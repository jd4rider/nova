import std.io { println }
import "../../../libraries/nova-engine/src/math.nova"
import "../../../libraries/nova-game/src/physics.nova"
import "../../../libraries/nova-render/src/metal.nova"

extern "C" fn usleep(usec: Int) -> Int

// ENG-02.002/003/004, ENG-11.001/002. The lab opens a real Metal window and
// draws a UV-mapped quad, a depth-tested colour cube, a lit textured cube, or a
// physics-driven lit cube. Camera input is polled as scalars from the host:
// drag orbits, shift-drag or right-drag pans, scroll zooms.

struct Camera {
    yaw: Int,
    pitch: Int,
    distance: Int,
    target: Vec3,
}

fn radians(degrees: Int) -> Int {
    return fx_mul(fx(degrees), fx_div(fx_pi(), fx(180)))
}

fn camera_new(yaw_degrees: Int, pitch_degrees: Int, distance: Int, target: Vec3) -> Camera {
    return Camera {
        yaw: radians(yaw_degrees),
        pitch: radians(pitch_degrees),
        distance: distance,
        target: target,
    }
}

fn camera_eye(camera: Camera) -> Vec3 {
    let cp = fx_cos(camera.pitch)
    let x = fx_mul(fx_mul(camera.distance, cp), fx_sin(camera.yaw))
    let y = fx_mul(camera.distance, fx_sin(camera.pitch))
    let z = fx_mul(fx_mul(camera.distance, cp), fx_cos(camera.yaw))
    return v3_add(camera.target, vec3(x, y, z))
}

// Q16.16 radians per drag point. The pitch clamp keeps the camera off the pole.
fn camera_orbit(camera: Camera, dx: Int, dy: Int) -> Camera {
    let turn = fx_ratio(5, 1000)
    var yaw = camera.yaw + dx * turn
    var pitch = camera.pitch - dy * turn
    let limit = fx_ratio(13, 10)
    if pitch > limit {
        pitch = limit
    }
    if pitch < 0 - limit {
        pitch = 0 - limit
    }
    return Camera {
        yaw: yaw,
        pitch: pitch,
        distance: camera.distance,
        target: camera.target,
    }
}

// Pan is in the camera's screen plane, scaled by distance so a drag feels the
// same close up and far away.
fn camera_pan(camera: Camera, dx: Int, dy: Int) -> Camera {
    let eye = camera_eye(camera)
    let forward = v3_normalize(v3_sub(camera.target, eye))
    let right = v3_normalize(v3_cross(forward, vec3(0, fx(1), 0)))
    let up = v3_cross(right, forward)
    let per_pixel = fx_mul(camera.distance, fx_ratio(1, 2000))
    let move_x = fx_mul(fx(dx), per_pixel)
    let move_y = fx_mul(fx(dy), per_pixel)
    let moved = v3_sub(v3_add(camera.target, v3_scale(right, move_x)), v3_scale(up, move_y))
    return Camera {
        yaw: camera.yaw,
        pitch: camera.pitch,
        distance: camera.distance,
        target: moved,
    }
}

fn camera_zoom(camera: Camera, scroll: Int) -> Camera {
    var distance = camera.distance + scroll * camera.distance / 2000
    let minimum = fx_ratio(5, 2)
    let maximum = fx(12)
    if distance < minimum {
        distance = minimum
    }
    if distance > maximum {
        distance = maximum
    }
    return Camera {
        yaw: camera.yaw,
        pitch: camera.pitch,
        distance: distance,
        target: camera.target,
    }
}

fn camera_vp(camera: Camera, width: Int, height: Int) -> Mat4 {
    let projection = mat4_perspective(radians(50), fx_ratio(width, height), fx(1), fx(60))
    let view = mat4_look_at(camera_eye(camera), camera.target, vec3(0, fx(1), 0))
    return mat4_mul(projection, view)
}

fn send_mvp(handle: Int, mvp: Mat4) -> Int {
    return metal_mvp(handle,
        mat4_get(mvp, 0, 0), mat4_get(mvp, 0, 1), mat4_get(mvp, 0, 2), mat4_get(mvp, 0, 3),
        mat4_get(mvp, 1, 0), mat4_get(mvp, 1, 1), mat4_get(mvp, 1, 2), mat4_get(mvp, 1, 3),
        mat4_get(mvp, 2, 0), mat4_get(mvp, 2, 1), mat4_get(mvp, 2, 2), mat4_get(mvp, 2, 3),
        mat4_get(mvp, 3, 0), mat4_get(mvp, 3, 1), mat4_get(mvp, 3, 2), mat4_get(mvp, 3, 3))
}

// The original fixed camera used by the quad, colour-cube and lit-cube
// acceptance paths. Keeping it separate preserves their pixel baselines.
fn apply_camera(handle: Int, width: Int, height: Int) -> Int {
    let fov = radians(50)
    let projection = mat4_perspective(fov, fx_ratio(width, height), fx(1), fx(20))
    let view = mat4_look_at(vec3(fx_ratio(12, 10), fx(1), fx(3)), vec3(0, 0, 0), vec3(0, fx(1), 0))
    return send_mvp(handle, mat4_mul(projection, view))
}

fn apply_scene(handle: Int, width: Int, height: Int, camera: Camera, position: Vec3) -> Int {
    let mvp = mat4_mul(camera_vp(camera, width, height), mat4_translation(position))
    return send_mvp(handle, mvp)
}

// ---------- physics-driven cube ----------

fn physics_start() -> Body {
    var body = ph_box(80, 30, 130, 130)
    body = ph_with_velocity(body, 5000, 0)
    body = ph_with_bounce(body, 80)
    return body
}

fn physics_step(body: Body) -> Body {
    let pulled = ph_gravity(body, 120)
    let moved = ph_advance(pulled)
    return ph_clamp(moved, 20, 20, 280, 280)
}

fn physics_run(body: Body, steps: Int) -> Body {
    var work = body
    var i = 0
    while i < steps {
        work = physics_step(work)
        i = i + 1
    }
    return work
}

// The physics field is 300 x 300 px at 100 px per world unit. Physics y grows
// downward, so the rendered axis is flipped.
fn body_position(body: Body) -> Vec3 {
    let x = fx_ratio(ph_px(body.x), 100)
    let y = fx_ratio(300 - ph_px(body.y), 100)
    return vec3(x, y, 0)
}

fn camera_orbit_preset() -> Camera {
    return camera_new(35, 22, fx(6), vec3(fx_ratio(15, 10), fx_ratio(15, 10), 0))
}

fn camera_front_preset() -> Camera {
    return camera_new(0, 10, fx(6), vec3(fx_ratio(15, 10), fx_ratio(15, 10), 0))
}

fn camera_from_env() -> Camera {
    if metal_env("NOVA_METAL_CAMERA") == "front" {
        return camera_front_preset()
    }
    return camera_orbit_preset()
}

fn camera_name() -> String {
    if metal_env("NOVA_METAL_CAMERA") == "front" {
        return "front"
    }
    return "orbit"
}

fn read_camera_input(handle: Int, camera: Camera) -> Camera {
    let orbit_dx = metal_input(handle, 0)
    let orbit_dy = metal_input(handle, 1)
    let pan_dx = metal_input(handle, 2)
    let pan_dy = metal_input(handle, 3)
    let scroll = metal_input(handle, 4)
    metal_input_reset(handle)
    var next = camera_orbit(camera, orbit_dx, orbit_dy)
    next = camera_pan(next, pan_dx, pan_dy)
    next = camera_zoom(next, scroll)
    return next
}

fn run_live(handle: Int, start_camera: Camera, start_body: Body, start_steps: Int) {
    var camera = start_camera
    var body = start_body
    var steps = start_steps
    while metal_poll(handle) == 1 {
        camera = read_camera_input(handle, camera)
        body = physics_step(body)
        steps = steps + 1
        apply_scene(handle, 900, 640, camera, body_position(body))
        metal_draw(handle, 15, 20, 28)
        usleep(16000)
    }
    println("metal-lab: physics live-stopped steps=${steps} body=${ph_px(body.x)},${ph_px(body.y)}")
}

fn main() {
    let handle = metal_init("Nova Metal Lab", 900, 640)
    if handle == 0 {
        println("metal-lab: ok=false error=${metal_last_error()}")
        return
    }

    let mode = metal_env("NOVA_METAL_MODE")
    var cube_mode = mode == "cube"
    var lit_mode = mode == "lit"
    var physics_mode = mode == "physics"
    var geometry = 0
    var geometry_ok = 1
    var camera = 1
    if cube_mode {
        geometry = 1
        geometry_ok = metal_geometry(handle, geometry)
        camera = apply_camera(handle, 900, 640)
    }
    if lit_mode || physics_mode {
        geometry = 2
        geometry_ok = metal_geometry(handle, geometry)
        if lit_mode {
            camera = apply_camera(handle, 900, 640)
        }
    }

    let texture = metal_env("NOVA_METAL_TEXTURE")
    var texture_loaded = 0
    if !cube_mode && texture.len() > 0 {
        texture_loaded = metal_texture(handle, texture)
    }

    var light = 0
    if lit_mode || physics_mode {
        let towards = vec3(fx_ratio(9, 20), fx_ratio(17, 20), fx_ratio(11, 20))
        light = metal_light(handle, 1, towards.x, towards.y, towards.z)
    }

    var camera_state = camera_from_env()
    var camera_preset = "none"
    if physics_mode {
        camera_preset = camera_name()
    }
    var body = physics_start()
    var steps = 0
    if physics_mode {
        body = physics_run(body, 90)
        steps = 90
        camera = apply_scene(handle, 900, 640, camera_state, body_position(body))
    }

    let shot = metal_env("NOVA_METAL_SHOT")
    if physics_mode && shot.len() == 0 {
        run_live(handle, camera_state, body, steps)
        metal_shutdown(handle)
        println("metal-lab: shutdown-complete")
        return
    }

    var frames = 0
    var attempts = 0
    while frames < 3 && attempts < 300 {
        if metal_poll(handle) == 0 {
            break
        }
        if physics_mode {
            camera_state = read_camera_input(handle, camera_state)
            body = physics_step(body)
            steps = steps + 1
            apply_scene(handle, 900, 640, camera_state, body_position(body))
        }
        if metal_draw(handle, 15, 20, 28) == 1 {
            frames = frames + 1
        }
        attempts = attempts + 1
    }

    var captured = 0
    if shot.len() > 0 {
        captured = metal_capture(handle, shot)
    }
    if physics_mode {
        println("metal-lab: physics step=${steps} body=${ph_px(body.x)},${ph_px(body.y)}")
    }

    // Advance the simulation between the two captures so the second image is
    // not a repeat; the camera is rebuilt at the new aspect ratio.
    if physics_mode {
        body = physics_run(body, 60)
        steps = steps + 60
    }
    let resized = metal_resize(handle, 640, 480)
    var camera_resized = 1
    if cube_mode || lit_mode {
        camera_resized = apply_camera(handle, 640, 480)
    }
    if physics_mode {
        camera_resized = apply_scene(handle, 640, 480, camera_state, body_position(body))
    }
    var redrawn = 0
    if resized == 1 {
        redrawn = metal_draw(handle, 20, 26, 36)
    }

    var captured_resized = 0
    if shot.len() > 0 {
        captured_resized = metal_capture(handle, shot + ".resized.png")
    }
    if physics_mode {
        println("metal-lab: physics step=${steps} body=${ph_px(body.x)},${ph_px(body.y)}")
    }

    var capture_ok = true
    if shot.len() > 0 && (captured != 1 || captured_resized != 1) {
        capture_ok = false
    }
    var texture_ok = true
    if !cube_mode && texture.len() > 0 && texture_loaded != 1 {
        texture_ok = false
    }
    if (lit_mode || physics_mode) && texture_loaded != 1 {
        texture_ok = false
    }
    var mode_ok = true
    if cube_mode || lit_mode || physics_mode {
        if geometry_ok != 1 {
            mode_ok = false
        }
        if camera != 1 {
            mode_ok = false
        }
        if camera_resized != 1 {
            mode_ok = false
        }
    }
    if (lit_mode || physics_mode) && light != 1 {
        mode_ok = false
    }
    var ok = "false"
    if frames == 3 && resized == 1 && capture_ok && texture_ok && mode_ok {
        ok = "true"
    }
    println("metal-lab: ok=${ok} mode=${mode} geometry=${geometry} camera=${camera} camera_resized=${camera_resized} camera_preset=${camera_preset} light=${light} frames=${frames} attempts=${attempts} resize=${resized} redrawn=${redrawn} texture=${texture_loaded} capture=${captured} resized_capture=${captured_resized} steps=${steps} body=${ph_px(body.x)},${ph_px(body.y)} error=${metal_last_error()}")
    if metal_env("NOVA_METAL_KEEP").len() == 0 {
        metal_shutdown(handle)
    }
    println("metal-lab: shutdown-complete")
}
