enum Flag {
    Off
    On(Bool)
    Pair(Bool, Bool)
}

fn score(flag: Flag) -> Int {
    return match flag {
        Off => 0
        On(v) => match v {
            true => 4
            false => 1
        }
        Pair(a, b) => match a {
            true => 2
            false => 0
        } + match b {
            true => 3
            false => 0
        }
    }
}

fn main() -> Int {
    let a = On(true)
    let b = Pair(true, false)
    let c = On(false)
    return score(a) + score(b) + score(c) + score(Off)
}
