import "../../../libraries/nova-lsp/src/lsp.nova"

// nova-tool: the phase-1 self-hosted toolchain, in Nova.
//
// Set NOVA_TOOL to fmt | check | lex | diag | box | lock | imports and
// NOVA_TOOL_PATH to the file to inspect. `fmt` writes to NOVA_TOOL_OUT when it
// is set, which is how the corpus test checks idempotence.

struct NtExpanded {
    text: String,
    loaded: List<String>,
    modules: List<NtModule>,
    error: String,
}

struct NtModule {
    path: String,
    name: String,
    decls: Int,
}

fn nt_between_quotes(line: String) -> String {
    let chars = line.chars()
    var start = 0 - 1
    var i = 0
    while i < chars.len() {
        if chars[i] == "\"" {
            if start < 0 {
                start = i + 1
            } else {
                return lx_slice(chars, start, i)
            }
        }
        i = i + 1
    }
    return ""
}

fn nt_manifest_value(source: String, wanted: String, key: String) -> String {
    var section = ""
    for line in source.split("\n") {
        let text = line.trim()
        if text.starts_with("[") && text.ends_with("]") {
            section = text
        } else if section == wanted && text.starts_with(key) {
            let rest = lx_slice(text.chars(), key.len(), text.len()).trim()
            if rest.starts_with("=") {
                return nt_between_quotes(rest)
            }
        }
    }
    return ""
}

fn nt_find_root() -> String {
    var dir = gui.cwd()
    var searching = true
    while searching {
        if gui.exists(dir + "/nova.toml") || gui.exists(dir + "/Box.toml") {
            return dir
        }
        let parent = rs_dirname(dir)
        if parent == dir || parent.len() == 0 {
            searching = false
        } else {
            dir = parent
        }
    }
    return ""
}

fn nt_has_arg(flag: String) -> Bool {
    let argc = gui.args_count()
    var i = 2
    while i < argc {
        if gui.arg(i) == flag {
            return true
        }
        i = i + 1
    }
    return false
}

fn nt_has_path(paths: List<String>, path: String) -> Bool {
    for item in paths {
        if item == path {
            return true
        }
    }
    return false
}

fn nt_basename(path: String) -> String {
    let parts = path.split("/")
    if parts.len() == 0 {
        return path
    }
    return parts[parts.len() - 1]
}

// `src/math.nova` -> `math`.
fn nt_stem(name: String) -> String {
    if !name.ends_with(".nova") {
        return name
    }
    let chars = name.chars()
    var out = ""
    var i = 0
    while i + 5 < chars.len() {
        out = out + chars[i]
        i = i + 1
    }
    return out
}

fn nt_first_existing(paths: List<String>) -> String {
    for path in paths {
        if gui.exists(path) {
            return path
        }
    }
    return ""
}

fn nt_manifest_file(dir: String) -> String {
    if gui.exists(dir + "/Box.toml") {
        return dir + "/Box.toml"
    }
    return dir + "/nova.toml"
}

// The directory of a `[dependencies]` path dependency, or "" when `name` is
// not declared (or is registry-only, which this build cannot fetch).
fn nt_dep_path(root: String, name: String) -> String {
    let manifest_path = nt_manifest_file(root)
    if !gui.exists(manifest_path) {
        return ""
    }
    let manifest = bx_parse_manifest(gui.read(manifest_path))
    for dep in manifest.deps {
        if dep.name == name && dep.path.len() > 0 {
            return rs_normalize(root + "/" + dep.path)
        }
    }
    return ""
}

fn nt_dep_entry(dir: String) -> String {
    let manifest_path = nt_manifest_file(dir)
    if !gui.exists(manifest_path) {
        return ""
    }
    return bx_parse_manifest(gui.read(manifest_path)).bin
}

// A registry dependency that `nova box fetch` unpacked into the local cache:
// Box.lock names the version, and the cached Box.toml names the entry file.
fn nt_registry_module(name: String, root: String) -> String {
    let cache = rg_cache_root()
    if cache.len() == 0 {
        return ""
    }
    let lock_path = root + "/Box.lock"
    if !gui.exists(lock_path) {
        return ""
    }
    var version = ""
    for line in gui.read(lock_path).split("\n") {
        if line.starts_with("box \"" + name + "\" ") {
            let parts = line.split("\"")
            if parts.len() >= 4 {
                version = parts[3]
            }
        }
    }
    if version.len() == 0 {
        return ""
    }
    let dir = cache + "/src/" + rg_publisher(name) + "/" + rg_box(name) + "/" + version
    let manifest = dir + "/Box.toml"
    if gui.exists(manifest) {
        let bin = nt_manifest_value(gui.read(manifest), "[bin]", "path")
        if bin.len() > 0 {
            let entry = dir + "/" + bin
            if gui.exists(entry) {
                return entry
            }
        }
    }
    if gui.exists(dir + "/src/lib.nova") {
        return dir + "/src/lib.nova"
    }
    if gui.exists(dir + "/src/main.nova") {
        return dir + "/src/main.nova"
    }
    return ""
}

// Resolves one import to a file. A `.nova` path is file-relative; a bare name
// is tried as a `[dependencies]` path dependency first, then a cached registry
// box, then as a sibling module file and finally as a module directory.
fn nt_resolve_module(importer: String, relative: String, root: String) -> String {
    let base = rs_dirname(importer)
    var candidates: List<String> = []
    if relative.ends_with(".nova") {
        candidates.push(rs_normalize(base + "/" + relative))
        return nt_first_existing(candidates)
    }
    let dep = nt_dep_path(root, relative)
    if dep.len() > 0 {
        let bin = nt_dep_entry(dep)
        if bin.len() > 0 {
            candidates.push(rs_normalize(dep + "/" + bin))
        }
        candidates.push(dep + "/src/lib.nova")
        candidates.push(dep + "/src/main.nova")
    }
    candidates.push(rs_normalize(base + "/" + relative + ".nova"))
    candidates.push(rs_normalize(base + "/" + relative + "/src/lib.nova"))
    candidates.push(rs_normalize(base + "/" + relative + "/src/main.nova"))
    let found = nt_first_existing(candidates)
    if found.len() > 0 {
        return found
    }
    return nt_registry_module(relative, root)
}

fn nt_import_is_std(line: String) -> Bool {
    let text = line.trim()
    if !text.starts_with("import ") {
        return false
    }
    return text.contains("std.")
}

// `import std.io { println }` -> `std.io`.
fn nt_std_name(line: String) -> String {
    let text = line.trim()
    if !text.starts_with("import ") {
        return ""
    }
    let chars = text.chars()
    var start = 0 - 1
    var i = 0
    while i + 3 < chars.len() {
        if chars[i] == "s" && chars[i + 1] == "t" && chars[i + 2] == "d" && chars[i + 3] == "." {
            start = i
            i = chars.len()
        } else {
            i = i + 1
        }
    }
    if start < 0 {
        return ""
    }
    var out = ""
    var j = start
    while j < chars.len() && chars[j] != " " && chars[j] != "{" {
        out = out + chars[j]
        j = j + 1
    }
    return out
}

fn nt_std_known(module: String) -> Bool {
    return module == "std.io" || module == "std.core"
}

// Counts top-level `fn`/`struct`/`enum`/`impl` items. `p_parse` cannot be
// used here: it treats `import` as an item and skips the declaration that
// follows an import line.
fn nt_decl_count(source: String) -> Int {
    var count = 0
    var depth = 0
    for token in lx_lex(source) {
        if token.text == "{" {
            depth = depth + 1
        } else if token.text == "}" {
            depth = depth - 1
        } else if depth == 0 && (token.text == "fn" || token.text == "struct" || token.text == "enum" || token.text == "impl") {
            count = count + 1
        }
    }
    return count
}

// Inlines imports into one program. `.nova` paths and path dependencies load
// transitively; `stack` detects cycles, `loaded` expands a shared module once,
// and every module's declarations are recorded for `NOVA_TOOL=modules`.
// Standard-library imports are validated and dropped because their functions
// are compiler builtins in this slice.
fn nt_expand(path: String, source: String, stack: List<String>, loaded: List<String>, root: String) -> NtExpanded {
    var text = ""
    var seen = loaded
    var modules: List<NtModule> = []
    modules.push(
    NtModule {
        path: path,
        name: nt_stem(nt_basename(path)),
        decls: nt_decl_count(source),
    }
    )
    for line in source.split("\n") {
        let trimmed = line.trim()
        if trimmed.starts_with("import ") {
            if nt_import_is_std(trimmed) {
                let module = nt_std_name(trimmed)
                if !nt_std_known(module) {
                    return NtExpanded {
                        text: text,
                        loaded: seen,
                        modules: modules,
                        error: "unknown standard module `${module}` in ${path}; this build provides std.io and std.core",
                    }
                }
            } else {
                let relative = nt_between_quotes(trimmed)
                if relative.len() == 0 {
                    return NtExpanded {
                        text: text,
                        loaded: seen,
                        modules: modules,
                        error: "unsupported import in ${path}: ${trimmed}",
                    }
                }
                let child = nt_resolve_module(path, relative, root)
                if child.len() == 0 {
                    return NtExpanded {
                        text: text,
                        loaded: seen,
                        modules: modules,
                        error: "cannot resolve module `${relative}` imported by ${path}",
                    }
                }
                if nt_has_path(stack, child) {
                    return NtExpanded {
                        text: text,
                        loaded: seen,
                        modules: modules,
                        error: "cyclic module import: ${path} -> ${child}",
                    }
                }
                if !nt_has_path(seen, child) {
                    var next_seen = seen
                    next_seen.push(child)
                    var next_stack = stack
                    next_stack.push(child)
                    let child_source = gui.read(child)
                    if child_source.len() == 0 && !gui.exists(child) {
                        return NtExpanded {
                            text: text,
                            loaded: seen,
                            modules: modules,
                            error: "cannot read imported file " + child,
                        }
                    }
                    let nested = nt_expand(child, child_source, next_stack, next_seen, root)
                    if nested.error.len() > 0 {
                        return nested
                    }
                    text = text + nested.text + "\n"
                    seen = nested.loaded
                    for item in nested.modules {
                        modules.push(item)
                    }
                }
            }
        } else {
            text = text + line + "\n"
        }
    }
    return NtExpanded { text: text, loaded: seen, modules: modules, error: "" }
}

fn nt_runtime_in(dir: String) -> String {
    let direct = dir + "/runtime/runtime.c"
    if gui.exists(direct) {
        return direct
    }
    let nested = dir + "/runtime.c"
    if gui.exists(nested) {
        return nested
    }
    return ""
}

fn nt_find_runtime() -> String {
    let explicit = gui.env("NOVA_TOOL_RUNTIME")
    if explicit.len() > 0 {
        return explicit
    }
    // A released compiler ships its runtime next to the binary; a source
    // checkout keeps it at the repository root, so walk up from the executable
    // before falling back to the working directory.
    var exe_dir = rs_dirname(gui.arg(0))
    var hops = 0
    while hops < 6 {
        let from_exe = nt_runtime_in(exe_dir)
        if from_exe.len() > 0 {
            return from_exe
        }
        let parent = rs_dirname(exe_dir)
        if parent == exe_dir || parent.len() == 0 {
            hops = 6
        } else {
            exe_dir = parent
            hops = hops + 1
        }
    }
    var dir = gui.cwd()
    var searching = true
    while searching {
        let candidate = nt_runtime_in(dir)
        if candidate.len() > 0 {
            return candidate
        }
        let parent = rs_dirname(dir)
        if parent == dir || parent.len() == 0 {
            searching = false
        } else {
            dir = parent
        }
    }
    return ""
}

fn nt_find_gui(runtime: String) -> String {
    // Resolve relative runtime paths against the working directory first:
    // normalising `..` only works once the path is absolute.
    var base = runtime
    if !base.starts_with("/") {
        base = gui.cwd() + "/" + base
    }
    let candidate = rs_dirname(base) + "/gui.m"
    if gui.exists(candidate) {
        return candidate
    }
    return ""
}

fn nt_wants_gui(ir: String) -> Bool {
    if ir.contains("@nova_gui_") {
        return true
    }
    if ir.contains("@nova_fs_") {
        return true
    }
    if ir.contains("@nova_process_") {
        return true
    }
    return ir.contains("@nova_env")
}

fn nt_find_webkit(runtime: String) -> String {
    var base = runtime
    if !base.starts_with("/") {
        base = gui.cwd() + "/" + base
    }
    let candidate = rs_dirname(base) + "/webkit.m"
    if gui.exists(candidate) {
        return candidate
    }
    return ""
}

fn nt_wants_webkit(ir: String) -> Bool {
    return ir.contains("@nova_webview_")
}

fn nt_find_speech(runtime: String) -> String {
    var base = runtime
    if !base.starts_with("/") {
        base = gui.cwd() + "/" + base
    }
    let candidate = rs_dirname(base) + "/speech.m"
    if gui.exists(candidate) {
        return candidate
    }
    return ""
}

fn nt_wants_speech(ir: String) -> Bool {
    return ir.contains("@nova_speech_")
}

fn nt_build_project() -> Int {
    let root = nt_find_root()
    if root.len() == 0 {
        println("error: no nova.toml or Box.toml found in this directory or its parents")
        return 1
    }
    var manifest_path = root + "/Box.toml"
    if !gui.exists(manifest_path) {
        manifest_path = root + "/nova.toml"
    }
    let manifest = gui.read(manifest_path)
    let lock_path = root + "/Box.lock"
    if nt_has_arg("--locked") && !gui.exists(lock_path) {
        println("nova build: --locked was passed but Box.lock does not exist")
        return 1
    }
    if manifest_path.ends_with("Box.toml") && !gui.exists(lock_path) {
        gui.write(lock_path, rp_lock(bx_parse_manifest(manifest), rs_resolve(manifest, root)))
    }
    var name = nt_manifest_value(manifest, "[package]", "name")
    if name.len() == 0 {
        name = "app"
    }
    var bin = nt_manifest_value(manifest, "[bin]", "path")
    if bin.len() == 0 {
        bin = "src/main.nova"
    }
    let entry = root + "/" + bin
    if !gui.exists(entry) {
        println("error: binary source does not exist: " + entry)
        return 1
    }
    let source = gui.read(entry)
    let expanded = nt_expand(entry, source, [entry], [entry], root)
    if expanded.error.len() > 0 {
        println("error: " + expanded.error)
        return 1
    }
    var target = gui.env("NOVA_TOOL_OUT")
    if target.len() == 0 {
        let target_dir = root + "/target/nova"
        if !gui.exists(target_dir) {
            if !gui.exists(root + "/target") {
                gui.mkdir(root + "/target")
            }
            gui.mkdir(target_dir)
        }
        target = nt_project_target()
    }
    return nt_build_source(entry, expanded.text, target)
}

fn nt_project_target() -> String {
    let root = nt_find_root()
    if root.len() == 0 {
        return ""
    }
    var manifest_path = root + "/Box.toml"
    if !gui.exists(manifest_path) {
        manifest_path = root + "/nova.toml"
    }
    let manifest = gui.read(manifest_path)
    var name = nt_manifest_value(manifest, "[package]", "name")
    if name.len() == 0 {
        name = "app"
    }
    return root + "/target/nova/" + name
}

fn nt_run_project() -> Int {
    let status = nt_build_project()
    if status != 0 {
        return status
    }
    let target = nt_project_target()
    let root = nt_find_root()
    if target.len() == 0 || !gui.exists(target) {
        println("error: built executable not found")
        return 1
    }
    let output = gui.run(nt_shell_quote(target), root)
    if output.len() > 0 {
        println(output)
    }
    return gui.exit_status()
}

fn nt_check_project() -> Int {
    let root = nt_find_root()
    if root.len() == 0 {
        println("error: no nova.toml or Box.toml found in this directory or its parents")
        return 1
    }
    var manifest_path = root + "/Box.toml"
    if !gui.exists(manifest_path) {
        manifest_path = root + "/nova.toml"
    }
    let manifest = gui.read(manifest_path)
    var bin = nt_manifest_value(manifest, "[bin]", "path")
    if bin.len() == 0 {
        bin = "src/main.nova"
    }
    let entry = root + "/" + bin
    if !gui.exists(entry) {
        println("error: binary source does not exist: " + entry)
        return 1
    }
    let expanded = nt_expand(entry, gui.read(entry), [entry], [entry], root)
    if expanded.error.len() > 0 {
        println("error: " + expanded.error)
        return 1
    }
    let diags = sa_check(nt_monomorphize(expanded.text))
    if diags.len() == 0 {
        println("Checked " + entry + ": no errors")
        return 0
    }
    for message in diags {
        println(message)
    }
    return 1
}

fn nt_shell_quote(text: String) -> String {
    var out = "'"
    for c in text.chars() {
        if c == "'" {
            out = out + "'" + "\\" + "'" + "'"
        } else {
            out = out + c
        }
    }
    return out + "'"
}

fn nt_brace_delta(line: String) -> Int {
    var depth = 0
    for c in line.chars() {
        if c == "{" {
            depth = depth + 1
        } else if c == "}" {
            depth = depth - 1
        }
    }
    return depth
}

// Explicit generic function calls (`id<Int>(7)`) are monomorphized before sema
// and codegen. This is intentionally a narrow, textual slice: one type
// parameter, simple type names and no generic structs/methods yet.
fn nt_monomorphize(source: String) -> String {
    let lines = source.split("\n")
    var names: List<String> = []
    var params: List<String> = []
    var blocks: List<String> = []
    var skip: List<Bool> = []
    var i = 0
    while i < lines.len() {
        skip.push(false)
        i = i + 1
    }
    i = 0
    while i < lines.len() {
        let trimmed = lines[i].trim()
        let head = if trimmed.starts_with("fn ") { trimmed.replace("fn ", "").split("(")[0].trim() } else { "" }
        if head.contains("<") && head.contains(">") {
            let name = head.split("<")[0].trim()
            let inside = head.split("<")[1].split(">")[0].trim()
            if name.len() > 0 && inside.len() > 0 && !inside.contains(",") {
                var depth = 0
                var block = ""
                var j = i
                var done = false
                var saw = false
                while j < lines.len() && !done {
                    block = block + lines[j] + "\n"
                    depth = depth + nt_brace_delta(lines[j])
                    if lines[j].contains("{") {
                        saw = true
                    }
                    skip[j] = true
                    if saw && depth <= 0 {
                        done = true
                    }
                    j = j + 1
                }
                names.push(name)
                params.push(inside)
                blocks.push(block)
                i = j
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    var insts: List<String> = []
    var n = 0
    while n < names.len() {
        var li = 0
        while li < lines.len() {
            if !skip[li] {
                let marker = names[n] + "<"
                if lines[li].contains(marker) {
                    let after = lines[li].split(marker)[1]
                    let ty = after.split(">")[0].trim()
                    if ty.len() > 0 {
                        var found = false
                        for existing in insts {
                            if existing == names[n] + "|" + ty {
                                found = true
                            }
                        }
                        if !found {
                            insts.push(names[n] + "|" + ty)
                        }
                    }
                }
            }
            li = li + 1
        }
        n = n + 1
    }
    var out = ""
    i = 0
    while i < lines.len() {
        if !skip[i] {
            var line = lines[i]
            for inst in insts {
                let parts = inst.split("|")
                line = line.replace(parts[0] + "<" + parts[1] + ">", parts[0] + "__" + parts[1])
            }
            out = out + line + "\n"
        }
        i = i + 1
    }
    n = 0
    while n < names.len() {
        for inst in insts {
            let parts = inst.split("|")
            if parts[0] == names[n] {
                var block = blocks[n]
                block = block.replace("<" + params[n] + ">", "")
                block = block.replace("fn " + names[n], "fn " + names[n] + "__" + parts[1])
                block = block.replace(params[n], parts[1])
                out = out + block + "\n"
            }
        }
        n = n + 1
    }
    return out
}

fn nt_build_source(path: String, source: String, target: String) -> Int {
    let result = cg_compile(nt_monomorphize(source))
    if result.error.len() > 0 {
        println("error: " + result.error)
        return 1
    }
    let ir_path = target + ".ll"
    if !gui.write(ir_path, result.ir) {
        println("error: cannot write " + ir_path)
        return 1
    }
    let runtime = nt_find_runtime()
    if runtime.len() == 0 || !gui.exists(runtime) {
        println("error: cannot find runtime/runtime.c; set NOVA_TOOL_RUNTIME")
        return 1
    }
    let gui_source = nt_find_gui(runtime)
    let webkit_source = nt_find_webkit(runtime)
    let host = gui.run("uname -s", gui.cwd()).trim()
    var wants_gui = false
    var gui_object = ""
    if host == "Darwin" && gui_source.len() > 0 && nt_wants_gui(result.ir) {
        wants_gui = true
        gui_object = target + ".gui.o"
        let gui_command = "clang -fobjc-arc -O2 -c " + nt_shell_quote(gui_source) + " -o " + nt_shell_quote(gui_object)
        let gui_output = gui.run(gui_command, gui.cwd())
        if gui.exit_status() != 0 {
            println("error: clang failed to compile nova-gui for " + path)
            if gui_output.len() > 0 {
                println(gui_output)
            }
            return 1
        }
    }
    var wants_webkit = false
    var webkit_object = ""
    if host == "Darwin" && webkit_source.len() > 0 && nt_wants_webkit(result.ir) {
        wants_webkit = true
        webkit_object = target + ".webkit.o"
        let webkit_command = "clang -fobjc-arc -O2 -c " + nt_shell_quote(webkit_source) + " -o " + nt_shell_quote(webkit_object)
        let webkit_output = gui.run(webkit_command, gui.cwd())
        if gui.exit_status() != 0 {
            println("error: clang failed to compile nova-webkit for " + path)
            if webkit_output.len() > 0 {
                println(webkit_output)
            }
            return 1
        }
    }
    let speech_source = nt_find_speech(runtime)
    var wants_speech = false
    var speech_object = ""
    if host == "Darwin" && speech_source.len() > 0 && nt_wants_speech(result.ir) {
        wants_speech = true
        speech_object = target + ".speech.o"
        let speech_command = "clang -fobjc-arc -O2 -c " + nt_shell_quote(speech_source) + " -o " + nt_shell_quote(speech_object)
        let speech_output = gui.run(speech_command, gui.cwd())
        if gui.exit_status() != 0 {
            println("error: clang failed to compile nova-speech for " + path)
            if speech_output.len() > 0 {
                println(speech_output)
            }
            return 1
        }
    }
    var command = "clang -x ir " + nt_shell_quote(ir_path) + " -x none " + nt_shell_quote(runtime) + " -o " + nt_shell_quote(target) + " -lm"
    if wants_gui {
        command = command + " " + nt_shell_quote(gui_object) + " -framework Cocoa -framework CoreText -framework CoreGraphics -framework ImageIO -framework QuartzCore"
    }
    if wants_webkit {
        command = command + " " + nt_shell_quote(webkit_object) + " -framework WebKit -framework Cocoa"
    }
    if wants_speech {
        command = command + " " + nt_shell_quote(speech_object) + " -framework AVFoundation -framework Cocoa"
    }
    let output = gui.run(command, gui.cwd())
    if gui.exit_status() != 0 {
        println("error: clang failed for " + path)
        if output.len() > 0 {
            println(output)
        }
        return 1
    }
    if wants_gui {
        gui.run("rm -f " + nt_shell_quote(gui_object), gui.cwd())
    }
    if wants_webkit {
        gui.run("rm -f " + nt_shell_quote(webkit_object), gui.cwd())
    }
    if wants_speech {
        gui.run("rm -f " + nt_shell_quote(speech_object), gui.cwd())
    }
    println("built " + target)
    return 0
}

// ---------- `nova` CLI surface ----------
// These commands run in the Nova tool instead of delegating to the Rust stage-0
// CLI. They reuse the Nova formatter, Nova Boxes and package helpers already
// linked into this binary.

fn nt_collect_nova(dir: String, out: List<String>) -> List<String> {
    var files = out
    if !gui.is_dir(dir) {
        return files
    }
    for entry in gui.list(dir).split("\n") {
        let name = entry.trim().replace("f\t", "").replace("d\t", "")
        if name.len() == 0 {
            continue
        }
        let path = dir + "/" + name
        if gui.is_dir(path) {
            files = nt_collect_nova(path, files)
        } else if name.ends_with(".nova") {
            files.push(path)
        }
    }
    return files
}

fn nt_fmt_command() -> Int {
    var check = false
    var files: List<String> = []
    let argc = gui.args_count()
    var i = 2
    while i < argc {
        let arg = gui.arg(i)
        if arg == "--check" {
            check = true
        } else if gui.is_dir(arg) {
            files = nt_collect_nova(arg, files)
        } else {
            files.push(arg)
        }
        i = i + 1
    }
    if files.len() == 0 {
        let root = nt_find_root()
        if root.len() == 0 {
            println("nova fmt: no nova.toml or Box.toml found in this directory or its parents")
            return 1
        }
        files = nt_collect_nova(root + "/src", files)
        files = nt_collect_nova(root + "/tests", files)
    }
    if files.len() == 0 {
        println("nova fmt: no .nova files found")
        return 1
    }
    var changed = 0
    var errors = 0
    for path in files {
        let source = gui.read(path)
        if source.len() == 0 && !gui.exists(path) {
            println("nova fmt: could not read " + path)
            errors = errors + 1
            continue
        }
        if fmt_is_formatted(source) {
            continue
        }
        changed = changed + 1
        if check {
            println("would reformat " + path)
        } else if gui.write(path, fmt_source(source)) {
            println("formatted " + path)
        } else {
            println("nova fmt: could not write " + path)
            errors = errors + 1
        }
    }
    if check {
        if changed == 0 && errors == 0 {
            println("All " + files.len().to_string() + " file(s) are formatted.")
        }
    } else {
        println("Formatted " + changed.to_string() + " file(s).")
    }
    if errors > 0 || (check && changed > 0) {
        return 1
    }
    return 0
}

fn nt_project_manifest(root: String) -> String {
    if gui.exists(root + "/Box.toml") {
        return root + "/Box.toml"
    }
    return root + "/nova.toml"
}

fn nt_box_registry(action: String) -> Int {
    let registry = rg_root()
    if action == "search" {
        if gui.args_count() > 4 {
            println("nova box search: at most one query is supported")
            return 2
        }
        let text = rg_search(registry, gui.arg(3))
        println(text)
        if text.contains("error:") {
            return 1
        }
        return 0
    }
    if gui.args_count() != 4 {
        println("nova box " + action + ": expected one box name")
        return 2
    }
    let name = gui.arg(3)
    var text = ""
    if action == "info" {
        text = rg_info(registry, name)
    } else {
        text = rg_fetch(registry, name)
    }
    println(text)
    if text.contains("error:") {
        return 1
    }
    return 0
}

fn nt_box_command() -> Int {
    let action = gui.arg(2)
    if action.len() == 0 {
        println("nova box: expected an action")
        return 2
    }
    if action == "search" || action == "info" || action == "fetch" {
        return nt_box_registry(action)
    }
    let root = nt_find_root()
    if root.len() == 0 {
        println("nova box: no Box.toml or nova.toml found in this directory or its parents")
        return 1
    }
    let manifest = nt_project_manifest(root)
    let source = gui.read(manifest)

    if action == "tree" || action == "resolve" || action == "check" {
        let resolved = rs_resolve(source, root)
        println(rp_tree(bx_parse_manifest(source), resolved))
        for message in resolved.errors {
            println("error: " + message)
        }
        if resolved.errors.len() > 0 {
            return 1
        }
        if action == "check" {
            println("Boxes check passed: " + manifest)
        }
        return 0
    }

    if action == "lock" {
        let lock = rp_lock(bx_parse_manifest(source), rs_resolve(source, root))
        if !gui.write(root + "/Box.lock", lock) {
            println("nova box: could not write " + root + "/Box.lock")
            return 1
        }
        println("Wrote " + root + "/Box.lock")
        return 0
    }

    if action == "metadata" {
        println(rp_metadata(bx_parse_manifest(source), rs_resolve(source, root)))
        return 0
    }

    if action == "pack" {
        var out = gui.arg(3)
        if out.len() == 0 {
            out = root + "/Box.box"
        }
        let message = ar_pack(root, out)
        println(message)
        if message.starts_with("error:") {
            return 1
        }
        return 0
    }

    if action == "verify" {
        var path = gui.arg(3)
        if path.len() == 0 {
            path = root + "/Box.box"
        }
        let message = ar_verify(path)
        println(message)
        if message.starts_with("error:") {
            return 1
        }
        return 0
    }

    if action == "unpack" {
        var path = gui.arg(3)
        if path.len() == 0 {
            path = root + "/Box.box"
        }
        var out = gui.arg(4)
        if out.len() == 0 {
            out = root + "/Boxes"
        }
        let message = ar_unpack(path, out)
        println(message)
        if message.starts_with("error:") {
            return 1
        }
        return 0
    }

    if action == "add" || action == "remove" {
        if gui.args_count() != 4 {
            println("nova box " + action + ": expected one box name")
            return 2
        }
        let arg = gui.arg(3)
        var edited = ""
        if action == "add" {
            let pair = rg_split_spec(arg)
            if !rg_valid_name(pair.0) {
                println("error: `" + pair.0 + "` is not a canonical registry name; use @publisher/box")
                return 1
            }
            if !rg_requirement_ok(pair.1) {
                println("error: `" + pair.1 + "` is not a SemVer requirement")
                return 1
            }
            edited = bx_set_dependency(source, pair.0, pair.1)
        } else {
            let edit = bx_remove_dependency(source, arg)
            if !edit.1 {
                println("error: no dependency `" + arg + "` in this manifest")
                return 1
            }
            edited = edit.0
        }
        if edited.starts_with("error:") || !gui.write(manifest, edited) {
            println("error: could not update " + manifest)
            return 1
        }
        let verb = if action == "add" { "Added" } else { "Removed" }
        println(verb + " `" + arg + "` in " + manifest)
        return 0
    }

    if action == "update" {
        let lock = rg_update(source, root, rg_root())
        if lock.starts_with("error:") {
            println(lock)
            return 1
        }
        let warnings = rg_yank_warnings(root, rg_root())
        if warnings.len() > 0 {
            println(warnings)
        }
        if !gui.write(root + "/Box.lock", lock) {
            println("nova box update: Box.lock was not written")
            return 1
        }
        println("Wrote " + root + "/Box.lock")
        return 0
    }

    println("nova box: `" + action + "` is not implemented yet; available: add, remove, tree, check, lock, update, metadata, resolve, pack, verify, unpack, search, info, fetch")
    return 2
}

fn nt_tree_command() -> Int {
    let root = nt_find_root()
    if root.len() == 0 {
        println("nova tree: no nova.toml or Box.toml found in this directory or its parents")
        return 1
    }
    let manifest = nt_project_manifest(root)
    let source = gui.read(manifest)
    println(rp_tree(bx_parse_manifest(source), rs_resolve(source, root)))
    return 0
}

fn nt_write_project(root: String, name: String) -> Int {
    if !gui.exists(root) && !gui.mkdir(root) {
        println("nova: could not create " + root)
        return 1
    }
    gui.mkdir(root + "/src")
    gui.mkdir(root + "/tests")
    let manifest = "[package]\nname = \"" + name + "\"\nversion = \"0.1.0\"\n\n[bin]\npath = \"src/main.nova\"\n"
    let main_source = "import std.io { println }\n\nfn main() {\n    println(\"Hello, Nova!\")\n}\n"
    if !gui.write(root + "/nova.toml", manifest) {
        println("nova: could not write " + root + "/nova.toml")
        return 1
    }
    gui.write(root + "/src/main.nova", main_source)
    gui.write(root + "/tests/hello_test.nova", "@test\nfn hello() {\n    assert(true)\n}\n")
    gui.write(root + "/.gitignore", "/target\n")
    return 0
}

fn nt_new_command() -> Int {
    if gui.args_count() != 3 {
        println("nova new: expected a project name")
        return 1
    }
    let name = gui.arg(2)
    if !bx_valid_name(name) {
        println("nova new: `" + name + "` is not a valid project name")
        return 1
    }
    if gui.exists(name) {
        println("nova new: `" + name + "` already exists")
        return 1
    }
    let status = nt_write_project(name, name)
    if status == 0 {
        println("Created Nova project `" + name + "`.")
        println("Next:")
        println("  cd " + name)
        println("  nova run")
    }
    return status
}

fn nt_init_command() -> Int {
    let root = gui.cwd()
    if gui.exists(root + "/nova.toml") {
        println("nova init: nova.toml already exists here")
        return 1
    }
    var name = ""
    for c in nt_basename(root).chars() {
        if c == " " || c == "." {
            name = name + "-"
        } else {
            name = name + c
        }
    }
    if name.len() == 0 {
        name = "app"
    }
    let status = nt_write_project(root, name)
    if status == 0 {
        println("Initialised Nova project `" + name + "`.")
    }
    return status
}

fn nt_clean_command() -> Int {
    let root = nt_find_root()
    if root.len() == 0 {
        println("nova clean: no nova.toml or Box.toml found in this directory or its parents")
        return 1
    }
    let target = root + "/target/nova"
    if !gui.exists(target) {
        println("Nothing to clean.")
        return 0
    }
    gui.run("rm -rf " + nt_shell_quote(target), root)
    if gui.exit_status() != 0 {
        println("nova clean: could not remove " + target)
        return 1
    }
    println("Removed " + target)
    return 0
}

fn nt_doctor_command() -> Int {
    println("Nova 0.2.0")
    println("Executable: nova-tool")
    println("Runtime ABI: 1")
    let clang = gui.run("clang --version", gui.cwd()).trim()
    var ok = true
    if clang.len() == 0 {
        println("C toolchain: NOT FOUND (required for native builds)")
        ok = false
    } else {
        println("C toolchain: " + clang.split("\n")[0])
    }
    println("Language server: `nova lsp`")
    println("Formatter: `nova fmt --check`")
    if ok {
        println("\nDoctor: native builds should work.")
        return 0
    }
    println("\nDoctor: install Xcode command line tools or clang, or set NOVA_CC.")
    return 1
}

fn nt_test_command() -> Int {
    let root = nt_find_root()
    if root.len() == 0 {
        println("nova test: no nova.toml or Box.toml found in this directory or its parents")
        return 1
    }
    let tests_dir = root + "/tests"
    if !gui.exists(tests_dir) {
        println("nova test: no tests/ directory")
        return 1
    }
    var files: List<String> = []
    files = nt_collect_nova(tests_dir, files)
    if files.len() == 0 {
        println("No test files found under tests/.")
        return 0
    }
    let target_dir = root + "/target/nova/tests"
    if !gui.exists(root + "/target") {
        gui.mkdir(root + "/target")
    }
    if !gui.exists(root + "/target/nova") {
        gui.mkdir(root + "/target/nova")
    }
    if !gui.exists(target_dir) {
        gui.mkdir(target_dir)
    }
    let filter = if gui.args_count() >= 3 { gui.arg(2) } else { "" }
    var passed = 0
    var failed = 0
    var matched = 0
    var built = 0
    for file in files {
        let source = gui.read(file)
        if source.len() == 0 && !gui.exists(file) {
            println("nova test: cannot read " + file)
            failed = failed + 1
            continue
        }
        let clean = source.replace("@test", "")
        var names: List<String> = []
        var pending = false
        for line in source.split("\n") {
            var decl = ""
            let trimmed = line.trim()
            if trimmed.starts_with("@test") {
                let rest = trimmed.replace("@test", "").trim()
                if rest.len() == 0 {
                    pending = true
                } else {
                    decl = rest
                }
            } else if pending {
                decl = trimmed
                pending = false
            }
            if decl.starts_with("fn ") {
                let rest = decl.replace("fn ", "").trim()
                let parts = rest.split("(")
                if parts.len() > 0 {
                    let name = parts[0].trim()
                    var seen = false
                    for existing in names {
                        if existing == name {
                            seen = true
                        }
                    }
                    if name.len() > 0 && !seen {
                        names.push(name)
                    }
                }
            }
        }
        if names.len() == 0 {
            println("note: " + file + " has no @test functions (skipped)")
            continue
        }
        let expanded = nt_expand(file, clean, [file], [file], root)
        if expanded.error.len() > 0 {
            println("test " + file + " ... FAILED (" + expanded.error + ")")
            failed = failed + 1
            continue
        }
        for name in names {
            if filter.len() > 0 && !name.contains(filter) {
                continue
            }
            matched = matched + 1
            built = built + 1
            let wrapped = expanded.text + "\nfn main() {\n    " + name + "()\n}\n"
            let target = target_dir + "/test_" + built.to_string()
            let status = nt_build_source(file, wrapped, target)
            if status != 0 {
                println("test " + file + "::" + name + " ... FAILED (build)")
                failed = failed + 1
                continue
            }
            let output = gui.run(nt_shell_quote(target), root)
            let code = gui.exit_status()
            if output.len() > 0 {
                println(output)
            }
            if code == 0 {
                println("test " + file + "::" + name + " ... ok")
                passed = passed + 1
            } else {
                println("test " + file + "::" + name + " ... FAILED (exit " + code.to_string() + ")")
                failed = failed + 1
            }
        }
    }
    println("\n" + passed.to_string() + " passed, " + failed.to_string() + " failed")
    if matched == 0 {
        println("note: filter matched no tests")
        return 0
    }
    if failed == 0 {
        return 0
    }
    return 1
}

fn nt_repl_command() -> Int {
    println("Nova compile-run REPL. Each line is compiled natively and executed.")
    println("Use :quit to exit, :clear to reset.")
    var buffer = ""
    var counter = 0
    var running = true
    while running {
        println("nova> ")
        let line = nova_stdin_read_line()
        if line.len() == 0 {
            running = false
        } else {
            let trimmed = line.trim()
            if trimmed.len() == 0 {
                counter = counter
            } else if trimmed == ":quit" || trimmed == ":q" || trimmed == "exit" {
                running = false
            } else if trimmed == ":clear" {
                buffer = ""
            } else if trimmed.starts_with("fn ") || trimmed.starts_with("struct ") || trimmed.starts_with("enum ") || trimmed.starts_with("import ") {
                println("Declarations are not supported in the REPL yet; put them in a .nova file.")
            } else {
                let candidate = buffer + trimmed + "\n"
                var statement = trimmed
                var source = "import std.io { println }\n\nfn main() {\n" + candidate + "}\n"
                let direct = cg_compile(source)
                let statementy = trimmed.starts_with("var ") || trimmed.starts_with("let ") || trimmed.starts_with("for ") || trimmed.starts_with("while ") || trimmed.starts_with("if ") || trimmed.starts_with("return ") || trimmed.starts_with("break") || trimmed.starts_with("continue") || trimmed.starts_with("println(") || trimmed.starts_with("assert(")
                if direct.error.len() > 0 || !statementy {
                    let wrapped = buffer + "println(" + trimmed + ")\n"
                    let alternate = "import std.io { println }\n\nfn main() {\n" + wrapped + "}\n"
                    let checked = cg_compile(alternate)
                    if checked.error.len() == 0 {
                        source = alternate
                        statement = "println(" + trimmed + ")"
                    }
                }
                counter = counter + 1
                let target = "/tmp/nova-repl-" + counter.to_string()
                if nt_build_source("<repl>", source, target) == 0 {
                    let output = gui.run(nt_shell_quote(target), gui.cwd())
                    let code = gui.exit_status()
                    if output.len() > 0 {
                        println(output)
                    }
                    if code == 0 {
                        buffer = buffer + statement + "\n"
                    } else {
                        println("repl: program exited " + code.to_string())
                    }
                }
            }
        }
    }
    return 0
}

fn main() {
    let argc = gui.args_count()
    if argc >= 2 && (gui.arg(1) == "--version" || gui.arg(1) == "-V") {
        println("nova 0.2.0")
        return
    }
    if argc >= 2 && gui.arg(1) == "lsp" {
        gui.exit(lsp_run_stdio())
    }
    if argc >= 2 && gui.arg(1) == "fmt" {
        gui.exit(nt_fmt_command())
    }
    if argc >= 2 && gui.arg(1) == "box" {
        gui.exit(nt_box_command())
    }
    if argc >= 2 && gui.arg(1) == "tree" {
        gui.exit(nt_tree_command())
    }
    if argc >= 2 && gui.arg(1) == "new" {
        gui.exit(nt_new_command())
    }
    if argc >= 2 && gui.arg(1) == "init" {
        gui.exit(nt_init_command())
    }
    if argc >= 2 && gui.arg(1) == "clean" {
        gui.exit(nt_clean_command())
    }
    if argc >= 2 && gui.arg(1) == "doctor" {
        gui.exit(nt_doctor_command())
    }
    if argc >= 2 && gui.arg(1) == "build" {
        if argc < 3 || gui.arg(2).starts_with("--") {
            gui.exit(nt_build_project())
        }
        let source_path = gui.arg(2)
        let target = if argc >= 4 { gui.arg(3) } else { source_path + ".out" }
        let source = gui.read(source_path)
        if source.len() == 0 && !gui.exists(source_path) {
            println("nova-tool: cannot read " + source_path)
            gui.exit(1)
        }
        gui.exit(nt_build_source(source_path, source, target))
    }
    if argc >= 2 && gui.arg(1) == "run" {
        gui.exit(nt_run_project())
    }
    if argc >= 2 && gui.arg(1) == "check" {
        gui.exit(nt_check_project())
    }
    if argc >= 2 && gui.arg(1) == "test" {
        gui.exit(nt_test_command())
    }
    if argc >= 2 && gui.arg(1) == "repl" {
        gui.exit(nt_repl_command())
    }
    let mode = gui.env("NOVA_TOOL")
    let path = gui.env("NOVA_TOOL_PATH")

    // Registry commands need no project: they read an index and a cache.
    if mode == "box-search" || mode == "box-info" || mode == "box-fetch" {
        let arg = gui.env("NOVA_TOOL_ARG")
        let registry = rg_root()
        if mode == "box-search" {
            println(rg_search(registry, arg))
        } else if mode == "box-info" {
            println(rg_info(registry, arg))
        } else {
            println(rg_fetch(registry, arg))
        }
        return
    }

    if path.len() == 0 {
        println("nova-tool: set NOVA_TOOL_PATH")
        return
    }
    let source = gui.read(path)
    if source.len() == 0 && !gui.exists(path) {
        println("nova-tool: cannot read ${path}")
        return
    }

    if mode == "box-add" || mode == "box-remove" {
        let arg = gui.env("NOVA_TOOL_ARG")
        if mode == "box-add" {
            let pair = rg_split_spec(arg)
            if !rg_valid_name(pair.0) {
                println("error: `${pair.0}` is not a canonical registry name; use @publisher/box")
            } else if !rg_requirement_ok(pair.1) {
                println("error: `${pair.1}` is not a SemVer requirement")
            } else {
                println(bx_set_dependency(source, pair.0, pair.1))
            }
        } else {
            let edit = bx_remove_dependency(source, arg)
            if !edit.1 {
                println("error: no dependency `${arg}` in this manifest")
            } else {
                println(edit.0)
            }
        }
        return
    }

    if mode == "box-update" {
        let base = rs_dirname(path)
        let registry = rg_root()
        let lock = rg_update(source, base, registry)
        if lock.starts_with("error:") {
            println(lock)
            return
        }
        let warnings = rg_yank_warnings(base, registry)
        if warnings.len() > 0 {
            println(warnings)
        }
        let target = gui.env("NOVA_TOOL_OUT")
        if target.len() > 0 {
            if !gui.write(target, lock) {
                println("error: cannot write " + target)
            }
        } else {
            println(lock)
        }
        return
    }

    if mode == "ast-dump" {
        let ast = a_parse(source)
        if ast.errors.len() > 0 {
            for message in ast.errors {
                println("error: " + message)
            }
        } else {
            println(a_render(ast, ast.nodes.len() - 1))
        }
        return
    }

    if mode == "box-json" {
        let doc = js_parse(source)
        if doc.error.len() > 0 {
            println("error: ${doc.error}")
        } else {
            println(js_render(doc, doc.nodes.len() - 1))
        }
        return
    }

    if mode == "fmt" {
        let out = fmt_source(source)
        let target = gui.env("NOVA_TOOL_OUT")
        if target.len() > 0 {
            if gui.write(target, out) {
                println("formatted ${path} -> ${target}")
            } else {
                println("nova-tool: could not write ${target}")
            }
        } else {
            println(out)
        }
        return
    }

    if mode == "check" {
        if fmt_is_formatted(source) {
            println("FORMATTED ${path}")
        } else {
            println("UNFORMATTED ${path}")
        }
        return
    }

    if mode == "lex" {
        let tokens = lx_lex(source)
        var count = tokens.len()
        if count > 0 {
            count = count - 1
        }
        println("tokens=${count} keywords=${lx_count(tokens, lx_keyword())} idents=${lx_count(tokens, lx_ident())} strings=${lx_count(tokens, lx_string())} comments=${lx_count(tokens, lx_comment())}")
        return
    }

    if mode == "parse" {
        for item in p_parse(source) {
            println("${item.kind} ${item.name} params=${item.params} stmts=${item.stmts} depth=${item.depth}")
        }
        return
    }

    if mode == "expr" {
        println(px_parse(source))
        return
    }

    if mode == "sema" {
        let diags = ck_check(source)
        if diags.len() == 0 {
            println("OK ${path}")
        } else {
            for message in diags {
                println(message)
            }
        }
        return
    }

    if mode == "sema-ast" {
        let diags = sa_check(source)
        if diags.len() == 0 {
            println("OK ${path}")
        } else {
            for message in diags {
                println(message)
            }
        }
        return
    }

    if mode == "emit-ir" {
        let result = cg_compile(source)
        if result.error.len() > 0 {
            println("error: " + result.error)
        } else {
            println(result.ir)
        }
        return
    }

    if mode == "build-ir" {
        let target = gui.env("NOVA_TOOL_OUT")
        if target.len() == 0 {
            println("error: set NOVA_TOOL_OUT to the output binary")
            return
        }
        nt_build_source(path, source, target)
        return
    }

    if mode == "box-semver" {
        for line in source.split("\n") {
            let parts = line.split("|")
            if parts.len() >= 2 {
                let version = sv_parse(parts[0].trim())
                println("${parts[0].trim()} ${parts[1].trim()} ${sv_satisfies(version, parts[1])}")
            }
        }
        return
    }

    if mode == "box-resolve" || mode == "box-tree" || mode == "box-lock" || mode == "box-metadata" {
        let manifest = bx_parse_manifest(source)
        let result = rs_resolve(source, rs_dirname(path))
        if mode == "box-resolve" || mode == "box-tree" {
            println(rp_tree(manifest, result))
        } else if mode == "box-lock" {
            println(rp_lock(manifest, result))
        } else {
            println(rp_metadata(manifest, result))
        }
        for message in result.errors {
            println("error: ${message}")
        }
        return
    }

    if mode == "box-pack" {
        let out = gui.env("NOVA_TOOL_OUT")
        if out.len() == 0 {
            println("nova-tool: set NOVA_TOOL_OUT")
            return
        }
        println(ar_pack(rs_dirname(path), out))
        return
    }
    if mode == "box-unpack" {
        let out = gui.env("NOVA_TOOL_OUT")
        println(ar_unpack(path, out))
        return
    }
    if mode == "box-verify" {
        println(ar_verify(path))
        return
    }
    if mode == "diag" {
        let d = diag_error("E0001", "unexpected token", 10, 14)
        println(diag_render(source, d))
        return
    }

    if mode == "box" {
        let manifest = bx_parse_manifest(source)
        println("name=${manifest.name} version=${manifest.version} bin=${manifest.bin} deps=${manifest.deps.len()} ok=${bx_manifest_ok(manifest)}")
        for dep in manifest.deps {
            println("  ${dep.name} path=${dep.path} version=${dep.version}")
        }
        return
    }

    if mode == "lock" {
        println(bx_lock(bx_parse_manifest(source)))
        return
    }

    if mode == "imports" {
        for dep in bx_imports(source) {
            println(dep)
        }
        return
    }

    if mode == "modules" {
        var root = nt_find_root()
        if root.len() == 0 {
            root = rs_dirname(path)
        }
        let expanded = nt_expand(path, source, [path], [path], root)
        if expanded.error.len() > 0 {
            println("error: " + expanded.error)
            return
        }
        for module in expanded.modules {
            println("${module.path} name=${module.name} decls=${module.decls}")
        }
        return
    }

    println("nova-tool: unknown mode ${mode}")
}
