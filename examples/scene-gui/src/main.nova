// ---------- demo world ----------

fn demo_world() -> World {
    var world = world_new(0)

    let ground = world_spawn(world, 1)
    world = ground.world
    world = world_set_position(world, ground.id, vec3(0, fx_ratio(0 - 2, 5), 0))
    world = world_set_scale(world, ground.id, vec3(fx(9), fx_ratio(1, 5), fx(9)))

    let crate_a = world_spawn(world, 2)
    world = crate_a.world
    world = world_set_position(world, crate_a.id, vec3(fx_ratio(0 - 8, 5), fx_ratio(1, 2), fx_ratio(2, 5)))
    world = world_set_scale(world, crate_a.id, vec3(fx(1), fx(1), fx(1)))
    world = world_set_velocity(world, crate_a.id, vec3(fx_ratio(3, 5), 0, fx_ratio(1, 5)))

    let crate_b = world_spawn(world, 2)
    world = crate_b.world
    world = world_set_position(world, crate_b.id, vec3(fx_ratio(4, 5), fx_ratio(1, 2), fx_ratio(0 - 6, 5)))
    world = world_set_scale(world, crate_b.id, vec3(fx(1), fx(1), fx(1)))

    let player = world_spawn(world, 3)
    world = player.world
    world = world_set_position(world, player.id, vec3(0, fx_ratio(7, 5), fx(1)))
    world = world_set_scale(world, player.id, vec3(fx_ratio(4, 5), fx_ratio(17, 10), fx_ratio(4, 5)))

    let light = world_spawn(world, 4)
    world = light.world
    world = world_set_position(world, light.id, vec3(fx_ratio(12, 5), fx_ratio(13, 5), fx_ratio(0 - 7, 5)))
    world = world_set_scale(world, light.id, vec3(fx_ratio(2, 5), fx_ratio(2, 5), fx_ratio(2, 5)))
    world = world_set_velocity(world, light.id, vec3(0, fx_ratio(2, 5), 0))

    let pedestal = world_spawn(world, 5)
    world = pedestal.world
    world = world_set_position(world, pedestal.id, vec3(fx_ratio(11, 5), fx_ratio(2, 5), fx_ratio(8, 5)))
    world = world_set_scale(world, pedestal.id, vec3(fx_ratio(8, 5), fx_ratio(2, 5), fx_ratio(8, 5)))

    // Game mode looks through this entity. The -12 degree pitch aims at the
    // player from eye height; editing the camera in the inspector changes the
    // Game view without a separate camera component or runtime API.
    let camera = world_spawn(world, 6)
    world = camera.world
    world = world_set_position(world, camera.id, vec3(0, fx_ratio(13, 5), fx_ratio(15, 2)))
    world = world_set_rotation(world, camera.id, quat_axis_angle(vec3(fx(1), 0, 0), radians(0 - 12)))
    world = world_set_scale(world, camera.id, vec3(fx_ratio(1, 2), fx_ratio(1, 2), fx_ratio(1, 2)))

    return world
}

fn find_tag(world: World, tag: Int) -> EntityId {
    var i = 0
    while i < world_capacity(world) {
        if world.pool.alive[i] && world.tags[i] == tag {
            return EntityId { index: i, generation: world.pool.generations[i] }
        }
        i = i + 1
    }
    return entity_none()
}

fn first_live(world: World) -> EntityId {
    var i = 0
    while i < world_capacity(world) {
        if world.pool.alive[i] {
            return EntityId { index: i, generation: world.pool.generations[i] }
        }
        i = i + 1
    }
    return entity_none()
}

fn next_live(world: World, id: EntityId) -> EntityId {
    let start = world_index(world, id)
    var i = start + 1
    while i < world_capacity(world) {
        if world.pool.alive[i] {
            return EntityId { index: i, generation: world.pool.generations[i] }
        }
        i = i + 1
    }
    return first_live(world)
}

// ---------- editor commands ----------

fn has_selection(app: App) -> Bool {
    return !entity_is_none(app.selected) && world_has(app.world, app.selected)
}

fn tool_mode_name(mode: Int) -> String {
    if mode == 1 {
        return "MOVE"
    }
    if mode == 2 {
        return "ROTATE"
    }
    if mode == 3 {
        return "SCALE"
    }
    return "SELECT"
}

fn tool_field(mode: Int) -> Int {
    if mode == 1 {
        return 0
    }
    if mode == 2 {
        return 1
    }
    if mode == 3 {
        return 2
    }
    return 0 - 1
}

fn snap_fixed(value: Int, step: Int) -> Int {
    if step <= 0 {
        return value
    }
    if value >= 0 {
        return ((value + step / 2) / step) * step
    }
    return 0 - (((0 - value + step / 2) / step) * step)
}

fn snap_degrees(value: Int) -> Int {
    if value >= 0 {
        return ((value + 7) / 15) * 15
    }
    return 0 - (((0 - value + 7) / 15) * 15)
}

fn tool_set_mode(app: App, mode: Int) -> App {
    var tool = app.tool
    tool.mode = mode
    tool.menu = 0 - 1
    tool.drag = false
    var notice = "Select tool · click an entity in Scene or the hierarchy"
    if mode == 1 {
        notice = "Move tool · drag in Scene · W"
    }
    if mode == 2 {
        notice = "Rotate tool · drag horizontally · E"
    }
    if mode == 3 {
        notice = "Scale tool · drag horizontally · R"
    }
    return app_set_notice(app_set_tool(app, tool), notice)
}

fn tool_toggle_snap(app: App) -> App {
    var tool = app.tool
    tool.snap = !tool.snap
    var notice = "Snapping off"
    if tool.snap {
        notice = "Snapping on · 0.5 m · 15° · 0.1 scale"
    }
    return app_set_notice(app_set_tool(app, tool), notice)
}

fn tool_toggle_grid(app: App) -> App {
    var tool = app.tool
    tool.grid = !tool.grid
    var notice = "Grid hidden"
    if tool.grid {
        notice = "Grid shown · 1 m"
    }
    return app_set_notice(app_set_tool(app, tool), notice)
}

fn tool_begin_drag(app: App, x: Int, y: Int) -> App {
    let field = tool_field(app.tool.mode)
    if field < 0 || !has_selection(app) {
        return app
    }
    var tool = app.tool
    tool.drag = true
    tool.drag_x = x
    tool.drag_y = y
    tool.drag_entity = app.selected
    tool.drag_field = field
    tool.drag_before = edit_values_for(app.world, app.selected, field)
    return app_set_notice(app_set_tool(app, tool), "${tool_mode_name(tool.mode)} drag · release to apply · Esc cancels")
}

fn tool_update_drag(app: App, x: Int, y: Int) -> App {
    if !app.tool.drag {
        return app
    }
    let dx = x - app.tool.drag_x
    let dy = y - app.tool.drag_y
    let before = app.tool.drag_before
    var values = before
    if app.tool.drag_field == 0 {
        var nx = before.x + fx_ratio(dx, 20)
        var nz = before.z + fx_ratio(dy, 20)
        if app.tool.snap {
            nx = snap_fixed(nx, fx_ratio(1, 2))
            nz = snap_fixed(nz, fx_ratio(1, 2))
        }
        values = EditValues { w: 0, x: nx, y: before.y, z: nz }
    }
    if app.tool.drag_field == 1 {
        var degrees = dx * 2
        if app.tool.snap {
            degrees = snap_degrees(degrees)
        }
        let delta = quat_axis_angle(vec3(0, fx(1), 0), radians(degrees))
        let rotation = quat_mul(delta, Quat { w: before.w, x: before.x, y: before.y, z: before.z })
        values = EditValues { w: rotation.w, x: rotation.x, y: rotation.y, z: rotation.z }
    }
    if app.tool.drag_field == 2 {
        let factor = fx_clamp(fx(1) + fx_ratio(dx, 120), fx_ratio(1, 10), fx(10))
        var sx = fx_mul(before.x, factor)
        var sy = fx_mul(before.y, factor)
        var sz = fx_mul(before.z, factor)
        if app.tool.snap {
            sx = snap_fixed(sx, fx_ratio(1, 10))
            sy = snap_fixed(sy, fx_ratio(1, 10))
            sz = snap_fixed(sz, fx_ratio(1, 10))
        }
        values = EditValues {
            w: 0,
            x: fx_clamp(sx, fx_ratio(1, 10), fx(10)),
            y: fx_clamp(sy, fx_ratio(1, 10), fx(10)),
            z: fx_clamp(sz, fx_ratio(1, 10), fx(10)),
        }
    }
    let command = EditCommand { entity: app.tool.drag_entity, field: app.tool.drag_field, before: before, after: values }
    return app_set_world(app, edit_apply(app.world, command, true))
}

fn tool_finish_drag(app: App) -> App {
    if !app.tool.drag {
        return app
    }
    var tool = app.tool
    tool.drag = false
    if !world_has(app.world, tool.drag_entity) {
        return app_set_tool(app, tool)
    }
    let after = edit_values_for(app.world, tool.drag_entity, tool.drag_field)
    if edit_values_equal(tool.drag_before, after) {
        return app_set_notice(app_set_tool(app, tool), "No transform change")
    }
    let command = EditCommand { entity: tool.drag_entity, field: tool.drag_field, before: tool.drag_before, after: after }
    let history = history_record(app.history, app.history_at, command)
    let notice = "Applied ${edit_field_name(tool.drag_field)} · ⌘Z undoes"
    return app_set_history(app_set_notice(app_set_tool(app, tool), notice), history, history.len())
}

fn new_scene_world() -> World {
    var world = world_new(0)
    let ground = world_spawn(world, 1)
    world = ground.world
    world = world_set_position(world, ground.id, vec3(0, fx_ratio(0 - 2, 5), 0))
    world = world_set_scale(world, ground.id, vec3(fx(9), fx_ratio(1, 5), fx(9)))
    return world
}

fn new_scene(app: App) -> App {
    let world = new_scene_world()
    var next = app_set_selected(app_set_world(app, world), first_live(world))
    next = app_clear_history(next)
    next = tool_set_mode(next, 0)
    return app_set_notice(next, "New Scene · use GameObject > Create Cube or Add")
}

fn reset_demo(app: App) -> App {
    let world = demo_world()
    var next = app_set_selected(app_set_world(app, world), find_tag(world, 3))
    next = app_clear_history(next)
    next = tool_set_mode(next, 0)
    return app_set_notice(next, "Demo Scene reset")
}

fn create_cube(app: App) -> App {
    let spawned = world_spawn(app.world, 2)
    var world = spawned.world
    world = world_set_position(world, spawned.id, vec3(0, fx_ratio(1, 2), 0))
    world = world_set_scale(world, spawned.id, vec3(fx(1), fx(1), fx(1)))
    var next = app_set_selected(app_set_world(app, world), spawned.id)
    next = app_clear_history(next)
    next = tool_set_mode(next, 1)
    return app_set_notice(next, "Created Cube · drag to move · ⌘Z undoes")
}

fn create_camera(app: App) -> App {
    let spawned = world_spawn(app.world, 6)
    var world = spawned.world
    world = world_set_position(world, spawned.id, vec3(0, fx_ratio(13, 5), fx_ratio(15, 2)))
    world = world_set_rotation(world, spawned.id, quat_axis_angle(vec3(fx(1), 0, 0), radians(0 - 12)))
    world = world_set_scale(world, spawned.id, vec3(fx_ratio(1, 2), fx_ratio(1, 2), fx_ratio(1, 2)))
    var next = app_set_selected(app_set_world(app, world), spawned.id)
    next = app_clear_history(next)
    next = tool_set_mode(next, 1)
    return app_set_notice(next, "Created Game Camera · Game renders through it")
}

fn duplicate_selected(app: App) -> App {
    if !has_selection(app) {
        return app_set_notice(app, "Select an entity to duplicate")
    }
    let tag = world_tag(app.world, app.selected)
    let position = world_position(app.world, app.selected)
    let rotation = world_rotation(app.world, app.selected)
    let scale = world_scale(app.world, app.selected)
    let spawned = world_spawn(app.world, tag)
    var world = spawned.world
    world = world_set_position(world, spawned.id, vec3(position.x + fx_ratio(3, 5), position.y, position.z))
    world = world_set_rotation(world, spawned.id, rotation)
    world = world_set_scale(world, spawned.id, scale)
    var next = app_set_selected(app_set_world(app, world), spawned.id)
    next = app_clear_history(next)
    next = tool_set_mode(next, 1)
    return app_set_notice(next, "Duplicated ${entity_name(world, spawned.id)} · drag to move")
}

fn delete_selected(app: App) -> App {
    if !has_selection(app) {
        return app_set_notice(app, "Select an entity to delete")
    }
    let name = entity_name(app.world, app.selected)
    let world = world_despawn(app.world, app.selected)
    var next = app_set_selected(app_set_world(app, world), first_live(world))
    next = app_clear_history(next)
    next = tool_set_mode(next, 0)
    return app_set_notice(next, "Deleted ${name}")
}

fn menu_apply(app: App, menu: Int, item: Int) -> App {
    var next = app_set_menu(app, 0 - 1)
    if menu == 0 {
        if item == 0 {
            return new_scene(next)
        }
        if item == 1 {
            return reset_demo(next)
        }
        return app_quit(next)
    }
    if menu == 1 {
        if item == 0 {
            return edit_undo(next)
        }
        if item == 1 {
            return edit_redo(next)
        }
        if item == 2 {
            return duplicate_selected(next)
        }
        return delete_selected(next)
    }
    if menu == 2 {
        return app_set_notice(next, "Asset pipeline is not implemented yet")
    }
    if menu == 3 {
        if item == 0 {
            return create_cube(next)
        }
        if item == 1 {
            return create_camera(next)
        }
        if item == 2 {
            return duplicate_selected(next)
        }
        return delete_selected(next)
    }
    if menu == 4 {
        return app_set_notice(next, "No component types registered yet")
    }
    if menu == 5 {
        if item == 0 {
            return panel_toggle(next, 0)
        }
        if item == 1 {
            return panel_toggle(next, 1)
        }
        return panel_toggle(next, 2)
    }
    return app_set_notice(next, "Nova Engine Studio ${app_version()} · pure Nova editor")
}

// ---------- formatting ----------

fn radians(degrees: Int) -> Int {
    return fx_mul(fx(degrees), fx_div(fx_pi(), fx(180)))
}

fn fixed2(value: Int) -> String {
    var v = value
    var sign = ""
    if v < 0 {
        sign = "-"
        v = 0 - v
    }
    var whole = v / 65536
    var fraction = ((v % 65536) * 100 + 32768) / 65536
    if fraction >= 100 {
        fraction = 0
        whole = whole + 1
    }
    var pad = ""
    if fraction < 10 {
        pad = "0"
    }
    return "${sign}${whole}.${pad}${fraction}"
}

fn clamp_int(value: Int, low: Int, high: Int) -> Int {
    if value < low {
        return low
    }
    if value > high {
        return high
    }
    return value
}

fn parse_int(text: String) -> Int {
    let chars = text.trim().chars()
    if chars.len() == 0 {
        return 0
    }
    var i = 0
    var negative = false
    if chars[0] == "-" {
        negative = true
        i = 1
    }
    var value = 0
    while i < chars.len() {
        let code = chars[i].bytes()[0]
        if code < 48 || code > 57 {
            return 0
        }
        value = value * 10 + (code - 48)
        i = i + 1
    }
    if negative {
        return 0 - value
    }
    return value
}

fn bool_value(value: Bool) -> Int {
    if value {
        return 1
    }
    return 0
}

fn default_layout_path() -> String {
    let override = gui.env("NOVA_SCENE_LAYOUT")
    if override.len() > 0 {
        return override
    }
    let home = gui.env("HOME")
    if home.len() == 0 {
        return "target/scene-layout.txt"
    }
    return home + "/Library/Application Support/Nova Engine Studio/layout.txt"
}

// `gui.write` deliberately does not create directories. The layout file gets
// the same missing-parent treatment as a capture path.
fn ensure_parent_dir(path: String) {
    let parts = path.split("/")
    if parts.len() < 2 {
        return
    }
    var current = ""
    if path.starts_with("/") {
        current = "/"
    }
    var i = 0
    while i < parts.len() - 1 {
        let part = parts[i]
        if part.len() > 0 {
            if current.len() == 0 {
                current = part
            } else if current == "/" {
                current = "/" + part
            } else {
                current = current + "/" + part
            }
            gui.mkdir(current)
        }
        i = i + 1
    }
}

fn default_panels() -> Panels {
    return Panels {
        left: 252,
        right: 304,
        drawer: 196,
        hierarchy: true,
        inspector: true,
        drawer_open: true,
        drag: 0,
        drag_origin: 0,
        drag_start: 0,
        path: default_layout_path(),
    }
}

fn load_panels() -> Panels {
    var panels = default_panels()
    let data = gui.read(panels.path)
    if data.len() == 0 {
        return panels
    }
    for line in data.split("\n") {
        let parts = line.trim().split("=")
        if parts.len() == 2 {
            let key = parts[0].trim()
            let value = parts[1].trim()
            if key == "left" {
                panels.left = clamp_int(parse_int(value), 180, 420)
            }
            if key == "right" {
                panels.right = clamp_int(parse_int(value), 220, 460)
            }
            if key == "drawer" {
                panels.drawer = clamp_int(parse_int(value), 120, 320)
            }
            if key == "hierarchy" {
                panels.hierarchy = parse_int(value) == 1
            }
            if key == "inspector" {
                panels.inspector = parse_int(value) == 1
            }
            if key == "drawer_open" {
                panels.drawer_open = parse_int(value) == 1
            }
        }
    }
    return panels
}

fn save_panels(panels: Panels) -> Bool {
    ensure_parent_dir(panels.path)
    let data = "version=1\nleft=${panels.left}\nright=${panels.right}\ndrawer=${panels.drawer}\nhierarchy=${bool_value(panels.hierarchy)}\ninspector=${bool_value(panels.inspector)}\ndrawer_open=${bool_value(panels.drawer_open)}\n"
    return gui.write(panels.path, data)
}

// ---------- inspector editing and undo ----------

fn edit_field_name(field: Int) -> String {
    if field == 0 {
        return "Position"
    }
    if field == 1 {
        return "Rotation"
    }
    if field == 2 {
        return "Scale"
    }
    return "Transform"
}

fn edit_field_from_env(name: String) -> Int {
    if name == "position" {
        return 0
    }
    if name == "rotation" {
        return 1
    }
    if name == "scale" {
        return 2
    }
    return 0 - 1
}

fn edit_values_for(world: World, id: EntityId, field: Int) -> EditValues {
    if field == 1 {
        let rotation = world_rotation(world, id)
        return EditValues { w: rotation.w, x: rotation.x, y: rotation.y, z: rotation.z }
    }
    var value = world_position(world, id)
    if field == 2 {
        value = world_scale(world, id)
    }
    return EditValues { w: 0, x: value.x, y: value.y, z: value.z }
}

fn edit_values_text(field: Int, values: EditValues) -> String {
    if field == 1 {
        return "${fixed2(values.w)}, ${fixed2(values.x)}, ${fixed2(values.y)}, ${fixed2(values.z)}"
    }
    return "${fixed2(values.x)}, ${fixed2(values.y)}, ${fixed2(values.z)}"
}

fn edit_values_equal(a: EditValues, b: EditValues) -> Bool {
    if a.w != b.w || a.x != b.x || a.y != b.y || a.z != b.z {
        return false
    }
    return true
}

fn edit_apply(world: World, command: EditCommand, after: Bool) -> World {
    let values = if after { command.after } else { command.before }
    if command.field == 0 {
        return world_set_position(world, command.entity, vec3(values.x, values.y, values.z))
    }
    if command.field == 1 {
        return world_set_rotation(world, command.entity, Quat { w: values.w, x: values.x, y: values.y, z: values.z })
    }
    if command.field == 2 {
        return world_set_scale(world, command.entity, vec3(values.x, values.y, values.z))
    }
    return world
}

fn history_keep(history: List<EditCommand>, at: Int) -> List<EditCommand> {
    var out: List<EditCommand> = []
    var i = 0
    while i < at && i < history.len() {
        out.push(history[i])
        i = i + 1
    }
    return out
}

fn history_tail(history: List<EditCommand>) -> List<EditCommand> {
    if history.len() <= 16 {
        return history
    }
    var out: List<EditCommand> = []
    var i = history.len() - 16
    while i < history.len() {
        out.push(history[i])
        i = i + 1
    }
    return out
}

fn history_record(history: List<EditCommand>, at: Int, command: EditCommand) -> List<EditCommand> {
    var out = history_keep(history, at)
    out.push(command)
    return history_tail(out)
}

// Parses a decimal field into Q16.16. Invalid input is reported, never
// silently rounded to zero, so a typo cannot move an entity to the origin.
fn parse_fixed(text: String) -> ParsedNumber {
    let chars = text.trim().chars()
    if chars.len() == 0 {
        return ParsedNumber { ok: false, value: 0 }
    }
    var i = 0
    var negative = false
    if chars[0] == "-" {
        negative = true
        i = 1
    }
    if i >= chars.len() {
        return ParsedNumber { ok: false, value: 0 }
    }
    var whole = 0
    var fraction = 0
    var digits = 0
    var fraction_digits = 0
    var dot = false
    while i < chars.len() {
        let ch = chars[i]
        if ch == "." {
            if dot {
                return ParsedNumber { ok: false, value: 0 }
            }
            dot = true
            i = i + 1
            continue
        }
        let code = ch.bytes()[0]
        if code < 48 || code > 57 {
            return ParsedNumber { ok: false, value: 0 }
        }
        let digit = code - 48
        if dot {
            if fraction_digits < 5 {
                fraction = fraction * 10 + digit
                fraction_digits = fraction_digits + 1
            }
        } else {
            whole = whole * 10 + digit
        }
        digits = digits + 1
        i = i + 1
    }
    if digits == 0 {
        return ParsedNumber { ok: false, value: 0 }
    }
    var denom = 1
    var k = 0
    while k < fraction_digits {
        denom = denom * 10
        k = k + 1
    }
    let scaled = (fraction * 65536 + denom / 2) / denom
    var value = whole * 65536 + scaled
    if negative {
        value = 0 - value
    }
    return ParsedNumber { ok: true, value: value }
}

fn parse_edit_values(text: String, field: Int) -> EditParse {
    let parts = text.split(",")
    let wanted = if field == 1 { 4 } else { 3 }
    if parts.len() != wanted {
        return EditParse { ok: false, values: EditValues { w: 0, x: 0, y: 0, z: 0 } }
    }
    let a = parse_fixed(parts[0])
    let b = parse_fixed(parts[1])
    let c = parse_fixed(parts[2])
    if !a.ok || !b.ok || !c.ok {
        return EditParse { ok: false, values: EditValues { w: 0, x: 0, y: 0, z: 0 } }
    }
    if field == 1 {
        let d = parse_fixed(parts[3])
        if !d.ok {
            return EditParse { ok: false, values: EditValues { w: 0, x: 0, y: 0, z: 0 } }
        }
        return EditParse { ok: true, values: EditValues { w: a.value, x: b.value, y: c.value, z: d.value } }
    }
    return EditParse { ok: true, values: EditValues { w: 0, x: a.value, y: b.value, z: c.value } }
}

fn edit_begin(app: App, field: Int) -> App {
    if entity_is_none(app.selected) || !world_has(app.world, app.selected) {
        return app
    }
    let values = edit_values_for(app.world, app.selected, field)
    let notice = "Editing ${edit_field_name(field)} · Enter applies · Esc cancels"
    return app_set_edit(app_set_notice(app, notice), field, edit_values_text(field, values), true)
}

fn edit_commit(app: App) -> App {
    if app.edit_field < 0 {
        return app
    }
    if entity_is_none(app.selected) || !world_has(app.world, app.selected) {
        return app_set_edit(app, 0 - 1, "", false)
    }
    let parsed = parse_edit_values(app.edit_text, app.edit_field)
    if !parsed.ok {
        var hint = "Enter 3 numbers: x, y, z"
        if app.edit_field == 1 {
            hint = "Enter 4 numbers: w, x, y, z"
        }
        return app_set_notice(app, hint)
    }
    let before = edit_values_for(app.world, app.selected, app.edit_field)
    if edit_values_equal(before, parsed.values) {
        return app_set_edit(app_set_notice(app, "No transform change"), 0 - 1, "", false)
    }
    let command = EditCommand { entity: app.selected, field: app.edit_field, before: before, after: parsed.values }
    let world = edit_apply(app.world, command, true)
    let history = history_record(app.history, app.history_at, command)
    let notice = "Applied ${edit_field_name(command.field)} · ⌘Z undoes"
    return app_set_history(app_set_edit(app_set_world(app_set_notice(app, notice), world), 0 - 1, "", false), history, history.len())
}

fn edit_undo(app: App) -> App {
    if app.history_at <= 0 {
        return app_set_notice(app, "Nothing to undo")
    }
    let command = app.history[app.history_at - 1]
    let world = edit_apply(app.world, command, false)
    let notice = "Undo ${edit_field_name(command.field)} · ⇧⌘Z redoes"
    return app_set_history(app_set_edit(app_set_world(app_set_notice(app, notice), world), 0 - 1, "", false), app.history, app.history_at - 1)
}

fn edit_redo(app: App) -> App {
    if app.history_at >= app.history.len() {
        return app_set_notice(app, "Nothing to redo")
    }
    let command = app.history[app.history_at]
    let world = edit_apply(app.world, command, true)
    let notice = "Redo ${edit_field_name(command.field)} · ⌘Z undoes"
    return app_set_history(app_set_edit(app_set_world(app_set_notice(app, notice), world), 0 - 1, "", false), app.history, app.history_at + 1)
}

fn edit_drop_last(text: String) -> String {
    let chars = text.chars()
    if chars.len() == 0 {
        return ""
    }
    var out = ""
    var i = 0
    while i < chars.len() - 1 {
        out = out + chars[i]
        i = i + 1
    }
    return out
}

fn edit_allowed_char(ch: String) -> Bool {
    return "0123456789.,- ".contains(ch)
}

fn handle_text(app: App, text: String) -> App {
    if app.edit_field < 0 || text.len() == 0 {
        return app
    }
    var next = if app.edit_fresh { "" } else { app.edit_text }
    for ch in text.chars() {
        if edit_allowed_char(ch) && next.len() < 64 {
            next = next + ch
        }
    }
    return app_set_edit(app, app.edit_field, next, false)
}

fn inspector_field_at(p: Panels, x: Int, y: Int) -> Int {
    if x < inspector_inner_x(p) || x >= inspector_inner_x(p) + inspector_inner_w(p) {
        return 0 - 1
    }
    var field = 0
    while field < 3 {
        let row_y = inspector_field_y(field)
        if y >= row_y && y < row_y + 24 {
            return field
        }
        field = field + 1
    }
    return 0 - 1
}

fn edit_hit(app: App, x: Int, y: Int) -> Bool {
    if app.edit_field < 0 {
        return false
    }
    let row_y = inspector_field_y(app.edit_field)
    return x >= inspector_inner_x(app.panels) && x < inspector_inner_x(app.panels) + inspector_inner_w(app.panels) && y >= row_y && y < row_y + 24
}

fn tag_name(tag: Int) -> String {
    if tag == 1 {
        return "Ground"
    }
    if tag == 2 {
        return "Crate"
    }
    if tag == 3 {
        return "Player"
    }
    if tag == 4 {
        return "Key Light"
    }
    if tag == 5 {
        return "Pedestal"
    }
    if tag == 6 {
        return "Game Camera"
    }
    return "Entity"
}

fn entity_name(world: World, id: EntityId) -> String {
    if entity_is_none(id) {
        return "Nothing selected"
    }
    let tag = world_tag(world, id)
    if tag == 2 {
        return "Crate ${id.index}"
    }
    return tag_name(tag)
}

fn tag_colour(tag: Int, theme: gui.Theme) -> Int {
    if tag == 1 {
        return theme.border_strong
    }
    if tag == 2 {
        return theme.orange
    }
    if tag == 3 {
        return theme.blue
    }
    if tag == 4 {
        return theme.yellow
    }
    if tag == 5 {
        return theme.green
    }
    if tag == 6 {
        return theme.purple
    }
    return theme.muted
}

// ---------- projection ----------

fn make_view(x: Int, y: Int, w: Int, h: Int) -> View3D {
    let eye = vec3(fx(6), fx(4), fx(8))
    let target = vec3(0, fx_ratio(1, 2), 0)
    let up = vec3(0, 65536, 0)
    let view = mat4_look_at(eye, target, up)
    let fov = fx_mul(fx(42), fx_div(fx_pi(), fx(180)))
    let projection = mat4_perspective(fov, fx_ratio(w, h), fx_ratio(1, 10), fx(60))
    return View3D { x: x, y: y, w: w, h: h, vp: mat4_mul(projection, view) }
}

// Game mode uses the scene's camera entity. Position and rotation are ordinary
// World components, so moving or rotating the Game Camera in the inspector is
// immediately visible without a separate runtime camera API.
fn make_game_view(app: App, x: Int, y: Int, w: Int, h: Int) -> View3D {
    let camera = find_tag(app.world, 6)
    if entity_is_none(camera) || !world_has(app.world, camera) {
        return make_view(x, y, w, h)
    }
    let eye = world_position(app.world, camera)
    let rotation = world_rotation(app.world, camera)
    let forward = quat_rotate_vec3(rotation, vec3(0, 0, 0 - 65536))
    let up = quat_rotate_vec3(rotation, vec3(0, 65536, 0))
    let target = v3_add(eye, forward)
    let view = mat4_look_at(eye, target, up)
    let fov = fx_mul(fx(50), fx_div(fx_pi(), fx(180)))
    let projection = mat4_perspective(fov, fx_ratio(w, h), fx_ratio(1, 10), fx(60))
    return View3D { x: x, y: y, w: w, h: h, vp: mat4_mul(projection, view) }
}

fn view_for(app: App, x: Int, y: Int, w: Int, h: Int) -> View3D {
    if app.tab == 1 {
        return make_game_view(app, x, y, w, h)
    }
    return make_view(x, y, w, h)
}

fn project(view: View3D, point: Vec3) -> Vec3 {
    let ndc = mat4_transform_point(view.vp, point)
    let px = view.x + (ndc.x + 65536) * view.w / 131072
    let py = view.y + (65536 - ndc.y) * view.h / 131072
    return Vec3 { x: px, y: py, z: ndc.z }
}

fn project_ok(point: Vec3) -> Bool {
    return point.z > 0 - 65536 && point.z < 65536
}

// ---------- Metal viewport ----------

fn metal_add_mvp(handle: Int, mvp: Mat4) -> Int {
    return metal_scene_add(handle,
        mat4_get(mvp, 0, 0), mat4_get(mvp, 0, 1), mat4_get(mvp, 0, 2), mat4_get(mvp, 0, 3),
        mat4_get(mvp, 1, 0), mat4_get(mvp, 1, 1), mat4_get(mvp, 1, 2), mat4_get(mvp, 1, 3),
        mat4_get(mvp, 2, 0), mat4_get(mvp, 2, 1), mat4_get(mvp, 2, 2), mat4_get(mvp, 2, 3),
        mat4_get(mvp, 3, 0), mat4_get(mvp, 3, 1), mat4_get(mvp, 3, 2), mat4_get(mvp, 3, 3))
}

// The Metal lab's lit mesh is 1.3 units wide. World scales are in metres, so
// the model scale compensates for that mesh size instead of changing the
// established lab geometry and its pixel baselines.
fn metal_mesh_scale(scale: Vec3) -> Vec3 {
    let unit = fx_ratio(10, 13)
    return vec3(fx_mul(scale.x, unit), fx_mul(scale.y, unit), fx_mul(scale.z, unit))
}

fn metal_entity_mvp(world: World, id: EntityId, view: View3D) -> Mat4 {
    let model = mat4_mul(mat4_translation(world_position(world, id)),
        mat4_mul(mat4_rotation(world_rotation(world, id)),
            mat4_scaling(metal_mesh_scale(world_scale(world, id)))))
    return mat4_mul(view.vp, model)
}

fn draw_metal_scene(app: App, view: View3D, editor: Bool) -> Bool {
    if app.metal == 0 {
        return false
    }
    metal_scene_clear(app.metal)
    var scene_ok = true
    var i = 0
    while i < world_capacity(app.world) {
        if app.world.pool.alive[i] {
            let id = EntityId { index: i, generation: app.world.pool.generations[i] }
            let is_camera = app.world.tags[i] == 6
            if editor || !is_camera {
                if metal_add_mvp(app.metal, metal_entity_mvp(app.world, id, view)) != 1 {
                    scene_ok = false
                }
            }
        }
        i = i + 1
    }
    if !scene_ok {
        return false
    }
    let scale = gui.scale()
    if metal_render_frame(app.metal, view.w * scale, view.h * scale) != 1 {
        return false
    }
    return gui.metal_frame(view.x, view.y, view.w, view.h)
}

fn start_metal(p: Panels) -> Int {
    let handle = metal_offscreen(centre_w(p), view_h(p))
    if handle == 0 {
        println("scene-gui: metal unavailable: ${metal_last_error()}")
        return 0
    }
    let checker = metal_texture_checker(handle)
    let geometry = metal_geometry(handle, 2)
    let light = metal_light(handle, 1, fx_ratio(9, 20), fx_ratio(17, 20), fx_ratio(11, 20))
    if checker != 1 || geometry != 1 || light != 1 {
        println("scene-gui: metal viewport setup failed: ${metal_last_error()}")
        metal_shutdown(handle)
        return 0
    }
    return handle
}

fn corner(world: World, id: EntityId, sx: Int, sy: Int, sz: Int) -> Vec3 {
    let scale = world_scale(world, id)
    var hx = scale.x / 2
    var hy = scale.y / 2
    var hz = scale.z / 2
    if sx < 0 {
        hx = 0 - hx
    }
    if sy < 0 {
        hy = 0 - hy
    }
    if sz < 0 {
        hz = 0 - hz
    }
    let local = vec3(hx, hy, hz)
    let rotated = quat_rotate_vec3(world_rotation(world, id), local)
    return v3_add(world_position(world, id), rotated)
}

// ---------- drawing helpers ----------

fn label(x: Int, y: Int, value: String, theme: gui.Theme) {
    gui.text(x, y, value, 10, theme.faint)
}

fn section_title(x: Int, y: Int, w: Int, title: String, theme: gui.Theme) {
    gui.rect(x, y, w, 28, theme.elevated)
    gui.line(x, y + 27, x + w, y + 27, theme.border)
    gui.text(x + 11, y + 8, title, 11, theme.fg_bright)
}

fn field_row(x: Int, y: Int, w: Int, name: String, value: String, theme: gui.Theme) {
    gui.text(x + 11, y + 5, name, 10, theme.faint)
    let value_w = gui.text_width(value, 11)
    gui.text(x + w - 11 - value_w, y + 3, value, 11, theme.fg)
    gui.line(x + 11, y + 22, x + w - 11, y + 22, theme.border)
}

fn transform_row(app: App, x: Int, y: Int, w: Int, name: String, field: Int, value: String, theme: gui.Theme) {
    let active = app.edit_field == field
    gui.text(x + 11, y + 5, name, 10, theme.faint)
    let box_x = x + 72
    let box_w = w - 83
    var fill = theme.bg_hard
    var border = theme.border
    var colour = theme.fg
    if active {
        fill = theme.input
        border = theme.accent
        colour = theme.fg_bright
    }
    gui.round_rect(box_x, y + 1, box_w, 20, 3, fill)
    gui.stroke(box_x, y + 1, box_w, 20, border)
    var shown = value
    if active {
        shown = app.edit_text
    }
    gui.text(box_x + 7, y + 4, shown, 10, colour)
    gui.line(x + 11, y + 22, x + w - 11, y + 22, theme.border)
}

fn draw_history_button(x: Int, y: Int, enabled: Bool, label: String, theme: gui.Theme) {
    var fill = theme.bg_hard
    var border = theme.border
    var colour = theme.faint
    if enabled {
        fill = theme.input
        border = theme.border_strong
        colour = theme.fg
    }
    gui.round_rect(x, y, 38, 18, 4, fill)
    gui.stroke(x, y, 38, 18, border)
    gui.text(x + (38 - gui.text_width(label, 9)) / 2, y + 3, label, 9, colour)
}

fn component_card(x: Int, y: Int, w: Int, h: Int, theme: gui.Theme) {
    gui.round_rect(x, y, w, h, 6, theme.panel)
    gui.stroke(x, y, w, h, theme.border)
}

fn icon_box(x: Int, y: Int, colour: Int, theme: gui.Theme) {
    gui.round_rect(x, y, 10, 10, 2, colour)
    gui.stroke(x, y, 10, 10, theme.bg_hard)
}

fn draw_play_icon(x: Int, y: Int, colour: Int) {
    gui.line(x, y, x, y + 12, colour)
    gui.line(x, y, x + 9, y + 6, colour)
    gui.line(x + 9, y + 6, x, y + 12, colour)
}

fn draw_pause_icon(x: Int, y: Int, colour: Int) {
    gui.rect(x, y, 3, 12, colour)
    gui.rect(x + 7, y, 3, 12, colour)
}

fn draw_step_icon(x: Int, y: Int, colour: Int) {
    gui.line(x, y, x, y + 12, colour)
    gui.line(x, y, x + 8, y + 6, colour)
    gui.line(x + 8, y + 6, x, y + 12, colour)
    gui.rect(x + 10, y, 2, 12, colour)
}

fn draw_tool_button(x: Int, y: Int, w: Int, active: Bool, theme: gui.Theme, kind: Int) {
    var fill = theme.panel
    if active {
        fill = theme.selection
    }
    gui.round_rect(x, y, w, 24, 5, fill)
    gui.stroke(x, y, w, 24, theme.border)
    var colour = theme.muted
    if active {
        colour = theme.fg_bright
    }
    if kind == 0 {
        draw_play_icon(x + 11, y + 6, colour)
    }
    if kind == 1 {
        draw_pause_icon(x + 10, y + 6, colour)
    }
    if kind == 2 {
        draw_step_icon(x + 9, y + 6, colour)
    }
}

fn draw_text_tool(x: Int, y: Int, w: Int, label: String, active: Bool, enabled: Bool, theme: gui.Theme) {
    var fill = theme.panel
    var border = theme.border
    var colour = theme.muted
    if active {
        fill = theme.selection
        border = theme.border_strong
        colour = theme.fg_bright
    }
    if !enabled {
        fill = theme.bg_hard
        colour = theme.faint
    }
    gui.round_rect(x, y, w, 24, 5, fill)
    gui.stroke(x, y, w, 24, border)
    gui.text(x + (w - gui.text_width(label, 9)) / 2, y + 7, label, 9, colour)
}

// ---------- menu bar ----------

fn menu_count() -> Int {
    return 7
}

fn menu_label(index: Int) -> String {
    if index == 0 {
        return "File"
    }
    if index == 1 {
        return "Edit"
    }
    if index == 2 {
        return "Assets"
    }
    if index == 3 {
        return "GameObject"
    }
    if index == 4 {
        return "Component"
    }
    if index == 5 {
        return "Window"
    }
    return "Help"
}

fn menu_start_x() -> Int {
    let brand_x = traffic_inset()
    let engine_x = brand_x + gui.text_width("Nova", 13) + 5
    return engine_x + gui.text_width("Engine", 13) + 28
}

fn menu_label_x(index: Int) -> Int {
    var x = menu_start_x()
    var i = 0
    while i < index && i < menu_count() {
        x = x + gui.text_width(menu_label(i), 11) + 18
        i = i + 1
    }
    return x
}

fn menu_label_w(index: Int) -> Int {
    return gui.text_width(menu_label(index), 11) + 12
}

fn menu_at(x: Int, y: Int) -> Int {
    if y < 0 || y >= menu_h() {
        return 0 - 1
    }
    var i = 0
    while i < menu_count() {
        let left = menu_label_x(i) - 6
        if x >= left && x < left + menu_label_w(i) {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn menu_drop_x(menu: Int) -> Int {
    return menu_label_x(menu) - 8
}

fn menu_drop_y() -> Int {
    return menu_h() + 2
}

fn menu_drop_w() -> Int {
    return 220
}

fn menu_item_h() -> Int {
    return 26
}

fn menu_item_count(menu: Int) -> Int {
    if menu == 0 {
        return 3
    }
    if menu == 1 || menu == 3 {
        return 4
    }
    if menu == 5 {
        return 3
    }
    if menu == 2 || menu == 4 || menu == 6 {
        return 1
    }
    return 0
}

fn menu_item_label(menu: Int, item: Int) -> String {
    if menu == 0 {
        if item == 0 {
            return "New Scene"
        }
        if item == 1 {
            return "Reset Demo"
        }
        return "Quit"
    }
    if menu == 1 {
        if item == 0 {
            return "Undo"
        }
        if item == 1 {
            return "Redo"
        }
        if item == 2 {
            return "Duplicate"
        }
        return "Delete"
    }
    if menu == 2 {
        return "Asset pipeline not available"
    }
    if menu == 3 {
        if item == 0 {
            return "Create Cube"
        }
        if item == 1 {
            return "Create Camera"
        }
        if item == 2 {
            return "Duplicate"
        }
        return "Delete"
    }
    if menu == 4 {
        return "Add Component not available"
    }
    if menu == 5 {
        if item == 0 {
            return "Hierarchy"
        }
        if item == 1 {
            return "Inspector"
        }
        return "Drawer"
    }
    return "About Nova Engine Studio"
}

fn menu_item_shortcut(menu: Int, item: Int) -> String {
    if menu == 0 && item == 2 {
        return "⌘Q"
    }
    if menu == 1 {
        if item == 0 {
            return "⌘Z"
        }
        if item == 1 {
            return "⇧⌘Z"
        }
        if item == 2 {
            return "⌘D"
        }
        return "⌫"
    }
    if menu == 3 {
        if item == 2 {
            return "⌘D"
        }
        if item == 3 {
            return "⌫"
        }
    }
    return ""
}

fn menu_item_at(app: App, x: Int, y: Int) -> Int {
    let menu = app.tool.menu
    if menu < 0 {
        return 0 - 1
    }
    let left = menu_drop_x(menu)
    let top = menu_drop_y() + 4
    if x < left || x >= left + menu_drop_w() || y < top {
        return 0 - 1
    }
    let item = (y - top) / menu_item_h()
    if item < 0 || item >= menu_item_count(menu) {
        return 0 - 1
    }
    return item
}

// ---------- top chrome ----------

fn draw_panel_chip(x: Int, y: Int, label: String, on: Bool, theme: gui.Theme) {
    var fill = theme.bg_hard
    var border = theme.border
    var colour = theme.faint
    if on {
        fill = theme.selection
        border = theme.border_strong
        colour = theme.fg_bright
    }
    gui.round_rect(x, y, panel_chip_w(), 18, 3, fill)
    gui.stroke(x, y, panel_chip_w(), 18, border)
    gui.text(x + (panel_chip_w() - gui.text_width(label, 9)) / 2, y + 3, label, 9, colour)
}

fn draw_top(app: App, theme: gui.Theme) {
    // Full-size content puts the native buttons over the menu strip. Keep them
    // in that strip but stop the title and menu from running underneath them.
    gui.place_traffic_lights(14)
    gui.rect(0, 0, window_w(), menu_h(), theme.bg_hard)
    let brand_x = traffic_inset()
    gui.text(brand_x, 7, "Nova", 13, theme.fg_bright)
    let engine_x = brand_x + gui.text_width("Nova", 13) + 5
    gui.text(engine_x, 7, "Engine", 13, theme.accent)
    var menu_index = 0
    while menu_index < menu_count() {
        let menu_x = menu_label_x(menu_index)
        if app.tool.menu == menu_index {
            gui.round_rect(menu_x - 6, 2, menu_label_w(menu_index), 24, 3, theme.selection)
        }
        gui.text(menu_x, 8, menu_label(menu_index), 11, if app.tool.menu == menu_index { theme.fg_bright } else { theme.muted })
        menu_index = menu_index + 1
    }
    draw_panel_chip(panel_chip_x(0), panel_chip_y(), "Hier", app.panels.hierarchy, theme)
    draw_panel_chip(panel_chip_x(1), panel_chip_y(), "Insp", app.panels.inspector, theme)
    draw_panel_chip(panel_chip_x(2), panel_chip_y(), "Draw", app.panels.drawer_open, theme)
    let version = app_version()
    gui.text(window_w() - 18 - gui.text_width(version, 10), 9, version, 10, theme.faint)
    gui.line(0, menu_h() - 1, window_w(), menu_h() - 1, theme.border)

    gui.rect(0, menu_h(), window_w(), strip_h(), theme.panel)
    gui.text_fmt(18, menu_h() + 9, "Demo Scene", 13, theme.fg_bright, gui.font_sans(), gui.style_bold())
    gui.text(18 + gui.text_width("Demo Scene", 13) + 10, menu_h() + 11, "·  unsaved", 10, theme.faint)
    gui.text(centre_x(app.panels) + 18, menu_h() + 10, "Nova Engine Studio", 11, theme.muted)
    let live = "${world_live_count(app.world)} entities"
    let rate = "60 Hz"
    gui.text(window_w() - 18 - gui.text_width(rate, 10), menu_h() + 11, rate, 10, theme.faint)
    gui.text(window_w() - 34 - gui.text_width(rate, 10) - gui.text_width(live, 10), menu_h() + 11, live, 10, theme.muted)
    gui.line(0, menu_h() + strip_h() - 1, window_w(), menu_h() + strip_h() - 1, theme.border)
}

fn draw_menu(app: App, theme: gui.Theme) {
    let menu = app.tool.menu
    if menu < 0 {
        return
    }
    let x = menu_drop_x(menu)
    let y = menu_drop_y()
    let w = menu_drop_w()
    let h = menu_item_count(menu) * menu_item_h() + 8
    gui.round_rect(x + 3, y + 3, w, h, 6, theme.bg_hard)
    gui.round_rect(x, y, w, h, 6, theme.elevated)
    gui.stroke(x, y, w, h, theme.border_strong)
    var item = 0
    while item < menu_item_count(menu) {
        let row_y = y + 4 + item * menu_item_h()
        let label = menu_item_label(menu, item)
        gui.text(x + 12, row_y + 7, label, 11, theme.fg)
        let shortcut = menu_item_shortcut(menu, item)
        if shortcut.len() > 0 {
            gui.text(x + w - 12 - gui.text_width(shortcut, 9), row_y + 8, shortcut, 9, theme.faint)
        }
        item = item + 1
    }
}

// ---------- hierarchy ----------

fn hierarchy_row_y(n: Int) -> Int {
    return hierarchy_first_row() + n * hierarchy_row_h()
}

fn hierarchy_pick(world: World, p: Panels, x: Int, y: Int) -> EntityId {
    if x < 0 || x >= left_w(p) {
        return entity_none()
    }
    var n = 0
    var i = 0
    while i < world_capacity(world) {
        if world.pool.alive[i] {
            let row_y = hierarchy_row_y(n)
            if y >= row_y && y < row_y + hierarchy_row_h() {
                return EntityId { index: i, generation: world.pool.generations[i] }
            }
            n = n + 1
        }
        i = i + 1
    }
    return entity_none()
}

fn draw_hierarchy(app: App, theme: gui.Theme) {
    gui.rect(0, body_y(), left_w(app.panels), body_h(app.panels), theme.panel)
    gui.line(left_w(app.panels) - 1, body_y(), left_w(app.panels) - 1, drawer_y(app.panels), theme.border_strong)
    gui.text(16, body_y() + 13, "HIERARCHY", 10, theme.faint)

    let header_y = body_y() + 30
    gui.rect(0, header_y, left_w(app.panels), 30, theme.elevated)
    gui.text(14, header_y + 8, "▾", 12, theme.fg)
    gui.text(32, header_y + 8, "Demo Scene", 12, theme.fg_bright)
    let count = "${world_live_count(app.world)}"
    gui.text(left_w(app.panels) - 16 - gui.text_width(count, 10), header_y + 10, count, 10, theme.faint)

    var n = 0
    var i = 0
    while i < world_capacity(app.world) {
        if app.world.pool.alive[i] {
            let id = EntityId { index: i, generation: app.world.pool.generations[i] }
            let y = hierarchy_row_y(n)
            let selected = entity_eq(id, app.selected)
            if selected {
                gui.rect(0, y, left_w(app.panels), hierarchy_row_h() - 2, theme.selection)
                gui.rect(0, y, 3, hierarchy_row_h() - 2, theme.accent)
            }
            let colour = tag_colour(app.world.tags[i], theme)
            icon_box(22, y + 8, colour, theme)
            var text_colour = theme.fg
            if selected {
                text_colour = theme.fg_bright
            }
            gui.text(42, y + 4, entity_name(app.world, id), 12, text_colour)
            n = n + 1
        }
        i = i + 1
    }

    gui.line(0, drawer_y(app.panels) - 30, left_w(app.panels), drawer_y(app.panels) - 30, theme.border)
    let footer = "${world_live_count(app.world)} entities  ·  step ${world_step(app.world)}"
    gui.text(16, drawer_y(app.panels) - 22, footer, 10, theme.faint)
    let pending = "${world_pending_count(app.world)} pending"
    gui.text(left_w(app.panels) - 16 - gui.text_width(pending, 10), drawer_y(app.panels) - 22, pending, 10, theme.faint)
}

// ---------- scene / game viewport ----------

fn draw_grid(view: View3D, theme: gui.Theme) {
    var i = 0 - 6
    while i <= 6 {
        let a = project(view, vec3(fx(i), 0, fx(0 - 6)))
        let b = project(view, vec3(fx(i), 0, fx(6)))
        let c = project(view, vec3(fx(0 - 6), 0, fx(i)))
        let d = project(view, vec3(fx(6), 0, fx(i)))
        gui.line(a.x, a.y, b.x, b.y, theme.border)
        gui.line(c.x, c.y, d.x, d.y, theme.border)
        i = i + 1
    }
    let origin = project(view, vec3(0, 0, 0))
    let x_axis = project(view, vec3(fx(2), 0, 0))
    let y_axis = project(view, vec3(0, fx(2), 0))
    let z_axis = project(view, vec3(0, 0, fx(2)))
    gui.line(origin.x, origin.y, x_axis.x, x_axis.y, theme.red)
    gui.line(origin.x, origin.y, y_axis.x, y_axis.y, theme.green)
    gui.line(origin.x, origin.y, z_axis.x, z_axis.y, theme.blue)
}

fn draw_cube_line(a: Vec3, b: Vec3, colour: Int) {
    if project_ok(a) && project_ok(b) {
        gui.line(a.x, a.y, b.x, b.y, colour)
    }
}

fn draw_cube(world: World, id: EntityId, view: View3D, colour: Int) {
    let p0 = project(view, corner(world, id, 0 - 1, 0 - 1, 0 - 1))
    let p1 = project(view, corner(world, id, 1, 0 - 1, 0 - 1))
    let p2 = project(view, corner(world, id, 0 - 1, 1, 0 - 1))
    let p3 = project(view, corner(world, id, 1, 1, 0 - 1))
    let p4 = project(view, corner(world, id, 0 - 1, 0 - 1, 1))
    let p5 = project(view, corner(world, id, 1, 0 - 1, 1))
    let p6 = project(view, corner(world, id, 0 - 1, 1, 1))
    let p7 = project(view, corner(world, id, 1, 1, 1))

    draw_cube_line(p0, p1, colour)
    draw_cube_line(p1, p3, colour)
    draw_cube_line(p3, p2, colour)
    draw_cube_line(p2, p0, colour)
    draw_cube_line(p4, p5, colour)
    draw_cube_line(p5, p7, colour)
    draw_cube_line(p7, p6, colour)
    draw_cube_line(p6, p4, colour)
    draw_cube_line(p0, p4, colour)
    draw_cube_line(p1, p5, colour)
    draw_cube_line(p2, p6, colour)
    draw_cube_line(p3, p7, colour)
}

fn draw_scene_label(app: App, id: EntityId, view: View3D, theme: gui.Theme) {
    let centre = project(view, world_position(app.world, id))
    if project_ok(centre) && gui.inside(view.x, view.y, view.w, view.h, centre.x, centre.y) {
        let name = entity_name(app.world, id)
        let w = gui.text_width(name, 10) + 16
        gui.round_rect(centre.x + 8, centre.y - 22, w, 19, 4, theme.selection)
        gui.stroke(centre.x + 8, centre.y - 22, w, 19, theme.accent)
        gui.text(centre.x + 16, centre.y - 18, name, 10, theme.fg_bright)
        gui.stroke(centre.x - 10, centre.y - 10, 20, 20, theme.fg_bright)
        gui.stroke(centre.x - 12, centre.y - 12, 24, 24, theme.accent)
    }
}

fn draw_scene_entity(app: App, id: EntityId, view: View3D, theme: gui.Theme, editor: Bool) {
    let tag = world_tag(app.world, id)
    let selected = entity_eq(id, app.selected)
    var colour = tag_colour(tag, theme)
    if editor && selected {
        colour = theme.fg_bright
    }
    draw_cube(app.world, id, view, colour)
    if editor && selected {
        draw_scene_label(app, id, view, theme)
    }
}

fn draw_selected_overlay(app: App, view: View3D, theme: gui.Theme) {
    if entity_is_none(app.selected) || !world_has(app.world, app.selected) {
        return
    }
    draw_cube(app.world, app.selected, view, theme.fg_bright)
    draw_scene_label(app, app.selected, view, theme)
}

fn draw_cpu_scene(app: App, view: View3D, theme: gui.Theme, editor: Bool) {
    if editor && app.tool.grid {
        draw_grid(view, theme)
    }
    var pass = 0
    while pass < 2 {
        var i = 0
        while i < world_capacity(app.world) {
            if app.world.pool.alive[i] {
                let id = EntityId { index: i, generation: app.world.pool.generations[i] }
                let selected = entity_eq(id, app.selected)
                let is_camera = app.world.tags[i] == 6
                if (editor || !is_camera) && (!editor || (pass == 0 && !selected) || (pass == 1 && selected)) {
                    draw_scene_entity(app, id, view, theme, editor)
                }
            }
            i = i + 1
        }
        pass = pass + 1
    }
}

fn draw_viewport(app: App, theme: gui.Theme) {
    let x = centre_x(app.panels)
    let y = view_y()
    let w = centre_w(app.panels)
    let h = view_h(app.panels)
    gui.rect(x, y, w, h, theme.bg)
    gui.clip(x, y, w, h)
    let view = view_for(app, x, y, w, h)
    let editor = app.tab == 0
    let metal_drawn = draw_metal_scene(app, view, editor)
    if metal_drawn {
        if editor {
            if app.tool.grid {
                draw_grid(view, theme)
            }
            draw_selected_overlay(app, view, theme)
        }
    } else {
        draw_cpu_scene(app, view, theme, editor)
    }
    gui.clip_reset()

    var view_name = "SCENE"
    if app.tab == 1 {
        view_name = "GAME"
    }
    gui.text(x + 14, y + 12, view_name, 10, theme.faint)
    var projection = "Perspective"
    if !editor {
        projection = "Game Camera"
    }
    gui.text(x + w - 14 - gui.text_width(projection, 10), y + 12, projection, 10, theme.faint)
    if !editor {
        gui.text(x + 14, y + h - 24, "Game view · Game Camera · editor overlays hidden", 10, theme.faint)
    }
}

fn draw_centre(app: App, theme: gui.Theme) {
    let x = centre_x(app.panels)
    gui.rect(x, body_y(), centre_w(app.panels), body_h(app.panels), theme.panel)

    gui.rect(x, body_y(), centre_w(app.panels), tabs_h(), theme.panel)
    let scene_active = app.tab == 0
    let game_active = app.tab == 1
    if scene_active {
        gui.rect(scene_tab_x(app.panels), body_y(), 76, tabs_h(), theme.bg)
        gui.rect(scene_tab_x(app.panels), body_y() + tabs_h() - 2, 76, 2, theme.accent)
    }
    if game_active {
        gui.rect(game_tab_x(app.panels), body_y(), 76, tabs_h(), theme.bg)
        gui.rect(game_tab_x(app.panels), body_y() + tabs_h() - 2, 76, 2, theme.accent)
    }
    gui.text(scene_tab_x(app.panels) + 16, body_y() + 8, "Scene", 12, if scene_active { theme.fg_bright } else { theme.muted })
    gui.text(game_tab_x(app.panels) + 16, body_y() + 8, "Game", 12, if game_active { theme.fg_bright } else { theme.muted })
    gui.line(x, body_y() + tabs_h() - 1, x + centre_w(app.panels), body_y() + tabs_h() - 1, theme.border)

    gui.rect(x, body_y() + tabs_h(), centre_w(app.panels), toolbar_h(), theme.panel)
    gui.line(x, body_y() + tabs_h() + toolbar_h() - 1, x + centre_w(app.panels), body_y() + tabs_h() + toolbar_h() - 1, theme.border_strong)
    let ready = has_selection(app)
    draw_tool_button(play_x(app.panels), tool_button_y(), 30, app.playing, theme, 0)
    draw_tool_button(pause_x(app.panels), tool_button_y(), 30, false, theme, 1)
    draw_tool_button(step_x(app.panels), tool_button_y(), 30, false, theme, 2)
    gui.line(step_x(app.panels) + 42, tool_button_y() + 3, step_x(app.panels) + 42, tool_button_y() + 20, theme.border)
    draw_text_tool(select_tool_x(app.panels), tool_button_y(), tool_button_w(), "Sel", app.tool.mode == 0, true, theme)
    draw_text_tool(move_tool_x(app.panels), tool_button_y(), tool_button_w(), "Mov", app.tool.mode == 1, true, theme)
    draw_text_tool(rotate_tool_x(app.panels), tool_button_y(), tool_button_w(), "Rot", app.tool.mode == 2, true, theme)
    draw_text_tool(scale_tool_x(app.panels), tool_button_y(), tool_button_w(), "Scl", app.tool.mode == 3, true, theme)
    gui.line(scale_tool_x(app.panels) + 30, tool_button_y() + 3, scale_tool_x(app.panels) + 30, tool_button_y() + 20, theme.border)
    var snap_label = "Snap off"
    if app.tool.snap {
        snap_label = "Snap 0.5"
    }
    draw_text_tool(snap_x(app.panels), tool_button_y(), 44, snap_label, app.tool.snap, true, theme)
    draw_text_tool(grid_x(app.panels), tool_button_y(), 38, "Grid", app.tool.grid, true, theme)
    gui.line(grid_x(app.panels) + 42, tool_button_y() + 3, grid_x(app.panels) + 42, tool_button_y() + 20, theme.border)
    draw_text_tool(add_cube_x(app.panels), tool_button_y(), tool_button_w(), "Add", false, true, theme)
    draw_text_tool(duplicate_x(app.panels), tool_button_y(), tool_button_w(), "Dup", false, ready, theme)
    draw_text_tool(delete_x(app.panels), tool_button_y(), tool_button_w(), "Del", false, ready, theme)
    var mode = tool_mode_name(app.tool.mode)
    var snap_state = "SNAP OFF"
    if app.tool.snap {
        snap_state = "SNAP 0.5"
    }
    var status = mode + " · " + snap_state
    if app.tab == 1 {
        status = "GAME VIEW"
    }
    if app.playing {
        status = "PLAYING"
    }
    gui.text(x + centre_w(app.panels) - 16 - gui.text_width(status, 10), tool_button_y() + 6, status, 10, theme.faint)

    draw_viewport(app, theme)
}

// ---------- inspector ----------

fn draw_inspector(app: App, theme: gui.Theme) {
    let x = inspector_x(app.panels)
    gui.rect(x, body_y(), right_w(app.panels), body_h(app.panels), theme.panel)
    gui.line(x, body_y(), x, drawer_y(app.panels), theme.border_strong)
    gui.text(x + 16, body_y() + 13, "INSPECTOR", 10, theme.faint)
    draw_history_button(undo_x(app.panels), history_button_y(), app.history_at > 0, "Undo", theme)
    draw_history_button(redo_x(app.panels), history_button_y(), app.history_at < app.history.len(), "Redo", theme)

    let inner_x = inspector_inner_x(app.panels)
    let inner_w = inspector_inner_w(app.panels)
    if entity_is_none(app.selected) || !world_has(app.world, app.selected) {
        gui.text(x + 16, body_y() + 52, "Nothing selected", 14, theme.muted)
        gui.text(x + 16, body_y() + 76, "Select an entity in the", 11, theme.faint)
        gui.text(x + 16, body_y() + 94, "hierarchy or scene view.", 11, theme.faint)
        return
    }

    let name = entity_name(app.world, app.selected)
    let tag = world_tag(app.world, app.selected)
    icon_box(x + 16, body_y() + 47, tag_colour(tag, theme), theme)
    gui.text_fmt(x + 34, body_y() + 42, name, 16, theme.fg_bright, gui.font_sans(), gui.style_bold())
    gui.text(x + 16, body_y() + 70, "TAG ${tag}  ·  entity ${app.selected.index}:${app.selected.generation}", 10, theme.faint)

    let transform_y = inspector_transform_y()
    component_card(inner_x, transform_y, inner_w, 126, theme)
    section_title(inner_x, transform_y, inner_w, "Transform", theme)
    let position = world_position(app.world, app.selected)
    let rotation = world_rotation(app.world, app.selected)
    let scale = world_scale(app.world, app.selected)
    transform_row(app, inner_x, inspector_field_y(0), inner_w, "Position", 0, "${fixed2(position.x)}, ${fixed2(position.y)}, ${fixed2(position.z)}", theme)
    transform_row(app, inner_x, inspector_field_y(1), inner_w, "Rotation", 1, "${fixed2(rotation.w)}, ${fixed2(rotation.x)}, ${fixed2(rotation.y)}, ${fixed2(rotation.z)}", theme)
    transform_row(app, inner_x, inspector_field_y(2), inner_w, "Scale", 2, "${fixed2(scale.x)}, ${fixed2(scale.y)}, ${fixed2(scale.z)}", theme)
    gui.text(inner_x + 11, transform_y + 105, "Click a row to edit · Enter applies", 9, theme.faint)

    let velocity_y = transform_y + 136
    component_card(inner_x, velocity_y, inner_w, 102, theme)
    section_title(inner_x, velocity_y, inner_w, "Velocity", theme)
    let velocity = world_velocity(app.world, app.selected)
    field_row(inner_x, velocity_y + 30, inner_w, "Linear", "${fixed2(velocity.x)}, ${fixed2(velocity.y)}, ${fixed2(velocity.z)}", theme)
    field_row(inner_x, velocity_y + 54, inner_w, "Frame", "fixed 1/60 s", theme)

    let identity_y = velocity_y + 112
    component_card(inner_x, identity_y, inner_w, 102, theme)
    section_title(inner_x, identity_y, inner_w, "Entity", theme)
    field_row(inner_x, identity_y + 30, inner_w, "Tag", "${tag_name(tag)}  (${tag})", theme)
    field_row(inner_x, identity_y + 54, inner_w, "Handle", "${app.selected.index} : ${app.selected.generation}", theme)

    let world_y = identity_y + 112
    component_card(inner_x, world_y, inner_w, 126, theme)
    section_title(inner_x, world_y, inner_w, "World", theme)
    field_row(inner_x, world_y + 30, inner_w, "Step", "${world_step(app.world)}", theme)
    field_row(inner_x, world_y + 54, inner_w, "Gravity", fixed2(app.world.gravity), theme)
    field_row(inner_x, world_y + 78, inner_w, "Live / pending", "${world_live_count(app.world)}  /  ${world_pending_count(app.world)}", theme)

    let add_y = add_component_y(app.panels)
    gui.round_rect(inner_x, add_y, inner_w, 28, 5, theme.bg_hard)
    gui.stroke(inner_x, add_y, inner_w, 28, theme.border_strong)
    gui.text(inner_x + 12, add_y + 7, "+  Add Component", 11, theme.muted)
    if app.notice.len() > 0 {
        gui.text(inner_x + 12, add_y + 38, app.notice, 10, theme.faint)
    } else {
        gui.text(inner_x + 12, add_y + 38, "No component types registered yet.", 10, theme.faint)
    }
}

// ---------- drawer ----------

fn draw_drawer(app: App, theme: gui.Theme) {
    let y = drawer_y(app.panels)
    gui.rect(0, y, window_w(), drawer_h(app.panels), theme.bg_hard)
    gui.line(0, y, window_w(), y, theme.border_strong)

    let project_x = 16
    let console_x = 92
    gui.text(project_x, y + 10, "Project", 12, if app.drawer == 0 { theme.fg_bright } else { theme.muted })
    gui.text(console_x, y + 10, "Console", 12, if app.drawer == 1 { theme.fg_bright } else { theme.muted })
    if app.drawer == 0 {
        gui.rect(project_x, y + 29, gui.text_width("Project", 12), 2, theme.accent)
    } else {
        gui.rect(console_x, y + 29, gui.text_width("Console", 12), 2, theme.accent)
    }
    var mode = "edit"
    if app.playing {
        mode = "playing"
    }
    let status = "${world_live_count(app.world)} entities  ·  step ${world_step(app.world)}  ·  ${mode}"
    gui.text(window_w() - 18 - gui.text_width(status, 10), y + 12, status, 10, theme.faint)
    gui.line(0, y + 32, window_w(), y + 32, theme.border)

    if app.drawer == 1 {
        let selected = entity_name(app.world, app.selected)
        let position = world_position(app.world, app.selected)
        gui.mono(18, y + 44, "[world]    Demo Scene ready · ${world_live_count(app.world)} entities · handle ${app.selected.index}:${app.selected.generation}", 11, theme.fg)
        gui.mono(18, y + 62, "[assembly] ${selected} · ${fixed2(position.x)}, ${fixed2(position.y)}, ${fixed2(position.z)}", 11, theme.muted)
        gui.mono(18, y + 80, "[runtime]  fixed dt 1/60 s · gravity ${fixed2(app.world.gravity)} · step ${world_step(app.world)}", 11, theme.muted)
        var shell_line = "[shell]    Scene tab · perspective · grid 1 m"
        if app.tab == 1 {
            shell_line = "[shell]    Game tab · game camera · editor overlays hidden"
        }
        gui.mono(18, y + 98, shell_line + " · history ${app.history_at}/${app.history.len()}", 11, theme.muted)
        gui.mono(18, y + 116, "[input]    click selects · click a transform row to edit · ⌘Z undo · ⇧⌘Z redo · Space play · S step", 11, theme.faint)
    } else {
        gui.mono(18, y + 44, "Runtime", 11, theme.fg_bright)
        gui.mono(18, y + 64, "  World        Demo Scene        ${world_live_count(app.world)} entities", 11, theme.muted)
        gui.mono(18, y + 82, "  Module       world.nova        transforms · tags · fixed step", 11, theme.muted)
        gui.mono(18, y + 100, "  Module       core.nova         generational handles · clock", 11, theme.muted)
        gui.mono(18, y + 118, "  Module       math.nova         Q16.16 vectors and matrices", 11, theme.muted)
        gui.mono(18, y + 142, "All panels read the same runtime World value.", 10, theme.faint)
    }
}

// ---------- frame ----------

fn draw_splitters(app: App, theme: gui.Theme) {
    let p = app.panels
    if p.hierarchy {
        gui.rect(left_w(p) - 1, body_y(), 2, body_h(p), theme.border_strong)
    }
    if p.inspector {
        gui.rect(inspector_x(p) - 1, body_y(), 2, body_h(p), theme.border_strong)
    }
    if p.drawer_open {
        gui.rect(0, drawer_y(p) - 1, window_w(), 2, theme.border_strong)
    }
}

fn draw(app: App) {
    let theme = gui.dark()
    gui.clear(theme.bg)
    draw_top(app, theme)
    if app.panels.hierarchy {
        draw_hierarchy(app, theme)
    }
    draw_centre(app, theme)
    if app.panels.inspector {
        draw_inspector(app, theme)
    }
    if app.panels.drawer_open {
        draw_drawer(app, theme)
    }
    draw_splitters(app, theme)
    draw_menu(app, theme)
}

// ---------- input ----------

fn scene_pick(app: App, x: Int, y: Int) -> EntityId {
    let view = view_for(app, centre_x(app.panels), view_y(), centre_w(app.panels), view_h(app.panels))
    var best = entity_none()
    var best_distance = 2500
    var i = 0
    while i < world_capacity(app.world) {
        if app.world.pool.alive[i] {
            let point = project(view, world_position(app.world, EntityId { index: i, generation: app.world.pool.generations[i] }))
            if project_ok(point) {
                let dx = x - point.x
                let dy = y - point.y
                let distance = dx * dx + dy * dy
                if distance < best_distance {
                    best_distance = distance
                    best = EntityId { index: i, generation: app.world.pool.generations[i] }
                }
            }
        }
        i = i + 1
    }
    return best
}

fn handle_key(app: App, code: Int, mods: Int) -> App {
    let command = mods % 2 == 1
    let shift = (mods / 2) % 2 == 1
    if command && code == 113 {
        return app_quit(app)
    }
    if command && code == 122 {
        var next = app
        if next.edit_field >= 0 {
            next = app_set_edit(next, 0 - 1, "", false)
        }
        if shift {
            return edit_redo(next)
        }
        return edit_undo(next)
    }
    if app.edit_field >= 0 {
        if code == gui.key_escape() {
            return app_set_edit(app_set_notice(app, "Edit cancelled"), 0 - 1, "", false)
        }
        if code == gui.key_enter() {
            return edit_commit(app)
        }
        if code == gui.key_backspace() || code == gui.key_delete() {
            if app.edit_fresh {
                return app_set_edit(app, app.edit_field, "", false)
            }
            return app_set_edit(app, app.edit_field, edit_drop_last(app.edit_text), false)
        }
        if code == gui.key_tab() {
            let field = app.edit_field
            let committed = edit_commit(app)
            if committed.edit_field >= 0 {
                return committed
            }
            var next_field = field + 1
            if shift {
                next_field = field - 1
            }
            if next_field > 2 {
                next_field = 0
            }
            if next_field < 0 {
                next_field = 2
            }
            return edit_begin(committed, next_field)
        }
        return app
    }
    if code == gui.key_escape() {
        if app.tool.menu >= 0 {
            return app_set_menu(app, 0 - 1)
        }
        if app.tool.drag {
            var tool = app.tool
            tool.drag = false
            return app_set_notice(app_set_tool(app, tool), "Drag cancelled")
        }
        return tool_set_mode(app, 0)
    }
    if code == 32 {
        return app_set_playing(app, !app.playing)
    }
    if command && code == 100 {
        return duplicate_selected(app)
    }
    if command && code == 114 {
        return reset_demo(app)
    }
    if shift && code == 115 {
        return tool_toggle_snap(app)
    }
    if code == 115 {
        return app_set_world(app_set_playing(app, false), world_tick(app.world, fx_ratio(1, 60)))
    }
    if code == 113 {
        return tool_set_mode(app, 0)
    }
    if code == 119 {
        return tool_set_mode(app, 1)
    }
    if code == 101 {
        return tool_set_mode(app, 2)
    }
    if code == 114 {
        return tool_set_mode(app, 3)
    }
    if code == 103 {
        return tool_toggle_grid(app)
    }
    if code == gui.key_tab() {
        return app_set_selected(app, next_live(app.world, app.selected))
    }
    if code == gui.key_backspace() || code == gui.key_delete() {
        return delete_selected(app)
    }
    return app
}

fn near_value(value: Int, target: Int, radius: Int) -> Bool {
    return value >= target - radius && value <= target + radius
}

fn panel_chip_at(x: Int, y: Int) -> Int {
    var i = 0
    while i < 3 {
        let chip_x = panel_chip_x(i)
        if x >= chip_x && x < chip_x + panel_chip_w() && y >= panel_chip_y() && y < panel_chip_y() + 18 {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn panel_toggle(app: App, which: Int) -> App {
    var panels = app.panels
    if which == 0 {
        panels.hierarchy = !panels.hierarchy
    }
    if which == 1 {
        panels.inspector = !panels.inspector
    }
    if which == 2 {
        panels.drawer_open = !panels.drawer_open
    }
    var next = app_set_panels(app, panels)
    if !panels.inspector {
        next = app_set_edit(next, 0 - 1, "", false)
    }
    save_panels(panels)
    return next
}

fn panel_drag_at(app: App, x: Int, y: Int) -> Int {
    let panels = app.panels
    if panels.drawer_open && near_value(y, drawer_y(panels), 3) && x >= 0 && x < window_w() {
        return 3
    }
    if panels.hierarchy && near_value(x, left_w(panels), 5) && y >= body_y() && y < drawer_y(panels) {
        return 1
    }
    if panels.inspector && near_value(x, inspector_x(panels), 5) && y >= body_y() && y < drawer_y(panels) {
        return 2
    }
    return 0
}

fn panel_drag_start(app: App, x: Int, y: Int) -> App {
    let which = panel_drag_at(app, x, y)
    if which == 0 {
        return app
    }
    var panels = app.panels
    panels.drag = which
    if which == 3 {
        panels.drag_origin = y
        panels.drag_start = panels.drawer
    } else {
        panels.drag_origin = x
        if which == 1 {
            panels.drag_start = panels.left
        } else {
            panels.drag_start = panels.right
        }
    }
    return app_set_panels(app, panels)
}

fn panel_drag_update(app: App, x: Int, y: Int) -> App {
    if app.panels.drag == 0 {
        return app
    }
    var panels = app.panels
    if panels.drag == 1 {
        panels.left = clamp_int(panels.drag_start + (x - panels.drag_origin), 180, 420)
    }
    if panels.drag == 2 {
        panels.right = clamp_int(panels.drag_start - (x - panels.drag_origin), 220, 460)
    }
    if panels.drag == 3 {
        panels.drawer = clamp_int(panels.drag_start - (y - panels.drag_origin), 120, 320)
    }
    return app_set_panels(app, panels)
}

fn panel_drag_finish(app: App) -> App {
    if app.panels.drag == 0 {
        return app
    }
    var panels = app.panels
    panels.drag = 0
    save_panels(panels)
    return app_set_panels(app, panels)
}

// Test hooks use the real splitter hit test and event handlers, not a second
// layout writer. `left:320` means drag the hierarchy splitter to 320 points.
fn layout_test_drag(app: App, which: String, target: Int) -> App {
    let panels = app.panels
    var start_x = window_w() / 2
    var start_y = body_y() + 80
    if which == "left" {
        start_x = left_w(panels)
    }
    if which == "right" {
        start_x = inspector_x(panels)
    }
    if which == "drawer" {
        start_y = drawer_y(panels)
    }
    var next = handle_mouse_down(app, start_x, start_y)
    if next.panels.drag == 0 {
        return next
    }
    var drag_x = start_x
    var drag_y = start_y
    if which == "left" {
        drag_x = start_x + (target - panels.left)
    }
    if which == "right" {
        drag_x = start_x + (panels.right - target)
    }
    if which == "drawer" {
        drag_y = start_y + (panels.drawer - target)
    }
    next = panel_drag_update(next, drag_x, drag_y)
    return panel_drag_finish(next)
}

fn layout_test_drag_spec(app: App, spec: String) -> App {
    var next = app
    for item in spec.split(",") {
        let parts = item.trim().split(":")
        if parts.len() == 2 {
            next = layout_test_drag(next, parts[0].trim(), parse_int(parts[1]))
        }
    }
    return next
}

fn layout_test_hide_spec(app: App, spec: String) -> App {
    var next = app
    for item in spec.split(",") {
        let name = item.trim()
        var which = 0 - 1
        if name == "hierarchy" {
            which = 0
        }
        if name == "inspector" {
            which = 1
        }
        if name == "drawer" {
            which = 2
        }
        if which >= 0 {
            next = handle_mouse_down(next, panel_chip_x(which) + panel_chip_w() / 2, panel_chip_y() + 9)
        }
    }
    return next
}

// These hooks click the real toolbar/menu rectangles. They do not call the
// command functions directly, so a painted button that lost its hit test fails
// the acceptance test.
fn toolbar_test_action(app: App, action: String) -> App {
    let y = tool_button_y() + 8
    if action == "play" {
        return handle_mouse_down(app, play_x(app.panels) + 15, y)
    }
    if action == "pause" {
        return handle_mouse_down(app, pause_x(app.panels) + 15, y)
    }
    if action == "step" {
        return handle_mouse_down(app, step_x(app.panels) + 15, y)
    }
    if action == "select" {
        return handle_mouse_down(app, select_tool_x(app.panels) + 15, y)
    }
    if action == "move" {
        return handle_mouse_down(app, move_tool_x(app.panels) + 15, y)
    }
    if action == "rotate" {
        return handle_mouse_down(app, rotate_tool_x(app.panels) + 15, y)
    }
    if action == "scale" {
        return handle_mouse_down(app, scale_tool_x(app.panels) + 15, y)
    }
    if action == "snap" {
        return handle_mouse_down(app, snap_x(app.panels) + 25, y)
    }
    if action == "grid" {
        return handle_mouse_down(app, grid_x(app.panels) + 22, y)
    }
    if action == "add" {
        return handle_mouse_down(app, add_cube_x(app.panels) + 15, y)
    }
    if action == "duplicate" {
        return handle_mouse_down(app, duplicate_x(app.panels) + 15, y)
    }
    if action == "delete" {
        return handle_mouse_down(app, delete_x(app.panels) + 15, y)
    }
    return app
}

fn menu_test(app: App, spec: String) -> App {
    let parts = spec.split(":")
    if parts.len() != 2 {
        return app
    }
    let menu = parse_int(parts[0])
    let item = parse_int(parts[1])
    if menu < 0 || menu >= menu_count() || item < 0 || item >= menu_item_count(menu) {
        return app
    }
    var next = handle_mouse_down(app, menu_label_x(menu) + 4, 10)
    return handle_mouse_down(next, menu_drop_x(menu) + 20, menu_drop_y() + 4 + item * menu_item_h() + 8)
}

fn drag_test(app: App, spec: String) -> App {
    let parts = spec.split(",")
    if parts.len() != 2 || !has_selection(app) {
        return app
    }
    let view = view_for(app, centre_x(app.panels), view_y(), centre_w(app.panels), view_h(app.panels))
    let point = project(view, world_position(app.world, app.selected))
    var start_x = centre_x(app.panels) + centre_w(app.panels) / 2
    var start_y = view_y() + view_h(app.panels) / 2
    if project_ok(point) {
        start_x = point.x
        start_y = point.y
    }
    var next = handle_mouse_down(app, start_x, start_y)
    if !next.tool.drag {
        return next
    }
    next = tool_update_drag(next, start_x + parse_int(parts[0]), start_y + parse_int(parts[1]))
    return tool_finish_drag(next)
}

fn handle_mouse_down(app: App, x: Int, y: Int) -> App {
    var app = app
    if app.edit_field >= 0 && !edit_hit(app, x, y) {
        app = edit_commit(app)
        if app.edit_field >= 0 {
            return app
        }
    }
    if app.tool.menu >= 0 {
        let item = menu_item_at(app, x, y)
        if item >= 0 {
            return menu_apply(app, app.tool.menu, item)
        }
    }
    let clicked_menu = menu_at(x, y)
    if clicked_menu >= 0 {
        if app.tool.menu == clicked_menu {
            return app_set_menu(app, 0 - 1)
        }
        return app_set_menu(app, clicked_menu)
    }
    if app.tool.menu >= 0 {
        app = app_set_menu(app, 0 - 1)
    }
    let chip = panel_chip_at(x, y)
    if chip >= 0 {
        return panel_toggle(app, chip)
    }
    if panel_drag_at(app, x, y) > 0 {
        return panel_drag_start(app, x, y)
    }
    if x >= scene_tab_x(app.panels) && x < scene_tab_x(app.panels) + 76 && y >= body_y() && y < body_y() + tabs_h() {
        return app_set_tab(app, 0)
    }
    if x >= game_tab_x(app.panels) && x < game_tab_x(app.panels) + 76 && y >= body_y() && y < body_y() + tabs_h() {
        return app_set_tab(app, 1)
    }
    if x >= play_x(app.panels) && x < play_x(app.panels) + 30 && y >= tool_button_y() && y < tool_button_y() + 24 {
        return app_set_playing(app, true)
    }
    if x >= pause_x(app.panels) && x < pause_x(app.panels) + 30 && y >= tool_button_y() && y < tool_button_y() + 24 {
        return app_set_playing(app, false)
    }
    if x >= step_x(app.panels) && x < step_x(app.panels) + 30 && y >= tool_button_y() && y < tool_button_y() + 24 {
        let world = world_tick(app.world, fx_ratio(1, 60))
        return app_set_playing(app_set_world(app, world), false)
    }
    if x >= select_tool_x(app.panels) && x < select_tool_x(app.panels) + tool_button_w() && y >= tool_button_y() && y < tool_button_y() + 24 {
        return tool_set_mode(app, 0)
    }
    if x >= move_tool_x(app.panels) && x < move_tool_x(app.panels) + tool_button_w() && y >= tool_button_y() && y < tool_button_y() + 24 {
        return tool_set_mode(app, 1)
    }
    if x >= rotate_tool_x(app.panels) && x < rotate_tool_x(app.panels) + tool_button_w() && y >= tool_button_y() && y < tool_button_y() + 24 {
        return tool_set_mode(app, 2)
    }
    if x >= scale_tool_x(app.panels) && x < scale_tool_x(app.panels) + tool_button_w() && y >= tool_button_y() && y < tool_button_y() + 24 {
        return tool_set_mode(app, 3)
    }
    if x >= snap_x(app.panels) && x < snap_x(app.panels) + 44 && y >= tool_button_y() && y < tool_button_y() + 24 {
        return tool_toggle_snap(app)
    }
    if x >= grid_x(app.panels) && x < grid_x(app.panels) + 38 && y >= tool_button_y() && y < tool_button_y() + 24 {
        return tool_toggle_grid(app)
    }
    if x >= add_cube_x(app.panels) && x < add_cube_x(app.panels) + tool_button_w() && y >= tool_button_y() && y < tool_button_y() + 24 {
        return create_cube(app)
    }
    if x >= duplicate_x(app.panels) && x < duplicate_x(app.panels) + tool_button_w() && y >= tool_button_y() && y < tool_button_y() + 24 {
        return duplicate_selected(app)
    }
    if x >= delete_x(app.panels) && x < delete_x(app.panels) + tool_button_w() && y >= tool_button_y() && y < tool_button_y() + 24 {
        return delete_selected(app)
    }
    if y >= history_button_y() && y < history_button_y() + 18 {
        if x >= undo_x(app.panels) && x < undo_x(app.panels) + 38 {
            return edit_undo(app)
        }
        if x >= redo_x(app.panels) && x < redo_x(app.panels) + 38 {
            return edit_redo(app)
        }
    }
    let field = inspector_field_at(app.panels, x, y)
    if field >= 0 {
        if field == app.edit_field {
            return app
        }
        return edit_begin(app, field)
    }
    if x >= inspector_x(app.panels) + 12 && x < inspector_x(app.panels) + 12 + right_w(app.panels) - 24 && y >= add_component_y(app.panels) && y < add_component_y(app.panels) + 28 {
        return app_set_notice(app, "No component types registered yet.")
    }
    if y >= drawer_y(app.panels) + 4 && y < drawer_y(app.panels) + 30 {
        if x >= 16 && x < 80 {
            return app_set_drawer(app, 0)
        }
        if x >= 92 && x < 172 {
            return app_set_drawer(app, 1)
        }
    }
    if x >= 0 && x < left_w(app.panels) && y >= hierarchy_first_row() && y < hierarchy_first_row() + world_live_count(app.world) * hierarchy_row_h() {
        let picked = hierarchy_pick(app.world, app.panels, x, y)
        if !entity_is_none(picked) {
            return app_set_selected(app, picked)
        }
    }
    if x >= centre_x(app.panels) && x < centre_x(app.panels) + centre_w(app.panels) && y >= view_y() && y < view_y() + view_h(app.panels) {
        let picked = scene_pick(app, x, y)
        if app.tool.mode == 0 {
            return app_set_selected(app, picked)
        }
        if !entity_is_none(picked) {
            app = app_set_selected(app, picked)
        }
        return tool_begin_drag(app, x, y)
    }
    return app
}

fn handle(app: App, event: gui.Event) -> App {
    if event.kind == gui.event_key() {
        return handle_key(app, event.code, event.mods)
    }
    if event.kind == gui.event_text() {
        return handle_text(app, gui.typed_text())
    }
    if event.kind == gui.event_close() {
        return app_quit(app)
    }
    if event.kind == gui.event_mouse_down() {
        return handle_mouse_down(app, event.x, event.y)
    }
    if event.kind == gui.event_drag() {
        if app.tool.drag {
            return tool_update_drag(app, event.x, event.y)
        }
        return panel_drag_update(app, event.x, event.y)
    }
    if event.kind == gui.event_mouse_up() {
        if app.tool.drag {
            return tool_finish_drag(app)
        }
        return panel_drag_finish(app)
    }
    return app
}

// ---------- entry ----------

fn main() {
    var app = App {
        world: demo_world(),
        selected: entity_none(),
        playing: false,
        tab: 0,
        drawer: 1,
        notice: "",
        edit_field: 0 - 1,
        edit_text: "",
        edit_fresh: false,
        history: [],
        history_at: 0,
        quit: false,
        metal: 0,
        panels: load_panels(),
        tool: default_tool(),
    }
    app = app_set_selected(app, find_tag(app.world, 3))
    if gui.env("NOVA_SCENE_SELECT") == "camera" {
        app = app_set_selected(app, find_tag(app.world, 6))
    }

    let shot = gui.env("NOVA_SCENE_SHOT")
    if shot.len() > 0 {
        let drag = gui.env("NOVA_SCENE_LAYOUT_DRAG")
        if drag.len() > 0 {
            app = layout_test_drag_spec(app, drag)
        }
        let hide = gui.env("NOVA_SCENE_LAYOUT_HIDE")
        if hide.len() > 0 {
            app = layout_test_hide_spec(app, hide)
        }
        // Capture acceptance uses the same hit test as a real mouse-down so a
        // Game tab that paints but cannot be entered fails the check.
        if gui.env("NOVA_SCENE_CLICK") == "game" {
            app = handle_mouse_down(app, game_tab_x(app.panels) + 16, body_y() + 8)
        }
        let edit = edit_field_from_env(gui.env("NOVA_SCENE_EDIT"))
        if edit >= 0 {
            app = handle_mouse_down(app, inspector_inner_x(app.panels) + 20, inspector_field_y(edit) + 8)
            app = handle_text(app, gui.env("NOVA_SCENE_TEXT"))
            app = handle_key(app, gui.key_enter(), 0)
        }
        if gui.env("NOVA_SCENE_UNDO") == "1" {
            app = handle_mouse_down(app, undo_x(app.panels) + 10, history_button_y() + 8)
        }
        if gui.env("NOVA_SCENE_REDO") == "1" {
            app = handle_mouse_down(app, redo_x(app.panels) + 10, history_button_y() + 8)
        }
        let action = gui.env("NOVA_SCENE_ACTION")
        if action.len() > 0 {
            app = toolbar_test_action(app, action)
        }
        let menu_spec = gui.env("NOVA_SCENE_MENU")
        if menu_spec.len() > 0 {
            app = menu_test(app, menu_spec)
        }
        let drag_spec = gui.env("NOVA_SCENE_DRAG")
        if drag_spec.len() > 0 {
            app = drag_test(app, drag_spec)
        }
        if gui.env("NOVA_SCENE_UNDO_AFTER") == "1" {
            app = handle_mouse_down(app, undo_x(app.panels) + 10, history_button_y() + 8)
        }
        if gui.open("Nova Engine Studio", window_w(), window_h()) {
            app = app_set_metal(app, start_metal(app.panels))
            gui.begin()
            draw(app)
            gui.present()
            let saved = gui.save_png(shot)
            var tab_label = "scene"
            if app.tab == 1 {
                tab_label = "game"
            }
            var viewport = "cpu"
            if app.metal != 0 {
                viewport = "metal"
            }
            let position = world_position(app.world, app.selected)
            let rotation = world_rotation(app.world, app.selected)
            let scale = world_scale(app.world, app.selected)
            println("scene-gui: shell=captured saved=${saved} entities=${world_live_count(app.world)} selected=${app.selected.index}:${app.selected.generation} tab=${tab_label} viewport=${viewport} drawer=console history=${app.history_at}/${app.history.len()} position=${fixed2(position.x)}, ${fixed2(position.y)}, ${fixed2(position.z)} rotation=${fixed2(rotation.w)}, ${fixed2(rotation.x)}, ${fixed2(rotation.y)}, ${fixed2(rotation.z)} scale=${fixed2(scale.x)}, ${fixed2(scale.y)}, ${fixed2(scale.z)} layout=${app.panels.left},${app.panels.right},${app.panels.drawer} h=${bool_value(app.panels.hierarchy)} i=${bool_value(app.panels.inspector)} d=${bool_value(app.panels.drawer_open)} tool=${tool_mode_name(app.tool.mode)} snap=${bool_value(app.tool.snap)} grid=${bool_value(app.tool.grid)} playing=${bool_value(app.playing)} step=${world_step(app.world)} menu=${app.tool.menu}")
            if app.metal != 0 {
                metal_shutdown(app.metal)
            }
            gui.close()
        }
        return
    }

    if !gui.open("Nova Engine Studio", window_w(), window_h()) {
        println("scene-gui: could not open a window")
        return
    }
    app = app_set_metal(app, start_metal(app.panels))
    let finite = gui.env("NOVA_SCENE_FRAMES").len() > 0
    var frames = 0
    while !app.quit && gui.is_open() {
        var event = gui.next_event()
        while event.kind != gui.event_none() {
            app = handle(app, event)
            event = gui.next_event()
        }
        if app.playing {
            app = app_set_world(app, world_tick(app.world, fx_ratio(1, 60)))
        }
        gui.begin()
        draw(app)
        gui.present()
        frames = frames + 1
        if finite && frames >= 5 {
            app = app_quit(app)
        }
        gui.sleep(16)
    }
    var viewport = "cpu"
    if app.metal != 0 {
        viewport = "metal"
    }
    println("scene-gui: live=stopped frames=${frames} viewport=${viewport}")
    if app.metal != 0 {
        metal_shutdown(app.metal)
    }
    gui.close()
}
