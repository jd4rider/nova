import std.io { println }
import "../../../libraries/nova-gui/src/gui.nova" as gui
import "../../../libraries/nova-engine/src/core.nova"
import "../../../libraries/nova-engine/src/math.nova"
import "../../../libraries/nova-engine/src/world.nova"
import "../../../libraries/nova-render/src/metal.nova"

// Nova Engine Studio, ENG-04.002 + ENG-04.003 + ENG-11.003.
//
// The shell follows ADR-ENG-009: hierarchy on the left, scene/game view with a
// play/pause/step toolbar in the centre, inspector on the right, and a
// project/console drawer along the bottom. Every panel reads the same World
// value. The centre view is an offscreen Metal render of that world composited
// into the Nova GUI bitmap; the grid and selected-player box are editor
// overlays, and selection is the same EntityId the hierarchy and inspector use.

fn window_w() -> Int {
    return 1440
}

fn window_h() -> Int {
    return 900
}

fn app_version() -> String {
    return "0.6.0"
}

fn menu_h() -> Int {
    return 28
}

fn strip_h() -> Int {
    return 32
}

fn body_y() -> Int {
    return 60
}

// Editor-owned panel state. The World stays untouched when a panel is resized
// or hidden; `layout.txt` persists only these shell values between launches.
struct Panels {
    left: Int,
    right: Int,
    drawer: Int,
    hierarchy: Bool,
    inspector: Bool,
    drawer_open: Bool,
    drag: Int,
    drag_origin: Int,
    drag_start: Int,
    path: String,
}

fn drawer_h(p: Panels) -> Int {
    if !p.drawer_open {
        return 0
    }
    return p.drawer
}

fn drawer_y(p: Panels) -> Int {
    return window_h() - drawer_h(p)
}

fn body_h(p: Panels) -> Int {
    return drawer_y(p) - body_y()
}

fn left_w(p: Panels) -> Int {
    if !p.hierarchy {
        return 0
    }
    return p.left
}

fn centre_x(p: Panels) -> Int {
    return left_w(p)
}

fn right_w(p: Panels) -> Int {
    if !p.inspector {
        return 0
    }
    return p.right
}

fn centre_w(p: Panels) -> Int {
    return window_w() - left_w(p) - right_w(p)
}

fn inspector_x(p: Panels) -> Int {
    return window_w() - right_w(p)
}

fn tabs_h() -> Int {
    return 30
}

fn toolbar_h() -> Int {
    return 36
}

fn view_y() -> Int {
    return body_y() + tabs_h() + toolbar_h()
}

fn view_h(p: Panels) -> Int {
    return drawer_y(p) - view_y()
}

fn hierarchy_first_row() -> Int {
    return body_y() + 66
}

fn hierarchy_row_h() -> Int {
    return 26
}

fn scene_tab_x(p: Panels) -> Int {
    return centre_x(p) + 8
}

fn game_tab_x(p: Panels) -> Int {
    return centre_x(p) + 88
}

// The traffic lights are AppKit's own buttons; reserve their corner instead of
// painting the menu title underneath them.
fn traffic_inset() -> Int {
    return 84
}

fn play_x(p: Panels) -> Int {
    return centre_x(p) + 12
}

fn pause_x(p: Panels) -> Int {
    return centre_x(p) + 48
}

fn step_x(p: Panels) -> Int {
    return centre_x(p) + 84
}

// The transform tools follow Godot's Q/W/E/R muscle memory. They are real
// viewport drag tools, not labels: Move changes X/Z, Rotate turns around Y and
// Scale changes all three axes uniformly.
fn toolbar_group_x(p: Panels) -> Int {
    return step_x(p) + 44
}

fn select_tool_x(p: Panels) -> Int {
    return toolbar_group_x(p)
}

fn move_tool_x(p: Panels) -> Int {
    return toolbar_group_x(p) + 30
}

fn rotate_tool_x(p: Panels) -> Int {
    return toolbar_group_x(p) + 60
}

fn scale_tool_x(p: Panels) -> Int {
    return toolbar_group_x(p) + 90
}

fn snap_x(p: Panels) -> Int {
    return toolbar_group_x(p) + 124
}

fn grid_x(p: Panels) -> Int {
    return toolbar_group_x(p) + 172
}

fn add_cube_x(p: Panels) -> Int {
    return toolbar_group_x(p) + 218
}

fn duplicate_x(p: Panels) -> Int {
    return toolbar_group_x(p) + 248
}

fn delete_x(p: Panels) -> Int {
    return toolbar_group_x(p) + 278
}

fn tool_button_w() -> Int {
    return 26
}

fn tool_button_y() -> Int {
    return body_y() + tabs_h() + 6
}

fn add_component_y(p: Panels) -> Int {
    return drawer_y(p) - 54
}

fn inspector_inner_x(p: Panels) -> Int {
    return inspector_x(p) + 12
}

fn inspector_inner_w(p: Panels) -> Int {
    return right_w(p) - 24
}

fn inspector_transform_y() -> Int {
    return body_y() + 96
}

fn inspector_field_y(field: Int) -> Int {
    return inspector_transform_y() + 30 + field * 24
}

fn history_button_y() -> Int {
    return body_y() + 6
}

fn undo_x(p: Panels) -> Int {
    return inspector_x(p) + right_w(p) - 92
}

fn redo_x(p: Panels) -> Int {
    return inspector_x(p) + right_w(p) - 50
}

// Panel visibility chips live in the menu bar so every panel can be restored
// even when all three are hidden.
fn panel_chip_w() -> Int {
    return 38
}

fn panel_chip_y() -> Int {
    return 5
}

fn panel_chip_x(index: Int) -> Int {
    let version_w = gui.text_width(app_version(), 10)
    let total = 3 * panel_chip_w() + 8
    return window_w() - 18 - version_w - 16 - total + index * (panel_chip_w() + 4)
}

struct View3D {
    x: Int,
    y: Int,
    w: Int,
    h: Int,
    vp: Mat4,
}

// Editor-only command history. The runtime World never stores undo state;
// every command replays through the same world_set_* mutators.
struct EditValues {
    w: Int,
    x: Int,
    y: Int,
    z: Int,
}

struct EditCommand {
    entity: EntityId,
    field: Int,
    before: EditValues,
    after: EditValues,
}

struct ParsedNumber {
    ok: Bool,
    value: Int,
}

struct EditParse {
    ok: Bool,
    values: EditValues,
}

// Editor-only tool state. None of this belongs in the World: the active tool,
// snapping, grid visibility, an open menu and an in-flight viewport drag are
// shell concerns. A drag records one EditCommand when the mouse is released, so
// moving an entity with the toolbar is undoable exactly like typing a value.
struct ToolState {
    mode: Int,
    snap: Bool,
    grid: Bool,
    menu: Int,
    drag: Bool,
    drag_x: Int,
    drag_y: Int,
    drag_entity: EntityId,
    drag_field: Int,
    drag_before: EditValues,
}

fn default_tool() -> ToolState {
    return ToolState {
        mode: 0,
        snap: true,
        grid: true,
        menu: 0 - 1,
        drag: false,
        drag_x: 0,
        drag_y: 0,
        drag_entity: entity_none(),
        drag_field: 0 - 1,
        drag_before: EditValues { w: 0, x: 0, y: 0, z: 0 },
    }
}

struct App {
    world: World,
    selected: EntityId,
    playing: Bool,
    tab: Int,
    drawer: Int,
    notice: String,
    edit_field: Int,
    edit_text: String,
    edit_fresh: Bool,
    history: List<EditCommand>,
    history_at: Int,
    quit: Bool,
    metal: Int,
    panels: Panels,
    tool: ToolState,
}

fn app_set_world(app: App, world: World) -> App {
    return App {
        world: world,
        selected: app.selected,
        playing: app.playing,
        tab: app.tab,
        drawer: app.drawer,
        notice: app.notice,
        quit: app.quit,
        metal: app.metal,
        edit_field: app.edit_field,
        edit_text: app.edit_text,
        edit_fresh: app.edit_fresh,
        history: app.history,
        history_at: app.history_at,
        panels: app.panels,
        tool: app.tool,
    }
}

