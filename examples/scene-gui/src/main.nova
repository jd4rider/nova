import std.io { println }
import "../../../libraries/nova-gui/src/gui.nova" as gui
import "../../../libraries/nova-engine/src/render.nova"

// A playground for Engine Phase 0: orbs with per-body restitution bounce inside
// a box, drawn by the scene renderer. Click drops another orb, space resets.

fn window_w() -> Int {
    return 900
}

fn window_h() -> Int {
    return 700
}

fn field_x() -> Int {
    return 50
}

fn field_y() -> Int {
    return 112
}

fn orb_size() -> Int {
    return 18
}

fn orb_count() -> Int {
    return 140
}

struct App {
    scene: Scene,
    quit: Bool,
    clicks: Int,
}

fn box() -> Scene {
    // Zero gravity keeps the box alive: this demo is about restitution and
    // readability, not about everything settling into one line.
    var scene = scene_new(0)
    scene = scene_spawn(scene, "ceiling", "solid", 400, 8, 800, 16, 0, true, 0)
    scene = scene_spawn(scene, "floor", "solid", 400, 510, 800, 20, 0, true, 0)
    scene = scene_spawn(scene, "left", "solid", 8, 260, 16, 520, 0, true, 0)
    scene = scene_spawn(scene, "right", "solid", 792, 260, 16, 520, 0, true, 0)
    return scene
}

// Deterministic spread: the first frame is the same every launch, which keeps
// screenshots and bug reports comparable.
fn populated() -> Scene {
    var scene = box()
    var i = 0
    while i < orb_count() {
        let x = 60 + i % 12 * 58
        let y = 80 + i / 12 * 26
        let vx = i * 37 % 41 * 22 - 440
        let vy = i * 53 % 31 * 17 - 255
        scene = scene_spawn(scene, "orb", "orb", x, y, orb_size(), orb_size(), i % 6, false, 96)
        let index = scene_count(scene) - 1
        scene = scene_set_velocity(scene, scene.ids[index], vx, vy)
        i = i + 1
    }
    return scene
}

fn draw(app: App) {
    let theme = gui.dark()
    gui.clear(theme.bg)
    gui.text(24, 26, "NOVA", 20, theme.fg_bright)
    gui.text(24 + gui.text_width("NOVA", 20) + 10, 26, "PHYSICS", 20, theme.accent)
    gui.text(24, 56, "engine phase 0 · scene · restitution · fixed step", 11, theme.faint)

    let count_text = "${scene_count(app.scene)} entities   gravity ${app.scene.gravity}   ${app.clicks} dropped"
    gui.text(window_w() - 24 - gui.text_width(count_text, 13), 30, count_text, 13, theme.fg)

    gui.round_rect(field_x() - 14, field_y() - 14, 800 + 28, 520 + 28, 12, theme.panel)
    gui.stroke(field_x() - 14, field_y() - 14, 800 + 28, 520 + 28, theme.border_strong)
    draw_scene(app.scene, field_x(), field_y(), theme)

    let hint = "click drops an orb   ·   space resets   ·   R resets   ·   ⌘Q quits"
    gui.text((window_w() - gui.text_width(hint, 11)) / 2, window_h() - 34, hint, 11, theme.faint)
}

fn key(app: App, code: Int, mods: Int) -> App {
    let command = mods % 2 == 1
    if command && code == 113 {
        return App { scene: app.scene, quit: true, clicks: app.clicks }
    }
    if code == gui.key_escape() {
        return App { scene: app.scene, quit: true, clicks: app.clicks }
    }
    if code == 32 || code == 114 {
        return App { scene: populated(), quit: false, clicks: 0 }
    }
    return app
}

fn handle(app: App, event: gui.Event) -> App {
    if event.kind == gui.event_key() {
        return key(app, event.code, event.mods)
    }
    if event.kind == gui.event_close() {
        return App { scene: app.scene, quit: true, clicks: app.clicks }
    }
    if event.kind == gui.event_mouse_down() {
        var x = event.x - field_x()
        var y = event.y - field_y()
        if x < 24 {
            x = 24
        }
        if x > 776 {
            x = 776
        }
        if y < 30 {
            y = 30
        }
        if y > 480 {
            y = 480
        }
        var scene = scene_spawn(app.scene, "orb", "orb", x, y, orb_size(), orb_size(), app.clicks % 6, false, 82)
        scene = scene_set_velocity(scene, scene.ids[scene_count(scene) - 1], app.clicks % 9 * 90 - 360, app.clicks % 7 * 80 - 240)
        return App { scene: scene, quit: false, clicks: app.clicks + 1 }
    }
    return app
}

fn main() {
    let shot = gui.env("NOVA_SCENE_SHOT")
    if shot.len() > 0 {
        var scene = populated()
        var i = 0
        while i < 220 {
            scene = scene_tick(scene)
            i = i + 1
        }
        let app = App { scene: scene, quit: false, clicks: 0 }
        if gui.open("Nova Physics", window_w(), window_h()) {
            gui.begin()
            draw(app)
            gui.present()
            let saved = gui.save_png(shot)
            println("scene-gui: saved=${saved} entities=${scene_count(app.scene)}")
            gui.close()
        }
        return
    }
    if !gui.open("Nova Physics", window_w(), window_h()) {
        println("scene-gui: could not open a window")
        return
    }
    var app = App { scene: populated(), quit: false, clicks: 0 }
    while !app.quit && gui.is_open() {
        var event = gui.next_event()
        while event.kind != gui.event_none() {
            app = handle(app, event)
            event = gui.next_event()
        }
        let next = App { scene: scene_tick(app.scene), quit: app.quit, clicks: app.clicks }
        app = next
        gui.begin()
        draw(app)
        gui.present()
        gui.sleep(16)
    }
    gui.close()
}
