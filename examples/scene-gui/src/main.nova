import std.io { println }
import "../../../libraries/nova-gui/src/gui.nova" as gui
import "../../../libraries/nova-engine/src/core.nova"
import "../../../libraries/nova-engine/src/math.nova"
import "../../../libraries/nova-engine/src/world.nova"
import "../../../libraries/nova-render/src/metal.nova"

// Nova Engine Studio, ENG-04.002 + ENG-11.003.
//
// The shell follows ADR-ENG-009: hierarchy on the left, scene/game view with a
// play/pause/step toolbar in the centre, inspector on the right, and a
// project/console drawer along the bottom. Every panel reads the same World
// value. The centre view is an offscreen Metal render of that world composited
// into the Nova GUI bitmap; the grid and selected-player box are editor
// overlays, and selection is the same EntityId the hierarchy and inspector use.

fn window_w() -> Int {
    return 1440
}

fn window_h() -> Int {
    return 900
}

fn menu_h() -> Int {
    return 28
}

fn strip_h() -> Int {
    return 32
}

fn body_y() -> Int {
    return 60
}

fn drawer_h() -> Int {
    return 196
}

fn drawer_y() -> Int {
    return window_h() - drawer_h()
}

fn body_h() -> Int {
    return drawer_y() - body_y()
}

fn left_w() -> Int {
    return 252
}

fn centre_x() -> Int {
    return left_w()
}

fn right_w() -> Int {
    return 304
}

fn centre_w() -> Int {
    return window_w() - left_w() - right_w()
}

fn inspector_x() -> Int {
    return window_w() - right_w()
}

fn tabs_h() -> Int {
    return 30
}

fn toolbar_h() -> Int {
    return 36
}

fn view_y() -> Int {
    return body_y() + tabs_h() + toolbar_h()
}

fn view_h() -> Int {
    return drawer_y() - view_y()
}

fn hierarchy_first_row() -> Int {
    return body_y() + 66
}

fn hierarchy_row_h() -> Int {
    return 26
}

fn scene_tab_x() -> Int {
    return centre_x() + 8
}

fn game_tab_x() -> Int {
    return centre_x() + 88
}

// The traffic lights are AppKit's own buttons; reserve their corner instead of
// painting the menu title underneath them.
fn traffic_inset() -> Int {
    return 84
}

fn play_x() -> Int {
    return centre_x() + 12
}

fn pause_x() -> Int {
    return centre_x() + 48
}

fn step_x() -> Int {
    return centre_x() + 84
}

fn tool_button_y() -> Int {
    return body_y() + tabs_h() + 6
}

fn add_component_y() -> Int {
    return drawer_y() - 54
}

struct View3D {
    x: Int,
    y: Int,
    w: Int,
    h: Int,
    vp: Mat4,
}

struct App {
    world: World,
    selected: EntityId,
    playing: Bool,
    tab: Int,
    drawer: Int,
    notice: String,
    quit: Bool,
    metal: Int,
}

fn app_set_world(app: App, world: World) -> App {
    return App {
        world: world,
        selected: app.selected,
        playing: app.playing,
        tab: app.tab,
        drawer: app.drawer,
        notice: app.notice,
        quit: app.quit,
        metal: app.metal,
    }
}

fn app_set_selected(app: App, selected: EntityId) -> App {
    return App {
        world: app.world,
        selected: selected,
        playing: app.playing,
        tab: app.tab,
        drawer: app.drawer,
        notice: app.notice,
        quit: app.quit,
        metal: app.metal,
    }
}

