import std.io { println }
import "../../../libraries/nova-gui/src/gui.nova" as gui
import "../../../libraries/nova-engine/src/core.nova"
import "../../../libraries/nova-engine/src/random.nova"
import "rules.nova"

// Gemstorm — the window.
//
// rules.nova owns every decision; this file owns the screens, the pointer, the
// animation and the pixels. A click or an arrow key becomes one game_swap call,
// and the view replays whatever board that call returned: cleared gems pop,
// survivors slide, refills drop in from above. Nothing here decides a match.
//
// Headless entry points, used by tests/run.sh and the icon:
//   NOVA_GEMSTORM_CHECK=1           print the rules self-check and exit
//   NOVA_GEMSTORM_SIM=<moves>       play a hint-driven run and print its state
//   NOVA_GEMSTORM_SCENARIO=<name>   draw one screen state and exit
//   NOVA_GEMSTORM_SHOT=<path>       save that frame as a PNG
//   NOVA_GEMSTORM_ICON=<path>       render the app icon

