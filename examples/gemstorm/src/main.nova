// ---------- frame ----------

fn draw(app: App) {
    let s = skin()
    gui.clear(s.bg)
    draw_backdrop(s)
    if app.screen == screen_menu() {
        draw_board(app, s)
        shade(150, s)
        draw_menu(app, s)
        return
    }
    draw_header(app, s)
    draw_board(app, s)
    draw_particles(app, s)
    draw_floats(app, s)
    draw_left(app, s)
    draw_right(app, s)
    draw_status(app, s)
    draw_footer(app, s)
    if app.screen == screen_pause() {
        draw_pause(app, s)
    }
    if app.screen == screen_over() {
        draw_over(app, s)
    }
}

// ---------- icon ----------

fn draw_icon(size: Int) {
    let s = skin()
    gui.clear(s.bg)
    var i = 0
    while i < 20 {
        gui.rect(0, i * size / 20, size, size / 20 + 1, lerp_colour(gui.rgb(24, 30, 52), s.bg, i * 100 / 19))
        i = i + 1
    }

    let margin = size * 9 / 100
    let slab = size - margin * 2
    gui.round_rect_alpha(margin, margin + size / 40, slab, slab, size / 6, 0, 110)
    gui.round_rect(margin, margin, slab, slab, size / 6, s.border)
    gui.round_rect(margin + 3, margin + 3, slab - 6, slab - 6, size / 6 - 3, s.panel)

    let gem = size * 22 / 100
    let gap = size * 3 / 100
    let grid = gem * 3 + gap * 2
    let ox = (size - grid) / 2
    let oy = (size - grid) / 2
    var row = 0
    while row < 3 {
        var col = 0
        while col < 3 {
            let x = ox + col * (gem + gap)
            let y = oy + row * (gem + gap)
            gui.round_rect(x, y, gem, gem, gem / 5, s.tile)
            let slot = row * 3 + col
            if slot == 4 {
                draw_gem(x, y, gem, 0, special_prism(), s)
            } else {
                draw_gem(x, y, gem, slot % 6 + 1, special_none(), s)
            }
            col = col + 1
        }
        row = row + 1
    }
}

// ---------- headless entry points ----------

fn parse_int(text: String) -> Int {
    let chars = text.trim().chars()
    if chars.len() == 0 {
        return 0
    }
    var i = 0
    var negative = false
    if chars[0] == "-" {
        negative = true
        i = 1
    }
    var value = 0
    while i < chars.len() {
        let code = chars[i].bytes()[0]
        if code < 48 || code > 57 {
            return 0
        }
        value = value * 10 + (code - 48)
        i = i + 1
    }
    if negative {
        return 0 - value
    }
    return value
}

fn bool_text(value: Bool) -> String {
    if value {
        return "true"
    }
    return "false"
}

fn state_line(app: App) -> String {
    let game = app.game
    return "gemstorm: screen=${screen_name(app.screen)} seed=${app.seed} phase=${game.phase} score=${game.score} moves=${game.moves_left} spent=${game.moves_spent} cleared=${game.cleared} specials=${game.specials_made} combo=${game.best_combo} power=${game.power} rejected=${game.rejected} anim=${app.anim.ticks} hash=${board_hash(game.board)}"
}

// Hint-driven play, used for the soak and the determinism check: every move is
// the rules' own first legal swap, so the hash covers matching, specials,
// gravity and scoring rather than one lucky board.
fn sim_run(seed: Int, moves: Int) -> Game {
    var game = game_new(seed, board_cols(), board_rows(), gem_colours(), moves)
    var guard = 0
    while game.phase != phase_over() && guard < 4000 {
        guard = guard + 1
        if !game_has_move(game) {
            game = game_shuffle(game)
        }
        let hint = game_hint(game)
        if hint.len() != 2 {
            break
        }
        let before = game.moves_spent
        game = game_swap(game, hint[0], hint[1])
        if game.moves_spent == before {
            break
        }
    }
    return game
}

fn scenario_app(name: String) -> App {
    var app = app_new(20261127)
    app.muted = true
    if name == "menu" {
        app.screen = screen_menu()
        return app
    }

    app.screen = screen_play()
    if name == "play" {
        // A known sapphire at the corner so a pixel probe has a fixed target,
        // plus a selection and a hint so the capture shows both markers.
        var board = app.game.board
        board = board_set(board, 0, 0, gem(4, 0))
        var game = app.game
        game.board = board
        app.game = game
        app.sel = board_index(app.game.board, 2, 3)
        app.cursor = app.sel
        app.hint_a = board_index(app.game.board, 4, 5)
        app.hint_b = board_index(app.game.board, 5, 5)
        app.hint_ticks = 160
        return app_notice(app, "click a neighbouring gem to swap", 600)
    }
    if name == "specials" {
        var board = app.game.board
        board = board_set(board, 0, 0, gem(4, 0))
        board = board_set(board, 1, 0, gem(4, special_beam_h()))
        board = board_set(board, 2, 0, gem(3, special_beam_v()))
        board = board_set(board, 3, 0, gem(2, special_burst()))
        board = board_set(board, 4, 0, cell_prism())
        board = board_set(board, 5, 0, gem(5, 0))
        var blocked = board.blocked
        let crate = board_index(board, 1, 2)
        blocked[crate] = 1
        var cells = board.cells
        cells[crate] = 0
        board.blocked = blocked
        board.cells = cells
        var frost = board.frost
        frost[board_index(board, 2, 2)] = 2
        board.frost = frost
        var game = app.game
        game.board = board
        app.game = game
        return app_notice(app, "beams, burst, prism, crate and frost", 600)
    }
    if name == "hint" {
        app = app_hint(app)
        return app
    }
    if name == "power" {
        var game = game_with_power(app.game, 2)
        app.game = game
        app.power_mode = true
        app.cursor = board_index(app.game.board, 4, 4)
        app.hover = app.cursor
        return app_notice(app, "storm armed · click a gem", 600)
    }
    if name == "slide" {
        let hint = game_hint(app.game)
        if hint.len() == 2 {
            app = app_try_swap(app, hint[0], hint[1])
        }
        var i = 0
        while i < 8 {
            app = app_step(app)
            i = i + 1
        }
        return app
    }
    if name == "over" {
        app.game = game_new(app.seed, board_cols(), board_rows(), gem_colours(), 1)
        app = app_hint(app)
        let hint = game_hint(app.game)
        if hint.len() == 2 {
            app = app_try_swap(app, hint[0], hint[1])
        }
        // Let the final settle finish, so the capture shows the finished board
        // behind the card rather than an empty one.
        var i = 0
        while i < anim_total() + 2 {
            app = app_step(app)
            i = i + 1
        }
        return app
    }
    return app
}

// ---------- entry point ----------

fn main() {
    if gui.env("NOVA_GEMSTORM_CHECK").len() > 0 {
        let game = game_new(20261127, 8, 8, 6, 25)
        println("gemstorm: seed=${game.seed} hash=${board_hash(game.board)} score=${game.score} moves=${game.moves_left} stable=${!match_any(game.board)}")
        return
    }

    let icon_path = gui.env("NOVA_GEMSTORM_ICON")
    if icon_path.len() > 0 {
        if !gui.open("Gemstorm", 512, 512) {
            println("gemstorm: could not open a window for the icon")
            return
        }
        gui.begin()
        draw_icon(gui.width())
        gui.present()
        let saved = gui.save_png(icon_path)
        println("gemstorm: icon saved=${bool_text(saved)} path=${icon_path}")
        gui.close()
        return
    }

    let sim = gui.env("NOVA_GEMSTORM_SIM")
    if sim.len() > 0 {
        let seed = parse_int(gui.env("NOVA_GEMSTORM_SEED"))
        let game = sim_run(seed, parse_int(sim))
        println("gemstorm: sim seed=${seed} budget=${sim} spent=${game.moves_spent} score=${game.score} cleared=${game.cleared} specials=${game.specials_made} phase=${game.phase} hash=${board_hash(game.board)}")
        return
    }

    let scenario = gui.env("NOVA_GEMSTORM_SCENARIO")
    if scenario.len() > 0 {
        var app = scenario_app(scenario)
        let shot = gui.env("NOVA_GEMSTORM_SHOT")
        if !gui.open("Gemstorm", window_w(), window_h()) {
            println("gemstorm: could not open a window")
            return
        }
        gui.begin()
        draw(app)
        gui.present()
        var saved = false
        if shot.len() > 0 {
            saved = gui.save_png(shot)
        }
        println(state_line(app) + " scenario=${scenario} saved=${bool_text(saved)}")
        gui.close()
        return
    }

    let seed = parse_int(gui.env("NOVA_GEMSTORM_SEED"))
    if !gui.open("Gemstorm", window_w(), window_h()) {
        println("gemstorm: could not open a window")
        return
    }

    var app = app_new(seed)
    var clock = clock_new(60)
    clock = clock_with_max_steps(clock, 5)
    var last = gui.now()

    while !app.quit && gui.is_open() {
        var event = gui.next_event()
        while event.kind != gui.event_none() {
            app = handle(app, event)
            event = gui.next_event()
        }

        let now = gui.now()
        let tick = clock_advance(clock, (now - last) * 1000)
        clock = tick.clock
        last = now
        var steps = 0
        while steps < tick.steps {
            app = app_step(app)
            steps = steps + 1
        }

        gui.place_traffic_lights(14)
        gui.begin()
        draw(app)
        gui.present()
        gui.sleep(1)
    }
    gui.close()
}
