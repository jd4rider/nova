fn draw_status(app: App, s: Skin) {
    if app.power_mode {
        let w = gui.text_width("storm armed · click a gem · Esc cancels", 12) + 30
        let x = board_x() + (board_px() - w) / 2
        gui.round_rect(x, 612, w, 30, 15, s.hot)
        gui.text(x + 15, 620, "storm armed · click a gem · Esc cancels", 12, s.bg)
        return
    }
    if app.notice_ticks > 0 && app.notice.len() > 0 {
        let w = gui.text_width(app.notice, 12) + 30
        let x = board_x() + (board_px() - w) / 2
        gui.round_rect(x, 612, w, 30, 15, s.panel_high)
        gui.stroke(x, 612, w, 30, s.border)
        gui.text(x + 15, 620, app.notice, 12, s.text)
        return
    }
    var hint = "pick a gem · then a neighbour"
    if app.screen == screen_pause() {
        hint = "paused · Space resumes"
    }
    let w = gui.text_width(hint, 11)
    gui.text(board_x() + (board_px() - w) / 2, 622, hint, 11, s.faint)
}

fn draw_footer(app: App, s: Skin) {
    gui.text(left_x(), footer_y(), "GEMSTORM · rules in rules.nova", 10, s.faint)
    let right = "H hints · S storm · Esc pauses · ⌘Q quits"
    gui.text(right_x() + right_w() - gui.text_width(right, 10), footer_y(), right, 10, s.faint)
}

