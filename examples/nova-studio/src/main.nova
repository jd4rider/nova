import std.io { println }
import "../../../libraries/nova-gui/src/gui.nova" as gui
import "../../../libraries/nova-term/src/term.nova" as vt

// Nova Studio, rewritten in Nova on nova-gui.
//
// The layout mirrors the Electron workbench: a 35px title bar with a command
// pill, a 48px activity bar, a 300px explorer, tabs, breadcrumbs, the editor,
// a 240px bottom panel and a 22px status bar, all in the same Dark+ palette.
//
// Everything here is immediate mode: the loop drains one event, updates the
// model and redraws. There is no retained widget tree, so a redraw is a
// function of the model and the window size.

// ---------- layout ----------

fn title_height() -> Int {
    return 35
}

fn status_height() -> Int {
    return 22
}

fn activity_width() -> Int {
    return 48
}

fn sidebar_width() -> Int {
    return 300
}

fn tabs_height() -> Int {
    return 35
}

fn crumbs_height() -> Int {
    return 22
}

fn panel_height() -> Int {
    return 240
}

fn row_height() -> Int {
    return 22
}

fn line_height(size: Int) -> Int {
    return size + 6
}

fn gutter_width() -> Int {
    return 46
}

// ---------- text helpers ----------
//
// Nova's String has no split, substring or character index, so the editor
// builds those from `graphemes()` once here and reuses them everywhere.

fn slice_chars(chars: List<String>, start: Int, stop: Int) -> String {
    var out = ""
    var i = start
    while i < stop && i < chars.len() {
        out = out + chars[i]
        i = i + 1
    }
    return out
}

fn split_lines(text: String) -> List<String> {
    var out: List<String> = []
    var current = ""
    for ch in text.graphemes() {
        if ch == "\n" {
            out.push(current)
            current = ""
        } else {
            if ch != "\r" {
                current = current + ch
            }
        }
    }
    out.push(current)
    return out
}

fn join_lines(lines: List<String>) -> String {
    var out = ""
    var i = 0
    while i < lines.len() {
        if i > 0 {
            out = out + "\n"
        }
        out = out + lines[i]
        i = i + 1
    }
    return out
}

fn replace_line(lines: List<String>, at: Int, value: String) -> List<String> {
    var out: List<String> = []
    var i = 0
    while i < lines.len() {
        if i == at {
            out.push(value)
        } else {
            out.push(lines[i])
        }
        i = i + 1
    }
    return out
}

fn insert_line(lines: List<String>, at: Int, value: String) -> List<String> {
    var out: List<String> = []
    var i = 0
    var placed = false
    while i < lines.len() {
        if i == at {
            out.push(value)
            placed = true
        }
        out.push(lines[i])
        i = i + 1
    }
    if !placed {
        out.push(value)
    }
    return out
}

fn remove_line(lines: List<String>, at: Int) -> List<String> {
    var out: List<String> = []
    var i = 0
    while i < lines.len() {
        if i != at {
            out.push(lines[i])
        }
        i = i + 1
    }
    if out.len() == 0 {
        out.push("")
    }
    return out
}

fn basename(path: String) -> String {
    let chars = path.graphemes()
    var i = chars.len() - 1
    var found = -1
    while i >= 0 {
        if chars[i] == "/" {
            found = i
            i = -1
        } else {
            i = i - 1
        }
    }
    return slice_chars(chars, found + 1, chars.len())
}

fn dirname(path: String) -> String {
    let chars = path.graphemes()
    var i = chars.len() - 1
    var found = -1
    while i >= 0 {
        if chars[i] == "/" {
            found = i
            i = -1
        } else {
            i = i - 1
        }
    }
    if found <= 0 {
        return "/"
    }
    return slice_chars(chars, 0, found)
}

fn relative(root: String, path: String) -> String {
    let root_chars = root.graphemes()
    if path.starts_with(root) {
        let chars = path.graphemes()
        let skip = root_chars.len() + 1
        if chars.len() > skip {
            return slice_chars(chars, skip, chars.len())
        }
    }
    return path
}

fn list_has(items: List<String>, value: String) -> Bool {
    var i = 0
    while i < items.len() {
        if items[i] == value {
            return true
        }
        i = i + 1
    }
    return false
}

fn append_list(into: List<String>, extra: List<String>) -> List<String> {
    var out = into
    var i = 0
    while i < extra.len() {
        out.push(extra[i])
        i = i + 1
    }
    return out
}

fn is_digit(ch: String) -> Bool {
    return "0123456789".contains(ch)
}

fn is_letter(ch: String) -> Bool {
    return "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(ch)
}

fn is_ident_start(ch: String) -> Bool {
    return is_letter(ch) || ch == "_"
}

fn is_ident_part(ch: String) -> Bool {
    return is_letter(ch) || is_digit(ch) || ch == "_"
}

// Printable ASCII, indexed by code - 32, so a key event becomes text without
// an Int-to-Char conversion (Nova has none).
fn printable() -> String {
    return " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
}

fn code_to_text(code: Int) -> String {
    if code < 32 || code > 126 {
        return ""
    }
    let chars = printable().graphemes()
    let index = code - 32
    if index < 0 || index >= chars.len() {
        return ""
    }
    return chars[index]
}

// ---------- syntax ----------
// Dark+ scopes: comments green, strings orange, numbers pale green, keywords
// blue, control flow purple, types teal, function names yellow.

fn comment_color() -> Int {
    return gui.rgb(106, 153, 85)
}

fn string_color() -> Int {
    return gui.rgb(206, 145, 120)
}

fn number_color() -> Int {
    return gui.rgb(181, 206, 168)
}

fn keyword_color() -> Int {
    return gui.rgb(86, 156, 214)
}

fn control_color() -> Int {
    return gui.rgb(197, 134, 192)
}

fn type_color() -> Int {
    return gui.rgb(78, 201, 176)
}

fn func_color() -> Int {
    return gui.rgb(220, 220, 170)
}

fn is_control(word: String) -> Bool {
    return word == "if" || word == "else" || word == "while" || word == "for" || word == "return" ||
        word == "match" || word == "loop" || word == "break" || word == "continue" ||
        word == "in" || word == "import" || word == "as" || word == "use" || word == "where"
}

fn is_decl(word: String) -> Bool {
    return word == "fn" || word == "let" || word == "var" || word == "struct" || word == "enum" ||
        word == "impl" || word == "trait" || word == "pub" || word == "const" || word == "extern" ||
        word == "mut" || word == "self" || word == "true" || word == "false" || word == "static"
}

fn is_upper_char(ch: String) -> Bool {
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(ch)
}

fn is_type(word: String) -> Bool {
    if word.len() == 0 {
        return false
    }
    if is_upper_char(word.graphemes()[0]) {
        return true
    }
    return word == "int" || word == "string" || word == "bool" || word == "float"
}

// True when the identifier that ends at `from` is followed by a call.
fn call_follows(chars: List<String>, from: Int) -> Bool {
    var j = from
    while j < chars.len() && chars[j] == " " {
        j = j + 1
    }
    if j < chars.len() {
        return chars[j] == "("
    }
    return false
}

// Block-comment state at a line, so a /* opened above the viewport still
// colours the visible lines.
fn block_before(lines: List<String>, upto: Int) -> Bool {
    var block = false
    var i = 0
    while i < upto && i < lines.len() {
        let chars = lines[i].graphemes()
        var j = 0
        while j < chars.len() {
            if block {
                if chars[j] == "*" && j + 1 < chars.len() && chars[j + 1] == "/" {
                    block = false
                    j = j + 2
                } else {
                    j = j + 1
                }
            } else {
                if chars[j] == "/" && j + 1 < chars.len() && chars[j + 1] == "/" {
                    j = chars.len()
                } else {
                    if chars[j] == "/" && j + 1 < chars.len() && chars[j + 1] == "*" {
                        block = true
                        j = j + 2
                    } else {
                        if chars[j] == "\"" {
                            var k = j + 1
                            var closed = false
                            while k < chars.len() && !closed {
                                if chars[k] == "\\" && k + 1 < chars.len() {
                                    k = k + 2
                                } else {
                                    if chars[k] == "\"" {
                                        closed = true
                                        k = k + 1
                                    } else {
                                        k = k + 1
                                    }
                                }
                            }
                            j = k
                        } else {
                            j = j + 1
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return block
}

struct Lex {
    block: Bool,
    x: Int,
}

// Draws one line with Dark+ colours. Returns the block-comment state after the
// line so multi-line comments stay green below the opener.
fn draw_code(x0: Int, y: Int, text: String, size: Int, theme: gui.Theme, in_block: Bool) -> Lex {
    let chars = text.graphemes()
    let count = chars.len()
    var x = x0
    var i = 0
    var block = in_block
    var previous = ""
    while i < count {
        let ch = chars[i]
        var token = ""
        var color = theme.fg
        var handled = false
        if block {
            var j = i
            var closed = false
            while j < count && !closed {
                if chars[j] == "*" && j + 1 < count && chars[j + 1] == "/" {
                    j = j + 2
                    closed = true
                } else {
                    j = j + 1
                }
            }
            token = slice_chars(chars, i, j)
            color = comment_color()
            i = j
            block = !closed
            handled = true
        }
        if !handled && ch == "/" && i + 1 < count && chars[i + 1] == "/" {
            token = slice_chars(chars, i, count)
            color = comment_color()
            i = count
            handled = true
        }
        if !handled && ch == "/" && i + 1 < count && chars[i + 1] == "*" {
            var j = i + 2
            var closed = false
            while j < count && !closed {
                if chars[j] == "*" && j + 1 < count && chars[j + 1] == "/" {
                    j = j + 2
                    closed = true
                } else {
                    j = j + 1
                }
            }
            token = slice_chars(chars, i, j)
            color = comment_color()
            i = j
            block = !closed
            handled = true
        }
        if !handled && (ch == "\"" || ch == "'") {
            let quote = ch
            var j = i + 1
            var closed = false
            while j < count && !closed {
                if chars[j] == "\\" && j + 1 < count {
                    j = j + 2
                } else {
                    if chars[j] == quote {
                        closed = true
                        j = j + 1
                    } else {
                        j = j + 1
                    }
                }
            }
            token = slice_chars(chars, i, j)
            color = string_color()
            i = j
            handled = true
        }
        if !handled && is_digit(ch) {
            var j = i
            var go = true
            while j < count && go {
                let c = chars[j]
                if is_digit(c) || c == "." || c == "_" || c == "x" || c == "b" || c == "f" {
                    j = j + 1
                } else {
                    go = false
                }
            }
            token = slice_chars(chars, i, j)
            color = number_color()
            i = j
            handled = true
        }
        if !handled && is_ident_start(ch) {
            var j = i
            var go = true
            while j < count && go {
                if is_ident_part(chars[j]) {
                    j = j + 1
                } else {
                    go = false
                }
            }
            token = slice_chars(chars, i, j)
            color = theme.fg
            if is_control(token) {
                color = control_color()
            } else {
                if is_decl(token) {
                    color = keyword_color()
                } else {
                    if is_type(token) {
                        color = type_color()
                    } else {
                        if previous == "fn" || call_follows(chars, j) {
                            color = func_color()
                        }
                    }
                }
            }
            i = j
            handled = true
        }
        if !handled {
            token = ch
            color = theme.fg
            i = i + 1
        }
        previous = token
        gui.mono(x, y, token, size, color)
        x = x + gui.mono_width(token, size)
    }
    return Lex { block: block, x: x }
}

// ---------- model ----------

struct Node {
    path: String,
    name: String,
    depth: Int,
    is_dir: Bool,
}

struct Tab {
    path: String,
    name: String,
    lines: List<String>,
    dirty: Bool,
    cursor_line: Int,
    cursor_col: Int,
    scroll: Int,
    undo: List<String>,
    folds: List<Int>,
    sel_line: Int,
    sel_col: Int,
    selecting: Bool,
}

struct Command {
    id: String,
    label: String,
    hint: String,
}

// A plugin is a manifest in <workspace>/plugins: id, label and the shell
// command it runs. The studio lists it in the palette and streams its output.
struct Plugin {
    id: String,
    label: String,
    command: String,
}

struct Row {
    key: String,
    label: String,
    hint: String,
}

struct App {
    root: String,
    nodes: List<Node>,
    expanded: List<String>,
    tabs: List<Tab>,
    active: Int,
    theme: gui.Theme,
    theme_name: String,
    size: Int,
    overlay: String,
    field: String,
    field_cursor: Int,
    selection: Int,
    output: String,
    bottom: String,
    panel: Bool,
    sidebar: Bool,
    status: String,
    quit: Bool,
    tree_scroll: Int,
    files: List<String>,
    mouse_x: Int,
    mouse_y: Int,
    vim: Bool,
    mode: String,
    yank: String,
    pending: String,
    anchor: Int,
    anim: Int,
    minimap: Bool,
    plugins: List<Plugin>,
    field2: String,
    field2_cursor: Int,
    focus: Int,
    cursors: List<Int>,
    term: vt.Term,
    term_slot: Int,
    term_cols: Int,
    term_rows: Int,
    task_running: Bool,
    split: Bool,
    pane: Int,
    pane_tabs: List<Int>,
    term_focus: Bool,
    dim: Bool,
    tab_drag: Int,
    refs: List<String>,
    ref_paths: List<String>,
    ref_lines: List<Int>,
    ref_index: Int,
}

// ---------- workspace ----------

fn skip_dir(name: String) -> Bool {
    return name == "target" || name == "node_modules" || name == "dist" || name == "out" || name == "release" || name == ".git"
}

fn build_nodes(root: String, depth: Int, expanded: List<String>) -> List<Node> {
    var nodes: List<Node> = []
    let entries = split_lines(gui.list(root))
    var i = 0
    while i < entries.len() {
        let chars = entries[i].graphemes()
        if chars.len() > 2 {
            let name = slice_chars(chars, 2, chars.len())
            let path = root + "/" + name
            let is_dir = chars[0] == "d"
            nodes.push(Node { path: path, name: name, depth: depth, is_dir: is_dir })
            if is_dir && list_has(expanded, path) {
                let children = build_nodes(path, depth + 1, expanded)
                var c = 0
                while c < children.len() {
                    nodes.push(children[c])
                    c = c + 1
                }
            }
        }
        i = i + 1
    }
    return nodes
}

fn collect_files(root: String, depth: Int) -> List<String> {
    var out: List<String> = []
    if depth > 6 {
        return out
    }
    let entries = split_lines(gui.list(root))
    var i = 0
    while i < entries.len() {
        let chars = entries[i].graphemes()
        if chars.len() > 2 {
            let name = slice_chars(chars, 2, chars.len())
            let path = root + "/" + name
            if chars[0] == "d" {
                if !skip_dir(name) {
                    out = append_list(out, collect_files(path, depth + 1))
                }
            } else {
                out.push(path)
            }
        }
        i = i + 1
    }
    return out
}

fn open_workspace(app: App, path: String) -> App {
    var app = app
    if !gui.is_dir(path) {
        app.status = "Not a folder: " + path
        return app
    }
    var none: List<String> = []
    app.root = path
    app.expanded = none
    app.nodes = build_nodes(path, 0, none)
    app.files = []
    app.tree_scroll = 0
    app.status = "Opened " + basename(path)
    app.overlay = ""
    app.plugins = load_plugins(path)
    return app
}

fn manifest_value(text: String, key: String) -> String {
    for line in split_lines(text) {
        let trimmed = line.trim()
        if trimmed.starts_with(key + "=") {
            let chars = trimmed.graphemes()
            return slice_chars(chars, key.len() + 1, chars.len()).trim()
        }
    }
    return ""
}

// Plugins are manifests in <workspace>/plugins/*.plugin:
//   id=format
//   label=Format document
//   command=nova fmt src/main.nova
fn load_plugins(root: String) -> List<Plugin> {
    var out: List<Plugin> = []
    let entries = split_lines(gui.list(root + "/plugins"))
    var i = 0
    while i < entries.len() {
        let chars = entries[i].graphemes()
        if chars.len() > 2 && chars[0] == "f" {
            let name = slice_chars(chars, 2, chars.len())
            if ext_of(name) == "plugin" {
                let text = gui.read(root + "/plugins/" + name)
                let id = manifest_value(text, "id")
                let label = manifest_value(text, "label")
                let command = manifest_value(text, "command")
                if id.len() > 0 && command.len() > 0 {
                    var shown = label
                    if shown.len() == 0 {
                        shown = id
                    }
                    out.push(Plugin { id: id, label: shown, command: command })
                }
            }
        }
        i = i + 1
    }
    return out
}

fn project_name(root: String) -> String {
    let text = gui.read(root + "/nova.toml")
    if text.len() == 0 {
        return ""
    }
    for line in split_lines(text) {
        let trimmed = line.trim()
        if trimmed.starts_with("name") {
            let chars = trimmed.graphemes()
            var i = 0
            var found = -1
            while i < chars.len() {
                if chars[i] == "=" {
                    found = i
                    i = chars.len()
                } else {
                    i = i + 1
                }
            }
            if found >= 0 {
                let raw = slice_chars(chars, found + 1, chars.len()).trim()
                return raw.replace("\"", "")
            }
        }
    }
    return ""
}

// ---------- tabs and editing ----------

fn active_tab(app: App) -> Tab {
    if app.active < 0 || app.active >= app.tabs.len() {
        var no_undo: List<String> = []
        var no_folds: List<Int> = []
        return Tab { path: "", name: "", lines: [""], dirty: false, cursor_line: 0, cursor_col: 0, scroll: 0, undo: no_undo, folds: no_folds, sel_line: 0, sel_col: 0, selecting: false }
    }
    return app.tabs[app.active]
}

fn open_file(app: App, path: String) -> App {
    var app = app
    var i = 0
    while i < app.tabs.len() {
        if app.tabs[i].path == path {
            app = set_pane_tab(app, i)
            app.overlay = ""
            app.field = ""
            app.field_cursor = 0
            return app
        }
        i = i + 1
    }
    let text = gui.read(path)
    var tabs = app.tabs
    var no_undo: List<String> = []
    var no_folds: List<Int> = []
    tabs.push(Tab {
        path: path,
        name: basename(path),
        lines: split_lines(text),
        dirty: false,
        cursor_line: 0,
        cursor_col: 0,
        scroll: 0,
        undo: no_undo,
        folds: no_folds,
        sel_line: 0,
        sel_col: 0,
        selecting: false,
    })
    app.tabs = tabs
    app = set_pane_tab(app, tabs.len() - 1)
    app.overlay = ""
    app.field = ""
    app.field_cursor = 0
    app.status = ""
    return app
}

fn close_tab(app: App) -> App {
    var app = app
    if app.active < 0 || app.tabs.len() == 0 {
        return app
    }
    var rest: List<Tab> = []
    var i = 0
    while i < app.tabs.len() {
        if i != app.active {
            rest.push(app.tabs[i])
        }
        i = i + 1
    }
    app.tabs = rest
    if app.active >= rest.len() {
        app.active = rest.len() - 1
    }
    var pane_tabs = app.pane_tabs
    var p = 0
    while p < pane_tabs.len() {
        if pane_tabs[p] >= app.tabs.len() || p == app.pane {
            pane_tabs[p] = app.active
        }
        p = p + 1
    }
    app.pane_tabs = pane_tabs
    return app
}

fn save(app: App) -> App {
    var app = app
    if app.active < 0 {
        return app
    }
    var tab = app.tabs[app.active]
    let text = join_lines(tab.lines)
    if gui.write(tab.path, text) {
        tab.dirty = false
        app.status = "Saved " + tab.name
    } else {
        app.status = "Could not save " + tab.name
    }
    app.tabs[app.active] = tab
    return app
}

fn save_all(app: App) -> App {
    var app = app
    var i = 0
    var saved = 0
    while i < app.tabs.len() {
        var tab = app.tabs[i]
        if tab.dirty {
            if gui.write(tab.path, join_lines(tab.lines)) {
                tab.dirty = false
                app.tabs[i] = tab
                saved = saved + 1
            }
        }
        i = i + 1
    }
    app.status = "Saved " + "${saved}" + " file(s)"
    return app
}

fn edit_insert(app: App, value: String) -> App {
    var app = app
    if app.active < 0 {
        return app
    }
    app = clear_selection(app)
    app = snapshot(app)
    if app.cursors.len() > 0 {
        return insert_at_carets(app, value)
    }
    var tab = app.tabs[app.active]
    let chars = tab.lines[tab.cursor_line].graphemes()
    let col = gui.clamp(tab.cursor_col, 0, chars.len())
    let before = slice_chars(chars, 0, col)
    let after = slice_chars(chars, col, chars.len())
    tab.lines = replace_line(tab.lines, tab.cursor_line, before + value + after)
    tab.cursor_col = col + value.graphemes().len()
    tab.dirty = true
    app.tabs[app.active] = tab
    app.status = ""
    return app
}

fn edit_newline(app: App) -> App {
    var app = app
    if app.active < 0 {
        return app
    }
    app = clear_selection(app)
    app = snapshot(app)
    var tab = app.tabs[app.active]
    let chars = tab.lines[tab.cursor_line].graphemes()
    let col = gui.clamp(tab.cursor_col, 0, chars.len())
    let before = slice_chars(chars, 0, col)
    let after = slice_chars(chars, col, chars.len())
    tab.lines = replace_line(tab.lines, tab.cursor_line, before)
    tab.lines = insert_line(tab.lines, tab.cursor_line + 1, after)
    tab.cursor_line = tab.cursor_line + 1
    tab.cursor_col = 0
    tab.dirty = true
    app.tabs[app.active] = tab
    return app
}

fn edit_backspace(app: App) -> App {
    var app = app
    if app.active < 0 {
        return app
    }
    if app.tabs[app.active].selecting {
        return clear_selection(app)
    }
    app = snapshot(app)
    if app.cursors.len() > 0 {
        return backspace_at_carets(app)
    }
    var tab = app.tabs[app.active]
    if tab.cursor_col > 0 {
        let chars = tab.lines[tab.cursor_line].graphemes()
        let col = gui.clamp(tab.cursor_col, 0, chars.len())
        let before = slice_chars(chars, 0, col - 1)
        let after = slice_chars(chars, col, chars.len())
        tab.lines = replace_line(tab.lines, tab.cursor_line, before + after)
        tab.cursor_col = col - 1
        tab.dirty = true
    } else {
        if tab.cursor_line > 0 {
            let previous = tab.lines[tab.cursor_line - 1]
            let current = tab.lines[tab.cursor_line]
            tab.lines = replace_line(tab.lines, tab.cursor_line - 1, previous + current)
            tab.lines = remove_line(tab.lines, tab.cursor_line)
            tab.cursor_line = tab.cursor_line - 1
            tab.cursor_col = previous.graphemes().len()
            tab.dirty = true
        }
    }
    app.tabs[app.active] = tab
    return app
}

fn edit_delete(app: App) -> App {
    var app = app
    if app.active < 0 {
        return app
    }
    if app.tabs[app.active].selecting {
        return clear_selection(app)
    }
    app = snapshot(app)
    var tab = app.tabs[app.active]
    let chars = tab.lines[tab.cursor_line].graphemes()
    let col = gui.clamp(tab.cursor_col, 0, chars.len())
    if col < chars.len() {
        let before = slice_chars(chars, 0, col)
        let after = slice_chars(chars, col + 1, chars.len())
        tab.lines = replace_line(tab.lines, tab.cursor_line, before + after)
        tab.dirty = true
    } else {
        if tab.cursor_line + 1 < tab.lines.len() {
            let current = tab.lines[tab.cursor_line]
            let next = tab.lines[tab.cursor_line + 1]
            tab.lines = replace_line(tab.lines, tab.cursor_line, current + next)
            tab.lines = remove_line(tab.lines, tab.cursor_line + 1)
            tab.dirty = true
        }
    }
    app.tabs[app.active] = tab
    return app
}

fn edit_move(app: App, dline: Int, dcol: Int) -> App {
    var app = app
    if app.active < 0 {
        return app
    }
    var tab = app.tabs[app.active]
    var line = tab.cursor_line + dline
    line = gui.clamp(line, 0, tab.lines.len() - 1)
    var col = tab.cursor_col
    if dline != 0 {
        col = tab.cursor_col
    } else {
        col = tab.cursor_col + dcol
    }
    if col < 0 {
        if line > 0 {
            line = line - 1
            col = tab.lines[line].graphemes().len()
        } else {
            col = 0
        }
    }
    if col > tab.lines[line].graphemes().len() {
        if line + 1 < tab.lines.len() {
            line = line + 1
            col = 0
        } else {
            col = tab.lines[line].graphemes().len()
        }
    }
    tab.cursor_line = line
    tab.cursor_col = gui.clamp(col, 0, tab.lines[line].graphemes().len())
    tab = tab_scrolled(tab)
    app.tabs[app.active] = tab
    return app
}

fn edit_home(app: App) -> App {
    var app = app
    if app.active < 0 {
        return app
    }
    var tab = app.tabs[app.active]
    tab.cursor_col = 0
    app.tabs[app.active] = tab
    return app
}

fn edit_end(app: App) -> App {
    var app = app
    if app.active < 0 {
        return app
    }
    var tab = app.tabs[app.active]
    tab.cursor_col = tab.lines[tab.cursor_line].graphemes().len()
    app.tabs[app.active] = tab
    return app
}

// Keeps the caret inside the visible rows.
fn tab_scrolled(tab: Tab) -> Tab {
    var tab = tab
    let visible = (gui.height() - title_height() - status_height() - tabs_height() - crumbs_height()) / line_height(13)
    let rows = visible_rows(tab)
    let row = row_of(rows, tab.cursor_line)
    if row >= 0 {
        if row < tab.scroll {
            tab.scroll = row
        }
        if row >= tab.scroll + visible {
            tab.scroll = row - visible + 1
        }
    }
    if tab.scroll < 0 {
        tab.scroll = 0
    }
    return tab
}

// ---------- tasks ----------

fn nova_binary() -> String {
    var nova = gui.env("NOVA_BIN")
    if nova.len() == 0 {
        nova = "nova"
    }
    return nova
}

fn with_trailing_newline(text: String) -> String {
    if text.len() == 0 {
        return text
    }
    let chars = text.graphemes()
    if chars[chars.len() - 1] == "\n" {
        return text
    }
    return text + "\n"
}

fn run_task(app: App, kind: String) -> App {
    var app = app
    let command = nova_binary() + " " + kind + " 2>&1"
    app.bottom = "terminal"
    app.panel = true
    app.term = vt.tm_new(app.term_cols, app.term_rows)
    vt.tm_feed(app.term, vt.tm_escape() + "[2J" + vt.tm_escape() + "[H")
    vt.tm_feed(app.term, "\u{1b}[38;5;39m$ \u{1b}[0m" + command + "\r\n")
    if gui.pty_open(app.term_slot, command, app.root, app.term_cols, app.term_rows) {
        app.task_running = true
        app.status = kind + " running…"
    } else {
        app.status = "Could not start " + kind
    }
    return app
}

fn run_project(app: App) -> App {
    var app = app
    let nova = nova_binary()
    app.status = "building…"
    gui.begin()
    draw(app)
    gui.present()
    let built = gui.run(nova + " build", app.root)
    let status = gui.exit_status()
    if status != 0 {
        var text = "$ " + nova + " build\n" + with_trailing_newline(built)
        text = text + "\nexit " + "${status}"
        app.output = text
        app.bottom = "output"
        app.panel = true
        app.status = "build failed"
        return app
    }
    let name = project_name(app.root)
    if name.len() == 0 {
        app.status = "No nova.toml in this workspace"
        return app
    }
    let target = "./target/nova/" + name
    let launched = gui.run("open -a Terminal " + target, app.root)
    var text = "$ " + nova + " build\n" + with_trailing_newline(built)
    text = text + "\nlaunched " + target + " in Terminal\n" + launched
    app.output = text
    app.bottom = "output"
    app.panel = true
    app.status = "running " + name
    return app
}

// ---------- palette ----------

fn commands() -> List<Command> {
    var list: List<Command> = []
    list.push(Command { id: "build", label: "Build project", hint: "⌘B" })
    list.push(Command { id: "run", label: "Build and run in Terminal", hint: "⌘R" })
    list.push(Command { id: "check", label: "Check project", hint: "⇧⌘B" })
    list.push(Command { id: "save", label: "Save file", hint: "⌘S" })
    list.push(Command { id: "saveall", label: "Save all files", hint: "⇧⌘S" })
    list.push(Command { id: "close", label: "Close tab", hint: "⌘W" })
    list.push(Command { id: "quick", label: "Go to file", hint: "⌘P" })
    list.push(Command { id: "palette", label: "Show all commands", hint: "⇧⌘P" })
    list.push(Command { id: "sidebar", label: "Toggle sidebar", hint: "⇧⌘E" })
    list.push(Command { id: "panel", label: "Toggle bottom panel", hint: "⌘`" })
    list.push(Command { id: "docs", label: "Open documentation", hint: "" })
    list.push(Command { id: "settings", label: "Settings", hint: "⌘," })
    list.push(Command { id: "openfile", label: "File: Open File…", hint: "⌘O" })
    list.push(Command { id: "openfolder", label: "File: Open Folder…", hint: "⇧⌘O" })
    list.push(Command { id: "vim", label: "Toggle Vim mode", hint: "" })
    list.push(Command { id: "minimap", label: "Toggle minimap", hint: "" })
    list.push(Command { id: "terminal", label: "Toggle terminal", hint: "" })
    list.push(Command { id: "addcursor", label: "Select next occurrence", hint: "⌘D" })
    list.push(Command { id: "split", label: "Toggle split editor", hint: "⌘\\" })
    list.push(Command { id: "definition", label: "Go to definition", hint: "F12" })
    list.push(Command { id: "references", label: "Find references", hint: "⇧F12" })
    list.push(Command { id: "about", label: "About Nova Studio", hint: "" })
    list.push(Command { id: "quit", label: "Quit", hint: "⌘Q" })
    return list
}

fn rows(app: App) -> List<Row> {
    var list: List<Row> = []
    let query = app.field.lower()
    if app.overlay == "palette" {
        for command in commands() {
            if query.len() == 0 || command.label.lower().contains(query) {
                list.push(Row { key: command.id, label: command.label, hint: command.hint })
            }
        }
        for plugin in app.plugins {
            let label = "Plugin: " + plugin.label
            if query.len() == 0 || label.lower().contains(query) {
                list.push(Row { key: "plugin:" + plugin.id, label: label, hint: "plugin" })
            }
        }
    } else {
        for path in app.files {
            let shown = relative(app.root, path)
            if query.len() == 0 || shown.lower().contains(query) {
                list.push(Row { key: path, label: shown, hint: "" })
            }
        }
    }
    return list
}

fn open_palette(app: App) -> App {
    var app = app
    app.overlay = "palette"
    app.field = ""
    app.field_cursor = 0
    app.selection = 0
    return app
}

fn open_quick(app: App) -> App {
    var app = app
    app.overlay = "quick"
    app.field = ""
    app.field_cursor = 0
    app.selection = 0
    app.files = collect_files(app.root, 0)
    return app
}

fn run_command(app: App, id: String) -> App {
    var next = app
    next.overlay = ""
    next.field = ""
    next.field_cursor = 0
    next.selection = 0
    if id == "build" {
        return run_task(next, "build")
    }
    if id == "check" {
        return run_task(next, "check")
    }
    if id == "run" {
        return run_project(next)
    }
    if id == "save" {
        return save(next)
    }
    if id == "saveall" {
        return save_all(next)
    }
    if id == "close" {
        return close_tab(next)
    }
    if id == "quick" {
        return open_quick(next)
    }
    if id == "palette" {
        return open_palette(next)
    }
    if id == "sidebar" {
        next.sidebar = !next.sidebar
        return next
    }
    if id == "panel" {
        next.panel = !next.panel
        return next
    }
    if id == "docs" {
        next.panel = true
        next.bottom = "docs"
        return next
    }
    if id == "settings" {
        next.overlay = "settings"
        return next
    }
    if id == "about" {
        next.overlay = "about"
        return next
    }
    if id == "openfile" {
        let picked = gui.pick_file()
        if picked.len() > 0 {
            return open_file(next, picked)
        }
        return next
    }
    if id == "openfolder" {
        let picked = gui.pick_folder()
        if picked.len() > 0 {
            return open_workspace(next, picked)
        }
        return next
    }
    if id == "vim" {
        next.vim = !next.vim
        if next.vim {
            next.mode = "normal"
        } else {
            next.mode = "insert"
        }
        var state = "off"
        if next.vim {
            state = "on"
        }
        next.status = "Vim " + state
        return next
    }
    if id == "minimap" {
        next.minimap = !next.minimap
        return next
    }
    if id.starts_with("plugin:") {
        let key = id.replace("plugin:", "")
        var i = 0
        while i < next.plugins.len() {
            let plugin = next.plugins[i]
            if plugin.id == key {
                next.status = "Running " + plugin.label
                gui.begin()
                draw(next)
                gui.present()
                let output = gui.run(plugin.command, next.root)
                let status = gui.exit_status()
                var text = "$ " + plugin.command + "\n"
                text = text + with_trailing_newline(output)
                text = text + "\nexit " + "${status}"
                next.output = text
                next.panel = true
                next.bottom = "output"
                next.status = plugin.label + " exited " + "${status}"
                return next
            }
            i = i + 1
        }
        next.status = "No such plugin: " + key
        return next
    }
    if id == "terminal" {
        next.panel = true
        next.bottom = "terminal"
        return next
    }
    if id == "addcursor" {
        return add_cursor(next)
    }
    if id == "split" {
        return toggle_split(next)
    }
    if id == "definition" {
        return go_to_definition(next)
    }
    if id == "references" {
        return find_references(next)
    }
    if id == "quit" {
        next.quit = true
        return next
    }
    return next
}

// ---------- icons ----------
// Material-style icons drawn from line segments: nova-gui has no icon font, and
// vector shapes stay sharp at every size and theme.

// Eight segments read as a circle at icon sizes without trigonometry.
fn ring(cx: Int, cy: Int, r: Int, color: Int) {
    let s = r * 7 / 10
    let xs: List<Int> = [cx + r, cx + s, cx, cx - s, cx - r, cx - s, cx, cx + s]
    let ys: List<Int> = [cy, cy + s, cy + r, cy + s, cy, cy - s, cy - r, cy - s]
    var i = 0
    while i < 8 {
        let next = (i + 1) % 8
        gui.line(xs[i], ys[i], xs[next], ys[next], color)
        i = i + 1
    }
}

fn icon(name: String, x: Int, y: Int, size: Int, color: Int) {
    if name == "files" {
        gui.stroke(x + 3, y + 1, size - 6, size - 2, color)
        gui.line(x + size - 9, y + 1, x + size - 9, y + 6, color)
        gui.line(x + size - 9, y + 1, x + size - 4, y + 6, color)
        gui.line(x + 6, y + 9, x + size - 8, y + 9, color)
        gui.line(x + 6, y + size - 5, x + size - 8, y + size - 5, color)
    }
    if name == "search" {
        ring(x + size / 2 - 2, y + size / 2 - 2, size / 3, color)
        gui.line(x + size - 7, y + size - 7, x + size - 2, y + size - 2, color)
    }
    if name == "git" {
        ring(x + 4, y + 4, 2, color)
        ring(x + size - 5, y + 7, 2, color)
        ring(x + 4, y + size - 5, 2, color)
        gui.line(x + 4, y + 6, x + 4, y + size - 7, color)
        gui.line(x + 5, y + 9, x + size - 6, y + 8, color)
    }
    if name == "extensions" {
        gui.stroke(x + 2, y + 2, 7, 7, color)
        gui.stroke(x + size - 9, y + 2, 7, 7, color)
        gui.stroke(x + 2, y + size - 9, 7, 7, color)
        gui.stroke(x + size - 9, y + size - 9, 7, 7, color)
    }
    if name == "settings" {
        ring(x + size / 2, y + size / 2, size / 3, color)
        gui.line(x + size / 2, y, x + size / 2, y + 3, color)
        gui.line(x + size / 2, y + size - 3, x + size / 2, y + size, color)
        gui.line(x, y + size / 2, x + 3, y + size / 2, color)
        gui.line(x + size - 3, y + size / 2, x + size, y + size / 2, color)
    }
    if name == "sidebar" {
        gui.stroke(x + 2, y + 3, size - 4, size - 6, color)
        gui.line(x + 8, y + 3, x + 8, y + size - 3, color)
    }
    if name == "panel" {
        gui.stroke(x + 2, y + 3, size - 4, size - 6, color)
        gui.line(x + 2, y + size - 7, x + size - 2, y + size - 7, color)
    }
    if name == "close" {
        gui.line(x + 4, y + 4, x + size - 4, y + size - 4, color)
        gui.line(x + size - 4, y + 4, x + 4, y + size - 4, color)
    }
}

fn ext_of(name: String) -> String {
    let chars = name.graphemes()
    var i = chars.len() - 1
    var found = -1
    while i >= 0 {
        if chars[i] == "." {
            found = i
            i = -1
        } else {
            i = i - 1
        }
    }
    if found < 0 {
        return ""
    }
    return slice_chars(chars, found + 1, chars.len())
}

// Tones from the Material icon theme, so file types read the same as before.
fn file_color(name: String) -> Int {
    let ext = ext_of(name)
    if ext == "toml" {
        return gui.rgb(156, 102, 75)
    }
    if ext == "lock" {
        return gui.rgb(109, 128, 134)
    }
    if ext == "nova" {
        return gui.rgb(81, 154, 186)
    }
    if ext == "md" {
        return gui.rgb(81, 154, 186)
    }
    if ext == "sh" {
        return gui.rgb(137, 224, 81)
    }
    if ext == "json" {
        return gui.rgb(203, 203, 65)
    }
    if ext == "html" || ext == "css" || ext == "astro" {
        return gui.rgb(227, 121, 57)
    }
    return gui.rgb(144, 164, 174)
}

fn draw_file_icon(x: Int, y: Int, name: String) {
    let color = file_color(name)
    gui.rect(x, y, 11, 14, color)
    gui.rect(x + 8, y, 3, 3, gui.rgb(30, 30, 30))
    gui.rect(x + 2, y + 6, 7, 1, gui.rgb(30, 30, 30))
    gui.rect(x + 2, y + 9, 5, 1, gui.rgb(30, 30, 30))
}

fn draw_folder_icon(x: Int, y: Int, open: Bool) {
    let color = gui.rgb(232, 163, 61)
    gui.rect(x, y, 6, 3, color)
    gui.rect(x, y + 3, 14, 10, color)
    if open {
        gui.rect(x + 1, y + 5, 12, 1, gui.rgb(30, 30, 30))
    }
}

// ---------- drawing ----------

fn draw(app: App) {
    let theme = app.theme
    let w = gui.width()
    let h = gui.height()
    gui.clear(theme.bg)
    draw_title(app, w)
    draw_activity(app, h)
    if app.sidebar {
        draw_sidebar(app, h)
    }
    draw_main(app, w, h)
    draw_status(app, w, h)
    if app.overlay.len() > 0 {
        draw_overlay(app, w, h)
    }
}

// Immediate-mode hit testing for hover feedback: the pointer is only ever the
// last mouse-move the host reported, so this is a pure function of the model.
fn hovering(app: App, x: Int, y: Int, w: Int, h: Int) -> Bool {
    let mx = app.mouse_x
    let my = app.mouse_y
    if mx < x || my < y {
        return false
    }
    if mx >= x + w || my >= y + h {
        return false
    }
    return true
}

fn draw_title(app: App, w: Int) {
    let theme = app.theme
    gui.rect(0, 0, w, title_height(), theme.bg_hard)
    gui.line(0, title_height() - 1, w, title_height() - 1, theme.border)
    var pill = w * 60 / 100
    if pill > 520 {
        pill = 520
    }
    if pill < 220 {
        pill = 220
    }
    let pill_x = (w - pill) / 2
    var pill_bg = gui.rgb(36, 36, 36)
    if hovering(app, pill_x, 6, pill, 24) {
        pill_bg = theme.elevated
    }
    gui.round_rect(pill_x, 6, pill, 24, 6, pill_bg)
    gui.stroke(pill_x, 6, pill, 24, theme.border_strong)
    gui.text(pill_x + 11, 10, "✦", 11, gui.rgb(90, 200, 255))
    var label = "Nova Studio"
    if app.active >= 0 && app.tabs.len() > 0 {
        label = app.tabs[app.active].name
        if app.tabs[app.active].dirty {
            label = "● " + label
        }
    }
    gui.text(pill_x + 26, 9, label, 12, theme.muted)
    let buttons: List<String> = ["sidebar", "panel", "settings"]
    var bx = w - 104
    var bi = 0
    while bi < 3 {
        var bcolor = theme.muted
        if hovering(app, bx, 5, 26, 26) {
            gui.round_rect(bx, 5, 26, 26, 5, theme.elevated)
            bcolor = theme.fg_bright
        }
        icon(buttons[bi], bx + 5, 10, 16, bcolor)
        bx = bx + 30
        bi = bi + 1
    }
}

fn draw_activity(app: App, h: Int) {
    let theme = app.theme
    let top = title_height()
    let bottom = h - status_height()
    gui.rect(0, top, activity_width(), bottom - top, theme.bg_hard)
    gui.line(activity_width() - 1, top, activity_width() - 1, bottom, theme.border)
    let names: List<String> = ["files", "search", "git", "settings"]
    var i = 0
    while i < 4 {
        let y = top + 4 + i * 46
        let hovered = hovering(app, 0, y, activity_width(), 46)
        if hovered {
            gui.rect(0, y, activity_width(), 46, theme.elevated)
        }
        var color = theme.muted
        if i == 0 {
            color = theme.fg_bright
            gui.rect(0, y, 2, 46, theme.fg_bright)
        }
        if hovered && i != 0 {
            color = theme.fg_bright
        }
        icon(names[i], 13, y + 14, 18, color)
        i = i + 1
    }
}

fn draw_sidebar(app: App, h: Int) {
    let theme = app.theme
    let x = activity_width()
    let top = title_height()
    let bottom = h - status_height()
    gui.rect(x, top, sidebar_width(), bottom - top, theme.panel)
    gui.line(x + sidebar_width() - 1, top, x + sidebar_width() - 1, bottom, theme.border)
    gui.text(x + 20, top + 11, "EXPLORER", 11, theme.fg)
    var refresh = theme.muted
    if hovering(app, x + sidebar_width() - 34, top + 4, 30, 26) {
        refresh = theme.fg_bright
    }
    gui.text(x + sidebar_width() - 28, top + 8, "↻", 14, refresh)
    gui.text(x + 14, top + 40, basename(app.root), 12, theme.fg_bright)
    let start_y = top + 62
    gui.clip(x, start_y, sidebar_width() - 1, bottom - start_y)
    var i = app.tree_scroll
    var row = 0
    while i < app.nodes.len() && start_y + row * row_height() < bottom {
        let node = app.nodes[i]
        let ry = start_y + row * row_height()
        var selected = false
        if app.active >= 0 && app.tabs.len() > 0 && app.tabs[app.active].path == node.path {
            selected = true
        }
        let hovered = hovering(app, x, ry, sidebar_width() - 1, row_height())
        if hovered && !selected {
            gui.rect(x, ry, sidebar_width() - 1, row_height(), theme.elevated)
        }
        if selected {
            gui.rect(x, ry, sidebar_width() - 1, row_height(), theme.selection)
        }
        let indent = 12 + node.depth * 12
        var color = theme.fg
        if selected || hovered {
            color = theme.fg_bright
        }
        let icon_x = x + indent + 13
        if node.is_dir {
            var chevron = "▸"
            if list_has(app.expanded, node.path) {
                chevron = "▾"
            }
            gui.text(x + indent, ry + 5, chevron, 11, theme.fg)
            draw_folder_icon(icon_x, ry + 5, list_has(app.expanded, node.path))
            gui.text(icon_x + 20, ry + 4, node.name, 12, color)
        } else {
            draw_file_icon(icon_x, ry + 4, node.name)
            gui.text(icon_x + 20, ry + 4, node.name, 12, color)
        }
        i = i + 1
        row = row + 1
    }
    gui.clip_reset()
}

fn draw_tabs(app: App, x: Int, y: Int, w: Int) {
    let theme = app.theme
    gui.rect(x, y, w, tabs_height(), theme.panel)
    gui.line(x, y + tabs_height() - 1, x + w, y + tabs_height() - 1, theme.border)
    gui.clip(x, y, w, tabs_height())
    var tx = x
    var i = 0
    while i < app.tabs.len() {
        let tab = app.tabs[i]
        var width = gui.mono_width(tab.name, 12) + 62
        if width > 240 {
            width = 240
        }
        if width < 120 {
            width = 120
        }
        if i == app.active {
            gui.rect(tx, y, width, tabs_height(), theme.bg)
            gui.rect(tx, y, width, 1, theme.accent)
        } else {
            var tab_bg = gui.rgb(45, 45, 45)
            if hovering(app, tx, y, width, tabs_height()) {
                tab_bg = gui.rgb(58, 58, 58)
            }
            gui.rect(tx, y, width, tabs_height(), tab_bg)
        }
        gui.line(tx + width - 1, y, tx + width - 1, y + tabs_height(), theme.border)
        var color = gui.rgb(150, 150, 150)
        if i == app.active {
            color = theme.fg_bright
        }
        gui.text(tx + 10, y + 9, tab.name, 12, color)
        if tab.dirty {
            gui.text(tx + width - 38, y + 9, "●", 9, theme.fg)
        }
        gui.text(tx + width - 22, y + 8, "✕", 11, theme.muted)
        tx = tx + width
        i = i + 1
    }
    gui.clip_reset()
}

fn draw_crumbs(app: App, x: Int, y: Int, w: Int) {
    let theme = app.theme
    gui.rect(x, y, w, crumbs_height(), theme.bg)
    gui.line(x, y + crumbs_height() - 1, x + w, y + crumbs_height() - 1, theme.border)
    if app.active >= 0 && app.tabs.len() > 0 {
        let path = relative(app.root, app.tabs[app.active].path)
        gui.text(x + 12, y + 4, basename(app.root), 11, theme.muted)
        gui.text(x + 12 + gui.text_width(basename(app.root), 11) + 4, y + 4, "›", 11, theme.faint)
        gui.text(x + 12 + gui.text_width(basename(app.root), 11) + 16, y + 4, path, 11, theme.fg)
        let symbol_tab = app.tabs[app.active]
        let span = fn_range(symbol_tab.lines, symbol_tab.cursor_line)
        if span.len() == 2 {
            let symbol_x = x + 12 + gui.text_width(basename(app.root), 11) + 16 + gui.text_width(path, 11) + 10
            gui.text(symbol_x, y + 4, "›", 11, theme.faint)
            gui.text(symbol_x + 11, y + 4, fn_name(symbol_tab.lines, span[0]) + "()", 11, theme.muted)
        }
    }
}

fn draw_welcome(app: App, x: Int, y: Int, w: Int, h: Int) {
    let theme = app.theme
    let left = x + 52
    let top = y + 46
    gui.text(left, top, "✦", 18, gui.rgb(90, 200, 255))
    gui.text(left, top + 26, "Nova Studio", 30, theme.fg_bright)
    gui.text(left, top + 66, "A workbench for the Nova language, written in Nova.", 13, theme.muted)
    // Two aligned columns, the way VS Code's welcome page lays out actions and
    // recent entries: labels left, shortcut chords right-aligned on a shared edge.
    let start_top = top + 112
    let key_right = left + 300
    gui.text(left, start_top, "START", 11, theme.muted)
    let labels: List<String> = [
        "Open File…",
        "Open Folder…",
        "Go to File",
        "Command Palette",
        "Find in File",
        "Build",
        "Run in Terminal",
        "Settings",
    ]
    let keys: List<String> = ["⌘O", "⇧⌘O", "⌘P", "⇧⌘P", "⌘F", "⌘B", "⌘R", "⌘,"]
    var i = 0
    while i < labels.len() {
        let ry = start_top + 26 + i * 24
        gui.text(left, ry, labels[i], 13, theme.link)
        gui.text(key_right - gui.text_width(keys[i], 11), ry + 1, keys[i], 11, theme.faint)
        i = i + 1
    }
    let col2 = left + 420
    gui.text(col2, start_top, "RECENT", 11, theme.muted)
    if app.tabs.len() == 0 {
        gui.text(col2, start_top + 26, "No open files", 13, theme.faint)
    }
    var row = 0
    while row < app.tabs.len() && row < 6 {
        gui.text(col2, start_top + 26 + row * 24, app.tabs[row].name, 13, theme.link)
        row = row + 1
    }
    gui.text(left, start_top + 26 + labels.len() * 24 + 18, "The compiler, engine and this window are all Nova.", 12, theme.muted)
}

fn leading_spaces(text: String) -> Int {
    let chars = text.graphemes()
    var i = 0
    while i < chars.len() && chars[i] == " " {
        i = i + 1
    }
    return i
}

// The fn that contains `line`, as [start, end], or an empty list.
fn fn_range(lines: List<String>, line: Int) -> List<Int> {
    var cursor = line
    var found = -1
    while cursor >= 0 {
        let text = lines[cursor].trim()
        if text.starts_with("fn ") {
            found = cursor
            cursor = -1
        } else {
            cursor = cursor - 1
        }
    }
    if found < 0 {
        var empty: List<Int> = []
        return empty
    }
    var depth = 0
    var end = found
    var i = found
    while i < lines.len() {
        let chars = lines[i].graphemes()
        var j = 0
        while j < chars.len() {
            if chars[j] == "{" {
                depth = depth + 1
            }
            if chars[j] == "}" {
                depth = depth - 1
            }
            j = j + 1
        }
        if depth <= 0 && i > found {
            end = i
            i = lines.len()
        } else {
            i = i + 1
        }
    }
    var out: List<Int> = []
    out.push(found)
    out.push(end)
    return out
}

fn fn_name(lines: List<String>, start: Int) -> String {
    let text = lines[start].trim()
    let chars = text.graphemes()
    var i = 3
    var name = ""
    while i < chars.len() && chars[i] != "(" {
        name = name + chars[i]
        i = i + 1
    }
    return name.trim()
}

fn bracket_pair(ch: String) -> String {
    if ch == "(" {
        return ")"
    }
    if ch == "[" {
        return "]"
    }
    if ch == "{" {
        return "}"
    }
    if ch == ")" {
        return "("
    }
    if ch == "]" {
        return "["
    }
    if ch == "}" {
        return "{"
    }
    return ""
}

// Partner of the bracket under the caret on the same line, or -1.
fn bracket_partner(line: String, col: Int) -> Int {
    let chars = line.graphemes()
    if col < 0 || col >= chars.len() {
        return -1
    }
    let ch = chars[col]
    let pair = bracket_pair(ch)
    if pair.len() == 0 {
        return -1
    }
    let forward = ch == "(" || ch == "[" || ch == "{"
    var depth = 0
    var i = col
    while i >= 0 && i < chars.len() {
        if chars[i] == ch {
            depth = depth + 1
        }
        if chars[i] == pair {
            depth = depth - 1
            if depth == 0 {
                return i
            }
        }
        if forward {
            i = i + 1
        } else {
            i = i - 1
        }
    }
    return -1
}

// Caret firework: a handful of motes that fade out over a few frames.
fn draw_sparks(app: App, x: Int, y: Int) {
    if app.anim <= 0 {
        return
    }
    let tones: List<Int> = [gui.rgb(120, 200, 255), gui.rgb(255, 220, 120), gui.rgb(160, 255, 190)]
    var i = 0
    while i < 6 {
        let dx = ((app.anim * 5 + i * 7) % 15) - 7
        let dy = ((app.anim * 3 + i * 5) % 11) - 5
        gui.rect_alpha(x + dx, y + dy - (18 - app.anim), 2, 2, tones[i % 3], app.anim * 12)
        i = i + 1
    }
}

fn draw_minimap(app: App, x: Int, y: Int, w: Int, h: Int) {
    let theme = app.theme
    if w <= 0 || app.tabs.len() == 0 || app.active < 0 {
        return
    }
    let tab = app.tabs[app.active]
    let rows = visible_rows(tab)
    let total = rows.len()
    if total <= 0 {
        return
    }
    gui.rect(x, y, w, h, theme.bg_hard)
    gui.line(x, y, x, y + h, theme.border)
    gui.clip(x, y, w, h)
    var stride = 1
    if total > h {
        stride = total / h + 1
    }
    var i = 0
    while i < total {
        if i % stride == 0 {
            let text = tab.lines[rows[i]]
            let indent = leading_spaces(text)
            let len = text.graphemes().len() - indent
            var bar = len * 3 / 2
            if bar > w - 12 {
                bar = w - 12
            }
            if bar > 1 {
                var color = theme.faint
                if rows[i] == tab.cursor_line {
                    color = theme.link
                }
                gui.rect(x + 6 + indent * 2 / 3, y + i * h / total, bar, 2, color)
            }
        }
        i = i + 1
    }
    let visible = h / line_height(app.size)
    let top_row = tab.scroll * h / total
    var view = visible * h / total
    if view < 8 {
        view = 8
    }
    gui.rect_alpha(x + w - 4, y + top_row, 3, view, theme.fg, 45)
    gui.clip_reset()
}

fn draw_editor(app: App, x: Int, y: Int, w: Int, h: Int) {
    let theme = app.theme
    if app.tabs.len() == 0 || app.active < 0 {
        draw_welcome(app, x, y, w, h)
        return
    }
    let tab = app.tabs[app.active]
    let size = app.size
    let lh = line_height(size)
    let rows_visible = h / lh
    var minimap = 0
    if app.minimap {
        minimap = 68
    }
    let text_w = w - minimap
    let adv = gui.mono_width(" ", size)
    let rows = visible_rows(tab)
    let span = selection_span(tab)
    var matches: List<Int> = []
    if app.overlay == "find" && app.field.len() > 0 {
        matches = all_matches(tab, app.field)
    }
    let query_len = app.field.graphemes().len()
    var first_line = row_line(rows, tab.scroll)
    if first_line < 0 {
        first_line = 0
    }
    gui.clip(x, y, text_w, h)
    let fspan = fn_range(tab.lines, tab.cursor_line)
    if fspan.len() == 2 {
        let start_row = row_of(rows, fspan[0])
        let end_row = row_of(rows, fspan[1])
        if start_row >= 0 && end_row >= 0 {
            let top = y + (start_row - tab.scroll) * lh
            var height = (end_row - start_row + 1) * lh
            if height < lh {
                height = lh
            }
            gui.rect_alpha(x, top, 3, height, theme.accent, 120)
        }
    }
    var block = block_before(tab.lines, first_line)
    var row = 0
    while row < rows_visible {
        let index = row_line(rows, tab.scroll + row)
        if index >= 0 {
            let ly = y + row * lh
            let line_text = tab.lines[index]
            var marked = index == tab.cursor_line
            if app.vim && app.mode == "visual" {
                let low = gui.min(app.anchor, tab.cursor_line)
                let high = gui.max(app.anchor, tab.cursor_line)
                if index >= low && index <= high {
                    marked = true
                }
            }
            if marked {
                gui.rect(x, ly, text_w, lh, theme.elevated)
            }
            if !app.dim && !span.empty && index >= span.l0 && index <= span.l1 {
                let chars = line_text.graphemes()
                var c0 = 0
                var c1 = chars.len()
                if index == span.l0 {
                    c0 = gui.clamp(span.c0, 0, chars.len())
                }
                if index == span.l1 {
                    c1 = gui.clamp(span.c1, 0, chars.len())
                }
                if c1 > c0 {
                    gui.rect_alpha(x + gutter_width() + c0 * adv, ly, (c1 - c0) * adv, lh, theme.accent, 120)
                }
            }
            var m = 0
            while m + 1 < matches.len() {
                if matches[m] == index && query_len > 0 {
                    gui.rect_alpha(x + gutter_width() + matches[m + 1] * adv, ly, query_len * adv, lh, theme.yellow, 80)
                }
                m = m + 2
            }
            let indent = leading_spaces(line_text)
            var guide = 4
            while guide <= indent {
                gui.rect_alpha(x + gutter_width() + guide * adv, ly, 1, lh, theme.border_strong, 90)
                guide = guide + 4
            }
            let number = "${index + 1}"
            let number_width = gui.mono_width(number, size)
            var number_color = theme.faint
            if index == tab.cursor_line {
                number_color = theme.link
            }
            gui.mono(x + gutter_width() - 12 - number_width, ly + 3, number, size, number_color)
            let trimmed = line_text.trim()
            let is_decl = trimmed.starts_with("fn ") || trimmed.starts_with("struct ") || trimmed.starts_with("impl ") || trimmed.starts_with("enum ")
            if is_decl {
                gui.rect(x + gutter_width() - 34, ly + 9, 7, 1, theme.faint)
                if has_int(tab.folds, index) {
                    gui.rect(x + gutter_width() - 31, ly + 6, 1, 7, theme.faint)
                    let hidden = fold_end(tab.lines, index) - index
                    let folded_label = "⋯ " + "${hidden}" + " lines"
                    gui.text(x + gutter_width() + 4, ly + 3, folded_label, size, theme.faint)
                }
            }
            let lex = draw_code(x + gutter_width(), ly + 3, line_text, size, theme, block)
            block = lex.block
        }
        row = row + 1
    }
    let caret_row = row_of(rows, tab.cursor_line)
    if !app.dim && caret_row >= tab.scroll && caret_row < tab.scroll + rows_visible {
        let line = tab.lines[tab.cursor_line]
        let chars = line.graphemes()
        var at = tab.cursor_col
        if at >= chars.len() {
            at = chars.len() - 1
        }
        if at >= 0 && at < chars.len() {
            let partner = bracket_partner(line, at)
            if partner >= 0 {
                let ly = y + (caret_row - tab.scroll) * lh
                gui.stroke(x + gutter_width() + at * adv - 1, ly + 1, adv + 2, lh - 2, theme.border_strong)
                gui.stroke(x + gutter_width() + partner * adv - 1, ly + 1, adv + 2, lh - 2, theme.border_strong)
            }
        }
    }
    if !app.dim && caret_row >= 0 && caret_row >= tab.scroll && caret_row < tab.scroll + rows_visible {
        let line_chars = tab.lines[tab.cursor_line].graphemes()
        let prefix = slice_chars(line_chars, 0, gui.clamp(tab.cursor_col, 0, line_chars.len()))
        let caret_x = x + gutter_width() + gui.mono_width(prefix, size)
        let caret_y = y + (caret_row - tab.scroll) * lh + 3
        var typing = true
        if app.vim && app.mode != "insert" {
            typing = false
        }
        if typing {
            gui.rect(caret_x, caret_y, 2, size + 3, theme.fg_bright)
        } else {
            let under = slice_chars(line_chars, gui.clamp(tab.cursor_col, 0, line_chars.len()), gui.clamp(tab.cursor_col + 1, 0, line_chars.len()))
            var cell = gui.mono_width(under, size)
            if cell < 7 {
                cell = 7
            }
            gui.rect_alpha(caret_x, caret_y, cell, size + 3, theme.fg_bright, 120)
        }
        draw_sparks(app, caret_x + 2, caret_y)
    }
    var e = 0
    while e + 1 < app.cursors.len() {
        let extra_line = app.cursors[e]
        let extra_col = app.cursors[e + 1]
        let extra_row = row_of(rows, extra_line)
        if extra_row >= tab.scroll && extra_row < tab.scroll + rows_visible {
            let extra_chars = tab.lines[extra_line].graphemes()
            let extra_prefix = slice_chars(extra_chars, 0, gui.clamp(extra_col, 0, extra_chars.len()))
            let extra_x = x + gutter_width() + gui.mono_width(extra_prefix, size)
            let extra_y = y + (extra_row - tab.scroll) * lh + 3
            gui.rect(extra_x, extra_y, 2, size + 3, theme.fg_bright)
        }
        e = e + 2
    }
    gui.clip_reset()
    draw_minimap(app, x + text_w, y, minimap, h)
}

fn draw_main(app: App, w: Int, h: Int) {
    let theme = app.theme
    var left = activity_width()
    if app.sidebar {
        left = left + sidebar_width()
    }
    let top = title_height()
    var bottom = h - status_height()
    if app.panel {
        bottom = bottom - panel_height()
    }
    let editor_top = top + tabs_height() + crumbs_height()
    let body_h = bottom - editor_top
    let full = w - left
    var split = app.split
    if full < 520 {
        split = false
    }
    if split {
        let half = full / 2
        var left_strip = app
        left_strip.active = pane_tab(app, 0)
        draw_tabs(left_strip, left, top, half - 1)
        var right_strip = app
        right_strip.active = pane_tab(app, 1)
        draw_tabs(right_strip, left + half - 1, top, full - half + 1)
        draw_crumbs(app, left, top + tabs_height(), half - 1)
        draw_crumbs(app, left + half - 1, top + tabs_height(), full - half + 1)
        draw_editor(app, left, editor_top, half - 1, body_h)
        var other = app
        other.active = pane_tab(app, 1 - app.pane)
        other.dim = true
        draw_editor(other, left + half, editor_top, full - half, body_h)
        gui.line(left + half - 1, top, left + half - 1, bottom, theme.border_strong)
    } else {
        draw_tabs(app, left, top, full)
        draw_crumbs(app, left, top + tabs_height(), full)
        draw_editor(app, left, editor_top, full, body_h)
    }
    if app.panel {
        draw_panel(app, left, bottom, full, panel_height())
    }
    gui.line(left, top, left, bottom, theme.border)
}

fn docs_lines() -> List<String> {
    return [
        "NOVA STUDIO — QUICK REFERENCE",
        "",
        "Language",
        "  fn name(arg: Int) -> Int { return arg }",
        "  struct Point { x: Int, y: Int }",
        "  enum Status { Idle, Running }",
        "  match value { Status.Idle => foo() }",
        "",
        "Toolchain",
        "  nova build        compile the project binary",
        "  nova run          compile and run it",
        "  nova check        parse and type-check only",
        "  nova test         run tests/**/*.nova",
        "  nova fmt          format sources",
        "",
        "This workbench",
        "  ⌘S save · ⌘B build · ⌘R run in Terminal",
        "  ⌘P go to file · ⇧⌘P all commands",
        "  ⌘W close tab · ⌘` panel · ⇧⌘E sidebar",
        "",
        "Full documentation: https://jd4rider.github.io/nova/docs/",
    ]
}

fn draw_panel(app: App, x: Int, y: Int, w: Int, h: Int) {
    let theme = app.theme
    gui.rect(x, y, w, h, theme.bg)
    gui.line(x, y, x + w, y, theme.border)
    gui.rect(x, y, w, 35, theme.panel)

    var tx = x + 12
    let labels: List<String> = ["PROBLEMS", "OUTPUT", "TERMINAL", "DOCS"]
    let ids: List<String> = ["problems", "output", "terminal", "docs"]
    var i = 0
    while i < 4 {
        var color = gui.rgb(150, 150, 150)
        if app.bottom == ids[i] {
            color = theme.fg_bright
            gui.rect(tx - 10, y, gui.text_width(labels[i], 11) + 20, 35, theme.bg)
            gui.rect(tx - 10, y, gui.text_width(labels[i], 11) + 20, 1, theme.accent)
        } else {
            if hovering(app, tx - 10, y, gui.text_width(labels[i], 11) + 20, 35) {
                color = theme.fg_bright
            }
        }
        gui.text(tx, y + 12, labels[i], 11, color)
        tx = tx + gui.text_width(labels[i], 11) + 40
        i = i + 1
    }

    let body_y = y + 35
    let body_h = h - 35
    gui.clip(x, body_y, w, body_h)
    if app.bottom == "output" {
        let lines = split_lines(app.output)
        var row = 0
        while row < lines.len() && body_y + 8 + row * 16 < body_y + body_h {
            gui.mono(x + 12, body_y + 8 + row * 16, lines[row], 12, theme.fg)
            row = row + 1
        }
        if app.output.len() == 0 {
            gui.text(x + 12, body_y + 10, "No task has run yet. Press ⌘B to build.", 12, theme.muted)
        }
    }
    if app.bottom == "problems" {
        gui.text(x + 12, body_y + 10, "No problems detected.", 12, theme.muted)
        gui.text(x + 12, body_y + 30, "The Nova build runs the compiler as a task and reports its output verbatim;", 11, theme.faint)
        gui.text(x + 12, body_y + 46, "it does not host a language server, so there are no inline diagnostics yet.", 11, theme.faint)
    }
    if app.bottom == "terminal" {
        let pal = terminal_palette(app)
        let grid_y = body_y + 6
        let grid_h = body_h - 34
        vt.tm_draw(app.term, x + 14, grid_y, w - 28, grid_h, 12, pal)
        vt.tm_draw_rail(app.term, x + 6, grid_y, grid_h, 12, pal)
        let footer_y = body_y + body_h - 22
        gui.rect(x, footer_y - 4, w, 26, theme.panel)
        var state_text = "idle"
        if gui.pty_running(app.term_slot) {
            state_text = "running"
        }
        gui.text(x + 14, footer_y, state_text, 10, theme.fg)
        gui.text(x + 88, footer_y, "${app.term_cols}x${app.term_rows}", 10, theme.muted)
        if app.term_focus {
            gui.text(x + w - 150, footer_y, "typing - esc returns to the editor", 10, theme.faint)
        } else {
            gui.text(x + w - 96, footer_y, "click to type", 10, theme.faint)
        }
    }
    if app.bottom == "docs" {
        let lines = docs_lines()
        var row = 0
        while row < lines.len() && body_y + 8 + row * 16 < body_y + body_h {
            var color = theme.muted
            if lines[row].starts_with("NOVA STUDIO") {
                color = theme.fg_bright
            }
            gui.mono(x + 12, body_y + 8 + row * 16, lines[row], 11, color)
            row = row + 1
        }
    }
    gui.clip_reset()
}

fn draw_status(app: App, w: Int, h: Int) {
    let theme = app.theme
    let y = h - status_height()
    gui.rect(0, y, w, status_height(), theme.status)
    gui.text(10, y + 5, "◈ nova-studio", 11, gui.white())
    var left = 118
    if app.vim {
        var mode_text = "NORMAL"
        if app.mode == "insert" {
            mode_text = "INSERT"
        }
        if app.mode == "visual" {
            mode_text = "VISUAL"
        }
        let badge = gui.text_width(mode_text, 10) + 12
        gui.rect(left, y + 2, badge, 15, gui.rgb(0, 88, 150))
        gui.text(left + 6, y + 4, mode_text, 10, gui.white())
        left = left + badge + 10
    }
    gui.text(left, y + 5, basename(app.root), 11, gui.white())
    if app.status.len() > 0 {
        let sx = left + gui.text_width(basename(app.root), 11) + 12
        gui.text(sx, y + 5, "·", 11, gui.white())
        gui.text(sx + 10, y + 5, app.status, 11, gui.white())
    }
    var cursor = "Ln 1, Col 1"
    if app.active >= 0 && app.tabs.len() > 0 {
        let tab = app.tabs[app.active]
        cursor = "Ln " + "${tab.cursor_line + 1}" + ", Col " + "${tab.cursor_col + 1}"
    }
    let right = "UTF-8   " + cursor + "   " + app.theme_name + "   Nova"
    gui.text(w - gui.text_width(right, 11) - 12, y + 5, right, 11, gui.white())
}

fn draw_overlay(app: App, w: Int, h: Int) {
    let theme = app.theme
    if app.overlay == "refs" {
        draw_references(app, w, h)
        return
    }
    if app.overlay == "find" {
        draw_find(app, w)
        return
    }
    gui.rect_alpha(0, 0, w, h, 0, 110)
    if app.overlay == "about" {
        draw_about(app, w)
        return
    }
    if app.overlay == "settings" {
        draw_settings(app, w)
        return
    }
    var card = 640
    if card > w - 80 {
        card = w - 80
    }
    let x = (w - card) / 2
    let y = 70
    let list = rows(app)
    var height = 44 + list.len() * 30 + 8
    if height > h - 140 {
        height = h - 140
    }
    gui.rect(x, y, card, height, theme.panel)
    gui.stroke(x, y, card, height, theme.border_strong)
    gui.rect(x + 1, y + 1, card - 2, 33, theme.panel)
    gui.line(x, y + 34, x + card, y + 34, theme.border_strong)
    var query = app.field
    if query.len() == 0 {
        query = "Type a name"
    }
    gui.text(x + 12, y + 10, query, 13, theme.fg)
    let caret = app.field.graphemes()
    let caret_x = x + 12 + gui.mono_width(slice_chars(caret, 0, gui.clamp(app.field_cursor, 0, caret.len())), 13)
    gui.rect(caret_x, y + 9, 1, 16, theme.accent)
    var i = 0
    while i < list.len() && i < 12 {
        let ry = y + 38 + i * 30
        if i == app.selection {
            gui.rect(x + 4, ry, card - 8, 28, theme.selection)
        }
        gui.text(x + 12, ry + 7, list[i].label, 13, theme.fg)
        gui.text(x + card - 12 - gui.text_width(list[i].hint, 11), ry + 8, list[i].hint, 11, theme.muted)
        i = i + 1
    }
    if list.len() == 0 {
        gui.text(x + 12, y + 46, "No matches", 12, theme.muted)
    }
}

fn draw_about(app: App, w: Int) {
    let theme = app.theme
    let card = 560
    let x = (w - card) / 2
    let y = 90
    gui.rect(x, y, card, 300, theme.panel)
    gui.stroke(x, y, card, 300, theme.border_strong)
    gui.text(x + 24, y + 24, "✦ Nova Studio", 22, theme.fg_bright)
    gui.text(x + 24, y + 60, "The workbench, rewritten in Nova.", 13, theme.muted)
    let lines: List<String> = [
        "Every pixel here is drawn by Nova through nova-gui:",
        "a native macOS window, a CoreGraphics framebuffer and",
        "CoreText glyphs, polled from a single event loop.",
        "",
        "The editor, explorer, tabs, palette and tasks are",
        "functions in examples/nova-studio/src/main.nova.",
        "",
        "The compiler is invoked as a real task; output is verbatim.",
    ]
    var i = 0
    while i < lines.len() {
        gui.text(x + 24, y + 92 + i * 19, lines[i], 12, theme.fg)
        i = i + 1
    }
    gui.text(x + 24, y + 266, "Esc closes this panel", 11, theme.faint)
}

fn draw_settings(app: App, w: Int) {
    let theme = app.theme
    let card = 520
    let x = (w - card) / 2
    let y = 90
    gui.rect(x, y, card, 372, theme.panel)
    gui.stroke(x, y, card, 372, theme.border_strong)
    gui.text(x + 24, y + 22, "Settings", 18, theme.fg_bright)
    gui.line(x + 24, y + 56, x + card - 24, y + 56, theme.border_strong)
    gui.text(x + 24, y + 70, "THEME", 11, theme.muted)
    gui.rect(x + 24, y + 90, 140, 32, theme.bg)
    gui.stroke(x + 24, y + 90, 140, 32, theme.border_strong)
    gui.text(x + 36, y + 99, "Dark+", 12, theme.fg_bright)
    gui.rect(x + 176, y + 90, 140, 32, theme.bg)
    gui.stroke(x + 176, y + 90, 140, 32, theme.border_strong)
    gui.text(x + 188, y + 99, "Gruvbox", 12, theme.fg)
    gui.text(x + 24, y + 140, "FONT SIZE", 11, theme.muted)
    gui.rect(x + 24, y + 160, 32, 30, theme.bg)
    gui.stroke(x + 24, y + 160, 32, 30, theme.border_strong)
    gui.text(x + 36, y + 168, "−", 13, theme.fg)
    gui.text(x + 68, y + 168, "${app.size}", 13, theme.fg_bright)
    gui.rect(x + 100, y + 160, 32, 30, theme.bg)
    gui.stroke(x + 100, y + 160, 32, 30, theme.border_strong)
    gui.text(x + 110, y + 168, "+", 13, theme.fg)
    gui.text(x + 24, y + 204, "EDITOR", 11, theme.muted)
    gui.rect(x + 24, y + 224, 140, 32, theme.bg)
    gui.stroke(x + 24, y + 224, 140, 32, theme.border_strong)
    var vim_label = "Vim: off"
    if app.vim {
        vim_label = "Vim: on"
    }
    gui.text(x + 36, y + 233, vim_label, 12, theme.fg_bright)
    gui.rect(x + 176, y + 224, 140, 32, theme.bg)
    gui.stroke(x + 176, y + 224, 140, 32, theme.border_strong)
    var map_label = "Minimap: off"
    if app.minimap {
        map_label = "Minimap: on"
    }
    gui.text(x + 188, y + 233, map_label, 12, theme.fg_bright)
    let notes: List<String> = [
        "Themes, font size, Vim mode and the minimap apply immediately.",
        "Settings are not persisted between launches yet.",
        "",
        "Esc closes this panel",
    ]
    var i = 0
    while i < notes.len() {
        gui.text(x + 24, y + 272 + i * 18, notes[i], 11, theme.muted)
        i = i + 1
    }
}

// ---------- undo ----------

// Snapshots the buffer before a change; the editor keeps the last 80 states.
fn snapshot(app: App) -> App {
    var app = app
    if app.active < 0 || app.tabs.len() == 0 {
        return app
    }
    var tab = app.tabs[app.active]
    var undo = tab.undo
    undo.push(join_lines(tab.lines))
    if undo.len() > 80 {
        var kept: List<String> = []
        var i = undo.len() - 60
        while i < undo.len() {
            kept.push(undo[i])
            i = i + 1
        }
        undo = kept
    }
    tab.undo = undo
    app.tabs[app.active] = tab
    return app
}

fn undo(app: App) -> App {
    var app = app
    if app.active < 0 || app.tabs.len() == 0 {
        app.status = "Nothing to undo"
        return app
    }
    var tab = app.tabs[app.active]
    if tab.undo.len() == 0 {
        app.status = "Nothing to undo"
        return app
    }
    let last = tab.undo[tab.undo.len() - 1]
    var kept: List<String> = []
    var i = 0
    while i + 1 < tab.undo.len() {
        kept.push(tab.undo[i])
        i = i + 1
    }
    tab.lines = split_lines(last)
    tab.undo = kept
    tab.dirty = true
    tab.cursor_line = gui.clamp(tab.cursor_line, 0, tab.lines.len() - 1)
    tab.cursor_col = gui.clamp(tab.cursor_col, 0, tab.lines[tab.cursor_line].graphemes().len())
    app.tabs[app.active] = tab
    app.status = "Undo"
    return app
}

// ---------- vim ----------

fn vim_goto(app: App, line: Int) -> App {
    var app = app
    if app.active < 0 {
        return app
    }
    var tab = app.tabs[app.active]
    var target = line
    if target < 0 {
        target = tab.lines.len() - 1
    }
    tab.cursor_line = gui.clamp(target, 0, tab.lines.len() - 1)
    tab.cursor_col = leading_spaces(tab.lines[tab.cursor_line])
    tab = tab_scrolled(tab)
    app.tabs[app.active] = tab
    return app
}

// w and b: hop to the next or previous run of identifier characters.
fn vim_word(app: App, dir: Int) -> App {
    var app = app
    if app.active < 0 {
        return app
    }
    var tab = app.tabs[app.active]
    let chars = tab.lines[tab.cursor_line].graphemes()
    var col = tab.cursor_col
    if dir > 0 {
        col = col + 1
        var skipping = true
        while col < chars.len() && skipping {
            if is_ident_part(chars[col]) {
                skipping = false
            } else {
                col = col + 1
            }
        }
        var running = true
        while col < chars.len() && running {
            if is_ident_part(chars[col]) {
                col = col + 1
            } else {
                running = false
            }
        }
    } else {
        if col > 0 {
            col = col - 1
        }
        var backing = true
        while col > 0 && backing {
            if is_ident_part(chars[col]) {
                backing = false
            } else {
                col = col - 1
            }
        }
        var head = true
        while col > 0 && head {
            if is_ident_part(chars[col - 1]) {
                col = col - 1
            } else {
                head = false
            }
        }
    }
    tab.cursor_col = gui.clamp(col, 0, chars.len())
    app.tabs[app.active] = tab
    return app
}

// e: end of the run under the caret.
fn vim_word_end(app: App) -> App {
    var app = app
    if app.active < 0 {
        return app
    }
    var tab = app.tabs[app.active]
    let chars = tab.lines[tab.cursor_line].graphemes()
    var col = tab.cursor_col
    var started = true
    while col < chars.len() && started {
        if is_ident_part(chars[col]) {
            started = false
        } else {
            col = col + 1
        }
    }
    var running = true
    while col < chars.len() && running {
        if is_ident_part(chars[col]) {
            col = col + 1
        } else {
            running = false
        }
    }
    if col > 0 && col <= chars.len() {
        col = col - 1
    }
    tab.cursor_col = gui.clamp(col, 0, chars.len())
    app.tabs[app.active] = tab
    return app
}

fn vim_delete_line(app: App) -> App {
    var app = app
    if app.active < 0 {
        return app
    }
    var tab = app.tabs[app.active]
    app.yank = tab.lines[tab.cursor_line]
    app = snapshot(app)
    tab = app.tabs[app.active]
    if tab.lines.len() == 1 {
        tab.lines = [""]
    } else {
        tab.lines = remove_line(tab.lines, tab.cursor_line)
        tab.cursor_line = gui.clamp(tab.cursor_line, 0, tab.lines.len() - 1)
    }
    tab.cursor_col = leading_spaces(tab.lines[tab.cursor_line])
    tab.dirty = true
    app.tabs[app.active] = tab
    app.status = "1 line deleted"
    return app
}

fn vim_yank_line(app: App) -> App {
    var app = app
    if app.active < 0 {
        return app
    }
    app.yank = app.tabs[app.active].lines[app.tabs[app.active].cursor_line]
    app.status = "1 line yanked"
    return app
}

fn vim_paste(app: App) -> App {
    var app = app
    if app.active < 0 || app.yank.len() == 0 {
        return app
    }
    app = snapshot(app)
    var tab = app.tabs[app.active]
    tab.lines = insert_line(tab.lines, tab.cursor_line + 1, app.yank)
    tab.cursor_line = tab.cursor_line + 1
    tab.cursor_col = leading_spaces(tab.lines[tab.cursor_line])
    tab.dirty = true
    app.tabs[app.active] = tab
    app.status = "pasted"
    return app
}

fn vim_insert(app: App, kind: String) -> App {
    var app = app
    if app.active < 0 {
        return app
    }
    var tab = app.tabs[app.active]
    if kind == "a" {
        tab.cursor_col = gui.clamp(tab.cursor_col + 1, 0, tab.lines[tab.cursor_line].graphemes().len())
    }
    if kind == "I" {
        tab.cursor_col = leading_spaces(tab.lines[tab.cursor_line])
    }
    if kind == "A" {
        tab.cursor_col = tab.lines[tab.cursor_line].graphemes().len()
    }
    if kind == "o" {
        app.tabs[app.active] = tab
        app = snapshot(app)
        var fresh = app.tabs[app.active]
        fresh.lines = insert_line(fresh.lines, fresh.cursor_line + 1, "")
        fresh.cursor_line = fresh.cursor_line + 1
        fresh.cursor_col = 0
        fresh.dirty = true
        app.tabs[app.active] = fresh
        app.mode = "insert"
        return app
    }
    if kind == "O" {
        app.tabs[app.active] = tab
        app = snapshot(app)
        var above = app.tabs[app.active]
        above.lines = insert_line(above.lines, above.cursor_line, "")
        above.cursor_col = 0
        above.dirty = true
        app.tabs[app.active] = above
        app.mode = "insert"
        return app
    }
    app.tabs[app.active] = tab
    app.mode = "insert"
    return app
}

fn vim_visual_op(app: App, kind: String) -> App {
    var app = app
    if app.active < 0 {
        return app
    }
    var tab = app.tabs[app.active]
    let low = gui.min(app.anchor, tab.cursor_line)
    let high = gui.max(app.anchor, tab.cursor_line)
    var collected = ""
    var i = low
    while i <= high && i < tab.lines.len() {
        collected = collected + tab.lines[i] + "\n"
        i = i + 1
    }
    if kind == "y" {
        app.yank = collected
        app.mode = "normal"
        app.status = "visual yank"
        return app
    }
    app.yank = collected
    app = snapshot(app)
    tab = app.tabs[app.active]
    var kept: List<String> = []
    var row = 0
    while row < tab.lines.len() {
        if row < low || row > high {
            kept.push(tab.lines[row])
        }
        row = row + 1
    }
    if kept.len() == 0 {
        kept = [""]
    }
    tab.lines = kept
    tab.cursor_line = gui.clamp(low, 0, kept.len() - 1)
    tab.cursor_col = leading_spaces(kept[tab.cursor_line])
    tab.dirty = true
    app.tabs[app.active] = tab
    app.mode = "normal"
    app.status = "visual delete"
    return app
}

fn vim_key(app: App, code: Int) -> App {
    var app = app
    let pending = app.pending
    app.pending = ""
    if pending == "g" {
        if code == 103 {
            return vim_goto(app, 0)
        }
        return app
    }
    if pending == "d" {
        if code == 100 {
            return vim_delete_line(app)
        }
        return app
    }
    if pending == "y" {
        if code == 121 {
            return vim_yank_line(app)
        }
        return app
    }
    if app.mode == "visual" {
        if code == 100 {
            return vim_visual_op(app, "d")
        }
        if code == 121 {
            return vim_visual_op(app, "y")
        }
        if code == 27 {
            app.mode = "normal"
            return app
        }
    }
    if code == gui.key_escape() {
        app.mode = "normal"
        app.pending = ""
        return app
    }
    if code == gui.key_up() {
        return edit_move(app, -1, 0)
    }
    if code == gui.key_down() {
        return edit_move(app, 1, 0)
    }
    if code == gui.key_left() {
        return edit_move(app, 0, -1)
    }
    if code == gui.key_right() {
        return edit_move(app, 0, 1)
    }
    if code == gui.key_home() {
        return edit_home(app)
    }
    if code == gui.key_end() {
        return edit_end(app)
    }
    if code == 104 {
        return edit_move(app, 0, -1)
    }
    if code == 106 {
        return edit_move(app, 1, 0)
    }
    if code == 107 {
        return edit_move(app, -1, 0)
    }
    if code == 108 {
        return edit_move(app, 0, 1)
    }
    if code == 48 {
        return edit_home(app)
    }
    if code == 36 || code == 52 {
        return edit_end(app)
    }
    if code == 119 {
        return vim_word(app, 1)
    }
    if code == 98 {
        return vim_word(app, -1)
    }
    if code == 101 {
        return vim_word_end(app)
    }
    if code == 103 {
        app.pending = "g"
        return app
    }
    if code == 71 {
        return vim_goto(app, -1)
    }
    if code == 120 {
        app = snapshot(app)
        return edit_delete(app)
    }
    if code == 100 {
        app.pending = "d"
        return app
    }
    if code == 121 {
        app.pending = "y"
        return app
    }
    if code == 117 {
        return undo(app)
    }
    if code == 105 {
        return vim_insert(app, "i")
    }
    if code == 97 {
        return vim_insert(app, "a")
    }
    if code == 73 {
        return vim_insert(app, "I")
    }
    if code == 65 {
        return vim_insert(app, "A")
    }
    if code == 111 {
        return vim_insert(app, "o")
    }
    if code == 79 {
        return vim_insert(app, "O")
    }
    if code == 112 {
        return vim_paste(app)
    }
    if code == 118 {
        app.mode = "visual"
        app.anchor = active_tab(app).cursor_line
        return app
    }
    return app
}

// ---------- selection, clipboard, find, folding ----------

struct Span {
    l0: Int,
    c0: Int,
    l1: Int,
    c1: Int,
    empty: Bool,
}

fn has_int(items: List<Int>, value: Int) -> Bool {
    var i = 0
    while i < items.len() {
        if items[i] == value {
            return true
        }
        i = i + 1
    }
    return false
}

fn selection_span(tab: Tab) -> Span {
    var l0 = tab.sel_line
    var c0 = tab.sel_col
    var l1 = tab.cursor_line
    var c1 = tab.cursor_col
    if l0 > l1 || (l0 == l1 && c0 > c1) {
        l0 = tab.cursor_line
        c0 = tab.cursor_col
        l1 = tab.sel_line
        c1 = tab.sel_col
    }
    let empty = l0 == l1 && c0 == c1
    return Span { l0: l0, c0: c0, l1: l1, c1: c1, empty: empty }
}

fn selected_text(tab: Tab) -> String {
    let span = selection_span(tab)
    if span.empty {
        return ""
    }
    var out = ""
    var line = span.l0
    while line <= span.l1 {
        let chars = tab.lines[line].graphemes()
        var from = 0
        if line == span.l0 {
            from = gui.clamp(span.c0, 0, chars.len())
        }
        var to = chars.len()
        if line == span.l1 {
            to = gui.clamp(span.c1, 0, chars.len())
        }
        out = out + slice_chars(chars, from, to)
        if line < span.l1 {
            out = out + "\n"
        }
        line = line + 1
    }
    return out
}

fn select_all(app: App) -> App {
    var app = app
    if app.active < 0 || app.tabs.len() == 0 {
        return app
    }
    var tab = app.tabs[app.active]
    tab.sel_line = 0
    tab.sel_col = 0
    tab.cursor_line = tab.lines.len() - 1
    tab.cursor_col = tab.lines[tab.cursor_line].graphemes().len()
    tab.selecting = true
    app.tabs[app.active] = tab
    return app
}

fn copy_selection(app: App) -> App {
    var app = app
    if app.active < 0 || app.tabs.len() == 0 {
        return app
    }
    let text = selected_text(app.tabs[app.active])
    if text.len() > 0 {
        gui.set_clipboard(text)
        app.status = "Copied " + "${text.graphemes().len()}" + " chars"
    }
    return app
}

fn cut_selection(app: App) -> App {
    var app = copy_selection(app)
    if app.active < 0 || app.tabs.len() == 0 {
        return app
    }
    if app.tabs[app.active].selecting {
        app = snapshot(app)
        app = delete_selection(app)
        app.status = "Cut"
    }
    return app
}

fn paste_clipboard(app: App) -> App {
    var app = app
    let text = gui.clipboard()
    if text.len() == 0 {
        return app
    }
    if app.active < 0 || app.tabs.len() == 0 {
        return app
    }
    app = clear_selection(app)
    return insert_text(app, text)
}

fn insert_text(app: App, text: String) -> App {
    let parts = split_lines(text)
    if parts.len() <= 1 {
        return edit_insert(app, text)
    }
    var app = edit_insert(app, parts[0])
    var i = 1
    while i < parts.len() {
        app = edit_newline(app)
        app = edit_insert(app, parts[i])
        i = i + 1
    }
    return app
}

fn delete_selection(app: App) -> App {
    var app = app
    if app.active < 0 || app.tabs.len() == 0 {
        return app
    }
    var tab = app.tabs[app.active]
    let span = selection_span(tab)
    if span.empty {
        tab.selecting = false
        app.tabs[app.active] = tab
        return app
    }
    let first = tab.lines[span.l0].graphemes()
    let last = tab.lines[span.l1].graphemes()
    let head = slice_chars(first, 0, gui.clamp(span.c0, 0, first.len()))
    let tail = slice_chars(last, gui.clamp(span.c1, 0, last.len()), last.len())
    let merged = head + tail
    var out: List<String> = []
    var i = 0
    while i < tab.lines.len() {
        if i == span.l0 {
            out.push(merged)
        } else {
            if i < span.l0 || i > span.l1 {
                out.push(tab.lines[i])
            }
        }
        i = i + 1
    }
    tab.lines = out
    tab.cursor_line = span.l0
    tab.cursor_col = head.graphemes().len()
    tab.sel_line = tab.cursor_line
    tab.sel_col = tab.cursor_col
    tab.selecting = false
    tab.dirty = true
    app.tabs[app.active] = tab
    return app
}

fn clear_selection(app: App) -> App {
    var app = app
    if app.active < 0 || app.tabs.len() == 0 {
        return app
    }
    if !app.tabs[app.active].selecting {
        return app
    }
    app = snapshot(app)
    return delete_selection(app)
}

// ---------- find ----------

fn find_in_line(line: String, query: String, from: Int) -> Int {
    let chars = line.graphemes()
    let q = query.graphemes()
    if q.len() == 0 {
        return -1
    }
    var i = from
    while i + q.len() <= chars.len() {
        var same = true
        var j = 0
        while j < q.len() && same {
            if chars[i + j] != q[j] {
                same = false
            } else {
                j = j + 1
            }
        }
        if same {
            return i
        }
        i = i + 1
    }
    return -1
}

// Every match as flattened [line, col] pairs.
fn all_matches(tab: Tab, query: String) -> List<Int> {
    var out: List<Int> = []
    if query.len() == 0 {
        return out
    }
    var i = 0
    while i < tab.lines.len() {
        var at = find_in_line(tab.lines[i], query, 0)
        while at >= 0 {
            out.push(i)
            out.push(at)
            at = find_in_line(tab.lines[i], query, at + 1)
        }
        i = i + 1
    }
    return out
}

fn find_step(app: App, dir: Int) -> App {
    var app = app
    if app.active < 0 || app.tabs.len() == 0 {
        return app
    }
    var tab = app.tabs[app.active]
    let list = all_matches(tab, app.field)
    if list.len() == 0 {
        app.status = "No results"
        return app
    }
    var pick = 0
    if dir < 0 {
        pick = list.len() - 2
    }
    var i = 0
    while i < list.len() {
        let line = list[i]
        let col = list[i + 1]
        let after = line > tab.cursor_line || (line == tab.cursor_line && col > tab.cursor_col)
        let before = line < tab.cursor_line || (line == tab.cursor_line && col < tab.cursor_col)
        if dir > 0 && after {
            pick = i
            i = list.len()
        } else {
            if dir < 0 && before {
                pick = i
            }
            i = i + 2
        }
    }
    tab.cursor_line = list[pick]
    tab.sel_line = list[pick]
    tab.sel_col = list[pick + 1]
    tab.cursor_col = list[pick + 1] + app.field.graphemes().len()
    tab.selecting = true
    tab = tab_scrolled(tab)
    app.tabs[app.active] = tab
    app.status = "Match " + "${pick / 2 + 1}" + " of " + "${list.len() / 2}"
    return app
}

fn replace_all(app: App) -> App {
    var app = app
    if app.active < 0 || app.tabs.len() == 0 || app.field.len() == 0 {
        return app
    }
    app = snapshot(app)
    var tab = app.tabs[app.active]
    let count = all_matches(tab, app.field).len() / 2
    var lines: List<String> = []
    var i = 0
    while i < tab.lines.len() {
        lines.push(tab.lines[i].replace(app.field, app.field2))
        i = i + 1
    }
    tab.lines = lines
    tab.dirty = true
    tab.selecting = false
    app.tabs[app.active] = tab
    app.status = "Replaced " + "${count}"
    return app
}

struct FieldText {
    value: String,
    cursor: Int,
}

fn field_type(value: String, cursor: Int, ch: String) -> FieldText {
    let chars = value.graphemes()
    let at = gui.clamp(cursor, 0, chars.len())
    return FieldText { value: slice_chars(chars, 0, at) + ch + slice_chars(chars, at, chars.len()), cursor: at + 1 }
}

fn field_back(value: String, cursor: Int) -> FieldText {
    let chars = value.graphemes()
    let at = gui.clamp(cursor, 0, chars.len())
    if at == 0 {
        return FieldText { value: value, cursor: 0 }
    }
    return FieldText { value: slice_chars(chars, 0, at - 1) + slice_chars(chars, at, chars.len()), cursor: at - 1 }
}

fn find_key(app: App, code: Int, mods: Int) -> App {
    var app = app
    let command = mods % 2 == 1
    let shift = (mods / 2) % 2 == 1
    if code == gui.key_escape() {
        app.overlay = ""
        return app
    }
    if code == gui.key_tab() {
        app.focus = 1 - app.focus
        return app
    }
    if code == gui.key_enter() {
        if command && app.focus == 1 {
            return replace_all(app)
        }
        if shift {
            return find_step(app, -1)
        }
        return find_step(app, 1)
    }
    if app.focus == 1 {
        if code == gui.key_backspace() {
            let next = field_back(app.field2, app.field2_cursor)
            app.field2 = next.value
            app.field2_cursor = next.cursor
            return app
        }
        if code == gui.key_left() {
            app.field2_cursor = gui.clamp(app.field2_cursor - 1, 0, app.field2.graphemes().len())
            return app
        }
        if code == gui.key_right() {
            app.field2_cursor = gui.clamp(app.field2_cursor + 1, 0, app.field2.graphemes().len())
            return app
        }
        if !command && code >= 32 && code <= 126 {
            let next = field_type(app.field2, app.field2_cursor, code_to_text(code))
            app.field2 = next.value
            app.field2_cursor = next.cursor
        }
        return app
    }
    if code == gui.key_backspace() {
        let next = field_back(app.field, app.field_cursor)
        app.field = next.value
        app.field_cursor = next.cursor
        return app
    }
    if code == gui.key_left() {
        app.field_cursor = gui.clamp(app.field_cursor - 1, 0, app.field.graphemes().len())
        return app
    }
    if code == gui.key_right() {
        app.field_cursor = gui.clamp(app.field_cursor + 1, 0, app.field.graphemes().len())
        return app
    }
    if !command && code >= 32 && code <= 126 {
        let next = field_type(app.field, app.field_cursor, code_to_text(code))
        app.field = next.value
        app.field_cursor = next.cursor
    }
    return app
}

fn find_click(app: App, mx: Int, my: Int, w: Int, h: Int) -> App {
    var app = app
    let width = 460
    let x = w - width - 28
    let y = title_height() + tabs_height() + crumbs_height() + 6
    if mx > x && mx < x + width - 76 && my > y + 4 && my < y + 26 {
        app.focus = 0
        return app
    }
    if mx > x && mx < x + width - 76 && my > y + 38 && my < y + 60 {
        app.focus = 1
        return app
    }
    if mx > x + width - 68 && mx < x + width - 12 && my > y + 38 && my < y + 60 {
        return replace_all(app)
    }
    if mx < x || mx > x + width || my < y || my > y + 78 {
        app.overlay = ""
    }
    return app
}

fn draw_find(app: App, w: Int) {
    let theme = app.theme
    let width = 460
    let x = w - width - 28
    let y = title_height() + tabs_height() + crumbs_height() + 6
    gui.rect(x, y, width, 78, theme.panel)
    gui.stroke(x, y, width, 78, theme.border_strong)
    gui.text(x + 12, y + 9, "Find", 11, theme.muted)
    gui.rect(x + 56, y + 4, width - 140, 22, theme.bg)
    gui.stroke(x + 56, y + 4, width - 140, 22, theme.border_strong)
    gui.text(x + 62, y + 7, app.field, 12, theme.fg_bright)
    if app.focus == 0 {
        let at = slice_chars(app.field.graphemes(), 0, gui.clamp(app.field_cursor, 0, app.field.graphemes().len()))
        gui.rect(x + 62 + gui.mono_width(at, 12), y + 6, 1, 18, theme.accent)
    }
    let total = all_matches(active_tab(app), app.field).len() / 2
    gui.text(x + width - 76, y + 9, "${total}", 10, theme.muted)
    gui.text(x + 12, y + 43, "Replace", 11, theme.muted)
    gui.rect(x + 56, y + 38, width - 140, 22, theme.bg)
    gui.stroke(x + 56, y + 38, width - 140, 22, theme.border_strong)
    gui.text(x + 62, y + 41, app.field2, 12, theme.fg_bright)
    if app.focus == 1 {
        let at2 = slice_chars(app.field2.graphemes(), 0, gui.clamp(app.field2_cursor, 0, app.field2.graphemes().len()))
        gui.rect(x + 62 + gui.mono_width(at2, 12), y + 40, 1, 18, theme.accent)
    }
    gui.rect(x + width - 68, y + 38, 56, 22, theme.accent)
    gui.text(x + width - 56, y + 43, "All", 11, theme.fg_bright)
}

// ---------- folding ----------

fn fold_end(lines: List<String>, start: Int) -> Int {
    var depth = 0
    var i = start
    while i < lines.len() {
        let chars = lines[i].graphemes()
        var j = 0
        while j < chars.len() {
            if chars[j] == "{" {
                depth = depth + 1
            }
            if chars[j] == "}" {
                depth = depth - 1
            }
            j = j + 1
        }
        if depth <= 0 && i > start {
            return i
        }
        i = i + 1
    }
    return start
}

// Line indices that are actually drawn, skipping folded blocks.
fn visible_rows(tab: Tab) -> List<Int> {
    var rows: List<Int> = []
    var i = 0
    while i < tab.lines.len() {
        rows.push(i)
        if has_int(tab.folds, i) {
            i = fold_end(tab.lines, i) + 1
        } else {
            i = i + 1
        }
    }
    return rows
}

fn row_line(rows: List<Int>, row: Int) -> Int {
    if row < 0 || row >= rows.len() {
        return -1
    }
    return rows[row]
}

fn row_of(rows: List<Int>, line: Int) -> Int {
    var i = 0
    while i < rows.len() {
        if rows[i] == line {
            return i
        }
        i = i + 1
    }
    return -1
}

// ---------- multi-cursor ----------

fn word_bounds(line: String, col: Int) -> List<Int> {
    let chars = line.graphemes()
    var start = gui.clamp(col, 0, chars.len())
    var end = start
    while start > 0 && is_ident_part(chars[start - 1]) {
        start = start - 1
    }
    while end < chars.len() && is_ident_part(chars[end]) {
        end = end + 1
    }
    var out: List<Int> = []
    out.push(start)
    out.push(end)
    return out
}

// ⌘D: put another caret on the next occurrence of the word under the caret.
fn add_cursor(app: App) -> App {
    var app = app
    if app.active < 0 || app.tabs.len() == 0 {
        return app
    }
    let tab = app.tabs[app.active]
    var needle = ""
    let span = selection_span(tab)
    if !span.empty {
        needle = selected_text(tab)
    }
    if needle.len() == 0 {
        let bounds = word_bounds(tab.lines[tab.cursor_line], tab.cursor_col)
        needle = slice_chars(tab.lines[tab.cursor_line].graphemes(), bounds[0], bounds[1])
    }
    if needle.len() == 0 {
        app.status = "Nothing to select"
        return app
    }
    var from_line = tab.cursor_line
    var from_col = tab.cursor_col
    var c = 0
    while c + 1 < app.cursors.len() {
        if app.cursors[c] > from_line || (app.cursors[c] == from_line && app.cursors[c + 1] > from_col) {
            from_line = app.cursors[c]
            from_col = app.cursors[c + 1]
        }
        c = c + 2
    }
    var line = from_line
    var col = from_col + needle.graphemes().len()
    var found_line = -1
    var found_col = -1
    var scanned = 0
    while scanned <= tab.lines.len() {
        if line >= tab.lines.len() {
            line = 0
            col = 0
        }
        let at = find_in_line(tab.lines[line], needle, col)
        if at >= 0 {
            found_line = line
            found_col = at
            scanned = tab.lines.len() + 1
        } else {
            line = line + 1
            col = 0
            scanned = scanned + 1
        }
    }
    if found_line < 0 {
        app.status = "No more matches"
        return app
    }
    var cursors = app.cursors
    cursors.push(found_line)
    cursors.push(found_col)
    app.cursors = cursors
    app.status = "${cursors.len() / 2 + 1} cursors"
    return app
}

// Inserts at the primary caret and every extra caret, right to left.
fn insert_at_carets(app: App, value: String) -> App {
    var app = app
    var tab = app.tabs[app.active]
    let added = value.graphemes().len()
    var pts: List<Int> = []
    pts.push(tab.cursor_line)
    pts.push(gui.clamp(tab.cursor_col, 0, tab.lines[tab.cursor_line].graphemes().len()))
    var c = 0
    while c + 1 < app.cursors.len() {
        let l = app.cursors[c]
        pts.push(l)
        pts.push(gui.clamp(app.cursors[c + 1], 0, tab.lines[l].graphemes().len()))
        c = c + 2
    }
    let n = pts.len() / 2
    var i = 0
    while i < n {
        var j = 0
        while j + 1 < n - i {
            let l0 = pts[j * 2]
            let c0 = pts[j * 2 + 1]
            let l1 = pts[(j + 1) * 2]
            let c1 = pts[(j + 1) * 2 + 1]
            if l0 < l1 || (l0 == l1 && c0 < c1) {
                pts[j * 2] = l1
                pts[j * 2 + 1] = c1
                pts[(j + 1) * 2] = l0
                pts[(j + 1) * 2 + 1] = c0
            }
            j = j + 1
        }
        i = i + 1
    }
    var lines = tab.lines
    var k = 0
    while k + 1 < pts.len() {
        let line = pts[k]
        let chars = lines[line].graphemes()
        let at = gui.clamp(pts[k + 1], 0, chars.len())
        lines = replace_line(lines, line, slice_chars(chars, 0, at) + value + slice_chars(chars, at, chars.len()))
        k = k + 2
    }
    tab.lines = lines
    tab.cursor_col = tab.cursor_col + added
    var extras: List<Int> = []
    var m = 0
    while m + 1 < app.cursors.len() {
        extras.push(app.cursors[m])
        extras.push(app.cursors[m + 1] + added)
        m = m + 2
    }
    app.cursors = extras
    tab.dirty = true
    app.tabs[app.active] = tab
    app.status = ""
    return app
}

// Backspace at the primary caret and every extra caret.
fn backspace_at_carets(app: App) -> App {
    var app = app
    var tab = app.tabs[app.active]
    var pts: List<Int> = []
    pts.push(tab.cursor_line)
    pts.push(tab.cursor_col)
    var c = 0
    while c + 1 < app.cursors.len() {
        pts.push(app.cursors[c])
        pts.push(app.cursors[c + 1])
        c = c + 2
    }
    let n = pts.len() / 2
    var i = 0
    while i < n {
        var j = 0
        while j + 1 < n - i {
            let l0 = pts[j * 2]
            let c0 = pts[j * 2 + 1]
            let l1 = pts[(j + 1) * 2]
            let c1 = pts[(j + 1) * 2 + 1]
            if l0 < l1 || (l0 == l1 && c0 < c1) {
                pts[j * 2] = l1
                pts[j * 2 + 1] = c1
                pts[(j + 1) * 2] = l0
                pts[(j + 1) * 2 + 1] = c0
            }
            j = j + 1
        }
        i = i + 1
    }
    var lines = tab.lines
    var k = 0
    while k + 1 < pts.len() {
        let line = pts[k]
        let chars = lines[line].graphemes()
        let at = gui.clamp(pts[k + 1], 0, chars.len())
        if at > 0 {
            lines = replace_line(lines, line, slice_chars(chars, 0, at - 1) + slice_chars(chars, at, chars.len()))
        }
        k = k + 2
    }
    tab.lines = lines
    if tab.cursor_col > 0 {
        tab.cursor_col = tab.cursor_col - 1
    }
    var extras: List<Int> = []
    var m = 0
    while m + 1 < app.cursors.len() {
        extras.push(app.cursors[m])
        var ecol = app.cursors[m + 1]
        if ecol > 0 {
            ecol = ecol - 1
        }
        extras.push(ecol)
        m = m + 2
    }
    app.cursors = extras
    tab.dirty = true
    app.tabs[app.active] = tab
    return app
}

// ---------- scripted UI test ----------

// Reverse of code_to_text: the key code that produces a printable character.
fn char_code(ch: String) -> Int {
    let chars = printable().graphemes()
    var i = 0
    while i < chars.len() {
        if chars[i] == ch {
            return 32 + i
        }
        i = i + 1
    }
    return 0
}

fn digit_value(ch: String) -> Int {
    let digits = "0123456789".graphemes()
    var i = 0
    while i < digits.len() {
        if digits[i] == ch {
            return i
        }
        i = i + 1
    }
    return -1
}

fn str_to_int(word: String) -> Int {
    var value = 0
    var sign = 1
    let chars = word.graphemes()
    var i = 0
    while i < chars.len() {
        if chars[i] == "-" && i == 0 {
            sign = 0 - 1
        } else {
            let d = digit_value(chars[i])
            if d >= 0 {
                value = value * 10 + d
            }
        }
        i = i + 1
    }
    return value * sign
}

fn script_words(line: String) -> List<String> {
    var out: List<String> = []
    let chars = line.graphemes()
    var current = ""
    var i = 0
    while i < chars.len() {
        if chars[i] == " " {
            if current.len() > 0 {
                out.push(current)
                current = ""
            }
        } else {
            current = current + chars[i]
        }
        i = i + 1
    }
    if current.len() > 0 {
        out.push(current)
    }
    return out
}

fn report(ok: Bool, name: String) {
    if ok {
        println("PASS " + name)
    } else {
        println("FAIL " + name)
    }
}

fn poll_term(app: App) -> App {
    var app = app
    let chunk = gui.pty_poll(app.term_slot)
    if chunk.len() > 0 {
        vt.tm_feed(app.term, chunk)
    }
    if !gui.pty_running(app.term_slot) && app.task_running {
        app.task_running = false
        let code = gui.pty_status(app.term_slot)
        vt.tm_feed(app.term, "\r\n" + vt.tm_escape() + "[90m[exit " + "${code}" + "]" + vt.tm_escape() + "[0m\r\n")
    }
    return app
}

// Keeps the emulator grid and the pty window size in step with the panel.
fn sync_term(app: App) -> App {
    var app = app
    let w = gui.width()
    var left = activity_width()
    if app.sidebar {
        left = left + sidebar_width()
    }
    let cols = (w - left - 28) / gui.advance(12)
    let rows = (panel_height() - 70) / 17
    if cols > 20 && rows > 3 && (cols != app.term_cols || rows != app.term_rows) {
        app.term_cols = cols
        app.term_rows = rows
        app.term = vt.tm_resize(app.term, cols, rows)
        gui.pty_resize(app.term_slot, cols, rows)
    }
    return app
}

fn terminal_palette(app: App) -> vt.Palette {
    if app.theme_name.contains("Gruvbox") {
        return vt.tm_palette_gruvbox()
    }
    return vt.tm_palette_dark()
}

// Runs a script of synthetic events against the same handlers the window uses,
// so selection, find and folding are exercised without a human at the keyboard.
fn run_script(app: App, path: String) -> App {
    var app = app
    for entry in split_lines(gui.read(path)) {
        let trimmed = entry.trim()
        if trimmed.len() > 0 && !trimmed.starts_with("#") {
            let words = script_words(trimmed)
            let cmd = words[0]
            if cmd == "click" && words.len() >= 3 {
                app = click(app, str_to_int(words[1]), str_to_int(words[2]), 0)
            }
            if cmd == "clickmod" && words.len() >= 4 {
                app = click(app, str_to_int(words[1]), str_to_int(words[2]), str_to_int(words[3]))
            }
            if cmd == "drag" && words.len() >= 3 {
                app = drag(app, str_to_int(words[1]), str_to_int(words[2]))
            }
            if cmd == "key" && words.len() >= 2 {
                app = key(app, str_to_int(words[1]), 0)
            }
            if cmd == "keymod" && words.len() >= 3 {
                app = key(app, str_to_int(words[1]), str_to_int(words[2]))
            }
            if cmd == "text" && words.len() >= 2 {
                let chars = words[1].graphemes()
                var i = 0
                while i < chars.len() {
                    app = key(app, char_code(chars[i]), 0)
                    i = i + 1
                }
            }
            if cmd == "fold" && words.len() >= 2 {
                app = toggle_fold(app, str_to_int(words[1]))
            }
            if cmd == "shot" && words.len() >= 2 {
                gui.begin()
                draw(app)
                gui.present()
                gui.save_png(words[1])
            }
            if cmd == "wait" && words.len() >= 2 {
                var ms = str_to_int(words[1])
                while ms > 0 {
                    gui.pump()
                    gui.sleep(10)
                    app = poll_term(app)
                    ms = ms - 10
                }
            }
            if cmd == "build_now" {
                app = run_task(app, "build")
            }
            if cmd == "assert_cursor" && words.len() >= 3 {
                var ok = false
                if app.active >= 0 && app.tabs.len() > 0 {
                    let tab = app.tabs[app.active]
                    ok = tab.cursor_line == str_to_int(words[1]) && tab.cursor_col == str_to_int(words[2])
                }
                report(ok, trimmed)
            }
            if cmd == "assert_selection_has" && words.len() >= 2 {
                var ok = false
                if app.active >= 0 && app.tabs.len() > 0 {
                    ok = selected_text(app.tabs[app.active]).contains(words[1])
                }
                report(ok, trimmed)
            }
            if cmd == "assert_find" && words.len() >= 2 {
                var count = 0
                if app.active >= 0 && app.tabs.len() > 0 {
                    count = all_matches(app.tabs[app.active], app.field).len() / 2
                }
                report(count == str_to_int(words[1]), trimmed)
            }
            if cmd == "assert_fold" && words.len() >= 2 {
                var count = 0
                if app.active >= 0 && app.tabs.len() > 0 {
                    count = app.tabs[app.active].folds.len()
                }
                report(count == str_to_int(words[1]), trimmed)
            }
            if cmd == "assert_rows" && words.len() >= 2 {
                var count = 0
                if app.active >= 0 && app.tabs.len() > 0 {
                    count = visible_rows(app.tabs[app.active]).len()
                }
                report(count == str_to_int(words[1]), trimmed)
            }
            if cmd == "assert_clipboard_has" && words.len() >= 2 {
                report(gui.clipboard().contains(words[1]), trimmed)
            }
            if cmd == "assert_term_has" && words.len() >= 2 {
                report(vt.tm_all_text(app.term).contains(words[1]), trimmed)
            }
            if cmd == "assert_rows_min" && words.len() >= 2 {
                var count = 0
                if app.active >= 0 && app.tabs.len() > 0 {
                    count = visible_rows(app.tabs[app.active]).len()
                }
                report(count >= str_to_int(words[1]), trimmed)
            }
            if cmd == "assert_rows_max" && words.len() >= 2 {
                var count = 0
                if app.active >= 0 && app.tabs.len() > 0 {
                    count = visible_rows(app.tabs[app.active]).len()
                }
                report(count <= str_to_int(words[1]), trimmed)
            }
            if cmd == "assert_line_has" && words.len() >= 3 {
                var ok = false
                if app.active >= 0 && app.tabs.len() > 0 {
                    let tab = app.tabs[app.active]
                    let at = str_to_int(words[1])
                    if at >= 0 && at < tab.lines.len() {
                        ok = tab.lines[at].contains(words[2])
                    }
                }
                report(ok, trimmed)
            }
            if cmd == "openfile" && words.len() >= 2 {
                var path = words[1]
                if !path.starts_with("/") {
                    path = app.root + "/" + path
                }
                app = open_file(app, path)
            }
            if cmd == "refs" {
                app = find_references(app)
            }
            if cmd == "assert_refs" && words.len() >= 2 {
                report(app.refs.len() == str_to_int(words[1]), trimmed)
            }
            if cmd == "assert_refs_min" && words.len() >= 2 {
                report(app.refs.len() >= str_to_int(words[1]), trimmed)
            }
            if cmd == "assert_pane_tab" && words.len() >= 3 {
                report(pane_tab(app, str_to_int(words[1])) == str_to_int(words[2]), trimmed)
            }
            if cmd == "tabdrag" && words.len() >= 3 {
                app = click(app, str_to_int(words[1]), str_to_int(words[2]), 0)
                app = drag(app, str_to_int(words[1]) + 300, str_to_int(words[2]))
            }
            if cmd == "gotodef" {
                app = go_to_definition(app)
            }
            if cmd == "splittoggle" {
                app = toggle_split(app)
            }
            if cmd == "assert_split" && words.len() >= 2 {
                report(app.split == (str_to_int(words[1]) == 1), trimmed)
            }
            if cmd == "termcmd" && words.len() >= 2 {
                app.term = vt.tm_new(app.term_cols, app.term_rows)
                if gui.pty_open(app.term_slot, words[1], app.root, app.term_cols, app.term_rows) {
                    app.task_running = true
                }
            }
            if cmd == "termfeed" && words.len() >= 2 {
                var payload = ""
                var k = 1
                while k < words.len() {
                    if k > 1 {
                        payload = payload + " "
                    }
                    payload = payload + words[k]
                    k = k + 1
                }
                vt.tm_feed(app.term, payload.replace("<E>", vt.tm_escape()))
            }
            if cmd == "refdump" {
                println("REFCOUNT " + "${app.refs.len()}" + " status=" + app.status)
                if app.refs.len() > 0 {
                    println("REF0 " + app.refs[0].replace(vt.tm_escape(), ""))
                }
            }
            if cmd == "termdump" {
                println("DUMP [" + vt.tm_all_text(app.term).replace(vt.tm_escape(), "<E>") + "]")
            }
            if cmd == "termtype" && words.len() >= 2 {
                app.term_focus = true
                gui.pty_write_text(app.term_slot, words[1])
            }
            if cmd == "termenter" {
                gui.pty_write_text(app.term_slot, "\r")
            }
            if cmd == "termkey" && words.len() >= 2 {
                app = term_key(app, str_to_int(words[1]), 0)
            }
            if cmd == "termresize" && words.len() >= 3 {
                app.term_cols = str_to_int(words[1])
                app.term_rows = str_to_int(words[2])
                app.term = vt.tm_resize(app.term, app.term_cols, app.term_rows)
                gui.pty_resize(app.term_slot, app.term_cols, app.term_rows)
            }
            if cmd == "termclear" {
                app.term = vt.tm_new(app.term_cols, app.term_rows)
            }
            if cmd == "assert_term_cell" && words.len() >= 3 {
                report(vt.tm_cell_at(app.term, str_to_int(words[1]), str_to_int(words[2])).ch == words[3], trimmed)
            }
            if cmd == "assert_term_colour" && words.len() >= 4 {
                report(vt.tm_cell_at(app.term, str_to_int(words[1]), str_to_int(words[2])).fg == str_to_int(words[3]), trimmed)
            }
            if cmd == "assert_term_lines" && words.len() >= 2 {
                report(vt.tm_total_lines(app.term) == str_to_int(words[1]), trimmed)
            }
            if cmd == "assert_file_has" && words.len() >= 2 {
                var ok = false
                if app.active >= 0 && app.tabs.len() > 0 {
                    ok = app.tabs[app.active].path.contains(words[1])
                }
                report(ok, trimmed)
            }
            if cmd == "assert_cursors" && words.len() >= 2 {
                report(app.cursors.len() / 2 == str_to_int(words[1]), trimmed)
            }
        }
    }
    return app
}

// ---------- split panes ----------

fn pane_tab(app: App, pane: Int) -> Int {
    if pane >= 0 && pane < app.pane_tabs.len() {
        let index = app.pane_tabs[pane]
        if index >= 0 && index < app.tabs.len() {
            return index
        }
    }
    return app.active
}

fn set_pane_tab(app: App, index: Int) -> App {
    var app = app
    var tabs = app.pane_tabs
    while tabs.len() < 2 {
        tabs.push(0)
    }
    tabs[app.pane] = index
    app.pane_tabs = tabs
    app.active = index
    return app
}

fn toggle_split(app: App) -> App {
    var app = app
    app.split = !app.split
    var tabs = app.pane_tabs
    while tabs.len() < 2 {
        tabs.push(0)
    }
    if app.split {
        tabs[1] = app.active
    }
    app.pane_tabs = tabs
    return app
}

// ---------- terminal input ----------

fn term_key(app: App, code: Int, mods: Int) -> App {
    var app = app
    if code == gui.key_escape() {
        app.term_focus = false
        return app
    }
    if mods % 2 == 1 {
        if code == 118 {
            let text = gui.clipboard()
            if text.len() > 0 {
                gui.pty_write_text(app.term_slot, text)
            }
            return app
        }
        if code == 99 {
            gui.set_clipboard(vt.tm_screen_text(app.term))
            app.status = "copied screen"
            return app
        }
        if code == 107 {
            app.term = vt.tm_scroll_bottom(app.term)
            return app
        }
        return app
    }
    if code == gui.key_page_up() {
        app.term = vt.tm_scroll(app.term, 10)
        return app
    }
    if code == gui.key_page_down() {
        app.term = vt.tm_scroll(app.term, 0 - 10)
        return app
    }
    let bytes = vt.tm_key_text(code, mods)
    if bytes.len() > 0 {
        gui.pty_write_text(app.term_slot, bytes)
        app.term = vt.tm_scroll_bottom(app.term)
    }
    return app
}

// ---------- references ----------

fn refs_top() -> Int {
    return 150
}

fn line_has_word(line: String, word: String) -> Bool {
    let chars = line.chars()
    let target = word.chars()
    if target.len() == 0 {
        return false
    }
    var i = 0
    while i + target.len() <= chars.len() {
        var same = true
        var j = 0
        while j < target.len() {
            if chars[i + j] != target[j] {
                same = false
            }
            j = j + 1
        }
        if same {
            let before = i == 0 || !is_ident_part(chars[i - 1])
            let after = i + target.len()
            let after_ok = after >= chars.len() || !is_ident_part(chars[after])
            if before && after_ok {
                return true
            }
        }
        i = i + 1
    }
    return false
}

fn collect_references(app: App, word: String) -> App {
    var app = app
    var labels: List<String> = []
    var paths: List<String> = []
    var lines: List<Int> = []
    if app.active >= 0 && app.tabs.len() > 0 {
        var tab = app.tabs[app.active]
        var row = 0
        while row < tab.lines.len() {
            if line_has_word(tab.lines[row], word) {
                labels.push(tab.name + ":" + "${row + 1}" + "  " + tab.lines[row].trim())
                paths.push(tab.path)
                lines.push(row)
            }
            row = row + 1
        }
    }
    if app.files.len() == 0 {
        app.files = collect_files(app.root, 0)
    }
    var i = 0
    while i < app.files.len() {
        let path = app.files[i]
        var skip = false
        if app.active >= 0 && app.tabs.len() > 0 {
            skip = app.tabs[app.active].path == path
        }
        if !skip {
            let lines_of = split_lines(gui.read(path))
            var row = 0
            while row < lines_of.len() {
                if line_has_word(lines_of[row], word) {
                    labels.push(basename(path) + ":" + "${row + 1}" + "  " + lines_of[row].trim())
                    paths.push(path)
                    lines.push(row)
                }
                row = row + 1
            }
        }
        i = i + 1
    }
    app.refs = labels
    app.ref_paths = paths
    app.ref_lines = lines
    app.ref_index = 0
    app.overlay = "refs"
    app.status = "${labels.len()}" + " references to " + word
    return app
}

fn find_references(app: App) -> App {
    var app = app
    if app.active < 0 || app.tabs.len() == 0 {
        return app
    }
    let tab = app.tabs[app.active]
    let bounds = word_bounds(tab.lines[tab.cursor_line], tab.cursor_col)
    let word = slice_chars(tab.lines[tab.cursor_line].graphemes(), bounds[0], bounds[1])
    if word.len() == 0 {
        app.status = "No symbol under caret"
        return app
    }
    return collect_references(app, word)
}

fn open_reference(app: App, index: Int) -> App {
    var app = app
    if index < 0 || index >= app.ref_paths.len() {
        return app
    }
    let path = app.ref_paths[index]
    let line = app.ref_lines[index]
    app.overlay = ""
    app = open_file(app, path)
    if app.active >= 0 && app.tabs.len() > 0 {
        var tab = app.tabs[app.active]
        tab.cursor_line = gui.clamp(line, 0, tab.lines.len() - 1)
        tab.cursor_col = leading_spaces(tab.lines[tab.cursor_line])
        tab = tab_scrolled(tab)
        app.tabs[app.active] = tab
    }
    return app
}

fn draw_references(app: App, w: Int, h: Int) {
    let theme = app.theme
    let width = 720
    let x = (w - width) / 2
    let y = refs_top()
    var height = app.refs.len() * 24 + 76
    if height > h - y - 60 {
        height = h - y - 60
    }
    gui.rect_alpha(0, 0, w, h, 0, 110)
    gui.rect(x, y, width, height, theme.elevated)
    gui.stroke(x, y, width, height, theme.border_strong)
    gui.text(x + 16, y + 14, "REFERENCES", 11, theme.muted)
    gui.text(x + width - 92, y + 12, "enter to open", 10, theme.faint)
    let rows = (height - 60) / 24
    var i = 0
    while i < app.refs.len() && i < rows {
        var row_bg = theme.elevated
        var color = theme.fg
        if i == app.ref_index {
            row_bg = theme.selection
            color = theme.fg_bright
        }
        gui.rect(x + 8, y + 40 + i * 24, width - 16, 22, row_bg)
        gui.text(x + 16, y + 44 + i * 24, app.refs[i], 11, color)
        i = i + 1
    }
    if app.refs.len() == 0 {
        gui.text(x + 16, y + 44, "No references found.", 11, theme.muted)
    }
}

// ---------- go to definition ----------

fn definition_line(lines: List<String>, word: String) -> Int {
    var i = 0
    while i < lines.len() {
        let trimmed = lines[i].trim()
        if trimmed.starts_with("fn " + word + "(") || trimmed.starts_with("fn " + word + " (") ||
            trimmed.starts_with("struct " + word) || trimmed.starts_with("enum " + word) ||
            trimmed.starts_with("impl " + word) {
            return i
        }
        i = i + 1
    }
    return -1
}

fn go_to_definition(app: App) -> App {
    var app = app
    if app.active < 0 || app.tabs.len() == 0 {
        return app
    }
    var tab = app.tabs[app.active]
    let bounds = word_bounds(tab.lines[tab.cursor_line], tab.cursor_col)
    let word = slice_chars(tab.lines[tab.cursor_line].graphemes(), bounds[0], bounds[1])
    if word.len() == 0 {
        app.status = "No symbol under caret"
        return app
    }
    let here = definition_line(tab.lines, word)
    if here >= 0 {
        tab.cursor_line = here
        tab.cursor_col = leading_spaces(tab.lines[here]) + 3
        tab = tab_scrolled(tab)
        app.tabs[app.active] = tab
        app.status = "Definition: " + word
        return app
    }
    if app.files.len() == 0 {
        app.files = collect_files(app.root, 0)
    }
    var i = 0
    while i < app.files.len() {
        let path = app.files[i]
        if path != tab.path {
            let lines = split_lines(gui.read(path))
            let at = definition_line(lines, word)
            if at >= 0 {
                app = open_file(app, path)
                var found = app.tabs[app.active]
                found.cursor_line = at
                found.cursor_col = leading_spaces(found.lines[at]) + 3
                found = tab_scrolled(found)
                app.tabs[app.active] = found
                app.status = "Definition: " + word + " in " + basename(path)
                return app
            }
        }
        i = i + 1
    }
    app.status = "No definition for " + word
    return app
}

// ---------- input ----------

// Which control the pointer is over, coarsely: two positions with the same key
// paint exactly the same hover state, so moving between them needs no redraw.
fn hover_key(app: App) -> String {
    let mx = app.mouse_x
    let my = app.mouse_y
    let h = gui.height()
    let status_top = h - status_height()
    if mx < 0 || my < 0 {
        return "-"
    }
    if app.overlay.len() > 0 {
        return "overlay"
    }
    if my < title_height() {
        let band = mx / 30
        let line = my / 14
        return "title:${band}:${line}"
    }
    if mx < activity_width() && my < status_top {
        let slot = (my - title_height()) / 46
        return "activity:${slot}"
    }
    if app.sidebar && mx < activity_width() + sidebar_width() && my < status_top {
        let rows_top = title_height() + 62
        if my >= rows_top {
            let row = (my - rows_top) / row_height() + app.tree_scroll
            return "tree:${row}"
        }
        let band = my / 20
        return "side:${band}"
    }
    if app.panel && my > status_top - panel_height() {
        let tab = (my - (status_top - panel_height())) / 35
        return "panel:${tab}"
    }
    return "body"
}

fn handle(app: App, event: gui.Event) -> App {
    var app = app
    if event.kind == gui.event_close() {
        app.quit = true
        return app
    }
    // Focus changes only need a repaint; the model is unchanged.
    if event.kind == gui.event_repaint() {
        return app
    }
    if event.kind == gui.event_mouse_move() {
        app.mouse_x = event.x
        app.mouse_y = event.y
        return app
    }
    if event.kind == gui.event_drag() {
        return drag(app, event.x, event.y)
    }
    if event.kind == gui.event_mouse_down() {
        return click(app, event.x, event.y, event.mods)
    }
    if event.kind == gui.event_scroll() {
        return scroll(app, event.delta, event.x, event.y)
    }
    if event.kind == gui.event_key() {
        return key(app, event.code, event.mods)
    }
    return app
}

fn key(app: App, code: Int, mods: Int) -> App {
    var app = app
    let command = mods % 2 == 1
    let shift = (mods / 2) % 2 == 1
    if app.overlay.len() > 0 {
        return overlay_key(app, code, mods)
    }
    if command {
        if code == 115 {
            if shift {
                return save_all(app)
            }
            return save(app)
        }
        if code == 98 {
            if shift {
                return run_task(app, "check")
            }
            return run_task(app, "build")
        }
        if code == 114 {
            return run_project(app)
        }
        if code == 119 {
            return close_tab(app)
        }
        if code == 112 {
            if shift {
                return open_palette(app)
            }
            return open_quick(app)
        }
        if code == 96 {
            app.panel = !app.panel
            return app
        }
        if code == 44 {
            app.overlay = "settings"
            return app
        }
        if code == 101 {
            if shift {
                app.sidebar = !app.sidebar
            }
            return app
        }
        if code == 113 {
            app.quit = true
            return app
        }
        if code == 111 {
            if shift {
                let picked = gui.pick_folder()
                if picked.len() > 0 {
                    return open_workspace(app, picked)
                }
                return app
            }
            let picked = gui.pick_file()
            if picked.len() > 0 {
                return open_file(app, picked)
            }
            return app
        }
        if code == 92 {
            return toggle_split(app)
        }
        if code == 102 {
            app.overlay = "find"
            app.focus = 0
            return app
        }
        if code == 100 {
            return add_cursor(app)
        }
        if code == 99 {
            return copy_selection(app)
        }
        if code == 120 {
            return cut_selection(app)
        }
        if code == 118 {
            return paste_clipboard(app)
        }
        if code == 97 {
            return select_all(app)
        }
        // Editor zoom, like ⌘+ / ⌘- / ⌘0 in VS Code.
        if code == 61 || code == 43 || code == 69 {
            app.size = gui.clamp(app.size + 1, 10, 22)
            return app
        }
        if code == 45 || code == 78 {
            app.size = gui.clamp(app.size - 1, 10, 22)
            return app
        }
        if code == 48 {
            app.size = 13
            return app
        }
        return app
    }
    if app.term_focus {
        return term_key(app, code, mods)
    }
    if code == gui.key_f12() {
        if shift {
            return find_references(app)
        }
        return go_to_definition(app)
    }
    // Vim: normal and visual modes own the keyboard; insert mode is the plain
    // editor and Esc drops back out of it.
    if app.vim && app.mode != "insert" {
        return vim_key(app, code)
    }
    if app.vim && app.mode == "insert" && code == gui.key_escape() {
        app.mode = "normal"
        return app
    }
    if app.active >= 0 && app.tabs.len() > 0 {
        if code == gui.key_enter() {
            return edit_newline(app)
        }
        if code == gui.key_tab() {
            return edit_insert(app, "    ")
        }
        if code == gui.key_backspace() {
            return edit_backspace(app)
        }
        if code == gui.key_delete() {
            return edit_delete(app)
        }
        if code == gui.key_left() {
            return edit_move(app, 0, -1)
        }
        if code == gui.key_right() {
            return edit_move(app, 0, 1)
        }
        if code == gui.key_up() {
            return edit_move(app, -1, 0)
        }
        if code == gui.key_down() {
            return edit_move(app, 1, 0)
        }
        if code == gui.key_home() {
            return edit_home(app)
        }
        if code == gui.key_end() {
            return edit_end(app)
        }
        if code >= 32 && code <= 126 {
            let text = code_to_text(code)
            if text.len() > 0 {
                return edit_insert(app, text)
            }
        }
    }
    if code == gui.key_escape() {
        app.overlay = ""
    }
    return app
}

fn overlay_key(app: App, code: Int, mods: Int) -> App {
    var app = app
    if app.overlay == "refs" {
        if code == gui.key_escape() {
            app.overlay = ""
            return app
        }
        if code == gui.key_up() {
            if app.ref_index > 0 {
                app.ref_index = app.ref_index - 1
            }
            return app
        }
        if code == gui.key_down() {
            if app.ref_index + 1 < app.refs.len() {
                app.ref_index = app.ref_index + 1
            }
            return app
        }
        if code == 13 {
            return open_reference(app, app.ref_index)
        }
        return app
    }
    if app.overlay == "find" {
        return find_key(app, code, mods)
    }
    let command = mods % 2 == 1
    if code == gui.key_escape() {
        app.overlay = ""
        app.field = ""
        app.field_cursor = 0
        return app
    }
    if code == gui.key_enter() {
        let list = rows(app)
        if app.selection >= 0 && app.selection < list.len() {
            let picked = list[app.selection]
            if app.overlay == "quick" {
                var next = app
                next.overlay = ""
                next.field = ""
                next.field_cursor = 0
                return open_file(next, picked.key)
            }
            return run_command(app, picked.key)
        }
        return app
    }
    if code == gui.key_up() {
        if app.selection > 0 {
            app.selection = app.selection - 1
        }
        return app
    }
    if code == gui.key_down() {
        let list = rows(app)
        if app.selection + 1 < list.len() {
            app.selection = app.selection + 1
        }
        return app
    }
    if app.overlay == "settings" || app.overlay == "about" {
        return app
    }
    if code == gui.key_backspace() {
        let chars = app.field.graphemes()
        if app.field_cursor > 0 {
            app.field = slice_chars(chars, 0, app.field_cursor - 1) + slice_chars(chars, app.field_cursor, chars.len())
            app.field_cursor = app.field_cursor - 1
            app.selection = 0
        }
        return app
    }
    if code == gui.key_left() {
        if app.field_cursor > 0 {
            app.field_cursor = app.field_cursor - 1
        }
        return app
    }
    if code == gui.key_right() {
        if app.field_cursor < app.field.graphemes().len() {
            app.field_cursor = app.field_cursor + 1
        }
        return app
    }
    if !command && code >= 32 && code <= 126 {
        let text = code_to_text(code)
        if text.len() > 0 {
            let chars = app.field.graphemes()
            app.field = slice_chars(chars, 0, app.field_cursor) + text + slice_chars(chars, app.field_cursor, chars.len())
            app.field_cursor = app.field_cursor + 1
            app.selection = 0
        }
    }
    return app
}

fn scroll(app: App, delta: Int, mx: Int, my: Int) -> App {
    var app = app
    let steps = delta / 10
    if steps == 0 {
        return app
    }
    let left = activity_width() + (if_set(app.sidebar, sidebar_width(), 0))
    if app.sidebar && mx < activity_width() + sidebar_width() {
        app.tree_scroll = gui.clamp(app.tree_scroll - steps, 0, app.nodes.len())
        return app
    }
    if app.active >= 0 && app.tabs.len() > 0 && mx > left {
        var tab = app.tabs[app.active]
        let rows = visible_rows(tab)
        tab.scroll = gui.clamp(tab.scroll - steps, 0, rows.len())
        app.tabs[app.active] = tab
    }
    return app
}

fn if_set(flag: Bool, value: Int, other: Int) -> Int {
    if flag {
        return value
    }
    return other
}

fn toggle_fold(app: App, line: Int) -> App {
    var app = app
    if app.active < 0 || app.tabs.len() == 0 {
        return app
    }
    var tab = app.tabs[app.active]
    if line < 0 || line >= tab.lines.len() {
        return app
    }
    var folds = tab.folds
    if has_int(folds, line) {
        var kept: List<Int> = []
        var k = 0
        while k < folds.len() {
            if folds[k] != line {
                kept.push(folds[k])
            }
            k = k + 1
        }
        folds = kept
    } else {
        folds.push(line)
    }
    tab.folds = folds
    app.tabs[app.active] = tab
    return app
}

fn drag(app: App, mx: Int, my: Int) -> App {
    var app = app
    let drag_w = gui.width()
    var drag_left = activity_width()
    if app.sidebar {
        drag_left = drag_left + sidebar_width()
    }
    let drag_top = title_height() + tabs_height() + crumbs_height()
    if my < drag_top {
        if app.tab_drag >= 0 && app.tab_drag < app.tabs.len() {
            let half = drag_left + (drag_w - drag_left) / 2
            if !app.split && mx > half {
                app.split = true
                app.pane = 1
                app.pane_tabs = [0, app.tab_drag]
                app.term_focus = false
                app.status = "moved " + app.tabs[app.tab_drag].name + " into a split"
                return app
            }
            if app.split {
                if mx > half {
                    app.pane = 1
                } else {
                    app.pane = 0
                }
                return set_pane_tab(app, app.tab_drag)
            }
        }
        return app
    }
    app.tab_drag = 0 - 1
    if app.overlay.len() > 0 {
        return app
    }
    let h = gui.height()
    var left = activity_width()
    if app.sidebar {
        left = left + sidebar_width()
    }
    let editor_top = title_height() + tabs_height() + crumbs_height()
    var editor_bottom = h - status_height()
    if app.panel {
        editor_bottom = editor_bottom - panel_height()
    }
    if app.active < 0 || app.tabs.len() == 0 || my < editor_top || my > editor_bottom || mx < left {
        return app
    }
    var tab = app.tabs[app.active]
    let rows = visible_rows(tab)
    let row = tab.scroll + (my - editor_top) / line_height(app.size)
    var line = tab.lines.len() - 1
    if row >= 0 && row < rows.len() {
        line = rows[row]
    }
    var col = (mx - left - gutter_width()) / gui.mono_width(" ", app.size)
    if col < 0 {
        col = 0
    }
    tab.cursor_line = gui.clamp(line, 0, tab.lines.len() - 1)
    tab.cursor_col = gui.clamp(col, 0, tab.lines[tab.cursor_line].graphemes().len())
    tab.selecting = true
    tab = tab_scrolled(tab)
    app.tabs[app.active] = tab
    app.mouse_x = mx
    app.mouse_y = my
    return app
}

fn click(app: App, mx: Int, my: Int, mods: Int) -> App {
    var app = app
    app.tab_drag = 0 - 1
    if app.overlay == "refs" {
        let row = (my - refs_top()) / 24
        if row >= 0 && row < app.refs.len() {
            return open_reference(app, row)
        }
        app.overlay = ""
        return app
    }
    let w = gui.width()
    let h = gui.height()
    if app.overlay.len() > 0 {
        return overlay_click(app, mx, my, w, h)
    }
    // Title bar buttons
    if my < title_height() {
        if mx > w - 110 && mx < w - 90 {
            app.sidebar = !app.sidebar
            return app
        }
        if mx > w - 80 && mx < w - 60 {
            app.panel = !app.panel
            return app
        }
        if mx > w - 50 {
            app.overlay = "settings"
            return app
        }
        return app
    }
    // Activity bar
    if mx < activity_width() && my < h - status_height() {
        let index = (my - title_height()) / 46
        if index == 1 {
            return open_quick(app)
        }
        if index == 2 {
            app.panel = true
            app.bottom = "docs"
            return app
        }
        if index == 3 {
            app.overlay = "settings"
            return app
        }
        app.sidebar = !app.sidebar
        return app
    }
    // Explorer
    if app.sidebar && mx < activity_width() + sidebar_width() {
        if my < title_height() + 35 && mx > activity_width() + sidebar_width() - 40 {
            app.nodes = build_nodes(app.root, 0, app.expanded)
            return app
        }
        let start_y = title_height() + 62
        if my >= start_y {
            let index = app.tree_scroll + (my - start_y) / row_height()
            if index >= 0 && index < app.nodes.len() {
                let node = app.nodes[index]
                if node.is_dir {
                    var expanded = app.expanded
                    if list_has(expanded, node.path) {
                        var kept: List<String> = []
                        var i = 0
                        while i < expanded.len() {
                            if expanded[i] != node.path {
                                kept.push(expanded[i])
                            }
                            i = i + 1
                        }
                        expanded = kept
                    } else {
                        expanded.push(node.path)
                    }
                    app.expanded = expanded
                    app.nodes = build_nodes(app.root, 0, expanded)
                } else {
                    return open_file(app, node.path)
                }
            }
        }
        return app
    }
    // Tabs
    var left = activity_width()
    if app.sidebar {
        left = left + sidebar_width()
    }
    if my < title_height() + tabs_height() && mx > left {
        var strip_left = left
        if app.split && (w - left) >= 520 {
            if mx > left + (w - left) / 2 {
                app.pane = 1
                strip_left = left + (w - left) / 2 - 1
            } else {
                app.pane = 0
            }
        }
        var tx = strip_left
        var i = 0
        while i < app.tabs.len() {
            var width = gui.mono_width(app.tabs[i].name, 12) + 62
            if width > 240 {
                width = 240
            }
            if width < 120 {
                width = 120
            }
            if mx >= tx && mx < tx + width {
                if mx > tx + width - 30 {
                    app = set_pane_tab(app, i)
                    return close_tab(app)
                }
                app.tab_drag = i
                return set_pane_tab(app, i)
            }
            tx = tx + width
            i = i + 1
        }
        return app
    }
    // Editor
    let editor_top = title_height() + tabs_height() + crumbs_height()
    var editor_bottom = h - status_height()
    if app.panel {
        editor_bottom = editor_bottom - panel_height()
    }
    if my > editor_top && my < editor_bottom && mx > left {
        var pane_left = left
        var pane_index = 0
        if app.split && w - left >= 520 {
            let half = (w - left) / 2
            if mx >= left + half {
                pane_index = 1
                pane_left = left + half
            }
        }
        app.pane = pane_index
        app.active = pane_tab(app, pane_index)
        app.term_focus = false
        if app.active >= 0 && app.tabs.len() > 0 {
            var tab = app.tabs[app.active]
            let rows = visible_rows(tab)
            let row = tab.scroll + (my - editor_top) / line_height(app.size)
            var line = tab.lines.len() - 1
            if row >= 0 && row < rows.len() {
                line = rows[row]
            }
            // The gutter fold marker: a minus when open, a plus when collapsed.
            if mx > pane_left + gutter_width() - 38 && mx < pane_left + gutter_width() - 20 {
                let trimmed = tab.lines[line].trim()
                let is_decl = trimmed.starts_with("fn ") || trimmed.starts_with("struct ") || trimmed.starts_with("impl ") || trimmed.starts_with("enum ")
                if is_decl {
                    return toggle_fold(app, line)
                }
            }
            var picked = tab
            picked.cursor_line = gui.clamp(line, 0, tab.lines.len() - 1)
            var column = (mx - pane_left - gutter_width()) / gui.mono_width(" ", app.size)
            if column < 0 {
                column = 0
            }
            picked.cursor_col = gui.clamp(column, 0, picked.lines[picked.cursor_line].graphemes().len())
            picked.selecting = true
            let shift = (mods / 2) % 2 == 1
            if !shift {
                picked.sel_line = picked.cursor_line
                picked.sel_col = picked.cursor_col
            }
            app.tabs[app.active] = picked
            if mods % 2 == 1 {
                return go_to_definition(app)
            }
            return app
        }
        return app
    }
    // Bottom panel tabs
    if app.panel {
        let panel_y = h - status_height() - panel_height()
        if my > panel_y && my < panel_y + 35 {
            var tx = left + 12
            let ids: List<String> = ["problems", "output", "terminal", "docs"]
            let labels: List<String> = ["PROBLEMS", "OUTPUT", "TERMINAL", "DOCS"]
            var i = 0
            while i < 4 {
                let width = gui.text_width(labels[i], 11) + 20
                if mx >= tx - 10 && mx < tx + width - 10 {
                    app.bottom = ids[i]
                    return app
                }
                tx = tx + width + 20
                i = i + 1
            }
        }
        if my > panel_y + 35 && my < h - status_height() && mx > left {
            if app.bottom == "terminal" {
                app.term_focus = true
            }
        }
    }
    return app
}

fn overlay_click(app: App, mx: Int, my: Int, w: Int, h: Int) -> App {
    var app = app
    if app.overlay == "find" {
        return find_click(app, mx, my, w, h)
    }
    if app.overlay == "settings" {
        let card = 520
        let x = (w - card) / 2
        let y = 90
        if mx > x + 24 && mx < x + 164 && my > y + 90 && my < y + 122 {
            app.theme = gui.dark()
            app.theme_name = "Dark+"
            return app
        }
        if mx > x + 176 && mx < x + 316 && my > y + 90 && my < y + 122 {
            app.theme = gui.gruvbox()
            app.theme_name = "Gruvbox"
            return app
        }
        if mx > x + 24 && mx < x + 56 && my > y + 160 && my < y + 190 {
            if app.size > 10 {
                app.size = app.size - 1
            }
            return app
        }
        if mx > x + 100 && mx < x + 132 && my > y + 160 && my < y + 190 {
            if app.size < 20 {
                app.size = app.size + 1
            }
            return app
        }
        if mx > x + 24 && mx < x + 164 && my > y + 224 && my < y + 256 {
            app.vim = !app.vim
            if app.vim {
                app.mode = "normal"
            } else {
                app.mode = "insert"
            }
            return app
        }
        if mx > x + 176 && mx < x + 316 && my > y + 224 && my < y + 256 {
            app.minimap = !app.minimap
            return app
        }
        return app
    }
    if app.overlay == "about" {
        if my > 240 || mx < 200 {
            app.overlay = ""
        }
        return app
    }
    var card = 640
    if card > w - 80 {
        card = w - 80
    }
    let x = (w - card) / 2
    let y = 70
    let list = rows(app)
    let index = (my - y - 38) / 30
    if mx > x && mx < x + card && index >= 0 && index < list.len() && my > y + 38 {
        let picked = list[index]
        if app.overlay == "quick" {
            var next = app
            next.overlay = ""
            next.field = ""
            next.field_cursor = 0
            return open_file(next, picked.key)
        }
        return run_command(app, picked.key)
    }
    if mx < x || mx > x + card || my < y || my > y + h {
        app.overlay = ""
        app.field = ""
        app.field_cursor = 0
    }
    return app
}

// ---------- main ----------

fn main() {
    // Launch hooks: NOVA_STUDIO_OPEN opens a file at startup and
    // NOVA_STUDIO_SHOT writes the first frame to a PNG and exits.
    let capture = gui.env("NOVA_STUDIO_SHOT")
    let start_file = gui.env("NOVA_STUDIO_OPEN")
    var root = gui.env("NOVA_STUDIO_ROOT")
    if root.len() == 0 {
        root = gui.cwd()
    }
    if !gui.open("Nova Studio", 1280, 820) {
        println("nova-studio: could not open a window")
        return
    }
    var app = App {
        root: root,
        nodes: [],
        expanded: [],
        tabs: [],
        active: -1,
        theme: gui.dark(),
        theme_name: "Dark+",
        size: 13,
        overlay: "",
        field: "",
        field_cursor: 0,
        selection: 0,
        output: "",
        bottom: "problems",
        panel: true,
        sidebar: true,
        status: "",
        quit: false,
        tree_scroll: 0,
        files: [],
        mouse_x: -1,
        mouse_y: -1,
        vim: true,
        mode: "normal",
        yank: "",
        pending: "",
        anchor: 0,
        anim: 0,
        minimap: true,
        plugins: [],
        field2: "",
        field2_cursor: 0,
        focus: 0,
        cursors: [],
        term: vt.tm_new(120, 24),
        term_slot: 0,
        term_cols: 120,
        term_rows: 24,
        task_running: false,
        split: false,
        pane: 0,
        pane_tabs: [],
        term_focus: false,
        dim: false,
        tab_drag: 0 - 1,
        refs: [],
        ref_paths: [],
        ref_lines: [],
        ref_index: 0,
    }
    app.nodes = build_nodes(app.root, 0, app.expanded)
    app.plugins = load_plugins(app.root)
    if capture.len() > 0 && app.nodes.len() > 0 {
        let first_dir = app.nodes[0].is_dir
        println("studio: " + "${app.nodes.len()}" + " rows, first is dir=" + "${first_dir}" + ", plugins=" + "${app.plugins.len()}")
    }
    if start_file.len() > 0 {
        app = open_file(app, start_file)
    }
    let start_task = gui.env("NOVA_STUDIO_TASK")
    if start_task.len() > 0 {
        app = run_task(app, start_task)
        println("studio: task " + start_task + " started")
    }
    let script = gui.env("NOVA_STUDIO_SCRIPT")
    var running = true
    if script.len() > 0 {
        app = run_script(app, script)
        running = false
    }
    var dirty = true
    while running {
        app = sync_term(app)
        if app.task_running || gui.pty_running(app.term_slot) {
            let was_running = app.task_running
            app = poll_term(app)
            if was_running && !app.task_running {
                app.status = "task finished"
            }
            dirty = true
        }
        if dirty {
            gui.begin()
            draw(app)
            gui.present()
            dirty = false
            if capture.len() > 0 {
                gui.save_png(capture)
                app.quit = true
            }
        }
        let event = gui.next_event()
        if event.kind == gui.event_none() {
            // Idle iterations still pump AppKit: without this the window stops
            // committing and macOS shows the app as unresponsive.
            gui.pump()
            gui.sleep(8)
            // Keep repainting while the caret sparks are alive.
            if app.anim > 0 {
                app.anim = app.anim - 1
                dirty = true
            }
        } else {
            let previous = app
            app = handle(app, event)
            if event.kind == gui.event_key() {
                app.anim = 18
            }
            // A mouse move only changes the picture when it changes what is
            // highlighted; redrawing on every move made hover feel sluggish.
            if event.kind == gui.event_mouse_move() {
                if hover_key(previous) != hover_key(app) {
                    dirty = true
                }
            } else {
                dirty = true
            }
        }
        if app.quit || !gui.is_open() {
            running = false
        }
    }
    gui.close()
}
