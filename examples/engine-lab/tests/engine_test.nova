import "../../../libraries/nova-engine/src/math.nova"
import "../../../libraries/nova-engine/src/core.nova"
import "../../../libraries/nova-engine/src/scene.nova"
import "../../../libraries/nova-engine/src/world.nova"

// Acceptance tests for ENG-01 (runtime core, math, lifecycle, timestep) and the
// ENG-01.00 scene-tick regression. Run with `nova test` in examples/engine-lab.

// `assert_eq` is documented but not built into the test runner's build, so the
// suite compares explicitly. A failure aborts through `assert`.
fn same(actual: Int, expected: Int) {
    if actual != expected {
        panic("expected ${expected}, got ${actual}")
    }
}

fn near(a: Int, b: Int, epsilon: Int) -> Bool {
    let difference = a - b
    if difference < 0 {
        return 0 - difference <= epsilon
    }
    return difference <= epsilon
}

// ---------- fixed point ----------

@test
fn fixed_point_scalars() {
    same(fx_mul(fx(3), fx(2)), fx(6))
    same(fx_div(fx(8), fx(2)), fx(4))
    same(fx_div(fx(1), 0), 0)
    let missing = fx_div_checked(fx(1), 0)
    assert(missing.is_none())
    same(fx_floor_int(fx(1) / 2), 0)
    same(fx_floor_int((0 - fx(1)) / 2), 0 - 1)
    same(fx_round_int(fx(3) / 2), 2)
    same(fx_clamp(fx(9), 0, fx(5)), fx(5))
    same(fx_min(fx(2), fx(7)), fx(2))
    same(fx_max(fx(2), fx(7)), fx(7))
}

@test
fn fixed_point_sqrt() {
    assert(near(fx_sqrt(fx(4)), fx(2), 64))
    assert(near(fx_sqrt(fx(9)), fx(3), 64))
    assert(near(fx_sqrt(fx(2)), 92682, 64))
    same(fx_sqrt(0), 0)
    same(fx_sqrt(0 - fx(1)), 0)
}

@test
fn fixed_point_trig() {
    assert(near(fx_sin(0), 0, 4))
    assert(near(fx_cos(0), fx(1), 64))
    assert(near(fx_sin(fx_half_pi()), fx(1), 400))
    assert(near(fx_cos(fx_half_pi()), 0, 400))
    assert(near(fx_sin(fx_pi()), 0, 400))
    assert(near(fx_sin(fx_mul(fx(3), fx_half_pi())), fx(0 - 1), 600))
    assert(near(fx_cos(fx_mul(fx(2), fx_pi())), fx(1), 600))
}

// ---------- vectors ----------

@test
fn vec3_length_and_normalize() {
    let a = vec3(fx(3), fx(4), 0)
    same(v3_len_sq(a), fx(25))
    assert(near(v3_len(a), fx(5), 64))
    let n = v3_normalize(a)
    assert(near(n.x, 39322, 64))
    assert(near(n.y, 52429, 64))
    same(n.z, 0)
    assert(near(v3_len(n), fx(1), 64))
    same(v3_normalize(v3_zero()).x, 0)
}

@test
fn vec3_products() {
    let x_axis = vec3(fx(1), 0, 0)
    let y_axis = vec3(0, fx(1), 0)
    same(v3_dot(x_axis, y_axis), 0)
    same(v3_dot(x_axis, x_axis), fx(1))
    let z_axis = v3_cross(x_axis, y_axis)
    same(z_axis.x, 0)
    same(z_axis.y, 0)
    same(z_axis.z, fx(1))
    let back = v3_cross(y_axis, x_axis)
    same(back.z, fx(0 - 1))
    same(v3_scale(x_axis, fx(3)).x, fx(3))
    same(v3_sub(vec3(fx(5), 0, 0), vec3(fx(2), 0, 0)).x, fx(3))
}

@test
fn vec2_matches_vec3() {
    let v = vec2(fx(3), fx(4))
    assert(near(v.length(), fx(5), 64))
    let unit = v2_normalize(v)
    assert(near(unit.x, 39322, 64))
    assert(near(v2_distance(vec2(0, 0), vec2(fx(3), fx(4))), fx(5), 64))
}

// ---------- quaternions ----------

@test
fn quaternion_rotation() {
    let quarter_turn = quat_axis_angle(vec3(0, 0, fx(1)), fx_half_pi())
    let rotated = quat_rotate_vec3(quarter_turn, vec3(fx(1), 0, 0))
    assert(near(rotated.x, 0, 600))
    assert(near(rotated.y, fx(1), 600))
    assert(near(rotated.z, 0, 600))
    assert(near(quat_len(quarter_turn), fx(1), 128))

    let identity = quat_identity()
    let unchanged = identity.rotated(vec3(fx(2), fx(0 - 3), fx(4)))
    same(unchanged.x, fx(2))
    same(unchanged.y, fx(0 - 3))
    same(unchanged.z, fx(4))
}

@test
fn quaternion_composition_matches_addition() {
    let half = quat_axis_angle(vec3(0, 0, fx(1)), fx_half_pi())
    let full = quat_mul(half, half)
    let rotated = quat_rotate_vec3(full, vec3(fx(1), 0, 0))
    assert(near(rotated.x, fx(0 - 1), 600))
    assert(near(rotated.y, 0, 600))
}

// ---------- matrices ----------

@test
fn matrix_identity_and_translation() {
    let identity = mat4_identity()
    let point = vec3(fx(2), fx(0 - 3), fx(4))
    let same = mat4_transform_point(identity, point)
    same(same.x, point.x)
    same(same.y, point.y)
    same(same.z, point.z)

    let translation = mat4_translation(vec3(fx(2), fx(3), fx(4)))
    let moved = mat4_transform_point(translation, v3_zero())
    same(moved.x, fx(2))
    same(moved.y, fx(3))
    same(moved.z, fx(4))

    let product = mat4_mul(identity, translation)
    same(mat4_get(product, 0, 3), fx(2))
}

@test
fn matrix_scale_and_transform() {
    let transform = transform_new(vec3(fx(10), 0, 0), quat_identity(), vec3(fx(2), fx(2), fx(2)))
    let world = transform_point(transform, vec3(fx(1), 0, 0))
    same(world.x, fx(12))
    let matrix = transform_matrix(transform)
    let via_matrix = mat4_transform_point(matrix, vec3(fx(1), 0, 0))
    same(via_matrix.x, fx(12))
}

@test
fn perspective_depth_and_clip() {
    let projection = mat4_perspective(fx(60), fx(1), fx(1), fx(100))
    let near_clip = mat4_transform4(projection, vec3(0, 0, fx(0 - 1)))
    assert(near(near_clip.w, fx(1), 64))
    assert(near(near_clip.z, fx(0 - 1), 512))

    let far_clip = mat4_transform4(projection, vec3(0, 0, fx(0 - 100)))
    assert(near(far_clip.w, fx(100), 128))
    // Clip space before the perspective divide: w is 100, so z is 100 too.
    assert(near(far_clip.z, fx(100), 2048))

    let centre = mat4_transform_point(projection, vec3(0, 0, fx(0 - 10)))
    assert(near(centre.x, 0, 64))
    assert(near(centre.y, 0, 64))
}

@test
fn ortho_corners() {
    let projection = mat4_ortho(0, fx(800), fx(600), 0, fx(1), fx(100))
    let top_left = mat4_transform_point(projection, vec3(0, 0, fx(0 - 1)))
    assert(near(top_left.x, fx(0 - 1), 512))
    assert(near(top_left.y, fx(1), 512))
    assert(near(top_left.z, fx(0 - 1), 512))

    let bottom_right = mat4_transform_point(projection, vec3(fx(800), fx(600), fx(0 - 1)))
    assert(near(bottom_right.x, fx(1), 512))
    assert(near(bottom_right.y, fx(0 - 1), 512))
}

@test
fn look_at_keeps_target_in_front() {
    let view = mat4_look_at(vec3(0, 0, fx(5)), v3_zero(), vec3(0, fx(1), 0))
    let target = mat4_transform_point(view, v3_zero())
    assert(near(target.x, 0, 256))
    assert(near(target.y, 0, 256))
    assert(near(target.z, fx(0 - 5), 512))
}

// ---------- handles ----------

@test
fn entity_handles_are_generational() {
    var pool = pool_new()
    let first = pool_spawn(pool)
    pool = first.pool
    assert(pool_is_alive(pool, first.id))
    same(pool_live_count(pool), 1)

    pool = pool_destroy(pool, first.id)
    assert(!pool_is_alive(pool, first.id))
    same(pool_index(pool, first.id), 0 - 1)
    same(pool_live_count(pool), 0)

    let second = pool_spawn(pool)
    pool = second.pool
    same(second.id.index, first.id.index)
    assert(second.id.generation != first.id.generation)
    assert(pool_is_alive(pool, second.id))
    assert(!pool_is_alive(pool, first.id))
}

@test
fn entity_destroy_is_idempotent() {
    var pool = pool_new()
    let spawned = pool_spawn(pool)
    pool = spawned.pool
    pool = pool_destroy(pool, spawned.id)
    let after_first = pool.destroyed
    pool = pool_destroy(pool, spawned.id)
    same(pool.destroyed, after_first)
    same(pool_live_count(pool), 0)
    same(pool_capacity(pool), 1)
}

@test
fn entity_none_never_resolves() {
    var pool = pool_new()
    let spawned = pool_spawn(pool)
    pool = spawned.pool
    assert(!pool_is_alive(pool, entity_none()))
    assert(entity_is_none(entity_none()))
    same(pool_index(pool, entity_none()), 0 - 1)
}

// ---------- timestep ----------

@test
fn timestep_consumes_whole_steps() {
    let clock = clock_new(60)
    same(clock.step_us, 16666)

    let one = clock_advance(clock, 16666)
    same(one.steps, 1)
    same(one.alpha, 0)
    same(one.clock.frame, 1)
    same(one.clock.accumulator_us, 0)

    let partial = clock_advance(clock, 8333)
    same(partial.steps, 0)
    assert(near(partial.alpha, 32768, 2))
    same(partial.clock.frame, 0)

    let three = clock_advance(clock, 50000)
    same(three.steps, 3)
    same(three.clock.frame, 3)
    same(three.clock.accumulator_us, 2)
}

@test
fn timestep_clamps_long_stalls() {
    var clock = clock_new(60)
    clock = clock_with_max_steps(clock, 4)
    let tick = clock_advance(clock, 10000000)
    same(tick.steps, 4)
    assert(tick.clock.dropped_us > 0)
    same(tick.clock.elapsed_us, 4 * 16666)
    let negative = clock_advance(clock, 0 - 500)
    same(negative.steps, 0)
    same(negative.clock.elapsed_us, 0)
}

@test
fn timestep_accumulates_across_frames() {
    var clock = clock_new(60)
    var total = 0
    var i = 0
    while i < 60 {
        let tick = clock_advance(clock, 8333)
        clock = tick.clock
        total = total + tick.steps
        i = i + 1
    }
    // 60 half-steps is 499,980 us, which is exactly 30 whole 16,666 us steps.
    same(total, 30)
    same(clock.frame, 30)
}

// ---------- world / component storage ----------

@test
fn world_spawn_and_recycle_handles() {
    var world = world_new(0)
    let first = world_spawn(world, 1)
    world = first.world
    same(world_live_count(world), 1)
    assert(world_has(world, first.id))
    same(world_tag(world, first.id), 1)

    world = world_despawn(world, first.id)
    assert(!world_has(world, first.id))
    same(world_live_count(world), 0)

    let second = world_spawn(world, 2)
    world = second.world
    same(second.id.index, first.id.index)
    assert(second.id.generation != first.id.generation)
    assert(world_has(world, second.id))
    assert(!world_has(world, first.id))
    same(world_tag(world, second.id), 2)
}

@test
fn world_component_roundtrip() {
    var world = world_new(0)
    let spawned = world_spawn(world, 9)
    world = spawned.world
    world = world_set_position(world, spawned.id, vec3(fx(1), fx(2), fx(3)))
    world = world_set_velocity(world, spawned.id, vec3(fx(4), fx(5), fx(6)))
    world = world_set_scale(world, spawned.id, vec3(fx(2), fx(2), fx(2)))
    let position = world_position(world, spawned.id)
    same(position.x, fx(1))
    same(position.y, fx(2))
    same(position.z, fx(3))
    let velocity = world_velocity(world, spawned.id)
    same(velocity.x, fx(4))
    same(velocity.z, fx(6))
    same(world_scale(world, spawned.id).x, fx(2))
    same(world_transform(world, spawned.id).position.y, fx(2))

    let stale = EntityId { index: spawned.id.index, generation: spawned.id.generation + 1 }
    same(world_position(world, stale).x, 0)
    same(world_index(world, stale), 0 - 1)
}

@test
fn world_tick_integrates_and_snapshots() {
    var world = world_new(fx(1))
    let spawned = world_spawn(world, 1)
    world = spawned.world
    world = world_set_velocity(world, spawned.id, vec3(fx(1), 0, 0))
    let dt = fx_ratio(1, 60)
    same(dt, 1092)
    world = world_tick(world, dt)
    same(world_step(world), 1)
    assert(near(world_position(world, spawned.id).x, 1092, 4))
    // Gravity is one unit/s^2, so after one step vy is also one step of dt.
    assert(near(world_velocity(world, spawned.id).y, 1092, 4))
    assert(near(world_position(world, spawned.id).y, 18, 4))

    // Interpolation endpoints are exact: alpha 0 is the previous step.
    let at_start = world_lerp_position(world, spawned.id, 0)
    same(at_start.x, 0)
    let at_end = world_lerp_position(world, spawned.id, 65536)
    same(at_end.x, world_position(world, spawned.id).x)
    let halfway = world_lerp_position(world, spawned.id, 32768)
    assert(near(halfway.x, 546, 4))
}

@test
fn world_structural_changes_are_deferred() {
    var world = world_new(0)
    let doomed = world_spawn(world, 1)
    world = doomed.world

    world = world_request_spawn(world, 7)
    world = world_request_destroy(world, doomed.id)
    same(world_pending_count(world), 2)
    same(world_live_count(world), 1)

    // The step sees the entity set it started with: the dying entity is still
    // simulated, the new one does not exist yet.
    world = world_tick(world, fx_ratio(1, 60))
    same(world_live_count(world), 1)
    same(world_pending_count(world), 0)
    assert(!world_has(world, doomed.id))

    var found = 0 - 1
    var i = 0
    while i < world_capacity(world) {
        if world.pool.alive[i] {
            found = world.tags[i]
        }
        i = i + 1
    }
    same(found, 7)
}

@test
fn world_golden_trace_is_deterministic() {
    let first = trace_world()
    let second = trace_world()
    same(first, second)
    assert(first != 0)
}

fn trace_world() -> Int {
    var world = world_new(fx(9))
    var i = 0
    while i < 3 {
        let spawned = world_spawn(world, i + 1)
        world = spawned.world
        world = world_set_position(world, spawned.id, vec3(fx(i * 10), fx(100 - i * 20), 0))
        world = world_set_velocity(world, spawned.id, vec3(fx(i + 1), fx(4 - i), 0))
        i = i + 1
    }
    var s = 0
    while s < 600 {
        world = world_tick(world, fx_ratio(1, 60))
        s = s + 1
    }
    return world_trace_hash(world)
}

@test
fn world_thousand_entities_and_stale_handles() {
    var world = world_new(0)
    var i = 0
    while i < 1000 {
        let spawned = world_spawn(world, i)
        world = spawned.world
        i = i + 1
    }
    same(world_live_count(world), 1000)
    same(world_capacity(world), 1000)

    // Remove every even slot; every first-generation handle for those slots is
    // now stale, while odd slots keep working.
    var d = 0
    while d < 1000 {
        if d % 2 == 0 {
            world = world_despawn(world, EntityId { index: d, generation: 1 })
        }
        d = d + 1
    }
    same(world_live_count(world), 500)
    assert(!world_has(world, EntityId { index: 0, generation: 1 }))
    assert(world_has(world, EntityId { index: 1, generation: 1 }))
    same(world_tag(world, EntityId { index: 1, generation: 1 }), 1)

    // Reuse a freed slot: capacity must not grow and the old handle stays dead.
    let reused = world_spawn(world, 99)
    world = reused.world
    same(world_capacity(world), 1000)
    same(world_live_count(world), 501)
    same(reused.id.generation, 2)
    assert(!world_has(world, EntityId { index: reused.id.index, generation: 1 }))
    same(world_tag(world, reused.id), 99)
}

// ---------- scene regression ----------

@test
fn scene_tick_applies_gravity() {
    var world = scene_new(30)
    world = scene_spawn(world, "floor", "solid", 400, 590, 800, 20, 0, true, 0)
    world = scene_spawn(world, "crate", "demo", 400, 120, 40, 40, 0, false, 0)
    same(scene_y(world, 2), 120)
    var i = 0
    while i < 120 {
        world = scene_tick(world)
        i = i + 1
    }
    assert(scene_y(world, 2) > 120)
    assert(scene_y(world, 2) < 570)
}

@test
fn scene_mutations_persist() {
    var world = scene_new(0)
    world = scene_spawn(world, "orb", "orb", 100, 100, 10, 10, 0, false, 0)
    world = scene_set_position(world, 1, 200, 150)
    same(scene_x(world, 1), 200)
    same(scene_y(world, 1), 150)
    world = scene_set_velocity(world, 1, 7, 0 - 7)
    same(world.vxs[0], 7)
    same(world.vys[0], 0 - 7)
    world = scene_set_solid(world, 1, true)
    assert(world.solids[0])
}
