import std.io { println }
import "../../../libraries/nova-gui/src/gui.nova" as gui
import "../../../libraries/nova-game/src/engine.nova"

// Nova Breakout, drawn by nova-gui. The engine owns the simulation; this file
// owns input and pixels. One frame is one 16 ms tick, so physics is fixed-step.
//
// Movement is driven by held keys, not by key repeats: the host reports key-up,
// so `hold` steers the target every tick. A tap still moves a little; a held
// arrow glides at full speed, exactly like the mouse.

fn window_w() -> Int {
    return 900
}

fn window_h() -> Int {
    return 700
}

fn field_x() -> Int {
    return 50
}

fn field_y() -> Int {
    return 112
}

fn transition_ticks() -> Int {
    return 150
}

struct App {
    game: Game,
    target: Int,
    quit: Bool,
    screen: String,
    pick: Int,
    hold: Int,
    muted: Bool,
    flash: Int,
}

fn tune(app: App, game: Game) -> App {
    return App {
        game: game,
        target: app.target,
        quit: app.quit,
        screen: app.screen,
        pick: app.pick,
        hold: app.hold,
        muted: app.muted,
        flash: app.flash,
    }
}

fn set_target(app: App, target: Int) -> App {
    return App {
        game: app.game,
        target: target,
        quit: app.quit,
        screen: app.screen,
        pick: app.pick,
        hold: app.hold,
        muted: app.muted,
        flash: app.flash,
    }
}

fn set_screen(app: App, screen: String) -> App {
    return App {
        game: app.game,
        target: app.target,
        quit: app.quit,
        screen: screen,
        pick: app.pick,
        hold: 0,
        muted: app.muted,
        flash: app.flash,
    }
}

fn set_pick(app: App, pick: Int) -> App {
    return App {
        game: app.game,
        target: app.target,
        quit: app.quit,
        screen: app.screen,
        pick: pick,
        hold: app.hold,
        muted: app.muted,
        flash: app.flash,
    }
}

fn set_hold(app: App, hold: Int) -> App {
    return App {
        game: app.game,
        target: app.target,
        quit: app.quit,
        screen: app.screen,
        pick: app.pick,
        hold: hold,
        muted: app.muted,
        flash: app.flash,
    }
}

fn set_mute(app: App, muted: Bool) -> App {
    return App {
        game: app.game,
        target: app.target,
        quit: app.quit,
        screen: app.screen,
        pick: app.pick,
        hold: app.hold,
        muted: muted,
        flash: app.flash,
    }
}

fn set_flash(app: App, flash: Int) -> App {
    return App {
        game: app.game,
        target: app.target,
        quit: app.quit,
        screen: app.screen,
        pick: app.pick,
        hold: app.hold,
        muted: app.muted,
        flash: flash,
    }
}

fn start_level(app: App, level: Int) -> App {
    var out = tune(app, level_game(level, 0, 3))
    out = set_target(out, 400)
    out = set_screen(out, "play")
    out = set_pick(out, level)
    out = set_hold(out, 0)
    return set_flash(out, 0)
}

fn restart(app: App) -> App {
    return start_level(app, app.game.level)
}

fn quit(app: App) -> App {
    var out = set_screen(app, app.screen)
    out = set_hold(out, 0)
    return App {
        game: out.game,
        target: out.target,
        quit: true,
        screen: out.screen,
        pick: out.pick,
        hold: 0,
        muted: out.muted,
        flash: out.flash,
    }
}

fn with_target(app: App, target: Int) -> App {
    var next = target
    if next < 50 {
        next = 50
    }
    if next > field_width() - 50 {
        next = field_width() - 50
    }
    return set_target(app, next)
}

// Space and a click mean "the obvious next thing".
fn action(app: App) -> App {
    if app.screen == "menu" {
        return start_level(app, app.pick)
    }
    if app.screen == "pause" {
        return set_screen(app, "play")
    }
    if app.game.status == 0 {
        return tune(app, launch(app.game))
    }
    if app.game.status == 2 {
        let advanced = next_level(app.game)
        var out = tune(app, advanced)
        out = set_target(out, 400)
        out = set_pick(out, advanced.level)
        return set_flash(out, 0)
    }
    if app.game.status == 3 {
        return restart(app)
    }
    return app
}

fn key_menu(app: App, code: Int) -> App {
    if code == gui.key_left() || code == 97 {
        var pick = app.pick - 1
        if pick < 0 {
            pick = level_count() - 1
        }
        var out = tune(app, launch(level_game(pick, 0, 3)))
        return set_pick(out, pick)
    }
    if code == gui.key_right() || code == 100 {
        var pick = app.pick + 1
        if pick >= level_count() {
            pick = 0
        }
        var out = tune(app, launch(level_game(pick, 0, 3)))
        return set_pick(out, pick)
    }
    if code == 32 || code == gui.key_enter() {
        return action(app)
    }
    if code == gui.key_escape() {
        return quit(app)
    }
    return app
}

fn key_pause(app: App, code: Int) -> App {
    if code == 32 || code == 112 {
        return set_screen(app, "play")
    }
    if code == 114 {
        return restart(app)
    }
    if code == 109 {
        return set_screen(app, "menu")
    }
    if code == gui.key_escape() {
        return set_screen(app, "menu")
    }
    return app
}

fn key_play(app: App, code: Int) -> App {
    // Esc is the way out: menu first, quit only from the menu.
    if code == gui.key_escape() {
        return set_screen(app, "menu")
    }
    if code == 112 {
        return set_screen(app, "pause")
    }
    if code == 32 {
        return action(app)
    }
    if code == 114 {
        return restart(app)
    }
    if code == 109 {
        let muted = !app.muted
        if !muted {
            gui.sound(620, 40, 30)
        }
        return set_mute(app, muted)
    }
    if code == 97 || code == gui.key_left() {
        return set_hold(with_target(app, app.target - 20), -1)
    }
    if code == 100 || code == gui.key_right() {
        return set_hold(with_target(app, app.target + 20), 1)
    }
    if code == gui.key_home() {
        return with_target(app, 50)
    }
    if code == gui.key_end() {
        return with_target(app, field_width() - 50)
    }
    return app
}

fn key(app: App, code: Int, mods: Int) -> App {
    let command = mods % 2 == 1
    if command && code == 113 {
        return quit(app)
    }
    if app.screen == "menu" {
        return key_menu(app, code)
    }
    if app.screen == "pause" {
        return key_pause(app, code)
    }
    return key_play(app, code)
}

// Release stops the glide. Releasing the direction that is not held leaves the
// other direction intact, so tapping both keys cannot leave the paddle running.
fn key_release(app: App, code: Int) -> App {
    if code == gui.key_left() || code == 97 {
        if app.hold < 0 {
            return set_hold(app, 0)
        }
    }
    if code == gui.key_right() || code == 100 {
        if app.hold > 0 {
            return set_hold(app, 0)
        }
    }
    return app
}

// Applied once per tick before the simulation: holding a direction slides the
// target, and the engine's easing turns that into constant paddle motion.
fn held_step(app: App) -> App {
    if app.screen != "play" || app.hold == 0 {
        return app
    }
    return with_target(app, app.target + app.hold * 20)
}

fn handle(app: App, event: gui.Event) -> App {
    if event.kind == gui.event_key() {
        return key(app, event.code, event.mods)
    }
    if event.kind == gui.event_key_up() {
        return key_release(app, event.code)
    }
    if event.kind == gui.event_close() {
        return quit(app)
    }
    if event.kind == gui.event_mouse_move() || event.kind == gui.event_drag() {
        if app.screen == "play" {
            return with_target(app, event.x - field_x())
        }
        return app
    }
    if event.kind == gui.event_mouse_down() {
        if app.screen == "play" {
            return action(with_target(app, event.x - field_x()))
        }
        return action(app)
    }
    return app
}

// Sound follows the simulation, not the input: one tone per material event,
// compared across the tick. The app stays silent while muted.
fn sfx(prev: Game, next: Game, muted: Bool) {
    if muted {
        return
    }
    if prev.status == 0 && next.status == 1 {
        gui.sound(720, 60, 38)
    }
    if next.score > prev.score {
        let step = next.score / 10
        gui.sound(760 + step % 5 * 70, 42, 36)
    }
    if next.paddle_hits > prev.paddle_hits {
        gui.sound(420, 38, 30)
    }
    if ball_count(next) > ball_count(prev) {
        gui.sound(980, 70, 44)
        gui.sound(1320, 90, 32)
    }
    if prev.caps_alive && !next.caps_alive && next.lives >= prev.lives {
        gui.sound(1180, 90, 44)
    }
    if next.lives < prev.lives {
        gui.sound(170, 220, 58)
    }
    if next.status == 2 && prev.status != 2 {
        gui.sound(660, 150, 48)
        gui.sound(880, 170, 44)
        gui.sound(1320, 240, 38)
    }
    if next.status == 3 && prev.status != 3 {
        gui.sound(150, 320, 58)
    }
}

// One tick of play: simulate, start the wipe on a clear, and hand off to the
// next level on the tick the wipe ends.
fn tick_app(app: App) -> App {
    if app.screen != "play" {
        return app
    }
    let before = app.game
    let after = step(before, app.target)
    var flash = app.flash
    if before.status != 2 && after.status == 2 {
        flash = transition_ticks()
    }
    var game = after
    if flash > 0 {
        flash = flash - 1
        if flash == 0 && game.status == 2 {
            game = next_level(game)
        }
    }
    sfx(before, after, app.muted)
    var out = tune(app, game)
    return set_flash(out, flash)
}

// Attract mode: the menu runs the real engine, steered by the ball's own x.
fn menu_tick(app: App) -> App {
    if app.screen != "menu" {
        return app
    }
    var game = app.game
    if game.status != 1 {
        game = launch(level_game(app.pick, 0, 3))
    }
    game = step(game, ball_px_x(game) + 24)
    if game.status != 1 {
        game = launch(level_game(app.pick, 0, 3))
    }
    return tune(app, game)
}

fn brick_color(row: Int, theme: gui.Theme) -> Int {
    let index = brick_colour(row)
    if index == 0 {
        return theme.red
    }
    if index == 1 {
        return theme.orange
    }
    if index == 2 {
        return theme.yellow
    }
    if index == 3 {
        return theme.green
    }
    if index == 4 {
        return theme.aqua
    }
    return theme.purple
}

fn centered(y: Int, value: String, size: Int, color: Int) {
    let width = gui.text_width(value, size)
    gui.text((window_w() - width) / 2, y, value, size, color)
}

fn draw_brand(theme: gui.Theme) {
    gui.text(24, 26, "NOVA", 20, theme.fg_bright)
    let brand_x = 24 + gui.text_width("NOVA", 20) + 10
    gui.text(brand_x, 26, "BREAKOUT", 20, theme.accent)
    gui.text(24, 56, "levels · power-ups · multiball · swept physics", 11, theme.faint)
}

fn draw_hud(game: Game, theme: gui.Theme) {
    let level_text = "LEVEL ${game.level + 1}/${level_count()} · ${level_name(game.level)}"
    gui.text(24, 74, level_text, 11, theme.muted)

    let pace_text = "score ${game.score}   rally ${game.rally}   ${ball_pace(game)} px/tick"
    gui.text(window_w() - 24 - gui.text_width(pace_text, 13), 30, pace_text, 13, theme.fg)

    var hearts = ""
    var heart = 0
    while heart < game.lives {
        hearts = hearts + "♥ "
        heart = heart + 1
    }
    gui.text(window_w() - 24 - gui.text_width(hearts, 13), 54, hearts, 13, theme.red)

    var chips_x = window_w() - 24
    if ball_count(game) > 1 {
        let chip = "×${ball_count(game)} BALLS"
        chips_x = chips_x - gui.text_width(chip, 11) - 12
        gui.text(chips_x, 76, chip, 11, theme.purple)
    }
    if game.slow > 0 {
        let chip = "SLOW ${game.slow / 60}s"
        chips_x = chips_x - gui.text_width(chip, 11) - 12
        gui.text(chips_x, 76, chip, 11, theme.aqua)
    }
    if game.wide > 0 {
        let chip = "WIDE ${game.wide / 60}s"
        chips_x = chips_x - gui.text_width(chip, 11) - 12
        gui.text(chips_x, 76, chip, 11, theme.green)
    }
}

fn draw_bricks(game: Game, theme: gui.Theme) {
    var row = 0
    while row < brick_rows() {
        var column = 0
        while column < brick_cols() {
            let index = row * brick_cols() + column
            if game.bricks[index] == 1 {
                let x = field_x() + brick_x(column)
                let y = field_y() + brick_y(row)
                let color = brick_color(row, theme)
                gui.round_rect(x, y + 4, brick_w(), brick_h(), 6, theme.bg_hard)
                gui.round_rect(x, y, brick_w(), brick_h(), 6, color)
                gui.rect_alpha(x + 5, y + 3, brick_w() - 10, 5, gui.white(), 55)
                gui.rect_alpha(x + 5, y + brick_h() - 6, brick_w() - 10, 3, theme.bg, 70)
            }
            column = column + 1
        }
        row = row + 1
    }
}

fn capsule_color(kind: Int, theme: gui.Theme) -> Int {
    if kind == 1 {
        return theme.green
    }
    if kind == 2 {
        return theme.aqua
    }
    if kind == 4 {
        return theme.purple
    }
    return theme.red
}

fn draw_capsule(game: Game, theme: gui.Theme) {
    if !game.caps_alive {
        return
    }
    let size = capsule_size()
    let half = size / 2
    let x = field_x() + game.caps_x
    let y = field_y() + game.caps_y
    let color = capsule_color(game.caps_kind, theme)
    gui.round_rect(x - half - 3, y - half - 3, size + 6, size + 6, 8, theme.selection)
    gui.round_rect(x - half, y - half, size, size, 6, color)
    var label = "♥"
    if game.caps_kind == 1 {
        label = "W"
    }
    if game.caps_kind == 2 {
        label = "S"
    }
    if game.caps_kind == 4 {
        label = "×2"
    }
    let width = gui.text_width(label, 12)
    gui.text(x - width / 2, y - 9, label, 12, theme.bg)
}

fn draw_ball_at(bx: Int, by: Int, theme: gui.Theme) {
    let radius = ball_size() / 2
    gui.round_rect(bx - radius - 4, by - radius - 4, radius * 2 + 8, radius * 2 + 8, radius + 4, theme.selection)
    gui.round_rect(bx - radius - 2, by - radius - 2, radius * 2 + 4, radius * 2 + 4, radius + 2, gui.rgb(220, 240, 255))
    gui.round_rect(bx - radius, by - radius, radius * 2, radius * 2, radius, gui.white())
}

fn draw_balls(game: Game, theme: gui.Theme) {
    var i = 0
    while i < ball_count(game) {
        draw_ball_at(field_x() + ball_px_x_at(game, i), field_y() + ball_px_y_at(game, i), theme)
        i = i + 1
    }
}

fn draw_paddle(game: Game, theme: gui.Theme) {
    let width = paddle_width_of(game)
    let px = field_x() + game.paddle - width / 2
    let py = field_y() + paddle_y()
    var color = theme.accent
    if game.wide > 0 {
        color = theme.blue
    }
    gui.round_rect(px, py + 4, width, paddle_height(), 9, theme.bg_hard)
    gui.round_rect(px, py, width, paddle_height(), 9, color)
    gui.rect_alpha(px + 8, py + 3, width - 16, 4, gui.white(), 110)
    gui.rect_alpha(px + width / 2 - 1, py + 6, 2, paddle_height() - 10, gui.white(), 60)
}

fn draw_field(game: Game, theme: gui.Theme) {
    gui.round_rect(field_x() - 14, field_y() - 14, field_width() + 28, field_height() + 28, 12, theme.panel)
    gui.stroke(field_x() - 14, field_y() - 14, field_width() + 28, field_height() + 28, theme.border_strong)
    draw_bricks(game, theme)
    draw_capsule(game, theme)
    draw_paddle(game, theme)
    if game.status != 2 && game.status != 3 {
        draw_balls(game, theme)
    }
}

// The wipe sweeps left to right over 150 ticks; the tick that finishes it also
// calls next_level, so what is drawn and what is simulated cannot drift apart.
fn draw_transition(app: App, theme: gui.Theme) {
    if app.flash <= 0 {
        return
    }
    let total = transition_ticks()
    let progress = total - app.flash
    let band = field_x() + progress * field_width() / total
    let mid = field_y() + field_height() / 2
    gui.rect_alpha(field_x(), field_y(), field_width(), field_height(), theme.bg, 120)
    gui.rect_alpha(band, field_y(), 90, field_height(), theme.fg_bright, 50)
    gui.rect_alpha(band + 90, field_y(), 16, field_height(), theme.accent, 90)
    centered(mid - 30, "LEVEL ${app.game.level + 1} CLEARED", 26, theme.green)
    centered(mid + 8, "${app.game.score} points · next level incoming", 12, theme.muted)
}

fn draw_overlay(game: Game, theme: gui.Theme) {
    let mid = field_y() + field_height() / 2
    if game.status == 0 {
        centered(mid - 20, "SPACE OR CLICK TO LAUNCH", 18, theme.fg_bright)
        centered(mid + 10, "hold a direction to slide the paddle", 12, theme.muted)
    }
    if game.status == 3 {
        centered(mid - 24, "GAME OVER", 26, theme.red)
        centered(mid + 14, "space retries this level", 12, theme.muted)
    }
}

fn draw_play(app: App) {
    let theme = gui.dark()
    gui.clear(theme.bg)
    draw_brand(theme)
    draw_hud(app.game, theme)
    draw_field(app.game, theme)
    draw_transition(app, theme)
    draw_overlay(app.game, theme)
    var sound = "M sound on"
    if app.muted {
        sound = "M sound off"
    }
    let hint = "← → or A D hold to move   ·   mouse aims   ·   space launch   ·   P pause   ·   Esc menu   ·   ${sound}   ·   R restart   ·   ⌘Q quit"
    gui.text((window_w() - gui.text_width(hint, 11)) / 2, window_h() - 34, hint, 11, theme.faint)
}

fn menu_brick(x: Int, y: Int, color: Int, theme: gui.Theme) {
    gui.round_rect(x, y + 3, 96, 26, 6, theme.bg_hard)
    gui.round_rect(x, y, 96, 26, 6, color)
    gui.rect_alpha(x + 6, y + 3, 84, 5, gui.white(), 50)
}

// The menu is translucent: the attract game plays behind the title so the
// shooting demo is real code, not a canned animation.
fn draw_menu(app: App) {
    let theme = gui.dark()
    gui.clear(theme.bg)
    draw_field(app.game, theme)
    gui.rect_alpha(0, 0, window_w(), window_h(), theme.bg, 214)

    gui.text(24, 26, "NOVA GAME ENGINE", 11, theme.faint)
    gui.text(window_w() - 24 - gui.text_width("DEMO · AI PADDLE", 10), 26, "DEMO · AI PADDLE", 10, theme.faint)

    let title_y = 86
    let title = "BREAKOUT"
    let title_size = 46
    let title_width = gui.text_width(title, title_size)
    let nova_width = gui.text_width("NOVA ", title_size)
    let start_x = (window_w() - title_width - nova_width) / 2
    gui.text(start_x, title_y, "NOVA", title_size, theme.fg_bright)
    gui.text(start_x + nova_width, title_y, title, title_size, theme.accent)
    centered(title_y + 62, "colour, levels, power-ups and multiball on the Nova engine", 13, theme.muted)

    let gap = 12
    let brick_w_menu = 96
    let row_w = 7 * brick_w_menu + 6 * gap
    let left = (window_w() - row_w) / 2
    var row = 0
    while row < 3 {
        var column = 0
        while column < 7 {
            let x = left + column * (brick_w_menu + gap)
            let y = 206 + row * 36
            menu_brick(x, y, brick_color(row + column % 3, theme), theme)
            column = column + 1
        }
        row = row + 1
    }

    let name = level_name(app.pick)
    let label = "LEVEL ${app.pick + 1}  ·  ${name}"
    let label_width = gui.text_width(label, 20)
    gui.text((window_w() - label_width) / 2, 344, label, 20, theme.fg_bright)
    gui.text((window_w() - label_width) / 2 - 30, 346, "◀", 18, theme.faint)
    gui.text((window_w() + label_width) / 2 + 12, 346, "▶", 18, theme.faint)

    let dots = level_count()
    let dot_gap = 18
    let dots_left = (window_w() - (dots * 8 + (dots - 1) * dot_gap)) / 2
    var dot = 0
    while dot < dots {
        var dot_color = theme.border_strong
        if dot == app.pick {
            dot_color = theme.accent
        }
        gui.round_rect(dots_left + dot * (8 + dot_gap), 384, 8, 8, 4, dot_color)
        dot = dot + 1
    }

    centered(436, "SPACE OR CLICK TO PLAY", 18, theme.fg_bright)
    centered(466, "◀ ▶ or A D pick a level", 12, theme.muted)

    let hint = "A D or arrows move   ·   mouse aims   ·   click launches   ·   Esc quits   ·   ⌘Q quits"
    gui.text((window_w() - gui.text_width(hint, 11)) / 2, window_h() - 34, hint, 11, theme.faint)
}

fn draw_pause(app: App) {
    let theme = gui.dark()
    gui.clear(theme.bg)
    draw_brand(theme)
    draw_hud(app.game, theme)
    draw_field(app.game, theme)
    gui.rect_alpha(field_x() - 14, field_y() - 14, field_width() + 28, field_height() + 28, theme.bg, 190)
    let mid = field_y() + field_height() / 2
    centered(mid - 46, "PAUSED", 30, theme.fg_bright)
    centered(mid + 4, "space or P resumes", 13, theme.muted)
    centered(mid + 28, "R restarts this level   ·   Esc or M returns to the menu", 12, theme.faint)
    gui.text((window_w() - gui.text_width("⌘Q quits", 11)) / 2, window_h() - 34, "⌘Q quits", 11, theme.faint)
}

fn draw(app: App) {
    if app.screen == "menu" {
        draw_menu(app)
        return
    }
    if app.screen == "pause" {
        draw_pause(app)
        return
    }
    draw_play(app)
}

fn simulate(ticks: Int, follow: Bool, mode: String) -> App {
    var app = App {
        game: new_game(),
        target: 400,
        quit: false,
        screen: "play",
        pick: 0,
        hold: 0,
        muted: true,
        flash: 0,
    }
    app = tune(app, launch(level_game(0, 0, 3)))
    var i = 0
    while i < ticks {
        if mode == "balls" && ball_count(app.game) > 1 {
            break
        }
        if mode != "balls" && app.game.caps_alive {
            break
        }
        var target = app.target
        if follow {
            target = ball_px_x(app.game)
        }
        app = tune(app, step(app.game, target))
        app = set_target(app, target)
        i = i + 1
    }
    if mode == "balls" {
        app = tune(app, multiball(app.game))
        var settle = 0
        while settle < 18 {
            app = tune(app, step(app.game, app.target))
            settle = settle + 1
        }
    }
    if mode == "clear" {
        app = tune(app, clear_board(app.game))
        app = set_flash(app, 110)
    }
    return app
}

fn main() {
    // Headless check for held-key steering: no window, just the tick pipeline
    // the game runs, so the glide can be measured instead of eyeballed.
    let hold_check = gui.env("NOVA_BREAKOUT_HOLD")
    if hold_check.len() > 0 {
        var check = App {
            game: launch(new_game()),
            target: 400,
            quit: false,
            screen: "play",
            pick: 0,
            hold: 1,
            muted: true,
            flash: 0,
        }
        var positions = ""
        var tick = 0
        while tick < 24 {
            check = held_step(check)
            let next = tick_app(check)
            check = next
            positions = positions + " ${check.game.paddle}"
            tick = tick + 1
        }
        println("hold:${positions}")
        return
    }
    let shot = gui.env("NOVA_BREAKOUT_SHOT")
    if shot.len() > 0 {
        let screen = gui.env("NOVA_BREAKOUT_SCREEN")
        var mode = "play"
        if screen == "balls" || screen == "clear" {
            mode = screen
        }
        var app = simulate(6000, true, mode)
        if screen == "menu" {
            app = set_screen(app, "menu")
        }
        if screen == "pause" {
            app = set_screen(app, "pause")
        }
        if gui.open("Nova Breakout", window_w(), window_h()) {
            gui.begin()
            draw(app)
            gui.present()
            let saved = gui.save_png(shot)
            println("breakout-gui: saved=${saved} screen=${app.screen} level=${app.game.level} balls=${ball_count(app.game)} bricks=${bricks_left(app.game)} score=${app.game.score} flash=${app.flash}")
            gui.close()
        }
        return
    }
    if !gui.open("Nova Breakout", window_w(), window_h()) {
        println("breakout-gui: could not open a window")
        return
    }
    var app = App {
        game: new_game(),
        target: 400,
        quit: false,
        screen: "menu",
        pick: 0,
        hold: 0,
        muted: false,
        flash: 0,
    }
    while !app.quit && gui.is_open() {
        var event = gui.next_event()
        while event.kind != gui.event_none() {
            app = handle(app, event)
            event = gui.next_event()
        }
        if app.screen == "menu" {
            app = menu_tick(app)
        }
        if app.screen == "play" {
            app = held_step(app)
            app = tick_app(app)
        }
        gui.begin()
        draw(app)
        gui.present()
        gui.sleep(16)
    }
    gui.close()
}
