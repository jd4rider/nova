import std.io { println }
import "../../../libraries/nova-game/src/engine.nova"
import "../../../libraries/nova-game/src/physics.nova"
import "../../../libraries/nova-engine/src/scene.nova"

// A deterministic physics lab: every scenario runs the same on every machine,
// because positions and velocities are integers in millipixels.

fn report(ok: Bool, name: String) -> Int {
    if ok {
        println("PASS " + name)
        return 0
    }
    println("FAIL " + name)
    return 1
}

fn main() {
    var failures = 0

    var falling = ph_with_velocity(ph_body(100, 100, 10, 10), 0, 0)
    var i = 0
    while i < 60 {
        falling = ph_advance(ph_gravity(falling, 5))
        i = i + 1
    }
    failures = failures + report(falling.y > 100000, "gravity accelerates a free body")
    failures = failures + report(falling.vy > 0, "gravity gives downward velocity")

    let floor = ph_solid(0, 480, 800, 40)
    var ball = ph_with_velocity(ph_body(400, 100, 16, 16), 0, 12000)
    var bounced = false
    i = 0
    while i < 200 {
        ball = ph_resolve(ball, floor)
        if ball.vy < 0 {
            bounced = true
        }
        i = i + 1
    }
    failures = failures + report(bounced, "a ball bounces off the floor")
    failures = failures + report(ball.y < 480000, "the ball stays above the floor")

    let thin = ph_solid(400, 0, 4, 600)
    let fast = ph_with_velocity(ph_body(350, 300, 16, 16), 60000, 0)
    failures = failures + report(ph_sweep(fast, thin) < ph_miss(), "a fast body sees a thin wall")
    let stopped = ph_resolve(fast, thin)
    failures = failures + report(stopped.x < 400000, "a fast body cannot tunnel")

    var soft = ph_with_velocity(ph_with_bounce(ph_body(290, 100, 10, 10), 50), 10000, 0)
    let wall = ph_solid(300, 0, 10, 400)
    soft = ph_resolve(soft, wall)
    failures = failures + report(soft.vx == -5000, "restitution halves the speed")

    var game = launch(new_game())
    var steps = 0
    var escapes = 0
    while steps < 4000 && game.status == 1 {
        game = step(game, ball_px_x(game))
        if ball_px_x(game) < 0 || ball_px_x(game) > field_width() || ball_px_y(game) < 0 {
            escapes = escapes + 1
        }
        steps = steps + 1
    }
    failures = failures + report(game.score > 0, "paddle play destroys bricks")
    failures = failures + report(escapes == 0, "the ball stays inside the field")
    failures = failures + report(game.score == (brick_count() - bricks_left(game)) * 10, "score matches the bricks removed")
    failures = failures + report(game.vy != 0, "the ball keeps moving")

    let lvl = level_game(1, 0, 3)
    failures = failures + report(bricks_left(lvl) < brick_count(), "level 1 is not a full grid")
    failures = failures + report(level_count() >= 4, "four levels exist")
    failures = failures + report(bricks_left(level_game(0, 0, 3)) == brick_count(), "level 0 is a full grid")

    var drop = launch(level_game(0, 0, 3))
    var seen_capsule = false
    var drop_steps = 0
    while drop_steps < 4000 && !seen_capsule {
        drop = step(drop, ball_px_x(drop))
        if drop.caps_alive {
            seen_capsule = true
        }
        drop_steps = drop_steps + 1
    }
    failures = failures + report(seen_capsule, "bricks drop power-up capsules")

    let eased = step(level_game(0, 0, 3), 800)
    failures = failures + report(eased.paddle - 400 <= paddle_speed(), "the paddle eases toward its target")

    var world = scene_new(30)
    world = scene_spawn(world, "floor", "solid", 400, 590, 800, 20, 0, true)
    world = scene_spawn(world, "crate", "demo", 400, 120, 40, 40, 0, false)
    failures = failures + report(scene_count(world) == 2, "the scene spawns entities")
    var ticks = 0
    while ticks < 240 {
        world = scene_tick(world)
        ticks = ticks + 1
    }
    failures = failures + report(scene_y(world, 2) > 120, "scene gravity moves a dynamic entity")
    failures = failures + report(scene_y(world, 2) < 570, "a solid entity stops it")

    let total = 17
    println("")
    println("passed " + "${total - failures}" + ", failed " + "${failures}")
    if failures > 0 {
        println("physics-lab: FAILED")
    }
}
