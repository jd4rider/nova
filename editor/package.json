{
  "name": "nova-studio",
  "version": "0.1.0",
  "description": "Nova Studio — native IDE for the Nova programming language",
  "main": "./out/main/index.js",
  "private": true,
  "license": "UNLICENSED",
  "author": "Jonathan Forrider",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --arm64 --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never --config.npmRebuild=false --config.win.signAndEditExecutable=false",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "monaco-editor": "0.52.2",
    "monaco-vim": "0.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.3.0",
    "electron-builder": "25.1.8",
    "electron-vite": "3.0.0",
    "typescript": "5.7.2",
    "vite": "6.0.7"
  },
  "optionalDependencies": {
    "node-pty": "1.0.0"
  },
  "build": {
    "appId": "dev.nova.studio",
    "productName": "Nova Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        },
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ],
      "artifactName": "Nova-Studio-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Nova Studio ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Nova-Studio-${version}-${arch}-setup.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nova Studio"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  }
}
