import std.io { println }
import "../../../libraries/nova-gui/src/gui.nova" as gui
import "../../engines/webkit/src/engine.nova" as engine
import "../../address/src/address.nova" as address_edit
import "../../history/src/history.nova" as library
import "../../status/src/status.nova" as status
import "../../../libraries/nova-speech/src/speech.nova" as speech

// The Nova Browser shell. Nova owns the window, tabs, toolbar, address
// autocomplete, history/bookmarks and engine lifecycle. Each tab owns one
// WKWebView. WebKit owns the page document and rendering; there is no hidden
// Chromium/Electron path.
//
// Chrome is drawn every frame into the Nova framebuffer, with hover and focus
// energies eased toward their targets against a monotonic clock. The native
// page view sits on top of the page rectangle and is hidden while a failure
// panel is showing, so a blocked load never leaves a stale page behind it.

struct Chrome {
    bg_hard: Int,
    panel: Int,
    border: Int,
    border_strong: Int,
    fg: Int,
    fg_bright: Int,
    muted: Int,
    faint: Int,
    input: Int,
    elevated: Int,
    orange: Int,
    red: Int,
    green: Int,
    yellow: Int,
    selection: Int,
}

struct Address {
    editing: Bool,
    text: String,
    cursor: Int,
    // The other end of the selection. `anchor == cursor` means no selection;
    // keeping the anchor lets a double-click select a word and typing replace
    // exactly that word instead of only knowing "everything is selected".
    anchor: Int,
    error: String,
    highlight: Int,
}

struct Tab {
    handle: Int,
    url: String,
    fixture: Bool,
    title: String,
}

struct ClosedTab {
    url: String,
    fixture: Bool,
}

struct Session {
    tabs: List<Tab>,
    active: Int,
    closed: List<ClosedTab>,
    vertical: Bool,
    // A collapsed vertical sidebar: a narrow rail that opens its names as an
    // overlay while the pointer is on it, so revealing them never resizes the
    // page or WebKit.
    rail: Bool,
    seen: String,
}

struct Store {
    visits: List<String>,
    bookmarks: List<String>,
    history_path: String,
    bookmarks_path: String,
    settings_path: String,
    session_path: String,
    search: String,
    theme: String,
    downloads_open: Bool,
    downloads_path: String,
    download_history: List<String>,
    dirty_downloads: Bool,
    dirty_visits: Bool,
    dirty_bookmarks: Bool,
}

struct Fx {
    slots: List<Int>,
    focus: Int,
}

struct Notice {
    text: String,
    until: Int,
}

struct Box {
    x: Int,
    y: Int,
    w: Int,
    h: Int,
}

struct Tooltip {
    text: String,
    x: Int,
    y: Int,
}

struct Downloads {
    rows: List<String>,
}

struct Toolbar {
    back: Int,
    forward: Int,
    reload: Int,
    address: Int,
    address_w: Int,
    voice: Int,
    star: Int,
    downloads: Int,
    docs: Int,
    layout: Int,
    label: Int,
}

// `reader` is the reader panel delta: 1 opens it, -1 closes it, 0 leaves it.
// `fetch` starts the voice-model download (0 or 1). Keeping the deltas here
// means the loop owns the panel state without threading it through every
// action constructor.
struct ClickAction {
    session: Session,
    address: Address,
    store: Store,
    notice: Notice,
    reader: Int,
    fetch: Int,
}

struct KeyAction {
    session: Session,
    address: Address,
    store: Store,
    notice: Notice,
    close: Bool,
    reader: Int,
}

struct Imported {
    store: Store,
    message: String,
}

fn gruvbox_theme() -> Chrome {
    let theme = gui.gruvbox()
    return Chrome {
        bg_hard: theme.bg_hard,
        panel: theme.panel,
        border: theme.border,
        border_strong: theme.border_strong,
        fg: theme.fg,
        fg_bright: theme.fg_bright,
        muted: theme.muted,
        faint: theme.faint,
        input: theme.input,
        elevated: theme.elevated,
        orange: theme.orange,
        red: theme.red,
        green: theme.green,
        yellow: theme.yellow,
        selection: theme.selection,
    }
}

// Gruvbox stays the default; these are the built-ins a shortcut can cycle to.
fn theme_named(name: String) -> Chrome {
    if name == "midnight" {
        return Chrome {
            bg_hard: gui.rgb(15, 18, 26),
            panel: gui.rgb(22, 26, 37),
            border: gui.rgb(38, 44, 60),
            border_strong: gui.rgb(58, 66, 88),
            fg: gui.rgb(200, 210, 230),
            fg_bright: gui.rgb(235, 242, 255),
            muted: gui.rgb(140, 152, 175),
            faint: gui.rgb(110, 122, 145),
            input: gui.rgb(18, 22, 32),
            elevated: gui.rgb(30, 36, 50),
            orange: gui.rgb(122, 162, 247),
            red: gui.rgb(247, 118, 142),
            green: gui.rgb(158, 206, 106),
            yellow: gui.rgb(224, 175, 104),
            selection: gui.rgb(51, 66, 102),
        }
    }
    if name == "light" {
        return Chrome {
            bg_hard: gui.rgb(245, 243, 240),
            panel: gui.rgb(235, 232, 227),
            border: gui.rgb(215, 211, 205),
            border_strong: gui.rgb(190, 185, 178),
            fg: gui.rgb(60, 56, 54),
            fg_bright: gui.rgb(30, 28, 27),
            muted: gui.rgb(112, 105, 100),
            faint: gui.rgb(140, 133, 127),
            input: gui.rgb(250, 249, 247),
            elevated: gui.rgb(225, 221, 215),
            orange: gui.rgb(214, 93, 14),
            red: gui.rgb(200, 50, 40),
            green: gui.rgb(120, 140, 30),
            yellow: gui.rgb(180, 140, 20),
            selection: gui.rgb(205, 200, 190),
        }
    }
    if name == "solarized" {
        return Chrome {
            bg_hard: gui.rgb(253, 246, 227),
            panel: gui.rgb(238, 232, 213),
            border: gui.rgb(213, 206, 186),
            border_strong: gui.rgb(181, 173, 153),
            fg: gui.rgb(88, 110, 117),
            fg_bright: gui.rgb(7, 54, 66),
            muted: gui.rgb(147, 161, 161),
            faint: gui.rgb(168, 180, 180),
            input: gui.rgb(255, 252, 240),
            elevated: gui.rgb(226, 220, 201),
            orange: gui.rgb(203, 75, 22),
            red: gui.rgb(220, 50, 47),
            green: gui.rgb(133, 153, 0),
            yellow: gui.rgb(181, 137, 0),
            selection: gui.rgb(213, 206, 186),
        }
    }
    if name == "nova" {
        let theme = gui.dark()
        return Chrome {
            bg_hard: theme.bg_hard,
            panel: theme.panel,
            border: theme.border,
            border_strong: theme.border_strong,
            fg: theme.fg,
            fg_bright: theme.fg_bright,
            muted: theme.muted,
            faint: theme.faint,
            input: theme.input,
            elevated: theme.elevated,
            orange: theme.orange,
            red: theme.red,
            green: theme.green,
            yellow: theme.yellow,
            selection: theme.selection,
        }
    }
    return gruvbox_theme()
}

fn theme_label(name: String) -> String {
    if name == "midnight" {
        return "Midnight"
    }
    if name == "light" {
        return "Light"
    }
    if name == "solarized" {
        return "Solarized"
    }
    if name == "nova" {
        return "Nova Dark"
    }
    return "Gruvbox"
}

fn cycle_theme(current: String) -> String {
    if current == "gruvbox" {
        return "midnight"
    }
    if current == "midnight" {
        return "light"
    }
    if current == "light" {
        return "solarized"
    }
    if current == "solarized" {
        return "nova"
    }
    return "gruvbox"
}

fn hex_digit(ch: String) -> Int {
    if ch == "0" { return 0 }
    if ch == "1" { return 1 }
    if ch == "2" { return 2 }
    if ch == "3" { return 3 }
    if ch == "4" { return 4 }
    if ch == "5" { return 5 }
    if ch == "6" { return 6 }
    if ch == "7" { return 7 }
    if ch == "8" { return 8 }
    if ch == "9" { return 9 }
    if ch == "a" || ch == "A" { return 10 }
    if ch == "b" || ch == "B" { return 11 }
    if ch == "c" || ch == "C" { return 12 }
    if ch == "d" || ch == "D" { return 13 }
    if ch == "e" || ch == "E" { return 14 }
    if ch == "f" || ch == "F" { return 15 }
    return 0 - 1
}

fn parse_hex(text: String) -> Int {
    let chars = text.trim().chars()
    var start = 0
    if chars.len() > 0 && chars[0] == "#" {
        start = 1
    }
    if chars.len() - start != 6 {
        return 0 - 1
    }
    var value = 0
    var i = start
    while i < chars.len() {
        let digit = hex_digit(chars[i])
        if digit < 0 {
            return 0 - 1
        }
        value = value * 16 + digit
        i = i + 1
    }
    return value
}

fn with_color(base: Chrome, key: String, color: Int) -> Chrome {
    var next = base
    if key == "bg_hard" { next.bg_hard = color }
    if key == "panel" { next.panel = color }
    if key == "border" { next.border = color }
    if key == "border_strong" { next.border_strong = color }
    if key == "fg" { next.fg = color }
    if key == "fg_bright" { next.fg_bright = color }
    if key == "muted" { next.muted = color }
    if key == "faint" { next.faint = color }
    if key == "input" { next.input = color }
    if key == "elevated" { next.elevated = color }
    if key == "orange" { next.orange = color }
    if key == "red" { next.red = color }
    if key == "green" { next.green = color }
    if key == "yellow" { next.yellow = color }
    if key == "selection" { next.selection = color }
    return next
}

// A theme.tsv next to the other profile files overrides single roles:
//   panel<TAB>#1d2021
// Lines whose first field starts with # are comments. Unknown keys are ignored.
fn theme_override(base: Chrome, text: String) -> Chrome {
    var out = base
    let lines = text.split("\n")
    var i = 0
    while i < lines.len() {
        let key = library.field(lines[i], 0)
        let color = parse_hex(library.field(lines[i], 1))
        if key.len() > 0 && !key.starts_with("#") && color >= 0 {
            out = with_color(out, key, color)
        }
        i = i + 1
    }
    return out
}

fn resolved_theme_name(store: Store) -> String {
    let forced = gui.env("NOVA_BROWSER_THEME").trim()
    if forced.len() > 0 {
        return forced
    }
    if store.theme.len() == 0 {
        return "gruvbox"
    }
    return store.theme
}

fn theme_is_light(name: String) -> Bool {
    return name == "light" || name == "solarized"
}

fn load_theme(store: Store) -> Chrome {
    let name = resolved_theme_name(store)
    let overrides = gui.read(profile_root() + "/theme.tsv")
    if gui.env("NOVA_BROWSER_TRACE").len() > 0 {
        println("browser: theme=" + name)
    }
    return theme_override(theme_named(name), overrides)
}

// ---------- geometry ----------

fn max_tabs() -> Int {
    return 6
}

fn sug_rows() -> Int {
    return 6
}

fn sug_row_height() -> Int {
    return 36
}

fn chrome_height(vertical: Bool) -> Int {
    if vertical {
        return 58
    }
    return 118
}

fn toolbar_y(vertical: Bool) -> Int {
    if vertical {
        return 12
    }
    return 44
}

// The window buttons follow the row they belong to: the tab strip when tabs are
// horizontal (tab centre), the toolbar when they are vertical (button centre).
// The host moves the real AppKit buttons here rather than drawing copies.
fn traffic_center(vertical: Bool) -> Int {
    if vertical {
        return toolbar_y(true) + 17
    }
    // tab_box_y is 8 and a horizontal tab is 30 tall, so its centre is 23.
    return tab_box_y(0, false) + tab_box_h(false) / 2
}

fn sidebar_width() -> Int {
    var width = gui.width() / 4
    if width < 176 {
        width = 176
    }
    if width > 260 {
        width = 260
    }
    return width
}

fn rail_width() -> Int {
    return 46
}

fn rail_panel_width() -> Int {
    return 210
}

fn sidebar_span(session: Session) -> Int {
    if !session.vertical {
        return 0
    }
    if session.rail {
        return rail_width()
    }
    return sidebar_width()
}

fn page_left(session: Session) -> Int {
    if session.vertical {
        return sidebar_span(session) + 1
    }
    return 0
}

fn page_top(session: Session) -> Int {
    return chrome_height(session.vertical)
}

fn tab_width(count: Int) -> Int {
    if count <= 0 {
        return 160
    }
    // The horizontal strip no longer reserves room for a plus, so tabs get
    // the whole width up to the window edge.
    var available = gui.width() - 96
    if available < 300 {
        available = 300
    }
    var width = available / count
    if width > 200 {
        width = 200
    }
    if width < 84 {
        width = 84
    }
    return width
}

// Horizontal tabs scroll so the active one stays visible once they no longer
// fit between the traffic lights and the new-tab button.
fn tab_offset(session: Session) -> Int {
    let count = session.tabs.len()
    let width = tab_width(count)
    let span = gui.width() - 92
    let total = count * (width + 6)
    if total <= span {
        return 0
    }
    var offset = 0
    let active_x = session.active * (width + 6)
    if active_x + width > span {
        offset = active_x + width - span
    }
    if offset > total - span {
        offset = total - span
    }
    if offset < 0 {
        offset = 0
    }
    return offset
}

fn tab_box_x(session: Session, index: Int) -> Int {
    if session.vertical {
        return 8
    }
    return 84 + index * (tab_width(session.tabs.len()) + 6) - tab_offset(session)
}

// Which slot a dragged tab would land in, by its midpoint.
fn tab_slot_at(session: Session, x: Int) -> Int {
    let count = session.tabs.len()
    let width = tab_width(count)
    var i = 0
    while i < count {
        let tx = tab_box_x(session, i)
        if x < tx + width / 2 {
            return i
        }
        i = i + 1
    }
    return count - 1
}

fn reorder_tab(session: Session, from: Int, to: Int) -> Session {
    let count = session.tabs.len()
    if from < 0 || from >= count || to < 0 || to >= count || from == to {
        return session
    }
    var tabs: List<Tab> = []
    var i = 0
    while i < count {
        if i == to {
            tabs.push(session.tabs[from])
        }
        if i != from {
            tabs.push(session.tabs[i])
        }
        i = i + 1
    }
    var next = session
    next.tabs = tabs
    next.active = to
    next.seen = ""
    sync_visibility(next)
    return next
}

// Which tab a right-click landed on, or -1 when the point is not on a tab.
fn tab_menu_target(x: Int, y: Int, session: Session) -> Int {
    let count = session.tabs.len()
    var i = 0
    if session.vertical {
        if x >= sidebar_width() || y < chrome_height(true) {
            return 0 - 1
        }
        while i < count {
            let tx = tab_box_x(session, i)
            if gui.inside(tx, tab_box_y(i, true), tab_box_w(count, true), 32, x, y) {
                return i
            }
            i = i + 1
        }
        return 0 - 1
    }
    if y >= 44 {
        return 0 - 1
    }
    while i < count {
        let tx = tab_box_x(session, i)
        if gui.inside(tx, 8, tab_box_w(count, false), 30, x, y) {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// A duplicate opens the tab's live URL, or repeats the fixture for a fixture
// tab. It goes through the same six-tab cap as every other create path.
fn duplicate_tab(session: Session, index: Int, parent: Int, width: Int, height: Int) -> Session {
    if index < 0 || index >= session.tabs.len() {
        return session
    }
    let tab = session.tabs[index]
    let live = engine.page_url(tab.handle)
    let url = if live.len() > 0 { live } else { tab.url }
    if tab.fixture || url.contains("fixture.nova.invalid") {
        return append_tab(session, new_fixture_tab(parent, width, height))
    }
    if url.len() == 0 {
        return session
    }
    return append_tab(session, new_url_tab(parent, width, height, url))
}

// Close everything except `keep`, then leave that tab selected. Closing is
// always done by index 0 for the tabs before it so the survivor's index is
// known at every step.
fn close_other_tabs(session: Session, keep: Int, parent: Int, width: Int, height: Int) -> Session {
    if keep < 0 || keep >= session.tabs.len() {
        return session
    }
    var next = session
    while next.tabs.len() - 1 > keep {
        next = close_tab(next, next.tabs.len() - 1, parent, width, height)
    }
    var left = keep
    while left > 0 {
        next = close_tab(next, 0, parent, width, height)
        left = left - 1
    }
    return select_tab(next, 0)
}

fn tab_menu_apply(choice: Int, index: Int, session: Session) -> Session {
    let parent = gui.native_view()
    let width = gui.width()
    let height = gui.height()
    if choice == 1 {
        return append_tab(session, new_fixture_tab(parent, width, height))
    }
    if choice == 2 {
        return duplicate_tab(session, index, parent, width, height)
    }
    if choice == 3 {
        return close_tab(session, index, parent, width, height)
    }
    if choice == 4 {
        return close_other_tabs(session, index, parent, width, height)
    }
    return session
}

fn tab_box_y(index: Int, vertical: Bool) -> Int {
    if vertical {
        return 100 + index * 36
    }
    return 8
}

fn tab_box_w(count: Int, vertical: Bool) -> Int {
    if vertical {
        return sidebar_width() - 16
    }
    return tab_width(count)
}

fn tab_box_h(vertical: Bool) -> Int {
    if vertical {
        return 32
    }
    return 30
}

fn tab_title(tab: Tab) -> String {
    if tab.title.len() > 0 {
        return tab.title
    }
    if tab.fixture {
        return "New Tab"
    }
    return tab.url
}

// One tab mark in the collapsed rail.
fn rail_tab_box(index: Int) -> Box {
    return Box { x: 4, y: tab_box_y(index, true), w: rail_width() - 8, h: 30 }
}

// One row in the floating list a collapsed rail reveals on hover.
fn overlay_tab_box(index: Int) -> Box {
    return Box { x: 8, y: tab_box_y(index, true), w: rail_panel_width() - 16, h: 32 }
}

// New Tab grows under the last tab in a vertical sidebar, not above it.
fn new_tab_box(session: Session) -> Box {
    let y = tab_box_y(session.tabs.len(), true) + 4
    if session.rail {
        return Box { x: 4, y: y, w: rail_width() - 8, h: 28 }
    }
    return Box { x: 8, y: y, w: sidebar_width() - 16, h: 28 }
}

fn panel_new_tab_box(session: Session) -> Box {
    return Box { x: 8, y: tab_box_y(session.tabs.len(), true) + 4, w: rail_panel_width() - 16, h: 28 }
}

// Pin/expand control: the chevron sits in the sidebar header, or at the top of
// the rail when collapsed.
fn collapse_box(session: Session) -> Box {
    if session.rail {
        return Box { x: 6, y: 66, w: rail_width() - 12, h: 26 }
    }
    return Box { x: sidebar_width() - 36, y: 64, w: 26, h: 26 }
}

// One row of 30 px controls with an even 8 px gap on both sides of the field,
// the way Chrome lays out its toolbar. Every button is vertically centred on
// the 34 px field, so nothing sits a pixel off from its neighbour.
fn toolbar_metrics(vertical: Bool) -> Toolbar {
    let label = gui.width() - 12 - gui.mono_width("WEBKIT", 10)
    let layout_x = label - 38
    let docs_x = layout_x - 38
    let downloads_x = docs_x - 38
    let star_x = downloads_x - 38
    // Reading a page aloud sits next to the bookmark, on the same 8 px grid.
    let voice_x = star_x - 38
    let address_x = 202
    var address_w = voice_x - address_x - 8
    if address_w < 120 {
        address_w = 120
    }
    return Toolbar {
        back: 88,
        forward: 126,
        reload: 164,
        address: address_x,
        address_w: address_w,
        voice: voice_x,
        star: star_x,
        downloads: downloads_x,
        docs: docs_x,
        layout: layout_x,
        label: label,
    }
}

// The engine chip sits inside the address field's left edge while editing.
fn address_chip_box(vertical: Bool) -> Box {
    let metrics = toolbar_metrics(vertical)
    return Box { x: metrics.address + 8, y: toolbar_y(vertical) + 4, w: 26, h: 26 }
}

// Text and caret math start after the chip while editing. Click handling and
// the painter both read this, so a press lands on the glyph it points at.
fn address_text_x(vertical: Bool, editing: Bool) -> Int {
    let metrics = toolbar_metrics(vertical)
    if editing {
        return metrics.address + 42
    }
    return metrics.address + 18
}

fn search_initial(provider: String) -> String {
    if provider == "google" {
        return "G"
    }
    if provider == "duckduckgo" {
        return "D"
    }
    if provider == "brave" {
        return "B"
    }
    return "-"
}

fn suggestion_top(vertical: Bool) -> Int {
    return toolbar_y(vertical) + 38
}

fn failure_card(session: Session) -> Box {
    let left = page_left(session)
    let top = page_top(session)
    let width = gui.width() - left
    let height = gui.height() - top
    var card_w = 520
    if card_w > width - 48 {
        card_w = width - 48
    }
    if card_w < 260 {
        card_w = 260
    }
    var card_h = 292
    if card_h > height - 48 {
        card_h = height - 48
    }
    return Box {
        x: left + (width - card_w) / 2,
        y: top + (height - card_h) / 2,
        w: card_w,
        h: card_h,
    }
}

fn failure_retry(session: Session) -> Box {
    let card = failure_card(session)
    return Box { x: card.x + 24, y: card.y + card.h - 58, w: 112, h: 34 }
}

fn failure_back(session: Session) -> Box {
    let card = failure_card(session)
    return Box { x: card.x + 148, y: card.y + card.h - 58, w: 84, h: 34 }
}

// ---------- animation ----------

fn fx_new() -> Fx {
    var slots: List<Int> = []
    var i = 0
    while i < 160 {
        slots.push(0)
        i = i + 1
    }
    return Fx { slots: slots, focus: 0 }
}

fn slot(fx: Fx, index: Int) -> Int {
    if index < 0 || index >= fx.slots.len() {
        return 0
    }
    return fx.slots[index]
}

fn approach(current: Int, target: Int, step: Int) -> Int {
    if current < target {
        let next = current + step
        if next > target {
            return target
        }
        return next
    }
    if current > target {
        let next = current - step
        if next < target {
            return target
        }
        return next
    }
    return current
}

// One pass, one list allocation. The previous version rebuilt the whole slot
// list once per slot (160 lists of 160 ints per frame) to change a single
// element, which cost more than drawing the chrome.
fn fx_step(fx: Fx, hover: Int, editing: Bool) -> Fx {
    var slots: List<Int> = []
    var i = 0
    while i < fx.slots.len() {
        let target = if i == hover { 1000 } else { 0 }
        slots.push(approach(fx.slots[i], target, 240))
        i = i + 1
    }
    let focus_target = if editing { 1000 } else { 0 }
    return Fx { slots: slots, focus: approach(fx.focus, focus_target, 120) }
}

fn fx_busy(fx: Fx) -> Bool {
    if fx.focus > 0 && fx.focus < 1000 {
        return true
    }
    for value in fx.slots {
        if value > 0 && value < 1000 {
            return true
        }
    }
    return false
}

// Mixes two RGB values. amount is 0..1000, so drawing code can fade a border
// or a fill without needing alpha compositing.
fn blend(first: Int, second: Int, amount: Int) -> Int {
    var t = amount
    if t < 0 {
        t = 0
    }
    if t > 1000 {
        t = 1000
    }
    let r = ((first / 65536) * (1000 - t) + (second / 65536) * t) / 1000
    let g = (((first / 256) % 256) * (1000 - t) + ((second / 256) % 256) * t) / 1000
    let b = ((first % 256) * (1000 - t) + (second % 256) * t) / 1000
    return r * 65536 + g * 256 + b
}

// ---------- address model ----------

fn state_word(state: Int) -> String {
    if state == 2 {
        return "ready"
    }
    if state == 1 {
        return "loading"
    }
    if state == 3 {
        return "error"
    }
    return "idle"
}

fn address_idle() -> Address {
    return Address {
        editing: false,
        text: "",
        cursor: 0,
        anchor: 0,
        error: "",
        highlight: 0 - 1,
    }
}

fn address_clamp(at: Int, count: Int) -> Int {
    if at < 0 {
        return 0
    }
    if at > count {
        return count
    }
    return at
}

// Cmd+L and the first focus of the field select the whole URL.
fn address_begin(current: String) -> Address {
    return Address {
        editing: true,
        text: current,
        cursor: address_edit.char_count(current),
        anchor: 0,
        error: "",
        highlight: 0 - 1,
    }
}

fn address_begin_cursor(current: String, cursor: Int) -> Address {
    let at = address_clamp(cursor, address_edit.char_count(current))
    return Address {
        editing: true,
        text: current,
        cursor: at,
        anchor: at,
        error: "",
        highlight: 0 - 1,
    }
}

fn address_lo(current: Address) -> Int {
    if current.anchor < current.cursor {
        return current.anchor
    }
    return current.cursor
}

fn address_hi(current: Address) -> Int {
    if current.anchor < current.cursor {
        return current.cursor
    }
    return current.anchor
}

fn address_selected(current: Address) -> Bool {
    return current.anchor != current.cursor
}

fn address_at(current: Address, cursor: Int) -> Address {
    let at = address_clamp(cursor, address_edit.char_count(current.text))
    return Address {
        editing: true,
        text: current.text,
        cursor: at,
        anchor: at,
        error: "",
        highlight: current.highlight,
    }
}

fn address_with_text(current: Address, text: String, cursor: Int) -> Address {
    let at = address_clamp(cursor, address_edit.char_count(text))
    return Address {
        editing: true,
        text: text,
        cursor: at,
        anchor: at,
        error: "",
        highlight: 0 - 1,
    }
}

fn address_splice(text: String, start: Int, stop: Int, insert: String) -> String {
    let chars = text.chars()
    return address_edit.slice_chars(chars, 0, start) + insert + address_edit.slice_chars(chars, stop, chars.len())
}

// Horizontal offset that keeps the caret inside the visible part of the field.
fn address_scroll(text: String, cursor: Int, width: Int) -> Int {
    let prefix = address_edit.slice_chars(text.chars(), 0, cursor)
    let caret = gui.text_width(prefix, 13)
    if caret > width {
        return caret - width
    }
    return 0
}

// Nearest character boundary to a click, in the text's own coordinates. Widths
// accumulate left to right; re-measuring every prefix made a click on a long
// URL quadratic.
fn address_caret_at(text: String, local_x: Int) -> Int {
    let chars = text.chars()
    let starts = address_edit.cluster_starts(text)
    var best = 0
    var best_gap = 0 - 1
    var width = 0
    var measured = 0
    var i = 0
    // Candidate carets are cluster boundaries only, so a click never lands in
    // the middle of a combining sequence or an emoji. Widths accumulate once.
    while i < starts.len() {
        let at = starts[i]
        while measured < at {
            width = width + gui.text_width(chars[measured], 13)
            measured = measured + 1
        }
        let gap = if width > local_x { width - local_x } else { local_x - width }
        if best_gap < 0 || gap < best_gap {
            best_gap = gap
            best = at
        }
        i = i + 1
    }
    return best
}

// Word boundaries for Option+arrow: a URL is one long token, so punctuation
// that separates host, path and query counts as a boundary.
fn address_break(ch: String) -> Bool {
    if ch.len() == 0 {
        return true
    }
    return " /:?&=#.-_%@+~,;|".contains(ch)
}

fn address_word_left(text: String, at: Int) -> Int {
    let chars = text.chars()
    var i = address_clamp(at, chars.len())
    while i > 0 && address_break(chars[i - 1]) {
        i = i - 1
    }
    while i > 0 && !address_break(chars[i - 1]) {
        i = i - 1
    }
    return address_edit.snap(text, i)
}

fn address_word_right(text: String, at: Int) -> Int {
    let chars = text.chars()
    let count = chars.len()
    var i = address_clamp(at, count)
    while i < count && !address_break(chars[i]) {
        i = i + 1
    }
    while i < count && address_break(chars[i]) {
        i = i + 1
    }
    return address_edit.snap(text, i)
}

fn address_cancel(current: Address) -> Address {
    return Address {
        editing: false,
        text: current.text,
        cursor: current.cursor,
        anchor: current.cursor,
        error: "",
        highlight: 0 - 1,
    }
}

fn address_type(current: Address, typed: String) -> Address {
    if !current.editing || typed.len() == 0 {
        return current
    }
    let text = address_splice(current.text, address_lo(current), address_hi(current), typed)
    return address_with_text(current, text, address_lo(current) + address_edit.char_count(typed))
}

fn address_backspace(current: Address) -> Address {
    if !current.editing {
        return current
    }
    if address_selected(current) {
        let lo = address_lo(current)
        return address_with_text(current, address_splice(current.text, lo, address_hi(current), ""), lo)
    }
    let at = address_clamp(current.cursor, address_edit.char_count(current.text))
    let start = address_edit.char_left(current.text, at)
    return address_with_text(current, address_edit.backspace_text(current.text, at), start)
}

fn address_delete(current: Address) -> Address {
    if !current.editing {
        return current
    }
    if address_selected(current) {
        let lo = address_lo(current)
        return address_with_text(current, address_splice(current.text, lo, address_hi(current), ""), lo)
    }
    let at = address_clamp(current.cursor, address_edit.char_count(current.text))
    return address_with_text(current, address_edit.delete_forward_text(current.text, at), at)
}

fn address_left(current: Address) -> Address {
    if !current.editing {
        return current
    }
    if address_selected(current) {
        return address_at(current, address_lo(current))
    }
    return address_at(current, address_edit.char_left(current.text, current.cursor))
}

fn address_right(current: Address) -> Address {
    if !current.editing {
        return current
    }
    if address_selected(current) {
        return address_at(current, address_hi(current))
    }
    return address_at(current, address_edit.char_right(current.text, current.cursor))
}

fn address_edge(current: Address, start: Bool) -> Address {
    if !current.editing {
        return current
    }
    if start {
        return address_at(current, 0)
    }
    return address_at(current, address_edit.char_count(current.text))
}

// Option+arrow: one word at a time; with a selection it collapses to that edge.
fn address_word_step(current: Address, direction: Int) -> Address {
    if !current.editing {
        return current
    }
    if address_selected(current) {
        if direction < 0 {
            return address_at(current, address_lo(current))
        }
        return address_at(current, address_hi(current))
    }
    if direction < 0 {
        return address_at(current, address_word_left(current.text, current.cursor))
    }
    return address_at(current, address_word_right(current.text, current.cursor))
}

// Option+Backspace / Option+Delete: delete to the previous / next boundary.
fn address_word_erase(current: Address, forward: Bool) -> Address {
    if !current.editing {
        return current
    }
    if address_selected(current) {
        let lo = address_lo(current)
        return address_with_text(current, address_splice(current.text, lo, address_hi(current), ""), lo)
    }
    let at = current.cursor
    if forward {
        let stop = address_word_right(current.text, at)
        return address_with_text(current, address_splice(current.text, at, stop, ""), at)
    }
    let start = address_word_left(current.text, at)
    return address_with_text(current, address_splice(current.text, start, at, ""), start)
}

// Double-click: the separator run under the pointer, or the token around it.
fn address_select_word(current: Address, at: Int) -> Address {
    let text = current.text
    let chars = text.chars()
    let count = chars.len()
    let point = address_edit.snap(text, address_clamp(at, count))
    var start = point
    var stop = point
    if point < count && address_break(chars[point]) {
        while start > 0 && address_break(chars[start - 1]) {
            start = start - 1
        }
        while stop < count && address_break(chars[stop]) {
            stop = stop + 1
        }
    } else {
        while start > 0 && !address_break(chars[start - 1]) {
            start = start - 1
        }
        while stop < count && !address_break(chars[stop]) {
            stop = stop + 1
        }
    }
    if start == stop {
        stop = address_edit.char_right(text, start)
    }
    return Address {
        editing: true,
        text: text,
        cursor: stop,
        anchor: start,
        error: "",
        highlight: 0 - 1,
    }
}

fn address_select_all(current: Address) -> Address {
    return Address {
        editing: true,
        text: current.text,
        cursor: address_edit.char_count(current.text),
        anchor: 0,
        error: "",
        highlight: 0 - 1,
    }
}

fn address_clear(current: Address) -> Address {
    return Address {
        editing: true,
        text: "",
        cursor: 0,
        anchor: 0,
        error: "",
        highlight: 0 - 1,
    }
}

fn address_move(current: Address, delta: Int, count: Int) -> Address {
    if count <= 0 {
        return current
    }
    var next = current.highlight
    if next < 0 {
        next = if delta > 0 { 0 } else { count - 1 }
    } else {
        next = next + delta
        if next < 0 {
            next = count - 1
        }
        if next >= count {
            next = 0
        }
    }
    return Address {
        editing: current.editing,
        text: current.text,
        cursor: current.cursor,
        anchor: current.anchor,
        error: current.error,
        highlight: next,
    }
}

// Tab completes the highlighted suggestion into the field without opening it.
fn address_accept(current: Address, suggestions: List<String>) -> Address {
    if current.highlight < 0 || current.highlight >= suggestions.len() {
        return current
    }
    let url = library.field(suggestions[current.highlight], 1)
    return Address {
        editing: true,
        text: url,
        cursor: address_edit.char_count(url),
        anchor: address_edit.char_count(url),
        error: "",
        highlight: 0 - 1,
    }
}

fn address_open(current: Address, url: String) -> Address {
    return Address {
        editing: false,
        text: url,
        cursor: address_edit.char_count(url),
        anchor: address_edit.char_count(url),
        error: "",
        highlight: 0 - 1,
    }
}

// The engine owns plain text, so the first suggestion row says exactly where
// Enter sends it. Built locally from the chosen provider; nothing is fetched.
fn with_search_row(rows: List<String>, text: String, provider: String) -> List<String> {
    let trimmed = text.trim()
    if trimmed.len() == 0 || provider == "off" {
        return rows
    }
    if address_edit.normalize(trimmed).len() > 0 {
        return rows
    }
    let url = address_edit.search_url(provider, trimmed)
    if url.len() == 0 {
        return rows
    }
    var out: List<String> = ["search\t" + url + "\t" + "Search " + address_edit.search_label(provider) + " for \"" + trimmed + "\""]
    for row in rows {
        out.push(row)
    }
    return out
}

fn address_submit(handle: Int, current: Address, suggestions: List<String>, search: String) -> Address {
    var url = ""
    if current.highlight >= 0 && current.highlight < suggestions.len() {
        url = library.field(suggestions[current.highlight], 1)
    } else {
        url = address_edit.normalize(current.text)
        if url.len() == 0 && search != "off" && current.text.trim().len() > 0 {
            url = address_edit.search_url(search, current.text)
        }
    }
    if url.len() == 0 {
        return Address {
            editing: true,
            text: current.text,
            cursor: current.cursor,
            anchor: current.anchor,
            error: "Enter an address to open",
            highlight: current.highlight,
        }
    }
    engine.navigate(handle, url)
    engine.focus_page(handle)
    if gui.env("NOVA_BROWSER_TRACE").len() > 0 {
        println("browser: navigate " + url)
    }
    return address_open(current, url)
}

// ---------- tabs ----------

fn fixture_paths() -> List<String> {
    return [
        "browser/fixtures/start.html",
        "fixtures/start.html",
        "../fixtures/start.html",
    ]
}

fn fixture_html() -> String {
    let bundled = gui.resource("start.html")
    if bundled.contains("Nova Browser") {
        return bundled
    }
    for path in fixture_paths() {
        let data = gui.read(path)
        if data.contains("Nova Browser") {
            return data
        }
    }
    return "<!doctype html><html><head><title>Nova Browser</title></head><body style=\"background:#1d2021;color:#ebdbb2;font:20px -apple-system;padding:40px\"><h1>Nova Browser</h1><p>Fixture file not found. WebKit is still running.</p></body></html>"
}

fn tab_create(parent: Int, width: Int, height: Int, url: String, fixture: Bool) -> Tab {
    var page_height = height - chrome_height(false)
    if page_height < 1 {
        page_height = 1
    }
    let handle = engine.create(parent, 0, chrome_height(false), width, page_height)
    if handle <= 0 {
        return Tab {
            handle: 0,
            url: url,
            fixture: fixture,
            title: "",
        }
    }
    if fixture {
        engine.load_fixture(handle, fixture_html())
    } else {
        engine.navigate(handle, url)
    }
    return Tab {
        handle: handle,
        url: url,
        fixture: fixture,
        title: "",
    }
}

fn new_fixture_tab(parent: Int, width: Int, height: Int) -> Tab {
    return tab_create(parent, width, height, "https://fixture.nova.invalid/", true)
}

fn new_url_tab(parent: Int, width: Int, height: Int, url: String) -> Tab {
    return tab_create(parent, width, height, url, false)
}

fn active_handle(session: Session) -> Int {
    if session.active < 0 || session.active >= session.tabs.len() {
        return 0
    }
    return session.tabs[session.active].handle
}

// The page view is visible only for the active tab, and never while its own
// failure panel is on screen: a hidden native view is what lets Nova draw the
// error surface over the page area.
fn sync_visibility(session: Session) {
    var i = 0
    while i < session.tabs.len() {
        let tab = session.tabs[i]
        var visible = i == session.active
        if visible && engine.page_state(tab.handle) == 3 {
            visible = false
        }
        engine.set_visible(tab.handle, visible)
        i = i + 1
    }
}

fn select_tab(session: Session, index: Int) -> Session {
    if index < 0 || index >= session.tabs.len() {
        return session
    }
    var next = session
    next.active = index
    next.seen = ""
    sync_visibility(next)
    engine.focus_page(active_handle(next))
    if gui.env("NOVA_BROWSER_TRACE").len() > 0 {
        println("browser: tab selected index=${index}")
    }
    return next
}

fn append_tab(session: Session, tab: Tab) -> Session {
    if tab.handle <= 0 {
        return session
    }
    if session.tabs.len() >= max_tabs() {
        engine.destroy(tab.handle)
        return session
    }
    var tabs = session.tabs
    tabs.push(tab)
    var next = Session {
        tabs: tabs,
        active: tabs.len() - 1,
        closed: session.closed,
        vertical: session.vertical,
        rail: session.rail,
        seen: "",
    }
    sync_visibility(next)
    if gui.env("NOVA_BROWSER_TRACE").len() > 0 {
        println("browser: tab created count=${tabs.len()}")
    }
    return next
}

fn close_tab(session: Session, index: Int, parent: Int, width: Int, height: Int) -> Session {
    if index < 0 || index >= session.tabs.len() {
        return session
    }
    let closing = session.tabs[index]
    let live = engine.page_url(closing.handle)
    let closed_url = if live.len() > 0 { live } else { closing.url }
    let closed_fixture = closing.fixture && closed_url.contains("fixture.nova.invalid")
    var closed = session.closed
    closed.push(ClosedTab {
        url: closed_url,
        fixture: closed_fixture,
    })
    if closed.len() > 8 {
        var trimmed: List<ClosedTab> = []
        var c = 1
        while c < closed.len() {
            trimmed.push(closed[c])
            c = c + 1
        }
        closed = trimmed
    }

    engine.destroy(closing.handle)
    var rest: List<Tab> = []
    var i = 0
    while i < session.tabs.len() {
        if i != index {
            rest.push(session.tabs[i])
        }
        i = i + 1
    }

    var active = session.active
    if index < active {
        active = active - 1
    }
    if rest.len() == 0 {
        let fresh = new_fixture_tab(parent, width, height)
        rest.push(fresh)
        active = 0
    }
    if active >= rest.len() {
        active = rest.len() - 1
    }

    var next = Session {
        tabs: rest,
        active: active,
        closed: closed,
        vertical: session.vertical,
        rail: session.rail,
        seen: "",
    }
    sync_visibility(next)
    engine.focus_page(active_handle(next))
    if gui.env("NOVA_BROWSER_TRACE").len() > 0 {
        println("browser: tab closed count=${rest.len()}")
    }
    return next
}

fn restore_closed(session: Session, parent: Int, width: Int, height: Int) -> Session {
    if session.closed.len() == 0 || session.tabs.len() >= max_tabs() {
        return session
    }
    let item = session.closed[session.closed.len() - 1]
    var remaining: List<ClosedTab> = []
    var i = 0
    while i < session.closed.len() - 1 {
        remaining.push(session.closed[i])
        i = i + 1
    }
    let tab = if item.fixture {
        new_fixture_tab(parent, width, height)
    } else {
        new_url_tab(parent, width, height, item.url)
    }
    if tab.handle <= 0 {
        return session
    }
    var tabs = session.tabs
    tabs.push(tab)
    var next = Session {
        tabs: tabs,
        active: tabs.len() - 1,
        closed: remaining,
        vertical: session.vertical,
        rail: session.rail,
        seen: "",
    }
    sync_visibility(next)
    engine.focus_page(active_handle(next))
    if gui.env("NOVA_BROWSER_TRACE").len() > 0 {
        println("browser: tab restored count=${tabs.len()}")
    }
    return next
}

// Top tabs → sidebar → rail → top tabs. The rail is the collapsed sidebar:
// hovering it reveals the names without pinning it back open.
fn layout_notice(session: Session) -> String {
    if !session.vertical {
        return "Tabs: top"
    }
    if session.rail {
        return "Tabs: rail · hover to reveal"
    }
    return "Tabs: sidebar"
}

fn toggle_layout(session: Session) -> Session {
    var next = session
    if !session.vertical {
        next.vertical = true
        next.rail = false
    } else if !session.rail {
        next.rail = true
    } else {
        next.vertical = false
        next.rail = false
    }
    return next
}

fn destroy_session(session: Session) {
    var i = 0
    while i < session.tabs.len() {
        engine.destroy(session.tabs[i].handle)
        i = i + 1
    }
}

// ---------- profile, history and bookmarks ----------

fn profile_root() -> String {
    let explicit = gui.env("NOVA_BROWSER_PROFILE").trim()
    if explicit.len() > 0 {
        return explicit
    }
    return gui.env("HOME") + "/Library/Application Support/Nova Browser"
}

fn history_enabled() -> Bool {
    return gui.env("NOVA_BROWSER_NO_HISTORY").trim() != "1"
}

fn load_store() -> Store {
    let root = profile_root()
    gui.mkdir(root)
    let history_path = root + "/history.tsv"
    let bookmarks_path = root + "/bookmarks.tsv"
    let settings_path = root + "/settings.tsv"
    let session_path = root + "/session.tsv"
    let downloads_path = root + "/downloads.tsv"
    var visits: List<String> = []
    if history_enabled() {
        let raw = gui.read(history_path)
        visits = library.parse_records(raw)
    }
    let raw_marks = gui.read(bookmarks_path)
    let bookmarks = library.parse_records(raw_marks)
    let download_history = library.parse_records(gui.read(downloads_path))
    let settings = gui.read(settings_path)
    var search = library.setting_value(settings, "search")
    if search.len() == 0 {
        // Google is the default search engine. The chip in the address bar can
        // switch it without leaving the field or pressing a shortcut.
        search = "google"
    }
    var theme_name = library.setting_value(settings, "theme")
    if theme_name.len() == 0 {
        theme_name = "gruvbox"
    }
    return Store {
        visits: visits,
        bookmarks: bookmarks,
        history_path: if history_enabled() { history_path } else { "" },
        bookmarks_path: bookmarks_path,
        settings_path: settings_path,
        session_path: if history_enabled() { session_path } else { "" },
        search: search,
        theme: theme_name,
        downloads_open: false,
        downloads_path: downloads_path,
        download_history: download_history,
        dirty_downloads: false,
        dirty_visits: false,
        dirty_bookmarks: false,
    }
}

fn save_store(store: Store) -> Store {
    var next = store
    if next.dirty_visits && next.history_path.len() > 0 {
        let text = library.join_records(next.visits)
        if gui.write(next.history_path, text) {
            next.dirty_visits = false
        }
    }
    if next.dirty_bookmarks && next.bookmarks_path.len() > 0 {
        let text = library.join_records(next.bookmarks)
        if gui.write(next.bookmarks_path, text) {
            next.dirty_bookmarks = false
        }
    }
    if next.dirty_downloads && next.downloads_path.len() > 0 {
        let text = library.join_records(next.download_history)
        if gui.write(next.downloads_path, text) {
            next.dirty_downloads = false
        }
    }
    return next
}

fn save_setting(store: Store, key: String, value: String) {
    if store.settings_path.len() == 0 {
        return
    }
    let text = gui.read(store.settings_path)
    gui.write(store.settings_path, library.setting_with(text, key, value))
}

fn save_layout(store: Store, vertical: Bool, rail: Bool) {
    var value = "horizontal"
    if vertical {
        value = "vertical"
        if rail {
            value = "rail"
        }
    }
    save_setting(store, "layout", value)
}

// Every Chromium-family browser saves the same JSON Bookmarks file, so
// detection is the only per-browser work. Firefox and Safari export HTML
// instead, which --import reads directly.
fn import_roots() -> List<String> {
    return [
        "Google/Chrome",
        "Chromium",
        "BraveSoftware/Brave-Browser",
        "Microsoft Edge",
        "Arc/User Data",
        "Vivaldi",
    ]
}

fn chrome_profile_paths() -> List<String> {
    var paths: List<String> = []
    for root in import_roots() {
        let base = gui.env("HOME") + "/Library/Application Support/" + root
        if gui.is_dir(base) {
            let listing = gui.list(base)
            for line in listing.split("\n") {
                if line.starts_with("d\t") {
                    let parts = line.split("\t")
                    if parts.len() > 1 {
                        let candidate = base + "/" + parts[1] + "/Bookmarks"
                        if gui.exists(candidate) {
                            paths.push(candidate)
                        }
                    }
                }
            }
        }
    }
    return paths
}

fn import_file(path: String) -> List<String> {
    let text = gui.read(path)
    if text.len() == 0 {
        return []
    }
    let lower = text.lower()
    if lower.contains("<a href=") || lower.contains("<!doctype netscape") {
        return library.import_html(text)
    }
    return library.import_chrome(text)
}

fn import_files(paths: List<String>) -> List<String> {
    var found: List<String> = []
    for path in paths {
        if gui.is_dir(path) {
            let listing = gui.list(path)
            for line in listing.split("\n") {
                if line.starts_with("f\t") {
                    let parts = line.split("\t")
                    if parts.len() > 1 {
                        let name = parts[1].lower()
                        if name == "bookmarks" || name.ends_with(".html") || name.ends_with(".htm") {
                            let nested = import_file(path + "/" + parts[1])
                            found = library.merge(found, nested)
                        }
                    }
                }
            }
        } else {
            let imported = import_file(path)
            found = library.merge(found, imported)
        }
    }
    return found
}

fn apply_import(store: Store, found: List<String>) -> Store {
    var next = store
    var added = 0
    for line in found {
        let url = library.field(line, 1)
        if !library.has_bookmark(next.bookmarks, url) {
            let title = library.field(line, 2)
            next.bookmarks = library.add_bookmark(next.bookmarks, url, title)
            added = added + 1
        }
    }
    if added > 0 {
        next.dirty_bookmarks = true
    }
    return next
}

fn import_from_google(store: Store) -> Imported {
    let paths = chrome_profile_paths()
    if paths.len() == 0 {
        return Imported { store: store, message: "No Google Chrome profile found" }
    }
    let found = import_files(paths)
    let before = library.bookmark_count(store.bookmarks)
    let next = apply_import(store, found)
    let added = library.bookmark_count(next.bookmarks) - before
    if added == 0 {
        return Imported { store: next, message: "Bookmarks already up to date" }
    }
    return Imported { store: next, message: "Imported ${added} bookmarks" }
}

// ---------- drawing ----------

// Soft light around a shape: three translucent copies, largest faintest. Three
// fills cost far less than an offscreen shadow and read as a glow, not a border.
fn glow(x: Int, y: Int, w: Int, h: Int, radius: Int, color: Int, amount: Int) {
    if amount <= 0 {
        return
    }
    var layer = 1
    while layer <= 3 {
        let spread = layer * 3
        let alpha = amount / (layer * 2)
        gui.round_rect_alpha(x - spread, y - spread, w + spread * 2, h + spread * 2, radius + spread, color, alpha)
        layer = layer + 1
    }
}

// ---------- glyphs ----------
// Navigation marks are drawn from lines rather than font characters: the old
// text glyphs depended on font coverage (a missing one is a tofu box) and sat
// at the font's baseline instead of the button's centre.

fn draw_plus(cx: Int, cy: Int, color: Int) {
    gui.line(cx - 5, cy, cx + 5, cy, color)
    gui.line(cx - 5, cy + 1, cx + 5, cy + 1, color)
    gui.line(cx, cy - 5, cx, cy + 5, color)
    gui.line(cx + 1, cy - 5, cx + 1, cy + 5, color)
}

fn draw_close(cx: Int, cy: Int, color: Int) {
    gui.line(cx - 4, cy - 4, cx + 4, cy + 4, color)
    gui.line(cx - 3, cy - 4, cx + 5, cy + 4, color)
    gui.line(cx + 4, cy - 4, cx - 4, cy + 4, color)
    gui.line(cx + 5, cy - 4, cx - 3, cy + 4, color)
}

fn draw_chevron_left(cx: Int, cy: Int, color: Int) {
    gui.line(cx + 3, cy - 5, cx - 3, cy, color)
    gui.line(cx - 3, cy, cx + 3, cy + 5, color)
    gui.line(cx + 3, cy - 4, cx - 2, cy, color)
    gui.line(cx - 2, cy, cx + 3, cy + 4, color)
}

fn draw_chevron_right(cx: Int, cy: Int, color: Int) {
    gui.line(cx - 3, cy - 5, cx + 3, cy, color)
    gui.line(cx + 3, cy, cx - 3, cy + 5, color)
    gui.line(cx - 3, cy - 4, cx + 2, cy, color)
    gui.line(cx + 2, cy, cx - 3, cy + 4, color)
}

fn draw_star(cx: Int, cy: Int, color: Int, filled: Bool) {
    gui.line(cx, cy - 8, cx + 2, cy - 3, color)
    gui.line(cx + 2, cy - 3, cx + 8, cy - 2, color)
    gui.line(cx + 8, cy - 2, cx + 3, cy + 1, color)
    gui.line(cx + 3, cy + 1, cx + 5, cy + 6, color)
    gui.line(cx + 5, cy + 6, cx, cy + 3, color)
    gui.line(cx, cy + 3, cx - 5, cy + 6, color)
    gui.line(cx - 5, cy + 6, cx - 3, cy + 1, color)
    gui.line(cx - 3, cy + 1, cx - 8, cy - 2, color)
    gui.line(cx - 8, cy - 2, cx - 2, cy - 3, color)
    gui.line(cx - 2, cy - 3, cx, cy - 8, color)
    if filled {
        gui.line(cx - 3, cy, cx + 3, cy, color)
        gui.line(cx - 2, cy + 2, cx + 2, cy + 2, color)
        gui.line(cx - 1, cy + 3, cx + 1, cy + 3, color)
    }
}

fn draw_download(cx: Int, cy: Int, color: Int) {
    gui.line(cx, cy - 7, cx, cy + 3, color)
    gui.line(cx + 1, cy - 7, cx + 1, cy + 3, color)
    gui.line(cx - 4, cy - 1, cx, cy + 4, color)
    gui.line(cx, cy + 4, cx + 4, cy - 1, color)
    gui.line(cx - 4, cy, cx, cy + 5, color)
    gui.line(cx, cy + 5, cx + 4, cy, color)
    gui.line(cx - 6, cy + 7, cx + 6, cy + 7, color)
}

fn draw_reload(cx: Int, cy: Int, color: Int) {
    gui.line(cx, cy - 7, cx + 5, cy - 5, color)
    gui.line(cx + 5, cy - 5, cx + 7, cy, color)
    gui.line(cx + 7, cy, cx + 5, cy + 5, color)
    gui.line(cx + 5, cy + 5, cx, cy + 7, color)
    gui.line(cx, cy + 7, cx - 5, cy + 5, color)
    gui.line(cx - 5, cy + 5, cx - 7, cy, color)
    gui.line(cx - 7, cy, cx - 5, cy - 5, color)
    gui.line(cx - 5, cy - 5, cx - 2, cy - 6, color)
    gui.line(cx + 2, cy - 8, cx + 5, cy - 5, color)
    gui.line(cx + 2, cy - 8, cx + 3, cy - 4, color)
}

// A speaker cone with two waves: the reader control.
fn draw_speaker(cx: Int, cy: Int, color: Int) {
    gui.line(cx - 8, cy - 3, cx - 4, cy - 3, color)
    gui.line(cx - 4, cy - 3, cx, cy - 7, color)
    gui.line(cx, cy - 7, cx, cy + 7, color)
    gui.line(cx, cy + 7, cx - 4, cy + 3, color)
    gui.line(cx - 4, cy + 3, cx - 8, cy + 3, color)
    gui.line(cx - 8, cy - 3, cx - 8, cy + 3, color)
    gui.line(cx + 4, cy - 4, cx + 6, cy - 2, color)
    gui.line(cx + 6, cy - 2, cx + 6, cy + 2, color)
    gui.line(cx + 6, cy + 2, cx + 4, cy + 4, color)
    gui.line(cx + 8, cy - 6, cx + 10, cy - 3, color)
    gui.line(cx + 10, cy - 3, cx + 10, cy + 3, color)
    gui.line(cx + 10, cy + 3, cx + 8, cy + 6, color)
}

fn draw_sidebar_glyph(cx: Int, cy: Int, color: Int) {
    gui.line(cx - 7, cy - 6, cx + 7, cy - 6, color)
    gui.line(cx - 7, cy + 6, cx + 7, cy + 6, color)
    gui.line(cx - 7, cy - 6, cx - 7, cy + 6, color)
    gui.line(cx + 7, cy - 6, cx + 7, cy + 6, color)
    gui.line(cx - 2, cy - 6, cx - 2, cy + 6, color)
}

// 1 back, 2 forward, 3 reload, 4 stop, 5 star, 6 star filled, 7 download,
// 8 help, 9 sidebar, 10 plus, 11 chevron right, 12 chevron left, 13 close,
// 14 speaker.
fn draw_glyph(kind: Int, x: Int, y: Int, ink: Int) {
    let cx = x + 15
    let cy = y + 15
    if kind == 1 {
        draw_chevron_left(cx - 3, cy, ink)
    } else if kind == 2 {
        draw_chevron_right(cx + 3, cy, ink)
    } else if kind == 3 {
        draw_reload(cx, cy, ink)
    } else if kind == 4 {
        draw_close(cx, cy, ink)
    } else if kind == 5 {
        draw_star(cx, cy - 1, ink, false)
    } else if kind == 6 {
        draw_star(cx, cy - 1, ink, true)
    } else if kind == 7 {
        draw_download(cx, cy - 1, ink)
    } else if kind == 8 {
        gui.text(cx - gui.text_width("?", 14) / 2, y + 7, "?", 14, ink)
    } else if kind == 9 {
        draw_sidebar_glyph(cx, cy, ink)
    } else if kind == 10 {
        draw_plus(cx, cy, ink)
    } else if kind == 11 {
        draw_chevron_right(cx, cy, ink)
    } else if kind == 12 {
        draw_chevron_left(cx, cy, ink)
    } else if kind == 13 {
        draw_close(cx, cy, ink)
    } else if kind == 14 {
        draw_speaker(cx, cy, ink)
    }
}

// The button is its glyph: no resting box, a rounded wash and a soft glow that
// follow the eased hover energy, and a dimmed ink when the action is disabled.
fn draw_icon_button(x: Int, y: Int, kind: Int, theme: Chrome, heat: Int, enabled: Bool, active: Bool) {
    if active {
        gui.round_rect(x, y, 30, 30, 8, theme.elevated)
    } else if heat > 0 {
        gui.round_rect(x, y, 30, 30, 8, blend(theme.panel, theme.elevated, heat))
    }
    if heat > 180 {
        glow(x, y, 30, 30, 8, theme.orange, heat / 10)
    }
    var ink = blend(theme.muted, theme.fg_bright, heat)
    if active {
        // A lit button, not an orange glyph: an orange square reads as a stray
        // box rather than a state.
        ink = theme.fg_bright
    }
    if !enabled {
        ink = blend(theme.panel, theme.muted, 420)
    }
    draw_glyph(kind, x, y, ink)
}

fn draw_tabs(session: Session, theme: Chrome, fx: Fx, rail_open: Bool) {
    let vertical = session.vertical
    let width = gui.width()
    let count = session.tabs.len()

    if !vertical {
        gui.rect(0, 0, width, 44, theme.panel)
        gui.line(0, 43, width, 43, theme.border_strong)
        // Tabs fill the strip. The plus that used to sit here took width from
        // every tab, so it is gone; Cmd+T, the vertical New Tab row and the tab
        // menu are the create paths.
        gui.clip(84, 0, width - 92, 44)
    } else if session.rail {
        draw_rail(session, theme, fx, rail_open)
        return
    } else {
        let span = sidebar_span(session)
        gui.rect(0, chrome_height(true), span + 1, gui.height() - chrome_height(true), theme.panel)
        gui.line(span, chrome_height(true), span, gui.height(), theme.border_strong)
        gui.mono(14, 71, "TABS", 9, theme.faint)
        let toggle = collapse_box(session)
        let heat = slot(fx, 12)
        if heat > 0 {
            gui.round_rect(toggle.x, toggle.y, toggle.w, toggle.h, 7, blend(theme.panel, theme.elevated, heat))
        }
        draw_chevron_left(toggle.x + 13, toggle.y + 13, blend(theme.muted, theme.fg_bright, heat))
    }

    var i = 0
    while i < count {
        let tab = session.tabs[i]
        let active = i == session.active
        let x = tab_box_x(session, i)
        let y = tab_box_y(i, vertical)
        let box_w = tab_box_w(count, vertical)
        let box_h = tab_box_h(vertical)
        let heat = slot(fx, 40 + i)
        if active {
            glow(x, y, box_w, box_h, 8, theme.orange, 30)
        }
        let fill = if active { theme.elevated } else { blend(theme.bg_hard, theme.elevated, heat) }
        gui.round_rect(x, y, box_w, box_h, 8, fill)
        if active {
            gui.rect(x + 8, y + box_h - 2, box_w - 16, 2, theme.orange)
        }
        let ink = if active { theme.fg_bright } else { blend(theme.muted, theme.fg, heat) }
        gui.clip(x + 10, y + 4, box_w - 34, box_h - 8)
        gui.text(x + 10, y + 7, tab_title(tab), 11, ink)
        gui.clip_reset()
        let close_heat = slot(fx, 50 + i)
        if close_heat > 0 {
            gui.round_rect(x + box_w - 24, y + 6, 18, 18, 6, blend(theme.panel, theme.red, close_heat / 2))
        }
        draw_close(x + box_w - 15, y + 15, if close_heat > 0 { theme.fg_bright } else { ink })
        if engine.page_state(tab.handle) == 1 {
            gui.rect(x + box_w - 34, y + 13, 5, 5, theme.orange)
        }
        i = i + 1
    }
    if !vertical {
        gui.clip_reset()
    } else {
        // New Tab grows under the list, which is where a vertical tab stack
        // wants its next row.
        let box = new_tab_box(session)
        let plus_heat = slot(fx, 8)
        gui.round_rect(box.x, box.y, box.w, box.h, 7, blend(theme.panel, theme.elevated, plus_heat))
        draw_plus(box.x + 16, box.y + box.h / 2, blend(theme.muted, theme.fg_bright, plus_heat))
        gui.text(box.x + 28, box.y + 8, "New Tab", 11, blend(theme.muted, theme.fg_bright, plus_heat))
    }
}

// The collapsed sidebar: numbered tab marks, New Tab under them, and a floating
// list of names while the pointer is on the rail.
fn draw_rail(session: Session, theme: Chrome, fx: Fx, open: Bool) {
    let strip = rail_width()
    let panel = rail_panel_width()
    let count = session.tabs.len()
    let head = collapse_box(session)
    let heat = slot(fx, 12)
    if heat > 0 {
        gui.round_rect(head.x, head.y, head.w, head.h, 7, blend(theme.panel, theme.elevated, heat))
    }
    draw_chevron_right(head.x + head.w / 2, head.y + head.h / 2, blend(theme.muted, theme.fg_bright, heat))

    var i = 0
    while i < count {
        let tab = session.tabs[i]
        let active = i == session.active
        let x = 4
        let y = tab_box_y(i, true)
        let w = strip - 8
        let h = slot(fx, 40 + i)
        if active {
            glow(x, y, w, 30, 8, theme.orange, 26)
        }
        gui.round_rect(x, y, w, 30, 8, if active { theme.elevated } else { blend(theme.bg_hard, theme.elevated, h) })
        if active {
            gui.rect(x + 1, y + 7, 2, 16, theme.orange)
        }
        let label = "${i + 1}"
        gui.text(x + (w - gui.text_width(label, 12)) / 2, y + 9, label, 12, if active { theme.fg_bright } else { blend(theme.muted, theme.fg, h) })
        if engine.page_state(tab.handle) == 1 {
            gui.rect(x + w - 8, y + 6, 4, 4, theme.orange)
        }
        i = i + 1
    }

    let box = new_tab_box(session)
    let plus_heat = slot(fx, 8)
    gui.round_rect(box.x, box.y, box.w, box.h, 7, blend(theme.panel, theme.elevated, plus_heat))
    draw_plus(box.x + box.w / 2, box.y + box.h / 2, blend(theme.muted, theme.fg_bright, plus_heat))

    if !open {
        return
    }
    // The panel floats over the page instead of reclaiming its width, so
    // crossing the rail no longer reflows the document. It is registered as an
    // overlay: the host paints it above the WebView and presses in the panel
    // column come back through the normal event queue.
    gui.rect(0, chrome_height(true), panel, gui.height() - chrome_height(true), theme.panel)
    gui.line(panel, chrome_height(true), panel, gui.height(), theme.border_strong)
    gui.mono(14, 71, "TABS", 9, theme.faint)
    var j = 0
    while j < count {
        let tab = session.tabs[j]
        let active = j == session.active
        let x = 8
        let y = tab_box_y(j, true)
        let w = panel - 16
        let h = slot(fx, 40 + j)
        if active {
            glow(x, y, w, 32, 8, theme.orange, 26)
        }
        gui.round_rect(x, y, w, 32, 8, if active { theme.elevated } else { blend(theme.bg_hard, theme.elevated, h) })
        if active {
            gui.rect(x + 8, y + 30, w - 16, 2, theme.orange)
        }
        gui.clip(x + 10, y + 4, w - 20, 24)
        gui.text(x + 10, y + 9, tab_title(tab), 11, if active { theme.fg_bright } else { blend(theme.muted, theme.fg, h) })
        gui.clip_reset()
        j = j + 1
    }
    let nb = panel_new_tab_box(session)
    let nb_heat = slot(fx, 8)
    gui.round_rect(nb.x, nb.y, nb.w, nb.h, 7, blend(theme.panel, theme.elevated, nb_heat))
    draw_plus(nb.x + 16, nb.y + nb.h / 2, blend(theme.muted, theme.fg_bright, nb_heat))
    gui.text(nb.x + 28, nb.y + 8, "New Tab", 11, blend(theme.muted, theme.fg_bright, nb_heat))
    gui.overlay(0, chrome_height(true), panel, gui.height() - chrome_height(true), true)
}

fn draw_address(handle: Int, theme: Chrome, address: Address, session: Session, fx: Fx, search: String) {
    let metrics = toolbar_metrics(session.vertical)
    let y = toolbar_y(session.vertical)
    let focus = if address.editing { fx.focus } else { 0 }
    if address.editing {
        glow(metrics.address, y, metrics.address_w, 34, 17, theme.orange, 26 + focus / 10)
    }
    // Border as a one-point rounded ring, then the fill inside it. stroke_rect
    // cannot take a radius, and its square outline was the box drawn around
    // the pill.
    gui.round_rect(metrics.address - 1, y - 1, metrics.address_w + 2, 36, 18, blend(theme.border, theme.orange, focus))
    gui.round_rect(metrics.address, y, metrics.address_w, 34, 17, blend(theme.input, theme.elevated, focus / 6))

    // Text starts at text_x; the field keeps 16 px of right padding. A long
    // URL scrolls with the caret instead of running under the padding.
    let text_x = address_text_x(session.vertical, address.editing)
    // Ink is clipped 16 px from the field edge and the chip is allowed to run
    // 4 px past that, so a long URL never has a glyph touching the chip's
    // rounded corner (which is what made the last character look unselected).
    let text_right = metrics.address + metrics.address_w - 16
    let chip_right = text_right + 4
    let visible = text_right - text_x
    let width = gui.text_width(address.text, 13)
    let lo = address_lo(address)
    let hi = address_hi(address)
    let selected = lo != hi
    let characters = address.text.chars()
    var scroll = 0
    if address.editing && address.text.len() > 0 {
        if selected && lo == 0 && hi == address_edit.char_count(address.text) && width > visible {
            // Chrome shows the end of the URL when everything is selected. With
            // the start pinned the tail was cut mid-glyph at the ink limit.
            scroll = width - visible
        } else {
            scroll = address_scroll(address.text, address.cursor, visible)
        }
    }

    if address.editing && selected && address.text.len() > 0 {
        // The chip hugs the selected glyphs; a whole-URL selection overflows it
        // to the ink limit, so the clipped end stays inside the highlight.
        let before = gui.text_width(address_edit.slice_chars(characters, 0, lo), 13)
        let span = gui.text_width(address_edit.slice_chars(characters, lo, hi), 13)
        var left = text_x - scroll + before - 3
        var right = left + span + 6
        if right > chip_right {
            right = chip_right
        }
        if left < text_x - 6 {
            left = metrics.address + 8
        }
        if right > left {
            // Gruvbox's selection token matches the border colour, which reads
            // as a border rather than a selection here; blend towards the blue
            // so the chip is obvious against the dark input.
            gui.round_rect(left, y + 7, right - left, 20, 4, blend(theme.input, gui.rgb(131, 165, 152), 480))
        }
    }

    if address.editing {
        // The chip names the engine that owns plain text; a press cycles it.
        let chip = address_chip_box(session.vertical)
        let heat = slot(fx, 10)
        gui.round_rect(chip.x - 1, chip.y - 1, chip.w + 2, chip.h + 2, 8, blend(theme.border, theme.orange, heat))
        gui.round_rect(chip.x, chip.y, chip.w, chip.h, 7, blend(theme.input, theme.elevated, heat))
        gui.text(chip.x + 9, chip.y + 6, search_initial(search), 12, blend(theme.muted, theme.orange, heat))
    }
    gui.clip(text_x - 6, y + 6, text_right - (text_x - 6), 24)
    if address.editing {
        let shown = if address.text.len() > 0 { address.text } else { "Enter an http(s) address" }
        let ink = if address.text.len() > 0 { theme.fg_bright } else { theme.muted }
        gui.text(text_x - scroll, y + 8, shown, 13, ink)
        if !selected && (gui.now() / 530) % 2 == 0 {
            let prefix = address_edit.slice_chars(address.text.chars(), 0, address.cursor)
            let caret_x = text_x + gui.text_width(prefix, 13) - scroll
            gui.rect(caret_x, y + 9, 1, 16, theme.orange)
        }
        // IME composition: committed text stays in the field, the marked text
        // is painted after the caret with a rule under it until the input
        // method commits or cancels it.
        let preedit = gui.marked_text()
        if preedit.len() > 0 {
            let prefix = address_edit.slice_chars(address.text.chars(), 0, address.cursor)
            let preedit_x = text_x + gui.text_width(prefix, 13) - scroll
            gui.text(preedit_x, y + 8, preedit, 13, theme.yellow)
            gui.rect(preedit_x, y + 25, gui.text_width(preedit, 13), 1, theme.yellow)
        }
    } else {
        let live = engine.page_url(handle)
        let fallback = if session.active >= 0 && session.active < session.tabs.len() { session.tabs[session.active].url } else { "" }
        let shown = if live.len() > 0 { live } else if fallback.contains("fixture.nova.invalid") { "Nova Browser · trusted fixture" } else { fallback }
        // The URL text already carries its scheme; the extra scheme square
        // showed up as a stray amber glyph on http pages, so it is gone.
        gui.text(text_x, y + 8, shown, 13, theme.fg)
    }
    gui.clip_reset()

    if address.error.len() > 0 {
        gui.clip(metrics.address + 12, y + 36, metrics.address_w - 24, 16)
        gui.text(metrics.address + 12, y + 35, address.error, 10, theme.red)
        gui.clip_reset()
    }
}

// Downloads are encoded as one line each so a list of them can cross function
// signatures: the current compiler rejects List<Struct> parameters.
//   ident<TAB>state<TAB>received<TAB>expected<TAB>escaped name<TAB>resumable
//   <TAB>escaped path
fn downloads_empty() -> Downloads {
    return Downloads { rows: [] }
}

// One encoded row per download so the shelf, the click paths and the frame
// signature all read the same snapshot:
//   ident<TAB>state<TAB>received<TAB>expected<TAB>escaped name<TAB>resumable
//   <TAB>escaped path
fn downloads_snapshot() -> Downloads {
    var rows: List<String> = []
    let count = engine.download_count()
    var i = 0
    while i < count {
        let ident = engine.download_id(i)
        let state = engine.download_state(ident)
        let received = engine.download_received(ident)
        let expected = engine.download_expected(ident)
        let name = library.escape(engine.download_name(ident))
        let path = library.escape(engine.download_path(ident))
        let resumable = if engine.download_resumable(ident) { 1 } else { 0 }
        rows.push("${ident}\t${state}\t${received}\t${expected}\t" + name + "\t${resumable}\t" + path)
        i = i + 1
    }
    return Downloads { rows: rows }
}

fn download_part(line: String, index: Int) -> String {
    let parts = line.split("\t")
    if index < 0 || index >= parts.len() {
        return ""
    }
    return parts[index]
}

fn download_ident(line: String) -> Int {
    return library.number_of(download_part(line, 0))
}

fn download_state_of(line: String) -> Int {
    return library.number_of(download_part(line, 1))
}

fn download_received_of(line: String) -> Int {
    return library.number_of(download_part(line, 2))
}

fn download_expected_of(line: String) -> Int {
    return library.number_of(download_part(line, 3))
}

fn download_name_of(line: String) -> String {
    return library.field(line, 4)
}

// 1 when WebKit produced resume data and the originating view is still alive.
fn download_resumable_of(line: String) -> Int {
    return library.number_of(download_part(line, 5))
}

// The destination path is kept on the row so a history row can reveal its file
// after the WebKit download object is gone.
fn download_path_of(line: String) -> String {
    return library.field(line, 6)
}

fn path_in(paths: List<String>, path: String) -> Bool {
    for item in paths {
        if item == path {
            return true
        }
    }
    return false
}

// One persisted line per completed download:
//   bytes<TAB>when<TAB>escaped path<TAB>escaped name
fn download_history_has_path(history: List<String>, path: String) -> Bool {
    for line in history {
        if library.field(line, 2) == path {
            return true
        }
    }
    return false
}

// History rows reuse the shelf encoding with a negative ident, so they can never
// collide with a live WebKit download and the click paths stay the same.
fn download_history_row(line: String, index: Int) -> String {
    let bytes = library.number_of(download_part(line, 0))
    let name = library.field(line, 3)
    let path = library.field(line, 2)
    let ident = 0 - (index + 1)
    return "${ident}\t2\t${bytes}\t${bytes}\t" + library.escape(name) + "\t0\t" + library.escape(path)
}

// Live transfers first, then completed files from earlier sessions. A history
// row hides while a live row with the same path is still on screen.
fn downloads_view(store: Store) -> Downloads {
    var rows: List<String> = []
    var live_paths: List<String> = []
    let live = downloads_snapshot()
    for item in live.rows {
        rows.push(item)
        live_paths.push(download_path_of(item))
    }
    var i = 0
    while i < store.download_history.len() {
        let line = store.download_history[i]
        let path = library.field(line, 2)
        if path.len() > 0 && !path_in(live_paths, path) {
            rows.push(download_history_row(line, i))
        }
        i = i + 1
    }
    return Downloads { rows: rows }
}

// Persists one completed download straight to disk. `--download` runs exit
// before the frame loop, so they use this instead of `record_downloads`.
fn remember_download(path: String, name: String, bytes: Int) {
    let store = load_store()
    if path.len() == 0 || download_history_has_path(store.download_history, path) {
        return
    }
    var listed: List<String> = []
    for existing in store.download_history {
        listed.push(existing)
    }
    listed.push("${bytes}\t${gui.now()}\t" + library.escape(path) + "\t" + library.escape(name))
    gui.write(store.downloads_path, library.join_records(listed))
}

// Writes a completed download into the profile once. Called from the frame loop
// with the merged list; the path check makes repeated frames idempotent.
fn record_downloads(store: Store, downloads: Downloads) -> Store {
    var next = store
    for item in downloads.rows {
        if download_state_of(item) == 2 {
            let path = download_path_of(item)
            if path.len() > 0 && !download_history_has_path(next.download_history, path) {
                var listed: List<String> = []
                for existing in next.download_history {
                    listed.push(existing)
                }
                listed.push("${download_received_of(item)}\t${gui.now()}\t" + library.escape(path) + "\t" + library.escape(download_name_of(item)))
                if listed.len() > 20 {
                    var kept: List<String> = []
                    var i = listed.len() - 20
                    while i < listed.len() {
                        kept.push(listed[i])
                        i = i + 1
                    }
                    listed = kept
                }
                next.download_history = listed
                next.dirty_downloads = true
            }
        }
    }
    return next
}

// Drops WebKit's finished rows and the persisted history together, so the next
// frame cannot re-record the paths that were just cleared.
fn clear_finished_downloads(store: Store) -> Store {
    engine.download_clear_finished()
    var next = store
    if next.download_history.len() > 0 {
        next.download_history = library.empty()
        next.dirty_downloads = true
    }
    return next
}

fn downloads_running(downloads: Downloads) -> Int {
    var count = 0
    for item in downloads.rows {
        let state = download_state_of(item)
        if state == 0 || state == 1 {
            count = count + 1
        }
    }
    return count
}

fn download_shelf_box(downloads: Downloads) -> Box {
    var rows = downloads.rows.len()
    if rows == 0 {
        rows = 1
    }
    let width = 348
    let height = 40 + rows * 46 + 8
    return Box { x: gui.width() - width - 18, y: gui.height() - height - 18, w: width, h: height }
}

fn download_row_box(downloads: Downloads, index: Int) -> Box {
    let shelf = download_shelf_box(downloads)
    return Box { x: shelf.x + 8, y: shelf.y + 40 + index * 46, w: shelf.w - 16, h: 42 }
}

fn download_action_box(downloads: Downloads, index: Int) -> Box {
    let row = download_row_box(downloads, index)
    return Box { x: row.x + row.w - 34, y: row.y + 8, w: 26, h: 26 }
}

fn download_close_box(downloads: Downloads) -> Box {
    let shelf = download_shelf_box(downloads)
    return Box { x: shelf.x + shelf.w - 30, y: shelf.y + 8, w: 22, h: 22 }
}

// Only drawn while the profile has completed files to forget.
fn download_clear_box(downloads: Downloads) -> Box {
    let shelf = download_shelf_box(downloads)
    return Box { x: shelf.x + shelf.w - 96, y: shelf.y + 8, w: 58, h: 22 }
}

fn draw_downloads(theme: Chrome, store: Store, downloads: Downloads, fx: Fx) {
    if !store.downloads_open {
        return
    }
    let shelf = download_shelf_box(downloads)
    gui.rect_alpha(shelf.x + 3, shelf.y + 6, shelf.w, shelf.h, 0, 80)
    gui.round_rect(shelf.x, shelf.y, shelf.w, shelf.h, 12, theme.elevated)
    gui.stroke(shelf.x, shelf.y, shelf.w, shelf.h, theme.border_strong)
    gui.text(shelf.x + 14, shelf.y + 13, "Downloads", 13, theme.fg_bright)
    let close = download_close_box(downloads)
    if slot(fx, 120) > 0 {
        gui.round_rect(close.x, close.y, close.w, close.h, 5, blend(theme.elevated, theme.border_strong, slot(fx, 120)))
    }
    gui.text(close.x + 7, close.y + 4, "×", 12, theme.muted)
    if store.download_history.len() > 0 {
        let clear = download_clear_box(downloads)
        if slot(fx, 121) > 0 {
            gui.round_rect(clear.x, clear.y, clear.w, clear.h, 5, blend(theme.elevated, theme.border_strong, slot(fx, 121)))
        }
        gui.text(clear.x + 12, clear.y + 4, "Clear", 10, theme.muted)
    }

    if downloads.rows.len() == 0 {
        gui.text(shelf.x + 14, shelf.y + 46, "No downloads yet", 11, theme.muted)
    }

    var i = 0
    while i < downloads.rows.len() {
        let item = downloads.rows[i]
        let state = download_state_of(item)
        let received = download_received_of(item)
        let expected = download_expected_of(item)
        let row = download_row_box(downloads, i)
        let heat = slot(fx, 130 + i)
        gui.round_rect(row.x, row.y, row.w, row.h, 8, blend(theme.elevated, theme.selection, heat))
        gui.clip(row.x + 10, row.y + 4, row.w - 54, 18)
        gui.text(row.x + 10, row.y + 5, download_name_of(item), 11, theme.fg_bright)
        gui.clip_reset()
        let resumable = download_resumable_of(item)
        var status_text = "Starting…"
        if state == 1 {
            status_text = "${library.size_text(received)} of ${library.size_text(expected)}"
        } else if state == 5 {
            if resumable == 1 {
                status_text = "Paused · click to resume"
            } else {
                status_text = "Paused · cannot resume"
            }
        } else if state == 2 {
            status_text = "Done · ${library.size_text(received)}"
        } else if state == 3 {
            if resumable == 1 {
                status_text = "Failed · click to retry"
            } else {
                status_text = "Failed"
            }
        } else if state == 4 {
            status_text = "Cancelled"
        }
        gui.text(row.x + 10, row.y + 22, status_text, 10, theme.muted)
        if (state == 1 || state == 5) && expected > 0 {
            let percent = library.percent_of(received, expected)
            gui.rect(row.x + 10, row.y + row.h - 6, row.w - 56, 2, theme.panel)
            gui.rect(row.x + 10, row.y + row.h - 6, (row.w - 56) * percent / 100, 2, theme.orange)
        }
        let action = download_action_box(downloads, i)
        let action_heat = slot(fx, 140 + i)
        let action_fill = if state == 0 || state == 1 { theme.red } else { theme.border_strong }
        gui.round_rect(action.x, action.y, action.w, action.h, 6, blend(theme.elevated, action_fill, action_heat))
        gui.text(action.x + 8, action.y + 5, if state == 0 || state == 1 { "×" } else { "↗" }, 12, theme.fg)
        i = i + 1
    }
}

fn download_signature(downloads: Downloads) -> String {
    return library.join_records(downloads.rows)
}

fn tooltip_text(target: Int) -> String {
    if target == 1 {
        return "Back"
    }
    if target == 2 {
        return "Forward"
    }
    if target == 3 {
        return "Reload"
    }
    if target == 5 {
        return "Bookmark (Cmd+D)"
    }
    if target == 14 {
        return "Read aloud · pause, speed, voice (Cmd+Shift+L)"
    }
    if target == 6 {
        return "Nova docs"
    }
    if target == 7 {
        return "Tabs: top / sidebar / rail (Cmd+Shift+E)"
    }
    if target == 11 {
        return "Collapse or pin the tab sidebar"
    }
    if target == 8 {
        return "New tab (Cmd+T)"
    }
    if target == 9 {
        return "Downloads"
    }
    if target == 10 {
        return "Search engine · click to switch"
    }
    return ""
}

fn draw_tooltip(theme: Chrome, tooltip: Tooltip) {
    if tooltip.text.len() == 0 {
        return
    }
    let width = gui.text_width(tooltip.text, 11) + 20
    var x = tooltip.x + 10
    var y = tooltip.y + 18
    if x + width > gui.width() - 8 {
        x = gui.width() - width - 8
    }
    if y + 26 > gui.height() - 8 {
        y = tooltip.y - 32
    }
    gui.round_rect(x, y, width, 26, 7, theme.bg_hard)
    gui.stroke(x, y, width, 26, theme.border_strong)
    gui.text(x + 10, y + 6, tooltip.text, 11, theme.fg_bright)
}

fn draw_toolbar(handle: Int, theme: Chrome, address: Address, session: Session, fx: Fx, store: Store, downloads: Downloads) {
    let vertical = session.vertical
    let metrics = toolbar_metrics(vertical)
    let y = toolbar_y(vertical)

    if vertical {
        gui.rect(0, 0, gui.width(), chrome_height(true) - 1, theme.panel)
        gui.line(0, chrome_height(true) - 1, gui.width(), chrome_height(true) - 1, theme.border_strong)
    } else {
        // A shallow top-down wash instead of one flat fill: the strip picks up
        // light near the window edge the way modern chrome does.
        gui.rect(0, 44, gui.width(), chrome_height(false) - 45, theme.panel)
        var band = 0
        while band < 6 {
            gui.rect(0, 44 + band * 12, gui.width(), 12, blend(theme.panel, theme.elevated, 40 - band * 8))
            band = band + 1
        }
        gui.line(0, chrome_height(false) - 1, gui.width(), chrome_height(false) - 1, theme.border_strong)
    }

    let state = engine.page_state(handle)
    let loading = state == 1
    draw_icon_button(metrics.back, y + 2, 1, theme, slot(fx, 1), engine.can_go_back(handle), false)
    draw_icon_button(metrics.forward, y + 2, 2, theme, slot(fx, 2), engine.can_go_forward(handle), false)
    draw_icon_button(metrics.reload, y + 2, if loading { 4 } else { 3 }, theme, slot(fx, 3), true, loading)

    draw_address(handle, theme, address, session, fx, store.search)

    // The speaker turns into the same wheel the panel draws while Kokoro is
    // synthesizing, so a shortcut read still shows it is working.
    if speech.synthesizing() {
        draw_reader_spinner(metrics.voice + 15, y + 17, theme.orange)
    } else {
        draw_icon_button(metrics.voice, y + 2, 14, theme, slot(fx, 10), true, speech.speaking())
    }

    let live = engine.page_url(handle)
    let bookmarked = library.has_bookmark(store.bookmarks, live)
    draw_icon_button(metrics.star, y + 2, if bookmarked { 6 } else { 5 }, theme, slot(fx, 5), true, bookmarked)
    let running = downloads_running(downloads)
    draw_icon_button(metrics.downloads, y + 2, 7, theme, slot(fx, 9), true, store.downloads_open)
    if running > 0 {
        gui.round_rect(metrics.downloads + 21, y, 11, 11, 5, theme.orange)
        gui.text(metrics.downloads + 24, y - 1, "${running}", 8, theme.bg_hard)
    }
    draw_icon_button(metrics.docs, y + 2, 8, theme, slot(fx, 6), true, false)
    draw_icon_button(metrics.layout, y + 2, 9, theme, slot(fx, 7), true, vertical)

    gui.mono(metrics.label, y + 10, "WEBKIT", 10, theme.orange)

    if !vertical {
        let title = engine.page_title(handle)
        gui.clip(88, 84, gui.width() - 320, 22)
        gui.text(88, 84, if title.len() > 0 { title } else { "Nova Browser" }, 13, theme.fg_bright)
        gui.clip_reset()

        let loaded = state == 2
        let detail = if state == 3 {
            "error"
        } else if address.error.len() > 0 {
            address.error
        } else if address.editing {
            "editing · Enter opens · Tab completes"
        } else if loading {
            "loading"
        } else if session.tabs.len() > 1 {
            "ready · ${session.tabs.len()} tabs"
        } else {
            state_word(state)
        }
        let color = if state == 3 || address.error.len() > 0 {
            theme.red
        } else if address.editing || loading {
            theme.orange
        } else if loaded {
            theme.green
        } else {
            theme.muted
        }
        gui.mono(gui.width() - 12 - gui.mono_width(detail, 10), 86, detail, 10, color)
    }
}

fn draw_progress(handle: Int, theme: Chrome, session: Session) {
    let left = page_left(session)
    let span = gui.width() - left
    if span <= 0 {
        return
    }
    let y = page_top(session) - 2
    gui.rect(left, y, span, 2, theme.panel)
    var value = engine.page_progress(handle)
    if value < 40 {
        value = 40
    }
    let bar = span * value / 1000
    gui.rect(left, y, bar, 2, theme.orange)
    let span_full = span + 160
    let sheen = (gui.now() / 5) % span_full - 80
    if sheen > 0 && sheen < bar {
        var width = 60
        if width > bar - sheen {
            width = bar - sheen
        }
        gui.rect(left + sheen, y, width, 2, theme.yellow)
    }
    // Sparks ride the filled part of the bar. Positions come from the clock, so
    // nothing is stored and there is no allocation per frame.
    var spark = 0
    while spark < 7 {
        let phase = (gui.now() / 3 + spark * 137) % 1000
        let px = left + bar * phase / 1000
        let fade = 88 - phase / 12
        if fade > 0 {
            gui.rect_alpha(px, y - 2, 2, 5, theme.orange, fade)
        }
        spark = spark + 1
    }
}

fn draw_suggestions(theme: Chrome, address: Address, session: Session, suggestions: List<String>, fx: Fx) {
    if !address.editing || suggestions.len() == 0 {
        return
    }
    let metrics = toolbar_metrics(session.vertical)
    let top = suggestion_top(session.vertical)
    let rows = smaller(suggestions.len(), sug_rows())
    let height = rows * sug_row_height() + 8
    gui.rect_alpha(metrics.address - 3, top + 4, metrics.address_w + 6, height, 0, 90)
    gui.round_rect(metrics.address, top, metrics.address_w, height, 10, theme.elevated)
    gui.stroke(metrics.address, top, metrics.address_w, height, theme.border_strong)

    var i = 0
    while i < rows {
        let item = suggestions[i]
        let kind = library.field(item, 0)
        let url = library.field(item, 1)
        let title = library.field(item, 2)
        let ry = top + 4 + i * sug_row_height()
        let heat = if address.highlight == i { 1000 } else { slot(fx, 60 + i) }
        gui.round_rect(metrics.address + 4, ry, metrics.address_w - 8, sug_row_height() - 2, 6, blend(theme.elevated, theme.selection, heat))
        if kind == "search" {
            // A drawn magnifier rather than a glyph: no font-coverage gamble.
            gui.stroke(metrics.address + 13, ry + 8, 8, 8, theme.orange)
            gui.line(metrics.address + 20, ry + 15, metrics.address + 24, ry + 19, theme.orange)
        } else {
            gui.text(metrics.address + 12, ry + 4, if kind == "bookmark" { "★" } else { "◦" }, 11, if kind == "bookmark" { theme.orange } else { theme.muted })
        }
        gui.clip(metrics.address + 28, ry + 2, metrics.address_w - 40, sug_row_height() - 6)
        let shown = if title.len() > 0 { title } else { url }
        gui.text(metrics.address + 28, ry + 3, shown, 12, blend(theme.fg, theme.fg_bright, heat))
        gui.mono(metrics.address + 28, ry + 19, url, 10, theme.muted)
        gui.clip_reset()
        i = i + 1
    }
    // The list is taller than the chrome band, so the host must paint it above
    // the page view; without this it is covered from page_top downward.
    gui.overlay(metrics.address - 3, top, metrics.address_w + 6, height + 4, true)
}

// Local minimum: the GUI module already exports a `min`, and a qualified call
// to it is mis-resolved by the current compiler.
fn smaller(a: Int, b: Int) -> Int {
    if a < b {
        return a
    }
    return b
}

fn wrap_text(text: String, size: Int, width: Int) -> List<String> {
    var lines: List<String> = []
    var current = ""
    for word in text.split(" ") {
        let candidate = if current.len() == 0 { word } else { current + " " + word }
        if current.len() > 0 && gui.text_width(candidate, size) > width {
            lines.push(current)
            current = word
        } else {
            current = candidate
        }
    }
    if current.len() > 0 {
        lines.push(current)
    }
    return lines
}

fn draw_failure(handle: Int, theme: Chrome, session: Session, fx: Fx) {
    let left = page_left(session)
    let top = page_top(session)
    let width = gui.width() - left
    let height = gui.height() - top
    gui.rect(left, top, width, height, theme.bg_hard)

    let card = failure_card(session)
    let message = engine.page_error(handle)
    let kind = status.kind(message)
    let accent = if kind == "certificate" { theme.red } else if kind == "offline" { theme.yellow } else { theme.orange }
    gui.round_rect(card.x, card.y, card.w, card.h, 14, theme.panel)
    gui.stroke(card.x, card.y, card.w, card.h, theme.border_strong)
    gui.rect(card.x + 24, card.y + 24, 40, 4, accent)
    gui.text(card.x + 24, card.y + 40, status.title(kind), 22, theme.fg_bright)

    let lines = wrap_text(status.hint(kind), 13, card.w - 48)
    var i = 0
    while i < lines.len() {
        gui.text(card.x + 24, card.y + 78 + i * 20, lines[i], 13, theme.fg)
        i = i + 1
    }

    let target = engine.page_error_url(handle)
    let live = engine.page_url(handle)
    let fallback = if session.active >= 0 && session.active < session.tabs.len() { session.tabs[session.active].url } else { "" }
    let shown = if target.len() > 0 { target } else if live.len() > 0 { live } else { fallback }
    gui.clip(card.x + 24, card.y + 128, card.w - 48, 18)
    gui.mono(card.x + 24, card.y + 128, shown, 10, theme.muted)
    gui.clip_reset()

    let detail = status.detail(message)
    gui.clip(card.x + 24, card.y + 152, card.w - 48, 18)
    gui.text(card.x + 24, card.y + 152, detail, 11, theme.faint)
    gui.clip_reset()

    if status.can_retry(kind) {
        let button = failure_retry(session)
        gui.round_rect(button.x, button.y, button.w, button.h, 8, blend(theme.orange, theme.fg_bright, slot(fx, 90)))
        gui.text(button.x + 22, button.y + 9, "Try Again", 13, theme.bg_hard)
    }
    if engine.can_go_back(handle) {
        let button = failure_back(session)
        gui.round_rect(button.x, button.y, button.w, button.h, 8, blend(theme.elevated, theme.border_strong, slot(fx, 91)))
        gui.text(button.x + 18, button.y + 9, "Back", 13, theme.fg)
    }
    if !status.can_retry(kind) && !engine.can_go_back(handle) {
        gui.text(card.x + 24, card.y + card.h - 50, "Press Cmd+L to edit the address", 12, theme.muted)
    }
}

fn draw_notice(theme: Chrome, session: Session, notice: Notice) {
    if notice.text.len() == 0 || gui.now() > notice.until {
        return
    }
    let width = gui.text_width(notice.text, 12) + 32
    let x = page_left(session) + 18
    let y = gui.height() - 54
    gui.round_rect(x, y, width, 34, 9, theme.elevated)
    gui.stroke(x, y, width, 34, theme.border_strong)
    gui.text(x + 16, y + 9, notice.text, 12, theme.fg_bright)
}

// ---------- accessibility ----------

// Pushes the chrome controls for the frame that was just drawn. Living in the
// draw path keeps labels and rectangles from drifting away from the pixels; the
// host turns the list into NSAccessibilityElement children on demand. The page
// is a WKWebView and brings its own tree, so only Nova-owned chrome is listed.
fn ax_chrome(handle: Int, session: Session, address: Address, suggestions: List<String>, downloads: Downloads, store: Store) {
    gui.ax_begin()
    let vertical = session.vertical
    let count = session.tabs.len()
    var i = 0
    while i < count {
        let tab = session.tabs[i]
        let shown = if tab.title.len() > 0 { tab.title } else if tab.fixture { "New Tab" } else { tab.url }
        let selected = if i == session.active { 1 } else { 0 }
        if session.rail {
            gui.ax_tab(4, tab_box_y(i, true), rail_width() - 8, 30, shown, selected)
        } else {
            gui.ax_tab(tab_box_x(session, i), tab_box_y(i, vertical), tab_box_w(count, vertical), tab_box_h(vertical), shown, selected)
        }
        i = i + 1
    }
    let metrics = toolbar_metrics(vertical)
    let by = toolbar_y(vertical) + 2
    let state = engine.page_state(handle)
    gui.ax_button(metrics.back, by, 30, 30, "Back")
    gui.ax_button(metrics.forward, by, 30, 30, "Forward")
    if state == 1 {
        gui.ax_button(metrics.reload, by, 30, 30, "Stop loading")
    } else {
        gui.ax_button(metrics.reload, by, 30, 30, "Reload")
    }
    var shown_address = address.text
    if !address.editing {
        let live = engine.page_url(handle)
        let fallback = if session.active >= 0 && session.active < count { session.tabs[session.active].url } else { "" }
        shown_address = if live.len() > 0 { live } else { fallback }
    }
    gui.ax_field(metrics.address, toolbar_y(vertical), metrics.address_w, 34, "Address", shown_address)
    if address.editing {
        let chip = address_chip_box(vertical)
        gui.ax_button(chip.x, chip.y, chip.w, chip.h, "Search engine: " + address_edit.search_label(store.search))
    }
    let read_label = if speech.speaking() { "Stop reading" } else { "Listen to this page" }
    gui.ax_button(metrics.voice, by, 30, 30, read_label)
    gui.ax_button(metrics.star, by, 30, 30, "Bookmark")
    gui.ax_button(metrics.downloads, by, 30, 30, "Downloads")
    gui.ax_button(metrics.docs, by, 30, 30, "Nova docs")
    gui.ax_button(metrics.layout, by, 30, 30, "Tab layout")
    gui.ax_label(metrics.label, toolbar_y(vertical) + 10, gui.mono_width("WEBKIT", 10), 14, "Rendering engine: WebKit")
    if vertical {
        let plus = new_tab_box(session)
        gui.ax_button(plus.x, plus.y, plus.w, plus.h, "New tab")
        let toggle = collapse_box(session)
        gui.ax_button(toggle.x, toggle.y, toggle.w, toggle.h, if session.rail { "Expand tab sidebar" } else { "Collapse tab sidebar" })
    }
    if state == 3 {
        let retry = failure_retry(session)
        gui.ax_button(retry.x, retry.y, retry.w, retry.h, "Try Again")
        if engine.can_go_back(handle) {
            let back = failure_back(session)
            gui.ax_button(back.x, back.y, back.w, back.h, "Back")
        }
    }
    if store.downloads_open {
        ax_downloads(downloads, store)
    }
    ax_suggestions(address, session, suggestions)
}

// The shelf draws its own rows, so its controls must be named here too: the
// label carries the file name because VoiceOver reads children out of order.
fn ax_downloads(downloads: Downloads, store: Store) {
    let shelf = download_shelf_box(downloads)
    let close = download_close_box(downloads)
    gui.ax_button(close.x, close.y, close.w, close.h, "Close downloads")
    if store.download_history.len() > 0 {
        let clear = download_clear_box(downloads)
        gui.ax_button(clear.x, clear.y, clear.w, clear.h, "Clear finished downloads")
    }
    if downloads.rows.len() == 0 {
        gui.ax_label(shelf.x + 14, shelf.y + 46, 140, 14, "No downloads yet")
        return
    }
    var i = 0
    while i < downloads.rows.len() {
        let item = downloads.rows[i]
        let name = download_name_of(item)
        let state = download_state_of(item)
        let row = download_row_box(downloads, i)
        let action = download_action_box(downloads, i)
        if state == 1 {
            gui.ax_button(row.x, row.y, row.w, row.h, "Pause " + name)
            gui.ax_button(action.x, action.y, action.w, action.h, "Cancel " + name)
        } else if state == 5 {
            gui.ax_button(row.x, row.y, row.w, row.h, "Resume " + name)
            gui.ax_button(action.x, action.y, action.w, action.h, "Cancel " + name)
        } else if state == 3 && download_resumable_of(item) == 1 {
            gui.ax_button(row.x, row.y, row.w, row.h, "Retry " + name)
            gui.ax_button(action.x, action.y, action.w, action.h, "Show " + name + " in Finder")
        } else if state == 0 {
            gui.ax_label(row.x, row.y, row.w, row.h, name)
            gui.ax_button(action.x, action.y, action.w, action.h, "Cancel " + name)
        } else {
            gui.ax_label(row.x, row.y, row.w, row.h, name)
            gui.ax_button(action.x, action.y, action.w, action.h, "Show " + name + " in Finder")
        }
        i = i + 1
    }
}

fn ax_suggestions(address: Address, session: Session, suggestions: List<String>) {
    if !address.editing || suggestions.len() == 0 {
        return
    }
    let metrics = toolbar_metrics(session.vertical)
    let top = suggestion_top(session.vertical)
    let rows = smaller(suggestions.len(), sug_rows())
    var i = 0
    while i < rows {
        let item = suggestions[i]
        let url = library.field(item, 1)
        let title = library.field(item, 2)
        let shown = if title.len() > 0 { title } else { url }
        gui.ax_link(metrics.address + 4, top + 4 + i * sug_row_height(), metrics.address_w - 8, sug_row_height() - 2, shown, url)
        i = i + 1
    }
}

// The reader panel is drawn chrome too, so its controls are pushed as elements
// while it is open. Closed, it publishes nothing and the toolbar's count stands.
fn ax_reader(store: Store, open: Bool) {
    if !open {
        return
    }
    let panel = reader_panel_box(store)
    gui.ax_label(panel.x + 8, panel.y + 6, panel.w - 16, 18, "Read aloud")
    if speech.synthesizing() {
        gui.ax_label(panel.x + 8, panel.y + 24, panel.w - 16, 18, "Synthesizing with Kokoro, ${speech.synth_elapsed_ms() / 1000} seconds so far")
    } else if speech.synth_phase() == 4 {
        gui.ax_label(panel.x + 8, panel.y + 24, panel.w - 16, 18, "Kokoro synthesis failed: " + speech.synth_detail())
    }
    let primary = reader_primary_box(store)
    let label = if speech.speaking() { "Pause reading" } else if speech.paused() { "Resume reading" } else { "Read this page" }
    gui.ax_button(primary.x, primary.y, primary.w, primary.h, label)
    let stop = reader_stop_box(store)
    gui.ax_button(stop.x, stop.y, stop.w, stop.h, "Stop reading")
    let slower = reader_slower_box(store)
    gui.ax_button(slower.x, slower.y, slower.w, slower.h, "Slower")
    let faster = reader_faster_box(store)
    gui.ax_button(faster.x, faster.y, faster.w, faster.h, "Faster")
    let voices = reader_voices()
    var i = 0
    while i < voices.len() {
        let box = reader_voice_box(store, i)
        gui.ax_button(box.x, box.y, box.w, box.h, "Voice " + library.field(voices[i], 1))
        i = i + 1
    }
    if reader_kokoro_row() {
        let box = reader_kokoro_box(store)
        gui.ax_button(box.x, box.y, box.w, box.h, if speech.kokoro_usable() { "Kokoro voice" } else { "Kokoro needs a synthesizer" })
    }
    if reader_download_row() {
        let box = reader_model_box(store)
        gui.ax_button(box.x, box.y, box.w, box.h, "Download voice model")
    }
}

fn draw_chrome(handle: Int, theme: Chrome, address: Address, session: Session, suggestions: List<String>, fx: Fx, notice: Notice, store: Store, hover: Int, downloads: Downloads, tooltip: Tooltip, rail_open: Bool, reader_open: Bool, fetching: Bool, received: Int) {
    gui.clear(theme.bg_hard)
    gui.overlay_begin()
    draw_tabs(session, theme, fx, rail_open)
    draw_toolbar(handle, theme, address, session, fx, store, downloads)
    let state = engine.page_state(handle)
    if state == 1 {
        draw_progress(handle, theme, session)
    }
    if state == 3 {
        draw_failure(handle, theme, session, fx)
    }
    draw_downloads(theme, store, downloads, fx)
    draw_suggestions(theme, address, session, suggestions, fx)
    draw_reader_panel(theme, store, reader_open, fetching, received, hover)
    draw_notice(theme, session, notice)
    draw_tooltip(theme, tooltip)
    ax_chrome(handle, session, address, suggestions, downloads, store)
    ax_reader(store, reader_open)
}

// ---------- input ----------

// The pointer advertises what a press would do, the way a page shows a hand
// over a link: a hand over anything that acts, an I-beam over the address
// field, an arrow elsewhere and over buttons that are disabled.
fn cursor_for(handle: Int, hover: Int) -> Int {
    if hover == 4 {
        return gui.cursor_text()
    }
    if hover == 1 && !engine.can_go_back(handle) {
        return gui.cursor_arrow()
    }
    if hover == 2 && !engine.can_go_forward(handle) {
        return gui.cursor_arrow()
    }
    if hover > 0 {
        return gui.cursor_hand()
    }
    return gui.cursor_arrow()
}

fn hover_target(x: Int, y: Int, session: Session, address: Address, suggestions: List<String>, downloads: Downloads, shelf_open: Bool, store: Store, reader_open: Bool) -> Int {
    let vertical = session.vertical
    if reader_open {
        let panel = reader_panel_box(store)
        if gui.inside(panel.x, panel.y, panel.w, panel.h, x, y) {
            let primary = reader_primary_box(store)
            if gui.inside(primary.x, primary.y, primary.w, primary.h, x, y) {
                return 160
            }
            let stop = reader_stop_box(store)
            if gui.inside(stop.x, stop.y, stop.w, stop.h, x, y) {
                return 163
            }
            let slower = reader_slower_box(store)
            if gui.inside(slower.x, slower.y, slower.w, slower.h, x, y) {
                return 161
            }
            let faster = reader_faster_box(store)
            if gui.inside(faster.x, faster.y, faster.w, faster.h, x, y) {
                return 162
            }
            var i = 0
            while i < reader_voices().len() {
                let box = reader_voice_box(store, i)
                if gui.inside(box.x, box.y, box.w, box.h, x, y) {
                    return 170 + i
                }
                i = i + 1
            }
            if reader_kokoro_row() {
                let box = reader_kokoro_box(store)
                if gui.inside(box.x, box.y, box.w, box.h, x, y) {
                    return 178
                }
            }
            if reader_download_row() {
                let box = reader_model_box(store)
                if gui.inside(box.x, box.y, box.w, box.h, x, y) {
                    return 164
                }
            }
            return 0 - 1
        }
    }
    if address.editing && suggestions.len() > 0 {
        let metrics = toolbar_metrics(vertical)
        let top = suggestion_top(vertical)
        let rows = smaller(suggestions.len(), sug_rows())
        let bottom = top + rows * sug_row_height() + 8
        if x >= metrics.address && x <= metrics.address + metrics.address_w && y >= top && y < bottom {
            var row = (y - top - 4) / sug_row_height()
            if row < 0 {
                row = 0
            }
            if row >= rows {
                row = rows - 1
            }
            return 60 + row
        }
    }

    if shelf_open {
        let shelf = download_shelf_box(downloads)
        if gui.inside(shelf.x, shelf.y, shelf.w, shelf.h, x, y) {
            let close = download_close_box(downloads)
            if gui.inside(close.x, close.y, close.w, close.h, x, y) {
                return 120
            }
            var row = 0
            while row < downloads.rows.len() {
                let action = download_action_box(downloads, row)
                if gui.inside(action.x, action.y, action.w, action.h, x, y) {
                    return 140 + row
                }
                let box = download_row_box(downloads, row)
                if gui.inside(box.x, box.y, box.w, box.h, x, y) {
                    return 130 + row
                }
                row = row + 1
            }
            return 0 - 1
        }
    }

    if y < chrome_height(vertical) {
        let metrics = toolbar_metrics(vertical)
        let by = toolbar_y(vertical) + 2
        if gui.inside(metrics.back, by, 30, 30, x, y) {
            return 1
        }
        if gui.inside(metrics.forward, by, 30, 30, x, y) {
            return 2
        }
        if gui.inside(metrics.reload, by, 30, 30, x, y) {
            return 3
        }
        if address.editing {
            let chip = address_chip_box(vertical)
            if gui.inside(chip.x, chip.y, chip.w, chip.h, x, y) {
                return 10
            }
        }
        if gui.inside(metrics.address, toolbar_y(vertical), metrics.address_w, 34, x, y) {
            return 4
        }
        if gui.inside(metrics.voice, by, 30, 30, x, y) {
            return 14
        }
        if gui.inside(metrics.star, by, 30, 30, x, y) {
            return 5
        }
        if gui.inside(metrics.docs, by, 30, 30, x, y) {
            return 6
        }
    if gui.inside(metrics.layout, by, 30, 30, x, y) {
            return 7
        }
        if gui.inside(metrics.downloads, by, 30, 30, x, y) {
            return 9
        }
        if !vertical && y < 44 {
            var i = 0
            while i < session.tabs.len() {
                let tx = tab_box_x(session, i)
                let tw = tab_box_w(session.tabs.len(), false)
                if gui.inside(tx, 8, tw, 30, x, y) {
                    if x >= tx + tw - 24 {
                        return 50 + i
                    }
                    return 40 + i
                }
                i = i + 1
            }
            }
    }

    if vertical && y >= chrome_height(true) {
        let toggle = collapse_box(session)
        if gui.inside(toggle.x, toggle.y, toggle.w, toggle.h, x, y) {
            return 11
        }
        if session.rail {
            let plus = new_tab_box(session)
            if gui.inside(plus.x, plus.y, plus.w, plus.h, x, y) {
                return 8
            }
            var i = 0
            if x < rail_width() {
                while i < session.tabs.len() {
                    let box = rail_tab_box(i)
                    if gui.inside(box.x, box.y, box.w, box.h, x, y) {
                        return 40 + i
                    }
                    i = i + 1
                }
                return 0 - 1
            }
            if x < rail_panel_width() {
                let nb = panel_new_tab_box(session)
                if gui.inside(nb.x, nb.y, nb.w, nb.h, x, y) {
                    return 8
                }
                while i < session.tabs.len() {
                    let box = overlay_tab_box(i)
                    if gui.inside(box.x, box.y, box.w, box.h, x, y) {
                        return 40 + i
                    }
                    i = i + 1
                }
            }
            return 0 - 1
        }
        if x < sidebar_width() {
            var i = 0
            while i < session.tabs.len() {
                let tx = tab_box_x(session, i)
                let ty = tab_box_y(i, true)
                let tw = tab_box_w(session.tabs.len(), true)
                if gui.inside(tx, ty, tw, 32, x, y) {
                    if x >= tx + tw - 26 {
                        return 50 + i
                    }
                    return 40 + i
                }
                i = i + 1
            }
            let plus = new_tab_box(session)
            if gui.inside(plus.x, plus.y, plus.w, plus.h, x, y) {
                return 8
            }
        }
    }
    return 0 - 1
}

fn click_action(session: Session, address: Address, store: Store, notice: Notice) -> ClickAction {
    return ClickAction {
        session: session,
        address: address,
        store: store,
        notice: notice,
        reader: 0,
        fetch: 0,
    }
}

fn click_reader(session: Session, address: Address, store: Store, notice: Notice, reader: Int, fetch: Int) -> ClickAction {
    return ClickAction {
        session: session,
        address: address,
        store: store,
        notice: notice,
        reader: reader,
        fetch: fetch,
    }
}

fn toggle_bookmark(handle: Int, store: Store) -> Imported {
    let url = engine.page_url(handle)
    if url.len() == 0 || url.contains("fixture.nova.invalid") {
        return Imported { store: store, message: "Nothing to bookmark yet" }
    }
    var next = store
    let host = library.host_of(url)
    var message = "Bookmarked " + host
    if library.has_bookmark(store.bookmarks, url) {
        next.bookmarks = library.remove_bookmark(store.bookmarks, url)
        message = "Bookmark removed"
    } else {
        let title = engine.page_title(handle)
        next.bookmarks = library.add_bookmark(store.bookmarks, url, title)
    }
    next.dirty_bookmarks = true
    return Imported { store: next, message: message }
}

fn open_new_tab(session: Session, store: Store, notice: Notice) -> ClickAction {
    let next = append_tab(session, new_fixture_tab(gui.native_view(), gui.width(), gui.height()))
    engine.focus_chrome(active_handle(next))
    return click_action(next, address_begin(""), store, notice)
}

fn handle_click(handle: Int, x: Int, y: Int, clicks: Int, current: Address, session: Session, suggestions: List<String>, store: Store, downloads: Downloads, reader_open: Bool) -> ClickAction {
    let count = session.tabs.len()
    let notice = Notice { text: "", until: 0 }

    // The reader panel floats above the page, so its rows take presses before
    // anything behind them.
    if reader_open {
        let panel = reader_panel_box(store)
        if gui.inside(panel.x, panel.y, panel.w, panel.h, x, y) {
            let primary = reader_primary_box(store)
            if gui.inside(primary.x, primary.y, primary.w, primary.h, x, y) {
                return click_reader(session, current, store, reader_toggle(handle, store), 1, 0)
            }
            let stop = reader_stop_box(store)
            if gui.inside(stop.x, stop.y, stop.w, stop.h, x, y) {
                speech.stop_reading()
                return click_reader(session, current, store, Notice { text: "Reading stopped", until: gui.now() + 1800 }, 1, 0)
            }
            let slower = reader_slower_box(store)
            if gui.inside(slower.x, slower.y, slower.w, slower.h, x, y) {
                return click_reader(session, current, store, set_rate(store, stored_rate(store) - 25), 1, 0)
            }
            let faster = reader_faster_box(store)
            if gui.inside(faster.x, faster.y, faster.w, faster.h, x, y) {
                return click_reader(session, current, store, set_rate(store, stored_rate(store) + 25), 1, 0)
            }
            let voices = reader_voices()
            var vi = 0
            while vi < voices.len() {
                let box = reader_voice_box(store, vi)
                if gui.inside(box.x, box.y, box.w, box.h, x, y) {
                    let row = voices[vi]
                    let quality = library.field(row, 3)
                    let tag = if quality == "2" { " · premium" } else if quality == "1" { " · enhanced" } else { "" }
                    save_setting(store, "voice", library.field(row, 0))
                    save_setting(store, "engine", "system")
                    speech.use_engine("system")
                    return click_reader(session, current, store, Notice {
                        text: "Voice: " + library.field(row, 1) + tag + " · next reading",
                        until: gui.now() + 3200,
                    }, 1, 0)
                }
                vi = vi + 1
            }
            if reader_kokoro_row() {
                let box = reader_kokoro_box(store)
                if gui.inside(box.x, box.y, box.w, box.h, x, y) {
                    if speech.kokoro_usable() {
                        return click_reader(session, current, store, choose_engine(store, "kokoro"), 1, 0)
                    }
                    return click_reader(session, current, store, Notice {
                        text: "Kokoro needs a synthesizer command · install kokoro-tts or set NOVA_KOKORO_CMD",
                        until: gui.now() + 5600,
                    }, 1, 0)
                }
            }
            if reader_download_row() {
                let box = reader_model_box(store)
                if gui.inside(box.x, box.y, box.w, box.h, x, y) {
                    if gui.term_running() {
                        return click_action(session, current, store, notice)
                    }
                    return click_reader(session, current, store, notice, 1, 1)
                }
            }
            return click_action(session, current, store, notice)
        }
    }

    // Failure panel owns the page area while it is visible.
    if engine.page_state(handle) == 3 {
        if gui.inside(failure_retry(session).x, failure_retry(session).y, failure_retry(session).w, failure_retry(session).h, x, y) {
            engine.reload(handle)
            engine.focus_page(handle)
            return click_action(session, address_cancel(current), store, notice)
        }
        if gui.inside(failure_back(session).x, failure_back(session).y, failure_back(session).w, failure_back(session).h, x, y) {
            engine.back(handle)
            return click_action(session, address_cancel(current), store, notice)
        }
        return click_action(session, current, store, notice)
    }

    // Downloads shelf owns its own rectangle.
    if store.downloads_open {
        let shelf = download_shelf_box(downloads)
        if gui.inside(shelf.x, shelf.y, shelf.w, shelf.h, x, y) {
            let close = download_close_box(downloads)
            if gui.inside(close.x, close.y, close.w, close.h, x, y) {
                var closed = store
                closed.downloads_open = false
                return click_action(session, current, closed, notice)
            }
            if store.download_history.len() > 0 {
                let clear = download_clear_box(downloads)
                if gui.inside(clear.x, clear.y, clear.w, clear.h, x, y) {
                    return click_action(session, current, clear_finished_downloads(store), Notice {
                        text: "Cleared finished downloads",
                        until: gui.now() + 2200,
                    })
                }
            }
            var row = 0
            while row < downloads.rows.len() {
                let action = download_action_box(downloads, row)
                if gui.inside(action.x, action.y, action.w, action.h, x, y) {
                    let item = downloads.rows[row]
                    let state = download_state_of(item)
                    if state == 0 || state == 1 {
                        engine.download_cancel(download_ident(item))
                        return click_action(session, current, store, Notice {
                            text: "Download cancelled",
                            until: gui.now() + 2200,
                        })
                    }
                    if state == 2 {
                        let path = download_path_of(item)
                        if gui.reveal(path) {
                            return click_action(session, current, store, notice)
                        }
                        return click_action(session, current, store, Notice {
                            text: "This file is no longer there",
                            until: gui.now() + 2400,
                        })
                    }
                    engine.download_reveal(download_ident(item))
                    return click_action(session, current, store, notice)
                }
                let box = download_row_box(downloads, row)
                if gui.inside(box.x, box.y, box.w, box.h, x, y) {
                    let item = downloads.rows[row]
                    let ident = download_ident(item)
                    let state = download_state_of(item)
                    if state == 1 {
                        if engine.download_pause(ident) {
                            return click_action(session, current, store, Notice {
                                text: "Download paused · click to resume",
                                until: gui.now() + 2600,
                            })
                        }
                    }
                    if state == 2 {
                        let path = download_path_of(item)
                        if gui.reveal(path) {
                            return click_action(session, current, store, notice)
                        }
                        return click_action(session, current, store, Notice {
                            text: "This file is no longer there",
                            until: gui.now() + 2400,
                        })
                    }
                    if state == 3 || state == 5 {
                        if download_resumable_of(item) == 1 {
                            if engine.download_resume(ident) {
                                return click_action(session, current, store, Notice {
                                    text: "Download resumed",
                                    until: gui.now() + 2200,
                                })
                            }
                        }
                        return click_action(session, current, store, Notice {
                            text: "This download cannot resume",
                            until: gui.now() + 2400,
                        })
                    }
                    return click_action(session, current, store, notice)
                }
                row = row + 1
            }
            return click_action(session, current, store, notice)
        }
    }

    // Open suggestion rows.
    if current.editing && suggestions.len() > 0 {
        let metrics = toolbar_metrics(session.vertical)
        let top = suggestion_top(session.vertical)
        let rows = smaller(suggestions.len(), sug_rows())
        if x >= metrics.address && x <= metrics.address + metrics.address_w && y >= top && y < top + rows * sug_row_height() + 8 {
            var row = (y - top - 4) / sug_row_height()
            if row < 0 {
                row = 0
            }
            if row >= rows {
                row = rows - 1
            }
            let url = library.field(suggestions[row], 1)
            engine.navigate(handle, url)
            engine.focus_page(handle)
            return click_action(session, address_open(current, url), store, notice)
        }
    }

    if session.vertical {
        if y >= chrome_height(true) {
            let toggle = collapse_box(session)
            if gui.inside(toggle.x, toggle.y, toggle.w, toggle.h, x, y) {
                var next = session
                next.rail = !session.rail
                save_layout(store, next.vertical, next.rail)
                return click_action(next, address_idle(), store, Notice {
                    text: if next.rail { "Sidebar collapsed · hover the rail" } else { "Sidebar pinned" },
                    until: gui.now() + 2400,
                })
            }
            if session.rail && x >= rail_width() && x < rail_panel_width() {
                let nb = panel_new_tab_box(session)
                if gui.inside(nb.x, nb.y, nb.w, nb.h, x, y) {
                    return open_new_tab(session, store, notice)
                }
                var i = 0
                while i < count {
                    let box = overlay_tab_box(i)
                    if gui.inside(box.x, box.y, box.w, box.h, x, y) {
                        return click_action(select_tab(session, i), address_idle(), store, notice)
                    }
                    i = i + 1
                }
                return click_action(session, current, store, notice)
            }
            let plus = new_tab_box(session)
            if gui.inside(plus.x, plus.y, plus.w, plus.h, x, y) {
                return open_new_tab(session, store, notice)
            }
            if session.rail {
                var i = 0
                if x < rail_width() {
                    while i < count {
                        let box = rail_tab_box(i)
                        if gui.inside(box.x, box.y, box.w, box.h, x, y) {
                            return click_action(select_tab(session, i), address_idle(), store, notice)
                        }
                        i = i + 1
                    }
                }
                return click_action(session, current, store, notice)
            }
            if x < sidebar_width() {
                var i = 0
                while i < count {
                    let tx = tab_box_x(session, i)
                    let ty = tab_box_y(i, true)
                    let tw = tab_box_w(count, true)
                    if gui.inside(tx, ty, tw, 32, x, y) {
                        if x >= tx + tw - 26 {
                            return click_action(close_tab(session, i, gui.native_view(), gui.width(), gui.height()), address_idle(), store, notice)
                        }
                        return click_action(select_tab(session, i), address_idle(), store, notice)
                    }
                    i = i + 1
                }
            }
            return click_action(session, current, store, notice)
        }
    } else if y < 44 {
        var i = 0
        while i < count {
            let tx = tab_box_x(session, i)
            let tw = tab_box_w(count, false)
            if gui.inside(tx, 8, tw, 30, x, y) {
                if x >= tx + tw - 24 {
                    return click_action(close_tab(session, i, gui.native_view(), gui.width(), gui.height()), address_idle(), store, notice)
                }
                return click_action(select_tab(session, i), address_idle(), store, notice)
            }
            i = i + 1
        }
        return click_action(session, current, store, notice)
    }

    if y >= page_top(session) {
        return click_action(session, current, store, notice)
    }

    let metrics = toolbar_metrics(session.vertical)
    let by = toolbar_y(session.vertical) + 2
    if current.editing {
        let chip = address_chip_box(session.vertical)
        if gui.inside(chip.x, chip.y, chip.w, chip.h, x, y) {
            let provider = address_edit.next_search_provider(store.search)
            save_setting(store, "search", provider)
            var next_store = store
            next_store.search = provider
            return click_action(session, current, next_store, Notice {
                text: "Search: " + address_edit.search_label(provider),
                until: gui.now() + 2600,
            })
        }
    }
    if gui.inside(metrics.address, toolbar_y(session.vertical), metrics.address_w, 34, x, y) {
        engine.focus_chrome(handle)
        let live = engine.page_url(handle)
        let scroll = address_scroll(live, address_edit.char_count(live), metrics.address_w - 34)
        let at = address_caret_at(live, x - address_text_x(session.vertical, true) + scroll)
        // Chrome's rule: a press on an unfocused field selects the whole URL,
        // so typing replaces it; later presses place the caret, and a
        // double-click takes the word under the pointer.
        if clicks >= 3 || !current.editing {
            return click_action(session, address_select_all(address_begin_cursor(live, 0)), store, notice)
        }
        if clicks == 2 {
            return click_action(session, address_select_word(address_begin_cursor(live, at), at), store, notice)
        }
        return click_action(session, address_begin_cursor(live, at), store, notice)
    }

    var next_address = current
    if next_address.editing {
        next_address = address_cancel(next_address)
    }
    if gui.inside(metrics.back, by, 30, 30, x, y) {
        engine.back(handle)
        return click_action(session, next_address, store, notice)
    }
    if gui.inside(metrics.forward, by, 30, 30, x, y) {
        engine.forward(handle)
        return click_action(session, next_address, store, notice)
    }
    if gui.inside(metrics.reload, by, 30, 30, x, y) {
        if engine.page_state(handle) == 1 {
            engine.stop(handle)
        } else {
            engine.reload(handle)
        }
        return click_action(session, next_address, store, notice)
    }
    if gui.inside(metrics.voice, by, 30, 30, x, y) {
        // The speaker is the reader's door: it opens the panel, whose first row
        // reads or pauses. Cmd+Shift+L still reads immediately.
        return click_reader(session, next_address, store, notice, if reader_open { 0 - 1 } else { 1 }, 0)
    }
    if gui.inside(metrics.star, by, 30, 30, x, y) {
        let toggled = toggle_bookmark(handle, store)
        return click_action(session, next_address, toggled.store, Notice { text: toggled.message, until: gui.now() + 2600 })
    }
    if gui.inside(metrics.downloads, by, 30, 30, x, y) {
        var opened = store
        opened.downloads_open = !store.downloads_open
        return click_action(session, next_address, opened, notice)
    }
    if gui.inside(metrics.docs, by, 30, 30, x, y) {
        engine.navigate(handle, "https://jd4rider.github.io/nova/")
        engine.focus_page(handle)
        return click_action(session, next_address, store, notice)
    }
    if gui.inside(metrics.layout, by, 30, 30, x, y) {
        let next = toggle_layout(session)
        save_layout(store, next.vertical, next.rail)
        return click_action(next, next_address, store, Notice {
            text: layout_notice(next),
            until: gui.now() + 2400,
        })
    }
    return click_action(session, next_address, store, notice)
}

fn key_action(session: Session, address: Address, store: Store, notice: Notice, close: Bool) -> KeyAction {
    return KeyAction {
        session: session,
        address: address,
        store: store,
        notice: notice,
        close: close,
        reader: 0,
    }
}

fn key_reader(session: Session, address: Address, store: Store, notice: Notice, reader: Int, close: Bool) -> KeyAction {
    return KeyAction {
        session: session,
        address: address,
        store: store,
        notice: notice,
        close: close,
        reader: reader,
    }
}

// Boolean comparison is not accepted in a compound condition, so frame
// signatures keep bivalent state as 0/1.
fn flag(value: Bool) -> Int {
    if value {
        return 1
    }
    return 0
}

fn notice_idle() -> Notice {
    return Notice { text: "", until: 0 }
}

// ---------- reading aloud ----------
// The page text comes from WebKit (document.body.innerText); the voice comes
// from the host. Nothing here claims a voice the machine does not have.

fn stored_voice(store: Store) -> String {
    if store.settings_path.len() == 0 {
        return ""
    }
    return library.setting_value(gui.read(store.settings_path), "voice")
}

// Which engine reads: the system voices by default, Kokoro only when the user
// picked it and it can actually run. The environment override exists so a test
// can exercise either engine without clicking.
fn stored_engine(store: Store) -> String {
    let forced = gui.env("NOVA_BROWSER_ENGINE").trim()
    if forced.len() > 0 {
        return forced
    }
    if store.settings_path.len() == 0 {
        return "system"
    }
    if library.setting_value(gui.read(store.settings_path), "engine") == "kokoro" {
        return "kokoro"
    }
    return "system"
}

fn choose_engine(store: Store, engine: String) -> Notice {
    save_setting(store, "engine", engine)
    speech.use_engine(engine)
    if engine == "kokoro" {
        return Notice {
            text: "Voice: Kokoro · synthesizing can take a while",
            until: gui.now() + 3600,
        }
    }
    return Notice { text: "Voice: the built-in macOS voices", until: gui.now() + 2600 }
}

fn english_voices() -> List<String> {
    var rows: List<String> = []
    for row in speech.voice_rows() {
        if library.field(row, 2).starts_with("en") {
            rows.push(row)
        }
    }
    return rows
}

fn voice_label(id: String) -> String {
    for row in speech.voice_rows() {
        if library.field(row, 0) == id {
            return library.field(row, 1)
        }
    }
    return "the system voice"
}

fn toggle_listen(handle: Int, store: Store) -> Notice {
    if !speech.voice_available() {
        return Notice { text: "Speech is not available on this system", until: gui.now() + 2600 }
    }
    if speech.speaking() {
        speech.stop_reading()
        return Notice { text: "Reading stopped", until: gui.now() + 1800 }
    }
    let text = engine.body_text(handle).trim()
    if text.len() == 0 {
        return Notice { text: "Nothing to read on this page", until: gui.now() + 2400 }
    }
    let chosen = stored_engine(store)
    speech.use_engine(chosen)
    var fallback = ""
    if chosen == "kokoro" && !speech.kokoro_usable() {
        // Say why instead of quietly reading in a different voice. The panel
        // row is where Kokoro gets set up; this is the shortcut path.
        fallback = speech.voice_note()
        speech.use_engine("system")
    }
    var id = stored_voice(store)
    if id.len() == 0 {
        id = speech.default_voice()
    }
    if !speech.say(text, id, stored_rate(store)) {
        return Notice { text: "Could not start reading", until: gui.now() + 2400 }
    }
    if fallback.len() > 0 {
        return Notice { text: fallback + " · reading with " + voice_label(id), until: gui.now() + 5600 }
    }
    if chosen == "kokoro" {
        return Notice {
            text: "Synthesizing with Kokoro · this can take a while",
            until: gui.now() + 4200,
        }
    }
    let note = speech.voice_note()
    if note.len() > 0 {
        return Notice { text: note + " · reading with " + voice_label(id), until: gui.now() + 3800 }
    }
    return Notice { text: "Reading with " + voice_label(id), until: gui.now() + 2400 }
}

fn cycle_voice(store: Store) -> Notice {
    let rows = english_voices()
    if rows.len() == 0 {
        return Notice { text: "No English voices installed", until: gui.now() + 2400 }
    }
    let current = stored_voice(store)
    var next = 0
    var i = 0
    while i < rows.len() {
        if library.field(rows[i], 0) == current {
            next = (i + 1) % rows.len()
        }
        i = i + 1
    }
    let id = library.field(rows[next], 0)
    save_setting(store, "voice", id)
    let quality = library.field(rows[next], 3)
    let tag = if quality == "2" { " · premium" } else if quality == "1" { " · enhanced" } else { "" }
    return Notice {
        text: "Voice: " + library.field(rows[next], 1) + " · " + library.field(rows[next], 2) + tag,
        until: gui.now() + 3200,
    }
}

// Speed is stored as a percentage of the system default, the same unit the host
// takes. Absent or out of range means the calm 50% default.
fn stored_rate(store: Store) -> Int {
    if store.settings_path.len() == 0 {
        return 50
    }
    let rate = library.number_of(library.setting_value(gui.read(store.settings_path), "voice_rate"))
    if rate < 25 {
        return 50
    }
    if rate > 200 {
        return 200
    }
    return rate
}

fn set_rate(store: Store, rate: Int) -> Notice {
    var value = rate
    if value < 25 {
        value = 25
    }
    if value > 200 {
        value = 200
    }
    save_setting(store, "voice_rate", "${value}")
    return Notice { text: "Reading speed: ${value}% · next reading", until: gui.now() + 2400 }
}

// The panel lists at most eight English voices: enough to compare, small enough
// that it never needs a scrollbar over the page.
fn reader_voices() -> List<String> {
    var rows: List<String> = []
    for row in english_voices() {
        if rows.len() < 8 {
            rows.push(row)
        }
    }
    return rows
}

// Panel geometry reads a native count instead of the row list: every row box
// asks for the panel box, so enumerating voices here re-ran the list per row.
fn reader_voice_slots() -> Int {
    let count = speech.voice_english_count()
    if count > 8 {
        return 8
    }
    return count
}

// A Kokoro row joins the list once its model is installed; the download row
// appears while it is missing and a build asks for it. Keeping these as
// geometry helpers means the painter, hit test and accessibility all agree.
fn reader_kokoro_row() -> Bool {
    return speech.kokoro_ready()
}

fn reader_download_row() -> Bool {
    return speech.kokoro_wanted() && !speech.kokoro_ready()
}

fn reader_voice_total() -> Int {
    if reader_kokoro_row() {
        return reader_voice_slots() + 1
    }
    return reader_voice_slots()
}

fn reader_panel_box(store: Store) -> Box {
    var height = 124 + reader_voice_total() * 24
    if reader_download_row() {
        height = height + 24
    }
    let metrics = toolbar_metrics(false)
    var x = metrics.voice - 18
    if x + 300 > gui.width() - 8 {
        x = gui.width() - 308
    }
    if x < 8 {
        x = 8
    }
    return Box { x: x, y: suggestion_top(false), w: 300, h: height }
}

fn reader_primary_box(store: Store) -> Box {
    let panel = reader_panel_box(store)
    return Box { x: panel.x + 8, y: panel.y + 26, w: panel.w - 84, h: 28 }
}

fn reader_stop_box(store: Store) -> Box {
    let panel = reader_panel_box(store)
    return Box { x: panel.x + panel.w - 68, y: panel.y + 26, w: 60, h: 28 }
}

fn reader_slower_box(store: Store) -> Box {
    let panel = reader_panel_box(store)
    return Box { x: panel.x + panel.w - 92, y: panel.y + 60, w: 26, h: 24 }
}

fn reader_faster_box(store: Store) -> Box {
    let panel = reader_panel_box(store)
    return Box { x: panel.x + panel.w - 34, y: panel.y + 60, w: 26, h: 24 }
}

fn reader_voice_box(store: Store, index: Int) -> Box {
    let panel = reader_panel_box(store)
    return Box { x: panel.x + 8, y: panel.y + 108 + index * 24, w: panel.w - 16, h: 22 }
}

fn reader_kokoro_box(store: Store) -> Box {
    return reader_voice_box(store, reader_voice_slots())
}

fn reader_model_box(store: Store) -> Box {
    let panel = reader_panel_box(store)
    return Box { x: panel.x + 8, y: panel.y + 112 + reader_voice_total() * 24, w: panel.w - 16, h: 24 }
}

// A wheel, not a fake percentage: eight dots chase each other while the
// synthesizer runs, and the elapsed time beside them is the host's clock.
fn reader_spinner_dx(i: Int) -> Int {
    if i == 0 {
        return 7
    }
    if i == 1 {
        return 5
    }
    if i == 2 {
        return 0
    }
    if i == 3 {
        return 0 - 5
    }
    if i == 4 {
        return 0 - 7
    }
    if i == 5 {
        return 0 - 5
    }
    if i == 6 {
        return 0
    }
    return 5
}

fn reader_spinner_dy(i: Int) -> Int {
    if i == 0 {
        return 0
    }
    if i == 1 {
        return 5
    }
    if i == 2 {
        return 7
    }
    if i == 3 {
        return 5
    }
    if i == 4 {
        return 0
    }
    if i == 5 {
        return 0 - 5
    }
    if i == 6 {
        return 0 - 7
    }
    return 0 - 5
}

fn draw_reader_spinner(cx: Int, cy: Int, color: Int) {
    let tick = (gui.now() / 90) % 8
    var i = 0
    while i < 8 {
        let lead = (tick - i + 8) % 8
        var alpha = 0
        if lead == 0 {
            alpha = 255
        } else if lead == 1 {
            alpha = 150
        } else if lead == 2 {
            alpha = 60
        }
        if alpha > 0 {
            gui.round_rect_alpha(cx + reader_spinner_dx(i) - 1, cy + reader_spinner_dy(i) - 1, 3, 3, 1, color, alpha)
        }
        i = i + 1
    }
}

fn draw_reader_panel(theme: Chrome, store: Store, open: Bool, fetching: Bool, received: Int, hover: Int) {
    if !open {
        return
    }
    let panel = reader_panel_box(store)
    let voices = reader_voices()
    let rate = stored_rate(store)
    let current = stored_voice(store)
    let primary = reader_primary_box(store)
    let stop = reader_stop_box(store)
    let slower = reader_slower_box(store)
    let faster = reader_faster_box(store)

    gui.rect_alpha(panel.x - 4, panel.y - 4, panel.w + 8, panel.h + 8, 0, 90)
    gui.round_rect(panel.x, panel.y, panel.w, panel.h, 10, theme.elevated)
    gui.stroke(panel.x, panel.y, panel.w, panel.h, theme.border_strong)
    gui.text(panel.x + 12, panel.y + 8, "Read aloud", 12, theme.fg_bright)
    // The header carries one state word, and the synthesizer's own clock when
    // it is the one working. No progress percentage: the host cannot know how
    // long a model will take, so it reports loading, synthesizing, playing.
    let phase = speech.synth_phase()
    if phase == 1 {
        let ms = speech.synth_elapsed_ms()
        let stamp = "SYNTHESIZING ${ms / 1000}.${(ms % 1000) / 100}s"
        let width = gui.mono_width(stamp, 9)
        draw_reader_spinner(panel.x + panel.w - 18 - width, panel.y + 14, theme.orange)
        gui.mono(panel.x + panel.w - 12 - width, panel.y + 10, stamp, 9, theme.orange)
        let track = panel.w - 24
        let seg = track / 3
        let travel = (gui.now() / 9) % 120
        gui.rect_alpha(panel.x + 12, panel.y + 24, track, 2, theme.orange, 60)
        gui.round_rect(panel.x + 12 + (track - seg) * travel / 120, panel.y + 24, seg, 2, 1, theme.orange)
    } else if phase == 3 {
        let word = "KOKORO"
        gui.mono(panel.x + panel.w - 12 - gui.mono_width(word, 9), panel.y + 10, word, 9, theme.orange)
    } else if phase == 4 {
        let word = "FAILED"
        gui.mono(panel.x + panel.w - 12 - gui.mono_width(word, 9), panel.y + 10, word, 9, theme.red)
    } else if speech.speaking() || speech.paused() {
        let word = if speech.paused() { "PAUSED" } else { "SPEAKING" }
        gui.mono(panel.x + panel.w - 12 - gui.mono_width(word, 9), panel.y + 10, word, 9, theme.orange)
    }

    let primary_heat = if hover == 160 { 1000 } else { 0 }
    gui.round_rect(primary.x, primary.y, primary.w, primary.h, 7, blend(theme.bg_hard, theme.selection, primary_heat))
    let label = if speech.speaking() { "Pause" } else if speech.paused() { "Resume" } else { "Read this page" }
    gui.text(primary.x + 10, primary.y + 7, label, 12, theme.fg_bright)

    let stop_heat = if hover == 163 { 1000 } else { 0 }
    gui.round_rect(stop.x, stop.y, stop.w, stop.h, 7, blend(theme.bg_hard, theme.red, stop_heat / 2))
    gui.text(stop.x + 13, stop.y + 7, "Stop", 12, theme.fg)

    gui.text(panel.x + 12, panel.y + 64, "Speed", 11, theme.muted)
    gui.mono(panel.x + panel.w - 64, panel.y + 65, "${rate}%", 10, theme.fg_bright)
    let slow_heat = if hover == 161 { 1000 } else { 0 }
    gui.round_rect(slower.x, slower.y, slower.w, slower.h, 6, blend(theme.bg_hard, theme.selection, slow_heat))
    gui.text(slower.x + 9, slower.y + 4, "−", 12, theme.fg_bright)
    let fast_heat = if hover == 162 { 1000 } else { 0 }
    gui.round_rect(faster.x, faster.y, faster.w, faster.h, 6, blend(theme.bg_hard, theme.selection, fast_heat))
    gui.text(faster.x + 9, faster.y + 4, "+", 12, theme.fg_bright)

    gui.mono(panel.x + 12, panel.y + 92, "VOICE", 9, theme.faint)
    var i = 0
    while i < voices.len() {
        let row = voices[i]
        let box = reader_voice_box(store, i)
        let id = library.field(row, 0)
        let quality = library.field(row, 3)
        let selected = id == current || (current.len() == 0 && i == 0)
        let heat = if hover == 170 + i { 700 } else { 0 }
        if selected || heat > 0 {
            gui.round_rect(box.x, box.y, box.w, box.h, 6, blend(theme.elevated, theme.selection, if selected { 900 } else { heat }))
        }
        gui.clip(box.x + 6, box.y + 2, box.w - 74, box.h - 4)
        gui.text(box.x + 8, box.y + 4, library.field(row, 1), 11, if selected { theme.fg_bright } else { theme.fg })
        gui.clip_reset()
        let tag = if quality == "2" { "premium" } else if quality == "1" { "enhanced" } else { "" }
        if tag.len() > 0 {
            gui.mono(box.x + box.w - 62, box.y + 6, tag, 8, theme.muted)
        }
        if selected {
            gui.text(box.x + box.w - 20, box.y + 4, "✓", 11, theme.orange)
        }
        i = i + 1
    }

    // Kokoro is a choice, not a default: built-in voices stay selected unless
    // someone asks. Without a synthesizer command the row says so instead of
    // offering a voice that would fail after a long wait.
    if reader_kokoro_row() {
        let box = reader_kokoro_box(store)
        let usable = speech.kokoro_usable()
        let selected = stored_engine(store) == "kokoro"
        let heat = if hover == 178 { 700 } else { 0 }
        if selected || heat > 0 {
            gui.round_rect(box.x, box.y, box.w, box.h, 6, blend(theme.elevated, theme.selection, if selected { 900 } else { heat }))
        }
        gui.clip(box.x + 6, box.y + 2, box.w - 78, box.h - 4)
        gui.text(box.x + 8, box.y + 4, if usable { "Kokoro · 82M" } else { "Kokoro · needs a synthesizer" }, 11, if selected { theme.fg_bright } else if usable { theme.fg } else { theme.muted })
        gui.clip_reset()
        gui.mono(box.x + box.w - 58, box.y + 6, if usable { "neural" } else { "setup" }, 8, theme.muted)
        if selected {
            gui.text(box.x + box.w - 20, box.y + 4, "✓", 11, theme.orange)
        }
    }

    if reader_download_row() {
        let box = reader_model_box(store)
        let heat = if hover == 164 { 700 } else { 0 }
        gui.round_rect(box.x, box.y, box.w, box.h, 6, blend(theme.elevated, theme.selection, heat))
        var text = "Download voice model · 86 MB"
        var ink = theme.fg
        if fetching {
            var percent = received * 100 / voice_model_expected()
            if percent > 99 {
                percent = 99
            }
            text = "Downloading voice model · ${percent}%"
            ink = theme.orange
        }
        gui.text(box.x + 8, box.y + 5, text, 10, ink)
    }

    // The panel hangs below the toolbar over the page, so it has to be copied
    // above the WebView; its rows also take the presses the page would get.
    gui.overlay(panel.x - 4, panel.y - 4, panel.w + 8, panel.h + 8, true)
}

// ---------- voice model ----------
// Kokoro needs two things: a model file and an inference runtime. This build
// can fetch the model into the profile (the prerequisite), and reports honestly
// that the runtime is still missing rather than pretending to synthesize.

fn voice_model_dir() -> String {
    return profile_root() + "/kokoro"
}

fn voice_model_path() -> String {
    return voice_model_dir() + "/model.onnx"
}

fn voice_model_part() -> String {
    return voice_model_dir() + "/model.onnx.part"
}

fn voice_model_url() -> String {
    let override = gui.env("NOVA_KOKORO_URL").trim()
    if override.len() > 0 {
        return override
    }
    return "https://huggingface.co/onnx-community/Kokoro-82M-v1.0-ONNX/resolve/main/onnx/model_quantized.onnx"
}

fn voice_model_expected() -> Int {
    return 92000000
}

fn voice_model_min_bytes() -> Int {
    let own = library.number_of(gui.env("NOVA_KOKORO_MIN_BYTES"))
    if own > 0 {
        return own
    }
    return 50000000
}

fn file_bytes(path: String) -> Int {
    let text = gui.run("stat -f%z '" + path + "' 2>/dev/null", profile_root()).trim()
    return library.number_of(text)
}

fn voice_model_start() -> Notice {
    gui.mkdir(voice_model_dir())
    let command = "curl -fsSL --retry 2 -o '" + voice_model_part() + "' '" + voice_model_url() + "'"
    if !gui.term_start(command, voice_model_dir()) {
        return Notice { text: "Could not start the voice download", until: gui.now() + 2600 }
    }
    return Notice { text: "Downloading the voice model", until: gui.now() + 2400 }
}

// Called once curl exits. The size check is the integrity boundary: a partial
// or error page never becomes model.onnx, and a failed fetch leaves nothing
// behind that a later run could mistake for an installed model.
fn voice_model_finish() -> Notice {
    let part = voice_model_part()
    let bytes = file_bytes(part)
    if bytes < voice_model_min_bytes() {
        gui.run("rm -f '" + part + "'", profile_root())
        return Notice { text: "Voice model download failed", until: gui.now() + 4000 }
    }
    gui.run("mv -f '" + part + "' '" + voice_model_path() + "'", profile_root())
    return Notice {
        text: "Voice model installed · the neural runtime is still not bundled",
        until: gui.now() + 5200,
    }
}

fn reader_toggle(handle: Int, store: Store) -> Notice {
    if !speech.voice_available() {
        return Notice { text: "Speech is not available on this system", until: gui.now() + 2600 }
    }
    if speech.speaking() {
        speech.pause_reading()
        return Notice { text: "Reading paused", until: gui.now() + 1800 }
    }
    if speech.paused() {
        speech.resume_reading()
        return Notice { text: "Reading resumed", until: gui.now() + 1800 }
    }
    return toggle_listen(handle, store)
}

fn handle_key(handle: Int, code: Int, mods: Int, current: Address, session: Session, suggestions: List<String>, store: Store, reader_open: Bool) -> KeyAction {
    let command = mods % 2 == 1
    let shift = (mods / 2) % 2 == 1
    let option = (mods / 4) % 2 == 1

    if command && code == 116 && shift {
        let next = restore_closed(session, gui.native_view(), gui.width(), gui.height())
        return key_action(next, address_idle(), store, notice_idle(), false)
    }
    if command && code == 116 {
        let next = append_tab(session, new_fixture_tab(gui.native_view(), gui.width(), gui.height()))
        engine.focus_chrome(active_handle(next))
        return key_action(next, address_begin(""), store, notice_idle(), false)
    }
    if command && code == 119 {
        let next = close_tab(session, session.active, gui.native_view(), gui.width(), gui.height())
        return key_action(next, address_idle(), store, notice_idle(), false)
    }
    if command && code >= 49 && code <= 54 {
        let next = select_tab(session, code - 49)
        return key_action(next, address_idle(), store, notice_idle(), false)
    }
    if command && shift && code == 101 {
        let next = toggle_layout(session)
        save_layout(store, next.vertical, next.rail)
        return key_action(next, current, store, Notice {
            text: layout_notice(next),
            until: gui.now() + 2400,
        }, false)
    }
    if command && shift && code == 37 {
        // Reads or stops, and keeps the panel in view either way.
        return key_reader(session, current, store, toggle_listen(handle, store), 1, false)
    }
    if command && shift && code == 32 {
        if speech.paused() {
            speech.resume_reading()
            return key_reader(session, current, store, Notice { text: "Reading resumed", until: gui.now() + 1800 }, 1, false)
        }
        if speech.speaking() {
            speech.pause_reading()
            return key_reader(session, current, store, Notice { text: "Reading paused", until: gui.now() + 1800 }, 1, false)
        }
        return key_reader(session, current, store, toggle_listen(handle, store), 1, false)
    }
    if command && shift && code == 9 {
        return key_action(session, current, store, cycle_voice(store), false)
    }
    if command && shift && code == 105 {
        let imported = import_from_google(store)
        return key_action(session, current, imported.store, Notice {
            text: imported.message,
            until: gui.now() + 3200,
        }, false)
    }
    if command && code == 100 {
        let toggled = toggle_bookmark(handle, store)
        return key_action(session, current, toggled.store, Notice {
            text: toggled.message,
            until: gui.now() + 2600,
        }, false)
    }

    if command && shift && code == 112 {
        // Cmd+Shift+P cycles the built-in themes; theme.tsv can override any
        // role on top of whichever one is selected.
        let next = cycle_theme(store.theme)
        save_setting(store, "theme", next)
        var next_store = store
        next_store.theme = next
        return key_action(session, current, next_store, Notice {
            text: "Theme: " + theme_label(next),
            until: gui.now() + 2600,
        }, false)
    }

    if command && shift && code == 115 {
        let provider = address_edit.next_search_provider(store.search)
        save_setting(store, "search", provider)
        var next_store = store
        next_store.search = provider
        return key_action(session, current, next_store, Notice {
            text: "Search: " + address_edit.search_label(provider),
            until: gui.now() + 2800,
        }, false)
    }

    if current.editing {
        if code == gui.key_escape() {
            engine.focus_page(handle)
            return key_action(session, address_cancel(current), store, notice_idle(), false)
        }
        if code == gui.key_enter() {
            let next_address = address_submit(handle, current, suggestions, store.search)
            return key_action(session, next_address, store, notice_idle(), false)
        }
        if code == gui.key_tab() {
            return key_action(session, address_accept(current, suggestions), store, notice_idle(), false)
        }
        if code == gui.key_up() {
            return key_action(session, address_move(current, 0 - 1, suggestions.len()), store, notice_idle(), false)
        }
        if code == gui.key_down() {
            return key_action(session, address_move(current, 1, suggestions.len()), store, notice_idle(), false)
        }
        if code == gui.key_backspace() {
            if option {
                return key_action(session, address_word_erase(current, false), store, notice_idle(), false)
            }
            if command {
                return key_action(session, address_clear(current), store, notice_idle(), false)
            }
            return key_action(session, address_backspace(current), store, notice_idle(), false)
        }
        if code == gui.key_delete() {
            if option {
                return key_action(session, address_word_erase(current, true), store, notice_idle(), false)
            }
            return key_action(session, address_delete(current), store, notice_idle(), false)
        }
        if code == gui.key_left() {
            if option {
                return key_action(session, address_word_step(current, 0 - 1), store, notice_idle(), false)
            }
            if command {
                return key_action(session, address_edge(current, true), store, notice_idle(), false)
            }
            return key_action(session, address_left(current), store, notice_idle(), false)
        }
        if code == gui.key_right() {
            if option {
                return key_action(session, address_word_step(current, 1), store, notice_idle(), false)
            }
            if command {
                return key_action(session, address_edge(current, false), store, notice_idle(), false)
            }
            return key_action(session, address_right(current), store, notice_idle(), false)
        }
        if code == gui.key_home() {
            return key_action(session, address_edge(current, true), store, notice_idle(), false)
        }
        if code == gui.key_end() {
            return key_action(session, address_edge(current, false), store, notice_idle(), false)
        }
        if command && code == 97 {
            return key_action(session, address_select_all(current), store, notice_idle(), false)
        }
        if command && code == 118 {
            let pasted = gui.clipboard().trim()
            return key_action(session, address_type(current, pasted), store, notice_idle(), false)
        }
        if command && code == 108 {
            engine.focus_chrome(handle)
            return key_action(session, address_select_all(current), store, notice_idle(), false)
        }
        return key_action(session, current, store, notice_idle(), false)
    }

    if command && code == 108 {
        engine.focus_chrome(handle)
        return key_action(session, address_begin(engine.page_url(handle)), store, notice_idle(), false)
    }
    if command && code == 114 {
        engine.reload(handle)
        return key_action(session, current, store, notice_idle(), false)
    }
    if command && code == 1004 {
        engine.back(handle)
        return key_action(session, current, store, notice_idle(), false)
    }
    if command && code == 1003 {
        engine.forward(handle)
        return key_action(session, current, store, notice_idle(), false)
    }
    if code == gui.key_escape() {
        if reader_open {
            // Escape dismisses the reader panel before it closes the window.
            return key_reader(session, current, store, notice_idle(), 0 - 1, false)
        }
        return key_action(session, current, store, notice_idle(), true)
    }
    return key_action(session, current, store, notice_idle(), false)
}

// ---------- entry ----------

fn settle(frames: Int) {
    var i = 0
    while i < frames {
        gui.pump()
        gui.sleep(16)
        i = i + 1
    }
}

fn auto_close(session: Session, theme: Chrome, address: Address, store: Store) {
    let handle = active_handle(session)
    // The loop normally places these every pass; a headless run never reaches
    // the loop, so the frame it saves needs the same placement first.
    gui.place_traffic_lights(traffic_center(session.vertical))
    speech.use_engine(stored_engine(store))
    let final_state = engine.wait(handle, 8000)
    sync_visibility(session)
    let merged = library.merge(store.bookmarks, store.visits)
    let suggestions = if address.editing { with_search_row(library.suggest(merged, address.text, sug_rows()), address.text, store.search) } else { library.empty() }
    let rail_open = session.rail && gui.env("NOVA_BROWSER_RAIL_OPEN") == "1"
    var panel_open = gui.env("NOVA_BROWSER_READER_PANEL") == "1"
    if gui.env("NOVA_BROWSER_READER") == "1" {
        let notice = toggle_listen(active_handle(session), store)
        println("reader: chars=${engine.body_text(active_handle(session)).len()} backend=${speech.voice_backend()} voice=${stored_voice(store)} rate=${stored_rate(store)} speaking=${flag(speech.speaking())} notice=${notice.text}")
    }
    // Headless form of a Kokoro reading: wait for the job to finish and report
    // every phase it passed through, so a test can see loading, synthesizing
    // and the failure detail without ears.
    if gui.env("NOVA_BROWSER_SYNTH_WAIT") == "1" {
        var waited = 0
        var last = 0 - 1
        var done = false
        while !done && waited < 20000 {
            let phase = speech.synth_phase()
            if phase != last {
                println("synth: phase=${phase} elapsed=${speech.synth_elapsed_ms()} backend=${speech.voice_backend()} detail=${speech.synth_detail()}")
                last = phase
            }
            if phase == 0 || phase == 4 || phase == 5 {
                done = true
            }
            gui.pump()
            gui.sleep(40)
            waited = waited + 40
        }
        println("synth: end backend=${speech.voice_backend()} note=${speech.voice_note()}")
    }
    // Headless form of the panel's download row: fetch, verify the size, and
    // report what the host sees. The URL is overridable so tests use a local
    // file instead of the network.
    if gui.env("NOVA_BROWSER_VOICE_FETCH") == "1" {
        let started = voice_model_start()
        gui.sleep(120)
        var waited = 0
        while gui.term_running() && waited < 60000 {
            gui.pump()
            gui.sleep(25)
            waited = waited + 25
        }
        let result = voice_model_finish()
        println("voice: start=${started.text} bytes=${file_bytes(voice_model_path())} ready=${flag(speech.kokoro_ready())} path=${voice_model_path()} note=${result.text}")
    }
    gui.begin()
    draw_chrome(handle, theme, address, session, suggestions, fx_new(), notice_idle(), store, 0 - 1, downloads_view(store), Tooltip { text: "", x: 0, y: 0 }, rail_open, panel_open, false, 0)
    gui.present()
    settle(24)
    let target = gui.env("NOVA_BROWSER_SNAPSHOT")
    var saved = false
    if target.len() > 0 {
        saved = engine.snapshot(handle, target)
    }
    let ui_target = gui.env("NOVA_BROWSER_UI_SNAPSHOT")
    var ui_saved = false
    if ui_target.len() > 0 {
        ui_saved = gui.save_png(ui_target)
    }
    let title = engine.page_title(handle)
    let layout_word = if session.rail { "rail" } else if session.vertical { "vertical" } else { "horizontal" }
    save_session(store, session)
    println("browser: state=${state_word(final_state)} title=${title} snapshot=${saved} ui=${ui_saved} tabs=${session.tabs.len()} layout=${layout_word}")
}

fn run_cli_import(argument: String) -> Bool {
    var paths: List<String> = []
    if argument.len() > 0 {
        paths.push(argument)
    } else {
        paths = chrome_profile_paths()
    }
    let store = load_store()
    let found = import_files(paths)
    let before = library.bookmark_count(store.bookmarks)
    let next = apply_import(store, found)
    let after = library.bookmark_count(next.bookmarks)
    let saved = save_store(next)
    println("import: files=${paths.len()} found=${found.len()} new=${after - before} bookmarks=${after} path=${saved.bookmarks_path}")
    return after > 0
}

fn mark_active_url(session: Session, url: String) -> Session {
    if url.contains("fixture.nova.invalid") {
        return session
    }
    var tabs: List<Tab> = []
    var i = 0
    while i < session.tabs.len() {
        let tab = session.tabs[i]
        if i == session.active {
            tabs.push(Tab {
                handle: tab.handle,
                url: url,
                fixture: false,
                title: tab.title,
            })
        } else {
            tabs.push(tab)
        }
        i = i + 1
    }
    return Session {
        tabs: tabs,
        active: session.active,
        closed: session.closed,
        vertical: session.vertical,
        rail: session.rail,
        seen: session.seen,
    }
}

fn refresh_titles(session: Session) -> Session {
    var tabs: List<Tab> = []
    for tab in session.tabs {
        tabs.push(Tab {
            handle: tab.handle,
            url: tab.url,
            fixture: tab.fixture,
            title: engine.page_title(tab.handle),
        })
    }
    return Session {
        tabs: tabs,
        active: session.active,
        closed: session.closed,
        vertical: session.vertical,
        rail: session.rail,
        seen: session.seen,
    }
}

fn session_signature(session: Session) -> String {
    var out = "${session.active}"
    for tab in session.tabs {
        let live = if tab.fixture { "fixture" } else { engine.page_url(tab.handle) }
        out = out + "|" + live
    }
    return out
}

fn save_session(store: Store, session: Session) {
    if store.session_path.len() == 0 {
        return
    }
    var urls: List<String> = []
    var saved_active = 0
    var i = 0
    while i < session.tabs.len() {
        let tab = session.tabs[i]
        if !tab.fixture {
            let live = engine.page_url(tab.handle)
            if live.len() > 0 {
                urls.push(live)
            } else if tab.url.len() > 0 {
                urls.push(tab.url)
            }
            if i < session.active {
                saved_active = saved_active + 1
            }
        }
        i = i + 1
    }
    gui.write(store.session_path, library.session_encode(urls, saved_active))
}

fn restore_session(store: Store, vertical: Bool, rail: Bool) -> Session {
    let text = if store.session_path.len() > 0 { gui.read(store.session_path) } else { "" }
    let urls = if gui.env("NOVA_BROWSER_NO_RESTORE").trim() != "1" {
        library.session_urls(text)
    } else {
        library.empty()
    }
    var tabs: List<Tab> = []
    var i = 0
    while i < urls.len() && i < max_tabs() {
        let tab = new_url_tab(gui.native_view(), gui.width(), gui.height(), urls[i])
        if tab.handle > 0 {
            tabs.push(tab)
        }
        i = i + 1
    }
    if tabs.len() == 0 {
        let fresh = new_fixture_tab(gui.native_view(), gui.width(), gui.height())
        if fresh.handle > 0 {
            tabs.push(fresh)
        }
        return Session { tabs: tabs, active: 0, closed: [], vertical: vertical, rail: rail, seen: "" }
    }
    var active = library.session_active(text)
    if active < 0 {
        active = 0
    }
    if active >= tabs.len() {
        active = tabs.len() - 1
    }
    return Session { tabs: tabs, active: active, closed: [], vertical: vertical, rail: rail, seen: "" }
}

fn open_session(store: Store, vertical: Bool, rail: Bool, initial: String) -> Session {
    if initial.len() > 0 {
        let first = new_url_tab(gui.native_view(), gui.width(), gui.height(), initial)
        var tabs: List<Tab> = []
        if first.handle > 0 {
            tabs.push(first)
        }
        return Session { tabs: tabs, active: 0, closed: [], vertical: vertical, rail: rail, seen: "" }
    }
    return restore_session(store, vertical, rail)
}


fn run_download_test(url: String) -> Bool {
    if url.len() == 0 {
        println("download: usage: --download <http(s) url>")
        return false
    }
    let handle = engine.create(0, 0, 0, 900, 600)
    if handle <= 0 {
        println("download: could not create a view")
        return false
    }
    engine.navigate(handle, url)
    engine.wait(handle, 8000)
    // NOVA_BROWSER_DOWNLOAD_PAUSE=1 pauses as soon as bytes arrive, checks the
    // resume data, resumes, and still requires the finished file. It is the
    // automated form of the shelf's row-click pause/resume.
    let pause_wanted = gui.env("NOVA_BROWSER_DOWNLOAD_PAUSE") == "1"
    var paused = false
    var resumed = false
    var resume_attempted = false
    var pause_waited = 0
    var waited = 0
    while waited < 15000 {
        gui.pump()
        gui.sleep(20)
        waited = waited + 20
        let count = engine.download_count()
        if count > 0 {
            let ident = engine.download_id(count - 1)
            let state = engine.download_state(ident)
            if pause_wanted && !paused && state == 1 {
                let got = engine.download_received(ident)
                if got > 0 {
                    if engine.download_pause(ident) {
                        paused = true
                        println("download: paused at ${got}")
                    }
                }
            }
            if paused && !resumed && !resume_attempted {
                if engine.download_state(ident) == 5 {
                    if pause_waited < 300 {
                        pause_waited = pause_waited + 20
                    } else {
                        resume_attempted = true
                        let resumable = engine.download_resumable(ident)
                        let resumable_text = if resumable { "1" } else { "0" }
                        println("download: paused state received=${engine.download_received(ident)} resumable=" + resumable_text)
                        if resumable {
                            if engine.download_resume(ident) {
                                resumed = true
                                println("download: resumed")
                            }
                        } else {
                            println("download: state=unresumable")
                            engine.destroy(handle)
                            return false
                        }
                    }
                }
            }
            if state == 2 || state == 3 || state == 4 {
                let name = engine.download_name(ident)
                let path = engine.download_path(ident)
                let bytes = engine.download_received(ident)
                let word = if state == 2 { "done" } else if state == 3 { "failed" } else { "cancelled" }
                println("download: state=${word} name=${name} bytes=${bytes} path=${path}")
                if state == 2 {
                    remember_download(path, name, bytes)
                }
                engine.destroy(handle)
                if !pause_wanted {
                    return state == 2
                }
                return state == 2 && resumed
            }
        }
    }
    println("download: state=timeout downloads=${engine.download_count()}")
    engine.destroy(handle)
    return false
}

fn bench_run(session: Session, theme: Chrome, address: Address, store: Store) {
    let frames = library.number_of(gui.env("NOVA_BROWSER_BENCH"))
    if frames <= 0 {
        return
    }
    var fx = fx_new()
    var i = 0
    let fx_start = gui.now()
    while i < 2000 {
        fx = fx_step(fx, i % 12, true)
        i = i + 1
    }
    let fx_ms = gui.now() - fx_start
    var total = 0
    var worst = 0
    var frames_done = 0
    let merged = library.merge(store.bookmarks, store.visits)
    while frames_done < frames {
        let started = gui.now()
        let suggestions = library.suggest(merged, address.text, sug_rows())
        gui.begin()
        draw_chrome(active_handle(session), theme, address, session, suggestions, fx, notice_idle(), store, 3, downloads_view(store), Tooltip { text: "", x: 0, y: 0 }, false, false, false, 0)
        gui.present()
        let spent = gui.now() - started
        total = total + spent
        if spent > worst {
            worst = spent
        }
        fx = fx_step(fx, 3, address.editing)
        frames_done = frames_done + 1
    }
    println("bench: frames=${frames} avg=${total / frames}ms worst=${worst}ms fx_step_2000=${fx_ms}ms stack=${gui.stack_peak() / 1024}KB/${gui.stack_span() / 1024}KB")
}

fn main() {
    if gui.args_count() >= 2 {
        let argument = gui.arg(1)
        if argument == "--import" || argument == "--import-google" {
            var target = ""
            if gui.args_count() >= 3 {
                target = gui.arg(2)
            }
            run_cli_import(target)
            return
        }
        if argument == "--download" {
            var target = ""
            if gui.args_count() >= 3 {
                target = gui.arg(2)
            }
            run_download_test(target)
            return
        }
    }

    var store = load_store()
    // Test hook: open the shelf before the first frame so its accessibility
    // elements can be inspected without a live download.
    if gui.env("NOVA_BROWSER_DOWNLOADS_OPEN") == "1" {
        store.downloads_open = true
    }
    // Test hook: apply the Clear control before the first frame.
    if gui.env("NOVA_BROWSER_CLEAR_DOWNLOADS") == "1" {
        store = save_store(clear_finished_downloads(store))
    }

    if !gui.open("Nova Browser", 1180, 800) {
        println("browser: could not open a window")
        return
    }

    var theme = load_theme(store)
    gui.set_appearance(theme_is_light(resolved_theme_name(store)))
    let settings_text = gui.read(store.settings_path)
    let layout_setting = library.setting_value(settings_text, "layout")
    var vertical = layout_setting == "vertical" || layout_setting == "rail"
    var rail = layout_setting == "rail"
    if gui.env("NOVA_BROWSER_LAYOUT").trim() == "vertical" {
        vertical = true
        rail = false
    }
    if gui.env("NOVA_BROWSER_LAYOUT").trim() == "rail" {
        vertical = true
        rail = true
    }
    if gui.env("NOVA_BROWSER_LAYOUT").trim() == "horizontal" {
        vertical = false
        rail = false
    }

    var initial = gui.env("NOVA_BROWSER_URL")
    if initial.len() == 0 && gui.args_count() >= 2 {
        initial = gui.arg(1)
    }

    var session = open_session(store, vertical, rail, initial)
    if session.tabs.len() == 0 {
        println("browser: could not create the WebKit view")
        gui.close()
        return
    }
    session = refresh_titles(session)
    sync_visibility(session)

    // Headless check for the tab context-menu actions: the menu itself is
    // AppKit's, but the two multi-tab commands it dispatches are exercised
    // here so they have a repeatable assertion.
    if gui.env("NOVA_BROWSER_TAB_ACTION").trim() == "1" {
        session = duplicate_tab(session, 0, gui.native_view(), gui.width(), gui.height())
        println("browser: action duplicate tabs=${session.tabs.len()}")
        session = close_other_tabs(session, 0, gui.native_view(), gui.width(), gui.height())
        println("browser: action close-others tabs=${session.tabs.len()}")
    }

    engine.focus_page(active_handle(session))

    var address = address_idle()
    let focus_address_env = gui.env("NOVA_BROWSER_FOCUS_ADDRESS")
    if focus_address_env.len() > 0 {
        // Visual-check hook: open with the field focused and its text selected.
        // Any value other than "1" is the seed text, for long-URL checks.
        var seed = engine.page_url(active_handle(session))
        if focus_address_env != "1" {
            seed = focus_address_env
        }
        if seed.len() == 0 {
            seed = "https://nova.example/browser/releases/0.5.0/notes?tab=downloads"
        }
        address = address_begin(seed)
        engine.focus_chrome(active_handle(session))
    }

    if gui.env("NOVA_BROWSER_AUTOCLOSE") == "1" {
        auto_close(session, theme, address, store)
        destroy_session(session)
        gui.close()
        return
    }

    if library.number_of(gui.env("NOVA_BROWSER_BENCH")) > 0 {
        bench_run(session, theme, address, store)
        destroy_session(session)
        gui.close()
        return
    }

    var fx = fx_new()
    var notice = notice_idle()
    var pointer_x = 0
    var pointer_y = 0
    var have_pointer = false
    var hover = 0 - 1
    var hover_since = 0
    var last_hover = 0 - 2
    var drawn_state = 0 - 2
    var drawn_url = ""
    var drawn_progress = 0 - 1
    var drawn_downloads = ""
    var drawn_download_count = 0 - 1
    var drawn_hover = 0 - 2
    var drawn_editing = 0 - 1
    var drawn_vertical = 0 - 1
    var drawn_tooltip = 0 - 1
    var drawn_notice = 0 - 1
    var drawn_text = ""
    var drawn_cursor = 0 - 1
    var drawn_highlight = 0 - 2
    var drawn_bookmarks = 0 - 1
    var drawn_shelf = 0 - 1
    var drawn_rail_open = 0 - 1
    var drawn_speaking = 0 - 1
    var drawn_paused = 0 - 1
    var drawn_reader = 0 - 1
    var drawn_fetch = 0 - 1
    var drawn_synth = 0 - 1
    var voice_engine = ""
    var drawn_voice_bytes = 0 - 1
    var drawn_ready = 0 - 1
    var reader_open = gui.env("NOVA_BROWSER_READER_PANEL") == "1"
    var voice_fetch = false
    var voice_bytes = 0
    var last_titles = 0
    var last_signature = ""
    var drawn_theme = store.theme
    var suggestions: List<String> = []
    var sug_text = ""
    var sug_books = 0 - 1
    var sug_visits = 0 - 1
    var sug_search = ""
    var sug_ready = false
    var drag_tab = 0 - 1
    var drag_origin = 0
    var drag_started = false
    // Which tab the open context menu belongs to (-1 when none).
    var menu_tab = 0 - 1
    var drawn_preedit = ""
    var running = true

    while running {
        let now = gui.now()
        let width = gui.width()
        let height = gui.height()
        let handle = active_handle(session)
        // The saved engine is applied here, so a settings change or a shortcut
        // reaches the host before the next reading without per-frame churn.
        // Re-applied every pass: AppKit restores the buttons to the window's top
        // edge on resize and when full screen exits.
        gui.place_traffic_lights(traffic_center(session.vertical))
        let sound = stored_engine(store)
        if sound != voice_engine {
            speech.use_engine(sound)
            voice_engine = sound
        }

        // Hovering the collapsed rail opens its name panel above the page. The
        // page keeps its width now: the panel is an overlay, so crossing the
        // rail no longer reflows the document.
        var rail_hover = false
        if have_pointer && session.vertical && session.rail {
            rail_hover = pointer_x < rail_panel_width() && pointer_y >= chrome_height(true)
        }
        // Visual-check hook: open the rail's name panel without a pointer.
        if session.rail && gui.env("NOVA_BROWSER_RAIL_OPEN") == "1" {
            rail_hover = true
        }
        let left = page_left(session)
        let top = page_top(session)
        var page_w = width - left
        var page_h = height - top
        if page_w < 1 {
            page_w = 1
        }
        if page_h < 1 {
            page_h = 1
        }
        engine.set_bounds(handle, left, top, page_w, page_h)
        sync_visibility(session)

        if engine.take_chrome_focus_request(handle) {
            address = address_begin(engine.page_url(handle))
        }

        // A tab context menu is modal in the host, so its choice is polled
        // here once the menu has closed.
        let menu_choice = gui.menu_result()
        if menu_choice > 0 && menu_tab >= 0 {
            session = tab_menu_apply(menu_choice, menu_tab, session)
            if menu_choice == 1 {
                engine.focus_chrome(active_handle(session))
                address = address_begin("")
            } else {
                address = address_idle()
            }
            menu_tab = 0 - 1
        }

        if now - last_titles > 500 {
            session = refresh_titles(session)
            last_titles = now
        }

        if address.editing {
            // Rebuilding the merged library and re-scoring it every frame was
            // the main source of hitching while typing in the field.
            if !sug_ready || address.text != sug_text || store.bookmarks.len() != sug_books || store.visits.len() != sug_visits || store.search != sug_search {
                let merged = library.merge(store.bookmarks, store.visits)
                suggestions = with_search_row(library.suggest(merged, address.text, sug_rows()), address.text, store.search)
                sug_text = address.text
                sug_books = store.bookmarks.len()
                sug_visits = store.visits.len()
                sug_search = store.search
                sug_ready = true
                if gui.env("NOVA_BROWSER_TRACE").len() > 0 {
                    println("browser: suggestions=${suggestions.len()} provider=${store.search}")
                }
            }
            if address.highlight >= suggestions.len() {
                address.highlight = suggestions.len() - 1
            }
        } else {
            address.highlight = 0 - 1
            if sug_ready {
                suggestions = library.empty()
                sug_ready = false
            }
        }

        // The IME's in-progress composition is drawn by the chrome, so the
        // trace reports it here where it becomes visible for a frame.
        let preedit = if address.editing { gui.marked_text() } else { "" }
        if preedit != drawn_preedit {
            if preedit.len() > 0 && gui.env("NOVA_BROWSER_TRACE").len() > 0 {
                println("browser: preedit=${preedit}")
            }
            drawn_preedit = preedit
        }

        let shortcut = engine.take_shortcut(handle)
        if shortcut > 0 {
            let code = shortcut / 16
            let mods = shortcut % 16
            if gui.env("NOVA_BROWSER_TRACE").len() > 0 {
                println("browser: shortcut code=${code} mods=${mods}")
            }
            let action = handle_key(handle, code, mods, address, session, suggestions, store, reader_open)
            session = action.session
            address = action.address
            store = action.store
            if action.notice.text.len() > 0 {
                notice = action.notice
            }
            if action.reader == 1 {
                reader_open = true
            } else if action.reader == 0 - 1 {
                reader_open = false
            }
            if action.close {
                running = false
            }
        }

        if address.editing && engine.page_focused(handle) {
            address = address_cancel(address)
        }

        let state = engine.page_state(handle)
        let live = engine.page_url(handle)
        if state == 2 {
            if live.len() > 0 && live != session.seen {
                session.seen = live
                session = mark_active_url(session, live)
                if !live.contains("fixture.nova.invalid") && store.history_path.len() > 0 {
                    let title = engine.page_title(handle)
                    store.visits = library.add_visit(store.visits, live, title)
                    store.dirty_visits = true
                }
            }
        } else if state == 3 {
            session.seen = ""
        }
        store = save_store(store)
        if store.theme != drawn_theme {
            theme = load_theme(store)
            drawn_theme = store.theme
            let now_name = resolved_theme_name(store)
            gui.set_appearance(theme_is_light(now_name))
        }

        let signature = session_signature(session)
        if signature != last_signature {
            last_signature = signature
            save_session(store, session)
        }

        if notice.text.len() > 0 && now > notice.until {
            notice.text = ""
        }

        let downloads = downloads_view(store)
        store = record_downloads(store, downloads)
        store = save_store(store)
        let download_sig = download_signature(downloads)
        if drawn_download_count >= 0 && downloads.rows.len() > drawn_download_count {
            store.downloads_open = true
        }

        // The voice model is fetched by curl in a pty slot, so the window keeps
        // painting; every pass samples the .part file for the progress label.
        if voice_fetch {
            if gui.term_running() {
                let got = file_bytes(voice_model_part())
                if got != voice_bytes {
                    voice_bytes = got
                }
            } else {
                voice_fetch = false
                voice_bytes = 0
                notice = voice_model_finish()
            }
        }

        if have_pointer {
            hover = hover_target(pointer_x, pointer_y, session, address, suggestions, downloads, store.downloads_open, store, reader_open)
        } else {
            hover = 0 - 1
        }
        gui.set_cursor(cursor_for(handle, hover))
        if hover != last_hover {
            last_hover = hover
            hover_since = now
        }

        var tooltip = Tooltip { text: "", x: 0, y: 0 }
        if hover > 0 && now - hover_since > 450 && !address.editing {
            let text = tooltip_text(hover)
            if text.len() > 0 {
                tooltip = Tooltip { text: text, x: pointer_x, y: pointer_y }
            }
        }
        let tip_visible = tooltip.text.len() > 0
        let progress = engine.page_progress(handle)

        // The synthesizer's state drives the frame loop: while it works, the
        // panel animates its wheel and the elapsed time keeps counting.
        let synth_phase = speech.synth_phase()
        let synth_active = synth_phase > 0 && synth_phase < 4
        if synth_phase != drawn_synth && gui.env("NOVA_BROWSER_SYNTH_TRACE") == "1" {
            println("synth: phase=${synth_phase} elapsed=${speech.synth_elapsed_ms()} backend=${speech.voice_backend()} detail=${speech.synth_detail()}")
        }

        let dirty = state != drawn_state || live != drawn_url || progress != drawn_progress ||
                    download_sig != drawn_downloads || hover != drawn_hover ||
                    flag(address.editing) != drawn_editing || address.text != drawn_text ||
                    address.cursor != drawn_cursor || address.highlight != drawn_highlight ||
                    store.bookmarks.len() != drawn_bookmarks || flag(store.downloads_open) != drawn_shelf ||
                    flag(session.vertical) != drawn_vertical || flag(rail_hover) != drawn_rail_open ||
                    flag(speech.speaking()) != drawn_speaking || flag(speech.paused()) != drawn_paused ||
                    flag(reader_open) != drawn_reader || flag(voice_fetch) != drawn_fetch ||
                    flag(synth_active) == 1 || synth_phase != drawn_synth ||
                    voice_bytes != drawn_voice_bytes || flag(speech.kokoro_ready()) != drawn_ready ||
                    notice.text.len() > 0 || drawn_notice == 1 ||
                    fx_busy(fx) || flag(tip_visible) != drawn_tooltip || drag_started

        if dirty {
            fx = fx_step(fx, hover, address.editing)
            gui.begin()
            draw_chrome(handle, theme, address, session, suggestions, fx, notice, store, hover, downloads, tooltip, rail_hover, reader_open, voice_fetch, voice_bytes)
            if drag_started && !session.vertical {
                let slot = tab_slot_at(session, pointer_x)
                gui.round_rect(tab_box_x(session, slot), 8, 2, 30, 1, theme.orange)
            }
            gui.present()
            drawn_state = state
            drawn_url = live
            drawn_progress = progress
            drawn_downloads = download_sig
            drawn_download_count = downloads.rows.len()
            drawn_hover = hover
            drawn_editing = flag(address.editing)
            drawn_vertical = flag(session.vertical)
            drawn_tooltip = flag(tip_visible)
            drawn_notice = flag(notice.text.len() > 0)
            drawn_text = address.text
            drawn_cursor = address.cursor
            drawn_highlight = address.highlight
            drawn_bookmarks = store.bookmarks.len()
            drawn_shelf = flag(store.downloads_open)
            drawn_rail_open = flag(rail_hover)
            drawn_speaking = flag(speech.speaking())
            drawn_paused = flag(speech.paused())
            drawn_reader = flag(reader_open)
            drawn_fetch = flag(voice_fetch)
            drawn_synth = synth_phase
            drawn_voice_bytes = voice_bytes
            drawn_ready = flag(speech.kokoro_ready())
        }

        let event = gui.next_event()
        if event.kind == gui.event_close() {
            running = false
        } else if event.kind == gui.event_mouse_down() {
            pointer_x = event.x
            pointer_y = event.y
            have_pointer = true
            drag_tab = 0 - 1
            drag_started = false
            if event.delta == 2 {
                // The host marks a right click in delta; Nova owns the tab
                // geometry, so it decides whether a menu is due.
                menu_tab = tab_menu_target(event.x, event.y, session)
                if menu_tab >= 0 {
                    gui.tab_menu(session.tabs.len())
                }
            } else {
            // A press outside the reader panel dismisses it, the way a popover
            // behaves, before the press reaches whatever is behind it.
            if reader_open {
                let panel = reader_panel_box(store)
                if !gui.inside(panel.x, panel.y, panel.w, panel.h, event.x, event.y) {
                    reader_open = false
                }
            }
            let click = handle_click(handle, event.x, event.y, event.code, address, session, suggestions, store, downloads, reader_open)
            session = click.session
            address = click.address
            store = click.store
            if click.notice.text.len() > 0 {
                notice = click.notice
            }
            if click.reader == 1 {
                reader_open = true
            } else if click.reader == 0 - 1 {
                reader_open = false
            }
            if click.fetch == 1 {
                voice_bytes = 0
                voice_fetch = true
                notice = voice_model_start()
            }
            // A press on a tab arms a drag; the move threshold below decides
            // whether it was a click or a reorder.
            if event.code == 1 && !session.vertical && event.y < 44 && event.x >= 84 && event.x < gui.width() - 8 {
                let slot = tab_slot_at(session, event.x)
                let tx = tab_box_x(session, slot)
                if event.x < tx + tab_width(session.tabs.len()) - 24 {
                    drag_tab = slot
                    drag_origin = event.x
                }
            }
            }
        } else if event.kind == gui.event_mouse_up() {
            if drag_tab >= 0 && drag_started {
                session = reorder_tab(session, drag_tab, tab_slot_at(session, event.x))
            }
            drag_tab = 0 - 1
            drag_started = false
        } else if event.kind == gui.event_mouse_move() || event.kind == gui.event_drag() {
            pointer_x = event.x
            pointer_y = event.y
            have_pointer = true
            if drag_tab >= 0 && !drag_started {
                let dx = if event.x > drag_origin { event.x - drag_origin } else { drag_origin - event.x }
                if dx > 4 {
                    drag_started = true
                }
            }
        } else if event.kind == gui.event_scroll() {
            if address.editing && suggestions.len() > 0 && event.delta != 0 {
                if event.delta < 0 {
                    address = address_move(address, 1, suggestions.len())
                } else {
                    address = address_move(address, 0 - 1, suggestions.len())
                }
            }
        } else if event.kind == gui.event_key() {
            let action = handle_key(handle, event.code, event.mods, address, session, suggestions, store, reader_open)
            session = action.session
            address = action.address
            store = action.store
            if action.notice.text.len() > 0 {
                notice = action.notice
            }
            if action.reader == 1 {
                reader_open = true
            } else if action.reader == 0 - 1 {
                reader_open = false
            }
            if action.close {
                running = false
            }
        } else if event.kind == gui.event_text() {
            if address.editing {
                let typed = gui.typed_text()
                address = address_type(address, typed)
                if gui.env("NOVA_BROWSER_TRACE").len() > 0 {
                    println("browser: address text=${address.text}")
                }
            }
        }
        gui.pump()
        // Input already waiting: napping here is what made hover trail the
        // pointer, so only truly idle passes sleep.
        if synth_active {
            gui.sleep(33)
        } else if event.kind == gui.event_none() {
            if dirty {
                gui.sleep(6)
            } else {
                gui.sleep(12)
            }
        }
    }

    store = save_store(store)
    save_session(store, session)
    destroy_session(session)
    gui.close()
}
