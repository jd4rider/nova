// Nova lexer, in Nova.
//
// Tokens are (kind, text, span, line, column). The lexer is deliberately
// permissive: it tokenizes anything the parser might reject, so tooling such as
// formatting, highlighting and diagnostics can run on incomplete files.

struct Token {
    kind: Int,
    text: String,
    start: Int,
    end: Int,
    line: Int,
    column: Int,
}

fn lx_ident() -> Int {
    return 1
}

fn lx_keyword() -> Int {
    return 2
}

fn lx_number() -> Int {
    return 3
}

fn lx_string() -> Int {
    return 4
}

fn lx_char() -> Int {
    return 5
}

fn lx_comment() -> Int {
    return 6
}

fn lx_operator() -> Int {
    return 7
}

fn lx_punct() -> Int {
    return 8
}

fn lx_eof() -> Int {
    return 9
}

fn lx_kind_name(kind: Int) -> String {
    if kind == lx_ident() {
        return "ident"
    }
    if kind == lx_keyword() {
        return "keyword"
    }
    if kind == lx_number() {
        return "number"
    }
    if kind == lx_string() {
        return "string"
    }
    if kind == lx_char() {
        return "char"
    }
    if kind == lx_comment() {
        return "comment"
    }
    if kind == lx_operator() {
        return "operator"
    }
    if kind == lx_punct() {
        return "punct"
    }
    return "eof"
}

fn lx_keywords() -> List<String> {
    var words: List<String> = []
    words.push("fn")
    words.push("let")
    words.push("var")
    words.push("if")
    words.push("else")
    words.push("while")
    words.push("for")
    words.push("in")
    words.push("return")
    words.push("struct")
    words.push("enum")
    words.push("impl")
    words.push("import")
    words.push("match")
    words.push("break")
    words.push("continue")
    words.push("as")
    words.push("true")
    words.push("false")
    words.push("extern")
    return words
}

fn lx_is_keyword(word: String) -> Bool {
    for known in lx_keywords() {
        if word == known {
            return true
        }
    }
    return false
}

fn lx_in(c: String, set: String) -> Bool {
    for known in set.chars() {
        if c == known {
            return true
        }
    }
    return false
}

fn lx_is_digit(c: String) -> Bool {
    return lx_in(c, "0123456789")
}

fn lx_is_alpha(c: String) -> Bool {
    return lx_in(c, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_")
}

fn lx_is_space(c: String) -> Bool {
    return c == " " || c == "\t" || c == "\r" || c == "\n"
}

fn lx_slice(chars: List<String>, start: Int, stop: Int) -> String {
    var out = ""
    var i = start
    while i < stop && i < chars.len() {
        out = out + chars[i]
        i = i + 1
    }
    return out
}

fn lx_two(text: String) -> Bool {
    if text == "==" || text == "!=" || text == "<=" || text == ">=" {
        return true
    }
    if text == "->" || text == "=>" || text == "::" || text == "&&" {
        return true
    }
    if text == "||" || text == "+=" || text == "-=" || text == "*=" {
        return true
    }
    if text == "/=" || text == "%=" || text == ".." {
        return true
    }
    return false
}

fn lx_one(text: String) -> Bool {
    if text == "+" || text == "-" || text == "*" || text == "/" {
        return true
    }
    if text == "%" || text == "=" || text == "<" || text == ">" {
        return true
    }
    if text == "!" || text == "&" || text == "|" || text == "^" {
        return true
    }
    if text == "~" || text == "?" {
        return true
    }
    return false
}

fn lx_punct_char(text: String) -> Bool {
    if text == "(" || text == ")" || text == "[" || text == "]" {
        return true
    }
    if text == "{" || text == "}" || text == "," || text == ";" {
        return true
    }
    if text == ":" || text == "." || text == "@" {
        return true
    }
    return false
}

fn lx_token(kind: Int, text: String, start: Int, end: Int, line: Int, column: Int) -> Token {
    return Token {
        kind: kind,
        text: text,
        start: start,
        end: end,
        line: line,
        column: column,
    }
}

fn lx_lex(source: String) -> List<Token> {
    let chars = source.chars()
    var tokens: List<Token> = []
    var i = 0
    var line = 1
    var column = 1
    while i < chars.len() {
        let c = chars[i]
        if lx_is_space(c) {
            if c == "\n" {
                line = line + 1
                column = 1
            } else {
                column = column + 1
            }
            i = i + 1
        } else if c == "/" && i + 1 < chars.len() && chars[i + 1] == "/" {
            let start = i
            let start_line = line
            let start_column = column
            while i < chars.len() && chars[i] != "\n" {
                i = i + 1
                column = column + 1
            }
            tokens.push(lx_token(lx_comment(), lx_slice(chars, start, i), start, i, start_line, start_column))
        } else if c == "/" && i + 1 < chars.len() && chars[i + 1] == "*" {
            let start = i
            let start_line = line
            let start_column = column
            i = i + 2
            column = column + 2
            var depth = 1
            while i < chars.len() && depth > 0 {
                if chars[i] == "/" && i + 1 < chars.len() && chars[i + 1] == "*" {
                    depth = depth + 1
                    i = i + 2
                    column = column + 2
                } else if chars[i] == "*" && i + 1 < chars.len() && chars[i + 1] == "/" {
                    depth = depth - 1
                    i = i + 2
                    column = column + 2
                } else {
                    if chars[i] == "\n" {
                        line = line + 1
                        column = 1
                    } else {
                        column = column + 1
                    }
                    i = i + 1
                }
            }
            tokens.push(lx_token(lx_comment(), lx_slice(chars, start, i), start, i, start_line, start_column))
        } else if c == "\"" {
            let start = i
            let start_line = line
            let start_column = column
            i = i + 1
            column = column + 1
            var escaped = false
            var closed = false
            while i < chars.len() && !closed {
                let part = chars[i]
                if escaped {
                    escaped = false
                } else if part == "\\" {
                    escaped = true
                } else if part == "\"" {
                    closed = true
                }
                if part == "\n" {
                    line = line + 1
                    column = 1
                } else {
                    column = column + 1
                }
                i = i + 1
            }
            tokens.push(lx_token(lx_string(), lx_slice(chars, start, i), start, i, start_line, start_column))
        } else if c == "'" {
            let start = i
            let start_line = line
            let start_column = column
            i = i + 1
            column = column + 1
            var escaped = false
            var closed = false
            while i < chars.len() && !closed {
                let part = chars[i]
                if escaped {
                    escaped = false
                } else if part == "\\" {
                    escaped = true
                } else if part == "'" {
                    closed = true
                }
                if part == "\n" {
                    line = line + 1
                    column = 1
                } else {
                    column = column + 1
                }
                i = i + 1
            }
            tokens.push(lx_token(lx_char(), lx_slice(chars, start, i), start, i, start_line, start_column))
        } else if lx_is_alpha(c) {
            let start = i
            let start_line = line
            let start_column = column
            while i < chars.len() && (lx_is_alpha(chars[i]) || lx_is_digit(chars[i])) {
                i = i + 1
                column = column + 1
            }
            let word = lx_slice(chars, start, i)
            var kind = lx_ident()
            if lx_is_keyword(word) {
                kind = lx_keyword()
            }
            tokens.push(lx_token(kind, word, start, i, start_line, start_column))
        } else if lx_is_digit(c) {
            let start = i
            let start_line = line
            let start_column = column
            var scanning = true
            while i < chars.len() && scanning {
                let part = chars[i]
                if lx_is_digit(part) || part == "_" {
                    i = i + 1
                    column = column + 1
                } else if part == "." && i + 1 < chars.len() && lx_is_digit(chars[i + 1]) {
                    i = i + 1
                    column = column + 1
                } else {
                    scanning = false
                }
            }
            tokens.push(lx_token(lx_number(), lx_slice(chars, start, i), start, i, start_line, start_column))
        } else {
            let start = i
            let start_line = line
            let start_column = column
            var width = 1
            if i + 1 < chars.len() {
                let pair = chars[i] + chars[i + 1]
                if lx_two(pair) {
                    width = 2
                }
            }
            let text = lx_slice(chars, start, start + width)
            var kind = lx_punct()
            if lx_one(text) || width == 2 {
                kind = lx_operator()
            }
            tokens.push(lx_token(kind, text, start, start + width, start_line, start_column))
            i = i + width
            column = column + width
        }
    }
    tokens.push(lx_token(lx_eof(), "", i, i, line, column))
    return tokens
}

fn lx_count(tokens: List<Token>, kind: Int) -> Int {
    var count = 0
    for token in tokens {
        if token.kind == kind {
            count = count + 1
        }
    }
    return count
}
