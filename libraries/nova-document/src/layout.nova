// nova-document/layout — measured line breaking and pagination.
//
// Layout is deterministic for a fixed font set and platform: CoreText reports
// the advance width of a shaped line, and Nova decides where the line breaks
// and where the page ends. Paragraph positions stay in grapheme offsets, so a
// click, caret or selection always maps back to the document model.

import "../../nova-gui/src/gui.nova" as gui
import "document.nova" as wd
import "text.nova" as tx

struct LineRun {
    start: Int,
    end: Int,
    style: Int,
    text: String,
}

struct LineBox {
    para: Int,
    start: Int,
    end: Int,
    page: Int,
    x: Int,
    y: Int,
    w: Int,
    size: Int,
    style: Int,
    family: Int,
    text: String,
    prefix: String,
    indent: Int,
    dir: Int,
    runs: List<LineRun>,
}

struct Layout {
    lines: List<LineBox>,
    pages: Int,
    page_w: Int,
    page_h: Int,
    margin: Int,
}

// A paragraph's measured lines, kept independently of page position so an
// unchanged paragraph can be reused after an edit elsewhere.
struct ParaLayout {
    id: Int,
    para: wd.Paragraph,
    lines: List<LineBox>,
}

struct LayoutCache {
    doc_id: Int,
    page_w: Int,
    page_h: Int,
    margin: Int,
    paras: List<ParaLayout>,
    measured: Int,
    reused: Int,
}

struct EmitResult {
    lines: List<LineBox>,
    page: Int,
    y: Int,
}

struct WrapResult {
    lines: List<LineBox>,
    page: Int,
    y: Int,
}

struct CaredBox {
    found: Bool,
    page: Int,
    x: Int,
    y: Int,
    h: Int,
    line: Int,
}

struct Hit {
    found: Bool,
    para: Int,
    offset: Int,
    line: Int,
}

fn wl_a4_w() -> Int {
    return 595
}

fn wl_a4_h() -> Int {
    return 842
}

fn wl_margin() -> Int {
    return 64
}

fn wl_line_h(size: Int) -> Int {
    return size + 7
}

fn wl_size(kind: Int) -> Int {
    if kind == wd.wd_title_style() {
        return 24
    }
    if kind == wd.wd_heading1() {
        return 18
    }
    if kind == wd.wd_heading2() {
        return 14
    }
    return 11
}

fn wl_family(kind: Int) -> Int {
    if kind == wd.wd_title_style() || kind == wd.wd_heading1() || kind == wd.wd_heading2() {
        return 0
    }
    return 2
}

fn wl_style(kind: Int) -> Int {
    if kind == wd.wd_title_style() || kind == wd.wd_heading1() || kind == wd.wd_heading2() {
        return 1
    }
    if kind == wd.wd_quote() {
        return 2
    }
    return 0
}

fn wl_before(kind: Int) -> Int {
    if kind == wd.wd_title_style() {
        return 0
    }
    if kind == wd.wd_heading1() {
        return 14
    }
    if kind == wd.wd_heading2() {
        return 10
    }
    return 0
}

fn wl_after(kind: Int) -> Int {
    if kind == wd.wd_title_style() {
        return 18
    }
    if kind == wd.wd_heading1() {
        return 10
    }
    if kind == wd.wd_heading2() {
        return 8
    }
    if kind == wd.wd_quote() {
        return 8
    }
    return 7
}

fn wl_prefix(kind: Int) -> String {
    if kind == wd.wd_bullet() {
        return "• "
    }
    return ""
}

fn wl_dir(p: wd.Paragraph) -> Int {
    if p.dir == wd.wd_dir_rtl() {
        return wd.wd_dir_rtl()
    }
    if p.dir == wd.wd_dir_ltr() {
        return wd.wd_dir_ltr()
    }
    return tx.tx_auto_dir(p.text)
}

fn wl_align_x(align: Int, dir: Int, margin: Int, content_w: Int, width: Int) -> Int {
    if align == wd.wd_center() {
        return margin + (content_w - width) / 2
    }
    if dir == wd.wd_dir_rtl() {
        if align == wd.wd_right() {
            return margin
        }
        return margin + content_w - width
    }
    if align == wd.wd_right() {
        return margin + content_w - width
    }
    return margin
}

fn wl_emit(lines: List<LineBox>, page: Int, y: Int, page_h: Int, margin: Int, line: LineBox) -> EmitResult {
    var out = lines
    var p = page
    var yy = y
    let lh = wl_line_h(line.size)
    if yy + lh > page_h - margin {
        p = p + 1
        yy = margin
    }
    let placed = LineBox {
        para: line.para,
        start: line.start,
        end: line.end,
        page: p,
        x: line.x,
        y: yy,
        w: line.w,
        size: line.size,
        style: line.style,
        family: line.family,
        text: line.text,
        prefix: line.prefix,
        indent: line.indent,
        dir: line.dir,
        runs: line.runs,
    }
    out.push(placed)
    yy = yy + lh
    return EmitResult { lines: out, page: p, y: yy }
}

fn wl_slice(p: wd.Paragraph, from: Int, to: Int) -> String {
    let text = p.text
    let chars = text.chars()
    let starts = tx.tx_starts(text)
    let count = starts.len() - 1
    let a = tx.tx_clamp(from, count)
    let b = tx.tx_clamp(to, count)
    if b <= a {
        return ""
    }
    return tx.tx_slice(chars, starts[a], starts[b])
}

fn wl_measure_range(p: wd.Paragraph, from: Int, to: Int, size: Int, family: Int, base_style: Int) -> Int {
    if to <= from {
        return 0
    }
    var out = 0
    var cursor = from
    for r in p.runs {
        if r.end > from && r.start < to {
            let a = wd.wd_max(from, r.start)
            let b = wd.wd_min(to, r.end)
            if a > cursor {
                out = out + gui.text_fmt_width(wl_slice(p, cursor, a), size, family, base_style)
            }
            if b > a {
                out = out + gui.text_fmt_width(wl_slice(p, a, b), size, family, wd.wd_style_add(base_style, r.style))
            }
            cursor = b
        }
    }
    if cursor < to {
        out = out + gui.text_fmt_width(wl_slice(p, cursor, to), size, family, base_style)
    }
    return out
}

fn wl_line_runs(p: wd.Paragraph, from: Int, to: Int, size: Int, family: Int, base_style: Int) -> List<LineRun> {
    var out: List<LineRun> = []
    if to <= from {
        return out
    }
    var cursor = from
    for r in p.runs {
        if r.end > from && r.start < to {
            let a = wd.wd_max(from, r.start)
            let b = wd.wd_min(to, r.end)
            if a > cursor {
                out.push(LineRun {
                    start: cursor, end: a, style: base_style,
                    text: wl_slice(p, cursor, a),
                })
            }
            if b > a {
                out.push(LineRun {
                    start: a, end: b, style: wd.wd_style_add(base_style, r.style),
                    text: wl_slice(p, a, b),
                })
            }
            cursor = b
        }
    }
    if cursor < to {
        out.push(LineRun {
            start: cursor, end: to, style: base_style,
            text: wl_slice(p, cursor, to),
        })
    }
    return out
}

// Wraps one paragraph into visual lines, breaking on spaces and hard-breaking a
// single word that cannot fit (a URL, for example).
fn wl_wrap(doc: wd.Document, index: Int, page: Int, y: Int, page_w: Int, page_h: Int, margin: Int) -> WrapResult {
    let p = doc.paragraphs[index]
    let size = wl_size(p.kind)
    let family = wl_family(p.kind)
    let style = wl_style(p.kind)
    let dir = wl_dir(p)
    let content_w = page_w - margin * 2
    let prefix = wl_prefix(p.kind)
    let indent = gui.text_fmt_width(prefix, size, family, style)
    var lines: List<LineBox> = []
    var page = page
    var y = y
    if p.text.len() == 0 {
        let e = wl_emit(lines, page, y, page_h, margin, LineBox {
            para: index, start: 0, end: 0, page: 0,
            x: margin, y: 0, w: 0, size: size, style: style, family: family,
            text: "", prefix: prefix, indent: indent, dir: dir, runs: wl_line_runs(p, 0, 0, size, family, style),
        })
        return WrapResult { lines: e.lines, page: e.page, y: e.y }
    }
    let words = p.text.split(" ")
    var line_text = ""
    var line_start = 0
    var line_end = 0
    var first = true
    var gpos = 0
    var wi = 0
    while wi < words.len() {
        let word = words[wi]
        let wc = tx.tx_count(word)
        let word_start = gpos
        let word_end = gpos + wc
        gpos = word_end
        if wi + 1 < words.len() {
            gpos = gpos + 1
        }
        if word.len() == 0 {
            if line_text.len() > 0 {
                line_text = line_text + " "
                line_end = word_end
            }
            wi = wi + 1
            continue
        }
        if line_text.len() > 0 {
            let candidate = line_text + " " + word
            let pad = if first { indent } else { 0 }
            let cw = wl_measure_range(p, line_start, word_end, size, family, style) + pad
            if cw > content_w {
                let lw = wl_measure_range(p, line_start, line_end, size, family, style) + pad
                let x = wl_align_x(p.align, dir, margin, content_w, lw)
                let pre = if first { prefix } else { "" }
                let pin = if first { indent } else { 0 }
                let e = wl_emit(lines, page, y, page_h, margin, LineBox {
                    para: index, start: line_start, end: line_end, page: 0,
                    x: x, y: 0, w: lw, size: size, style: style, family: family,
                    text: line_text, prefix: pre, indent: pin, dir: dir,
                    runs: wl_line_runs(p, line_start, line_end, size, family, style),
                })
                lines = e.lines
                page = e.page
                y = e.y
                first = false
                line_text = ""
            }
        }
        if line_text.len() == 0 {
            line_text = word
            line_start = word_start
            line_end = word_end
            let pad = if first { indent } else { 0 }
            if wl_measure_range(p, word_start, word_end, size, family, style) + pad > content_w {
                var rest = word
                var rest_g = word_start
                while rest.len() > 0 {
                    let total = tx.tx_count(rest)
                    var best = 1
                    var k = 1
                    while k <= total {
                        let chunk = tx.tx_slice(rest.chars(), 0, tx.tx_scalar_at(rest, k))
                        let pad2 = if first { indent } else { 0 }
                        if wl_measure_range(p, rest_g, rest_g + k, size, family, style) + pad2 <= content_w {
                            best = k
                            k = k + 1
                        } else {
                            k = total + 1
                        }
                    }
                    let chunk = tx.tx_slice(rest.chars(), 0, tx.tx_scalar_at(rest, best))
                    let lw = wl_measure_range(p, rest_g, rest_g + best, size, family, style) + (if first { indent } else { 0 })
                    let x = wl_align_x(p.align, dir, margin, content_w, lw)
                    let pre = if first { prefix } else { "" }
                    let pin = if first { indent } else { 0 }
                    let e = wl_emit(lines, page, y, page_h, margin, LineBox {
                        para: index, start: rest_g, end: rest_g + best, page: 0,
                        x: x, y: 0, w: lw, size: size, style: style, family: family,
                        text: chunk, prefix: pre, indent: pin, dir: dir,
                        runs: wl_line_runs(p, rest_g, rest_g + best, size, family, style),
                    })
                    lines = e.lines
                    page = e.page
                    y = e.y
                    first = false
                    rest_g = rest_g + best
                    rest = tx.tx_slice(rest.chars(), tx.tx_scalar_at(rest, best), rest.chars().len())
                }
                line_text = ""
            }
        } else {
            line_text = line_text + " " + word
            line_end = word_end
        }
        wi = wi + 1
    }
    if line_text.len() > 0 {
        let pad = if first { indent } else { 0 }
        let lw = wl_measure_range(p, line_start, line_end, size, family, style) + pad
        let x = wl_align_x(p.align, dir, margin, content_w, lw)
        let pre = if first { prefix } else { "" }
        let pin = if first { indent } else { 0 }
        let e = wl_emit(lines, page, y, page_h, margin, LineBox {
            para: index, start: line_start, end: line_end, page: 0,
            x: x, y: 0, w: lw, size: size, style: style, family: family,
            text: line_text, prefix: pre, indent: pin, dir: dir,
            runs: wl_line_runs(p, line_start, line_end, size, family, style),
        })
        lines = e.lines
        page = e.page
        y = e.y
    }
    return WrapResult { lines: lines, page: page, y: y }
}

fn wl_runs_same(a: List<wd.Run>, b: List<wd.Run>) -> Bool {
    if a.len() != b.len() {
        return false
    }
    var i = 0
    while i < a.len() {
        if a[i].start != b[i].start || a[i].end != b[i].end || a[i].style != b[i].style {
            return false
        }
        i = i + 1
    }
    return true
}

fn wl_para_same(a: wd.Paragraph, b: wd.Paragraph) -> Bool {
    return a.id == b.id && a.kind == b.kind && a.align == b.align && a.dir == b.dir &&
        a.text == b.text && wl_runs_same(a.runs, b.runs)
}

fn wl_cache_find(paras: List<ParaLayout>, p: wd.Paragraph) -> Int {
    var i = 0
    while i < paras.len() {
        if paras[i].id == p.id {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn wl_cache_empty() -> LayoutCache {
    var paras: List<ParaLayout> = []
    return LayoutCache {
        doc_id: 0, page_w: 0, page_h: 0, margin: 0,
        paras: paras, measured: 0, reused: 0,
    }
}

// Measure one paragraph with an effectively unbounded page height. The lines
// keep their relative y positions; wl_layout_cached places them on pages.
fn wl_measure_para(doc: wd.Document, index: Int, page_w: Int, margin: Int) -> ParaLayout {
    let p = doc.paragraphs[index]
    let r = wl_wrap(doc, index, 0, 0, page_w, 1000000000, margin)
    return ParaLayout { id: p.id, para: p, lines: r.lines }
}

// Reuse measured paragraphs whose id and content are unchanged. A split or
// merge changes the surviving paragraph and adds/removes one, so only those
// paragraphs are measured again.
fn wl_cache_update(cache: LayoutCache, doc: wd.Document, page_w: Int, page_h: Int, margin: Int) -> LayoutCache {
    var base = cache
    if base.doc_id != doc.doc_id || base.page_w != page_w || base.page_h != page_h || base.margin != margin {
        base = wl_cache_empty()
        base.doc_id = doc.doc_id
        base.page_w = page_w
        base.page_h = page_h
        base.margin = margin
    }
    var out: List<ParaLayout> = []
    var measured = 0
    var reused = 0
    var i = 0
    while i < doc.paragraphs.len() {
        let p = doc.paragraphs[i]
        let found = wl_cache_find(base.paras, p)
        if found >= 0 && wl_para_same(base.paras[found].para, p) {
            out.push(base.paras[found])
            reused = reused + 1
        } else {
            out.push(wl_measure_para(doc, i, page_w, margin))
            measured = measured + 1
        }
        i = i + 1
    }
    return LayoutCache {
        doc_id: doc.doc_id, page_w: page_w, page_h: page_h, margin: margin,
        paras: out, measured: measured, reused: reused,
    }
}

fn wl_cache_build(doc: wd.Document, page_w: Int, page_h: Int, margin: Int) -> LayoutCache {
    return wl_cache_update(wl_cache_empty(), doc, page_w, page_h, margin)
}

// Paginate cached paragraphs. This copies lines and assigns page/y positions;
// it does not reshape any text.
fn wl_layout_cached(cache: LayoutCache) -> Layout {
    var lines: List<LineBox> = []
    var page = 0
    var y = cache.margin
    var i = 0
    while i < cache.paras.len() {
        let pl = cache.paras[i]
        let p = pl.para
        let size = wl_size(p.kind)
        let lh = wl_line_h(size)
        y = y + wl_before(p.kind)
        if y + lh > cache.page_h - cache.margin {
            page = page + 1
            y = cache.margin
        }
        if wd.wd_is_heading(p.kind) && y + lh * 2 > cache.page_h - cache.margin {
            page = page + 1
            y = cache.margin
        }
        var k = 0
        while k < pl.lines.len() {
            var line = pl.lines[k]
            line.para = i
            let e = wl_emit(lines, page, y, cache.page_h, cache.margin, line)
            lines = e.lines
            page = e.page
            y = e.y
            k = k + 1
        }
        y = y + wl_after(p.kind)
        i = i + 1
    }
    if lines.len() == 0 {
        var no_runs: List<LineRun> = []
        lines.push(LineBox {
            para: 0, start: 0, end: 0, page: 0,
            x: cache.margin, y: cache.margin, w: 0, size: 11, style: 0, family: 2,
            text: "", prefix: "", indent: 0, dir: wd.wd_dir_ltr(), runs: no_runs,
        })
    }
    return Layout { lines: lines, pages: page + 1, page_w: cache.page_w, page_h: cache.page_h, margin: cache.margin }
}

fn wl_layout(doc: wd.Document, page_w: Int, page_h: Int, margin: Int) -> Layout {
    var lines: List<LineBox> = []
    var page = 0
    var y = margin
    var i = 0
    while i < doc.paragraphs.len() {
        let p = doc.paragraphs[i]
        let size = wl_size(p.kind)
        let lh = wl_line_h(size)
        y = y + wl_before(p.kind)
        if y + lh > page_h - margin {
            page = page + 1
            y = margin
        }
        if wd.wd_is_heading(p.kind) && y + lh * 2 > page_h - margin {
            page = page + 1
            y = margin
        }
        let r = wl_wrap(doc, i, page, y, page_w, page_h, margin)
        var k = 0
        while k < r.lines.len() {
            lines.push(r.lines[k])
            k = k + 1
        }
        page = r.page
        y = r.y + wl_after(p.kind)
        i = i + 1
    }
    if lines.len() == 0 {
        var no_runs: List<LineRun> = []
        lines.push(LineBox {
            para: 0, start: 0, end: 0, page: 0,
            x: margin, y: margin, w: 0, size: 11, style: 0, family: 2,
            text: "", prefix: "", indent: 0, dir: wd.wd_dir_ltr(), runs: no_runs,
        })
    }
    return Layout { lines: lines, pages: page + 1, page_w: page_w, page_h: page_h, margin: margin }
}

fn wl_line_index(layout: Layout, para: Int, offset: Int) -> Int {
    var best = 0 - 1
    var i = 0
    while i < layout.lines.len() {
        let l = layout.lines[i]
        if l.para == para && offset >= l.start && offset <= l.end {
            if best < 0 {
                best = i
            }
            if offset > l.start {
                best = i
            }
        }
        i = i + 1
    }
    return best
}

fn wl_x_at(doc: wd.Document, line: LineBox, offset: Int) -> Int {
    if line.para < 0 || line.para >= doc.paragraphs.len() {
        if line.dir == wd.wd_dir_rtl() {
            return line.x + line.w
        }
        return line.x + line.indent
    }
    let p = doc.paragraphs[line.para]
    let count = tx.tx_count(p.text)
    let g0 = tx.tx_clamp(line.start, count)
    let g1 = tx.tx_clamp(offset, count)
    let pw = wl_measure_range(p, g0, g1, line.size, line.family, line.style)
    if line.dir == wd.wd_dir_rtl() {
        return line.x + line.w - line.indent - pw
    }
    return line.x + line.indent + pw
}

fn wl_caret(doc: wd.Document, layout: Layout, para: Int, offset: Int) -> CaredBox {
    let index = wl_line_index(layout, para, offset)
    if index < 0 {
        return CaredBox { found: false, page: 0, x: 0, y: 0, h: 0, line: 0 }
    }
    let l = layout.lines[index]
    return CaredBox {
        found: true,
        page: l.page,
        x: wl_x_at(doc, l, offset),
        y: l.y,
        h: wl_line_h(l.size),
        line: index,
    }
}

fn wl_hit(doc: wd.Document, layout: Layout, page: Int, px: Int, py: Int) -> Hit {
    var i = 0
    while i < layout.lines.len() {
        let l = layout.lines[i]
        if l.page == page && py >= l.y && py < l.y + wl_line_h(l.size) {
            let text = doc.paragraphs[l.para].text
            let count = tx.tx_count(text)
            let from = tx.tx_clamp(l.start, count)
            let to = tx.tx_clamp(l.end, count)
            var best_g = from
            var best_d = 999999
            var g = from
            while g <= to {
                let cx = wl_x_at(doc, l, g)
                var d = px - cx
                if d < 0 {
                    d = 0 - d
                }
                if d < best_d {
                    best_d = d
                    best_g = g
                }
                g = g + 1
            }
            return Hit { found: true, para: l.para, offset: best_g, line: i }
        }
        i = i + 1
    }
    return Hit { found: false, para: 0, offset: 0, line: 0 }
}

// Clicking past the last line of a page should still place the caret on that
// page instead of jumping to the end of the document.
fn wl_hit_nearest(doc: wd.Document, layout: Layout, page: Int, px: Int, py: Int) -> Hit {
    let exact = wl_hit(doc, layout, page, px, py)
    if exact.found {
        return exact
    }
    var first = 0 - 1
    var last = 0 - 1
    var i = 0
    while i < layout.lines.len() {
        let l = layout.lines[i]
        if l.page == page {
            if first < 0 {
                first = i
            }
            if l.y <= py {
                last = i
            }
            if l.y > py && last < 0 {
                last = i
            }
        }
        i = i + 1
    }
    if last < 0 {
        last = first
    }
    if last < 0 {
        return Hit { found: false, para: 0, offset: 0, line: 0 }
    }
    let l = layout.lines[last]
    return Hit { found: true, para: l.para, offset: l.start, line: last }
}

// End-of-document position: last paragraph, last grapheme.
fn wl_end(doc: wd.Document) -> Hit {
    let last = doc.paragraphs.len() - 1
    let count = tx.tx_count(doc.paragraphs[last].text)
    return Hit { found: true, para: last, offset: count, line: 0 }
}
