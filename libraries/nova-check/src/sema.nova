// AST-based semantic checker, in Nova.
//
// This is the first body-level slice: declaration tables, scoped locals,
// expression and return types, call arity/types, struct fields and control-flow
// conditions. It deliberately reports only what it can prove; unknown host
// modules and unsupported forms become `?` rather than invented types.

import "../../nova-lexer/src/lexer.nova"
import "../../nova-parser/src/ast.nova"

struct SaFn {
    name: String,
    params: List<String>,
    types: List<String>,
    ret: String,
    line: Int,
    column: Int,
}

struct SaStruct {
    name: String,
    fields: List<String>,
    types: List<String>,
}

struct SaEnum {
    name: String,
    variants: List<String>,
    payload_types: List<String>,
    payload_counts: List<Int>,
    payload_offsets: List<Int>,
}

struct SaLocal {
    name: String,
    type_name: String,
}

struct SaCtx {
    ast: Ast,
    fns: List<SaFn>,
    structs: List<SaStruct>,
    enums: List<SaEnum>,
    errors: List<String>,
    locals: List<SaLocal>,
    ret: String,
    loops: Int,
}

struct SaResult {
    ctx: SaCtx,
    type_name: String,
}

fn sa_has(names: List<String>, name: String) -> Bool {
    for existing in names {
        if existing == name {
            return true
        }
    }
    return false
}

fn sa_fn_index(fns: List<SaFn>, name: String) -> Int {
    var i = 0
    while i < fns.len() {
        if fns[i].name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn sa_struct_index(structs: List<SaStruct>, name: String) -> Int {
    var i = 0
    while i < structs.len() {
        if structs[i].name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn sa_enum_index(enums: List<SaEnum>, name: String) -> Int {
    var i = 0
    while i < enums.len() {
        if enums[i].name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn sa_field_index(item: SaStruct, name: String) -> Int {
    var i = 0
    while i < item.fields.len() {
        if item.fields[i] == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn sa_variant_index(item: SaEnum, name: String) -> Int {
    var i = 0
    while i < item.variants.len() {
        if item.variants[i] == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn sa_variant_payload_count(item: SaEnum, variant: Int) -> Int {
    if variant < 0 || variant >= item.payload_counts.len() {
        return 0
    }
    return item.payload_counts[variant]
}

fn sa_variant_payload_types(item: SaEnum, variant: Int) -> List<String> {
    var out: List<String> = []
    let count = sa_variant_payload_count(item, variant)
    if variant < 0 || variant >= item.payload_offsets.len() {
        return out
    }
    var i = 0
    while i < count {
        let slot = item.payload_offsets[variant] + i
        if slot >= 0 && slot < item.payload_types.len() {
            out.push(item.payload_types[slot])
        }
        i = i + 1
    }
    return out
}

fn sa_split_types(text: String) -> List<String> {
    var out: List<String> = []
    if text.len() == 0 {
        return out
    }
    var current = ""
    var depth = 0
    for c in text.chars() {
        if c == "<" {
            depth = depth + 1
            current = current + c
        } else if c == ">" {
            depth = depth - 1
            current = current + c
        } else if c == "," && depth == 0 {
            if current.len() > 0 {
                out.push(current)
            }
            current = ""
        } else {
            current = current + c
        }
    }
    if current.len() > 0 {
        out.push(current)
    }
    return out
}

fn sa_pattern_variant(pattern: String) -> String {
    var out = ""
    for c in pattern.chars() {
        if c == "(" {
            return out
        }
        out = out + c
    }
    return out
}

fn sa_pattern_payload(pattern: String) -> String {
    var out = ""
    var started = false
    for c in pattern.chars() {
        if c == ")" && started {
            return out
        }
        if started {
            out = out + c
        } else if c == "(" {
            started = true
        }
    }
    return out
}

fn sa_pattern_args(pattern: String) -> List<String> {
    var out: List<String> = []
    let payload = sa_pattern_payload(pattern)
    if payload.len() == 0 {
        return out
    }
    var current = ""
    for c in payload.chars() {
        if c == "," {
            if current.len() > 0 {
                out.push(current)
            }
            current = ""
        } else {
            current = current + c
        }
    }
    if current.len() > 0 {
        out.push(current)
    }
    return out
}

fn sa_identifier(text: String) -> Bool {
    if text.len() == 0 {
        return false
    }
    let chars = text.chars()
    let first = chars[0]
    if !"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_".contains(first) {
        return false
    }
    var i = 1
    while i < chars.len() {
        if !"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_".contains(chars[i]) {
            return false
        }
        i = i + 1
    }
    return true
}

fn sa_lookup(ctx: SaCtx, name: String) -> String {
    var i = ctx.locals.len() - 1
    while i >= 0 {
        if ctx.locals[i].name == name {
            return ctx.locals[i].type_name
        }
        i = i - 1
    }
    return ""
}

fn sa_variant_enum(ctx: SaCtx, name: String) -> String {
    for item in ctx.enums {
        if sa_has(item.variants, name) {
            return item.name
        }
    }
    return ""
}

fn sa_builtin(name: String) -> Bool {
    if name == "println" || name == "print" || name == "panic" {
        return true
    }
    return name == "assert"
}

fn sa_elem_type(name: String) -> String {
    let chars = name.chars()
    if chars.len() > 6 && name.starts_with("List<") && name.ends_with(">") {
        return lx_slice(chars, 5, chars.len() - 1)
    }
    return "?"
}

fn sa_string_pattern(text: String) -> Bool {
    return text.len() >= 2 && text.starts_with("\"") && text.ends_with("\"")
}

fn sa_int_pattern(text: String) -> Bool {
    let chars = text.chars()
    if chars.len() == 0 {
        return false
    }
    var i = 0
    if chars[0] == "-" {
        i = 1
    }
    if i >= chars.len() {
        return false
    }
    while i < chars.len() {
        if !"0123456789_".contains(chars[i]) {
            return false
        }
        i = i + 1
    }
    return true
}

fn sa_match_expr(ctx: SaCtx, node: Int, scrutinee: String) -> SaResult {
    let item = ctx.ast.nodes[node]
    var work = ctx
    var result = ""
    var wildcard = false
    var has_true = false
    var has_false = false
    var seen: List<String> = []
    let enum_index = sa_enum_index(ctx.enums, scrutinee)
    let supported = scrutinee == "Int" || scrutinee == "Bool" || scrutinee == "String" || scrutinee == "?" || enum_index >= 0
    if !supported {
        work = sa_error(work, node, "E0311", "match supports Int, Bool, String or enum scrutinees, got " + scrutinee)
    }
    var i = 1
    while i < item.count {
        let arm = a_child(ctx.ast, node, i)
        if arm < 0 {
            work = sa_error(work, node, "E0311", "invalid match arm")
        } else {
            let pattern = ctx.ast.nodes[arm].text
            var bindings: List<SaLocal> = []
            if pattern.len() == 0 {
                work = sa_error(work, arm, "E0311", "empty match pattern")
            } else if wildcard {
                work = sa_error(work, arm, "E0312", "unreachable match arm after `_`")
            } else if pattern == "_" {
                wildcard = true
            } else if enum_index >= 0 {
                let def = work.enums[enum_index]
                let variant_name = sa_pattern_variant(pattern)
                let variant = sa_variant_index(def, variant_name)
                if variant < 0 {
                    work = sa_error(work, arm, "E0305", "unknown variant `" + variant_name + "` on " + def.name)
                } else {
                    let expected = sa_variant_payload_count(def, variant)
                    let args = sa_pattern_args(pattern)
                    if args.len() != expected {
                        work = sa_error(
                            work,
                            arm,
                            "E0303",
                            def.name + "." + variant_name + " expects " + expected.to_string() + " payload bindings, got " + args.len().to_string()
                        )
                    } else if sa_has(seen, variant_name) {
                        work = sa_error(work, arm, "E0312", "duplicate match arm `" + variant_name + "`")
                    } else {
                        seen.push(variant_name)
                        var b = 0
                        while b < args.len() {
                            let binding = args[b]
                            if binding.len() == 0 {
                                work = sa_error(work, arm, "E0311", "empty payload binding")
                            } else if binding != "_" {
                                if !sa_identifier(binding) {
                                    work = sa_error(work, arm, "E0311", "unsupported payload pattern `" + binding + "`")
                                } else {
                                    bindings.push(
                                        SaLocal {
                                            name: binding,
                                            type_name: sa_variant_payload_types(def, variant)[b],
                                        }
                                    )
                                }
                            }
                            b = b + 1
                        }
                    }
                }
            } else if supported && scrutinee == "String" {
                if !sa_string_pattern(pattern) {
                    work = sa_error(work, arm, "E0311", "unsupported match pattern `" + pattern + "` for String")
                } else if sa_has(seen, pattern) {
                    work = sa_error(work, arm, "E0312", "duplicate match arm `" + pattern + "`")
                } else {
                    seen.push(pattern)
                }
            } else if supported && scrutinee == "Int" {
                if pattern == "true" || pattern == "false" {
                    work = sa_error(
                        work,
                        arm,
                        "E0311",
                        "Bool pattern `" + pattern + "` requires a Bool scrutinee"
                    )
                } else if !sa_int_pattern(pattern) {
                    work = sa_error(work, arm, "E0311", "unsupported match pattern `" + pattern + "` for Int")
                } else if sa_has(seen, pattern) {
                    work = sa_error(work, arm, "E0312", "duplicate match arm `" + pattern + "`")
                } else {
                    seen.push(pattern)
                }
            } else if supported && scrutinee == "Bool" {
                if pattern == "true" || pattern == "false" {
                    if sa_has(seen, pattern) {
                        work = sa_error(work, arm, "E0312", "duplicate match arm `" + pattern + "`")
                    } else {
                        seen.push(pattern)
                        if pattern == "true" {
                            has_true = true
                        } else {
                            has_false = true
                        }
                    }
                } else if sa_int_pattern(pattern) {
                    work = sa_error(
                        work,
                        arm,
                        "E0311",
                        "integer pattern `" + pattern + "` requires an Int scrutinee"
                    )
                } else {
                    work = sa_error(work, arm, "E0311", "unsupported match pattern `" + pattern + "` for Bool")
                }
            }
            let body = a_child(ctx.ast, arm, 0)
            let saved = work.locals.len()
            for binding in bindings {
                work = sa_push_local(work, binding.name, binding.type_name)
            }
            var body_ty = "?"
            if body >= 0 && ctx.ast.nodes[body].kind == ak_block() {
                work = sa_block(work, body)
                body_ty = "Unit"
            } else {
                let value = sa_expr(work, body)
                work = value.ctx
                body_ty = value.type_name
            }
            work = sa_trim_locals(work, saved)
            if result.len() == 0 {
                result = body_ty
            } else if body_ty != "?" && result != "?" && !sa_same(result, body_ty) {
                work = sa_error(
                    work,
                    body,
                    "E0301",
                    "match arms must return the same type, got " + result + " and " + body_ty
                )
                result = "?"
            }
        }
        i = i + 1
    }
    if item.count == 1 {
        work = sa_error(work, node, "E0313", "match has no arms")
    } else if scrutinee == "Int" && !wildcard {
        work = sa_error(work, node, "E0313", "non-exhaustive match on Int; add `_`")
    } else if scrutinee == "Bool" && !wildcard && !(has_true && has_false) {
        work = sa_error(work, node, "E0313", "non-exhaustive match on Bool; cover true and false or add `_`")
    } else if scrutinee == "String" && !wildcard {
        work = sa_error(work, node, "E0313", "non-exhaustive match on String; add `_`")
    } else if enum_index >= 0 && !wildcard && seen.len() < work.enums[enum_index].variants.len() {
        work = sa_error(
            work,
            node,
            "E0313",
            "non-exhaustive match on " + scrutinee + "; cover every variant or add `_`"
        )
    }
    if result.len() == 0 {
        result = "?"
    }
    return sa_result(work, result)
}

fn sa_same(expected: String, actual: String) -> Bool {
    if expected == "?" || actual == "?" || expected == "Any" {
        return true
    }
    return expected == actual
}

fn sa_ctx_errors(ctx: SaCtx, errors: List<String>) -> SaCtx {
    return SaCtx {
        ast: ctx.ast,
        fns: ctx.fns,
        structs: ctx.structs,
        enums: ctx.enums,
        errors: errors,
        locals: ctx.locals,
        ret: ctx.ret,
        loops: ctx.loops,
    }
}

fn sa_ctx_locals(ctx: SaCtx, locals: List<SaLocal>) -> SaCtx {
    return SaCtx {
        ast: ctx.ast,
        fns: ctx.fns,
        structs: ctx.structs,
        enums: ctx.enums,
        errors: ctx.errors,
        locals: locals,
        ret: ctx.ret,
        loops: ctx.loops,
    }
}

fn sa_ctx_ret(ctx: SaCtx, ret: String) -> SaCtx {
    return SaCtx {
        ast: ctx.ast,
        fns: ctx.fns,
        structs: ctx.structs,
        enums: ctx.enums,
        errors: ctx.errors,
        locals: ctx.locals,
        ret: ret,
        loops: ctx.loops,
    }
}

fn sa_ctx_loops(ctx: SaCtx, loops: Int) -> SaCtx {
    return SaCtx {
        ast: ctx.ast,
        fns: ctx.fns,
        structs: ctx.structs,
        enums: ctx.enums,
        errors: ctx.errors,
        locals: ctx.locals,
        ret: ctx.ret,
        loops: loops,
    }
}

fn sa_error(ctx: SaCtx, node: Int, code: String, message: String) -> SaCtx {
    if node < 0 || node >= ctx.ast.nodes.len() {
        return ctx
    }
    let item = ctx.ast.nodes[node]
    var errors = ctx.errors
    errors.push(code + " " + message + " at line " + item.line.to_string() + ", column " + item.column.to_string())
    return sa_ctx_errors(ctx, errors)
}

fn sa_result(ctx: SaCtx, type_name: String) -> SaResult {
    return SaResult { ctx: ctx, type_name: type_name }
}

fn sa_fail(ctx: SaCtx, node: Int, code: String, message: String) -> SaResult {
    return SaResult { ctx: sa_error(ctx, node, code, message), type_name: "?" }
}

fn sa_push_local(ctx: SaCtx, name: String, type_name: String) -> SaCtx {
    var locals = ctx.locals
    locals.push(SaLocal { name: name, type_name: type_name })
    return sa_ctx_locals(ctx, locals)
}

fn sa_trim_locals(ctx: SaCtx, count: Int) -> SaCtx {
    var locals: List<SaLocal> = []
    var i = 0
    while i < count && i < ctx.locals.len() {
        locals.push(ctx.locals[i])
        i = i + 1
    }
    return sa_ctx_locals(ctx, locals)
}

fn sa_check_bool(ctx: SaCtx, node: Int) -> SaCtx {
    let value = sa_expr(ctx, node)
    if value.type_name != "?" && value.type_name != "Bool" {
        return sa_error(value.ctx, node, "E0309", "condition must be Bool, got " + value.type_name)
    }
    return value.ctx
}

fn sa_args(ctx: SaCtx, call: Int, start: Int, expected: List<String>, check_types: Bool) -> SaCtx {
    var work = ctx
    let total = ctx.ast.nodes[call].count
    var i = start
    var index = 0
    while i < total {
        let child = a_child(work.ast, call, i)
        let value = sa_expr(work, child)
        work = value.ctx
        if check_types && index < expected.len() && !sa_same(expected[index], value.type_name) {
            work = sa_error(
                work,
                child,
                "E0301",
                "argument " + (index + 1).to_string() + " expected " + expected[index] + ", got " + value.type_name
            )
        }
        i = i + 1
        index = index + 1
    }
    return work
}

fn sa_expr(ctx: SaCtx, node: Int) -> SaResult {
    if node < 0 || node >= ctx.ast.nodes.len() {
        return sa_result(ctx, "?")
    }
    let item = ctx.ast.nodes[node]
    if item.kind == ak_number() {
        return sa_result(ctx, "Int")
    }
    if item.kind == ak_string() {
        return sa_result(ctx, "String")
    }
    if item.kind == ak_bool() {
        return sa_result(ctx, "Bool")
    }
    if item.kind == ak_ident() {
        let local = sa_lookup(ctx, item.text)
        if local.len() > 0 {
            return sa_result(ctx, local)
        }
        let variant = sa_variant_enum(ctx, item.text)
        if variant.len() > 0 {
            let enum_index = sa_enum_index(ctx.enums, variant)
            let variant_index = sa_variant_index(ctx.enums[enum_index], item.text)
            let count = sa_variant_payload_count(ctx.enums[enum_index], variant_index)
            if count != 0 {
                return sa_fail(
                    ctx,
                    node,
                    "E0303",
                    variant + "." + item.text + " expects " + count.to_string() + " payload values, got 0"
                )
            }
            return sa_result(ctx, variant)
        }
        return sa_fail(ctx, node, "E0300", "unknown name `" + item.text + "`")
    }
    if item.kind == ak_unary() {
        let value = sa_expr(ctx, a_child(ctx.ast, node, 0))
        if value.type_name == "?" {
            return value
        }
        if item.text == "-" && value.type_name != "Int" {
            return sa_fail(value.ctx, node, "E0309", "unary - expects Int, got " + value.type_name)
        }
        if item.text == "!" && value.type_name != "Bool" {
            return sa_fail(value.ctx, node, "E0309", "unary ! expects Bool, got " + value.type_name)
        }
        return sa_result(value.ctx, value.type_name)
    }
    if item.kind == ak_binary() {
        let left = sa_expr(ctx, a_child(ctx.ast, node, 0))
        let right = sa_expr(left.ctx, a_child(ctx.ast, node, 1))
        var work = right.ctx
        let op = item.text
        let l = left.type_name
        let r = right.type_name
        if op == "=" || op == "+=" || op == "-=" || op == "*=" || op == "/=" || op == "%=" {
            if op != "=" && l != "?" && l != "Int" {
                work = sa_error(work, node, "E0309", "compound assignment expects Int, got " + l)
            }
            if !sa_same(l, r) {
                work = sa_error(work, node, "E0301", "assignment expected " + l + ", got " + r)
            }
            return sa_result(work, l)
        }
        if op == "+" && l == "String" && r == "String" {
            return sa_result(work, "String")
        }
        if op == "+" && l == "List<Int>" && r == "List<Int>" {
            return sa_result(work, "List<Int>")
        }
        if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
            if l == "Int" && r == "Int" {
                return sa_result(work, "Int")
            }
            if l != "?" && r != "?" {
                return sa_fail(work, node, "E0309", "operator " + op + " expects Int operands, got " + l + " and " + r)
            }
            return sa_result(work, "?")
        }
        if op == ".." {
            if l == "Int" && r == "Int" {
                return sa_result(work, "Range")
            }
            if l != "?" && r != "?" {
                return sa_fail(work, node, "E0309", "range expects Int bounds, got " + l + " and " + r)
            }
            return sa_result(work, "?")
        }
        if op == "&&" || op == "||" {
            if (l == "Bool" || l == "?") && (r == "Bool" || r == "?") {
                return sa_result(work, "Bool")
            }
            return sa_fail(work, node, "E0309", "operator " + op + " expects Bool operands, got " + l + " and " + r)
        }
        if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
            if !sa_same(l, r) {
                return sa_fail(work, node, "E0301", "comparison operands differ: " + l + " and " + r)
            }
            return sa_result(work, "Bool")
        }
        return sa_result(work, "?")
    }
    if item.kind == ak_call() {
        let callee = a_child(ctx.ast, node, 0)
        if callee < 0 {
            return sa_result(ctx, "?")
        }
        let callee_node = ctx.ast.nodes[callee]
        if callee_node.kind == ak_ident() {
            let variant = sa_variant_enum(ctx, callee_node.text)
            if variant.len() > 0 {
                let enum_index = sa_enum_index(ctx.enums, variant)
                let variant_index = sa_variant_index(ctx.enums[enum_index], callee_node.text)
                let types = sa_variant_payload_types(ctx.enums[enum_index], variant_index)
                let got = ctx.ast.nodes[node].count - 1
                var work = ctx
                if got != types.len() {
                    work = sa_error(
                        work,
                        node,
                        "E0303",
                        variant + "." + callee_node.text + " expects " + types.len().to_string() + " payload values, got " + got.to_string()
                    )
                }
                work = sa_args(work, node, 1, types, true)
                return sa_result(work, variant)
            }
            if sa_builtin(callee_node.text) {
                let work = sa_args(ctx, node, 1, [], false)
                return sa_result(work, "Unit")
            }
            let index = sa_fn_index(ctx.fns, callee_node.text)
            if index < 0 {
                let work = sa_args(ctx, node, 1, [], false)
                return sa_fail(work, node, "E0302", "unknown function `" + callee_node.text + "`")
            }
            let sig = ctx.fns[index]
            let got = ctx.ast.nodes[node].count - 1
            var work = ctx
            if got != sig.params.len() {
                work = sa_error(
                    work,
                    node,
                    "E0303",
                    callee_node.text + " expects " + sig.params.len().to_string() + " arguments, got " + got.to_string()
                )
            }
            work = sa_args(work, node, 1, sig.types, true)
            return sa_result(work, sig.ret)
        }
        if callee_node.kind == ak_member() {
            let object = sa_expr(ctx, a_child(ctx.ast, callee, 0))
            var work = sa_args(object.ctx, node, 1, [], false)
            if callee_node.text == "contains" && object.type_name == "List<Int>" {
                work = sa_args(work, node, 1, ["Int"], true)
                return sa_result(work, "Bool")
            }
            if callee_node.text == "contains" || callee_node.text == "starts_with" || callee_node.text == "ends_with" {
                if object.type_name != "?" && object.type_name != "String" {
                    work = sa_error(work, node, "E0309", callee_node.text + " requires a String receiver")
                }
                work = sa_args(work, node, 1, ["String"], true)
                return sa_result(work, "Bool")
            }
            if callee_node.text == "trim" || callee_node.text == "trim_start" || callee_node.text == "trim_end" {
                if object.type_name != "?" && object.type_name != "String" {
                    work = sa_error(work, node, "E0309", callee_node.text + " requires a String receiver")
                }
                work = sa_args(work, node, 1, [], false)
                return sa_result(work, "String")
            }
            if callee_node.text == "reverse" {
                if object.type_name != "?" && object.type_name != "List<Int>" {
                    work = sa_error(work, node, "E0309", "reverse requires a List<Int> receiver")
                }
                work = sa_args(work, node, 1, [], false)
                return sa_result(work, "List<Int>")
            }
            if callee_node.text == "first" || callee_node.text == "last" {
                if object.type_name != "?" && object.type_name != "List<Int>" {
                    work = sa_error(work, node, "E0309", callee_node.text + " requires a List<Int> receiver")
                }
                work = sa_args(work, node, 1, [], false)
                return sa_result(work, "Int")
            }
            if callee_node.text == "is_empty" {
                if object.type_name != "?" && object.type_name != "String" {
                    work = sa_error(work, node, "E0309", "is_empty requires a String receiver")
                }
                work = sa_args(work, node, 1, [], false)
                return sa_result(work, "Bool")
            }
            if callee_node.text == "bytes" {
                if object.type_name != "?" && object.type_name != "String" {
                    work = sa_error(work, node, "E0309", "bytes requires a String receiver")
                }
                work = sa_args(work, node, 1, [], false)
                return sa_result(work, "List<Int>")
            }
            if callee_node.text == "replace" {
                if object.type_name != "?" && object.type_name != "String" {
                    work = sa_error(work, node, "E0309", "replace requires a String receiver")
                }
                work = sa_args(work, node, 1, ["String", "String"], true)
                return sa_result(work, "String")
            }
            if callee_node.text == "lower" || callee_node.text == "upper" {
                if object.type_name != "?" && object.type_name != "String" {
                    work = sa_error(work, node, "E0309", callee_node.text + " requires a String receiver")
                }
                work = sa_args(work, node, 1, [], false)
                return sa_result(work, "String")
            }
            if callee_node.text == "len" {
                return sa_result(work, "Int")
            }
            if callee_node.text == "to_string" {
                return sa_result(work, "String")
            }
            return sa_result(work, "?")
        }
        let object = sa_expr(ctx, callee)
        let work = sa_args(object.ctx, node, 1, [], false)
        return sa_result(work, "?")
    }
    if item.kind == ak_member() {
        let object = sa_expr(ctx, a_child(ctx.ast, node, 0))
        if object.type_name == "?" {
            return object
        }
        let index = sa_struct_index(ctx.structs, object.type_name)
        if index >= 0 {
            let field = sa_field_index(ctx.structs[index], item.text)
            if field < 0 {
                return sa_fail(object.ctx, node, "E0305", "unknown field `" + item.text + "` on " + object.type_name)
            }
            return sa_result(object.ctx, ctx.structs[index].types[field])
        }
        return sa_result(object.ctx, "?")
    }
    if item.kind == ak_index() {
        let object = sa_expr(ctx, a_child(ctx.ast, node, 0))
        let index_node = a_child(ctx.ast, node, 1)
        if index_node >= 0 && ctx.ast.nodes[index_node].kind == ak_binary() && ctx.ast.nodes[index_node].text == ".." {
            let start = sa_expr(object.ctx, a_child(ctx.ast, index_node, 0))
            let end = sa_expr(start.ctx, a_child(ctx.ast, index_node, 1))
            var work = end.ctx
            if object.type_name != "List<Int>" && object.type_name != "?" {
                work = sa_error(work, node, "E0301", "slicing expects List<Int>, got " + object.type_name)
            }
            if !sa_same("Int", start.type_name) && start.type_name != "?" {
                work = sa_error(work, a_child(ctx.ast, index_node, 0), "E0301", "slice start must be Int, got " + start.type_name)
            }
            if !sa_same("Int", end.type_name) && end.type_name != "?" {
                work = sa_error(work, a_child(ctx.ast, index_node, 1), "E0301", "slice end must be Int, got " + end.type_name)
            }
            return sa_result(work, "List<Int>")
        }
        let index = sa_expr(object.ctx, a_child(ctx.ast, node, 1))
        var work = index.ctx
        if !sa_same("Int", index.type_name) && index.type_name != "?" {
            work = sa_error(work, a_child(ctx.ast, node, 1), "E0301", "index must be Int, got " + index.type_name)
        }
        return sa_result(work, sa_elem_type(object.type_name))
    }
    if item.kind == ak_list() {
        var work = ctx
        var element = ""
        var i = 0
        while i < item.count {
            let value = sa_expr(work, a_child(ctx.ast, node, i))
            work = value.ctx
            if element.len() == 0 {
                element = value.type_name
            } else if !sa_same(element, value.type_name) {
                work = sa_error(work, node, "E0301", "list elements must share a type, got " + element + " and " + value.type_name)
            }
            i = i + 1
        }
        if element.len() == 0 {
            element = "?"
        }
        return sa_result(work, "List<" + element + ">")
    }
    if item.kind == ak_tuple() {
        var work = ctx
        var text = "("
        var i = 0
        while i < item.count {
            if i > 0 {
                text = text + ","
            }
            let value = sa_expr(work, a_child(ctx.ast, node, i))
            work = value.ctx
            text = text + value.type_name
            i = i + 1
        }
        return sa_result(work, text + ")")
    }
    if item.kind == ak_struct_lit() {
        let index = sa_struct_index(ctx.structs, item.text)
        var work = ctx
        if index < 0 {
            work = sa_error(work, node, "E0304", "unknown type `" + item.text + "`")
        }
        var seen: List<String> = []
        var i = 0
        while i < item.count {
            let field = a_child(ctx.ast, node, i)
            let field_node = ctx.ast.nodes[field]
            let value = sa_expr(work, a_child(ctx.ast, field, 0))
            work = value.ctx
            if sa_has(seen, field_node.text) {
                work = sa_error(work, field, "E0307", "duplicate field `" + field_node.text + "` on " + item.text)
            } else {
                seen.push(field_node.text)
            }
            if index >= 0 {
                let slot = sa_field_index(ctx.structs[index], field_node.text)
                if slot < 0 {
                    work = sa_error(work, field, "E0305", "unknown field `" + field_node.text + "` on " + item.text)
                } else if !sa_same(ctx.structs[index].types[slot], value.type_name) {
                    work = sa_error(
                        work,
                        field,
                        "E0301",
                        "field " + field_node.text + " expected " + ctx.structs[index].types[slot] + ", got " + value.type_name
                    )
                }
            }
            i = i + 1
        }
        if index >= 0 {
            for required in ctx.structs[index].fields {
                if !sa_has(seen, required) {
                    work = sa_error(work, node, "E0306", "missing field `" + required + "` on " + item.text)
                }
            }
        }
        return sa_result(work, item.text)
    }
    if item.kind == ak_match() {
        let scrutinee = sa_expr(ctx, a_child(ctx.ast, node, 0))
        return sa_match_expr(scrutinee.ctx, node, scrutinee.type_name)
    }
    if item.kind == ak_if() {
        var work = sa_check_bool(ctx, a_child(ctx.ast, node, 0))
        let then_block = a_child(ctx.ast, node, 1)
        work = sa_block(work, then_block)
        if item.count > 2 {
            let other = a_child(ctx.ast, node, 2)
            if ctx.ast.nodes[other].kind == ak_if() {
                let branch = sa_expr(work, other)
                work = branch.ctx
            } else {
                work = sa_block(work, other)
            }
        }
        return sa_result(work, "?")
    }
    return sa_result(ctx, "?")
}

fn sa_block(ctx: SaCtx, node: Int) -> SaCtx {
    if node < 0 || node >= ctx.ast.nodes.len() {
        return ctx
    }
    let saved = ctx.locals.len()
    var work = ctx
    var i = 0
    while i < ctx.ast.nodes[node].count {
        work = sa_stmt(work, a_child(ctx.ast, node, i))
        i = i + 1
    }
    return sa_trim_locals(work, saved)
}

fn sa_stmt(ctx: SaCtx, node: Int) -> SaCtx {
    if node < 0 || node >= ctx.ast.nodes.len() {
        return ctx
    }
    let item = ctx.ast.nodes[node]
    if item.kind == ak_let() || item.kind == ak_var() {
        let value = sa_expr(ctx, a_child(ctx.ast, node, 0))
        var work = value.ctx
        var type_name = item.aux
        if type_name.len() > 0 {
            if !sa_same(type_name, value.type_name) {
                work = sa_error(work, node, "E0301", "binding " + item.text + " expected " + type_name + ", got " + value.type_name)
            }
        } else {
            type_name = value.type_name
        }
        return sa_push_local(work, item.text, type_name)
    }
    if item.kind == ak_return() {
        if item.count == 0 {
            if ctx.ret != "Unit" && ctx.ret != "?" {
                return sa_error(ctx, node, "E0308", "function returns " + ctx.ret + " but this return has no value")
            }
            return ctx
        }
        let value = sa_expr(ctx, a_child(ctx.ast, node, 0))
        if ctx.ret != "?" && !sa_same(ctx.ret, value.type_name) {
            return sa_error(
                value.ctx,
                node,
                "E0308",
                "return expected " + ctx.ret + ", got " + value.type_name
            )
        }
        return value.ctx
    }
    if item.kind == ak_expr_stmt() {
        return sa_expr(ctx, a_child(ctx.ast, node, 0)).ctx
    }
    if item.kind == ak_block() {
        return sa_block(ctx, node)
    }
    if item.kind == ak_if() {
        var work = sa_check_bool(ctx, a_child(ctx.ast, node, 0))
        work = sa_block(work, a_child(ctx.ast, node, 1))
        if item.count > 2 {
            let other = a_child(ctx.ast, node, 2)
            if ctx.ast.nodes[other].kind == ak_if() {
                work = sa_stmt(work, other)
            } else {
                work = sa_block(work, other)
            }
        }
        return work
    }
    if item.kind == ak_while() {
        var work = sa_check_bool(ctx, a_child(ctx.ast, node, 0))
        work = sa_ctx_loops(work, work.loops + 1)
        work = sa_block(work, a_child(ctx.ast, node, 1))
        return sa_ctx_loops(work, work.loops - 1)
    }
    if item.kind == ak_for() {
        let iter = sa_expr(ctx, a_child(ctx.ast, node, 0))
        var work = iter.ctx
        var element = "?"
        if iter.type_name.starts_with("List<") {
            element = sa_elem_type(iter.type_name)
        } else if iter.type_name == "Range" {
            element = "Int"
        }
        work = sa_push_local(work, item.text, element)
        work = sa_ctx_loops(work, work.loops + 1)
        work = sa_block(work, a_child(ctx.ast, node, 1))
        return sa_ctx_loops(work, work.loops - 1)
    }
    if item.kind == ak_break() || item.kind == ak_continue() {
        if ctx.loops == 0 {
            return sa_error(ctx, node, "E0310", "`" + item.text + "` outside a loop")
        }
        return ctx
    }
    if item.kind == ak_match() {
        return sa_expr(ctx, node).ctx
    }
    return ctx
}

fn sa_check_fn(ctx: SaCtx, node: Int) -> SaCtx {
    let item = ctx.ast.nodes[node]
    let index = sa_fn_index(ctx.fns, item.text)
    if index < 0 {
        return ctx
    }
    let sig = ctx.fns[index]
    var locals: List<SaLocal> = []
    var i = 0
    while i < sig.params.len() {
        locals.push(SaLocal { name: sig.params[i], type_name: sig.types[i] })
        i = i + 1
    }
    var work = sa_ctx_locals(ctx, locals)
    work = sa_ctx_ret(work, sig.ret)
    work = sa_ctx_loops(work, 0)
    let body = a_child(ctx.ast, node, item.count - 1)
    return sa_block(work, body)
}

fn sa_collect(ctx: SaCtx) -> SaCtx {
    var work = ctx
    let file = ctx.ast.nodes.len() - 1
    var i = 0
    while i < ctx.ast.nodes[file].count {
        let node = a_child(ctx.ast, file, i)
        let item = ctx.ast.nodes[node]
        if item.kind == ak_fn() || item.kind == ak_extern() {
            if sa_fn_index(work.fns, item.text) >= 0 {
                work = sa_error(work, node, "E0307", "duplicate function `" + item.text + "`")
            } else {
                var params: List<String> = []
                var types: List<String> = []
                let last = if item.kind == ak_fn() { item.count - 1 } else { item.count }
                var k = 0
                while k < last {
                    let param = ctx.ast.nodes[a_child(ctx.ast, node, k)]
                    params.push(param.text)
                    types.push(param.aux)
                    k = k + 1
                }
                var ret = item.aux
                if ret.len() == 0 {
                    ret = "Unit"
                }
                var fns = work.fns
                fns.push(
                    SaFn {
                        name: item.text,
                        params: params,
                        types: types,
                        ret: ret,
                        line: item.line,
                        column: item.column,
                    }
                )
                work = SaCtx {
                    ast: work.ast,
                    fns: fns,
                    structs: work.structs,
                    enums: work.enums,
                    errors: work.errors,
                    locals: work.locals,
                    ret: work.ret,
                    loops: work.loops,
                }
            }
        } else if item.kind == ak_struct() {
            if sa_struct_index(work.structs, item.text) >= 0 {
                work = sa_error(work, node, "E0307", "duplicate struct `" + item.text + "`")
            } else {
                var fields: List<String> = []
                var types: List<String> = []
                var k = 0
                while k < item.count {
                    let field = ctx.ast.nodes[a_child(ctx.ast, node, k)]
                    if sa_has(fields, field.text) {
                        work = sa_error(work, a_child(ctx.ast, node, k), "E0307", "duplicate field `" + field.text + "` on " + item.text)
                    }
                    fields.push(field.text)
                    types.push(field.aux)
                    k = k + 1
                }
                var structs = work.structs
                structs.push(SaStruct { name: item.text, fields: fields, types: types })
                work = SaCtx {
                    ast: work.ast,
                    fns: work.fns,
                    structs: structs,
                    enums: work.enums,
                    errors: work.errors,
                    locals: work.locals,
                    ret: work.ret,
                    loops: work.loops,
                }
            }
        } else if item.kind == ak_enum() {
            if sa_enum_index(work.enums, item.text) >= 0 {
                work = sa_error(work, node, "E0307", "duplicate enum `" + item.text + "`")
            } else {
                var variants: List<String> = []
                var payload_types: List<String> = []
                var payload_counts: List<Int> = []
                var payload_offsets: List<Int> = []
                var k = 0
                while k < item.count {
                    let variant_node = a_child(ctx.ast, node, k)
                    let variant = ctx.ast.nodes[variant_node]
                    if sa_has(variants, variant.text) {
                        work = sa_error(
                            work,
                            variant_node,
                            "E0307",
                            "duplicate variant `" + variant.text + "` on " + item.text
                        )
                    }
                    variants.push(variant.text)
                    let types = sa_split_types(variant.aux)
                    payload_offsets.push(payload_types.len())
                    payload_counts.push(types.len())
                    for payload_type in types {
                        payload_types.push(payload_type)
                    }
                    k = k + 1
                }
                var enums = work.enums
                enums.push(
                    SaEnum {
                        name: item.text,
                        variants: variants,
                        payload_types: payload_types,
                        payload_counts: payload_counts,
                        payload_offsets: payload_offsets,
                    }
                )
                work = SaCtx {
                    ast: work.ast,
                    fns: work.fns,
                    structs: work.structs,
                    enums: enums,
                    errors: work.errors,
                    locals: work.locals,
                    ret: work.ret,
                    loops: work.loops,
                }
            }
        }
        i = i + 1
    }
    return work
}

fn sa_check(source: String) -> List<String> {
    let ast = a_parse(source)
    if ast.error.len() > 0 {
        return ["E0001 parse error: " + ast.error]
    }
    var ctx = SaCtx {
        ast: ast,
        fns: [],
        structs: [],
        enums: [],
        errors: [],
        locals: [],
        ret: "Unit",
        loops: 0,
    }
    ctx = sa_collect(ctx)
    let file = ast.nodes.len() - 1
    var i = 0
    while i < ast.nodes[file].count {
        let node = a_child(ast, file, i)
        if ast.nodes[node].kind == ak_fn() {
            ctx = sa_check_fn(ctx, node)
        }
        i = i + 1
    }
    return ctx.errors
}
