// AST-based semantic checker, in Nova.
//
// This is the first body-level slice: declaration tables, scoped locals,
// expression and return types, call arity/types, struct fields and control-flow
// conditions. It deliberately reports only what it can prove; unknown host
// modules and unsupported forms become `?` rather than invented types.

import "../../nova-lexer/src/lexer.nova"
import "../../nova-parser/src/ast.nova"

struct SaFn {
    name: String,
    params: List<String>,
    types: List<String>,
    ret: String,
    line: Int,
    column: Int,
}

struct SaStruct {
    name: String,
    fields: List<String>,
    types: List<String>,
}

struct SaEnum {
    name: String,
    variants: List<String>,
    payload_types: List<String>,
    payload_counts: List<Int>,
    payload_offsets: List<Int>,
}

struct SaLocal {
    name: String,
    type_name: String,
    mutable: Bool,
}

struct SaCtx {
    ast: Ast,
    fns: List<SaFn>,
    structs: List<SaStruct>,
    enums: List<SaEnum>,
    errors: List<String>,
    locals: List<SaLocal>,
    ret: String,
    loops: Int,
}

struct SaResult {
    ctx: SaCtx,
    type_name: String,
}

fn sa_has(names: List<String>, name: String) -> Bool {
    for existing in names {
        if existing == name {
            return true
        }
    }
    return false
}

fn sa_fn_index(fns: List<SaFn>, name: String) -> Int {
    var i = 0
    while i < fns.len() {
        if fns[i].name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn sa_struct_index(structs: List<SaStruct>, name: String) -> Int {
    var i = 0
    while i < structs.len() {
        if structs[i].name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn sa_enum_index(enums: List<SaEnum>, name: String) -> Int {
    var i = 0
    while i < enums.len() {
        if enums[i].name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn sa_field_index(item: SaStruct, name: String) -> Int {
    var i = 0
    while i < item.fields.len() {
        if item.fields[i] == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn sa_variant_index(item: SaEnum, name: String) -> Int {
    var i = 0
    while i < item.variants.len() {
        if item.variants[i] == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn sa_variant_payload_count(item: SaEnum, variant: Int) -> Int {
    if variant < 0 || variant >= item.payload_counts.len() {
        return 0
    }
    return item.payload_counts[variant]
}

fn sa_variant_payload_types(item: SaEnum, variant: Int) -> List<String> {
    var out: List<String> = []
    let count = sa_variant_payload_count(item, variant)
    if variant < 0 || variant >= item.payload_offsets.len() {
        return out
    }
    var i = 0
    while i < count {
        let slot = item.payload_offsets[variant] + i
        if slot >= 0 && slot < item.payload_types.len() {
            out.push(item.payload_types[slot])
        }
        i = i + 1
    }
    return out
}

fn sa_split_types(text: String) -> List<String> {
    var out: List<String> = []
    if text.len() == 0 {
        return out
    }
    var current = ""
    var depth = 0
    for c in text.chars() {
        if c == "<" {
            depth = depth + 1
            current = current + c
        } else if c == ">" {
            depth = depth - 1
            current = current + c
        } else if c == "," && depth == 0 {
            if current.len() > 0 {
                out.push(current)
            }
            current = ""
        } else {
            current = current + c
        }
    }
    if current.len() > 0 {
        out.push(current)
    }
    return out
}

fn sa_pattern_variant(pattern: String) -> String {
    var out = ""
    for c in pattern.chars() {
        if c == "(" {
            return out
        }
        out = out + c
    }
    return out
}

fn sa_pattern_payload(pattern: String) -> String {
    var out = ""
    var started = false
    for c in pattern.chars() {
        if c == ")" && started {
            return out
        }
        if started {
            out = out + c
        } else if c == "(" {
            started = true
        }
    }
    return out
}

fn sa_pattern_args(pattern: String) -> List<String> {
    var out: List<String> = []
    let payload = sa_pattern_payload(pattern)
    if payload.len() == 0 {
        return out
    }
    var current = ""
    for c in payload.chars() {
        if c == "," {
            if current.len() > 0 {
                out.push(current)
            }
            current = ""
        } else {
            current = current + c
        }
    }
    if current.len() > 0 {
        out.push(current)
    }
    return out
}

fn sa_identifier(text: String) -> Bool {
    if text.len() == 0 {
        return false
    }
    let chars = text.chars()
    let first = chars[0]
    if !"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_".contains(first) {
        return false
    }
    var i = 1
    while i < chars.len() {
        if !"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_".contains(chars[i]) {
            return false
        }
        i = i + 1
    }
    return true
}

fn sa_lookup(ctx: SaCtx, name: String) -> String {
    var i = ctx.locals.len() - 1
    while i >= 0 {
        if ctx.locals[i].name == name {
            return ctx.locals[i].type_name
        }
        i = i - 1
    }
    return ""
}

fn sa_local_index(ctx: SaCtx, name: String) -> Int {
    var i = ctx.locals.len() - 1
    while i >= 0 {
        if ctx.locals[i].name == name {
            return i
        }
        i = i - 1
    }
    return -1
}

fn sa_local_mutable(ctx: SaCtx, name: String) -> Bool {
    let index = sa_local_index(ctx, name)
    if index >= 0 {
        return ctx.locals[index].mutable
    }
    return true
}

fn sa_root_ident(ast: Ast, node: Int) -> Int {
    if node < 0 || node >= ast.nodes.len() {
        return -1
    }
    var current = node
    var steps = 0
    while steps < ast.nodes.len() {
        let item = ast.nodes[current]
        if item.kind == ak_ident() {
            return current
        }
        if item.kind != ak_member() && item.kind != ak_index() {
            return -1
        }
        current = a_child(ast, current, 0)
        if current < 0 {
            return -1
        }
        steps = steps + 1
    }
    return -1
}

fn sa_variant_enum(ctx: SaCtx, name: String) -> String {
    for item in ctx.enums {
        if sa_has(item.variants, name) {
            return item.name
        }
    }
    return ""
}

fn sa_builtin(name: String) -> Bool {
    if name == "println" || name == "print" || name == "panic" {
        return true
    }
    return name == "assert"
}

fn sa_is_fn_type(name: String) -> Bool {
    if !name.starts_with("fn(") || !name.contains(")->") {
        return false
    }
    return true
}

fn sa_fn_params(name: String) -> List<String> {
    if !sa_is_fn_type(name) {
        return []
    }
    let chars = name.chars()
    var start = 3
    var stop = -1
    var i = 0
    while i + 2 < chars.len() {
        if chars[i] == ")" && chars[i + 1] == "-" && chars[i + 2] == ">" {
            stop = i
            i = chars.len()
        } else {
            i = i + 1
        }
    }
    if stop < start {
        return []
    }
    return sa_split_types(lx_slice(chars, start, stop))
}

fn sa_fn_ret(name: String) -> String {
    if !sa_is_fn_type(name) {
        return ""
    }
    let chars = name.chars()
    var i = 0
    while i + 2 < chars.len() {
        if chars[i] == ")" && chars[i + 1] == "-" && chars[i + 2] == ">" {
            return lx_slice(chars, i + 3, chars.len())
        }
        i = i + 1
    }
    return ""
}

fn sa_find_return(ast: Ast, node: Int) -> Int {
    if node < 0 || node >= ast.nodes.len() {
        return -1
    }
    let item = ast.nodes[node]
    if item.kind == ak_closure() {
        return -1
    }
    if item.kind == ak_return() && item.count > 0 {
        return a_child(ast, node, 0)
    }
    var i = 0
    while i < item.count {
        let found = sa_find_return(ast, a_child(ast, node, i))
        if found >= 0 {
            return found
        }
        i = i + 1
    }
    return -1
}

fn sa_guess_type(ctx: SaCtx, node: Int) -> String {
    if node < 0 || node >= ctx.ast.nodes.len() {
        return "?"
    }
    let item = ctx.ast.nodes[node]
    if item.kind == ak_number() {
        return "Int"
    }
    if item.kind == ak_string() || item.kind == ak_interp() || item.kind == ak_str_part() {
        return "String"
    }
    if item.kind == ak_bool() {
        return "Bool"
    }
    if item.kind == ak_ident() {
        return sa_lookup(ctx, item.text)
    }
    if item.kind == ak_unary() {
        return sa_guess_type(ctx, a_child(ctx.ast, node, 0))
    }
    if item.kind == ak_binary() {
        let op = item.text
        if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" || op == "&&" || op == "||" {
            return "Bool"
        }
        if op == "+" {
            let left = sa_guess_type(ctx, a_child(ctx.ast, node, 0))
            if left == "String" {
                return "String"
            }
            if left.starts_with("List<") {
                return left
            }
        }
        if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
            return "Int"
        }
        if op == ".." {
            return "Range"
        }
        return "?"
    }
    if item.kind == ak_call() {
        let callee = a_child(ctx.ast, node, 0)
        if callee >= 0 {
            let callee_item = ctx.ast.nodes[callee]
            if callee_item.kind == ak_ident() {
                let local = sa_lookup(ctx, callee_item.text)
                if sa_is_fn_type(local) {
                    return sa_fn_ret(local)
                }
                let index = sa_fn_index(ctx.fns, callee_item.text)
                if index >= 0 {
                    return ctx.fns[index].ret
                }
            }
            if callee_item.kind == ak_member() {
                let receiver = sa_guess_type(ctx, a_child(ctx.ast, callee, 0))
                let symbol = receiver + "." + callee_item.text
                let index = sa_fn_index(ctx.fns, symbol)
                if index >= 0 {
                    return ctx.fns[index].ret
                }
            }
        }
        return "?"
    }
    if item.kind == ak_member() {
        let receiver = sa_guess_type(ctx, a_child(ctx.ast, node, 0))
        let index = sa_struct_index(ctx.structs, receiver)
        if index >= 0 {
            let field = sa_field_index(ctx.structs[index], item.text)
            if field >= 0 {
                return ctx.structs[index].types[field]
            }
        }
        return "?"
    }
    if item.kind == ak_struct_lit() {
        return item.text
    }
    if item.kind == ak_list() {
        if item.count == 0 {
            return "List<?>"
        }
        return "List<" + sa_guess_type(ctx, a_child(ctx.ast, node, 0)) + ">"
    }
    if item.kind == ak_tuple() {
        var text = "("
        var i = 0
        while i < item.count {
            if i > 0 {
                text = text + ","
            }
            text = text + sa_guess_type(ctx, a_child(ctx.ast, node, i))
            i = i + 1
        }
        return text + ")"
    }
    return "?"
}

fn sa_generic_args(name: String) -> List<String> {
    let chars = name.chars()
    if chars.len() < 3 || chars[chars.len() - 1] != ">" {
        return []
    }
    var start = -1
    var i = 0
    while i < chars.len() {
        if chars[i] == "<" {
            start = i
            i = chars.len()
        } else {
            i = i + 1
        }
    }
    if start < 0 {
        return []
    }
    return sa_split_types(lx_slice(chars, start + 1, chars.len() - 1))
}

fn sa_option_inner(name: String) -> String {
    if name.starts_with("Option<") {
        let args = sa_generic_args(name)
        if args.len() == 1 {
            return args[0]
        }
    }
    return ""
}

fn sa_result_ok(name: String) -> String {
    if name.starts_with("Result<") {
        let args = sa_generic_args(name)
        if args.len() == 2 {
            return args[0]
        }
    }
    return ""
}

fn sa_result_err(name: String) -> String {
    if name.starts_with("Result<") {
        let args = sa_generic_args(name)
        if args.len() == 2 {
            return args[1]
        }
    }
    return ""
}

fn sa_is_map(name: String) -> Bool {
    return name.starts_with("Map<") && name.ends_with(">")
}

fn sa_map_key(name: String) -> String {
    if !sa_is_map(name) {
        return ""
    }
    let args = sa_generic_args(name)
    if args.len() != 2 {
        return ""
    }
    return args[0]
}

fn sa_map_value(name: String) -> String {
    if !sa_is_map(name) {
        return ""
    }
    let args = sa_generic_args(name)
    if args.len() != 2 {
        return ""
    }
    return args[1]
}

fn sa_is_set(name: String) -> Bool {
    return name.starts_with("Set<") && name.ends_with(">")
}

fn sa_set_elem(name: String) -> String {
    if !sa_is_set(name) {
        return ""
    }
    let args = sa_generic_args(name)
    if args.len() != 1 {
        return ""
    }
    return args[0]
}

fn sa_map_key_ok(name: String) -> Bool {
    return name == "Int" || name == "Bool" || name == "String" || name == "?"
}

fn sa_digit(c: String) -> Int {
    if c == "0" {
        return 0
    }
    if c == "1" {
        return 1
    }
    if c == "2" {
        return 2
    }
    if c == "3" {
        return 3
    }
    if c == "4" {
        return 4
    }
    if c == "5" {
        return 5
    }
    if c == "6" {
        return 6
    }
    if c == "7" {
        return 7
    }
    if c == "8" {
        return 8
    }
    if c == "9" {
        return 9
    }
    return -1
}

// `[elem; N]` returns (elem, N); a non-array returns ("", -1).
fn sa_array_layout(name: String) -> (String, Int) {
    let chars = name.chars()
    if chars.len() < 4 || chars[0] != "[" || chars[chars.len() - 1] != "]" {
        return ("", -1)
    }
    var depth = 0
    var split = -1
    var i = 1
    while i < chars.len() - 1 {
        let c = chars[i]
        if c == "[" || c == "<" || c == "(" {
            depth = depth + 1
        } else if c == "]" || c == ">" || c == ")" {
            depth = depth - 1
        } else if c == ";" && depth == 0 {
            split = i
            i = chars.len()
        }
        i = i + 1
    }
    if split < 0 {
        return ("", -1)
    }
    let elem = lx_slice(chars, 1, split)
    var length = 0
    var digits = 0
    var k = split + 1
    while k < chars.len() - 1 {
        let c = chars[k]
        if c != "_" {
            let digit = sa_digit(c)
            if digit < 0 {
                return ("", -1)
            }
            length = length * 10 + digit
            digits = digits + 1
        }
        k = k + 1
    }
    if digits == 0 {
        return ("", -1)
    }
    return (elem, length)
}

fn sa_elem_type(name: String) -> String {
    let array = sa_array_layout(name)
    if array.1 >= 0 {
        return array.0
    }
    let chars = name.chars()
    if chars.len() > 6 && name.starts_with("List<") && name.ends_with(">") {
        return lx_slice(chars, 5, chars.len() - 1)
    }
    if chars.len() > 7 && name.starts_with("Slice<") && name.ends_with(">") {
        return lx_slice(chars, 6, chars.len() - 1)
    }
    return "?"
}

fn sa_display_type(name: String) -> String {
    var out = ""
    for c in name.chars() {
        if c == "?" {
            out = out + "_"
        } else if c == "," {
            out = out + ", "
        } else {
            out = out + c
        }
    }
    return out
}

fn sa_string_pattern(text: String) -> Bool {
    return text.len() >= 2 && text.starts_with("\"") && text.ends_with("\"")
}

fn sa_int_pattern(text: String) -> Bool {
    let chars = text.chars()
    if chars.len() == 0 {
        return false
    }
    var i = 0
    if chars[0] == "-" {
        i = 1
    }
    if i >= chars.len() {
        return false
    }
    while i < chars.len() {
        if !"0123456789_".contains(chars[i]) {
            return false
        }
        i = i + 1
    }
    return true
}

fn sa_match_expr(ctx: SaCtx, node: Int, scrutinee: String) -> SaResult {
    let item = ctx.ast.nodes[node]
    var work = ctx
    var result = ""
    var wildcard = false
    var has_true = false
    var has_false = false
    var seen: List<String> = []
    var has_some = false
    var has_none = false
    var has_ok = false
    var has_err = false
    let option_inner = sa_option_inner(scrutinee)
    let result_ok = sa_result_ok(scrutinee)
    let result_err = sa_result_err(scrutinee)
    let is_option = option_inner.len() > 0
    let is_result = result_ok.len() > 0 && result_err.len() > 0
    let enum_index = sa_enum_index(ctx.enums, scrutinee)
    let supported = scrutinee == "Int" || scrutinee == "Bool" || scrutinee == "String" || scrutinee == "?" || is_option || is_result || enum_index >= 0
    if !supported {
        work = sa_error(work, node, "E0311", "match supports Int, Bool, String or enum scrutinees, got " + scrutinee)
    }
    var i = 1
    while i < item.count {
        let arm = a_child(ctx.ast, node, i)
        if arm < 0 {
            work = sa_error(work, node, "E0311", "invalid match arm")
        } else {
            let pattern = ctx.ast.nodes[arm].text
            var bindings: List<SaLocal> = []
            if pattern.len() == 0 {
                work = sa_error(work, arm, "E0311", "empty match pattern")
            } else if pattern == "_" {
                wildcard = true
            } else if is_option {
                let variant_name = sa_pattern_variant(pattern)
                let args = sa_pattern_args(pattern)
                if variant_name == "None" {
                    has_none = true
                    if args.len() != 0 {
                        work = sa_error(work, arm, "E0311", "`None` does not take a payload pattern")
                    }
                } else if variant_name == "Some" {
                    has_some = true
                    if args.len() != 1 {
                        work = sa_error(
                            work,
                            arm,
                            "E0311",
                            "`Some` pattern expects 1 payload pattern, found " + args.len().to_string()
                        )
                    } else if args[0] != "_" {
                        if !sa_identifier(args[0]) {
                            work = sa_error(work, arm, "E0311", "unsupported payload pattern `" + args[0] + "`")
                        } else {
                            bindings.push(
                                SaLocal { name: args[0], type_name: option_inner, mutable: false }
                            )
                        }
                    }
                } else if args.len() > 0 || !sa_identifier(variant_name) {
                    work = sa_error(work, arm, "E0311", "unsupported pattern `" + pattern + "` for Option")
                } else {
                    bindings.push(SaLocal { name: variant_name, type_name: scrutinee, mutable: false })
                    wildcard = true
                }
            } else if is_result {
                let variant_name = sa_pattern_variant(pattern)
                let args = sa_pattern_args(pattern)
                if variant_name == "Ok" || variant_name == "Err" {
                    if variant_name == "Ok" {
                        has_ok = true
                    } else {
                        has_err = true
                    }
                    if args.len() != 1 {
                        work = sa_error(
                            work,
                            arm,
                            "E0311",
                            "`" + variant_name + "` pattern expects 1 payload pattern, found " + args.len().to_string()
                        )
                    } else if args[0] != "_" {
                        if !sa_identifier(args[0]) {
                            work = sa_error(work, arm, "E0311", "unsupported payload pattern `" + args[0] + "`")
                        } else {
                            let payload = if variant_name == "Ok" { result_ok } else { result_err }
                            bindings.push(
                                SaLocal { name: args[0], type_name: payload, mutable: false }
                            )
                        }
                    }
                } else if args.len() > 0 || !sa_identifier(variant_name) {
                    work = sa_error(work, arm, "E0311", "unsupported pattern `" + pattern + "` for Result")
                } else {
                    bindings.push(SaLocal { name: variant_name, type_name: scrutinee, mutable: false })
                    wildcard = true
                }
            } else if enum_index >= 0 {
                let def = work.enums[enum_index]
                let variant_name = sa_pattern_variant(pattern)
                let variant = sa_variant_index(def, variant_name)
                if variant < 0 {
                    work = sa_error(work, arm, "E0305", "unknown variant `" + variant_name + "` on " + def.name)
                } else {
                    let expected = sa_variant_payload_count(def, variant)
                    let args = sa_pattern_args(pattern)
                    if args.len() != expected {
                        work = sa_error(
                            work,
                            arm,
                            "E0303",
                            def.name + "." + variant_name + " expects " + expected.to_string() + " payload bindings, got " + args.len().to_string()
                        )
                    } else {
                        seen.push(variant_name)
                        var b = 0
                        while b < args.len() {
                            let binding = args[b]
                            if binding.len() == 0 {
                                work = sa_error(work, arm, "E0311", "empty payload binding")
                            } else if binding != "_" {
                                if !sa_identifier(binding) {
                                    work = sa_error(work, arm, "E0311", "unsupported payload pattern `" + binding + "`")
                                } else {
                                    bindings.push(
                                        SaLocal {
                                            name: binding,
                                            type_name: sa_variant_payload_types(def, variant)[b],
                                            mutable: false,
                                        }
                                    )
                                }
                            }
                            b = b + 1
                        }
                    }
                }
            } else if supported && scrutinee == "String" {
                if !sa_string_pattern(pattern) {
                    work = sa_error(work, arm, "E0311", "unsupported match pattern `" + pattern + "` for String")
                } else {
                    seen.push(pattern)
                }
            } else if supported && scrutinee == "Int" {
                if pattern == "true" || pattern == "false" {
                    work = sa_error(
                        work,
                        arm,
                        "E0311",
                        "Bool pattern `" + pattern + "` requires a Bool scrutinee"
                    )
                } else if !sa_int_pattern(pattern) {
                    work = sa_error(work, arm, "E0311", "unsupported match pattern `" + pattern + "` for Int")
                } else {
                    seen.push(pattern)
                }
            } else if supported && scrutinee == "Bool" {
                if pattern == "true" || pattern == "false" {
                    seen.push(pattern)
                    if pattern == "true" {
                        has_true = true
                    } else {
                        has_false = true
                    }
                } else if sa_int_pattern(pattern) {
                    work = sa_error(
                        work,
                        arm,
                        "E0311",
                        "integer pattern `" + pattern + "` requires an Int scrutinee"
                    )
                } else {
                    work = sa_error(work, arm, "E0311", "unsupported match pattern `" + pattern + "` for Bool")
                }
            }
            let body = a_child(ctx.ast, arm, 0)
            let saved = work.locals.len()
            for binding in bindings {
                work = sa_push_local(work, binding.name, binding.type_name)
            }
            var body_ty = "?"
            if body >= 0 && ctx.ast.nodes[body].kind == ak_block() {
                work = sa_block(work, body)
                body_ty = "Unit"
            } else {
                let value = sa_expr(work, body)
                work = value.ctx
                body_ty = value.type_name
            }
            work = sa_trim_locals(work, saved)
            if result.len() == 0 {
                result = body_ty
            } else if body_ty != "?" && result != "?" && !sa_compatible(result, body_ty) {
                work = sa_error(
                    work,
                    body,
                    "E0301",
                    "match arms must return the same type, got " + result + " and " + body_ty
                )
                result = "?"
            }
        }
        i = i + 1
    }
    if item.count == 1 {
        work = sa_error(work, node, "E0313", "match has no arms")
    } else if scrutinee == "Int" && !wildcard {
        work = sa_error(work, node, "E0310", "non-exhaustive `match` on `Int`")
    } else if scrutinee == "Bool" && !wildcard && !(has_true && has_false) {
        work = sa_error(work, node, "E0310", "non-exhaustive `match` on `Bool`")
    } else if scrutinee == "String" && !wildcard {
        work = sa_error(work, node, "E0310", "non-exhaustive `match` on `String`")
    } else if is_option && !wildcard && !(has_some && has_none) {
        work = sa_error(work, node, "E0310", "non-exhaustive `match` on `" + sa_display_type(scrutinee) + "`")
    } else if is_result && !wildcard && !(has_ok && has_err) {
        work = sa_error(work, node, "E0310", "non-exhaustive `match` on `" + sa_display_type(scrutinee) + "`")
    } else if enum_index >= 0 && !wildcard && seen.len() < work.enums[enum_index].variants.len() {
        work = sa_error(work, node, "E0310", "non-exhaustive `match` on `" + scrutinee + "`")
    }
    if result.len() == 0 {
        result = "?"
    }
    return sa_result(work, result)
}

// Imported types keep a module qualifier in some positions (`vt.Term`) while a
// method signature or a literal uses the bare name. Compare the trailing name
// so both spellings agree; the flattened namespace already rejects duplicate
// unqualified declarations, so this cannot merge two distinct types.
fn sa_unqualified(name: String) -> String {
    let parts = name.split(".")
    if parts.len() == 0 {
        return name
    }
    return parts[parts.len() - 1]
}

fn sa_same(expected: String, actual: String) -> Bool {
    if expected == "?" || actual == "?" || expected == "Any" {
        return true
    }
    if expected == actual {
        return true
    }
    if expected.contains("<") || expected.contains(">") || expected.contains("(") || expected.contains("[") {
        return false
    }
    if actual.contains("<") || actual.contains(">") || actual.contains("(") || actual.contains("[") {
        return false
    }
    return sa_unqualified(expected) == sa_unqualified(actual)
}

// Like `sa_same`, but treats an unknown element inside a list or tuple as a
// wildcard. An empty `List` literal has type `List<?>`; assigning it to a typed
// binding, argument, field or return is valid, while concrete mismatches still
// fail.
fn sa_compatible(expected: String, actual: String) -> Bool {
    if sa_same(expected, actual) {
        return true
    }
    let expected_chars = expected.chars()
    let actual_chars = actual.chars()
    if expected_chars.len() >= 2 && actual_chars.len() >= 2 && expected_chars[0] == "(" && actual_chars[0] == "(" && expected_chars[expected_chars.len() - 1] == ")" && actual_chars[actual_chars.len() - 1] == ")" {
        let left = sa_split_types(lx_slice(expected_chars, 1, expected_chars.len() - 1))
        let right = sa_split_types(lx_slice(actual_chars, 1, actual_chars.len() - 1))
        if left.len() != right.len() {
            return false
        }
        var i = 0
        while i < left.len() {
            if !sa_compatible(left[i], right[i]) {
                return false
            }
            i = i + 1
        }
        return true
    }
    if expected.starts_with("Option<") && actual.starts_with("Option<") {
        let left = sa_option_inner(expected)
        let right = sa_option_inner(actual)
        if left.len() > 0 && right.len() > 0 {
            return sa_compatible(left, right)
        }
    }
    if expected.starts_with("Result<") && actual.starts_with("Result<") {
        let left_ok = sa_result_ok(expected)
        let left_err = sa_result_err(expected)
        let right_ok = sa_result_ok(actual)
        let right_err = sa_result_err(actual)
        if left_ok.len() > 0 && left_err.len() > 0 && right_ok.len() > 0 && right_err.len() > 0 {
            return sa_compatible(left_ok, right_ok) && sa_compatible(left_err, right_err)
        }
    }
    if sa_is_map(expected) && sa_is_map(actual) {
        return sa_compatible(sa_map_key(expected), sa_map_key(actual)) && sa_compatible(sa_map_value(expected), sa_map_value(actual))
    }
    if sa_is_set(expected) && sa_is_set(actual) {
        return sa_compatible(sa_set_elem(expected), sa_set_elem(actual))
    }
    let expected_array = sa_array_layout(expected)
    let actual_array = sa_array_layout(actual)
    if expected_array.1 >= 0 && actual_array.1 >= 0 {
        return expected_array.1 == actual_array.1 && sa_compatible(expected_array.0, actual_array.0)
    }
    if expected.starts_with("List<") && actual.starts_with("List<") {
        return sa_compatible(sa_elem_type(expected), sa_elem_type(actual))
    }
    if expected.starts_with("Slice<") && actual.starts_with("Slice<") {
        return sa_compatible(sa_elem_type(expected), sa_elem_type(actual))
    }
    return false
}

fn sa_ctx_errors(ctx: SaCtx, errors: List<String>) -> SaCtx {
    return SaCtx {
        ast: ctx.ast,
        fns: ctx.fns,
        structs: ctx.structs,
        enums: ctx.enums,
        errors: errors,
        locals: ctx.locals,
        ret: ctx.ret,
        loops: ctx.loops,
    }
}

fn sa_ctx_locals(ctx: SaCtx, locals: List<SaLocal>) -> SaCtx {
    return SaCtx {
        ast: ctx.ast,
        fns: ctx.fns,
        structs: ctx.structs,
        enums: ctx.enums,
        errors: ctx.errors,
        locals: locals,
        ret: ctx.ret,
        loops: ctx.loops,
    }
}

fn sa_ctx_ret(ctx: SaCtx, ret: String) -> SaCtx {
    return SaCtx {
        ast: ctx.ast,
        fns: ctx.fns,
        structs: ctx.structs,
        enums: ctx.enums,
        errors: ctx.errors,
        locals: ctx.locals,
        ret: ret,
        loops: ctx.loops,
    }
}

fn sa_ctx_loops(ctx: SaCtx, loops: Int) -> SaCtx {
    return SaCtx {
        ast: ctx.ast,
        fns: ctx.fns,
        structs: ctx.structs,
        enums: ctx.enums,
        errors: ctx.errors,
        locals: ctx.locals,
        ret: ctx.ret,
        loops: loops,
    }
}

fn sa_error(ctx: SaCtx, node: Int, code: String, message: String) -> SaCtx {
    if node < 0 || node >= ctx.ast.nodes.len() {
        return ctx
    }
    let item = ctx.ast.nodes[node]
    var errors = ctx.errors
    errors.push(code + " " + message + " at line " + item.line.to_string() + ", column " + item.column.to_string())
    return sa_ctx_errors(ctx, errors)
}

fn sa_error_at(ctx: SaCtx, node: Int, column: Int, code: String, message: String) -> SaCtx {
    if node < 0 || node >= ctx.ast.nodes.len() {
        return ctx
    }
    let item = ctx.ast.nodes[node]
    var errors = ctx.errors
    errors.push(code + " " + message + " at line " + item.line.to_string() + ", column " + column.to_string())
    return sa_ctx_errors(ctx, errors)
}

fn sa_result(ctx: SaCtx, type_name: String) -> SaResult {
    return SaResult { ctx: ctx, type_name: type_name }
}

fn sa_fail(ctx: SaCtx, node: Int, code: String, message: String) -> SaResult {
    return SaResult { ctx: sa_error(ctx, node, code, message), type_name: "?" }
}

fn sa_push_local(ctx: SaCtx, name: String, type_name: String) -> SaCtx {
    var locals = ctx.locals
    locals.push(SaLocal { name: name, type_name: type_name, mutable: false })
    return sa_ctx_locals(ctx, locals)
}

fn sa_push_mutable(ctx: SaCtx, name: String, type_name: String) -> SaCtx {
    var locals = ctx.locals
    locals.push(SaLocal { name: name, type_name: type_name, mutable: true })
    return sa_ctx_locals(ctx, locals)
}

fn sa_trim_locals(ctx: SaCtx, count: Int) -> SaCtx {
    var locals: List<SaLocal> = []
    var i = 0
    while i < count && i < ctx.locals.len() {
        locals.push(ctx.locals[i])
        i = i + 1
    }
    return sa_ctx_locals(ctx, locals)
}

fn sa_check_bool(ctx: SaCtx, node: Int) -> SaCtx {
    let value = sa_expr(ctx, node)
    if value.type_name != "?" && value.type_name != "Bool" {
        return sa_error(
            value.ctx,
            node,
            "E0308",
            "type mismatch: expected `Bool`, found `" + value.type_name + "`"
        )
    }
    return value.ctx
}

fn sa_array_literal(ctx: SaCtx, node: Int, array: String) -> SaCtx {
    if node < 0 || node >= ctx.ast.nodes.len() || ctx.ast.nodes[node].kind != ak_list() {
        return ctx
    }
    let layout = sa_array_layout(array)
    let elem = layout.0
    let expected_len = layout.1
    let got = ctx.ast.nodes[node].count
    var work = ctx
    if expected_len >= 0 && got != expected_len {
        work = sa_error(
            work,
            node,
            "E0308",
            "array length mismatch: expected " + expected_len.to_string() + " element(s), found " + got.to_string()
        )
    }
    var i = 0
    while i < got {
        let child = a_child(work.ast, node, i)
        let value_node = work.ast.nodes[child]
        if value_node.kind == ak_list() && sa_array_layout(elem).1 >= 0 {
            work = sa_array_literal(work, child, elem)
        } else {
            let value = sa_expr(work, child)
            work = value.ctx
            if !sa_compatible(elem, value.type_name) {
                work = sa_error(
                    work,
                    child,
                    "E0308",
                    "type mismatch: expected `" + sa_display_type(elem) + "`, found `" + sa_display_type(value.type_name) + "`"
                )
            }
        }
        i = i + 1
    }
    return work
}

fn sa_args(ctx: SaCtx, call: Int, start: Int, expected: List<String>, check_types: Bool) -> SaCtx {
    var work = ctx
    let total = ctx.ast.nodes[call].count
    var i = start
    var index = 0
    while i < total {
        let child = a_child(work.ast, call, i)
        var actual = "?"
        let expected_type = if index < expected.len() { expected[index] } else { "" }
        if check_types && sa_array_layout(expected_type).1 >= 0 && work.ast.nodes[child].kind == ak_list() {
            work = sa_array_literal(work, child, expected_type)
            actual = expected_type
        } else {
            let value = sa_expr(work, child)
            work = value.ctx
            actual = value.type_name
        }
        if check_types && expected_type.len() > 0 && !sa_compatible(expected_type, actual) {
            work = sa_error(
                work,
                child,
                "E0308",
                "type mismatch: expected `" + sa_display_type(expected_type) + "`, found `" + sa_display_type(actual) + "`"
            )
        }
        i = i + 1
        index = index + 1
    }
    return work
}

fn sa_expr(ctx: SaCtx, node: Int) -> SaResult {
    if node < 0 || node >= ctx.ast.nodes.len() {
        return sa_result(ctx, "?")
    }
    let item = ctx.ast.nodes[node]
    if item.kind == ak_number() {
        return sa_result(ctx, "Int")
    }
    if item.kind == ak_string() {
        return sa_result(ctx, "String")
    }
    if item.kind == ak_str_part() {
        return sa_result(ctx, "String")
    }
    if item.kind == ak_interp() {
        var work = ctx
        var i = 0
        while i < item.count {
            let child = a_child(work.ast, node, i)
            if child >= 0 && work.ast.nodes[child].kind != ak_str_part() {
                let part = sa_expr(work, child)
                work = part.ctx
                if part.type_name != "?" && part.type_name != "Int" && part.type_name != "Bool" && part.type_name != "String" {
                    work = sa_error(work, child, "E0309", "cannot interpolate " + part.type_name + " into a string")
                }
            }
            i = i + 1
        }
        return sa_result(work, "String")
    }
    if item.kind == ak_bool() {
        return sa_result(ctx, "Bool")
    }
    if item.kind == ak_closure() {
        var work = ctx
        var types: List<String> = []
        var i = 0
        while i < item.count - 1 {
            let param = ctx.ast.nodes[a_child(ctx.ast, node, i)]
            if param.aux.len() == 0 {
                work = sa_error(work, a_child(ctx.ast, node, i), "E0103", "closure parameter `" + param.text + "` needs a type")
                types.push("?")
            } else {
                types.push(param.aux)
            }
            i = i + 1
        }
        let saved = work.locals.len()
        i = 0
        while i < item.count - 1 {
            let param = ctx.ast.nodes[a_child(ctx.ast, node, i)]
            work = sa_push_local(work, param.text, types[i])
            i = i + 1
        }
        var ret = item.aux
        if ret.len() == 0 {
            let returned = sa_find_return(ctx.ast, a_child(ctx.ast, node, item.count - 1))
            if returned >= 0 {
                ret = sa_guess_type(work, returned)
            } else {
                ret = "Unit"
            }
        }
        work = sa_ctx_ret(work, ret)
        work = sa_block(work, a_child(ctx.ast, node, item.count - 1))
        work = sa_trim_locals(work, saved)
        var text = "fn("
        i = 0
        while i < types.len() {
            if i > 0 {
                text = text + ","
            }
            text = text + types[i]
            i = i + 1
        }
        return sa_result(work, text + ")->" + ret)
    }
    if item.kind == ak_ident() {
        let local = sa_lookup(ctx, item.text)
        if local.len() > 0 {
            return sa_result(ctx, local)
        }
        if item.text == "None" {
            return sa_result(ctx, "Option<?>")
        }
        if item.text == "Some" || item.text == "Ok" || item.text == "Err" {
            return sa_fail(
                ctx,
                node,
                "E0205",
                "`" + item.text + "` is a constructor and requires an argument"
            )
        }
        let variant = sa_variant_enum(ctx, item.text)
        if variant.len() > 0 {
            let enum_index = sa_enum_index(ctx.enums, variant)
            let variant_index = sa_variant_index(ctx.enums[enum_index], item.text)
            let count = sa_variant_payload_count(ctx.enums[enum_index], variant_index)
            if count != 0 {
                return sa_fail(
                    ctx,
                    node,
                    "E0303",
                    variant + "." + item.text + " expects " + count.to_string() + " payload values, got 0"
                )
            }
            return sa_result(ctx, variant)
        }
        return sa_fail(ctx, node, "E0203", "unknown name `" + item.text + "`")
    }
    if item.kind == ak_unary() {
        let value = sa_expr(ctx, a_child(ctx.ast, node, 0))
        if value.type_name == "?" {
            return value
        }
        if item.text == "-" && value.type_name != "Int" {
            return sa_fail(value.ctx, node, "E0309", "unary - expects Int, got " + value.type_name)
        }
        if item.text == "!" && value.type_name != "Bool" {
            return sa_fail(value.ctx, node, "E0309", "unary ! expects Bool, got " + value.type_name)
        }
        return sa_result(value.ctx, value.type_name)
    }
    if item.kind == ak_try() {
        let value = sa_expr(ctx, a_child(ctx.ast, node, 0))
        var work = value.ctx
        let type_name = value.type_name
        if type_name == "?" {
            return sa_result(work, "?")
        }
        let option_inner = sa_option_inner(type_name)
        if option_inner.len() > 0 {
            if work.ret != "?" && sa_option_inner(work.ret).len() == 0 {
                work = sa_error(
                    work,
                    node,
                    "E0306",
                    "`?` on Option requires the function to return Option, found `" + sa_display_type(work.ret) + "`"
                )
                return sa_result(work, "?")
            }
            return sa_result(work, option_inner)
        }
        let ok = sa_result_ok(type_name)
        let err = sa_result_err(type_name)
        if ok.len() > 0 && err.len() > 0 {
            let ret_ok = sa_result_ok(work.ret)
            let ret_err = sa_result_err(work.ret)
            if work.ret != "?" && (ret_ok.len() == 0 || ret_err.len() == 0) {
                work = sa_error(
                    work,
                    node,
                    "E0306",
                    "`?` on Result requires the function to return Result, found `" + sa_display_type(work.ret) + "`"
                )
                return sa_result(work, "?")
            }
            if ret_err.len() > 0 && err != ret_err {
                work = sa_error(
                    work,
                    node,
                    "E0306",
                    "`?` cannot propagate error type `" + err + "` from a function returning `Result<_, " + ret_err + ">`"
                )
                return sa_result(work, "?")
            }
            return sa_result(work, ok)
        }
        work = sa_error(
            work,
            node,
            "E0306",
            "`?` is not defined for `" + sa_display_type(type_name) + "`"
        )
        return sa_result(work, "?")
    }
    if item.kind == ak_binary() {
        let left = sa_expr(ctx, a_child(ctx.ast, node, 0))
        let right = sa_expr(left.ctx, a_child(ctx.ast, node, 1))
        var work = right.ctx
        let op = item.text
        let l = left.type_name
        let r = right.type_name
        if op == "=" || op == "+=" || op == "-=" || op == "*=" || op == "/=" || op == "%=" {
            let target = a_child(ctx.ast, node, 0)
            // Writing through an aggregate field (`t.cells[i] = cell`) mutates
            // the shared list handle and does not need a mutable local. A bare
            // `xs[i] = value` on an immutable local still does.
            var check_root = true
            if target >= 0 && ctx.ast.nodes[target].kind == ak_index() {
                let base = a_child(ctx.ast, target, 0)
                if base >= 0 && ctx.ast.nodes[base].kind != ak_ident() {
                    check_root = false
                }
            }
            let root = sa_root_ident(ctx.ast, target)
            if check_root && root >= 0 {
                let name = ctx.ast.nodes[root].text
                if sa_local_index(work, name) >= 0 && !sa_local_mutable(work, name) {
                    work = sa_error(work, root, "E0301", "cannot assign to immutable binding `" + name + "`")
                }
            }
            if op != "=" && l != "?" && l != "Int" {
                work = sa_error(work, node, "E0309", "compound assignment expects Int, got " + l)
            }
            if !sa_compatible(l, r) {
                if op == "=" {
                    work = sa_error(
                        work,
                        a_child(ctx.ast, node, 1),
                        "E0308",
                        "type mismatch: expected `" + l + "`, found `" + r + "`"
                    )
                } else {
                    work = sa_error(work, node, "E0301", "assignment expected " + l + ", got " + r)
                }
            }
            return sa_result(work, l)
        }
        if op == "+" && l == "String" && r == "String" {
            return sa_result(work, "String")
        }
        if op == "+" && l == "List<Int>" && r == "List<Int>" {
            return sa_result(work, "List<Int>")
        }
        if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
            if l == "Int" && r == "Int" {
                return sa_result(work, "Int")
            }
            if l != "?" && r != "?" {
                if l != "Int" {
                    work = sa_error(
                        work,
                        a_child(ctx.ast, node, 0),
                        "E0308",
                        "type mismatch: expected `Int`, found `" + l + "`"
                    )
                }
                if r != "Int" {
                    work = sa_error(
                        work,
                        a_child(ctx.ast, node, 1),
                        "E0308",
                        "type mismatch: expected `Int`, found `" + r + "`"
                    )
                }
                return sa_result(work, "Int")
            }
            return sa_result(work, "?")
        }
        if op == ".." {
            if l == "Int" && r == "Int" {
                return sa_result(work, "Range")
            }
            if l != "?" && r != "?" {
                return sa_fail(work, node, "E0309", "range expects Int bounds, got " + l + " and " + r)
            }
            return sa_result(work, "?")
        }
        if op == "&&" || op == "||" {
            if (l == "Bool" || l == "?") && (r == "Bool" || r == "?") {
                return sa_result(work, "Bool")
            }
            return sa_fail(work, node, "E0309", "operator " + op + " expects Bool operands, got " + l + " and " + r)
        }
        if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
            if !sa_compatible(l, r) {
                return sa_fail(work, node, "E0301", "comparison operands differ: " + l + " and " + r)
            }
            return sa_result(work, "Bool")
        }
        return sa_result(work, "?")
    }
    if item.kind == ak_call() {
        let callee = a_child(ctx.ast, node, 0)
        if callee < 0 {
            return sa_result(ctx, "?")
        }
        let callee_node = ctx.ast.nodes[callee]
        if callee_node.kind == ak_ident() {
            if callee_node.text == "Some" || callee_node.text == "Ok" || callee_node.text == "Err" {
                let got = ctx.ast.nodes[node].count - 1
                var work = ctx
                var inner = "?"
                var i = 1
                while i < ctx.ast.nodes[node].count {
                    let value = sa_expr(work, a_child(ctx.ast, node, i))
                    work = value.ctx
                    if i == 1 {
                        inner = value.type_name
                    }
                    i = i + 1
                }
                if got != 1 {
                    work = sa_error(
                        work,
                        callee,
                        "E0208",
                        "`" + callee_node.text + "` expects 1 argument, found " + got.to_string()
                    )
                }
                if callee_node.text == "Some" {
                    return sa_result(work, "Option<" + inner + ">")
                }
                if callee_node.text == "Ok" {
                    return sa_result(work, "Result<" + inner + ",?>")
                }
                return sa_result(work, "Result<?," + inner + ">")
            }
            if callee_node.text == "None" {
                let work = sa_args(ctx, node, 1, [], false)
                return sa_fail(work, node, "E0205", "`None` does not take arguments")
            }
            if callee_node.text == "map" || callee_node.text == "set" {
                let got = ctx.ast.nodes[node].count - 1
                var work = ctx
                if got != 0 {
                    work = sa_error(work, node, "E0208", "`" + callee_node.text + "` expects 0 arguments, found " + got.to_string())
                }
                work = sa_args(work, node, 1, [], false)
                if callee_node.text == "map" {
                    return sa_result(work, "Map<?,?>")
                }
                return sa_result(work, "Set<?>")
            }
            let variant = sa_variant_enum(ctx, callee_node.text)
            if variant.len() > 0 {
                let enum_index = sa_enum_index(ctx.enums, variant)
                let variant_index = sa_variant_index(ctx.enums[enum_index], callee_node.text)
                let types = sa_variant_payload_types(ctx.enums[enum_index], variant_index)
                let got = ctx.ast.nodes[node].count - 1
                var work = ctx
                if got != types.len() {
                    work = sa_error(
                        work,
                        node,
                        "E0303",
                        variant + "." + callee_node.text + " expects " + types.len().to_string() + " payload values, got " + got.to_string()
                    )
                }
                work = sa_args(work, node, 1, types, true)
                return sa_result(work, variant)
            }
            if callee_node.text == "char_string" {
                let got = ctx.ast.nodes[node].count - 1
                var work = ctx
                if got != 1 {
                    work = sa_error(work, node, "E0303", "char_string expects 1 argument, got " + got.to_string())
                }
                work = sa_args(work, node, 1, ["Int"], true)
                return sa_result(work, "String")
            }
            if callee_node.text == "http_get" {
                let got = ctx.ast.nodes[node].count - 1
                var work = ctx
                if got != 1 {
                    work = sa_error(work, node, "E0303", "http_get expects 1 argument, got " + got.to_string())
                }
                work = sa_args(work, node, 1, ["String"], true)
                return sa_result(work, "String")
            }
            if callee_node.text == "json_string" {
                let got = ctx.ast.nodes[node].count - 1
                var work = ctx
                if got != 2 {
                    work = sa_error(work, node, "E0303", "json_string expects 2 arguments, got " + got.to_string())
                }
                work = sa_args(work, node, 1, ["String", "String"], true)
                return sa_result(work, "String")
            }
            if sa_builtin(callee_node.text) {
                let work = sa_args(ctx, node, 1, [], false)
                return sa_result(work, "Unit")
            }
            let callable = sa_lookup(ctx, callee_node.text)
            if sa_is_fn_type(callable) {
                let types = sa_fn_params(callable)
                let got = ctx.ast.nodes[node].count - 1
                var work = ctx
                if got != types.len() {
                    work = sa_error(
                        work,
                        callee,
                        "E0208",
                        "function value expects " + types.len().to_string() + " arguments, found " + got.to_string()
                    )
                }
                work = sa_args(work, node, 1, types, true)
                return sa_result(work, sa_fn_ret(callable))
            }
            let index = sa_fn_index(ctx.fns, callee_node.text)
            if index < 0 {
                let local = sa_lookup(ctx, callee_node.text)
                let work = sa_args(ctx, node, 1, [], false)
                if local.len() > 0 {
                    return sa_fail(
                        work,
                        callee,
                        "E0205",
                        "only functions can be called, found `" + local + "`"
                    )
                }
                return sa_fail(work, callee, "E0203", "unknown function `" + callee_node.text + "`")
            }
            let sig = ctx.fns[index]
            let got = ctx.ast.nodes[node].count - 1
            var work = ctx
            if got != sig.params.len() {
                work = sa_error(
                    work,
                    callee,
                    "E0208",
                    "`" + callee_node.text + "` expects " + sig.params.len().to_string() + " arguments, found " + got.to_string()
                )
            }
            work = sa_args(work, node, 1, sig.types, true)
            return sa_result(work, sig.ret)
        }
        if callee_node.kind == ak_member() {
            let recv_node = a_child(ctx.ast, callee, 0)
            if recv_node >= 0 && ctx.ast.nodes[recv_node].kind == ak_ident() && sa_lookup(ctx, ctx.ast.nodes[recv_node].text) == "" {
                let index = sa_fn_index(ctx.fns, callee_node.text)
                if index >= 0 {
                    let sig = ctx.fns[index]
                    let got = ctx.ast.nodes[node].count - 1
                    var work = ctx
                    if got != sig.params.len() {
                        work = sa_error(
                            work,
                            node,
                            "E0303",
                            callee_node.text + " expects " + sig.params.len().to_string() + " arguments, got " + got.to_string()
                        )
                    }
                    work = sa_args(work, node, 1, sig.types, true)
                    return sa_result(work, sig.ret)
                }
            }
            let object = sa_expr(ctx, a_child(ctx.ast, callee, 0))
            let got = ctx.ast.nodes[node].count - 1
            let method_symbol = object.type_name + "." + callee_node.text
            let method_index = sa_fn_index(ctx.fns, method_symbol)
            if method_index >= 0 {
                let sig = ctx.fns[method_index]
                var work = object.ctx
                if sig.params.len() == 0 {
                    return sa_fail(work, callee, "E0201", "method `" + callee_node.text + "` has no receiver")
                }
                if got != sig.params.len() - 1 {
                    work = sa_error(
                        work,
                        node,
                        "E0208",
                        "`" + callee_node.text + "` expects " + (sig.params.len() - 1).to_string() + " arguments, found " + got.to_string()
                    )
                }
                var expected: List<String> = []
                var k = 1
                while k < sig.types.len() {
                    expected.push(sig.types[k])
                    k = k + 1
                }
                work = sa_args(work, node, 1, expected, true)
                return sa_result(work, sig.ret)
            }
            let option_inner = sa_option_inner(object.type_name)
            let result_ok = sa_result_ok(object.type_name)
            if callee_node.text == "is_some" || callee_node.text == "is_none" {
                var work = object.ctx
                if object.type_name != "?" && option_inner.len() == 0 {
                    work = sa_error(
                        work,
                        callee,
                        "E0206",
                        "type `" + sa_display_type(object.type_name) + "` has no method `" + callee_node.text + "`"
                    )
                }
                if got != 0 {
                    work = sa_error(
                        work,
                        node,
                        "E0208",
                        "`" + callee_node.text + "` expects 0 arguments, found " + got.to_string()
                    )
                }
                return sa_result(work, "Bool")
            }
            if callee_node.text == "is_ok" || callee_node.text == "is_err" {
                var work = object.ctx
                if object.type_name != "?" && result_ok.len() == 0 {
                    work = sa_error(
                        work,
                        callee,
                        "E0206",
                        "type `" + sa_display_type(object.type_name) + "` has no method `" + callee_node.text + "`"
                    )
                }
                if got != 0 {
                    work = sa_error(
                        work,
                        node,
                        "E0208",
                        "`" + callee_node.text + "` expects 0 arguments, found " + got.to_string()
                    )
                }
                return sa_result(work, "Bool")
            }
            if callee_node.text == "unwrap_or" && (option_inner.len() > 0 || result_ok.len() > 0) {
                var work = object.ctx
                let inner = if option_inner.len() > 0 { option_inner } else { result_ok }
                if got != 1 {
                    work = sa_error(
                        work,
                        node,
                        "E0208",
                        "`unwrap_or` expects 1 argument, found " + got.to_string()
                    )
                }
                work = sa_args(work, node, 1, [inner], true)
                return sa_result(work, inner)
            }
            if callee_node.text == "as_slice" {
                var work = object.ctx
                if got != 0 {
                    work = sa_error(
                        work,
                        node,
                        "E0208",
                        "`as_slice` expects 0 arguments, found " + got.to_string()
                    )
                }
                let valid = object.type_name == "?" || object.type_name.starts_with("List<") || sa_array_layout(object.type_name).1 >= 0
                if !valid {
                    work = sa_error(
                        work,
                        callee,
                        "E0206",
                        "type `" + sa_display_type(object.type_name) + "` has no method `as_slice`"
                    )
                }
                return sa_result(work, "Slice<" + sa_elem_type(object.type_name) + ">")
            }
            if sa_is_map(object.type_name) {
                let key_type = sa_map_key(object.type_name)
                let value_type = sa_map_value(object.type_name)
                if callee_node.text == "get" {
                    var work = sa_args(object.ctx, node, 1, [key_type], true)
                    if got != 1 {
                        work = sa_error(work, node, "E0208", "`get` expects 1 argument, found " + got.to_string())
                    }
                    if !sa_map_key_ok(key_type) {
                        work = sa_error(work, callee, "E0306", "`" + sa_display_type(key_type) + "` cannot be used as a map/set key in this build")
                    }
                    return sa_result(work, "Option<" + value_type + ">")
                }
                if callee_node.text == "contains_key" {
                    var work = sa_args(object.ctx, node, 1, [key_type], true)
                    if got != 1 {
                        work = sa_error(work, node, "E0208", "`contains_key` expects 1 argument, found " + got.to_string())
                    }
                    if !sa_map_key_ok(key_type) {
                        work = sa_error(work, callee, "E0306", "`" + sa_display_type(key_type) + "` cannot be used as a map/set key in this build")
                    }
                    return sa_result(work, "Bool")
                }
                if callee_node.text == "insert" {
                    var work = sa_args(object.ctx, node, 1, [key_type, value_type], true)
                    if got != 2 {
                        work = sa_error(work, node, "E0208", "`insert` expects 2 arguments, found " + got.to_string())
                    }
                    if !sa_map_key_ok(key_type) {
                        work = sa_error(work, callee, "E0306", "`" + sa_display_type(key_type) + "` cannot be used as a map/set key in this build")
                    }
                    let receiver = a_child(ctx.ast, callee, 0)
                    if receiver >= 0 && ctx.ast.nodes[receiver].kind == ak_ident() {
                        let name = ctx.ast.nodes[receiver].text
                        if sa_local_index(work, name) >= 0 && !sa_local_mutable(work, name) {
                            work = sa_error(work, receiver, "E0301", "`insert` requires a mutable map binding")
                        }
                    }
                    return sa_result(work, "Unit")
                }
            }
            if sa_is_set(object.type_name) {
                let elem_type = sa_set_elem(object.type_name)
                if callee_node.text == "contains" {
                    var work = sa_args(object.ctx, node, 1, [elem_type], true)
                    if got != 1 {
                        work = sa_error(work, node, "E0208", "`contains` expects 1 argument, found " + got.to_string())
                    }
                    if !sa_map_key_ok(elem_type) {
                        work = sa_error(work, callee, "E0306", "`" + sa_display_type(elem_type) + "` cannot be used as a map/set key in this build")
                    }
                    return sa_result(work, "Bool")
                }
                if callee_node.text == "insert" {
                    var work = sa_args(object.ctx, node, 1, [elem_type], true)
                    if got != 1 {
                        work = sa_error(work, node, "E0208", "`insert` expects 1 argument, found " + got.to_string())
                    }
                    if !sa_map_key_ok(elem_type) {
                        work = sa_error(work, callee, "E0306", "`" + sa_display_type(elem_type) + "` cannot be used as a map/set key in this build")
                    }
                    let receiver = a_child(ctx.ast, callee, 0)
                    if receiver >= 0 && ctx.ast.nodes[receiver].kind == ak_ident() {
                        let name = ctx.ast.nodes[receiver].text
                        if sa_local_index(work, name) >= 0 && !sa_local_mutable(work, name) {
                            work = sa_error(work, receiver, "E0301", "`insert` requires a mutable set binding")
                        }
                    }
                    return sa_result(work, "Bool")
                }
            }
            var work = sa_args(object.ctx, node, 1, [], false)
            if callee_node.text == "push" {
                let receiver = a_child(ctx.ast, callee, 0)
                if receiver >= 0 && ctx.ast.nodes[receiver].kind == ak_ident() {
                    let name = ctx.ast.nodes[receiver].text
                    if sa_local_index(work, name) >= 0 && !sa_local_mutable(work, name) {
                        work = sa_error(work, receiver, "E0301", "`push` requires a mutable list binding")
                    }
                }
                return sa_result(work, "?")
            }
            if callee_node.text == "index_of" && object.type_name == "List<Int>" {
                work = sa_args(work, node, 1, ["Int"], true)
                return sa_result(work, "Int")
            }
            if callee_node.text == "contains" && object.type_name == "List<Int>" {
                work = sa_args(work, node, 1, ["Int"], true)
                return sa_result(work, "Bool")
            }
            if callee_node.text == "contains" || callee_node.text == "starts_with" || callee_node.text == "ends_with" {
                if object.type_name != "?" && object.type_name != "String" {
                    work = sa_error(work, node, "E0309", callee_node.text + " requires a String receiver")
                }
                work = sa_args(work, node, 1, ["String"], true)
                return sa_result(work, "Bool")
            }
            if callee_node.text == "trim" || callee_node.text == "trim_start" || callee_node.text == "trim_end" {
                if object.type_name != "?" && object.type_name != "String" {
                    work = sa_error(work, node, "E0309", callee_node.text + " requires a String receiver")
                }
                work = sa_args(work, node, 1, [], false)
                return sa_result(work, "String")
            }
            if callee_node.text == "min" || callee_node.text == "max" {
                if object.type_name != "?" && object.type_name != "List<Int>" {
                    work = sa_error(work, node, "E0309", callee_node.text + " requires a List<Int> receiver")
                }
                work = sa_args(work, node, 1, [], false)
                return sa_result(work, "Int")
            }
            if callee_node.text == "sum" {
                if object.type_name != "?" && object.type_name != "List<Int>" {
                    work = sa_error(work, node, "E0309", "sum requires a List<Int> receiver")
                }
                work = sa_args(work, node, 1, [], false)
                return sa_result(work, "Int")
            }
            if callee_node.text == "sort" {
                if object.type_name != "?" && object.type_name != "List<Int>" {
                    work = sa_error(work, node, "E0309", "sort requires a List<Int> receiver")
                }
                work = sa_args(work, node, 1, [], false)
                return sa_result(work, "List<Int>")
            }
            if callee_node.text == "reverse" {
                if object.type_name != "?" && object.type_name != "List<Int>" {
                    work = sa_error(work, node, "E0309", "reverse requires a List<Int> receiver")
                }
                work = sa_args(work, node, 1, [], false)
                return sa_result(work, "List<Int>")
            }
            if callee_node.text == "first" || callee_node.text == "last" {
                if object.type_name != "?" && object.type_name != "List<Int>" {
                    work = sa_error(work, node, "E0309", callee_node.text + " requires a List<Int> receiver")
                }
                work = sa_args(work, node, 1, [], false)
                return sa_result(work, "Int")
            }
            if callee_node.text == "is_empty" {
                if object.type_name != "?" && object.type_name != "String" {
                    work = sa_error(work, node, "E0309", "is_empty requires a String receiver")
                }
                work = sa_args(work, node, 1, [], false)
                return sa_result(work, "Bool")
            }
            if callee_node.text == "bytes" {
                if object.type_name != "?" && object.type_name != "String" {
                    work = sa_error(work, node, "E0309", "bytes requires a String receiver")
                }
                work = sa_args(work, node, 1, [], false)
                return sa_result(work, "List<Int>")
            }
            if callee_node.text == "replace" {
                if object.type_name != "?" && object.type_name != "String" {
                    work = sa_error(work, node, "E0309", "replace requires a String receiver")
                }
                work = sa_args(work, node, 1, ["String", "String"], true)
                return sa_result(work, "String")
            }
            if callee_node.text == "lower" || callee_node.text == "upper" {
                if object.type_name != "?" && object.type_name != "String" {
                    work = sa_error(work, node, "E0309", callee_node.text + " requires a String receiver")
                }
                work = sa_args(work, node, 1, [], false)
                return sa_result(work, "String")
            }
            if callee_node.text == "len" {
                return sa_result(work, "Int")
            }
            if callee_node.text == "to_string" {
                return sa_result(work, "String")
            }
            return sa_result(work, "?")
        }
        let object = sa_expr(ctx, callee)
        let work = sa_args(object.ctx, node, 1, [], false)
        return sa_result(work, "?")
    }
    if item.kind == ak_member() {
        let object = sa_expr(ctx, a_child(ctx.ast, node, 0))
        if object.type_name == "?" {
            return object
        }
        let index = sa_struct_index(ctx.structs, object.type_name)
        if index >= 0 {
            let field = sa_field_index(ctx.structs[index], item.text)
            if field < 0 {
                return sa_fail(object.ctx, node, "E0207", "struct `" + object.type_name + "` has no field `" + item.text + "`")
            }
            return sa_result(object.ctx, ctx.structs[index].types[field])
        }
        return sa_result(object.ctx, "?")
    }
    if item.kind == ak_index() {
        let object = sa_expr(ctx, a_child(ctx.ast, node, 0))
        let index_node = a_child(ctx.ast, node, 1)
        if index_node >= 0 && ctx.ast.nodes[index_node].kind == ak_binary() && ctx.ast.nodes[index_node].text == ".." {
            let start = sa_expr(object.ctx, a_child(ctx.ast, index_node, 0))
            let end = sa_expr(start.ctx, a_child(ctx.ast, index_node, 1))
            var work = end.ctx
            if object.type_name != "List<Int>" && object.type_name != "?" {
                work = sa_error(work, node, "E0301", "slicing expects List<Int>, got " + object.type_name)
            }
            if !sa_same("Int", start.type_name) && start.type_name != "?" {
                work = sa_error(work, a_child(ctx.ast, index_node, 0), "E0301", "slice start must be Int, got " + start.type_name)
            }
            if !sa_same("Int", end.type_name) && end.type_name != "?" {
                work = sa_error(work, a_child(ctx.ast, index_node, 1), "E0301", "slice end must be Int, got " + end.type_name)
            }
            return sa_result(work, "List<Int>")
        }
        let index = sa_expr(object.ctx, a_child(ctx.ast, node, 1))
        var work = index.ctx
        if !sa_same("Int", index.type_name) && index.type_name != "?" {
            work = sa_error(
                work,
                a_child(ctx.ast, node, 1),
                "E0308",
                "type mismatch: expected `Int`, found `" + index.type_name + "`"
            )
        }
        let element = sa_elem_type(object.type_name)
        if object.type_name != "?" && element == "?" {
            work = sa_error(
                work,
                node,
                "E0205",
                "indexing is not defined for `" + sa_display_type(object.type_name) + "`"
            )
        }
        return sa_result(work, element)
    }
    if item.kind == ak_list() {
        var work = ctx
        var element = ""
        var i = 0
        while i < item.count {
            let value = sa_expr(work, a_child(ctx.ast, node, i))
            work = value.ctx
            if element.len() == 0 {
                element = value.type_name
            } else if !sa_compatible(element, value.type_name) {
                work = sa_error(work, node, "E0301", "list elements must share a type, got " + element + " and " + value.type_name)
            }
            i = i + 1
        }
        if element.len() == 0 {
            element = "?"
        }
        return sa_result(work, "List<" + element + ">")
    }
    if item.kind == ak_tuple() {
        var work = ctx
        var text = "("
        var i = 0
        while i < item.count {
            if i > 0 {
                text = text + ","
            }
            let value = sa_expr(work, a_child(ctx.ast, node, i))
            work = value.ctx
            text = text + value.type_name
            i = i + 1
        }
        return sa_result(work, text + ")")
    }
    if item.kind == ak_struct_lit() {
        let index = sa_struct_index(ctx.structs, item.text)
        var work = ctx
        if index < 0 {
            work = sa_error(work, node, "E0304", "unknown type `" + item.text + "`")
        }
        var seen: List<String> = []
        var i = 0
        while i < item.count {
            let field = a_child(ctx.ast, node, i)
            let field_node = ctx.ast.nodes[field]
            let value = sa_expr(work, a_child(ctx.ast, field, 0))
            work = value.ctx
            if sa_has(seen, field_node.text) {
                work = sa_error(work, field, "E0307", "duplicate field `" + field_node.text + "` on " + item.text)
            } else {
                seen.push(field_node.text)
            }
            if index >= 0 {
                let slot = sa_field_index(ctx.structs[index], field_node.text)
                if slot < 0 {
                    work = sa_error(
                        work,
                        field,
                        "E0207",
                        "struct `" + item.text + "` has no field `" + field_node.text + "`"
                    )
                } else if !sa_compatible(ctx.structs[index].types[slot], value.type_name) {
                    work = sa_error(
                        work,
                        a_child(ctx.ast, field, 0),
                        "E0308",
                        "type mismatch: expected `" + ctx.structs[index].types[slot] + "`, found `" + value.type_name + "`"
                    )
                }
            }
            i = i + 1
        }
        if index >= 0 {
            for required in ctx.structs[index].fields {
                if !sa_has(seen, required) {
                    work = sa_error_at(
                        work,
                        node,
                        item.column - item.text.len() - 1,
                        "E0207",
                        "missing field `" + required + "` in `" + item.text + "` literal"
                    )
                }
            }
        }
        return sa_result(work, item.text)
    }
    if item.kind == ak_match() {
        let scrutinee = sa_expr(ctx, a_child(ctx.ast, node, 0))
        return sa_match_expr(scrutinee.ctx, node, scrutinee.type_name)
    }
    if item.kind == ak_if() {
        var work = sa_check_bool(ctx, a_child(ctx.ast, node, 0))
        let then_block = a_child(ctx.ast, node, 1)
        work = sa_block(work, then_block)
        if item.count > 2 {
            let other = a_child(ctx.ast, node, 2)
            if ctx.ast.nodes[other].kind == ak_if() {
                let branch = sa_expr(work, other)
                work = branch.ctx
            } else {
                work = sa_block(work, other)
            }
        }
        return sa_result(work, "?")
    }
    return sa_result(ctx, "?")
}

fn sa_block(ctx: SaCtx, node: Int) -> SaCtx {
    if node < 0 || node >= ctx.ast.nodes.len() {
        return ctx
    }
    let saved = ctx.locals.len()
    var work = ctx
    var i = 0
    while i < ctx.ast.nodes[node].count {
        work = sa_stmt(work, a_child(ctx.ast, node, i))
        i = i + 1
    }
    return sa_trim_locals(work, saved)
}

fn sa_stmt(ctx: SaCtx, node: Int) -> SaCtx {
    if node < 0 || node >= ctx.ast.nodes.len() {
        return ctx
    }
    let item = ctx.ast.nodes[node]
    if item.kind == ak_let() || item.kind == ak_var() {
        let value_node = a_child(ctx.ast, node, 0)
        var work = ctx
        var type_name = item.aux
        var actual = "?"
        if type_name.len() > 0 && sa_array_layout(type_name).1 >= 0 && ctx.ast.nodes[value_node].kind == ak_list() {
            work = sa_array_literal(ctx, value_node, type_name)
            actual = type_name
        } else {
            let value = sa_expr(ctx, value_node)
            work = value.ctx
            actual = value.type_name
        }
        if type_name.len() > 0 {
            if !sa_compatible(type_name, actual) {
                let prefix = if actual == "Option<?>" { "" } else { "type mismatch: " }
                work = sa_error(
                    work,
                    value_node,
                    "E0308",
                    prefix + "expected `" + sa_display_type(type_name) + "`, found `" + sa_display_type(actual) + "`"
                )
            }
        } else {
            if actual == "Option<?>" {
                work = sa_error(
                    work,
                    value_node,
                    "E0210",
                    "cannot infer the type parameter of `None`"
                )
            } else if actual.starts_with("Result<") {
                let ok = sa_result_ok(actual)
                let err = sa_result_err(actual)
                if ok == "?" || err == "?" {
                    let constructor = if err == "?" { "Ok" } else { "Err" }
                    work = sa_error(
                        work,
                        value_node,
                        "E0210",
                        "cannot infer the full `Result` type from `" + constructor + "` alone"
                    )
                }
            } else if sa_is_map(actual) {
                if sa_map_key(actual) == "?" || sa_map_value(actual) == "?" {
                    work = sa_error(work, value_node, "E0210", "cannot infer the type of `map()`")
                }
            } else if sa_is_set(actual) {
                if sa_set_elem(actual) == "?" {
                    work = sa_error(work, value_node, "E0210", "cannot infer the type of `set()`")
                }
            }
            type_name = actual
        }
        if item.kind == ak_var() {
            return sa_push_mutable(work, item.text, type_name)
        }
        return sa_push_local(work, item.text, type_name)
    }
    if item.kind == ak_return() {
        if item.count == 0 {
            if ctx.ret != "Unit" && ctx.ret != "?" {
                return sa_error(ctx, node, "E0308", "function returns " + ctx.ret + " but this return has no value")
            }
            return ctx
        }
        let value_node = a_child(ctx.ast, node, 0)
        var work = ctx
        var actual = "?"
        if ctx.ret != "?" && sa_array_layout(ctx.ret).1 >= 0 && ctx.ast.nodes[value_node].kind == ak_list() {
            work = sa_array_literal(ctx, value_node, ctx.ret)
            actual = ctx.ret
        } else {
            let value = sa_expr(ctx, value_node)
            work = value.ctx
            actual = value.type_name
        }
        if ctx.ret != "?" && !sa_compatible(ctx.ret, actual) {
            return sa_error(
                work,
                value_node,
                "E0308",
                "type mismatch: expected `" + sa_display_type(ctx.ret) + "`, found `" + sa_display_type(actual) + "`"
            )
        }
        return work
    }
    if item.kind == ak_expr_stmt() {
        return sa_expr(ctx, a_child(ctx.ast, node, 0)).ctx
    }
    if item.kind == ak_block() {
        return sa_block(ctx, node)
    }
    if item.kind == ak_if() {
        var work = sa_check_bool(ctx, a_child(ctx.ast, node, 0))
        work = sa_block(work, a_child(ctx.ast, node, 1))
        if item.count > 2 {
            let other = a_child(ctx.ast, node, 2)
            if ctx.ast.nodes[other].kind == ak_if() {
                work = sa_stmt(work, other)
            } else {
                work = sa_block(work, other)
            }
        }
        return work
    }
    if item.kind == ak_while() {
        var work = sa_check_bool(ctx, a_child(ctx.ast, node, 0))
        work = sa_ctx_loops(work, work.loops + 1)
        work = sa_block(work, a_child(ctx.ast, node, 1))
        return sa_ctx_loops(work, work.loops - 1)
    }
    if item.kind == ak_for() {
        let iter = sa_expr(ctx, a_child(ctx.ast, node, 0))
        var work = iter.ctx
        var element = "?"
        if iter.type_name.starts_with("List<") {
            element = sa_elem_type(iter.type_name)
        } else if iter.type_name.starts_with("Slice<") {
            element = sa_elem_type(iter.type_name)
        } else if sa_array_layout(iter.type_name).1 >= 0 {
            element = sa_array_layout(iter.type_name).0
        } else if iter.type_name == "Range" {
            element = "Int"
        }
        work = sa_push_local(work, item.text, element)
        work = sa_ctx_loops(work, work.loops + 1)
        work = sa_block(work, a_child(ctx.ast, node, 1))
        return sa_ctx_loops(work, work.loops - 1)
    }
    if item.kind == ak_break() || item.kind == ak_continue() {
        if ctx.loops == 0 {
            let keyword = if item.kind == ak_break() { "break" } else { "continue" }
            return sa_error(ctx, node, "E0302", "`" + keyword + "` outside of a loop")
        }
        return ctx
    }
    if item.kind == ak_match() {
        return sa_expr(ctx, node).ctx
    }
    return ctx
}

fn sa_check_fn_body(ctx: SaCtx, node: Int, sig: SaFn) -> SaCtx {
    var locals: List<SaLocal> = []
    var i = 0
    while i < sig.params.len() {
        locals.push(SaLocal { name: sig.params[i], type_name: sig.types[i], mutable: false })
        i = i + 1
    }
    var work = sa_ctx_locals(ctx, locals)
    work = sa_ctx_ret(work, sig.ret)
    work = sa_ctx_loops(work, 0)
    let body = a_child(ctx.ast, node, ctx.ast.nodes[node].count - 1)
    return sa_block(work, body)
}

fn sa_check_fn(ctx: SaCtx, node: Int) -> SaCtx {
    let item = ctx.ast.nodes[node]
    let index = sa_fn_index(ctx.fns, item.text)
    if index < 0 {
        return ctx
    }
    return sa_check_fn_body(ctx, node, ctx.fns[index])
}

fn sa_check_method(ctx: SaCtx, impl_node: Int, method: Int) -> SaCtx {
    let symbol = ctx.ast.nodes[impl_node].text + "." + ctx.ast.nodes[method].text
    let index = sa_fn_index(ctx.fns, symbol)
    if index < 0 {
        return ctx
    }
    return sa_check_fn_body(ctx, method, ctx.fns[index])
}

fn sa_collect(ctx: SaCtx) -> SaCtx {
    var work = ctx
    let file = ctx.ast.nodes.len() - 1
    var i = 0
    while i < ctx.ast.nodes[file].count {
        let node = a_child(ctx.ast, file, i)
        let item = ctx.ast.nodes[node]
        if item.kind == ak_fn() || item.kind == ak_extern() {
            if sa_fn_index(work.fns, item.text) >= 0 {
                work = sa_error_at(
                    work,
                    node,
                    item.column + 3,
                    "E0200",
                    "duplicate function `" + item.text + "`"
                )
            } else {
                var params: List<String> = []
                var types: List<String> = []
                var seen_params: List<String> = []
                let last = if item.kind == ak_fn() { item.count - 1 } else { item.count }
                var k = 0
                while k < last {
                    let param_node = a_child(ctx.ast, node, k)
                    let param = ctx.ast.nodes[param_node]
                    if sa_has(seen_params, param.text) {
                        work = sa_error(work, param_node, "E0200", "duplicate parameter `" + param.text + "`")
                        work = sa_error(
                            work,
                            param_node,
                            "E0200",
                            "duplicate binding `" + param.text + "` in the same scope"
                        )
                    } else {
                        seen_params.push(param.text)
                    }
                    params.push(param.text)
                    types.push(param.aux)
                    k = k + 1
                }
                var ret = item.aux
                if ret.len() == 0 {
                    ret = "Unit"
                }
                var fns = work.fns
                fns.push(
                    SaFn {
                        name: item.text,
                        params: params,
                        types: types,
                        ret: ret,
                        line: item.line,
                        column: item.column,
                    }
                )
                work = SaCtx {
                    ast: work.ast,
                    fns: fns,
                    structs: work.structs,
                    enums: work.enums,
                    errors: work.errors,
                    locals: work.locals,
                    ret: work.ret,
                    loops: work.loops,
                }
            }
        } else if item.kind == ak_struct() {
            if sa_struct_index(work.structs, item.text) >= 0 {
                work = sa_error(work, node, "E0307", "duplicate struct `" + item.text + "`")
            } else {
                var fields: List<String> = []
                var types: List<String> = []
                var k = 0
                while k < item.count {
                    let field = ctx.ast.nodes[a_child(ctx.ast, node, k)]
                    if sa_has(fields, field.text) {
                        work = sa_error(work, a_child(ctx.ast, node, k), "E0307", "duplicate field `" + field.text + "` on " + item.text)
                    }
                    fields.push(field.text)
                    types.push(field.aux)
                    k = k + 1
                }
                var structs = work.structs
                structs.push(SaStruct { name: item.text, fields: fields, types: types })
                work = SaCtx {
                    ast: work.ast,
                    fns: work.fns,
                    structs: structs,
                    enums: work.enums,
                    errors: work.errors,
                    locals: work.locals,
                    ret: work.ret,
                    loops: work.loops,
                }
            }
        } else if item.kind == ak_trait() {
            var k = 0
            while k < item.count {
                let sig_node = a_child(ctx.ast, node, k)
                let sig = ctx.ast.nodes[sig_node]
                let symbol = item.text + "." + sig.text
                if sa_fn_index(work.fns, symbol) >= 0 {
                    work = sa_error(work, sig_node, "E0200", "duplicate trait method `" + symbol + "`")
                } else {
                    var params: List<String> = []
                    var types: List<String> = []
                    var p = 0
                    while p < sig.count {
                        let param = ctx.ast.nodes[a_child(ctx.ast, sig_node, p)]
                        var type_name = param.aux
                        if param.text == "self" && type_name.len() == 0 {
                            type_name = "Self"
                        }
                        params.push(param.text)
                        types.push(type_name)
                        p = p + 1
                    }
                    if params.len() == 0 || params[0] != "self" {
                        work = sa_error(work, sig_node, "E0201", "trait method `" + sig.text + "` must take `self` as its first parameter")
                    }
                    var ret = sig.aux
                    if ret.len() == 0 {
                        ret = "Unit"
                    }
                    var fns = work.fns
                    fns.push(
                        SaFn {
                            name: symbol,
                            params: params,
                            types: types,
                            ret: ret,
                            line: sig.line,
                            column: sig.column,
                        }
                    )
                    work = SaCtx {
                        ast: work.ast,
                        fns: fns,
                        structs: work.structs,
                        enums: work.enums,
                        errors: work.errors,
                        locals: work.locals,
                        ret: work.ret,
                        loops: work.loops,
                    }
                }
                k = k + 1
            }
        } else if item.kind == ak_enum() {
            if sa_enum_index(work.enums, item.text) >= 0 {
                work = sa_error(work, node, "E0307", "duplicate enum `" + item.text + "`")
            } else {
                var variants: List<String> = []
                var payload_types: List<String> = []
                var payload_counts: List<Int> = []
                var payload_offsets: List<Int> = []
                var k = 0
                while k < item.count {
                    let variant_node = a_child(ctx.ast, node, k)
                    let variant = ctx.ast.nodes[variant_node]
                    if sa_has(variants, variant.text) {
                        work = sa_error(
                            work,
                            variant_node,
                            "E0307",
                            "duplicate variant `" + variant.text + "` on " + item.text
                        )
                    }
                    variants.push(variant.text)
                    let types = sa_split_types(variant.aux)
                    payload_offsets.push(payload_types.len())
                    payload_counts.push(types.len())
                    for payload_type in types {
                        payload_types.push(payload_type)
                    }
                    k = k + 1
                }
                var enums = work.enums
                enums.push(
                    SaEnum {
                        name: item.text,
                        variants: variants,
                        payload_types: payload_types,
                        payload_counts: payload_counts,
                        payload_offsets: payload_offsets,
                    }
                )
                work = SaCtx {
                    ast: work.ast,
                    fns: work.fns,
                    structs: work.structs,
                    enums: enums,
                    errors: work.errors,
                    locals: work.locals,
                    ret: work.ret,
                    loops: work.loops,
                }
            }
        }
        i = i + 1
    }
    var impl_index = 0
    while impl_index < ctx.ast.nodes[file].count {
        let node = a_child(ctx.ast, file, impl_index)
        let item = ctx.ast.nodes[node]
        if item.kind == ak_impl() {
            let type_name = item.text
            let trait_name = item.aux
            if sa_struct_index(work.structs, type_name) < 0 && sa_enum_index(work.enums, type_name) < 0 {
                work = sa_error(work, node, "E0201", "cannot implement methods for unknown type `" + type_name + "`")
            }
            var k = 0
            while k < item.count {
                let method_node = a_child(ctx.ast, node, k)
                let method = ctx.ast.nodes[method_node]
                let symbol = type_name + "." + method.text
                var params: List<String> = []
                var types: List<String> = []
                var p = 0
                while p < method.count - 1 {
                    let param = ctx.ast.nodes[a_child(ctx.ast, method_node, p)]
                    var param_type = param.aux
                    if param.text == "self" && param_type.len() == 0 {
                        param_type = type_name
                    }
                    params.push(param.text)
                    types.push(param_type)
                    p = p + 1
                }
                if params.len() == 0 || params[0] != "self" {
                    work = sa_error(work, method_node, "E0201", "method `" + method.text + "` must take `self` as its first parameter")
                }
                if sa_fn_index(work.fns, symbol) >= 0 {
                    work = sa_error(work, method_node, "E0200", "duplicate method `" + symbol + "`")
                } else {
                    var ret = method.aux
                    if ret.len() == 0 {
                        ret = "Unit"
                    }
                    var fns = work.fns
                    fns.push(
                        SaFn {
                            name: symbol,
                            params: params,
                            types: types,
                            ret: ret,
                            line: method.line,
                            column: method.column,
                        }
                    )
                    work = SaCtx {
                        ast: work.ast,
                        fns: fns,
                        structs: work.structs,
                        enums: work.enums,
                        errors: work.errors,
                        locals: work.locals,
                        ret: work.ret,
                        loops: work.loops,
                    }
                }
                k = k + 1
            }
            if trait_name.len() > 0 {
                var found_trait = false
                var t = 0
                while t < work.fns.len() {
                    let trait_fn = work.fns[t]
                    let prefix = trait_name + "."
                    if trait_fn.name.starts_with(prefix) {
                        found_trait = true
                        let chars = trait_fn.name.chars()
                        let method_name = lx_slice(chars, prefix.len(), chars.len())
                        let impl_fn_index = sa_fn_index(work.fns, type_name + "." + method_name)
                        if impl_fn_index < 0 {
                            work = sa_error(
                                work,
                                node,
                                "E0201",
                                "`impl " + trait_name + " for " + type_name + "` is missing required method `" + method_name + "`"
                            )
                        } else {
                            let impl_fn = work.fns[impl_fn_index]
                            var mismatch = impl_fn.ret != trait_fn.ret
                            if impl_fn.types.len() != trait_fn.types.len() {
                                mismatch = true
                            } else {
                                var q = 1
                                while q < impl_fn.types.len() {
                                    if impl_fn.types[q] != trait_fn.types[q] {
                                        mismatch = true
                                    }
                                    q = q + 1
                                }
                            }
                            if mismatch {
                                work = sa_error(
                                    work,
                                    node,
                                    "E0201",
                                    "method `" + method_name + "` in `impl " + trait_name + " for " + type_name + "` does not match the trait signature"
                                )
                            }
                        }
                    }
                    t = t + 1
                }
                if !found_trait {
                    work = sa_error(work, node, "E0201", "unknown trait `" + trait_name + "`")
                }
            }
        }
        impl_index = impl_index + 1
    }
    return work
}

fn sa_check(source: String) -> List<String> {
    let ast = a_parse(source)
    if ast.errors.len() > 0 {
        return ast.errors
    }
    var ctx = SaCtx {
        ast: ast,
        fns: [],
        structs: [],
        enums: [],
        errors: [],
        locals: [],
        ret: "Unit",
        loops: 0,
    }
    ctx = sa_collect(ctx)
    let file = ast.nodes.len() - 1
    var i = 0
    while i < ast.nodes[file].count {
        let node = a_child(ast, file, i)
        if ast.nodes[node].kind == ak_fn() {
            ctx = sa_check_fn(ctx, node)
        }
        if ast.nodes[node].kind == ak_impl() {
            var k = 0
            while k < ast.nodes[node].count {
                ctx = sa_check_method(ctx, node, a_child(ast, node, k))
                k = k + 1
            }
        }
        i = i + 1
    }
    return ctx.errors
}
