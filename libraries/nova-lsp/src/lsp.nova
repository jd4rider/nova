// A small, real Nova language server over stdio.
//
// Length-framed JSON-RPC transport, initialize, shutdown, full-document sync,
// published semantic diagnostics, completion, hover, definition, document
// symbols and whole-document formatting.

import "../../nova-boxes/src/json.nova"
import "../../nova-check/src/sema.nova"
import "../../nova-fmt/src/fmt.nova"

extern "C" fn nova_stdin_read_line() -> String
extern "C" fn nova_stdin_read_bytes(count: Int) -> String

struct LspMessage {
    body: String,
    ok: Bool,
}

struct LspDiag {
    code: String,
    message: String,
    line: Int,
    column: Int,
}

struct LspDocument {
    uri: String,
    text: String,
    version: Int,
}

fn lsp_digit(c: String) -> Int {
    let digits = "0123456789".chars()
    var i = 0
    while i < digits.len() {
        if digits[i] == c {
            return i
        }
        i = i + 1
    }
    return -1
}

fn lsp_int(text: String) -> Int {
    var value = 0
    var seen = false
    for c in text.trim().chars() {
        let digit = lsp_digit(c)
        if digit < 0 {
            if seen {
                return value
            }
        } else {
            value = value * 10 + digit
            seen = true
        }
    }
    return value
}

fn lsp_read_message() -> LspMessage {
    var length = 0 - 1
    var reading = true
    while reading {
        let line = nova_stdin_read_line()
        if line.len() == 0 {
            return LspMessage { body: "", ok: false }
        }
        let text = line.trim()
        if text.len() == 0 {
            reading = false
        } else if text.starts_with("Content-Length:") {
            let parts = text.split(":")
            if parts.len() >= 2 {
                length = lsp_int(parts[1])
            }
        }
    }
    if length < 0 {
        return LspMessage { body: "", ok: false }
    }
    let body = nova_stdin_read_bytes(length)
    return LspMessage { body: body, ok: body.len() == length }
}

fn lsp_send(body: String) {
    print("Content-Length: " + body.len().to_string() + "\r\n\r\n" + body)
}

fn lsp_response(id: String, result: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":" + result + "}"
}

fn lsp_error(id: String, code: Int, message: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":" + code.to_string() + ",\"message\":" + js_quote(message) + "}}"
}

fn lsp_after_first_space(text: String) -> String {
    var out = ""
    var found = false
    for c in text.chars() {
        if !found && c == " " {
            found = true
        } else if found {
            out = out + c
        }
    }
    return out
}

fn lsp_diag_parts(text: String) -> LspDiag {
    var head = text
    var line = 0
    var column = 0
    let located = text.split(" at line ")
    if located.len() >= 2 {
        head = located[0]
        let place = located[1].split(", column ")
        if place.len() >= 2 {
            line = lsp_int(place[0])
            column = lsp_int(place[1])
        }
    }
    var code = ""
    let words = head.split(" ")
    if words.len() > 0 {
        code = words[0]
    }
    return LspDiag {
        code: code,
        message: lsp_after_first_space(head),
        line: line,
        column: column,
    }
}

fn lsp_diagnostics(source: String) -> String {
    let errors = sa_check(source)
    var out = "["
    var i = 0
    while i < errors.len() {
        if i > 0 {
            out = out + ","
        }
        let d = lsp_diag_parts(errors[i])
        var line = d.line - 1
        var column = d.column - 1
        if line < 0 {
            line = 0
        }
        if column < 0 {
            column = 0
        }
        let end = column + 1
        out = out + "{\"range\":{\"start\":{\"line\":" + line.to_string() + ",\"character\":" + column.to_string() + "},\"end\":{\"line\":" + line.to_string() + ",\"character\":" + end.to_string() + "}},\"severity\":1,\"code\":" + js_quote(d.code) + ",\"source\":\"nova\",\"message\":" + js_quote(d.message) + "}"
        i = i + 1
    }
    return out + "]"
}

fn lsp_publish(uri: String, text: String) {
    let body = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":" + js_quote(uri) + ",\"diagnostics\":" + lsp_diagnostics(text) + "}}"
    lsp_send(body)
}

fn lsp_json_string(doc: JsonDoc, node: Int, key: String) -> String {
    return js_str(doc, js_get(doc, node, key))
}

fn lsp_slice(chars: List<String>, start: Int, stop: Int) -> String {
    var out = ""
    var i = start
    while i < stop && i < chars.len() {
        out = out + chars[i]
        i = i + 1
    }
    return out
}

fn lsp_offset_at(text: String, line: Int, character: Int) -> Int {
    let chars = text.chars()
    var current_line = 0
    var current_char = 0
    var i = 0
    while i < chars.len() {
        if current_line == line && current_char >= character {
            return i
        }
        if chars[i] == "\n" {
            current_line = current_line + 1
            current_char = 0
        } else {
            current_char = current_char + 1
        }
        i = i + 1
    }
    return chars.len()
}

fn lsp_line_start(chars: List<String>, offset: Int) -> Int {
    var start = 0
    var i = 0
    while i < offset && i < chars.len() {
        if chars[i] == "\n" {
            start = i + 1
        }
        i = i + 1
    }
    return start
}

fn lsp_doc_index(documents: List<LspDocument>, uri: String) -> Int {
    var i = 0
    while i < documents.len() {
        if documents[i].uri == uri {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn lsp_doc_set(documents: List<LspDocument>, uri: String, text: String, version: Int) -> List<LspDocument> {
    var out: List<LspDocument> = []
    let index = lsp_doc_index(documents, uri)
    var i = 0
    while i < documents.len() {
        if i == index {
            out.push(LspDocument { uri: uri, text: text, version: version })
        } else {
            out.push(documents[i])
        }
        i = i + 1
    }
    if index < 0 {
        out.push(LspDocument { uri: uri, text: text, version: version })
    }
    return out
}

fn lsp_doc_text(documents: List<LspDocument>, uri: String) -> String {
    let index = lsp_doc_index(documents, uri)
    if index < 0 {
        return ""
    }
    return documents[index].text
}

fn lsp_doc_remove(documents: List<LspDocument>, uri: String) -> List<LspDocument> {
    var out: List<LspDocument> = []
    let index = lsp_doc_index(documents, uri)
    var i = 0
    while i < documents.len() {
        if i != index {
            out.push(documents[i])
        }
        i = i + 1
    }
    return out
}

fn lsp_completion_item(label: String, kind: Int, detail: String) -> String {
    return "{\"label\":" + js_quote(label) + ",\"kind\":" + kind.to_string() + ",\"detail\":" + js_quote(detail) + "}"
}

fn lsp_completion_items(text: String, offset: Int) -> String {
    let chars = text.chars()
    let start = lsp_line_start(chars, offset)
    let prefix = lsp_slice(chars, start, offset).trim_end()
    var items: List<String> = []
    if prefix.ends_with(".") {
        items.push(lsp_completion_item("len", 2, "number of elements or UTF-8 bytes"))
        items.push(lsp_completion_item("is_empty", 2, "true when empty"))
        items.push(lsp_completion_item("push", 2, "append to a mutable List"))
        items.push(lsp_completion_item("get", 2, "checked element access"))
        items.push(lsp_completion_item("to_string", 2, "convert to a String"))
        items.push(lsp_completion_item("unwrap_or", 2, "Option/Result fallback"))
        items.push(lsp_completion_item("is_some", 2, "Option check"))
        items.push(lsp_completion_item("is_none", 2, "Option check"))
        items.push(lsp_completion_item("is_ok", 2, "Result check"))
        items.push(lsp_completion_item("is_err", 2, "Result check"))
    } else {
        var keywords: List<String> = ["fn", "let", "var", "return", "if", "else", "while", "for", "in", "match", "struct", "enum", "import", "true", "false", "break", "continue"]
        for keyword in keywords {
            items.push(lsp_completion_item(keyword, 14, "keyword"))
        }
        var builtins: List<String> = ["println", "print", "eprintln", "assert", "assert_eq", "panic"]
        for name in builtins {
            items.push(lsp_completion_item(name, 3, "builtin"))
        }
        let ast = a_parse(text)
        if ast.errors.len() == 0 && ast.nodes.len() > 0 {
            let file = ast.nodes.len() - 1
            var i = 0
            while i < ast.nodes[file].count {
                let node = a_child(ast, file, i)
                let item = ast.nodes[node]
                if item.kind == ak_fn() {
                    items.push(lsp_completion_item(item.text, 3, "function"))
                } else if item.kind == ak_struct() {
                    items.push(lsp_completion_item(item.text, 22, "struct"))
                } else if item.kind == ak_enum() {
                    items.push(lsp_completion_item(item.text, 10, "enum"))
                } else if item.kind == ak_extern() {
                    items.push(lsp_completion_item(item.text, 3, "extern function"))
                }
                i = i + 1
            }
        }
    }
    return "[" + items.join(",") + "]"
}

struct LspWord {
    text: String,
    start: Int,
    stop: Int,
}

fn lsp_is_word_char(c: String) -> Bool {
    for part in "_abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789".chars() {
        if part == c {
            return true
        }
    }
    return false
}

fn lsp_word_at(text: String, line: Int, character: Int) -> LspWord {
    let chars = text.chars()
    let offset = lsp_offset_at(text, line, character)
    var start = offset
    while start > 0 && lsp_is_word_char(chars[start - 1]) {
        start = start - 1
    }
    var stop = offset
    while stop < chars.len() && lsp_is_word_char(chars[stop]) {
        stop = stop + 1
    }
    return LspWord { text: lsp_slice(chars, start, stop), start: start, stop: stop }
}

fn lsp_position_at(text: String, offset: Int) -> (Int, Int) {
    let chars = text.chars()
    var line = 0
    var character = 0
    var i = 0
    while i < offset && i < chars.len() {
        if chars[i] == "\n" {
            line = line + 1
            character = 0
        } else {
            character = character + 1
        }
        i = i + 1
    }
    return (line, character)
}

fn lsp_range(line: Int, character: Int, end_line: Int, end_character: Int) -> String {
    return "{\"start\":{\"line\":" + line.to_string() + ",\"character\":" + character.to_string() + "},\"end\":{\"line\":" + end_line.to_string() + ",\"character\":" + end_character.to_string() + "}}"
}

fn lsp_decl_score(kind: Int) -> Int {
    if kind == ak_fn() || kind == ak_struct() || kind == ak_enum() || kind == ak_extern() {
        return 3
    }
    if kind == ak_param() || kind == ak_field() || kind == ak_variant() {
        return 2
    }
    if kind == ak_let() || kind == ak_var() {
        return 1
    }
    return 0
}

// Finds the declaration for `word` at or above `line`. Top-level declarations
// win over parameters and bindings, and the latest match wins on a tie.
fn lsp_find_decl(ast: Ast, word: String, line: Int) -> Int {
    var best = 0 - 1
    var best_score = 0
    if word.len() == 0 {
        return best
    }
    var i = 0
    while i < ast.nodes.len() {
        let item = ast.nodes[i]
        if item.text == word && item.line <= line && lsp_decl_score(item.kind) >= best_score {
            if lsp_decl_score(item.kind) > 0 {
                best = i
                best_score = lsp_decl_score(item.kind)
            }
        }
        i = i + 1
    }
    return best
}

fn lsp_signature(ast: Ast, node: Int) -> String {
    let item = ast.nodes[node]
    if item.kind == ak_param() {
        if item.aux.len() > 0 {
            return "parameter `" + item.text + ": " + item.aux + "`"
        }
        return "parameter `" + item.text + "`"
    }
    if item.kind == ak_field() {
        return "field `" + item.text + ": " + item.aux + "`"
    }
    if item.kind == ak_variant() {
        if item.aux.len() > 0 {
            return "variant `" + item.text + "(" + item.aux + ")`"
        }
        return "variant `" + item.text + "`"
    }
    if item.kind == ak_let() || item.kind == ak_var() {
        let keyword = if item.kind == ak_let() { "let" } else { "var" }
        var out = keyword + " " + item.text
        if item.aux.len() > 0 {
            out = out + ": " + item.aux
        }
        return "binding `" + out + "`"
    }
    if item.kind == ak_struct() {
        var out = "struct " + item.text + " {"
        var i = 0
        while i < item.count {
            let field = ast.nodes[a_child(ast, node, i)]
            if i > 0 {
                out = out + ","
            }
            out = out + " " + field.text + ": " + field.aux
            i = i + 1
        }
        return out + " }"
    }
    if item.kind == ak_enum() {
        var out = "enum " + item.text + " {"
        var i = 0
        while i < item.count {
            let variant = ast.nodes[a_child(ast, node, i)]
            if i > 0 {
                out = out + ","
            }
            out = out + " " + variant.text
            if variant.aux.len() > 0 {
                out = out + "(" + variant.aux + ")"
            }
            i = i + 1
        }
        return out + " }"
    }
    var out = ""
    if item.kind == ak_extern() {
        out = "extern \"C\" "
    }
    out = out + "fn " + item.text + "("
    var i = 0
    var done = false
    while i < item.count && !done {
        let param = ast.nodes[a_child(ast, node, i)]
        if param.kind != ak_param() {
            done = true
        } else {
            if i > 0 {
                out = out + ", "
            }
            out = out + param.text
            if param.aux.len() > 0 {
                out = out + ": " + param.aux
            }
            i = i + 1
        }
    }
    out = out + ")"
    if item.aux.len() > 0 {
        out = out + " -> " + item.aux
    }
    return out
}

fn lsp_hover(text: String, line: Int, character: Int) -> String {
    let word = lsp_word_at(text, line, character)
    if word.text.len() == 0 {
        return "null"
    }
    let ast = a_parse(text)
    if ast.errors.len() > 0 || ast.nodes.len() == 0 {
        return "null"
    }
    let node = lsp_find_decl(ast, word.text, line + 1)
    if node < 0 {
        return "null"
    }
    let start = lsp_position_at(text, word.start)
    let stop = lsp_position_at(text, word.stop)
    let value = lsp_signature(ast, node)
    return "{\"contents\":{\"kind\":\"markdown\",\"value\":" + js_quote("```nova\n" + value + "\n```") + "},\"range\":" + lsp_range(start.0, start.1, stop.0, stop.1) + "}"
}

fn lsp_name_offset(kind: Int) -> Int {
    if kind == ak_fn() {
        return 3
    }
    if kind == ak_struct() {
        return 7
    }
    if kind == ak_enum() {
        return 5
    }
    return 0
}

fn lsp_definition(text: String, uri: String, line: Int, character: Int) -> String {
    let word = lsp_word_at(text, line, character)
    if word.text.len() == 0 {
        return "null"
    }
    let ast = a_parse(text)
    if ast.errors.len() > 0 || ast.nodes.len() == 0 {
        return "null"
    }
    let node = lsp_find_decl(ast, word.text, line + 1)
    if node < 0 {
        return "null"
    }
    let item = ast.nodes[node]
    var start_line = item.line - 1
    var start_column = item.column - 1 + lsp_name_offset(item.kind)
    if start_line < 0 {
        start_line = 0
    }
    if start_column < 0 {
        start_column = 0
    }
    return "{\"uri\":" + js_quote(uri) + ",\"range\":" + lsp_range(start_line, start_column, start_line, start_column + item.text.len()) + "}"
}

fn lsp_symbol_kind(kind: Int) -> Int {
    if kind == ak_fn() || kind == ak_extern() {
        return 12
    }
    if kind == ak_struct() {
        return 23
    }
    if kind == ak_enum() {
        return 10
    }
    if kind == ak_field() {
        return 8
    }
    if kind == ak_variant() {
        return 22
    }
    if kind == ak_impl() {
        return 5
    }
    return 13
}

fn lsp_symbol(name: String, kind: Int, line: Int, column: Int, end_line: Int, end_column: Int, children: String) -> String {
    var out = "{\"name\":" + js_quote(name) + ",\"kind\":" + kind.to_string() + ",\"range\":" + lsp_range(line, column, end_line, end_column) + ",\"selectionRange\":" + lsp_range(line, column, line, column + name.len()) + ",\"children\":" + children
    return out + "}"
}

fn lsp_symbol_children(ast: Ast, node: Int) -> String {
    let item = ast.nodes[node]
    var out = "["
    if item.kind == ak_struct() || item.kind == ak_enum() || item.kind == ak_impl() {
        var i = 0
        while i < item.count {
            let child = a_child(ast, node, i)
            let part = ast.nodes[child]
            if i > 0 {
                out = out + ","
            }
            out = out + lsp_symbol(part.text, lsp_symbol_kind(part.kind), part.line - 1, part.column - 1, part.line - 1, part.column - 1 + part.text.len(), "[]")
            i = i + 1
        }
    }
    return out + "]"
}

fn lsp_document_symbols(text: String) -> String {
    let ast = a_parse(text)
    if ast.errors.len() > 0 || ast.nodes.len() == 0 {
        return "[]"
    }
    let file = ast.nodes.len() - 1
    if ast.nodes[file].kind != ak_file() {
        return "[]"
    }
    let lines = text.split("\n")
    let last_line = lines.len() - 1
    let last_column = lines[last_line].len()
    var out = "["
    var i = 0
    while i < ast.nodes[file].count {
        let node = a_child(ast, file, i)
        let item = ast.nodes[node]
        var end_line = last_line
        var end_column = last_column
        if i + 1 < ast.nodes[file].count {
            let next = ast.nodes[a_child(ast, file, i + 1)]
            end_line = next.line - 1
            end_column = next.column - 1
            if end_line < 0 {
                end_line = 0
            }
            if end_column < 0 {
                end_column = 0
            }
        }
        if i > 0 {
            out = out + ","
        }
        out = out + lsp_symbol(item.text, lsp_symbol_kind(item.kind), item.line - 1, item.column - 1, end_line, end_column, lsp_symbol_children(ast, node))
        i = i + 1
    }
    return out + "]"
}

fn lsp_formatting(text: String) -> String {
    if text.len() == 0 {
        return "[]"
    }
    let formatted = fmt_source(text)
    if formatted == text {
        return "[]"
    }
    let lines = text.split("\n")
    let last_line = lines.len() - 1
    let last_column = lines[last_line].len()
    return "[{\"range\":" + lsp_range(0, 0, last_line, last_column) + ",\"newText\":" + js_quote(formatted) + "}]"
}

fn lsp_run_stdio() -> Int {
    var documents: List<LspDocument> = []
    var running = true
    while running {
        let message = lsp_read_message()
        if !message.ok {
            running = false
        } else {
            let doc = js_parse(message.body)
            if doc.error.len() == 0 {
                let root = doc.nodes.len() - 1
                let method = lsp_json_string(doc, root, "method")
                let id_node = js_get(doc, root, "id")
                let has_id = id_node >= 0
                if method == "exit" {
                    running = false
                } else if method == "initialize" {
                    var id = "null"
                    if has_id {
                        id = js_render(doc, id_node)
                    }
                    let result = "{\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true,\"definitionProvider\":true,\"documentSymbolProvider\":true,\"documentFormattingProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\",\"$\"],\"resolveProvider\":false}},\"serverInfo\":{\"name\":\"nova-lsp\",\"version\":\"0.2.0\"}}"
                    lsp_send(lsp_response(id, result))
                } else if method == "shutdown" {
                    var id = "null"
                    if has_id {
                        id = js_render(doc, id_node)
                    }
                    lsp_send(lsp_response(id, "null"))
                } else if method == "textDocument/didOpen" {
                    let params = js_get(doc, root, "params")
                    let document = js_get(doc, params, "textDocument")
                    let uri = lsp_json_string(doc, document, "uri")
                    let text = lsp_json_string(doc, document, "text")
                    let version = lsp_int(lsp_json_string(doc, document, "version"))
                    documents = lsp_doc_set(documents, uri, text, version)
                    lsp_publish(uri, text)
                } else if method == "textDocument/didChange" {
                    let params = js_get(doc, root, "params")
                    let document = js_get(doc, params, "textDocument")
                    let uri = lsp_json_string(doc, document, "uri")
                    let changes = js_get(doc, params, "contentChanges")
                    var text = ""
                    let count = js_len(doc, changes)
                    if count > 0 {
                        text = lsp_json_string(doc, js_at(doc, changes, count - 1), "text")
                    }
                    let version = lsp_int(lsp_json_string(doc, document, "version"))
                    documents = lsp_doc_set(documents, uri, text, version)
                    lsp_publish(uri, text)
                } else if method == "textDocument/didClose" {
                    let params = js_get(doc, root, "params")
                    let document = js_get(doc, params, "textDocument")
                    let uri = lsp_json_string(doc, document, "uri")
                    documents = lsp_doc_remove(documents, uri)
                    lsp_publish(uri, "")
                } else if method == "textDocument/didSave" {
                    let params = js_get(doc, root, "params")
                    let document = js_get(doc, params, "textDocument")
                    let uri = lsp_json_string(doc, document, "uri")
                    let text = lsp_json_string(doc, params, "text")
                    if text.len() > 0 {
                        let version = lsp_int(lsp_json_string(doc, document, "version"))
                        documents = lsp_doc_set(documents, uri, text, version)
                        lsp_publish(uri, text)
                    }
                } else if method == "textDocument/completion" {
                    let params = js_get(doc, root, "params")
                    let document = js_get(doc, params, "textDocument")
                    let uri = lsp_json_string(doc, document, "uri")
                    let position = js_get(doc, params, "position")
                    let line = lsp_int(js_str(doc, js_get(doc, position, "line")))
                    let character = lsp_int(js_str(doc, js_get(doc, position, "character")))
                    let text = lsp_doc_text(documents, uri)
                    let offset = lsp_offset_at(text, line, character)
                    var id = "null"
                    if has_id {
                        id = js_render(doc, id_node)
                    }
                    let result = "{\"isIncomplete\":false,\"items\":" + lsp_completion_items(text, offset) + "}"
                    lsp_send(lsp_response(id, result))
                } else if method == "textDocument/hover" {
                    let params = js_get(doc, root, "params")
                    let document = js_get(doc, params, "textDocument")
                    let uri = lsp_json_string(doc, document, "uri")
                    let position = js_get(doc, params, "position")
                    let line = lsp_int(js_str(doc, js_get(doc, position, "line")))
                    let character = lsp_int(js_str(doc, js_get(doc, position, "character")))
                    let text = lsp_doc_text(documents, uri)
                    var id = "null"
                    if has_id {
                        id = js_render(doc, id_node)
                    }
                    lsp_send(lsp_response(id, lsp_hover(text, line, character)))
                } else if method == "textDocument/definition" {
                    let params = js_get(doc, root, "params")
                    let document = js_get(doc, params, "textDocument")
                    let uri = lsp_json_string(doc, document, "uri")
                    let position = js_get(doc, params, "position")
                    let line = lsp_int(js_str(doc, js_get(doc, position, "line")))
                    let character = lsp_int(js_str(doc, js_get(doc, position, "character")))
                    let text = lsp_doc_text(documents, uri)
                    var id = "null"
                    if has_id {
                        id = js_render(doc, id_node)
                    }
                    lsp_send(lsp_response(id, lsp_definition(text, uri, line, character)))
                } else if method == "textDocument/documentSymbol" {
                    let params = js_get(doc, root, "params")
                    let document = js_get(doc, params, "textDocument")
                    let uri = lsp_json_string(doc, document, "uri")
                    let text = lsp_doc_text(documents, uri)
                    var id = "null"
                    if has_id {
                        id = js_render(doc, id_node)
                    }
                    lsp_send(lsp_response(id, lsp_document_symbols(text)))
                } else if method == "textDocument/formatting" {
                    let params = js_get(doc, root, "params")
                    let document = js_get(doc, params, "textDocument")
                    let uri = lsp_json_string(doc, document, "uri")
                    let text = lsp_doc_text(documents, uri)
                    var id = "null"
                    if has_id {
                        id = js_render(doc, id_node)
                    }
                    lsp_send(lsp_response(id, lsp_formatting(text)))
                } else if has_id {
                    let id = js_render(doc, id_node)
                    lsp_send(lsp_error(id, 0 - 32601, "method not implemented"))
                }
            }
        }
    }
    return 0
}
