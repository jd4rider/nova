// Nova LLVM IR lowering.
//
// Scope: Int, Unit and String functions; let/var; integer, string and list
// literals; String.len/List.len; list indexing, index assignment and push;
// arithmetic; if/else/while; direct calls; seed-shaped ABI (`ptr %arg_env`,
// `nova_user_N`, `%nova.string`, `%nova.list`). Maps, structs and the full
// runtime ABI are later tasks.
//
// Unsupported syntax returns an error instead of emitting guessed IR.

import "../../nova-parser/src/ast.nova"

struct CgSig {
    name: String,
    params: List<String>,
    param_types: List<String>,
    ret: String,
    body: Int,
    index: Int,
}

struct CgLocal {
    name: String,
    ty: String,
    slot: String,
    value: String,
    mutable: Bool,
}

struct CgState {
    lines: List<String>,
    temps: Int,
    slots: Int,
    locals: List<CgLocal>,
    fns: List<CgSig>,
    globals: List<String>,
    strings: Int,
    fn_index: Int,
    ret: String,
    terminated: Bool,
    error: String,
}

struct CgVal {
    state: CgState,
    value: String,
    ty: String,
}

struct CgResult {
    ir: String,
    error: String,
}

fn cg_state(
    state: CgState,
    lines: List<String>,
    temps: Int,
    slots: Int,
    locals: List<CgLocal>,
    terminated: Bool,
    error: String
) -> CgState {
    return CgState {
        lines: lines,
        temps: temps,
        slots: slots,
        locals: locals,
        fns: state.fns,
        globals: state.globals,
        strings: state.strings,
        fn_index: state.fn_index,
        ret: state.ret,
        terminated: terminated,
        error: error,
    }
}

fn cg_state_globals(state: CgState, globals: List<String>, strings: Int) -> CgState {
    return CgState {
        lines: state.lines,
        temps: state.temps,
        slots: state.slots,
        locals: state.locals,
        fns: state.fns,
        globals: globals,
        strings: strings,
        fn_index: state.fn_index,
        ret: state.ret,
        terminated: state.terminated,
        error: state.error,
    }
}

fn cg_llvm_type(type_name: String) -> String {
    if type_name == "String" {
        return "%nova.string"
    }
    if type_name == "List<Int>" {
        return "%nova.list"
    }
    if type_name == "Unit" || type_name == "" {
        return "void"
    }
    return "i64"
}

fn cg_line(state: CgState, text: String) -> CgState {
    var lines = state.lines
    lines.push(text)
    return cg_state(state, lines, state.temps, state.slots, state.locals, state.terminated, state.error)
}

fn cg_error(state: CgState, message: String) -> CgState {
    if state.error.len() > 0 {
        return state
    }
    return cg_state(state, state.lines, state.temps, state.slots, state.locals, state.terminated, message)
}

fn cg_temp(state: CgState) -> (CgState, String) {
    let next = state.temps + 1
    let name = "%t" + state.temps.to_string()
    return (cg_state(state, state.lines, next, state.slots, state.locals, state.terminated, state.error), name)
}

fn cg_slot(state: CgState) -> (CgState, String) {
    let next = state.slots + 1
    let name = "%s" + state.slots.to_string()
    return (cg_state(state, state.lines, state.temps, next, state.locals, state.terminated, state.error), name)
}

fn cg_local_index(locals: List<CgLocal>, name: String) -> Int {
    var i = locals.len() - 1
    while i >= 0 {
        if locals[i].name == name {
            return i
        }
        i = i - 1
    }
    return -1
}

fn cg_fn_index(fns: List<CgSig>, name: String) -> Int {
    var i = 0
    while i < fns.len() {
        if fns[i].name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn cg_number(text: String) -> String {
    if text.contains(".") {
        return ""
    }
    let chars = text.chars()
    var out = ""
    for c in chars {
        if c != "_" {
            out = out + c
        }
    }
    return out
}

fn cg_val(state: CgState, value: String) -> CgVal {
    return CgVal { state: state, value: value, ty: "i64" }
}

fn cg_val_typed(state: CgState, value: String, ty: String) -> CgVal {
    return CgVal { state: state, value: value, ty: ty }
}

fn cg_label(state: CgState) -> (CgState, String) {
    let next = state.temps + 1
    let name = "L" + state.temps.to_string()
    return (cg_state(state, state.lines, next, state.slots, state.locals, state.terminated, state.error), name)
}

fn cg_string_unquote(raw: String) -> String {
    let chars = raw.chars()
    if chars.len() < 2 {
        return ""
    }
    var out = ""
    var i = 1
    while i < chars.len() - 1 {
        let c = chars[i]
        if c == "\\" && i + 1 < chars.len() - 1 {
            i = i + 1
            let escaped = chars[i]
            if escaped == "n" {
                out = out + "\n"
            } else if escaped == "t" {
                out = out + "\t"
            } else if escaped == "r" {
                out = out + "\r"
            } else if escaped == "\\" {
                out = out + "\\"
            } else if escaped == "\"" {
                out = out + "\""
            } else {
                out = out + escaped
            }
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

fn cg_llvm_escape(text: String) -> String {
    var out = ""
    for c in text.chars() {
        if c == "\"" {
            out = out + "\\22"
        } else if c == "\\" {
            out = out + "\\5C"
        } else if c == "\n" {
            out = out + "\\0A"
        } else if c == "\t" {
            out = out + "\\09"
        } else if c == "\r" {
            out = out + "\\0D"
        } else {
            out = out + c
        }
    }
    return out
}

fn cg_string_lit(state: CgState, raw: String) -> CgVal {
    let text = cg_string_unquote(raw)
    let symbol = "@nova.str." + state.fn_index.to_string() + "." + state.strings.to_string()
    var definition = symbol + " = private unnamed_addr constant [1 x i8] zeroinitializer, align 1"
    if text.len() > 0 {
        definition = symbol + " = private unnamed_addr constant [" + text.len().to_string() + " x i8] c\"" + cg_llvm_escape(text) + "\", align 1"
    }
    var globals = state.globals
    globals.push(definition)
    var work = cg_state_globals(state, globals, state.strings + 1)
    let first_result = cg_temp(work)
    work = first_result.0
    let first = first_result.1
    work = cg_line(work, "  " + first + " = insertvalue %nova.string { ptr null, i64 0 }, ptr " + symbol + ", 0")
    let second_result = cg_temp(work)
    work = second_result.0
    let second = second_result.1
    work = cg_line(work, "  " + second + " = insertvalue %nova.string " + first + ", i64 " + text.len().to_string() + ", 1")
    return cg_val_typed(work, second, "%nova.string")
}

fn cg_list_lit(ast: Ast, state: CgState, node: Int) -> CgVal {
    let count = ast.nodes[node].count
    if count == 0 {
        let first_result = cg_temp(state)
        var work = first_result.0
        let first = first_result.1
        work = cg_line(work, "  " + first + " = insertvalue %nova.list zeroinitializer, i64 0, 1")
        let second_result = cg_temp(work)
        work = second_result.0
        let second = second_result.1
        work = cg_line(work, "  " + second + " = insertvalue %nova.list " + first + ", i64 0, 2")
        return cg_val_typed(work, second, "%nova.list")
    }
    let bytes_result = cg_temp(state)
    var work = bytes_result.0
    let bytes = bytes_result.1
    work = cg_line(work, "  " + bytes + " = mul i64 " + count.to_string() + ", 8")
    let data_result = cg_temp(work)
    work = data_result.0
    let array = data_result.1
    work = cg_line(work, "  " + array + " = call ptr @malloc(i64 " + bytes + ")")
    let null_result = cg_temp(work)
    work = null_result.0
    let is_null = null_result.1
    work = cg_line(work, "  " + is_null + " = icmp eq ptr " + array + ", null")
    let ok_result = cg_label(work)
    work = ok_result.0
    let ok = ok_result.1
    let bad_result = cg_label(work)
    work = bad_result.0
    let bad = bad_result.1
    work = cg_line(work, "  br i1 " + is_null + ", label %" + bad + ", label %" + ok)
    work = cg_line(work, bad + ":")
    work = cg_line(work, "  call void @llvm.trap()")
    work = cg_line(work, "  unreachable")
    work = cg_line(work, ok + ":")
    var i = 0
    while i < count {
        let value = cg_expr2(ast, work, a_child(ast, node, i))
        work = value.state
        if value.ty != "i64" {
            return cg_val(cg_error(work, "list elements must be Int"), "0")
        }
        let ptr_result = cg_temp(work)
        work = ptr_result.0
        let ptr = ptr_result.1
        work = cg_line(work, "  " + ptr + " = getelementptr i64, ptr " + array + ", i64 " + i.to_string())
        work = cg_line(work, "  store i64 " + value.value + ", ptr " + ptr)
        i = i + 1
    }
    let first_result = cg_temp(work)
    work = first_result.0
    let first = first_result.1
    work = cg_line(work, "  " + first + " = insertvalue %nova.list zeroinitializer, ptr " + array + ", 0")
    let second_result = cg_temp(work)
    work = second_result.0
    let second = second_result.1
    work = cg_line(work, "  " + second + " = insertvalue %nova.list " + first + ", i64 " + count.to_string() + ", 1")
    let third_result = cg_temp(work)
    work = third_result.0
    let third = third_result.1
    work = cg_line(work, "  " + third + " = insertvalue %nova.list " + second + ", i64 " + count.to_string() + ", 2")
    return cg_val_typed(work, third, "%nova.list")
}

fn cg_index(ast: Ast, state: CgState, node: Int) -> CgVal {
    let base = cg_expr2(ast, state, a_child(ast, node, 0))
    let index = cg_expr2(ast, base.state, a_child(ast, node, 1))
    if base.ty != "%nova.list" {
        return cg_val(cg_error(index.state, "indexing expects List<Int>"), "0")
    }
    if index.ty != "i64" {
        return cg_val(cg_error(index.state, "list index must be Int"), "0")
    }
    let ok_result = cg_label(index.state)
    var work = ok_result.0
    let ok = ok_result.1
    let bad_result = cg_label(work)
    work = bad_result.0
    let bad = bad_result.1
    let len_result = cg_temp(work)
    work = len_result.0
    let len = len_result.1
    work = cg_line(work, "  " + len + " = extractvalue %nova.list " + base.value + ", 1")
    let neg_result = cg_temp(work)
    work = neg_result.0
    let neg = neg_result.1
    work = cg_line(work, "  " + neg + " = icmp slt i64 " + index.value + ", 0")
    let big_result = cg_temp(work)
    work = big_result.0
    let big = big_result.1
    work = cg_line(work, "  " + big + " = icmp sge i64 " + index.value + ", " + len)
    let oob_result = cg_temp(work)
    work = oob_result.0
    let oob = oob_result.1
    work = cg_line(work, "  " + oob + " = or i1 " + neg + ", " + big)
    work = cg_line(work, "  br i1 " + oob + ", label %" + bad + ", label %" + ok)
    work = cg_line(work, bad + ":")
    work = cg_line(work, "  call void @llvm.trap()")
    work = cg_line(work, "  unreachable")
    work = cg_line(work, ok + ":")
    let data_result = cg_temp(work)
    work = data_result.0
    let data = data_result.1
    work = cg_line(work, "  " + data + " = extractvalue %nova.list " + base.value + ", 0")
    let ptr_result = cg_temp(work)
    work = ptr_result.0
    let ptr = ptr_result.1
    work = cg_line(work, "  " + ptr + " = getelementptr i64, ptr " + data + ", i64 " + index.value)
    let val_result = cg_temp(work)
    work = val_result.0
    let val = val_result.1
    work = cg_line(work, "  " + val + " = load i64, ptr " + ptr)
    return cg_val(work, val)
}

fn cg_index_assign(ast: Ast, state: CgState, target: Int, value_node: Int) -> CgVal {
    let recv = a_child(ast, target, 0)
    if recv < 0 || ast.nodes[recv].kind != ak_ident() {
        return cg_val(cg_error(state, "index assignment requires a mutable list variable"), "0")
    }
    let index = cg_local_index(state.locals, ast.nodes[recv].text)
    if index < 0 {
        return cg_val(cg_error(state, "unknown local " + ast.nodes[recv].text), "0")
    }
    let local = state.locals[index]
    if local.ty != "%nova.list" {
        return cg_val(cg_error(state, "index assignment expects List<Int>"), "0")
    }
    if !local.mutable || local.slot.len() == 0 {
        return cg_val(cg_error(state, "index assignment requires a mutable list variable"), "0")
    }
    let at = cg_expr2(ast, state, a_child(ast, target, 1))
    if at.ty != "i64" {
        return cg_val(cg_error(at.state, "list index must be Int"), "0")
    }
    let value = cg_expr2(ast, at.state, value_node)
    var work = value.state
    if value.ty != "i64" {
        return cg_val(cg_error(work, "only List<Int> element assignment is supported"), "0")
    }
    let loaded_result = cg_temp(work)
    work = loaded_result.0
    let loaded = loaded_result.1
    work = cg_line(work, "  " + loaded + " = load %nova.list, ptr " + local.slot)
    let len_result = cg_temp(work)
    work = len_result.0
    let len = len_result.1
    work = cg_line(work, "  " + len + " = extractvalue %nova.list " + loaded + ", 1")
    let neg_result = cg_temp(work)
    work = neg_result.0
    let neg = neg_result.1
    work = cg_line(work, "  " + neg + " = icmp slt i64 " + at.value + ", 0")
    let big_result = cg_temp(work)
    work = big_result.0
    let big = big_result.1
    work = cg_line(work, "  " + big + " = icmp sge i64 " + at.value + ", " + len)
    let oob_result = cg_temp(work)
    work = oob_result.0
    let oob = oob_result.1
    work = cg_line(work, "  " + oob + " = or i1 " + neg + ", " + big)
    let bad_result = cg_label(work)
    work = bad_result.0
    let bad = bad_result.1
    let ok_result = cg_label(work)
    work = ok_result.0
    let ok = ok_result.1
    work = cg_line(work, "  br i1 " + oob + ", label %" + bad + ", label %" + ok)
    work = cg_line(work, bad + ":")
    work = cg_line(work, "  call void @llvm.trap()")
    work = cg_line(work, "  unreachable")
    work = cg_line(work, ok + ":")
    let data_result = cg_temp(work)
    work = data_result.0
    let data = data_result.1
    work = cg_line(work, "  " + data + " = extractvalue %nova.list " + loaded + ", 0")
    let ptr_result = cg_temp(work)
    work = ptr_result.0
    let ptr = ptr_result.1
    work = cg_line(work, "  " + ptr + " = getelementptr i64, ptr " + data + ", i64 " + at.value)
    work = cg_line(work, "  store i64 " + value.value + ", ptr " + ptr)
    return cg_val(work, value.value)
}

fn cg_list_push(ast: Ast, state: CgState, node: Int) -> CgVal {
    let got = ast.nodes[node].count - 1
    if got != 1 {
        return cg_val(cg_error(state, "push expects one argument"), "0")
    }
    let callee = a_child(ast, node, 0)
    let recv = a_child(ast, callee, 0)
    if recv < 0 || ast.nodes[recv].kind != ak_ident() {
        return cg_val(cg_error(state, "push requires a mutable list variable"), "0")
    }
    let index = cg_local_index(state.locals, ast.nodes[recv].text)
    if index < 0 {
        return cg_val(cg_error(state, "unknown local " + ast.nodes[recv].text), "0")
    }
    let local = state.locals[index]
    if local.ty != "%nova.list" {
        return cg_val(cg_error(state, "push expects List<Int>"), "0")
    }
    if !local.mutable || local.slot.len() == 0 {
        return cg_val(cg_error(state, "push requires a mutable list variable"), "0")
    }
    let value = cg_expr2(ast, state, a_child(ast, node, 1))
    var work = value.state
    if value.ty != "i64" {
        return cg_val(cg_error(work, "only List<Int>.push is supported"), "0")
    }
    let len_ptr_result = cg_temp(work)
    work = len_ptr_result.0
    let len_ptr = len_ptr_result.1
    work = cg_line(work, "  " + len_ptr + " = getelementptr %nova.list, ptr " + local.slot + ", i64 0, i32 1")
    let len_result = cg_temp(work)
    work = len_result.0
    let len = len_result.1
    work = cg_line(work, "  " + len + " = load i64, ptr " + len_ptr)
    let cap_ptr_result = cg_temp(work)
    work = cap_ptr_result.0
    let cap_ptr = cap_ptr_result.1
    work = cg_line(work, "  " + cap_ptr + " = getelementptr %nova.list, ptr " + local.slot + ", i64 0, i32 2")
    let cap_result = cg_temp(work)
    work = cap_result.0
    let cap = cap_result.1
    work = cg_line(work, "  " + cap + " = load i64, ptr " + cap_ptr)
    let data_ptr_result = cg_temp(work)
    work = data_ptr_result.0
    let data_ptr = data_ptr_result.1
    work = cg_line(work, "  " + data_ptr + " = getelementptr %nova.list, ptr " + local.slot + ", i64 0, i32 0")
    let full_result = cg_temp(work)
    work = full_result.0
    let full = full_result.1
    work = cg_line(work, "  " + full + " = icmp sge i64 " + len + ", " + cap)
    let grow_result = cg_label(work)
    work = grow_result.0
    let grow = grow_result.1
    let store_result = cg_label(work)
    work = store_result.0
    let store = store_result.1
    work = cg_line(work, "  br i1 " + full + ", label %" + grow + ", label %" + store)
    work = cg_line(work, grow + ":")
    let double_result = cg_temp(work)
    work = double_result.0
    let doubled = double_result.1
    work = cg_line(work, "  " + doubled + " = mul i64 " + cap + ", 2")
    let empty_result = cg_temp(work)
    work = empty_result.0
    let empty = empty_result.1
    work = cg_line(work, "  " + empty + " = icmp eq i64 " + cap + ", 0")
    let newcap_result = cg_temp(work)
    work = newcap_result.0
    let newcap = newcap_result.1
    work = cg_line(work, "  " + newcap + " = select i1 " + empty + ", i64 4, i64 " + doubled)
    let bytes_result = cg_temp(work)
    work = bytes_result.0
    let bytes = bytes_result.1
    work = cg_line(work, "  " + bytes + " = mul i64 " + newcap + ", 8")
    let old_data_result = cg_temp(work)
    work = old_data_result.0
    let old_data = old_data_result.1
    work = cg_line(work, "  " + old_data + " = load ptr, ptr " + data_ptr)
    let grown_result = cg_temp(work)
    work = grown_result.0
    let grown = grown_result.1
    work = cg_line(work, "  " + grown + " = call ptr @realloc(ptr " + old_data + ", i64 " + bytes + ")")
    let null_result = cg_temp(work)
    work = null_result.0
    let is_null = null_result.1
    work = cg_line(work, "  " + is_null + " = icmp eq ptr " + grown + ", null")
    let bad_result = cg_label(work)
    work = bad_result.0
    let bad = bad_result.1
    let grown_ok_result = cg_label(work)
    work = grown_ok_result.0
    let grown_ok = grown_ok_result.1
    work = cg_line(work, "  br i1 " + is_null + ", label %" + bad + ", label %" + grown_ok)
    work = cg_line(work, bad + ":")
    work = cg_line(work, "  call void @llvm.trap()")
    work = cg_line(work, "  unreachable")
    work = cg_line(work, grown_ok + ":")
    work = cg_line(work, "  store ptr " + grown + ", ptr " + data_ptr)
    work = cg_line(work, "  store i64 " + newcap + ", ptr " + cap_ptr)
    work = cg_line(work, "  br label %" + store)
    work = cg_line(work, store + ":")
    let final_len_result = cg_temp(work)
    work = final_len_result.0
    let final_len = final_len_result.1
    work = cg_line(work, "  " + final_len + " = load i64, ptr " + len_ptr)
    let final_data_result = cg_temp(work)
    work = final_data_result.0
    let final_data = final_data_result.1
    work = cg_line(work, "  " + final_data + " = load ptr, ptr " + data_ptr)
    let at_result = cg_temp(work)
    work = at_result.0
    let at = at_result.1
    work = cg_line(work, "  " + at + " = getelementptr i64, ptr " + final_data + ", i64 " + final_len)
    work = cg_line(work, "  store i64 " + value.value + ", ptr " + at)
    let next_result = cg_temp(work)
    work = next_result.0
    let next = next_result.1
    work = cg_line(work, "  " + next + " = add i64 " + final_len + ", 1")
    work = cg_line(work, "  store i64 " + next + ", ptr " + len_ptr)
    return cg_val_typed(work, "", "void")
}

fn cg_compile(source: String) -> CgResult {
    let ast = a_parse(source)
    if ast.error.len() > 0 {
        return CgResult { ir: "", error: "parse error: " + ast.error }
    }
    var fns: List<CgSig> = []
    let file = ast.nodes.len() - 1
    var i = 0
    while i < ast.nodes[file].count {
        let node = a_child(ast, file, i)
        let item = ast.nodes[node]
        if item.kind == ak_fn() {
            var ret = item.aux
            if ret == "" {
                ret = "Unit"
            }
            if ret != "Int" && ret != "String" && ret != "Unit" && ret != "List<Int>" {
                return CgResult { ir: "", error: "unsupported return type on " + item.text }
            }
            if cg_fn_index(fns, item.text) >= 0 {
                return CgResult { ir: "", error: "duplicate function " + item.text }
            }
            var params: List<String> = []
            var param_types: List<String> = []
            var k = 0
            while k < item.count - 1 {
                let param = ast.nodes[a_child(ast, node, k)]
                if param.aux != "Int" && param.aux != "String" && param.aux != "List<Int>" {
                    return CgResult { ir: "", error: "unsupported parameter type on " + param.text }
                }
                params.push(param.text)
                param_types.push(param.aux)
                k = k + 1
            }
            let index = fns.len()
            fns.push(CgSig { name: item.text, params: params, param_types: param_types, ret: ret, body: a_child(ast, node, item.count - 1), index: index })
        }
        i = i + 1
    }
    if cg_fn_index(fns, "main") < 0 {
        return CgResult { ir: "", error: "missing fn main()" }
    }
    let main_index = cg_fn_index(fns, "main")
    if fns[main_index].params.len() != 0 {
        return CgResult { ir: "", error: "main must take no parameters" }
    }
    var out = "; generated by Nova codegen (CODEGEN-01.01)\n"
    out = out + "%nova.string = type { ptr, i64 }\n"
    out = out + "%nova.list = type { ptr, i64, i64 }\n"
    out = out + "declare void @llvm.trap()\n"
    out = out + "declare ptr @malloc(i64)\n"
    out = out + "declare ptr @realloc(ptr, i64)\n"
    var emitted = 0
    while emitted < fns.len() {
        let sig = fns[emitted]
        let function = cg_emit_fn(ast, fns, sig)
        if function.error.len() > 0 {
            return CgResult { ir: "", error: function.error }
        }
        out = out + function.ir + "\n"
        emitted = emitted + 1
    }
    out = out + "define i32 @main() {\n"
    if fns[main_index].ret == "Unit" {
        out = out + "  call void @nova_user_" + fns[main_index].index.to_string() + "(ptr null)\n"
        out = out + "  ret i32 0\n"
    } else if fns[main_index].ret == "String" {
        out = out + "  %nova_result = call %nova.string @nova_user_" + fns[main_index].index.to_string() + "(ptr null)\n"
        out = out + "  ret i32 0\n"
    } else if fns[main_index].ret == "List<Int>" {
        out = out + "  %nova_result = call %nova.list @nova_user_" + fns[main_index].index.to_string() + "(ptr null)\n"
        out = out + "  ret i32 0\n"
    } else {
        out = out + "  %nova_result = call i64 @nova_user_" + fns[main_index].index.to_string() + "(ptr null)\n"
        out = out + "  %nova_exit = trunc i64 %nova_result to i32\n"
        out = out + "  ret i32 %nova_exit\n"
    }
    out = out + "}\n"
    return CgResult { ir: out, error: "" }
}

fn cg_emit_fn(ast: Ast, fns: List<CgSig>, sig: CgSig) -> CgResult {
    var state = CgState {
        lines: [],
        temps: 0,
        slots: 0,
        locals: [],
        fns: fns,
        globals: [],
        strings: 0,
        fn_index: sig.index,
        ret: sig.ret,
        terminated: false,
        error: "",
    }
    var i = 0
    while i < sig.params.len() {
        // Parameters are immutable Nova values: keep them in SSA instead of
        // spilling to the stack.
        var locals = state.locals
        locals.push(CgLocal { name: sig.params[i], ty: cg_llvm_type(sig.param_types[i]), slot: "", value: "%p" + i.to_string(), mutable: false })
        state = cg_state(state, state.lines, state.temps, state.slots, locals, state.terminated, state.error)
        i = i + 1
    }
    state = cg_block(ast, state, sig.body)
    if state.error.len() > 0 {
        return CgResult { ir: "", error: state.error }
    }
    if !state.terminated {
        if sig.ret == "Unit" {
            state = cg_line(state, "  ret void")
            state = cg_state(state, state.lines, state.temps, state.slots, state.locals, true, state.error)
        } else {
            return CgResult { ir: "", error: "function " + sig.name + " does not end with return" }
        }
    }
    let symbol = "nova_user_" + sig.index.to_string()
    let ret_llvm = cg_llvm_type(sig.ret)
    var text = ""
    for global in state.globals {
        text = text + global + "\n"
    }
    text = text + "define " + ret_llvm + " @" + symbol + "(ptr %arg_env"
    var k = 0
    while k < sig.params.len() {
        text = text + ", " + cg_llvm_type(sig.param_types[k]) + " %p" + k.to_string()
        k = k + 1
    }
    text = text + ") {\n"
    for line in state.lines {
        text = text + line + "\n"
    }
    text = text + "}"
    return CgResult { ir: text, error: "" }
}

fn cg_block(ast: Ast, state: CgState, node: Int) -> CgState {
    var work = state
    var i = 0
    while i < ast.nodes[node].count && !work.terminated && work.error.len() == 0 {
        work = cg_stmt(ast, work, a_child(ast, node, i))
        i = i + 1
    }
    return work
}

fn cg_if(ast: Ast, state: CgState, node: Int) -> CgState {
    let item = ast.nodes[node]
    let cond = cg_expr2(ast, state, a_child(ast, node, 0))
    if cond.state.error.len() > 0 {
        return cond.state
    }
    if cond.ty != "i1" {
        return cg_error(cond.state, "if condition must be Bool")
    }
    var work = cond.state
    let then_result = cg_label(work)
    work = then_result.0
    let then_label = then_result.1
    let else_result = cg_label(work)
    work = else_result.0
    let else_label = else_result.1
    let end_result = cg_label(work)
    work = end_result.0
    let end_label = end_result.1
    work = cg_line(work, "  br i1 " + cond.value + ", label %" + then_label + ", label %" + else_label)
    work = cg_state(work, work.lines, work.temps, work.slots, work.locals, false, work.error)
    work = cg_line(work, then_label + ":")
    let then_state = cg_block(ast, work, a_child(ast, node, 1))
    let then_terminated = then_state.terminated
    work = cg_state(then_state, then_state.lines, then_state.temps, then_state.slots, then_state.locals, false, then_state.error)
    if !then_terminated {
        work = cg_line(work, "  br label %" + end_label)
    }
    work = cg_line(work, else_label + ":")
    var else_terminated = false
    if item.count > 2 {
        let other = a_child(ast, node, 2)
        if ast.nodes[other].kind == ak_if() {
            let nested = cg_stmt(ast, work, other)
            else_terminated = nested.terminated
            work = cg_state(nested, nested.lines, nested.temps, nested.slots, nested.locals, false, nested.error)
        } else {
            let nested = cg_block(ast, work, other)
            else_terminated = nested.terminated
            work = cg_state(nested, nested.lines, nested.temps, nested.slots, nested.locals, false, nested.error)
        }
        if !else_terminated {
            work = cg_line(work, "  br label %" + end_label)
        }
    } else {
        work = cg_line(work, "  br label %" + end_label)
    }
    if then_terminated && else_terminated {
        return cg_state(work, work.lines, work.temps, work.slots, work.locals, true, work.error)
    }
    work = cg_line(work, end_label + ":")
    return cg_state(work, work.lines, work.temps, work.slots, work.locals, false, work.error)
}

fn cg_while(ast: Ast, state: CgState, node: Int) -> CgState {
    let item = ast.nodes[node]
    let header_result = cg_label(state)
    var work = header_result.0
    let header = header_result.1
    let body_result = cg_label(work)
    work = body_result.0
    let body = body_result.1
    let end_result = cg_label(work)
    work = end_result.0
    let end_label = end_result.1
    work = cg_line(work, "  br label %" + header)
    work = cg_line(work, header + ":")
    let cond = cg_expr2(ast, work, a_child(ast, node, 0))
    if cond.state.error.len() > 0 {
        return cond.state
    }
    if cond.ty != "i1" {
        return cg_error(cond.state, "while condition must be Bool")
    }
    work = cg_line(cond.state, "  br i1 " + cond.value + ", label %" + body + ", label %" + end_label)
    work = cg_line(work, body + ":")
    let body_state = cg_block(ast, work, a_child(ast, node, 1))
    if !body_state.terminated {
        work = cg_line(body_state, "  br label %" + header)
    } else {
        work = body_state
    }
    work = cg_line(work, end_label + ":")
    return cg_state(work, work.lines, work.temps, work.slots, work.locals, false, work.error)
}

fn cg_stmt(ast: Ast, state: CgState, node: Int) -> CgState {
    let item = ast.nodes[node]
    if item.kind == ak_if() {
        return cg_if(ast, state, node)
    }
    if item.kind == ak_while() {
        return cg_while(ast, state, node)
    }
    if item.kind == ak_let() || item.kind == ak_var() {
        let value = cg_expr2(ast, state, a_child(ast, node, 0))
        var work = value.state
        if value.ty == "void" {
            return cg_error(work, "cannot bind a Unit value")
        }
        if item.kind == ak_let() {
            // Immutable bindings can name the SSA value directly.
            var locals = work.locals
            locals.push(CgLocal { name: item.text, ty: value.ty, slot: "", value: value.value, mutable: false })
            return cg_state(work, work.lines, work.temps, work.slots, locals, work.terminated, work.error)
        }
        let slot_result = cg_slot(work)
        work = slot_result.0
        let slot = slot_result.1
        work = cg_line(work, "  " + slot + " = alloca " + value.ty)
        work = cg_line(work, "  store " + value.ty + " " + value.value + ", ptr " + slot)
        var locals = work.locals
        locals.push(CgLocal { name: item.text, ty: value.ty, slot: slot, value: "", mutable: true })
        return cg_state(work, work.lines, work.temps, work.slots, locals, work.terminated, work.error)
    }
    if item.kind == ak_return() {
        if item.count == 0 {
            if state.ret != "Unit" {
                return cg_error(state, "return needs a value")
            }
            let work = cg_line(state, "  ret void")
            return cg_state(work, work.lines, work.temps, work.slots, work.locals, true, work.error)
        }
        let value = cg_expr2(ast, state, a_child(ast, node, 0))
        var work = value.state
        if state.ret == "Unit" {
            return cg_error(work, "Unit function cannot return a value")
        }
        let expected = cg_llvm_type(state.ret)
        if value.ty != expected {
            return cg_error(work, "return type mismatch")
        }
        work = cg_line(work, "  ret " + expected + " " + value.value)
        return cg_state(work, work.lines, work.temps, work.slots, work.locals, true, work.error)
    }
    if item.kind == ak_expr_stmt() {
        let value = cg_expr2(ast, state, a_child(ast, node, 0))
        return value.state
    }
    if item.kind == ak_block() {
        return cg_block(ast, state, node)
    }
    return cg_error(state, "unsupported statement")
}

fn cg_expr2(ast: Ast, state: CgState, node: Int) -> CgVal {
    if state.error.len() > 0 {
        return cg_val(state, "0")
    }
    if node < 0 || node >= ast.nodes.len() {
        return cg_val(cg_error(state, "invalid expression node"), "0")
    }
    let item = ast.nodes[node]
    if item.kind == ak_number() {
        let number = cg_number(item.text)
        if number.len() == 0 {
            return cg_val(cg_error(state, "unsupported number " + item.text), "0")
        }
        return cg_val(state, number)
    }
    if item.kind == ak_string() {
        return cg_string_lit(state, item.text)
    }
    if item.kind == ak_list() {
        return cg_list_lit(ast, state, node)
    }
    if item.kind == ak_index() {
        return cg_index(ast, state, node)
    }
    if item.kind == ak_ident() {
        let index = cg_local_index(state.locals, item.text)
        if index < 0 {
            return cg_val(cg_error(state, "unknown local " + item.text), "0")
        }
        if state.locals[index].value.len() > 0 {
            return cg_val_typed(state, state.locals[index].value, state.locals[index].ty)
        }
        let temp_result = cg_temp(state)
        var work = temp_result.0
        let temp = temp_result.1
        work = cg_line(work, "  " + temp + " = load " + state.locals[index].ty + ", ptr " + state.locals[index].slot)
        return cg_val_typed(work, temp, state.locals[index].ty)
    }
    if item.kind == ak_unary() {
        let value = cg_expr2(ast, state, a_child(ast, node, 0))
        if item.text != "-" {
            return cg_val(cg_error(value.state, "unsupported unary operator " + item.text), "0")
        }
        let temp_result = cg_temp(value.state)
        var work = temp_result.0
        let temp = temp_result.1
        work = cg_line(work, "  " + temp + " = sub i64 0, " + value.value)
        return cg_val(work, temp)
    }
    if item.kind == ak_binary() {
        let op = item.text
        if op == "=" {
            let left = a_child(ast, node, 0)
            if left >= 0 && ast.nodes[left].kind == ak_index() {
                return cg_index_assign(ast, state, left, a_child(ast, node, 1))
            }
            if left < 0 || ast.nodes[left].kind != ak_ident() {
                return cg_val(cg_error(state, "assignment target is not a local"), "0")
            }
            let index = cg_local_index(state.locals, ast.nodes[left].text)
            if index < 0 {
                return cg_val(cg_error(state, "unknown local " + ast.nodes[left].text), "0")
            }
            if !state.locals[index].mutable {
                return cg_val(cg_error(state, "cannot assign to immutable binding " + ast.nodes[left].text), "0")
            }
            let value = cg_expr2(ast, state, a_child(ast, node, 1))
            if value.ty != state.locals[index].ty {
                return cg_val(cg_error(value.state, "assignment type mismatch"), "0")
            }
            let work = cg_line(value.state, "  store " + value.ty + " " + value.value + ", ptr " + state.locals[index].slot)
            return cg_val_typed(work, value.value, value.ty)
        }
        if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
            let left = cg_expr2(ast, state, a_child(ast, node, 0))
            let right = cg_expr2(ast, left.state, a_child(ast, node, 1))
            if left.ty != "i64" || right.ty != "i64" {
                return cg_val(cg_error(right.state, "comparison operands must be Int"), "0")
            }
            var pred = "eq"
            if op == "!=" {
                pred = "ne"
            } else if op == "<" {
                pred = "slt"
            } else if op == "<=" {
                pred = "sle"
            } else if op == ">" {
                pred = "sgt"
            } else if op == ">=" {
                pred = "sge"
            }
            let temp_result = cg_temp(right.state)
            var work = temp_result.0
            let temp = temp_result.1
            work = cg_line(work, "  " + temp + " = icmp " + pred + " i64 " + left.value + ", " + right.value)
            return cg_val_typed(work, temp, "i1")
        }
        let left = cg_expr2(ast, state, a_child(ast, node, 0))
        let right = cg_expr2(ast, left.state, a_child(ast, node, 1))
        var opcode = ""
        if op == "+" {
            opcode = "add"
        } else if op == "-" {
            opcode = "sub"
        } else if op == "*" {
            opcode = "mul"
        } else if op == "/" {
            opcode = "sdiv"
        } else {
            return cg_val(cg_error(right.state, "unsupported operator " + op), "0")
        }
        let temp_result = cg_temp(right.state)
        var work = temp_result.0
        let temp = temp_result.1
        work = cg_line(work, "  " + temp + " = " + opcode + " i64 " + left.value + ", " + right.value)
        return cg_val(work, temp)
    }
    if item.kind == ak_call() {
        let callee = a_child(ast, node, 0)
        if callee >= 0 && ast.nodes[callee].kind == ak_member() {
            if ast.nodes[callee].text == "push" {
                return cg_list_push(ast, state, node)
            }
            if ast.nodes[callee].text != "len" {
                return cg_val(cg_error(state, "unsupported method " + ast.nodes[callee].text), "0")
            }
            let recv = cg_expr2(ast, state, a_child(ast, callee, 0))
            if recv.ty != "%nova.string" && recv.ty != "%nova.list" {
                return cg_val(cg_error(recv.state, "len() expects String or List"), "0")
            }
            let temp_result = cg_temp(recv.state)
            var work = temp_result.0
            let temp = temp_result.1
            work = cg_line(work, "  " + temp + " = extractvalue " + recv.ty + " " + recv.value + ", 1")
            return cg_val(work, temp)
        }
        if callee < 0 || ast.nodes[callee].kind != ak_ident() {
            return cg_val(cg_error(state, "only direct function calls are supported"), "0")
        }
        let name = ast.nodes[callee].text
        let index = cg_fn_index(state.fns, name)
        if index < 0 {
            return cg_val(cg_error(state, "unknown function " + name), "0")
        }
        let sig = state.fns[index]
        let got = ast.nodes[node].count - 1
        if got != sig.params.len() {
            return cg_val(cg_error(state, name + " arity mismatch"), "0")
        }
        var work = state
        var args = ""
        var k = 0
        while k < got {
            let arg = cg_expr2(ast, work, a_child(ast, node, k + 1))
            work = arg.state
            let expected = cg_llvm_type(sig.param_types[k])
            if arg.ty != expected {
                return cg_val(cg_error(work, name + " argument " + k.to_string() + " type mismatch"), "0")
            }
            if k > 0 {
                args = args + ", "
            }
            args = args + expected + " " + arg.value
            k = k + 1
        }
        let symbol = "nova_user_" + sig.index.to_string()
        var call_args = "ptr null"
        if args.len() > 0 {
            call_args = call_args + ", " + args
        }
        let ret_ty = cg_llvm_type(sig.ret)
        if ret_ty == "void" {
            work = cg_line(work, "  call void @" + symbol + "(" + call_args + ")")
            return cg_val_typed(work, "", "void")
        }
        let temp_result = cg_temp(work)
        work = temp_result.0
        let temp = temp_result.1
        work = cg_line(work, "  " + temp + " = call " + ret_ty + " @" + symbol + "(" + call_args + ")")
        return cg_val_typed(work, temp, ret_ty)
    }
    return cg_val(cg_error(state, "unsupported expression"), "0")
}
