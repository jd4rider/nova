// Nova LLVM IR lowering.
//
// Scope: Int, Bool, Unit and String functions; let/var; integer, string, list,
// struct and enum literals; String.len/concat/equality and String match;
// runtime-linked list indexing, index assignment and push; struct field reads
// and assignment; arithmetic;
// if/else/while/for with break/continue; direct calls; Int/Bool/enum match;
// seed-shaped ABI (`ptr %arg_env`, `nova_user_N`, `%nova.string`,
// `%nova.list`, `%nova.struct.*`, `%nova.enum.*`). Maps and the full runtime
// ABI are later tasks.
//
// Unsupported syntax returns an error instead of emitting guessed IR.

import "../../nova-parser/src/ast.nova"

extern "C" fn nova_ir_reset()
extern "C" fn nova_ir_line(text: String)
extern "C" fn nova_ir_take() -> String

struct CgSig {
    name: String,
    params: List<String>,
    param_types: List<String>,
    ret: String,
    body: Int,
    index: Int,
    external: Bool,
    captures: List<String>,
    capture_types: List<String>,
    closure: Bool,
}

struct CgLocal {
    name: String,
    ty: String,
    slot: String,
    value: String,
    mutable: Bool,
    elem: String,
    source: String,
}

struct CgStruct {
    name: String,
    fields: List<String>,
    types: List<String>,
    index: Int,
}

struct CgEnum {
    name: String,
    variants: List<String>,
    payload_types: List<String>,
    payload_counts: List<Int>,
    payload_offsets: List<Int>,
    index: Int,
}

struct CgState {
    lines: List<String>,
    entry: List<String>,
    temps: Int,
    slots: Int,
    locals: List<CgLocal>,
    fns: List<CgSig>,
    structs: List<CgStruct>,
    enums: List<CgEnum>,
    globals: List<String>,
    strings: Int,
    fn_index: Int,
    ret: String,
    terminated: Bool,
    error: String,
    breaks: List<String>,
    continues: List<String>,
}

struct CgVal {
    state: CgState,
    value: String,
    ty: String,
    elem: String,
    source: String,
}

struct CgResult {
    ir: String,
    error: String,
}

fn cg_state(
    state: CgState,
    lines: List<String>,
    temps: Int,
    slots: Int,
    locals: List<CgLocal>,
    terminated: Bool,
    error: String
) -> CgState {
    return CgState {
        lines: lines,
        entry: state.entry,
        temps: temps,
        slots: slots,
        locals: locals,
        fns: state.fns,
        structs: state.structs,
        enums: state.enums,
        globals: state.globals,
        strings: state.strings,
        fn_index: state.fn_index,
        ret: state.ret,
        terminated: terminated,
        error: error,
        breaks: state.breaks,
        continues: state.continues,
    }
}

fn cg_state_globals(state: CgState, globals: List<String>, strings: Int) -> CgState {
    return CgState {
        lines: state.lines,
        entry: state.entry,
        temps: state.temps,
        slots: state.slots,
        locals: state.locals,
        fns: state.fns,
        structs: state.structs,
        enums: state.enums,
        globals: globals,
        strings: strings,
        fn_index: state.fn_index,
        ret: state.ret,
        terminated: state.terminated,
        error: state.error,
        breaks: state.breaks,
        continues: state.continues,
    }
}

fn cg_loops_state(state: CgState, breaks: List<String>, continues: List<String>) -> CgState {
    return CgState {
        lines: state.lines,
        entry: state.entry,
        temps: state.temps,
        slots: state.slots,
        locals: state.locals,
        fns: state.fns,
        structs: state.structs,
        enums: state.enums,
        globals: state.globals,
        strings: state.strings,
        fn_index: state.fn_index,
        ret: state.ret,
        terminated: state.terminated,
        error: state.error,
        breaks: breaks,
        continues: continues,
    }
}

fn cg_loop_enter(state: CgState, break_label: String, continue_label: String) -> CgState {
    var breaks = state.breaks
    breaks.push(break_label)
    var continues = state.continues
    continues.push(continue_label)
    return cg_loops_state(state, breaks, continues)
}

fn cg_strings_before(items: List<String>, count: Int) -> List<String> {
    var out: List<String> = []
    var i = 0
    while i < count && i < items.len() {
        out.push(items[i])
        i = i + 1
    }
    return out
}

fn cg_locals_before(items: List<CgLocal>, count: Int) -> List<CgLocal> {
    var out: List<CgLocal> = []
    var i = 0
    while i < count && i < items.len() {
        out.push(items[i])
        i = i + 1
    }
    return out
}

fn cg_loop_exit(state: CgState) -> CgState {
    if state.breaks.len() == 0 {
        return state
    }
    let keep = state.breaks.len() - 1
    return cg_loops_state(
        state,
        cg_strings_before(state.breaks, keep),
        cg_strings_before(state.continues, keep)
    )
}

fn cg_loop_break(state: CgState) -> String {
    if state.breaks.len() == 0 {
        return ""
    }
    return state.breaks[state.breaks.len() - 1]
}

fn cg_loop_continue(state: CgState) -> String {
    if state.continues.len() == 0 {
        return ""
    }
    return state.continues[state.continues.len() - 1]
}

fn cg_is_fn_type(type_name: String) -> Bool {
    if !type_name.starts_with("fn(") || !type_name.contains(")->") {
        return false
    }
    return true
}

fn cg_fn_params(type_name: String) -> List<String> {
    if !cg_is_fn_type(type_name) {
        return []
    }
    let chars = type_name.chars()
    var start = 3
    var stop = -1
    var i = 0
    while i + 2 < chars.len() {
        if chars[i] == ")" && chars[i + 1] == "-" && chars[i + 2] == ">" {
            stop = i
            i = chars.len()
        } else {
            i = i + 1
        }
    }
    if stop < start {
        return []
    }
    return cg_split_types(lx_slice(chars, start, stop))
}

fn cg_fn_ret(type_name: String) -> String {
    if !cg_is_fn_type(type_name) {
        return ""
    }
    let chars = type_name.chars()
    var i = 0
    while i + 2 < chars.len() {
        if chars[i] == ")" && chars[i + 1] == "-" && chars[i + 2] == ">" {
            return lx_slice(chars, i + 3, chars.len())
        }
        i = i + 1
    }
    return ""
}

fn cg_llvm_type(type_name: String) -> String {
    if cg_is_fn_type(type_name) {
        return "%nova.fn"
    }
    if type_name == "String" {
        return "%nova.string"
    }
    if cg_is_map(type_name) || cg_is_set(type_name) {
        return "%nova.map"
    }
    if cg_is_list(type_name) {
        return "%nova.list"
    }
    if type_name == "Bool" {
        return "i1"
    }
    if type_name == "Unit" || type_name == "" {
        return "void"
    }
    return "i64"
}

fn cg_struct_index(structs: List<CgStruct>, name: String) -> Int {
    var i = 0
    while i < structs.len() {
        if structs[i].name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn cg_enum_index(enums: List<CgEnum>, name: String) -> Int {
    var i = 0
    while i < enums.len() {
        if enums[i].name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn cg_variant_index(item: CgEnum, name: String) -> Int {
    var i = 0
    while i < item.variants.len() {
        if item.variants[i] == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn cg_variant_payload_count(item: CgEnum, variant: Int) -> Int {
    if variant < 0 || variant >= item.payload_counts.len() {
        return 0
    }
    return item.payload_counts[variant]
}

fn cg_variant_payload_types(item: CgEnum, variant: Int) -> List<String> {
    var out: List<String> = []
    let count = cg_variant_payload_count(item, variant)
    var i = 0
    while i < count {
        out.push(cg_variant_payload_type(item, variant, i))
        i = i + 1
    }
    return out
}

fn cg_variant_payload_type(item: CgEnum, variant: Int, payload: Int) -> String {
    if variant < 0 || variant >= item.payload_offsets.len() {
        return ""
    }
    let slot = item.payload_offsets[variant] + payload
    if slot < 0 || slot >= item.payload_types.len() {
        return ""
    }
    return item.payload_types[slot]
}

fn cg_type_slot_count(structs: List<CgStruct>, payload_ty: String) -> Int {
    if payload_ty == "String" {
        return 2
    }
    if cg_is_list(payload_ty) {
        return 3
    }
    let index = cg_struct_index(structs, payload_ty)
    if index >= 0 {
        var slots = 0
        for field_type in structs[index].types {
            slots = slots + cg_type_slot_count(structs, field_type)
        }
        return slots
    }
    return 1
}

fn cg_variant_slot_count(structs: List<CgStruct>, item: CgEnum, variant: Int) -> Int {
    var slots = 0
    var i = 0
    let count = cg_variant_payload_count(item, variant)
    while i < count {
        slots = slots + cg_type_slot_count(structs, cg_variant_payload_type(item, variant, i))
        i = i + 1
    }
    return slots
}

fn cg_enum_slot_count(structs: List<CgStruct>, item: CgEnum) -> Int {
    var max = 0
    var i = 0
    while i < item.variants.len() {
        let slots = cg_variant_slot_count(structs, item, i)
        if slots > max {
            max = slots
        }
        i = i + 1
    }
    return max
}

fn cg_pack_payload(
    state: CgState,
    aggregate: String,
    aggregate_ty: String,
    value: String,
    value_ty: String,
    type_name: String,
    slot: Int,
) -> (CgState, String, Int) {
    var work = state
    if type_name == "Bool" {
        if value_ty != "i1" {
            return (cg_error(work, "Bool payload expected i1"), aggregate, slot)
        }
        let wide_result = cg_temp(work)
        work = wide_result.0
        let wide = wide_result.1
        work = cg_line(work, "  " + wide + " = zext i1 " + value + " to i64")
        let next_result = cg_temp(work)
        work = next_result.0
        let next = next_result.1
        work = cg_line(work, "  " + next + " = insertvalue " + aggregate_ty + " " + aggregate + ", i64 " + wide + ", " + slot.to_string())
        return (work, next, slot + 1)
    }
    if type_name == "String" {
        if value_ty != "%nova.string" {
            return (cg_error(work, "String payload expected %nova.string"), aggregate, slot)
        }
        let ptr_result = cg_temp(work)
        work = ptr_result.0
        let ptr = ptr_result.1
        work = cg_line(work, "  " + ptr + " = extractvalue %nova.string " + value + ", 0")
        let ptr_int_result = cg_temp(work)
        work = ptr_int_result.0
        let ptr_int = ptr_int_result.1
        work = cg_line(work, "  " + ptr_int + " = ptrtoint ptr " + ptr + " to i64")
        let len_result = cg_temp(work)
        work = len_result.0
        let len = len_result.1
        work = cg_line(work, "  " + len + " = extractvalue %nova.string " + value + ", 1")
        let ptr_insert_result = cg_temp(work)
        work = ptr_insert_result.0
        let ptr_insert = ptr_insert_result.1
        work = cg_line(work, "  " + ptr_insert + " = insertvalue " + aggregate_ty + " " + aggregate + ", i64 " + ptr_int + ", " + slot.to_string())
        let len_insert_result = cg_temp(work)
        work = len_insert_result.0
        let len_insert = len_insert_result.1
        work = cg_line(work, "  " + len_insert + " = insertvalue " + aggregate_ty + " " + ptr_insert + ", i64 " + len + ", " + (slot + 1).to_string())
        return (work, len_insert, slot + 2)
    }
    if type_name == "Int" {
        if value_ty != "i64" {
            return (cg_error(work, "Int payload expected i64"), aggregate, slot)
        }
        let next_result = cg_temp(work)
        work = next_result.0
        let next = next_result.1
        work = cg_line(work, "  " + next + " = insertvalue " + aggregate_ty + " " + aggregate + ", i64 " + value + ", " + slot.to_string())
        return (work, next, slot + 1)
    }
    let struct_index = cg_struct_index(work.structs, type_name)
    if struct_index >= 0 {
        let def = work.structs[struct_index]
        if value_ty != "%nova.struct." + type_name {
            return (cg_error(work, "struct payload expected " + type_name), aggregate, slot)
        }
        var current = aggregate
        var next_slot = slot
        var field = 0
        while field < def.fields.len() {
            let field_result = cg_temp(work)
            work = field_result.0
            let field_value = field_result.1
            work = cg_line(work, "  " + field_value + " = extractvalue " + value_ty + " " + value + ", " + field.to_string())
            let field_ty = cg_llvm_type_in(work.structs, work.enums, def.types[field])
            let packed = cg_pack_payload(work, current, aggregate_ty, field_value, field_ty, def.types[field], next_slot)
            work = packed.0
            current = packed.1
            next_slot = packed.2
            if work.error.len() > 0 {
                return (work, current, next_slot)
            }
            field = field + 1
        }
        return (work, current, next_slot)
    }
    return (cg_error(work, "unsupported enum payload type " + type_name), aggregate, slot)
}

fn cg_unpack_payload(
    state: CgState,
    aggregate_ty: String,
    aggregate: String,
    type_name: String,
    slot: Int,
) -> (CgState, String, String, Int) {
    var work = state
    if type_name == "Bool" {
        let raw_result = cg_temp(work)
        work = raw_result.0
        let raw = raw_result.1
        work = cg_line(work, "  " + raw + " = extractvalue " + aggregate_ty + " " + aggregate + ", " + slot.to_string())
        let narrow_result = cg_temp(work)
        work = narrow_result.0
        let narrow = narrow_result.1
        work = cg_line(work, "  " + narrow + " = trunc i64 " + raw + " to i1")
        return (work, narrow, "i1", slot + 1)
    }
    if type_name == "String" {
        let ptr_bits_result = cg_temp(work)
        work = ptr_bits_result.0
        let ptr_bits = ptr_bits_result.1
        work = cg_line(work, "  " + ptr_bits + " = extractvalue " + aggregate_ty + " " + aggregate + ", " + slot.to_string())
        let ptr_result = cg_temp(work)
        work = ptr_result.0
        let ptr = ptr_result.1
        work = cg_line(work, "  " + ptr + " = inttoptr i64 " + ptr_bits + " to ptr")
        let len_result = cg_temp(work)
        work = len_result.0
        let len = len_result.1
        work = cg_line(work, "  " + len + " = extractvalue " + aggregate_ty + " " + aggregate + ", " + (slot + 1).to_string())
        let empty_result = cg_temp(work)
        work = empty_result.0
        let empty = empty_result.1
        work = cg_line(work, "  " + empty + " = insertvalue %nova.string undef, ptr " + ptr + ", 0")
        let full_result = cg_temp(work)
        work = full_result.0
        let full = full_result.1
        work = cg_line(work, "  " + full + " = insertvalue %nova.string " + empty + ", i64 " + len + ", 1")
        return (work, full, "%nova.string", slot + 2)
    }
    if type_name == "Int" {
        let raw_result = cg_temp(work)
        work = raw_result.0
        let raw = raw_result.1
        work = cg_line(work, "  " + raw + " = extractvalue " + aggregate_ty + " " + aggregate + ", " + slot.to_string())
        return (work, raw, "i64", slot + 1)
    }
    let struct_index = cg_struct_index(work.structs, type_name)
    if struct_index >= 0 {
        let def = work.structs[struct_index]
        var current = "undef"
        var next_slot = slot
        var field = 0
        while field < def.fields.len() {
            let unpacked = cg_unpack_payload(work, aggregate_ty, aggregate, def.types[field], next_slot)
            work = unpacked.0
            let field_value = unpacked.1
            let field_ty = cg_llvm_type_in(work.structs, work.enums, def.types[field])
            next_slot = unpacked.3
            let insert_result = cg_temp(work)
            work = insert_result.0
            let inserted = insert_result.1
            let struct_ty = "%nova.struct." + type_name
            work = cg_line(work, "  " + inserted + " = insertvalue " + struct_ty + " " + current + ", " + field_ty + " " + field_value + ", " + field.to_string())
            current = inserted
            if work.error.len() > 0 {
                return (work, current, "%nova.struct." + type_name, next_slot)
            }
            field = field + 1
        }
        return (work, current, "%nova.struct." + type_name, next_slot)
    }
    return (cg_error(work, "unsupported enum payload type " + type_name), "0", "i64", slot)
}

fn cg_enum_by_llvm(enums: List<CgEnum>, ty: String) -> Int {
    var i = 0
    while i < enums.len() {
        if "%nova.enum." + enums[i].name == ty {
            return i
        }
        i = i + 1
    }
    return -1
}

fn cg_llvm_type_in(structs: List<CgStruct>, enums: List<CgEnum>, type_name: String) -> String {
    if cg_is_fn_type(type_name) {
        return "%nova.fn"
    }
    if cg_is_map(type_name) || cg_is_set(type_name) {
        return "%nova.map"
    }
    if cg_is_slice(type_name) {
        return "%nova.slice"
    }
    let option_inner = cg_option_inner(type_name)
    if option_inner.len() > 0 {
        return "{ i1, " + cg_llvm_type_in(structs, enums, option_inner) + " }"
    }
    let result_ok = cg_result_ok(type_name)
    let result_err = cg_result_err(type_name)
    if result_ok.len() > 0 && result_err.len() > 0 {
        return "{ i1, " + cg_llvm_type_in(structs, enums, result_ok) + ", " + cg_llvm_type_in(structs, enums, result_err) + " }"
    }
    let array = cg_array_layout(type_name)
    if array.1 >= 0 {
        return "[" + array.1.to_string() + " x " + cg_llvm_type_in(structs, enums, array.0) + "]"
    }
    if cg_is_tuple(type_name) {
        let parts = cg_split_types(cg_tuple_inner(type_name))
        var out = "{ "
        var i = 0
        while i < parts.len() {
            if i > 0 {
                out = out + ", "
            }
            out = out + cg_llvm_type_in(structs, enums, parts[i].trim())
            i = i + 1
        }
        return out + " }"
    }
    if cg_struct_index(structs, type_name) >= 0 {
        return "%nova.struct." + type_name
    }
    if cg_enum_index(enums, type_name) >= 0 {
        return "%nova.enum." + type_name
    }
    return cg_llvm_type(type_name)
}

fn cg_supported_type(structs: List<CgStruct>, enums: List<CgEnum>, type_name: String) -> Bool {
    if type_name == "Int" || type_name == "Bool" || type_name == "String" || type_name == "Unit" {
        return true
    }
    if cg_is_fn_type(type_name) {
        let params = cg_fn_params(type_name)
        let ret = cg_fn_ret(type_name)
        if ret.len() == 0 {
            return false
        }
        for param in params {
            if !cg_supported_type(structs, enums, param) {
                return false
            }
        }
        return cg_supported_type(structs, enums, ret)
    }
    if cg_is_list(type_name) {
        let element = cg_list_elem(type_name)
        return element.len() > 0 && cg_supported_type(structs, enums, element)
    }
    if cg_is_slice(type_name) {
        let element = cg_slice_elem(type_name)
        return element.len() > 0 && cg_supported_type(structs, enums, element)
    }
    if cg_is_map(type_name) {
        let key = cg_map_key(type_name)
        let value = cg_map_value(type_name)
        return cg_map_key_kind(key).len() > 0 && cg_supported_type(structs, enums, key) && cg_supported_type(structs, enums, value)
    }
    if cg_is_set(type_name) {
        let element = cg_set_elem(type_name)
        return cg_map_key_kind(element).len() > 0 && cg_supported_type(structs, enums, element)
    }
    let option_inner = cg_option_inner(type_name)
    if option_inner.len() > 0 {
        return cg_supported_type(structs, enums, option_inner)
    }
    let result_ok = cg_result_ok(type_name)
    let result_err = cg_result_err(type_name)
    if result_ok.len() > 0 && result_err.len() > 0 {
        return cg_supported_type(structs, enums, result_ok) && cg_supported_type(structs, enums, result_err)
    }
    let array = cg_array_layout(type_name)
    if array.1 >= 0 {
        return cg_supported_type(structs, enums, array.0)
    }
    if cg_is_tuple(type_name) {
        let parts = cg_split_types(cg_tuple_inner(type_name))
        if parts.len() == 0 {
            return false
        }
        for part in parts {
            if !cg_supported_type(structs, enums, part.trim()) {
                return false
            }
        }
        return true
    }
    if cg_struct_index(structs, type_name) >= 0 {
        return true
    }
    return cg_enum_index(enums, type_name) >= 0
}

fn cg_sig_symbol(sig: CgSig) -> String {
    if sig.closure || sig.name.starts_with("__fnref_") {
        return sig.name
    }
    return "nova_user_" + sig.index.to_string()
}

fn cg_align_up(value: Int, align: Int) -> Int {
    if align <= 1 {
        return value
    }
    let rem = value % align
    if rem == 0 {
        return value
    }
    return value + align - rem
}

fn cg_type_size_align(structs: List<CgStruct>, enums: List<CgEnum>, type_name: String) -> (Int, Int) {
    if type_name == "Bool" {
        return (1, 1)
    }
    if type_name == "String" {
        return (16, 8)
    }
    if cg_is_list(type_name) {
        return (24, 8)
    }
    if cg_is_slice(type_name) {
        return (16, 8)
    }
    if cg_is_map(type_name) || cg_is_set(type_name) {
        return (40, 8)
    }
    if cg_is_fn_type(type_name) {
        return (16, 8)
    }
    let option_inner = cg_option_inner(type_name)
    if option_inner.len() > 0 {
        let inner = cg_type_size_align(structs, enums, option_inner)
        return (cg_align_up(8, inner.1) + inner.0, inner.1)
    }
    let result_ok = cg_result_ok(type_name)
    let result_err = cg_result_err(type_name)
    if result_ok.len() > 0 && result_err.len() > 0 {
        let ok = cg_type_size_align(structs, enums, result_ok)
        let err = cg_type_size_align(structs, enums, result_err)
        let size = cg_align_up(8, ok.1) + ok.0 + cg_align_up(err.0, err.1)
        return (size, 8)
    }
    let array = cg_array_layout(type_name)
    if array.1 >= 0 {
        let elem = cg_type_size_align(structs, enums, array.0)
        return (elem.0 * array.1, elem.1)
    }
    if cg_is_tuple(type_name) {
        let parts = cg_split_types(cg_tuple_inner(type_name))
        var offset = 0
        var align = 1
        for part in parts {
            let field = cg_type_size_align(structs, enums, part.trim())
            offset = cg_align_up(offset, field.1) + field.0
            align = if field.1 > align { field.1 } else { align }
        }
        return (cg_align_up(offset, align), align)
    }
    let struct_index = cg_struct_index(structs, type_name)
    if struct_index >= 0 {
        var offset = 0
        var align = 1
        var i = 0
        while i < structs[struct_index].types.len() {
            let field = cg_type_size_align(structs, enums, structs[struct_index].types[i])
            offset = cg_align_up(offset, field.1) + field.0
            align = if field.1 > align { field.1 } else { align }
            i = i + 1
        }
        return (cg_align_up(offset, align), align)
    }
    let enum_index = cg_enum_index(enums, type_name)
    if enum_index >= 0 {
        return (8 + 8 * cg_enum_slot_count(structs, enums[enum_index]), 8)
    }
    return (8, 8)
}

fn cg_capture_layout(structs: List<CgStruct>, enums: List<CgEnum>, types: List<String>) -> (List<Int>, Int) {
    var offsets: List<Int> = []
    var offset = 0
    var align = 1
    for type_name in types {
        let info = cg_type_size_align(structs, enums, type_name)
        offset = cg_align_up(offset, info.1)
        offsets.push(offset)
        offset = offset + info.0
        if info.1 > align {
            align = info.1
        }
    }
    return (offsets, cg_align_up(offset, align))
}

fn cg_find_return(ast: Ast, node: Int) -> Int {
    if node < 0 || node >= ast.nodes.len() {
        return -1
    }
    let item = ast.nodes[node]
    if item.kind == ak_closure() {
        return -1
    }
    if item.kind == ak_return() && item.count > 0 {
        return a_child(ast, node, 0)
    }
    var i = 0
    while i < item.count {
        let found = cg_find_return(ast, a_child(ast, node, i))
        if found >= 0 {
            return found
        }
        i = i + 1
    }
    return -1
}

fn cg_guess_type(ast: Ast, state: CgState, node: Int) -> String {
    if node < 0 || node >= ast.nodes.len() {
        return "?"
    }
    let item = ast.nodes[node]
    if item.kind == ak_number() {
        return "Int"
    }
    if item.kind == ak_string() || item.kind == ak_interp() || item.kind == ak_str_part() {
        return "String"
    }
    if item.kind == ak_bool() {
        return "Bool"
    }
    if item.kind == ak_ident() {
        let index = cg_local_index(state.locals, item.text)
        if index >= 0 {
            return state.locals[index].source
        }
        return "?"
    }
    if item.kind == ak_unary() {
        return cg_guess_type(ast, state, a_child(ast, node, 0))
    }
    if item.kind == ak_binary() {
        let op = item.text
        if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" || op == "&&" || op == "||" {
            return "Bool"
        }
        if op == "+" {
            let left = cg_guess_type(ast, state, a_child(ast, node, 0))
            if left == "String" || left.starts_with("List<") {
                return left
            }
        }
        if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
            return "Int"
        }
        if op == ".." {
            return "Range"
        }
        return "?"
    }
    if item.kind == ak_call() {
        let callee = a_child(ast, node, 0)
        if callee >= 0 {
            let callee_item = ast.nodes[callee]
            if callee_item.kind == ak_ident() {
                let local = cg_local_index(state.locals, callee_item.text)
                if local >= 0 && cg_is_fn_type(state.locals[local].source) {
                    return cg_fn_ret(state.locals[local].source)
                }
                let index = cg_fn_index(state.fns, callee_item.text)
                if index >= 0 {
                    return state.fns[index].ret
                }
            }
            if callee_item.kind == ak_member() {
                let receiver = cg_guess_type(ast, state, a_child(ast, callee, 0))
                let index = cg_fn_index(state.fns, receiver + "." + callee_item.text)
                if index >= 0 {
                    return state.fns[index].ret
                }
            }
        }
        return "?"
    }
    if item.kind == ak_member() {
        let receiver = cg_guess_type(ast, state, a_child(ast, node, 0))
        let index = cg_struct_index(state.structs, receiver)
        if index >= 0 {
            let field = cg_field_index(state.structs[index], item.text)
            if field >= 0 {
                return state.structs[index].types[field]
            }
        }
        return "?"
    }
    if item.kind == ak_struct_lit() {
        return item.text
    }
    if item.kind == ak_list() {
        if item.count == 0 {
            return "List<?>"
        }
        return "List<" + cg_guess_type(ast, state, a_child(ast, node, 0)) + ">"
    }
    if item.kind == ak_tuple() {
        var text = "("
        var i = 0
        while i < item.count {
            if i > 0 {
                text = text + ","
            }
            text = text + cg_guess_type(ast, state, a_child(ast, node, i))
            i = i + 1
        }
        return text + ")"
    }
    return "?"
}

fn cg_closure_sig(ast: Ast, state: CgState, node: Int) -> CgSig {
    let item = ast.nodes[node]
    var params: List<String> = []
    var param_types: List<String> = []
    var i = 0
    while i < item.count - 1 {
        let param = ast.nodes[a_child(ast, node, i)]
        params.push(param.text)
        param_types.push(param.aux)
        i = i + 1
    }
    var ret = item.aux
    if ret.len() == 0 {
        let returned = cg_find_return(ast, a_child(ast, node, item.count - 1))
        if returned >= 0 {
            ret = cg_guess_type(ast, state, returned)
        } else {
            ret = "Unit"
        }
    }
    var captures: List<String> = []
    var capture_types: List<String> = []
    i = 0
    while i < state.locals.len() {
        let local = state.locals[i]
        if !cg_has_name(captures, local.name) && !cg_has_name(params, local.name) {
            captures.push(local.name)
            capture_types.push(local.source)
        }
        i = i + 1
    }
    return CgSig {
        name: "__closure_" + node.to_string(),
        params: params,
        param_types: param_types,
        ret: ret,
        body: a_child(ast, node, item.count - 1),
        index: 100000 + node,
        external: false,
        captures: captures,
        capture_types: capture_types,
        closure: true,
    }
}

fn cg_emit_closure(ast: Ast, state: CgState, sig: CgSig) -> CgResult {
    var fns = state.fns
    fns.push(sig)
    return cg_emit_fn(ast, fns, state.structs, state.enums, sig)
}

fn cg_has_name(names: List<String>, name: String) -> Bool {
    for existing in names {
        if existing == name {
            return true
        }
    }
    return false
}

fn cg_struct_cycle(structs: List<CgStruct>, target: String, current: String, seen: List<String>) -> Bool {
    let index = cg_struct_index(structs, current)
    if index < 0 {
        return false
    }
    for field_type in structs[index].types {
        if field_type == target {
            return true
        }
        if cg_struct_index(structs, field_type) >= 0 && !cg_has_name(seen, field_type) {
            var next: List<String> = []
            for name in seen {
                next.push(name)
            }
            next.push(field_type)
            if cg_struct_cycle(structs, target, field_type, next) {
                return true
            }
        }
    }
    return false
}

fn cg_struct_by_llvm(structs: List<CgStruct>, ty: String) -> Int {
    var i = 0
    while i < structs.len() {
        if "%nova.struct." + structs[i].name == ty {
            return i
        }
        i = i + 1
    }
    return -1
}

fn cg_field_index(item: CgStruct, name: String) -> Int {
    var i = 0
    while i < item.fields.len() {
        if item.fields[i] == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn cg_is_tuple(type_name: String) -> Bool {
    return type_name.starts_with("(") && type_name.ends_with(")")
}

fn cg_tuple_inner(type_name: String) -> String {
    if !cg_is_tuple(type_name) {
        return ""
    }
    return lx_slice(type_name.chars(), 1, type_name.len() - 1)
}

fn cg_llvm_tuple_fields(ty: String) -> List<String> {
    var inner = ty.trim()
    if inner.starts_with("{") {
        inner = lx_slice(inner.chars(), 1, inner.len() - 1)
    }
    var out: List<String> = []
    var current = ""
    var depth = 0
    for c in inner.chars() {
        if c == "{" || c == "<" || c == "(" || c == "[" {
            depth = depth + 1
            current = current + c
        } else if c == "}" || c == ">" || c == ")" || c == "]" {
            depth = depth - 1
            current = current + c
        } else if c == "," && depth == 0 {
            out.push(current.trim())
            current = ""
        } else {
            current = current + c
        }
    }
    if current.trim().len() > 0 {
        out.push(current.trim())
    }
    return out
}

fn cg_llvm_tuple_field(ty: String, index: Int) -> String {
    let fields = cg_llvm_tuple_fields(ty)
    if index < 0 || index >= fields.len() {
        return "i64"
    }
    return fields[index]
}

fn cg_tuple_index(text: String) -> Int {
    var value = 0
    for c in text.chars() {
        var digit = 0 - 1
        if c == "0" {
            digit = 0
        } else if c == "1" {
            digit = 1
        } else if c == "2" {
            digit = 2
        } else if c == "3" {
            digit = 3
        } else if c == "4" {
            digit = 4
        } else if c == "5" {
            digit = 5
        } else if c == "6" {
            digit = 6
        } else if c == "7" {
            digit = 7
        } else if c == "8" {
            digit = 8
        } else if c == "9" {
            digit = 9
        }
        if digit < 0 {
            return 0 - 1
        }
        value = value * 10 + digit
    }
    return value
}

fn cg_split_types(text: String) -> List<String> {
    var out: List<String> = []
    if text.len() == 0 {
        return out
    }
    var current = ""
    var depth = 0
    for c in text.chars() {
        if c == "<" {
            depth = depth + 1
            current = current + c
        } else if c == ">" {
            depth = depth - 1
            current = current + c
        } else if c == "," && depth == 0 {
            if current.len() > 0 {
                out.push(current)
            }
            current = ""
        } else {
            current = current + c
        }
    }
    if current.len() > 0 {
        out.push(current)
    }
    return out
}

fn cg_find_variant(enums: List<CgEnum>, name: String) -> (Int, Int) {
    var i = 0
    while i < enums.len() {
        let variant = cg_variant_index(enums[i], name)
        if variant >= 0 {
            return (i, variant)
        }
        i = i + 1
    }
    return (0 - 1, 0 - 1)
}

fn cg_pattern_variant(pattern: String) -> String {
    var out = ""
    for c in pattern.chars() {
        if c == "(" {
            return out
        }
        out = out + c
    }
    return out
}

fn cg_pattern_payload(pattern: String) -> String {
    var out = ""
    var started = false
    for c in pattern.chars() {
        if c == ")" && started {
            return out
        }
        if started {
            out = out + c
        } else if c == "(" {
            started = true
        }
    }
    return out
}

fn cg_pattern_args(pattern: String) -> List<String> {
    var out: List<String> = []
    let payload = cg_pattern_payload(pattern)
    if payload.len() == 0 {
        return out
    }
    var current = ""
    for c in payload.chars() {
        if c == "," {
            if current.len() > 0 {
                out.push(current)
            }
            current = ""
        } else {
            current = current + c
        }
    }
    if current.len() > 0 {
        out.push(current)
    }
    return out
}

fn cg_pattern_is_bare(text: String) -> Bool {
    if text.len() == 0 {
        return false
    }
    for c in text.chars() {
        if "()[]{}.,:<> \t\n".contains(c) {
            return false
        }
    }
    return true
}

fn cg_enum_make(state: CgState, enum_index: Int, variant: Int, values: List<CgVal>) -> CgVal {
    if enum_index < 0 || enum_index >= state.enums.len() {
        return cg_val(cg_error(state, "unknown enum"), "0")
    }
    let def = state.enums[enum_index]
    if variant < 0 || variant >= def.variants.len() {
        return cg_val(cg_error(state, "unknown enum variant"), "0")
    }
    let count = cg_variant_payload_count(def, variant)
    if values.len() != count {
        return cg_val(
            cg_error(
                state,
                def.name + "." + def.variants[variant] + " expects " + count.to_string() + " payload values, got " + values.len().to_string(),
            ),
            "0",
        )
    }
    let ty = "%nova.enum." + def.name
    var work = state
    var aggregate = "zeroinitializer"
    let tag_result = cg_temp(work)
    work = tag_result.0
    let tag = tag_result.1
    work = cg_line(work, "  " + tag + " = insertvalue " + ty + " " + aggregate + ", i32 " + variant.to_string() + ", 0")
    aggregate = tag
    var k = 0
    var slot = 1
    while k < values.len() {
        let payload_ty = cg_variant_payload_type(def, variant, k)
        let packed = cg_pack_payload(work, aggregate, ty, values[k].value, values[k].ty, payload_ty, slot)
        work = packed.0
        aggregate = packed.1
        slot = packed.2
        if work.error.len() > 0 {
            return cg_val(work, "0")
        }
        k = k + 1
    }
    return cg_val_typed(work, aggregate, ty)
}

fn cg_enum_call(ast: Ast, state: CgState, node: Int, name: String) -> CgVal {
    let found = cg_find_variant(state.enums, name)
    if found.0 < 0 {
        return cg_val(cg_error(state, "unknown enum variant " + name), "0")
    }
    let def = state.enums[found.0]
    let count = cg_variant_payload_count(def, found.1)
    let got = ast.nodes[node].count - 1
    if got != count {
        return cg_val(
            cg_error(
                state,
                def.name + "." + name + " expects " + count.to_string() + " payload values, got " + got.to_string(),
            ),
            "0",
        )
    }
    var work = state
    var values: List<CgVal> = []
    var k = 0
    while k < got {
        let value = cg_expr2(ast, work, a_child(ast, node, k + 1))
        work = value.state
        values.push(value)
        k = k + 1
    }
    return cg_enum_make(work, found.0, found.1, values)
}

fn cg_line(state: CgState, text: String) -> CgState {
    nova_ir_line(text)
    var lines = state.lines
    lines.push(text)
    return cg_state(state, lines, state.temps, state.slots, state.locals, state.terminated, state.error)
}

fn cg_error(state: CgState, message: String) -> CgState {
    if state.error.len() > 0 {
        return state
    }
    return cg_state(state, state.lines, state.temps, state.slots, state.locals, state.terminated, message)
}

fn cg_temp(state: CgState) -> (CgState, String) {
    let next = state.temps + 1
    let name = "%t" + state.temps.to_string()
    return (cg_state(state, state.lines, next, state.slots, state.locals, state.terminated, state.error), name)
}

fn cg_slot(state: CgState) -> (CgState, String) {
    let next = state.slots + 1
    let name = "%s" + state.slots.to_string()
    return (cg_state(state, state.lines, state.temps, next, state.locals, state.terminated, state.error), name)
}

fn cg_entry_slot(state: CgState, ty: String) -> (CgState, String) {
    let next = state.slots + 1
    let name = "%s" + state.slots.to_string()
    var entry = state.entry
    entry.push("  " + name + " = alloca " + ty)
    let work = CgState {
        lines: state.lines,
        entry: entry,
        temps: state.temps,
        slots: next,
        locals: state.locals,
        fns: state.fns,
        structs: state.structs,
        enums: state.enums,
        globals: state.globals,
        strings: state.strings,
        fn_index: state.fn_index,
        ret: state.ret,
        terminated: state.terminated,
        error: state.error,
        breaks: state.breaks,
        continues: state.continues,
    }
    return (work, name)
}

fn cg_local_index(locals: List<CgLocal>, name: String) -> Int {
    var i = locals.len() - 1
    while i >= 0 {
        if locals[i].name == name {
            return i
        }
        i = i - 1
    }
    return -1
}

fn cg_fn_index(fns: List<CgSig>, name: String) -> Int {
    var i = 0
    while i < fns.len() {
        if fns[i].name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn cg_method_exists(fns: List<CgSig>, name: String) -> Bool {
    let suffix = "." + name
    var i = 0
    while i < fns.len() {
        if fns[i].name.ends_with(suffix) {
            return true
        }
        i = i + 1
    }
    return false
}

fn cg_number(text: String) -> String {
    if text.contains(".") {
        return ""
    }
    let chars = text.chars()
    var out = ""
    for c in chars {
        if c != "_" {
            out = out + c
        }
    }
    return out
}

fn cg_val(state: CgState, value: String) -> CgVal {
    return CgVal { state: state, value: value, ty: "i64", elem: "Int", source: "Int" }
}

fn cg_source_from_llvm(structs: List<CgStruct>, enums: List<CgEnum>, ty: String) -> String {
    if ty == "i64" {
        return "Int"
    }
    if ty == "i1" {
        return "Bool"
    }
    if ty == "%nova.string" {
        return "String"
    }
    if ty == "%nova.list" {
        return "List<Int>"
    }
    if ty == "%nova.slice" {
        return "Slice<Int>"
    }
    if ty == "%nova.map" {
        return "Map<Int, Int>"
    }
    let struct_index = cg_struct_by_llvm(structs, ty)
    if struct_index >= 0 {
        return structs[struct_index].name
    }
    let enum_index = cg_enum_by_llvm(enums, ty)
    if enum_index >= 0 {
        return enums[enum_index].name
    }
    return ""
}

fn cg_val_typed(state: CgState, value: String, ty: String) -> CgVal {
    return CgVal { state: state, value: value, ty: ty, elem: "Int", source: cg_source_from_llvm(state.structs, state.enums, ty) }
}

fn cg_val_source(state: CgState, value: String, source: String) -> CgVal {
    return CgVal {
        state: state,
        value: value,
        ty: cg_llvm_type_in(state.structs, state.enums, source),
        elem: cg_list_elem(source),
        source: source,
    }
}

fn cg_val_list(state: CgState, value: String, elem: String) -> CgVal {
    return CgVal { state: state, value: value, ty: "%nova.list", elem: elem, source: "List<" + elem + ">" }
}

fn cg_val_slice(state: CgState, value: String, elem: String) -> CgVal {
    return CgVal { state: state, value: value, ty: "%nova.slice", elem: elem, source: "Slice<" + elem + ">" }
}

fn cg_is_list(type_name: String) -> Bool {
    return type_name.starts_with("List<") && type_name.ends_with(">")
}

fn cg_list_elem(type_name: String) -> String {
    if !cg_is_list(type_name) {
        return ""
    }
    return lx_slice(type_name.chars(), 5, type_name.len() - 1)
}

fn cg_is_slice(type_name: String) -> Bool {
    return type_name.starts_with("Slice<") && type_name.ends_with(">")
}

fn cg_slice_elem(type_name: String) -> String {
    if !cg_is_slice(type_name) {
        return ""
    }
    return lx_slice(type_name.chars(), 6, type_name.len() - 1).trim()
}

fn cg_is_map(type_name: String) -> Bool {
    return type_name.starts_with("Map<") && type_name.ends_with(">")
}

fn cg_map_key(type_name: String) -> String {
    if !cg_is_map(type_name) {
        return ""
    }
    let parts = cg_split_types(lx_slice(type_name.chars(), 4, type_name.len() - 1))
    if parts.len() != 2 {
        return ""
    }
    return parts[0].trim()
}

fn cg_map_value(type_name: String) -> String {
    if !cg_is_map(type_name) {
        return ""
    }
    let parts = cg_split_types(lx_slice(type_name.chars(), 4, type_name.len() - 1))
    if parts.len() != 2 {
        return ""
    }
    return parts[1].trim()
}

fn cg_is_set(type_name: String) -> Bool {
    return type_name.starts_with("Set<") && type_name.ends_with(">")
}

fn cg_set_elem(type_name: String) -> String {
    if !cg_is_set(type_name) {
        return ""
    }
    let parts = cg_split_types(lx_slice(type_name.chars(), 4, type_name.len() - 1))
    if parts.len() != 1 {
        return ""
    }
    return parts[0].trim()
}

fn cg_map_key_kind(type_name: String) -> String {
    if type_name == "Int" {
        return "0"
    }
    if type_name == "Bool" {
        return "1"
    }
    if type_name == "String" {
        return "3"
    }
    return ""
}

fn cg_map_entry_source(type_name: String) -> String {
    if cg_is_map(type_name) {
        return "(" + cg_map_key(type_name) + "," + cg_map_value(type_name) + ")"
    }
    if cg_is_set(type_name) {
        return cg_set_elem(type_name)
    }
    return ""
}

fn cg_is_option(type_name: String) -> Bool {
    return type_name.starts_with("Option<") && type_name.ends_with(">")
}

fn cg_option_inner(type_name: String) -> String {
    if !cg_is_option(type_name) {
        return ""
    }
    return lx_slice(type_name.chars(), 7, type_name.len() - 1).trim()
}

fn cg_is_result(type_name: String) -> Bool {
    return type_name.starts_with("Result<") && type_name.ends_with(">")
}

fn cg_result_ok(type_name: String) -> String {
    if !cg_is_result(type_name) {
        return ""
    }
    let parts = cg_split_types(lx_slice(type_name.chars(), 7, type_name.len() - 1))
    if parts.len() < 1 {
        return ""
    }
    return parts[0].trim()
}

fn cg_result_err(type_name: String) -> String {
    if !cg_is_result(type_name) {
        return ""
    }
    let parts = cg_split_types(lx_slice(type_name.chars(), 7, type_name.len() - 1))
    if parts.len() < 2 {
        return ""
    }
    return parts[1].trim()
}

fn cg_digit_char(c: String) -> Int {
    if c == "0" {
        return 0
    }
    if c == "1" {
        return 1
    }
    if c == "2" {
        return 2
    }
    if c == "3" {
        return 3
    }
    if c == "4" {
        return 4
    }
    if c == "5" {
        return 5
    }
    if c == "6" {
        return 6
    }
    if c == "7" {
        return 7
    }
    if c == "8" {
        return 8
    }
    if c == "9" {
        return 9
    }
    return -1
}

// `[elem; N]` returns (elem, N); a non-array returns ("", -1).
fn cg_array_layout(name: String) -> (String, Int) {
    let chars = name.chars()
    if chars.len() < 4 || chars[0] != "[" || chars[chars.len() - 1] != "]" {
        return ("", -1)
    }
    var depth = 0
    var split = -1
    var i = 1
    while i < chars.len() - 1 && split < 0 {
        let c = chars[i]
        if c == "[" || c == "<" || c == "(" {
            depth = depth + 1
        } else if c == "]" || c == ">" || c == ")" {
            depth = depth - 1
        } else if c == ";" && depth == 0 {
            split = i
        }
        i = i + 1
    }
    if split < 0 {
        return ("", -1)
    }
    let elem = lx_slice(chars, 1, split).trim()
    var length = 0
    var digits = 0
    var k = split + 1
    while k < chars.len() - 1 {
        let c = chars[k]
        if c != "_" {
            let digit = cg_digit_char(c)
            if digit < 0 {
                return ("", -1)
            }
            length = length * 10 + digit
            digits = digits + 1
        }
        k = k + 1
    }
    if digits == 0 || elem.len() == 0 {
        return ("", -1)
    }
    return (elem, length)
}

fn cg_elem_name(structs: List<CgStruct>, enums: List<CgEnum>, ty: String) -> String {
    if ty == "i64" {
        return "Int"
    }
    if ty == "%nova.string" {
        return "String"
    }
    if ty == "i1" {
        return "Bool"
    }
    let struct_index = cg_struct_by_llvm(structs, ty)
    if struct_index >= 0 {
        return structs[struct_index].name
    }
    let enum_index = cg_enum_by_llvm(enums, ty)
    if enum_index >= 0 {
        return enums[enum_index].name
    }
    return "Int"
}

fn cg_elem_size(state: CgState, elem: String) -> (CgState, String) {
    let elem_ty = cg_llvm_type_in(state.structs, state.enums, elem)
    let ptr_result = cg_temp(state)
    var work = ptr_result.0
    let ptr = ptr_result.1
    work = cg_line(work, "  " + ptr + " = getelementptr " + elem_ty + ", ptr null, i64 1")
    let size_result = cg_temp(work)
    work = size_result.0
    let size = size_result.1
    work = cg_line(work, "  " + size + " = ptrtoint ptr " + ptr + " to i64")
    return (work, size)
}

fn cg_clone_list(state: CgState, value: CgVal, elem: String) -> (CgState, String) {
    let size_result = cg_elem_size(state, elem)
    var work = size_result.0
    let elem_size = size_result.1
    let source_result = cg_entry_slot(work, "%nova.list")
    work = source_result.0
    let source_slot = source_result.1
    work = cg_line(work, "  store %nova.list " + value.value + ", ptr " + source_slot)
    let dest_result = cg_entry_slot(work, "%nova.list")
    work = dest_result.0
    let dest_slot = dest_result.1
    work = cg_line(work, "  store %nova.list zeroinitializer, ptr " + dest_slot)
    work = cg_line(work, "  call void @nova_list_clone(ptr " + source_slot + ", ptr " + dest_slot + ", i64 " + elem_size + ")")
    let temp_result = cg_temp(work)
    work = temp_result.0
    let temp = temp_result.1
    work = cg_line(work, "  " + temp + " = load %nova.list, ptr " + dest_slot)
    return (work, temp)
}

fn cg_element_source(type_name: String) -> String {
    let array = cg_array_layout(type_name)
    if array.1 >= 0 {
        return array.0
    }
    if cg_is_list(type_name) {
        return cg_list_elem(type_name)
    }
    if cg_is_slice(type_name) {
        return cg_slice_elem(type_name)
    }
    return ""
}

fn cg_val_from_source(state: CgState, value: String, source_type: String) -> CgVal {
    if cg_is_list(source_type) {
        return cg_val_list(state, value, cg_list_elem(source_type))
    }
    if cg_is_slice(source_type) {
        return cg_val_slice(state, value, cg_slice_elem(source_type))
    }
    return CgVal {
        state: state,
        value: value,
        ty: cg_llvm_type_in(state.structs, state.enums, source_type),
        elem: cg_element_source(source_type),
        source: source_type,
    }
}

fn cg_label(state: CgState) -> (CgState, String) {
    let next = state.temps + 1
    let name = "L" + state.temps.to_string()
    return (cg_state(state, state.lines, next, state.slots, state.locals, state.terminated, state.error), name)
}

fn cg_string_unquote(raw: String) -> String {
    let chars = raw.chars()
    if chars.len() < 2 {
        return ""
    }
    var out = ""
    var i = 1
    while i < chars.len() - 1 {
        let c = chars[i]
        if c == "\\" && i + 1 < chars.len() - 1 {
            i = i + 1
            let escaped = chars[i]
            if escaped == "n" {
                out = out + "\n"
            } else if escaped == "t" {
                out = out + "\t"
            } else if escaped == "r" {
                out = out + "\r"
            } else if escaped == "\\" {
                out = out + "\\"
            } else if escaped == "\"" {
                out = out + "\""
            } else {
                out = out + escaped
            }
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

fn cg_llvm_escape(text: String) -> String {
    var out = ""
    for c in text.chars() {
        if c == "\"" {
            out = out + "\\22"
        } else if c == "\\" {
            out = out + "\\5C"
        } else if c == "\n" {
            out = out + "\\0A"
        } else if c == "\t" {
            out = out + "\\09"
        } else if c == "\r" {
            out = out + "\\0D"
        } else {
            out = out + c
        }
    }
    return out
}

fn cg_string_lit(state: CgState, raw: String) -> CgVal {
    return cg_string_text(state, cg_string_unquote(raw))
}

// Builds a `%nova.string` from already-decoded text, used by interpolation
// parts and by literal strings after unquoting.
fn cg_string_text(state: CgState, text: String) -> CgVal {
    let symbol = "@nova.str." + state.fn_index.to_string() + "." + state.strings.to_string()
    var definition = symbol + " = private unnamed_addr constant [1 x i8] zeroinitializer, align 1"
    if text.len() > 0 {
        definition = symbol + " = private unnamed_addr constant [" + text.len().to_string() + " x i8] c\"" + cg_llvm_escape(text) + "\", align 1"
    }
    var globals = state.globals
    globals.push(definition)
    var work = cg_state_globals(state, globals, state.strings + 1)
    let first_result = cg_temp(work)
    work = first_result.0
    let first = first_result.1
    work = cg_line(work, "  " + first + " = insertvalue %nova.string { ptr null, i64 0 }, ptr " + symbol + ", 0")
    let second_result = cg_temp(work)
    work = second_result.0
    let second = second_result.1
    work = cg_line(work, "  " + second + " = insertvalue %nova.string " + first + ", i64 " + text.len().to_string() + ", 1")
    return cg_val_typed(work, second, "%nova.string")
}

fn cg_interp_part(value: CgVal) -> CgVal {
    if value.ty == "%nova.string" {
        return value
    }
    if value.ty == "i64" {
        let temp_result = cg_temp(value.state)
        var work = temp_result.0
        let temp = temp_result.1
        work = cg_line(work, "  " + temp + " = call %nova.string @nova_i64_to_string(i64 " + value.value + ")")
        return cg_val_typed(work, temp, "%nova.string")
    }
    if value.ty == "i1" {
        let wide_result = cg_temp(value.state)
        var work = wide_result.0
        let wide = wide_result.1
        work = cg_line(work, "  " + wide + " = zext i1 " + value.value + " to i32")
        let temp_result = cg_temp(work)
        work = temp_result.0
        let temp = temp_result.1
        work = cg_line(work, "  " + temp + " = call %nova.string @nova_bool_to_string(i32 " + wide + ")")
        return cg_val_typed(work, temp, "%nova.string")
    }
    return cg_val(cg_error(value.state, "cannot interpolate " + value.ty + " into a string"), "0")
}

// Lowers `"text ${expr}"` to a left-to-right concat of literal pieces and
// converted expressions, matching the seed's `nova_string_concat` lowering.
fn cg_interp(ast: Ast, state: CgState, node: Int) -> CgVal {
    var acc = cg_string_text(state, "")
    let count = ast.nodes[node].count
    var i = 0
    while i < count {
        let child = a_child(ast, node, i)
        var piece = cg_val(acc.state, "0")
        if child >= 0 && ast.nodes[child].kind == ak_str_part() {
            piece = cg_string_text(acc.state, ast.nodes[child].text)
        } else {
            let value = cg_expr2(ast, acc.state, child)
            if value.state.error.len() > 0 {
                return cg_val(value.state, "0")
            }
            piece = cg_interp_part(value)
        }
        if piece.state.error.len() > 0 {
            return cg_val(piece.state, "0")
        }
        let temp_result = cg_temp(piece.state)
        var work = temp_result.0
        let temp = temp_result.1
        work = cg_line(work, "  " + temp + " = call %nova.string @nova_string_concat(%nova.string " + acc.value + ", %nova.string " + piece.value + ")")
        acc = cg_val_typed(work, temp, "%nova.string")
        i = i + 1
    }
    return acc
}

fn cg_list_lit(ast: Ast, state: CgState, node: Int) -> CgVal {
    let count = ast.nodes[node].count
    var work = state
    var values: List<CgVal> = []
    var i = 0
    while i < count {
        let value = cg_expr2(ast, work, a_child(ast, node, i))
        work = value.state
        if work.error.len() > 0 {
            return cg_val(work, "0")
        }
        values.push(value)
        i = i + 1
    }
    if count == 0 {
        let first_result = cg_temp(work)
        work = first_result.0
        let first = first_result.1
        work = cg_line(work, "  " + first + " = insertvalue %nova.list zeroinitializer, i64 0, 1")
        let second_result = cg_temp(work)
        work = second_result.0
        let second = second_result.1
        work = cg_line(work, "  " + second + " = insertvalue %nova.list " + first + ", i64 0, 2")
        return cg_val_list(work, second, "Int")
    }
    var elem = values[0].source
    if elem.len() == 0 || cg_is_tuple(elem) {
        elem = cg_elem_name(work.structs, work.enums, values[0].ty)
    }
    let elem_ty = cg_llvm_type_in(work.structs, work.enums, elem)
    var k = 0
    while k < count {
        if values[k].ty != elem_ty {
            return cg_val(cg_error(work, "list elements must share a type"), "0")
        }
        k = k + 1
    }
    let size_result = cg_elem_size(work, elem)
    work = size_result.0
    let elem_size = size_result.1
    let bytes_result = cg_temp(work)
    work = bytes_result.0
    let bytes = bytes_result.1
    work = cg_line(work, "  " + bytes + " = mul i64 " + count.to_string() + ", " + elem_size)
    let data_result = cg_temp(work)
    work = data_result.0
    let array = data_result.1
    work = cg_line(work, "  " + array + " = call ptr @malloc(i64 " + bytes + ")")
    let null_result = cg_temp(work)
    work = null_result.0
    let is_null = null_result.1
    work = cg_line(work, "  " + is_null + " = icmp eq ptr " + array + ", null")
    let ok_result = cg_label(work)
    work = ok_result.0
    let ok = ok_result.1
    let bad_result = cg_label(work)
    work = bad_result.0
    let bad = bad_result.1
    work = cg_line(work, "  br i1 " + is_null + ", label %" + bad + ", label %" + ok)
    work = cg_line(work, bad + ":")
    work = cg_line(work, "  call void @llvm.trap()")
    work = cg_line(work, "  unreachable")
    work = cg_line(work, ok + ":")
    var j = 0
    while j < count {
        let ptr_result = cg_temp(work)
        work = ptr_result.0
        let ptr = ptr_result.1
        work = cg_line(work, "  " + ptr + " = getelementptr " + elem_ty + ", ptr " + array + ", i64 " + j.to_string())
        work = cg_line(work, "  store " + elem_ty + " " + values[j].value + ", ptr " + ptr)
        j = j + 1
    }
    let first_result = cg_temp(work)
    work = first_result.0
    let first = first_result.1
    work = cg_line(work, "  " + first + " = insertvalue %nova.list zeroinitializer, ptr " + array + ", 0")
    let second_result = cg_temp(work)
    work = second_result.0
    let second = second_result.1
    work = cg_line(work, "  " + second + " = insertvalue %nova.list " + first + ", i64 " + count.to_string() + ", 1")
    let third_result = cg_temp(work)
    work = third_result.0
    let third = third_result.1
    work = cg_line(work, "  " + third + " = insertvalue %nova.list " + second + ", i64 " + count.to_string() + ", 2")
    return cg_val_list(work, third, elem)
}

fn cg_option_some(state: CgState, option_source: String, value: CgVal) -> CgVal {
    let inner = cg_option_inner(option_source)
    if inner.len() == 0 {
        return cg_val(cg_error(state, "Some requires an Option type"), "0")
    }
    let inner_ty = cg_llvm_type_in(state.structs, state.enums, inner)
    if value.ty != inner_ty {
        return cg_val(cg_error(state, "Some payload type mismatch"), "0")
    }
    let ty = cg_llvm_type_in(state.structs, state.enums, option_source)
    var work = value.state
    let first_result = cg_temp(work)
    work = first_result.0
    let first = first_result.1
    work = cg_line(work, "  " + first + " = insertvalue " + ty + " undef, " + inner_ty + " " + value.value + ", 1")
    let second_result = cg_temp(work)
    work = second_result.0
    let second = second_result.1
    work = cg_line(work, "  " + second + " = insertvalue " + ty + " " + first + ", i1 true, 0")
    return CgVal { state: work, value: second, ty: ty, elem: inner, source: option_source }
}

fn cg_option_none(state: CgState, option_source: String) -> CgVal {
    let inner = cg_option_inner(option_source)
    if inner.len() == 0 {
        return cg_val(cg_error(state, "None requires an Option type"), "0")
    }
    let ty = cg_llvm_type_in(state.structs, state.enums, option_source)
    let first_result = cg_temp(state)
    var work = first_result.0
    let first = first_result.1
    work = cg_line(work, "  " + first + " = insertvalue " + ty + " zeroinitializer, i1 false, 0")
    return CgVal { state: work, value: first, ty: ty, elem: inner, source: option_source }
}

fn cg_make_result_ok(state: CgState, result_source: String, value: CgVal) -> CgVal {
    let ok = cg_result_ok(result_source)
    let err = cg_result_err(result_source)
    if ok.len() == 0 || err.len() == 0 {
        return cg_val(cg_error(state, "Ok requires a Result type"), "0")
    }
    let ok_ty = cg_llvm_type_in(state.structs, state.enums, ok)
    if value.ty != ok_ty {
        return cg_val(cg_error(state, "Ok payload type mismatch"), "0")
    }
    let ty = cg_llvm_type_in(state.structs, state.enums, result_source)
    var work = value.state
    let first_result = cg_temp(work)
    work = first_result.0
    let first = first_result.1
    work = cg_line(work, "  " + first + " = insertvalue " + ty + " undef, " + ok_ty + " " + value.value + ", 1")
    let second_result = cg_temp(work)
    work = second_result.0
    let second = second_result.1
    work = cg_line(work, "  " + second + " = insertvalue " + ty + " " + first + ", i1 true, 0")
    return CgVal { state: work, value: second, ty: ty, elem: ok, source: result_source }
}

fn cg_make_result_err(state: CgState, result_source: String, value: CgVal) -> CgVal {
    let ok = cg_result_ok(result_source)
    let err = cg_result_err(result_source)
    if ok.len() == 0 || err.len() == 0 {
        return cg_val(cg_error(state, "Err requires a Result type"), "0")
    }
    let err_ty = cg_llvm_type_in(state.structs, state.enums, err)
    if value.ty != err_ty {
        return cg_val(cg_error(state, "Err payload type mismatch"), "0")
    }
    let ty = cg_llvm_type_in(state.structs, state.enums, result_source)
    var work = value.state
    let first_result = cg_temp(work)
    work = first_result.0
    let first = first_result.1
    work = cg_line(work, "  " + first + " = insertvalue " + ty + " undef, " + err_ty + " " + value.value + ", 2")
    let second_result = cg_temp(work)
    work = second_result.0
    let second = second_result.1
    work = cg_line(work, "  " + second + " = insertvalue " + ty + " " + first + ", i1 false, 0")
    return CgVal { state: work, value: second, ty: ty, elem: err, source: result_source }
}

fn cg_array_lit(ast: Ast, state: CgState, node: Int, array_source: String) -> CgVal {
    let layout = cg_array_layout(array_source)
    if layout.1 < 0 {
        return cg_val(cg_error(state, "array literal requires an array type"), "0")
    }
    let count = ast.nodes[node].count
    if count != layout.1 {
        return cg_val(cg_error(state, "array length mismatch"), "0")
    }
    let elem_ty = cg_llvm_type_in(state.structs, state.enums, layout.0)
    let array_ty = cg_llvm_type_in(state.structs, state.enums, array_source)
    var work = state
    var aggregate = "undef"
    var i = 0
    while i < count {
        let value = cg_expr_expected(ast, work, a_child(ast, node, i), layout.0)
        work = value.state
        if value.ty != elem_ty {
            return cg_val(cg_error(work, "array element type mismatch"), "0")
        }
        let temp_result = cg_temp(work)
        work = temp_result.0
        let temp = temp_result.1
        work = cg_line(work, "  " + temp + " = insertvalue " + array_ty + " " + aggregate + ", " + elem_ty + " " + value.value + ", " + i.to_string())
        aggregate = temp
        i = i + 1
    }
    return CgVal { state: work, value: aggregate, ty: array_ty, elem: layout.0, source: array_source }
}

fn cg_map_empty(state: CgState, source: String) -> CgVal {
    let map = cg_is_map(source)
    let set = cg_is_set(source)
    if !map && !set {
        return cg_val(cg_error(state, "map()/set() requires a Map or Set type"), "0")
    }
    let key = if map { cg_map_key(source) } else { cg_set_elem(source) }
    let value = if map { cg_map_value(source) } else { cg_set_elem(source) }
    if key.len() == 0 || value.len() == 0 {
        return cg_val(cg_error(state, "map()/set() requires concrete type parameters"), "0")
    }
    let kind = cg_map_key_kind(key)
    if kind.len() == 0 {
        return cg_val(cg_error(state, "unsupported map/set key type " + key), "0")
    }
    let size_result = cg_elem_size(state, cg_map_entry_source(source))
    var work = size_result.0
    let entry_size = size_result.1
    let first_result = cg_temp(work)
    work = first_result.0
    let first = first_result.1
    work = cg_line(work, "  " + first + " = insertvalue %nova.map zeroinitializer, i64 " + entry_size + ", 4")
    let second_result = cg_temp(work)
    work = second_result.0
    let second = second_result.1
    work = cg_line(work, "  " + second + " = insertvalue %nova.map " + first + ", i32 " + kind + ", 5")
    return CgVal { state: work, value: second, ty: "%nova.map", elem: "", source: source }
}

fn cg_map_insert(ast: Ast, state: CgState, node: Int, callee: Int, recv: CgVal) -> CgVal {
    let receiver = a_child(ast, callee, 0)
    if receiver < 0 || ast.nodes[receiver].kind != ak_ident() {
        return cg_val(cg_error(state, "map/set insert requires a mutable binding"), "0")
    }
    let index = cg_local_index(recv.state.locals, ast.nodes[receiver].text)
    if index < 0 {
        return cg_val(cg_error(recv.state, "unknown map/set local " + ast.nodes[receiver].text), "0")
    }
    let local = recv.state.locals[index]
    if !local.mutable || local.slot.len() == 0 {
        return cg_val(cg_error(recv.state, "map/set insert requires a mutable binding"), "0")
    }
    if cg_is_map(local.source) {
        let key_type = cg_map_key(local.source)
        let value_type = cg_map_value(local.source)
        let key = cg_expr_expected(ast, recv.state, a_child(ast, node, 1), key_type)
        let value = cg_expr_expected(ast, key.state, a_child(ast, node, 2), value_type)
        var work = value.state
        let key_ty = cg_llvm_type_in(work.structs, work.enums, key_type)
        let value_ty = cg_llvm_type_in(work.structs, work.enums, value_type)
        let entry_ty = "{ " + key_ty + ", " + value_ty + " }"
        let first_result = cg_temp(work)
        work = first_result.0
        let first = first_result.1
        work = cg_line(work, "  " + first + " = insertvalue " + entry_ty + " undef, " + key_ty + " " + key.value + ", 0")
        let entry_result = cg_temp(work)
        work = entry_result.0
        let entry = entry_result.1
        work = cg_line(work, "  " + entry + " = insertvalue " + entry_ty + " " + first + ", " + value_ty + " " + value.value + ", 1")
        let slot_result = cg_entry_slot(work, entry_ty)
        work = slot_result.0
        let slot = slot_result.1
        work = cg_line(work, "  store " + entry_ty + " " + entry + ", ptr " + slot)
        work = cg_line(work, "  call void @nova_map_insert(ptr " + local.slot + ", ptr " + slot + ")")
        return cg_val_typed(work, "", "void")
    }
    if cg_is_set(local.source) {
        let elem_type = cg_set_elem(local.source)
        let value = cg_expr_expected(ast, recv.state, a_child(ast, node, 1), elem_type)
        var work = value.state
        let elem_ty = cg_llvm_type_in(work.structs, work.enums, elem_type)
        let slot_result = cg_entry_slot(work, elem_ty)
        work = slot_result.0
        let slot = slot_result.1
        work = cg_line(work, "  store " + elem_ty + " " + value.value + ", ptr " + slot)
        let result_result = cg_temp(work)
        work = result_result.0
        let result = result_result.1
        work = cg_line(work, "  " + result + " = call i32 @nova_map_add(ptr " + local.slot + ", ptr " + slot + ")")
        let inserted_result = cg_temp(work)
        work = inserted_result.0
        let inserted = inserted_result.1
        work = cg_line(work, "  " + inserted + " = icmp ne i32 " + result + ", 0")
        return cg_val_typed(work, inserted, "i1")
    }
    return cg_val(cg_error(recv.state, "map/set insert requires a map or set"), "0")
}

fn cg_map_get(ast: Ast, state: CgState, node: Int, recv: CgVal) -> CgVal {
    let key_type = cg_map_key(recv.source)
    let value_type = cg_map_value(recv.source)
    if key_type.len() == 0 || value_type.len() == 0 {
        return cg_val(cg_error(recv.state, "get requires a Map"), "0")
    }
    let key = cg_expr_expected(ast, recv.state, a_child(ast, node, 1), key_type)
    var work = key.state
    let key_ty = cg_llvm_type_in(work.structs, work.enums, key_type)
    let map_slot_result = cg_entry_slot(work, "%nova.map")
    work = map_slot_result.0
    let map_slot = map_slot_result.1
    work = cg_line(work, "  store %nova.map " + recv.value + ", ptr " + map_slot)
    let key_slot_result = cg_entry_slot(work, key_ty)
    work = key_slot_result.0
    let key_slot = key_slot_result.1
    work = cg_line(work, "  store " + key_ty + " " + key.value + ", ptr " + key_slot)
    let found_result = cg_temp(work)
    work = found_result.0
    let found = found_result.1
    work = cg_line(work, "  " + found + " = call ptr @nova_map_get(ptr " + map_slot + ", ptr " + key_slot + ")")
    let option_source = "Option<" + value_type + ">"
    let option_ty = cg_llvm_type_in(work.structs, work.enums, option_source)
    let result_slot_result = cg_entry_slot(work, option_ty)
    work = result_slot_result.0
    let result_slot = result_slot_result.1
    let missing_result = cg_temp(work)
    work = missing_result.0
    let missing = missing_result.1
    work = cg_line(work, "  " + missing + " = icmp eq ptr " + found + ", null")
    let none_result = cg_label(work)
    work = none_result.0
    let none = none_result.1
    let some_result = cg_label(work)
    work = some_result.0
    let some = some_result.1
    let done_result = cg_label(work)
    work = done_result.0
    let done = done_result.1
    work = cg_line(work, "  br i1 " + missing + ", label %" + none + ", label %" + some)
    work = cg_line(work, none + ":")
    let none_value = cg_option_none(work, option_source)
    work = none_value.state
    work = cg_line(work, "  store " + option_ty + " " + none_value.value + ", ptr " + result_slot)
    work = cg_line(work, "  br label %" + done)
    work = cg_line(work, some + ":")
    let entry_ty = "{ " + key_ty + ", " + cg_llvm_type_in(work.structs, work.enums, value_type) + " }"
    let entry_result = cg_temp(work)
    work = entry_result.0
    let entry = entry_result.1
    work = cg_line(work, "  " + entry + " = load " + entry_ty + ", ptr " + found)
    let value_result = cg_temp(work)
    work = value_result.0
    let value_value = value_result.1
    work = cg_line(work, "  " + value_value + " = extractvalue " + entry_ty + " " + entry + ", 1")
    let value = cg_val_from_source(work, value_value, value_type)
    let some_value = cg_option_some(value.state, option_source, value)
    work = some_value.state
    work = cg_line(work, "  store " + option_ty + " " + some_value.value + ", ptr " + result_slot)
    work = cg_line(work, "  br label %" + done)
    work = cg_line(work, done + ":")
    let result_result = cg_temp(work)
    work = result_result.0
    let result = result_result.1
    work = cg_line(work, "  " + result + " = load " + option_ty + ", ptr " + result_slot)
    return CgVal { state: work, value: result, ty: option_ty, elem: value_type, source: option_source }
}

fn cg_map_contains(ast: Ast, state: CgState, node: Int, recv: CgVal) -> CgVal {
    let key_type = cg_map_key(recv.source)
    if key_type.len() == 0 {
        return cg_val(cg_error(recv.state, "contains_key requires a Map"), "0")
    }
    let key = cg_expr_expected(ast, recv.state, a_child(ast, node, 1), key_type)
    var work = key.state
    let key_ty = cg_llvm_type_in(work.structs, work.enums, key_type)
    let map_slot_result = cg_entry_slot(work, "%nova.map")
    work = map_slot_result.0
    let map_slot = map_slot_result.1
    work = cg_line(work, "  store %nova.map " + recv.value + ", ptr " + map_slot)
    let key_slot_result = cg_entry_slot(work, key_ty)
    work = key_slot_result.0
    let key_slot = key_slot_result.1
    work = cg_line(work, "  store " + key_ty + " " + key.value + ", ptr " + key_slot)
    let found_result = cg_temp(work)
    work = found_result.0
    let found = found_result.1
    work = cg_line(work, "  " + found + " = call ptr @nova_map_get(ptr " + map_slot + ", ptr " + key_slot + ")")
    let result_result = cg_temp(work)
    work = result_result.0
    let result = result_result.1
    work = cg_line(work, "  " + result + " = icmp ne ptr " + found + ", null")
    return cg_val_typed(work, result, "i1")
}

fn cg_set_contains(ast: Ast, state: CgState, node: Int, recv: CgVal) -> CgVal {
    let elem_type = cg_set_elem(recv.source)
    if elem_type.len() == 0 {
        return cg_val(cg_error(recv.state, "contains requires a Set"), "0")
    }
    let value = cg_expr_expected(ast, recv.state, a_child(ast, node, 1), elem_type)
    var work = value.state
    let elem_ty = cg_llvm_type_in(work.structs, work.enums, elem_type)
    let set_slot_result = cg_entry_slot(work, "%nova.map")
    work = set_slot_result.0
    let set_slot = set_slot_result.1
    work = cg_line(work, "  store %nova.map " + recv.value + ", ptr " + set_slot)
    let value_slot_result = cg_entry_slot(work, elem_ty)
    work = value_slot_result.0
    let value_slot = value_slot_result.1
    work = cg_line(work, "  store " + elem_ty + " " + value.value + ", ptr " + value_slot)
    let found_result = cg_temp(work)
    work = found_result.0
    let found = found_result.1
    work = cg_line(work, "  " + found + " = call ptr @nova_map_get(ptr " + set_slot + ", ptr " + value_slot + ")")
    let result_result = cg_temp(work)
    work = result_result.0
    let result = result_result.1
    work = cg_line(work, "  " + result + " = icmp ne ptr " + found + ", null")
    return cg_val_typed(work, result, "i1")
}

fn cg_map_len(state: CgState, recv: CgVal) -> CgVal {
    let map_slot_result = cg_entry_slot(state, "%nova.map")
    var work = map_slot_result.0
    let map_slot = map_slot_result.1
    work = cg_line(work, "  store %nova.map " + recv.value + ", ptr " + map_slot)
    let result_result = cg_temp(work)
    work = result_result.0
    let result = result_result.1
    work = cg_line(work, "  " + result + " = call i64 @nova_map_len(ptr " + map_slot + ")")
    return cg_val(work, result)
}

fn cg_expr_expected(ast: Ast, state: CgState, node: Int, expected: String) -> CgVal {
    if expected.len() == 0 {
        return cg_expr2(ast, state, node)
    }
    if node < 0 || node >= ast.nodes.len() {
        return cg_val(cg_error(state, "invalid expression node"), "0")
    }
    let item = ast.nodes[node]
    if (cg_is_map(expected) || cg_is_set(expected)) && item.kind == ak_call() {
        let callee = a_child(ast, node, 0)
        if callee >= 0 && ast.nodes[callee].kind == ak_ident() {
            let name = ast.nodes[callee].text
            if (cg_is_map(expected) && name == "map") || (cg_is_set(expected) && name == "set") {
                if item.count - 1 != 0 {
                    return cg_val(cg_error(state, name + " expects no arguments"), "0")
                }
                return cg_map_empty(state, expected)
            }
        }
    }
    let array = cg_array_layout(expected)
    if array.1 >= 0 && item.kind == ak_list() {
        return cg_array_lit(ast, state, node, expected)
    }
    let option_inner = cg_option_inner(expected)
    if option_inner.len() > 0 {
        if item.kind == ak_ident() && item.text == "None" {
            return cg_option_none(state, expected)
        }
        if item.kind == ak_call() {
            let callee = a_child(ast, node, 0)
            if callee >= 0 && ast.nodes[callee].kind == ak_ident() && ast.nodes[callee].text == "Some" {
                let got = item.count - 1
                if got != 1 {
                    return cg_val(cg_error(state, "Some expects one argument"), "0")
                }
                let value = cg_expr_expected(ast, state, a_child(ast, node, 1), option_inner)
                return cg_option_some(value.state, expected, value)
            }
        }
    }
    let result_ok = cg_result_ok(expected)
    let result_err = cg_result_err(expected)
    if result_ok.len() > 0 && result_err.len() > 0 && item.kind == ak_call() {
        let callee = a_child(ast, node, 0)
        if callee >= 0 && ast.nodes[callee].kind == ak_ident() {
            let name = ast.nodes[callee].text
            if name == "Ok" || name == "Err" {
                let got = item.count - 1
                if got != 1 {
                    return cg_val(cg_error(state, name + " expects one argument"), "0")
                }
                let payload_type = if name == "Ok" { result_ok } else { result_err }
                let value = cg_expr_expected(ast, state, a_child(ast, node, 1), payload_type)
                if name == "Ok" {
                    return cg_make_result_ok(value.state, expected, value)
                }
                return cg_make_result_err(value.state, expected, value)
            }
        }
    }
    return cg_expr2(ast, state, node)
}

fn cg_tuple_lit(ast: Ast, state: CgState, node: Int) -> CgVal {
    let count = ast.nodes[node].count
    if count == 0 {
        return cg_val_typed(state, "", "void")
    }
    var work = state
    var values: List<CgVal> = []
    var i = 0
    while i < count {
        let value = cg_expr2(ast, work, a_child(ast, node, i))
        work = value.state
        if work.error.len() > 0 {
            return cg_val(work, "0")
        }
        values.push(value)
        i = i + 1
    }
    var ty = "{ "
    i = 0
    while i < count {
        if i > 0 {
            ty = ty + ", "
        }
        ty = ty + values[i].ty
        i = i + 1
    }
    ty = ty + " }"
    var aggregate = "undef"
    i = 0
    while i < count {
        let temp_result = cg_temp(work)
        work = temp_result.0
        let temp = temp_result.1
        work = cg_line(work, "  " + temp + " = insertvalue " + ty + " " + aggregate + ", " + values[i].ty + " " + values[i].value + ", " + i.to_string())
        aggregate = temp
        i = i + 1
    }
    return cg_val_typed(work, aggregate, ty)
}

fn cg_list_slice(ast: Ast, state: CgState, node: Int, base_node: Int, range_node: Int) -> CgVal {
    let base = cg_expr2(ast, state, base_node)
    let start = cg_expr2(ast, base.state, a_child(ast, range_node, 0))
    let end = cg_expr2(ast, start.state, a_child(ast, range_node, 1))
    if base.ty != "%nova.list" {
        return cg_val(cg_error(end.state, "slicing expects List<Int>"), "0")
    }
    if start.ty != "i64" || end.ty != "i64" {
        return cg_val(cg_error(end.state, "slice bounds must be Int"), "0")
    }
    let base_slot_result = cg_entry_slot(end.state, "%nova.list")
    var work = base_slot_result.0
    let base_slot = base_slot_result.1
    work = cg_line(work, "  store %nova.list " + base.value + ", ptr " + base_slot)
    let result_slot_result = cg_entry_slot(work, "%nova.list")
    work = result_slot_result.0
    let result_slot = result_slot_result.1
    work = cg_line(work, "  store %nova.list zeroinitializer, ptr " + result_slot)
    let elem_slot_result = cg_entry_slot(work, "i64")
    work = elem_slot_result.0
    let elem_slot = elem_slot_result.1
    let index_slot_result = cg_entry_slot(work, "i64")
    work = index_slot_result.0
    let index_slot = index_slot_result.1
    work = cg_line(work, "  store i64 " + start.value + ", ptr " + index_slot)
    let header_result = cg_label(work)
    work = header_result.0
    let header = header_result.1
    let body_result = cg_label(work)
    work = body_result.0
    let body = body_result.1
    let done_result = cg_label(work)
    work = done_result.0
    let done = done_result.1
    work = cg_line(work, "  br label %" + header)
    work = cg_line(work, header + ":")
    let index_load_result = cg_temp(work)
    work = index_load_result.0
    let index_load = index_load_result.1
    work = cg_line(work, "  " + index_load + " = load i64, ptr " + index_slot)
    let condition_result = cg_temp(work)
    work = condition_result.0
    let condition = condition_result.1
    work = cg_line(work, "  " + condition + " = icmp slt i64 " + index_load + ", " + end.value)
    work = cg_line(work, "  br i1 " + condition + ", label %" + body + ", label %" + done)
    work = cg_line(work, body + ":")
    let ptr_result = cg_temp(work)
    work = ptr_result.0
    let ptr = ptr_result.1
    work = cg_line(
        work,
        "  " + ptr + " = call ptr @nova_list_at(ptr " + base_slot + ", i64 " + index_load + ", i64 8, i64 " + ast.nodes[node].line.to_string() + ")",
    )
    let value_result = cg_temp(work)
    work = value_result.0
    let value = value_result.1
    work = cg_line(work, "  " + value + " = load i64, ptr " + ptr)
    work = cg_line(work, "  store i64 " + value + ", ptr " + elem_slot)
    work = cg_line(work, "  call void @nova_list_push(ptr " + result_slot + ", ptr " + elem_slot + ", i64 8)")
    let next_result = cg_temp(work)
    work = next_result.0
    let next = next_result.1
    work = cg_line(work, "  " + next + " = add i64 " + index_load + ", 1")
    work = cg_line(work, "  store i64 " + next + ", ptr " + index_slot)
    work = cg_line(work, "  br label %" + header)
    work = cg_line(work, done + ":")
    let result_result = cg_temp(work)
    work = result_result.0
    let result = result_result.1
    work = cg_line(work, "  " + result + " = load %nova.list, ptr " + result_slot)
    return cg_val_typed(work, result, "%nova.list")
}

fn cg_bounds_check(state: CgState, index: String, len: String, line: String) -> CgState {
    let neg_result = cg_temp(state)
    var work = neg_result.0
    let neg = neg_result.1
    work = cg_line(work, "  " + neg + " = icmp slt i64 " + index + ", 0")
    let too_big_result = cg_temp(work)
    work = too_big_result.0
    let too_big = too_big_result.1
    work = cg_line(work, "  " + too_big + " = icmp sge i64 " + index + ", " + len)
    let oob_result = cg_temp(work)
    work = oob_result.0
    let oob = oob_result.1
    work = cg_line(work, "  " + oob + " = or i1 " + neg + ", " + too_big)
    let ok_result = cg_label(work)
    work = ok_result.0
    let ok = ok_result.1
    let bad_result = cg_label(work)
    work = bad_result.0
    let bad = bad_result.1
    work = cg_line(work, "  br i1 " + oob + ", label %" + bad + ", label %" + ok)
    work = cg_line(work, bad + ":")
    work = cg_line(work, "  call void @nova_panic_bounds(i64 " + index + ", i64 " + len + ", i64 " + line + ")")
    work = cg_line(work, "  unreachable")
    work = cg_line(work, ok + ":")
    return work
}

fn cg_index(ast: Ast, state: CgState, node: Int) -> CgVal {
    let index_node = a_child(ast, node, 1)
    if index_node >= 0 && ast.nodes[index_node].kind == ak_binary() && ast.nodes[index_node].text == ".." {
        return cg_list_slice(ast, state, node, a_child(ast, node, 0), index_node)
    }
    let base = cg_expr2(ast, state, a_child(ast, node, 0))
    let index = cg_expr2(ast, base.state, a_child(ast, node, 1))
    let array = cg_array_layout(base.source)
    if array.1 >= 0 {
        if index.ty != "i64" {
            return cg_val(cg_error(index.state, "array index must be Int"), "0")
        }
        let elem_ty = cg_llvm_type_in(index.state.structs, index.state.enums, array.0)
        let slot_result = cg_entry_slot(index.state, base.ty)
        var work = slot_result.0
        let slot = slot_result.1
        work = cg_line(work, "  store " + base.ty + " " + base.value + ", ptr " + slot)
        work = cg_bounds_check(work, index.value, array.1.to_string(), ast.nodes[node].line.to_string())
        let ptr_result = cg_temp(work)
        work = ptr_result.0
        let ptr = ptr_result.1
        work = cg_line(work, "  " + ptr + " = getelementptr " + base.ty + ", ptr " + slot + ", i64 0, i64 " + index.value)
        let val_result = cg_temp(work)
        work = val_result.0
        let val = val_result.1
        work = cg_line(work, "  " + val + " = load " + elem_ty + ", ptr " + ptr)
        return cg_val_from_source(work, val, array.0)
    }
    let slice_elem = cg_slice_elem(base.source)
    if slice_elem.len() > 0 {
        if index.ty != "i64" {
            return cg_val(cg_error(index.state, "slice index must be Int"), "0")
        }
        if base.elem.len() == 0 {
            return cg_val(cg_error(index.state, "slice element type is unknown"), "0")
        }
        let elem_ty = cg_llvm_type_in(index.state.structs, index.state.enums, base.elem)
        let data_result = cg_temp(index.state)
        var work = data_result.0
        let data = data_result.1
        work = cg_line(work, "  " + data + " = extractvalue %nova.slice " + base.value + ", 0")
        let len_result = cg_temp(work)
        work = len_result.0
        let len = len_result.1
        work = cg_line(work, "  " + len + " = extractvalue %nova.slice " + base.value + ", 1")
        work = cg_bounds_check(work, index.value, len, ast.nodes[node].line.to_string())
        let ptr_result = cg_temp(work)
        work = ptr_result.0
        let ptr = ptr_result.1
        work = cg_line(work, "  " + ptr + " = getelementptr " + elem_ty + ", ptr " + data + ", i64 " + index.value)
        let val_result = cg_temp(work)
        work = val_result.0
        let val = val_result.1
        work = cg_line(work, "  " + val + " = load " + elem_ty + ", ptr " + ptr)
        return cg_val_from_source(work, val, slice_elem)
    }
    if base.ty != "%nova.list" {
        return cg_val(cg_error(index.state, "indexing expects a list"), "0")
    }
    if index.ty != "i64" {
        return cg_val(cg_error(index.state, "list index must be Int"), "0")
    }
    if base.elem.len() == 0 {
        return cg_val(cg_error(index.state, "list element type is unknown"), "0")
    }
    let elem_ty = cg_llvm_type_in(index.state.structs, index.state.enums, base.elem)
    if elem_ty == "i64" && base.elem != "Int" {
        return cg_val(cg_error(index.state, "index element " + base.elem + " lowered to i64"), "0")
    }
    let size_result = cg_elem_size(index.state, base.elem)
    var work = size_result.0
    let elem_size = size_result.1
    let list_slot_result = cg_entry_slot(work, "%nova.list")
    work = list_slot_result.0
    let list_slot = list_slot_result.1
    work = cg_line(work, "  store %nova.list " + base.value + ", ptr " + list_slot)
    let ptr_result = cg_temp(work)
    work = ptr_result.0
    let ptr = ptr_result.1
    work = cg_line(
        work,
        "  " + ptr + " = call ptr @nova_list_at(ptr " + list_slot + ", i64 " + index.value + ", i64 " + elem_size + ", i64 " + ast.nodes[node].line.to_string() + ")",
    )
    let val_result = cg_temp(work)
    work = val_result.0
    let val = val_result.1
    work = cg_line(work, "  " + val + " = load " + elem_ty + ", ptr " + ptr)
    return cg_val_from_source(work, val, base.elem)
}

fn cg_index_assign(ast: Ast, state: CgState, target: Int, value_node: Int) -> CgVal {
    let recv = a_child(ast, target, 0)
    if recv < 0 || ast.nodes[recv].kind != ak_ident() {
        return cg_val(cg_error(state, "index assignment requires a mutable list variable"), "0")
    }
    let index = cg_local_index(state.locals, ast.nodes[recv].text)
    if index < 0 {
        return cg_val(cg_error(state, "unknown local " + ast.nodes[recv].text), "0")
    }
    let local = state.locals[index]
    let array = cg_array_layout(local.source)
    if array.1 >= 0 {
        if !local.mutable || local.slot.len() == 0 {
            return cg_val(cg_error(state, "array assignment requires a mutable array variable"), "0")
        }
        let at = cg_expr2(ast, state, a_child(ast, target, 1))
        if at.ty != "i64" {
            return cg_val(cg_error(at.state, "array index must be Int"), "0")
        }
        let value = cg_expr_expected(ast, at.state, value_node, array.0)
        var work = value.state
        let elem_ty = cg_llvm_type_in(work.structs, work.enums, array.0)
        if value.ty != elem_ty {
            return cg_val(cg_error(work, "array element type mismatch"), "0")
        }
        work = cg_bounds_check(work, at.value, array.1.to_string(), ast.nodes[target].line.to_string())
        let ptr_result = cg_temp(work)
        work = ptr_result.0
        let ptr = ptr_result.1
        work = cg_line(work, "  " + ptr + " = getelementptr " + local.ty + ", ptr " + local.slot + ", i64 0, i64 " + at.value)
        work = cg_line(work, "  store " + elem_ty + " " + value.value + ", ptr " + ptr)
        return cg_val_from_source(work, value.value, array.0)
    }
    let slice_elem = cg_slice_elem(local.source)
    if slice_elem.len() > 0 {
        if !local.mutable || local.slot.len() == 0 {
            return cg_val(cg_error(state, "slice assignment requires a mutable slice variable"), "0")
        }
        let at = cg_expr2(ast, state, a_child(ast, target, 1))
        if at.ty != "i64" {
            return cg_val(cg_error(at.state, "slice index must be Int"), "0")
        }
        let value = cg_expr_expected(ast, at.state, value_node, slice_elem)
        var work = value.state
        let elem_ty = cg_llvm_type_in(work.structs, work.enums, slice_elem)
        if value.ty != elem_ty {
            return cg_val(cg_error(work, "slice element type mismatch"), "0")
        }
        let slice_result = cg_temp(work)
        work = slice_result.0
        let slice = slice_result.1
        work = cg_line(work, "  " + slice + " = load %nova.slice, ptr " + local.slot)
        let data_result = cg_temp(work)
        work = data_result.0
        let data = data_result.1
        work = cg_line(work, "  " + data + " = extractvalue %nova.slice " + slice + ", 0")
        let len_result = cg_temp(work)
        work = len_result.0
        let len = len_result.1
        work = cg_line(work, "  " + len + " = extractvalue %nova.slice " + slice + ", 1")
        work = cg_bounds_check(work, at.value, len, ast.nodes[target].line.to_string())
        let ptr_result = cg_temp(work)
        work = ptr_result.0
        let ptr = ptr_result.1
        work = cg_line(work, "  " + ptr + " = getelementptr " + elem_ty + ", ptr " + data + ", i64 " + at.value)
        work = cg_line(work, "  store " + elem_ty + " " + value.value + ", ptr " + ptr)
        return cg_val_from_source(work, value.value, slice_elem)
    }
    if local.ty != "%nova.list" {
        return cg_val(cg_error(state, "index assignment expects a list"), "0")
    }
    if local.elem.len() == 0 {
        return cg_val(cg_error(state, "list element type is unknown"), "0")
    }
    if !local.mutable || local.slot.len() == 0 {
        return cg_val(cg_error(state, "index assignment requires a mutable list variable"), "0")
    }
    let at = cg_expr2(ast, state, a_child(ast, target, 1))
    if at.ty != "i64" {
        return cg_val(cg_error(at.state, "list index must be Int"), "0")
    }
    let value = cg_expr_expected(ast, at.state, value_node, local.elem)
    var work = value.state
    let elem_ty = cg_llvm_type_in(work.structs, work.enums, local.elem)
    if value.ty != elem_ty {
        return cg_val(cg_error(work, "list element type mismatch"), "0")
    }
    let size_result = cg_elem_size(work, local.elem)
    work = size_result.0
    let elem_size = size_result.1
    let ptr_result = cg_temp(work)
    work = ptr_result.0
    let ptr = ptr_result.1
    work = cg_line(
        work,
        "  " + ptr + " = call ptr @nova_list_at(ptr " + local.slot + ", i64 " + at.value + ", i64 " + elem_size + ", i64 " + ast.nodes[target].line.to_string() + ")",
    )
    work = cg_line(work, "  store " + elem_ty + " " + value.value + ", ptr " + ptr)
    return cg_val_from_source(work, value.value, local.elem)
}

fn cg_list_push(ast: Ast, state: CgState, node: Int) -> CgVal {
    let got = ast.nodes[node].count - 1
    if got != 1 {
        return cg_val(cg_error(state, "push expects one argument"), "0")
    }
    let callee = a_child(ast, node, 0)
    let recv = a_child(ast, callee, 0)
    if recv < 0 || ast.nodes[recv].kind != ak_ident() {
        return cg_val(cg_error(state, "push requires a mutable list variable"), "0")
    }
    let index = cg_local_index(state.locals, ast.nodes[recv].text)
    if index < 0 {
        return cg_val(cg_error(state, "unknown local " + ast.nodes[recv].text), "0")
    }
    let local = state.locals[index]
    if local.ty != "%nova.list" {
        return cg_val(cg_error(state, "push expects a list"), "0")
    }
    if local.elem.len() == 0 {
        return cg_val(cg_error(state, "list element type is unknown"), "0")
    }
    if !local.mutable || local.slot.len() == 0 {
        return cg_val(cg_error(state, "push requires a mutable list variable"), "0")
    }
    let value = cg_expr_expected(ast, state, a_child(ast, node, 1), local.elem)
    var work = value.state
    let elem_ty = cg_llvm_type_in(work.structs, work.enums, local.elem)
    if value.ty != elem_ty {
        return cg_val(cg_error(work, "push element type mismatch"), "0")
    }
    let size_result = cg_elem_size(work, local.elem)
    work = size_result.0
    let elem_size = size_result.1
    let elem_result = cg_entry_slot(work, elem_ty)
    work = elem_result.0
    let elem_slot = elem_result.1
    work = cg_line(work, "  store " + elem_ty + " " + value.value + ", ptr " + elem_slot)
    work = cg_line(work, "  call void @nova_list_push(ptr " + local.slot + ", ptr " + elem_slot + ", i64 " + elem_size + ")")
    return cg_val_typed(work, "", "void")
}

fn cg_branch_expr(ast: Ast, state: CgState, node: Int) -> CgVal {
    if node < 0 || node >= ast.nodes.len() {
        return cg_val(cg_error(state, "invalid if expression branch"), "0")
    }
    let item = ast.nodes[node]
    if item.kind == ak_block() {
        if item.count == 0 {
            return cg_val_typed(state, "", "void")
        }
        var work = state
        var i = 0
        while i < item.count - 1 {
            work = cg_stmt(ast, work, a_child(ast, node, i))
            if work.error.len() > 0 || work.terminated {
                return cg_val_typed(work, "", "void")
            }
            i = i + 1
        }
        let last = a_child(ast, node, item.count - 1)
        if last >= 0 && ast.nodes[last].kind == ak_expr_stmt() {
            return cg_expr2(ast, work, a_child(ast, last, 0))
        }
        if last >= 0 && ast.nodes[last].kind == ak_if() {
            return cg_if_expr(ast, work, last)
        }
        return cg_val_typed(work, "", "void")
    }
    if item.kind == ak_if() {
        return cg_if_expr(ast, state, node)
    }
    return cg_expr2(ast, state, node)
}

fn cg_if_expr(ast: Ast, state: CgState, node: Int) -> CgVal {
    let item = ast.nodes[node]
    if item.count < 2 {
        return cg_val(cg_error(state, "if expression needs a condition and body"), "0")
    }
    let cond = cg_expr2(ast, state, a_child(ast, node, 0))
    var work = cond.state
    if work.error.len() > 0 {
        return cg_val(work, "0")
    }
    if cond.ty != "i1" {
        return cg_val(cg_error(work, "if condition must be Bool"), "0")
    }
    let then_result = cg_label(work)
    work = then_result.0
    let then_label = then_result.1
    let else_result = cg_label(work)
    work = else_result.0
    let else_label = else_result.1
    let merge_result = cg_label(work)
    work = merge_result.0
    let merge_label = merge_result.1
    work = cg_line(work, "  br i1 " + cond.value + ", label %" + then_label + ", label %" + else_label)
    work = cg_line(work, then_label + ":")
    let then_value = cg_branch_expr(ast, work, a_child(ast, node, 1))
    work = then_value.state
    if work.error.len() > 0 {
        return cg_val(work, "0")
    }
    if work.terminated {
        return cg_val(cg_error(work, "if expression branch terminates"), "0")
    }
    var slot = ""
    if then_value.ty != "void" {
        let slot_result = cg_entry_slot(work, then_value.ty)
        work = slot_result.0
        slot = slot_result.1
        work = cg_line(work, "  store " + then_value.ty + " " + then_value.value + ", ptr " + slot)
    }
    work = cg_line(work, "  br label %" + merge_label)
    work = cg_line(work, else_label + ":")
    if item.count > 2 {
        let else_value = cg_branch_expr(ast, work, a_child(ast, node, 2))
        work = else_value.state
        if work.error.len() > 0 {
            return cg_val(work, "0")
        }
        if work.terminated {
            return cg_val(cg_error(work, "if expression branch terminates"), "0")
        }
        if else_value.ty != then_value.ty {
            return cg_val(cg_error(work, "if expression branches have incompatible types"), "0")
        }
        if else_value.ty != "void" {
            work = cg_line(work, "  store " + else_value.ty + " " + else_value.value + ", ptr " + slot)
        }
    } else if then_value.ty != "void" {
        return cg_val(cg_error(work, "if expression without else must be Unit"), "0")
    }
    work = cg_line(work, "  br label %" + merge_label)
    work = cg_line(work, merge_label + ":")
    if then_value.ty == "void" {
        return cg_val_typed(work, "", "void")
    }
    let result_result = cg_temp(work)
    work = result_result.0
    let result = result_result.1
    work = cg_line(work, "  " + result + " = load " + then_value.ty + ", ptr " + slot)
    return CgVal { state: work, value: result, ty: then_value.ty, elem: then_value.elem, source: then_value.source }
}

fn cg_logical(ast: Ast, state: CgState, node: Int, is_and: Bool) -> CgVal {
    let left = cg_expr2(ast, state, a_child(ast, node, 0))
    var work = left.state
    if left.ty != "i1" {
        return cg_val(cg_error(work, "logical operands must be Bool"), "0")
    }
    let slot_result = cg_entry_slot(work, "i1")
    work = slot_result.0
    let slot = slot_result.1
    work = cg_line(work, "  store i1 " + left.value + ", ptr " + slot)
    let right_result = cg_label(work)
    work = right_result.0
    let right_label = right_result.1
    let end_result = cg_label(work)
    work = end_result.0
    let end_label = end_result.1
    if is_and {
        work = cg_line(work, "  br i1 " + left.value + ", label %" + right_label + ", label %" + end_label)
    } else {
        work = cg_line(work, "  br i1 " + left.value + ", label %" + end_label + ", label %" + right_label)
    }
    work = cg_line(work, right_label + ":")
    let right = cg_expr2(ast, work, a_child(ast, node, 1))
    work = right.state
    if right.ty != "i1" {
        return cg_val(cg_error(work, "logical operands must be Bool"), "0")
    }
    work = cg_line(work, "  store i1 " + right.value + ", ptr " + slot)
    work = cg_line(work, "  br label %" + end_label)
    work = cg_line(work, end_label + ":")
    let result_result = cg_temp(work)
    work = result_result.0
    let result = result_result.1
    work = cg_line(work, "  " + result + " = load i1, ptr " + slot)
    return cg_val_typed(work, result, "i1")
}

fn cg_compile(source: String) -> CgResult {
    let ast = a_parse(source)
    if ast.errors.len() > 0 {
        return CgResult { ir: "", error: ast.errors[0] }
    }
    var structs: List<CgStruct> = []
    var enums: List<CgEnum> = []
    let file = ast.nodes.len() - 1
    var i = 0
    while i < ast.nodes[file].count {
        let node = a_child(ast, file, i)
        let item = ast.nodes[node]
        if item.kind == ak_enum() {
            if cg_enum_index(enums, item.text) >= 0 {
                return CgResult { ir: "", error: "duplicate enum " + item.text }
            }
            var variants: List<String> = []
            var payload_types: List<String> = []
            var payload_counts: List<Int> = []
            var payload_offsets: List<Int> = []
            var k = 0
            while k < item.count {
                let variant = ast.nodes[a_child(ast, node, k)]
                if cg_has_name(variants, variant.text) {
                    return CgResult { ir: "", error: "duplicate variant " + variant.text + " on " + item.text }
                }
                let types = cg_split_types(variant.aux)
                variants.push(variant.text)
                payload_offsets.push(payload_types.len())
                payload_counts.push(types.len())
                for payload_type in types {
                    payload_types.push(payload_type)
                }
                k = k + 1
            }
            enums.push(
                CgEnum {
                    name: item.text,
                    variants: variants,
                    payload_types: payload_types,
                    payload_counts: payload_counts,
                    payload_offsets: payload_offsets,
                    index: enums.len(),
                }
            )
        } else if item.kind == ak_struct() {
            if cg_struct_index(structs, item.text) >= 0 {
                return CgResult { ir: "", error: "duplicate struct " + item.text }
            }
            var fields: List<String> = []
            var types: List<String> = []
            var k = 0
            while k < item.count {
                let field = ast.nodes[a_child(ast, node, k)]
                if cg_has_name(fields, field.text) {
                    return CgResult { ir: "", error: "duplicate field " + field.text + " on " + item.text }
                }
                fields.push(field.text)
                types.push(field.aux)
                k = k + 1
            }
            structs.push(CgStruct { name: item.text, fields: fields, types: types, index: structs.len() })
        }
        i = i + 1
    }
    var s = 0
    while s < structs.len() {
        var k = 0
        while k < structs[s].fields.len() {
            if !cg_supported_type(structs, enums, structs[s].types[k]) {
                return CgResult { ir: "", error: "unsupported type " + structs[s].types[k] + " on field " + structs[s].fields[k] }
            }
            if cg_struct_cycle(structs, structs[s].name, structs[s].name, [structs[s].name]) {
                return CgResult { ir: "", error: "recursive struct " + structs[s].name + " has no finite layout" }
            }
            k = k + 1
        }
        s = s + 1
    }
    var enum_validation = 0
    while enum_validation < enums.len() {
        for payload_type in enums[enum_validation].payload_types {
            if payload_type != "Int" && payload_type != "Bool" && payload_type != "String" && cg_struct_index(structs, payload_type) < 0 {
                return CgResult { ir: "", error: "unsupported enum payload type " + payload_type }
            }
        }
        enum_validation = enum_validation + 1
    }
    var fns: List<CgSig> = []
    i = 0
    while i < ast.nodes[file].count {
        let node = a_child(ast, file, i)
        let item = ast.nodes[node]
        if item.kind == ak_fn() {
            var ret = item.aux
            if ret == "" {
                ret = "Unit"
            }
            if !cg_supported_type(structs, enums, ret) {
                return CgResult { ir: "", error: "unsupported return type on " + item.text }
            }
            if cg_fn_index(fns, item.text) >= 0 {
                return CgResult { ir: "", error: "duplicate function " + item.text }
            }
            var params: List<String> = []
            var param_types: List<String> = []
            var k = 0
            while k < item.count - 1 {
                let param = ast.nodes[a_child(ast, node, k)]
                if !cg_supported_type(structs, enums, param.aux) || param.aux == "Unit" || param.aux == "" {
                    return CgResult { ir: "", error: "unsupported parameter type on " + param.text }
                }
                params.push(param.text)
                param_types.push(param.aux)
                k = k + 1
            }
            let index = fns.len()
            fns.push(CgSig { name: item.text, params: params, param_types: param_types, ret: ret, body: a_child(ast, node, item.count - 1), index: index, external: false, captures: [], capture_types: [], closure: false })
        } else if item.kind == ak_extern() {
            var ret = item.aux
            if ret == "" {
                ret = "Unit"
            }
            if !cg_supported_type(structs, enums, ret) {
                return CgResult { ir: "", error: "unsupported extern return type on " + item.text }
            }
            if cg_fn_index(fns, item.text) >= 0 {
                return CgResult { ir: "", error: "duplicate function " + item.text }
            }
            var params: List<String> = []
            var param_types: List<String> = []
            var k = 0
            while k < item.count {
                let param = ast.nodes[a_child(ast, node, k)]
                if !cg_supported_type(structs, enums, param.aux) || param.aux == "Unit" || param.aux == "" {
                    return CgResult { ir: "", error: "unsupported extern parameter type on " + param.text }
                }
                params.push(param.text)
                param_types.push(param.aux)
                k = k + 1
            }
            let index = fns.len()
            fns.push(CgSig { name: item.text, params: params, param_types: param_types, ret: ret, body: 0 - 1, index: index, external: true, captures: [], capture_types: [], closure: false })
        }
        i = i + 1
    }
    i = 0
    while i < ast.nodes[file].count {
        let node = a_child(ast, file, i)
        let item = ast.nodes[node]
        if item.kind == ak_impl() {
            var k = 0
            while k < item.count {
                let method_node = a_child(ast, node, k)
                let method = ast.nodes[method_node]
                let symbol = item.text + "." + method.text
                var ret = method.aux
                if ret == "" {
                    ret = "Unit"
                }
                if !cg_supported_type(structs, enums, ret) {
                    return CgResult { ir: "", error: "unsupported return type on " + symbol }
                }
                if cg_fn_index(fns, symbol) >= 0 {
                    return CgResult { ir: "", error: "duplicate method " + symbol }
                }
                var params: List<String> = []
                var param_types: List<String> = []
                var p = 0
                while p < method.count - 1 {
                    let param = ast.nodes[a_child(ast, method_node, p)]
                    var param_type = param.aux
                    if param.text == "self" && param_type.len() == 0 {
                        param_type = item.text
                    }
                    if !cg_supported_type(structs, enums, param_type) || param_type == "Unit" || param_type == "" {
                        return CgResult { ir: "", error: "unsupported parameter type on " + symbol }
                    }
                    params.push(param.text)
                    param_types.push(param_type)
                    p = p + 1
                }
                let index = fns.len()
                fns.push(CgSig { name: symbol, params: params, param_types: param_types, ret: ret, body: a_child(ast, method_node, method.count - 1), index: index, external: false, captures: [], capture_types: [], closure: false })
                k = k + 1
            }
        }
        i = i + 1
    }
    if cg_fn_index(fns, "main") < 0 {
        return CgResult { ir: "", error: "missing fn main()" }
    }
    let main_index = cg_fn_index(fns, "main")
    if fns[main_index].params.len() != 0 {
        return CgResult { ir: "", error: "main must take no parameters" }
    }
    var out = "; generated by Nova codegen (CODEGEN-01.01)\n"
    out = out + "%nova.string = type { ptr, i64 }\n"
    out = out + "%nova.list = type { ptr, i64, i64 }\n"
    out = out + "%nova.slice = type { ptr, i64 }\n"
    out = out + "%nova.map = type { ptr, ptr, i64, i64, i64, i32 }\n"
    out = out + "%nova.fn = type { ptr, ptr }\n"
    var type_index = 0
    while type_index < structs.len() {
        var line = "%nova.struct." + structs[type_index].name + " = type { "
        var field_index = 0
        while field_index < structs[type_index].fields.len() {
            if field_index > 0 {
                line = line + ", "
            }
            line = line + cg_llvm_type_in(structs, enums, structs[type_index].types[field_index])
            field_index = field_index + 1
        }
        line = line + " }\n"
        out = out + line
        type_index = type_index + 1
    }
    var enum_index = 0
    while enum_index < enums.len() {
        var line = "%nova.enum." + enums[enum_index].name + " = type { i32"
        var payload = 0
        let arity = cg_enum_slot_count(structs, enums[enum_index])
        while payload < arity {
            line = line + ", i64"
            payload = payload + 1
        }
        line = line + " }\n"
        out = out + line
        enum_index = enum_index + 1
    }
    out = out + "declare void @llvm.trap()\n"
    out = out + "declare ptr @malloc(i64)\n"
    out = out + "declare ptr @nova_list_at(ptr, i64, i64, i64)\n"
    out = out + "declare void @nova_list_push(ptr, ptr, i64)\n"
    out = out + "declare void @nova_list_clone(ptr, ptr, i64)\n"
    out = out + "declare void @nova_map_insert(ptr, ptr)\n"
    out = out + "declare i32 @nova_map_add(ptr, ptr)\n"
    out = out + "declare ptr @nova_map_get(ptr, ptr)\n"
    out = out + "declare i64 @nova_map_len(ptr)\n"
    out = out + "declare void @nova_panic_str(%nova.string, i64)\n"
    out = out + "declare void @nova_panic_bounds(i64, i64, i64)\n"
    out = out + "declare %nova.string @nova_string_concat(%nova.string, %nova.string)\n"
    out = out + "declare i32 @nova_string_eq(%nova.string, %nova.string)\n"
    out = out + "declare i32 @nova_string_contains(%nova.string, %nova.string)\n"
    out = out + "declare i32 @nova_string_starts_with(%nova.string, %nova.string)\n"
    out = out + "declare i32 @nova_string_ends_with(%nova.string, %nova.string)\n"
    out = out + "declare %nova.string @nova_string_trim(%nova.string)\n"
    out = out + "declare %nova.string @nova_string_trim_start(%nova.string)\n"
    out = out + "declare %nova.string @nova_string_trim_end(%nova.string)\n"
    out = out + "declare %nova.string @nova_string_replace(%nova.string, %nova.string, %nova.string)\n"
    out = out + "declare %nova.string @nova_string_lower(%nova.string)\n"
    out = out + "declare %nova.string @nova_string_upper(%nova.string)\n"
    out = out + "declare void @nova_string_bytes(%nova.string, ptr)\n"
    out = out + "declare void @nova_string_from_bytes(ptr, ptr)\n"
    out = out + "declare %nova.string @nova_i64_to_string(i64)\n"
    out = out + "declare %nova.string @nova_bool_to_string(i32)\n"
    out = out + "declare %nova.string @nova_char_to_string(i32)\n"
    out = out + "declare %nova.string @nova_json_string(%nova.string, %nova.string)\n"
    out = out + "declare %nova.string @nova_http_get(%nova.string)\n"
    out = out + "declare void @nova_string_chars(%nova.string, ptr)\n"
    out = out + "declare void @nova_string_split(%nova.string, %nova.string, ptr)\n"
    out = out + "declare %nova.string @nova_string_join(ptr, %nova.string)\n"
    out = out + "declare void @nova_list_sort(ptr, ptr)\n"
    out = out + "declare void @nova_print_str(%nova.string, i32, i32)\n"
    out = out + "declare void @nova_print_i64(i64, i32, i32)\n"
    out = out + "declare void @nova_print_bool(i32, i32, i32)\n"
    out = out + "declare void @nova_assert_fail(i64)\n"
    var extern_index = 0
    while extern_index < fns.len() {
        let sig = fns[extern_index]
        if sig.external {
            var line = "declare " + cg_llvm_type_in(structs, enums, sig.ret) + " @" + sig.name + "("
            var k = 0
            while k < sig.param_types.len() {
                if k > 0 {
                    line = line + ", "
                }
                line = line + cg_llvm_type_in(structs, enums, sig.param_types[k])
                k = k + 1
            }
            out = out + line + ")\n"
        }
        extern_index = extern_index + 1
    }
    var bodies: List<String> = []
    var emitted = 0
    while emitted < fns.len() {
        let sig = fns[emitted]
        if !sig.external {
            let function = cg_emit_fn(ast, fns, structs, enums, sig)
            if function.error.len() > 0 {
                return CgResult { ir: "", error: function.error }
            }
            bodies.push(function.ir)
        }
        emitted = emitted + 1
    }
    out = out + bodies.join("\n") + "\n"
    out = out + "define i32 @main() {\n"
    if fns[main_index].ret == "Unit" {
        out = out + "  call void @nova_user_" + fns[main_index].index.to_string() + "(ptr null)\n"
        out = out + "  ret i32 0\n"
    } else if fns[main_index].ret != "Int" {
        let main_ty = cg_llvm_type_in(structs, enums, fns[main_index].ret)
        out = out + "  %nova_result = call " + main_ty + " @nova_user_" + fns[main_index].index.to_string() + "(ptr null)\n"
        out = out + "  ret i32 0\n"
    } else {
        out = out + "  %nova_result = call i64 @nova_user_" + fns[main_index].index.to_string() + "(ptr null)\n"
        out = out + "  %nova_exit = trunc i64 %nova_result to i32\n"
        out = out + "  ret i32 %nova_exit\n"
    }
    out = out + "}\n"
    return CgResult { ir: out, error: "" }
}

fn cg_emit_fn(ast: Ast, fns: List<CgSig>, structs: List<CgStruct>, enums: List<CgEnum>, sig: CgSig) -> CgResult {
    nova_ir_reset()
    var state = CgState {
        lines: [],
        entry: [],
        temps: 0,
        slots: 0,
        locals: [],
        fns: fns,
        structs: structs,
        enums: enums,
        globals: [],
        strings: 0,
        fn_index: sig.index,
        ret: sig.ret,
        terminated: false,
        error: "",
        breaks: [],
        continues: [],
    }
    var i = 0
    while i < sig.params.len() {
        // Parameters are immutable Nova values: keep them in SSA instead of
        // spilling to the stack.
        var locals = state.locals
        locals.push(CgLocal { name: sig.params[i], ty: cg_llvm_type_in(structs, enums, sig.param_types[i]), slot: "", value: "%p" + i.to_string(), mutable: false, elem: cg_list_elem(sig.param_types[i]), source: sig.param_types[i] })
        state = cg_state(state, state.lines, state.temps, state.slots, locals, state.terminated, state.error)
        i = i + 1
    }
    if sig.closure {
        let layout = cg_capture_layout(structs, enums, sig.capture_types)
        var c = 0
        while c < sig.captures.len() {
            let capture_ty = cg_llvm_type_in(structs, enums, sig.capture_types[c])
            let pointer_result = cg_temp(state)
            state = pointer_result.0
            let pointer = pointer_result.1
            state = cg_line(state, "  " + pointer + " = getelementptr i8, ptr %arg_env, i64 " + layout.0[c].to_string())
            let value_result = cg_temp(state)
            state = value_result.0
            let value = value_result.1
            state = cg_line(state, "  " + value + " = load " + capture_ty + ", ptr " + pointer)
            var locals = state.locals
            locals.push(CgLocal { name: sig.captures[c], ty: capture_ty, slot: "", value: value, mutable: false, elem: cg_list_elem(sig.capture_types[c]), source: sig.capture_types[c] })
            state = cg_state(state, state.lines, state.temps, state.slots, locals, state.terminated, state.error)
            c = c + 1
        }
    }
    state = cg_block(ast, state, sig.body)
    if state.error.len() > 0 {
        return CgResult { ir: "", error: "in " + sig.name + ": " + state.error }
    }
    if !state.terminated {
        if sig.ret == "Unit" {
            state = cg_line(state, "  ret void")
            state = cg_state(state, state.lines, state.temps, state.slots, state.locals, true, state.error)
        } else {
            return CgResult { ir: "", error: "function " + sig.name + " does not end with return" }
        }
    }
    let symbol = cg_sig_symbol(sig)
    let ret_llvm = cg_llvm_type_in(structs, enums, sig.ret)
    let body = state.lines.join("\n")
    var text = ""
    for global in state.globals {
        text = text + global + "\n"
    }
    text = text + "define " + ret_llvm + " @" + symbol + "(ptr %arg_env"
    var k = 0
    while k < sig.params.len() {
        text = text + ", " + cg_llvm_type_in(structs, enums, sig.param_types[k]) + " %p" + k.to_string()
        k = k + 1
    }
    text = text + ") {\n"
    for entry_line in state.entry {
        text = text + entry_line + "\n"
    }
    text = text + body
    text = text + "}"
    return CgResult { ir: text, error: "" }
}

fn cg_block(ast: Ast, state: CgState, node: Int) -> CgState {
    var work = state
    var i = 0
    while i < ast.nodes[node].count && !work.terminated && work.error.len() == 0 {
        work = cg_stmt(ast, work, a_child(ast, node, i))
        i = i + 1
    }
    return work
}

fn cg_if(ast: Ast, state: CgState, node: Int) -> CgState {
    let item = ast.nodes[node]
    let cond = cg_expr2(ast, state, a_child(ast, node, 0))
    if cond.state.error.len() > 0 {
        return cond.state
    }
    if cond.ty != "i1" {
        return cg_error(cond.state, "if condition must be Bool")
    }
    var work = cond.state
    let then_result = cg_label(work)
    work = then_result.0
    let then_label = then_result.1
    let else_result = cg_label(work)
    work = else_result.0
    let else_label = else_result.1
    let end_result = cg_label(work)
    work = end_result.0
    let end_label = end_result.1
    work = cg_line(work, "  br i1 " + cond.value + ", label %" + then_label + ", label %" + else_label)
    work = cg_state(work, work.lines, work.temps, work.slots, work.locals, false, work.error)
    work = cg_line(work, then_label + ":")
    let then_state = cg_block(ast, work, a_child(ast, node, 1))
    let then_terminated = then_state.terminated
    work = cg_state(then_state, then_state.lines, then_state.temps, then_state.slots, then_state.locals, false, then_state.error)
    if !then_terminated {
        work = cg_line(work, "  br label %" + end_label)
    }
    work = cg_line(work, else_label + ":")
    var else_terminated = false
    if item.count > 2 {
        let other = a_child(ast, node, 2)
        if ast.nodes[other].kind == ak_if() {
            let nested = cg_stmt(ast, work, other)
            else_terminated = nested.terminated
            work = cg_state(nested, nested.lines, nested.temps, nested.slots, nested.locals, false, nested.error)
        } else {
            let nested = cg_block(ast, work, other)
            else_terminated = nested.terminated
            work = cg_state(nested, nested.lines, nested.temps, nested.slots, nested.locals, false, nested.error)
        }
        if !else_terminated {
            work = cg_line(work, "  br label %" + end_label)
        }
    } else {
        work = cg_line(work, "  br label %" + end_label)
    }
    if then_terminated && else_terminated {
        return cg_state(work, work.lines, work.temps, work.slots, work.locals, true, work.error)
    }
    work = cg_line(work, end_label + ":")
    return cg_state(work, work.lines, work.temps, work.slots, work.locals, false, work.error)
}

fn cg_while(ast: Ast, state: CgState, node: Int) -> CgState {
    let item = ast.nodes[node]
    let header_result = cg_label(state)
    var work = header_result.0
    let header = header_result.1
    let body_result = cg_label(work)
    work = body_result.0
    let body = body_result.1
    let end_result = cg_label(work)
    work = end_result.0
    let end_label = end_result.1
    work = cg_line(work, "  br label %" + header)
    work = cg_line(work, header + ":")
    let cond = cg_expr2(ast, work, a_child(ast, node, 0))
    if cond.state.error.len() > 0 {
        return cond.state
    }
    if cond.ty != "i1" {
        return cg_error(cond.state, "while condition must be Bool")
    }
    work = cg_line(cond.state, "  br i1 " + cond.value + ", label %" + body + ", label %" + end_label)
    work = cg_line(work, body + ":")
    work = cg_loop_enter(work, end_label, header)
    let body_state = cg_block(ast, work, a_child(ast, node, 1))
    let body_ended = body_state.terminated
    work = cg_loop_exit(body_state)
    if !body_ended {
        work = cg_line(work, "  br label %" + header)
    }
    work = cg_line(work, end_label + ":")
    return cg_state(work, work.lines, work.temps, work.slots, work.locals, false, work.error)
}

fn cg_for_range(ast: Ast, state: CgState, node: Int, iter: Int) -> CgState {
    let start = cg_expr2(ast, state, a_child(ast, iter, 0))
    let end = cg_expr2(ast, start.state, a_child(ast, iter, 1))
    var work = end.state
    if work.error.len() > 0 {
        return work
    }
    if start.ty != "i64" || end.ty != "i64" {
        return cg_error(work, "for range bounds must be Int")
    }
    let slot_result = cg_slot(work)
    work = slot_result.0
    let slot = slot_result.1
    work = cg_line(work, "  " + slot + " = alloca i64")
    work = cg_line(work, "  store i64 " + start.value + ", ptr " + slot)
    let base = work.locals.len()
    var locals = work.locals
    locals.push(CgLocal { name: ast.nodes[node].text, ty: "i64", slot: slot, value: "", mutable: false, elem: "", source: "Int" })
    work = cg_state(work, work.lines, work.temps, work.slots, locals, work.terminated, work.error)

    let header_result = cg_label(work)
    work = header_result.0
    let header = header_result.1
    let body_result = cg_label(work)
    work = body_result.0
    let body = body_result.1
    let step_result = cg_label(work)
    work = step_result.0
    let step = step_result.1
    let end_result = cg_label(work)
    work = end_result.0
    let end_label = end_result.1

    work = cg_line(work, "  br label %" + header)
    work = cg_line(work, header + ":")
    let current_result = cg_temp(work)
    work = current_result.0
    let current = current_result.1
    work = cg_line(work, "  " + current + " = load i64, ptr " + slot)
    let cond_result = cg_temp(work)
    work = cond_result.0
    let cond = cond_result.1
    work = cg_line(work, "  " + cond + " = icmp slt i64 " + current + ", " + end.value)
    work = cg_line(work, "  br i1 " + cond + ", label %" + body + ", label %" + end_label)
    work = cg_line(work, body + ":")
    work = cg_loop_enter(work, end_label, step)
    let body_state = cg_block(ast, work, a_child(ast, node, 1))
    if body_state.error.len() > 0 {
        return body_state
    }
    let body_ended = body_state.terminated
    work = cg_loop_exit(body_state)
    if !body_ended {
        work = cg_line(work, "  br label %" + step)
    }
    work = cg_line(work, step + ":")
    let step_value_result = cg_temp(work)
    work = step_value_result.0
    let step_value = step_value_result.1
    work = cg_line(work, "  " + step_value + " = load i64, ptr " + slot)
    let next_result = cg_temp(work)
    work = next_result.0
    let next = next_result.1
    work = cg_line(work, "  " + next + " = add i64 " + step_value + ", 1")
    work = cg_line(work, "  store i64 " + next + ", ptr " + slot)
    work = cg_line(work, "  br label %" + header)
    work = cg_line(work, end_label + ":")
    return cg_state(work, work.lines, work.temps, work.slots, cg_locals_before(work.locals, base), false, work.error)
}

fn cg_for_array(ast: Ast, state: CgState, node: Int, list: CgVal, elem: String, len: Int) -> CgState {
    let elem_ty = cg_llvm_type_in(state.structs, state.enums, elem)
    let array_slot_result = cg_slot(state)
    var work = array_slot_result.0
    let array_slot = array_slot_result.1
    work = cg_line(work, "  " + array_slot + " = alloca " + list.ty)
    work = cg_line(work, "  store " + list.ty + " " + list.value + ", ptr " + array_slot)
    let index_slot_result = cg_slot(work)
    work = index_slot_result.0
    let index_slot = index_slot_result.1
    work = cg_line(work, "  " + index_slot + " = alloca i64")
    work = cg_line(work, "  store i64 0, ptr " + index_slot)
    let var_slot_result = cg_slot(work)
    work = var_slot_result.0
    let var_slot = var_slot_result.1
    work = cg_line(work, "  " + var_slot + " = alloca " + elem_ty)
    let base = work.locals.len()
    var locals = work.locals
    locals.push(CgLocal { name: ast.nodes[node].text, ty: elem_ty, slot: var_slot, value: "", mutable: false, elem: "", source: elem })
    work = cg_state(work, work.lines, work.temps, work.slots, locals, work.terminated, work.error)

    let header_result = cg_label(work)
    work = header_result.0
    let header = header_result.1
    let body_result = cg_label(work)
    work = body_result.0
    let body = body_result.1
    let step_result = cg_label(work)
    work = step_result.0
    let step = step_result.1
    let end_result = cg_label(work)
    work = end_result.0
    let end_label = end_result.1

    work = cg_line(work, "  br label %" + header)
    work = cg_line(work, header + ":")
    let index_result = cg_temp(work)
    work = index_result.0
    let index = index_result.1
    work = cg_line(work, "  " + index + " = load i64, ptr " + index_slot)
    let cond_result = cg_temp(work)
    work = cond_result.0
    let cond = cond_result.1
    work = cg_line(work, "  " + cond + " = icmp slt i64 " + index + ", " + len.to_string())
    work = cg_line(work, "  br i1 " + cond + ", label %" + body + ", label %" + end_label)
    work = cg_line(work, body + ":")
    let ptr_result = cg_temp(work)
    work = ptr_result.0
    let ptr = ptr_result.1
    work = cg_line(work, "  " + ptr + " = getelementptr " + list.ty + ", ptr " + array_slot + ", i64 0, i64 " + index)
    let element_result = cg_temp(work)
    work = element_result.0
    let element = element_result.1
    work = cg_line(work, "  " + element + " = load " + elem_ty + ", ptr " + ptr)
    work = cg_line(work, "  store " + elem_ty + " " + element + ", ptr " + var_slot)
    work = cg_loop_enter(work, end_label, step)
    let body_state = cg_block(ast, work, a_child(ast, node, 1))
    if body_state.error.len() > 0 {
        return body_state
    }
    let body_ended = body_state.terminated
    work = cg_loop_exit(body_state)
    if !body_ended {
        work = cg_line(work, "  br label %" + step)
    }
    work = cg_line(work, step + ":")
    let step_value_result = cg_temp(work)
    work = step_value_result.0
    let step_value = step_value_result.1
    work = cg_line(work, "  " + step_value + " = load i64, ptr " + index_slot)
    let next_result = cg_temp(work)
    work = next_result.0
    let next = next_result.1
    work = cg_line(work, "  " + next + " = add i64 " + step_value + ", 1")
    work = cg_line(work, "  store i64 " + next + ", ptr " + index_slot)
    work = cg_line(work, "  br label %" + header)
    work = cg_line(work, end_label + ":")
    return cg_state(work, work.lines, work.temps, work.slots, cg_locals_before(work.locals, base), false, work.error)
}

fn cg_for_slice(ast: Ast, state: CgState, node: Int, list: CgVal, elem: String) -> CgState {
    let elem_ty = cg_llvm_type_in(state.structs, state.enums, elem)
    let slice_slot_result = cg_slot(state)
    var work = slice_slot_result.0
    let slice_slot = slice_slot_result.1
    work = cg_line(work, "  " + slice_slot + " = alloca %nova.slice")
    work = cg_line(work, "  store %nova.slice " + list.value + ", ptr " + slice_slot)
    let index_slot_result = cg_slot(work)
    work = index_slot_result.0
    let index_slot = index_slot_result.1
    work = cg_line(work, "  " + index_slot + " = alloca i64")
    work = cg_line(work, "  store i64 0, ptr " + index_slot)
    let var_slot_result = cg_slot(work)
    work = var_slot_result.0
    let var_slot = var_slot_result.1
    work = cg_line(work, "  " + var_slot + " = alloca " + elem_ty)
    let base = work.locals.len()
    var locals = work.locals
    locals.push(CgLocal { name: ast.nodes[node].text, ty: elem_ty, slot: var_slot, value: "", mutable: false, elem: "", source: elem })
    work = cg_state(work, work.lines, work.temps, work.slots, locals, work.terminated, work.error)

    let header_result = cg_label(work)
    work = header_result.0
    let header = header_result.1
    let body_result = cg_label(work)
    work = body_result.0
    let body = body_result.1
    let step_result = cg_label(work)
    work = step_result.0
    let step = step_result.1
    let end_result = cg_label(work)
    work = end_result.0
    let end_label = end_result.1

    work = cg_line(work, "  br label %" + header)
    work = cg_line(work, header + ":")
    let index_result = cg_temp(work)
    work = index_result.0
    let index = index_result.1
    work = cg_line(work, "  " + index + " = load i64, ptr " + index_slot)
    let header_slice_result = cg_temp(work)
    work = header_slice_result.0
    let header_slice = header_slice_result.1
    work = cg_line(work, "  " + header_slice + " = load %nova.slice, ptr " + slice_slot)
    let len_result = cg_temp(work)
    work = len_result.0
    let len = len_result.1
    work = cg_line(work, "  " + len + " = extractvalue %nova.slice " + header_slice + ", 1")
    let cond_result = cg_temp(work)
    work = cond_result.0
    let cond = cond_result.1
    work = cg_line(work, "  " + cond + " = icmp slt i64 " + index + ", " + len)
    work = cg_line(work, "  br i1 " + cond + ", label %" + body + ", label %" + end_label)
    work = cg_line(work, body + ":")
    let body_slice_result = cg_temp(work)
    work = body_slice_result.0
    let body_slice = body_slice_result.1
    work = cg_line(work, "  " + body_slice + " = load %nova.slice, ptr " + slice_slot)
    let data_result = cg_temp(work)
    work = data_result.0
    let data = data_result.1
    work = cg_line(work, "  " + data + " = extractvalue %nova.slice " + body_slice + ", 0")
    let ptr_result = cg_temp(work)
    work = ptr_result.0
    let ptr = ptr_result.1
    work = cg_line(work, "  " + ptr + " = getelementptr " + elem_ty + ", ptr " + data + ", i64 " + index)
    let element_result = cg_temp(work)
    work = element_result.0
    let element = element_result.1
    work = cg_line(work, "  " + element + " = load " + elem_ty + ", ptr " + ptr)
    work = cg_line(work, "  store " + elem_ty + " " + element + ", ptr " + var_slot)
    work = cg_loop_enter(work, end_label, step)
    let body_state = cg_block(ast, work, a_child(ast, node, 1))
    if body_state.error.len() > 0 {
        return body_state
    }
    let body_ended = body_state.terminated
    work = cg_loop_exit(body_state)
    if !body_ended {
        work = cg_line(work, "  br label %" + step)
    }
    work = cg_line(work, step + ":")
    let step_value_result = cg_temp(work)
    work = step_value_result.0
    let step_value = step_value_result.1
    work = cg_line(work, "  " + step_value + " = load i64, ptr " + index_slot)
    let next_result = cg_temp(work)
    work = next_result.0
    let next = next_result.1
    work = cg_line(work, "  " + next + " = add i64 " + step_value + ", 1")
    work = cg_line(work, "  store i64 " + next + ", ptr " + index_slot)
    work = cg_line(work, "  br label %" + header)
    work = cg_line(work, end_label + ":")
    return cg_state(work, work.lines, work.temps, work.slots, cg_locals_before(work.locals, base), false, work.error)
}

fn cg_for_list(ast: Ast, state: CgState, node: Int, iter: Int) -> CgState {
    let list = cg_expr2(ast, state, iter)
    var work = list.state
    if work.error.len() > 0 {
        return work
    }
    let array = cg_array_layout(list.source)
    if array.1 >= 0 {
        return cg_for_array(ast, work, node, list, array.0, array.1)
    }
    let slice_elem = cg_slice_elem(list.source)
    if slice_elem.len() > 0 {
        return cg_for_slice(ast, work, node, list, slice_elem)
    }
    if list.ty != "%nova.list" {
        return cg_error(work, "for expects a range, list or slice")
    }
    if list.elem.len() == 0 {
        return cg_error(work, "for list element type is unknown")
    }
    let elem_ty = cg_llvm_type_in(work.structs, work.enums, list.elem)
    let size_result = cg_elem_size(work, list.elem)
    work = size_result.0
    let elem_size = size_result.1
    let list_slot_result = cg_slot(work)
    work = list_slot_result.0
    let list_slot = list_slot_result.1
    work = cg_line(work, "  " + list_slot + " = alloca %nova.list")
    work = cg_line(work, "  store %nova.list " + list.value + ", ptr " + list_slot)
    let index_slot_result = cg_slot(work)
    work = index_slot_result.0
    let index_slot = index_slot_result.1
    work = cg_line(work, "  " + index_slot + " = alloca i64")
    work = cg_line(work, "  store i64 0, ptr " + index_slot)
    let var_slot_result = cg_slot(work)
    work = var_slot_result.0
    let var_slot = var_slot_result.1
    work = cg_line(work, "  " + var_slot + " = alloca " + elem_ty)
    let base = work.locals.len()
    var locals = work.locals
    locals.push(CgLocal { name: ast.nodes[node].text, ty: elem_ty, slot: var_slot, value: "", mutable: false, elem: "", source: list.elem })
    work = cg_state(work, work.lines, work.temps, work.slots, locals, work.terminated, work.error)

    let header_result = cg_label(work)
    work = header_result.0
    let header = header_result.1
    let body_result = cg_label(work)
    work = body_result.0
    let body = body_result.1
    let step_result = cg_label(work)
    work = step_result.0
    let step = step_result.1
    let end_result = cg_label(work)
    work = end_result.0
    let end_label = end_result.1

    work = cg_line(work, "  br label %" + header)
    work = cg_line(work, header + ":")
    let index_result = cg_temp(work)
    work = index_result.0
    let index = index_result.1
    work = cg_line(work, "  " + index + " = load i64, ptr " + index_slot)
    let header_list_result = cg_temp(work)
    work = header_list_result.0
    let header_list = header_list_result.1
    work = cg_line(work, "  " + header_list + " = load %nova.list, ptr " + list_slot)
    let len_result = cg_temp(work)
    work = len_result.0
    let len = len_result.1
    work = cg_line(work, "  " + len + " = extractvalue %nova.list " + header_list + ", 1")
    let cond_result = cg_temp(work)
    work = cond_result.0
    let cond = cond_result.1
    work = cg_line(work, "  " + cond + " = icmp slt i64 " + index + ", " + len)
    work = cg_line(work, "  br i1 " + cond + ", label %" + body + ", label %" + end_label)
    work = cg_line(work, body + ":")
    let at_result = cg_temp(work)
    work = at_result.0
    let at = at_result.1
    work = cg_line(work, "  " + at + " = load i64, ptr " + index_slot)
    let ptr_result = cg_temp(work)
    work = ptr_result.0
    let ptr = ptr_result.1
    work = cg_line(
        work,
        "  " + ptr + " = call ptr @nova_list_at(ptr " + list_slot + ", i64 " + at + ", i64 " + elem_size + ", i64 " + ast.nodes[node].line.to_string() + ")",
    )
    let element_result = cg_temp(work)
    work = element_result.0
    let element = element_result.1
    work = cg_line(work, "  " + element + " = load " + elem_ty + ", ptr " + ptr)
    work = cg_line(work, "  store " + elem_ty + " " + element + ", ptr " + var_slot)
    work = cg_loop_enter(work, end_label, step)
    let body_state = cg_block(ast, work, a_child(ast, node, 1))
    if body_state.error.len() > 0 {
        return body_state
    }
    let body_ended = body_state.terminated
    work = cg_loop_exit(body_state)
    if !body_ended {
        work = cg_line(work, "  br label %" + step)
    }
    work = cg_line(work, step + ":")
    let step_value_result = cg_temp(work)
    work = step_value_result.0
    let step_value = step_value_result.1
    work = cg_line(work, "  " + step_value + " = load i64, ptr " + index_slot)
    let next_result = cg_temp(work)
    work = next_result.0
    let next = next_result.1
    work = cg_line(work, "  " + next + " = add i64 " + step_value + ", 1")
    work = cg_line(work, "  store i64 " + next + ", ptr " + index_slot)
    work = cg_line(work, "  br label %" + header)
    work = cg_line(work, end_label + ":")
    return cg_state(work, work.lines, work.temps, work.slots, cg_locals_before(work.locals, base), false, work.error)
}

fn cg_for(ast: Ast, state: CgState, node: Int) -> CgState {
    let iter = a_child(ast, node, 0)
    if iter >= 0 && ast.nodes[iter].kind == ak_binary() && ast.nodes[iter].text == ".." {
        return cg_for_range(ast, state, node, iter)
    }
    return cg_for_list(ast, state, node, iter)
}

fn cg_stmt(ast: Ast, state: CgState, node: Int) -> CgState {
    let item = ast.nodes[node]
    if item.kind == ak_if() {
        return cg_if(ast, state, node)
    }
    if item.kind == ak_while() {
        return cg_while(ast, state, node)
    }
    if item.kind == ak_for() {
        return cg_for(ast, state, node)
    }
    if item.kind == ak_break() || item.kind == ak_continue() {
        let target = if item.kind == ak_break() { cg_loop_break(state) } else { cg_loop_continue(state) }
        if target.len() == 0 {
            return cg_error(state, item.text + " outside a loop")
        }
        let work = cg_line(state, "  br label %" + target)
        return cg_state(work, work.lines, work.temps, work.slots, work.locals, true, work.error)
    }
    if item.kind == ak_let() || item.kind == ak_var() {
        let value = cg_expr_expected(ast, state, a_child(ast, node, 0), item.aux)
        var work = value.state
        if value.ty == "void" {
            return cg_error(work, "cannot bind a Unit value")
        }
        var value_source = value.source
        if item.aux.len() > 0 {
            value_source = item.aux
        }
        let elem = cg_element_source(value_source)
        if item.kind == ak_let() {
            // Immutable bindings can name the SSA value directly.
            var locals = work.locals
            locals.push(CgLocal { name: item.text, ty: value.ty, slot: "", value: value.value, mutable: false, elem: elem, source: value_source })
            return cg_state(work, work.lines, work.temps, work.slots, locals, work.terminated, work.error)
        }
        var init_value = value.value
        if value.ty == "%nova.list" {
            if elem.len() == 0 {
                return cg_error(work, "list element type is unknown")
            }
            let clone_result = cg_clone_list(work, value, elem)
            work = clone_result.0
            init_value = clone_result.1
        }
        let slot_result = cg_slot(work)
        work = slot_result.0
        let slot = slot_result.1
        work = cg_line(work, "  " + slot + " = alloca " + value.ty)
        work = cg_line(work, "  store " + value.ty + " " + init_value + ", ptr " + slot)
        var locals = work.locals
        locals.push(CgLocal { name: item.text, ty: value.ty, slot: slot, value: "", mutable: true, elem: elem, source: value_source })
        return cg_state(work, work.lines, work.temps, work.slots, locals, work.terminated, work.error)
    }
    if item.kind == ak_return() {
        if item.count == 0 {
            if state.ret != "Unit" {
                return cg_error(state, "return needs a value")
            }
            let work = cg_line(state, "  ret void")
            return cg_state(work, work.lines, work.temps, work.slots, work.locals, true, work.error)
        }
        let value = cg_expr_expected(ast, state, a_child(ast, node, 0), state.ret)
        var work = value.state
        if state.ret == "Unit" {
            return cg_error(work, "Unit function cannot return a value")
        }
        let expected = cg_llvm_type_in(state.structs, state.enums, state.ret)
        if value.ty != expected {
            return cg_error(work, "return type mismatch: " + value.ty + " vs " + expected)
        }
        work = cg_line(work, "  ret " + expected + " " + value.value)
        return cg_state(work, work.lines, work.temps, work.slots, work.locals, true, work.error)
    }
    if item.kind == ak_expr_stmt() {
        let value = cg_expr2(ast, state, a_child(ast, node, 0))
        return value.state
    }
    if item.kind == ak_block() {
        return cg_block(ast, state, node)
    }
    return cg_error(state, "unsupported statement")
}

fn cg_int_pattern(text: String) -> String {
    let chars = text.chars()
    if chars.len() == 0 {
        return ""
    }
    var start = 0
    if chars[0] == "-" {
        start = 1
    }
    if start >= chars.len() {
        return ""
    }
    var i = start
    while i < chars.len() {
        if !"0123456789_".contains(chars[i]) {
            return ""
        }
        i = i + 1
    }
    return cg_number(text)
}

fn cg_list_append(state: CgState, result_slot: String, source: CgVal) -> CgState {
    let source_slot_result = cg_entry_slot(state, "%nova.list")
    var work = source_slot_result.0
    let source_slot = source_slot_result.1
    work = cg_line(work, "  store %nova.list " + source.value + ", ptr " + source_slot)
    let loaded_result = cg_temp(work)
    work = loaded_result.0
    let loaded = loaded_result.1
    work = cg_line(work, "  " + loaded + " = load %nova.list, ptr " + source_slot)
    let len_result = cg_temp(work)
    work = len_result.0
    let len = len_result.1
    work = cg_line(work, "  " + len + " = extractvalue %nova.list " + loaded + ", 1")
    let index_result = cg_entry_slot(work, "i64")
    work = index_result.0
    let index_slot = index_result.1
    work = cg_line(work, "  store i64 0, ptr " + index_slot)
    let header_result = cg_label(work)
    work = header_result.0
    let header = header_result.1
    let body_result = cg_label(work)
    work = body_result.0
    let body = body_result.1
    let next_result = cg_label(work)
    work = next_result.0
    let next = next_result.1
    let end_result = cg_label(work)
    work = end_result.0
    let end_label = end_result.1
    work = cg_line(work, "  br label %" + header)
    work = cg_line(work, header + ":")
    let index_load_result = cg_temp(work)
    work = index_load_result.0
    let index_load = index_load_result.1
    work = cg_line(work, "  " + index_load + " = load i64, ptr " + index_slot)
    let cond_result = cg_temp(work)
    work = cond_result.0
    let cond = cond_result.1
    work = cg_line(work, "  " + cond + " = icmp slt i64 " + index_load + ", " + len)
    work = cg_line(work, "  br i1 " + cond + ", label %" + body + ", label %" + end_label)
    work = cg_line(work, body + ":")
    let at_result = cg_temp(work)
    work = at_result.0
    let at = at_result.1
    work = cg_line(work, "  " + at + " = call ptr @nova_list_at(ptr " + source_slot + ", i64 " + index_load + ", i64 8, i64 0)")
    work = cg_line(work, "  call void @nova_list_push(ptr " + result_slot + ", ptr " + at + ", i64 8)")
    work = cg_line(work, "  br label %" + next)
    work = cg_line(work, next + ":")
    let next_index_result = cg_temp(work)
    work = next_index_result.0
    let next_index = next_index_result.1
    work = cg_line(work, "  " + next_index + " = add i64 " + index_load + ", 1")
    work = cg_line(work, "  store i64 " + next_index + ", ptr " + index_slot)
    work = cg_line(work, "  br label %" + header)
    work = cg_line(work, end_label + ":")
    return cg_state(work, work.lines, work.temps, work.slots, work.locals, false, work.error)
}

fn cg_list_concat(state: CgState, left: CgVal, right: CgVal) -> CgVal {
    let result_slot_result = cg_entry_slot(state, "%nova.list")
    var work = result_slot_result.0
    let result_slot = result_slot_result.1
    work = cg_line(work, "  store %nova.list zeroinitializer, ptr " + result_slot)
    work = cg_list_append(work, result_slot, left)
    work = cg_list_append(work, result_slot, right)
    let loaded_result = cg_temp(work)
    work = loaded_result.0
    let loaded = loaded_result.1
    work = cg_line(work, "  " + loaded + " = load %nova.list, ptr " + result_slot)
    return cg_val_typed(work, loaded, "%nova.list")
}

fn cg_list_eq(state: CgState, left: CgVal, right: CgVal, negate: Bool) -> CgVal {
    let left_slot_result = cg_entry_slot(state, "%nova.list")
    var work = left_slot_result.0
    let left_slot = left_slot_result.1
    work = cg_line(work, "  store %nova.list " + left.value + ", ptr " + left_slot)
    let right_slot_result = cg_entry_slot(work, "%nova.list")
    work = right_slot_result.0
    let right_slot = right_slot_result.1
    work = cg_line(work, "  store %nova.list " + right.value + ", ptr " + right_slot)
    let left_load_result = cg_temp(work)
    work = left_load_result.0
    let left_load = left_load_result.1
    work = cg_line(work, "  " + left_load + " = load %nova.list, ptr " + left_slot)
    let right_load_result = cg_temp(work)
    work = right_load_result.0
    let right_load = right_load_result.1
    work = cg_line(work, "  " + right_load + " = load %nova.list, ptr " + right_slot)
    let left_len_result = cg_temp(work)
    work = left_len_result.0
    let left_len = left_len_result.1
    work = cg_line(work, "  " + left_len + " = extractvalue %nova.list " + left_load + ", 1")
    let right_len_result = cg_temp(work)
    work = right_len_result.0
    let right_len = right_len_result.1
    work = cg_line(work, "  " + right_len + " = extractvalue %nova.list " + right_load + ", 1")
    let same_len_result = cg_temp(work)
    work = same_len_result.0
    let same_len = same_len_result.1
    work = cg_line(work, "  " + same_len + " = icmp eq i64 " + left_len + ", " + right_len)
    let index_result = cg_entry_slot(work, "i64")
    work = index_result.0
    let index_slot = index_result.1
    work = cg_line(work, "  store i64 0, ptr " + index_slot)
    let false_result = cg_label(work)
    work = false_result.0
    let false_label = false_result.1
    let header_result = cg_label(work)
    work = header_result.0
    let header = header_result.1
    let body_result = cg_label(work)
    work = body_result.0
    let body = body_result.1
    let next_result = cg_label(work)
    work = next_result.0
    let next = next_result.1
    let true_result = cg_label(work)
    work = true_result.0
    let true_label = true_result.1
    let merge_result = cg_label(work)
    work = merge_result.0
    let merge = merge_result.1
    work = cg_line(work, "  br i1 " + same_len + ", label %" + header + ", label %" + false_label)
    work = cg_line(work, false_label + ":")
    work = cg_line(work, "  br label %" + merge)
    work = cg_line(work, header + ":")
    let index_load_result = cg_temp(work)
    work = index_load_result.0
    let index_load = index_load_result.1
    work = cg_line(work, "  " + index_load + " = load i64, ptr " + index_slot)
    let cond_result = cg_temp(work)
    work = cond_result.0
    let cond = cond_result.1
    work = cg_line(work, "  " + cond + " = icmp slt i64 " + index_load + ", " + left_len)
    work = cg_line(work, "  br i1 " + cond + ", label %" + body + ", label %" + true_label)
    work = cg_line(work, body + ":")
    let at_left_result = cg_temp(work)
    work = at_left_result.0
    let at_left = at_left_result.1
    work = cg_line(work, "  " + at_left + " = call ptr @nova_list_at(ptr " + left_slot + ", i64 " + index_load + ", i64 8, i64 0)")
    let at_right_result = cg_temp(work)
    work = at_right_result.0
    let at_right = at_right_result.1
    work = cg_line(work, "  " + at_right + " = call ptr @nova_list_at(ptr " + right_slot + ", i64 " + index_load + ", i64 8, i64 0)")
    let value_left_result = cg_temp(work)
    work = value_left_result.0
    let value_left = value_left_result.1
    work = cg_line(work, "  " + value_left + " = load i64, ptr " + at_left)
    let value_right_result = cg_temp(work)
    work = value_right_result.0
    let value_right = value_right_result.1
    work = cg_line(work, "  " + value_right + " = load i64, ptr " + at_right)
    let same_result = cg_temp(work)
    work = same_result.0
    let same = same_result.1
    work = cg_line(work, "  " + same + " = icmp eq i64 " + value_left + ", " + value_right)
    work = cg_line(work, "  br i1 " + same + ", label %" + next + ", label %" + false_label)
    work = cg_line(work, next + ":")
    let next_index_result = cg_temp(work)
    work = next_index_result.0
    let next_index = next_index_result.1
    work = cg_line(work, "  " + next_index + " = add i64 " + index_load + ", 1")
    work = cg_line(work, "  store i64 " + next_index + ", ptr " + index_slot)
    work = cg_line(work, "  br label %" + header)
    work = cg_line(work, true_label + ":")
    work = cg_line(work, "  br label %" + merge)
    work = cg_line(work, merge + ":")
    let phi_result = cg_temp(work)
    work = phi_result.0
    let phi = phi_result.1
    work = cg_line(work, "  " + phi + " = phi i1 [ false, %" + false_label + " ], [ true, %" + true_label + " ]")
    if negate {
        let not_result = cg_temp(work)
        work = not_result.0
        let not_value = not_result.1
        work = cg_line(work, "  " + not_value + " = xor i1 " + phi + ", true")
        return cg_val_typed(work, not_value, "i1")
    }
    return cg_val_typed(work, phi, "i1")
}

fn cg_list_extreme(ast: Ast, node: Int, recv: CgVal, want_min: Bool) -> CgVal {
    let list_slot_result = cg_entry_slot(recv.state, "%nova.list")
    var work = list_slot_result.0
    let list_slot = list_slot_result.1
    work = cg_line(work, "  store %nova.list " + recv.value + ", ptr " + list_slot)
    let len_result = cg_temp(work)
    work = len_result.0
    let len = len_result.1
    work = cg_line(work, "  " + len + " = extractvalue %nova.list " + recv.value + ", 1")
    let best_slot_result = cg_entry_slot(work, "i64")
    work = best_slot_result.0
    let best_slot = best_slot_result.1
    let first_ptr_result = cg_temp(work)
    work = first_ptr_result.0
    let first_ptr = first_ptr_result.1
    work = cg_line(work, "  " + first_ptr + " = call ptr @nova_list_at(ptr " + list_slot + ", i64 0, i64 8, i64 " + ast.nodes[node].line.to_string() + ")")
    let first_result = cg_temp(work)
    work = first_result.0
    let first = first_result.1
    work = cg_line(work, "  " + first + " = load i64, ptr " + first_ptr)
    work = cg_line(work, "  store i64 " + first + ", ptr " + best_slot)
    let index_slot_result = cg_entry_slot(work, "i64")
    work = index_slot_result.0
    let index_slot = index_slot_result.1
    work = cg_line(work, "  store i64 1, ptr " + index_slot)
    let header_result = cg_label(work)
    work = header_result.0
    let header = header_result.1
    let body_result = cg_label(work)
    work = body_result.0
    let body = body_result.1
    let done_result = cg_label(work)
    work = done_result.0
    let done = done_result.1
    work = cg_line(work, "  br label %" + header)
    work = cg_line(work, header + ":")
    let index_load_result = cg_temp(work)
    work = index_load_result.0
    let index_load = index_load_result.1
    work = cg_line(work, "  " + index_load + " = load i64, ptr " + index_slot)
    let condition_result = cg_temp(work)
    work = condition_result.0
    let condition = condition_result.1
    work = cg_line(work, "  " + condition + " = icmp slt i64 " + index_load + ", " + len)
    work = cg_line(work, "  br i1 " + condition + ", label %" + body + ", label %" + done)
    work = cg_line(work, body + ":")
    let ptr_result = cg_temp(work)
    work = ptr_result.0
    let ptr = ptr_result.1
    work = cg_line(work, "  " + ptr + " = call ptr @nova_list_at(ptr " + list_slot + ", i64 " + index_load + ", i64 8, i64 " + ast.nodes[node].line.to_string() + ")")
    let value_result = cg_temp(work)
    work = value_result.0
    let value = value_result.1
    work = cg_line(work, "  " + value + " = load i64, ptr " + ptr)
    let best_result = cg_temp(work)
    work = best_result.0
    let best = best_result.1
    work = cg_line(work, "  " + best + " = load i64, ptr " + best_slot)
    let better_result = cg_temp(work)
    work = better_result.0
    let better = better_result.1
    let opcode = if want_min { "icmp slt" } else { "icmp sgt" }
    work = cg_line(work, "  " + better + " = " + opcode + " i64 " + value + ", " + best)
    let selected_result = cg_temp(work)
    work = selected_result.0
    let selected = selected_result.1
    work = cg_line(work, "  " + selected + " = select i1 " + better + ", i64 " + value + ", i64 " + best)
    work = cg_line(work, "  store i64 " + selected + ", ptr " + best_slot)
    let next_result = cg_temp(work)
    work = next_result.0
    let next = next_result.1
    work = cg_line(work, "  " + next + " = add i64 " + index_load + ", 1")
    work = cg_line(work, "  store i64 " + next + ", ptr " + index_slot)
    work = cg_line(work, "  br label %" + header)
    work = cg_line(work, done + ":")
    let result_result = cg_temp(work)
    work = result_result.0
    let result = result_result.1
    work = cg_line(work, "  " + result + " = load i64, ptr " + best_slot)
    return cg_val_typed(work, result, "i64")
}

fn cg_list_sum(ast: Ast, node: Int, recv: CgVal) -> CgVal {
    let list_slot_result = cg_entry_slot(recv.state, "%nova.list")
    var work = list_slot_result.0
    let list_slot = list_slot_result.1
    work = cg_line(work, "  store %nova.list " + recv.value + ", ptr " + list_slot)
    let total_slot_result = cg_entry_slot(work, "i64")
    work = total_slot_result.0
    let total_slot = total_slot_result.1
    work = cg_line(work, "  store i64 0, ptr " + total_slot)
    let len_result = cg_temp(work)
    work = len_result.0
