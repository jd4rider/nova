// nova-tui — a small, dependency-free terminal UI toolkit for Nova.
//
// Everything here is ordinary Nova plus two scalar C calls for sleeping and
// flushing stdout. Rendering is plain ANSI text, so the output is just a string
// that any terminal (or a test harness) can inspect.
//
// Raw-mode input, terminal size, mouse and bracketed paste come from the
// native runtime; layout is grapheme-cluster aware. Windows remains untested.
// See the website page at /libraries/tui/.

extern "C" fn usleep(usec: Int) -> Unit
extern "C" fn fflush(stream: Int) -> Int
extern "C" fn nova_term_is_tty() -> Int
extern "C" fn nova_term_enter_raw() -> Int
extern "C" fn nova_term_leave_raw() -> Int
extern "C" fn nova_term_width() -> Int
extern "C" fn nova_term_height() -> Int
extern "C" fn nova_term_read_key(timeout: Int) -> Int
extern "C" fn nova_term_mouse_x() -> Int
extern "C" fn nova_term_mouse_y() -> Int
extern "C" fn nova_term_paste_len() -> Int
extern "C" fn nova_term_paste_next() -> Int

struct Style {
    fg: Int
    bg: Int
    bold: Bool
    dim: Bool
}

struct Theme {
    accent: Style
    muted: Style
    text: Style
    success: Style
    warning: Style
    danger: Style
}

struct Row {
    cells: List<String>
}

struct Panel {
    title: String
    lines: List<String>
    width: Int
    border: Style
    title_style: Style
    body: Style
}

struct Table {
    headers: List<String>
    rows: List<Row>
    widths: List<Int>
    header: Style
    cell: Style
    border: Style
}

struct Progress {
    label: String
    value: Int
    total: Int
    width: Int
    filled: Style
    empty: Style
    label_style: Style
}

struct TerminalSize {
    width: Int
    height: Int
}

enum Key {
    Up,
    Down,
    Left,
    Right,
    Home,
    End,
    PageUp,
    PageDown,
    Delete,
    Insert,
    BackTab,
    Enter,
    Tab,
    Backspace,
    Escape,
    Quit,
    Resize,
    MouseLeft,
    MouseMiddle,
    MouseRight,
    MouseRelease,
    WheelUp,
    WheelDown,
    WheelLeft,
    WheelRight,
    DragLeft,
    DragMiddle,
    DragRight,
    Paste,
    Char(Int),
    Timeout
}

// ---------- strings and styling ----------

fn style(fg: Int, bg: Int, bold: Bool, dim: Bool) -> Style {
    return Style { fg: fg, bg: bg, bold: bold, dim: dim }
}

fn theme() -> Theme {
    return Theme { accent: style(81, -1, true, false), muted: style(244, -1, false, false), text: style(252, -1, false, false), success: style(114, -1, true, false), warning: style(221, -1, true, false), danger: style(203, -1, true, false) }
}

fn paint(style: Style, text: String) -> String {
    var prefix = ""
    if style.bold {
        prefix = prefix + "\u{1b}[1m"
    }
    if style.dim {
        prefix = prefix + "\u{1b}[2m"
    }
    if style.fg >= 0 {
        prefix = prefix + "\u{1b}[38;5;${style.fg}m"
    }
    if style.bg >= 0 {
        prefix = prefix + "\u{1b}[48;5;${style.bg}m"
    }
    if prefix.len() == 0 {
        return text
    }
    return prefix + text + "\u{1b}[0m"
}

fn repeat(text: String, count: Int) -> String {
    var out = ""
    var i = 0
    while i < count {
        out = out + text
        i += 1
    }
    return out
}

fn pad(text: String, width: Int) -> String {
    let visible = text.display_width()
    if visible >= width {
        return text
    }
    return text + repeat(" ", width - visible)
}

fn fit(text: String, width: Int) -> String {
    return pad(text.clip(width), width)
}

fn badge(label: String, fill: Style) -> String {
    return paint(fill, " " + label + " ")
}

fn rule(label: String, width: Int, color: Style) -> String {
    if label.len() == 0 {
        return paint(color, repeat("─", width))
    }
    let visible = label.display_width()
    if visible + 4 >= width {
        return paint(color, repeat("─", width))
    }
    return paint(color, "── " + label + " " + repeat("─", width - visible - 4))
}

// ---------- terminal control ----------

fn clear() -> String {
    return "\u{1b}[2J\u{1b}[H"
}

fn home() -> String {
    return "\u{1b}[H"
}

fn hide_cursor() -> String {
    return "\u{1b}[?25l"
}

fn show_cursor() -> String {
    return "\u{1b}[?25h"
}

fn enter_alternate() -> String {
    return "\u{1b}[?1049h"
}

fn leave_alternate() -> String {
    return "\u{1b}[?1049l"
}

fn move_to(row: Int, column: Int) -> String {
    return "\u{1b}[${row};${column}H"
}

fn sleep_ms(milliseconds: Int) {
    usleep(milliseconds * 1000)
}

fn flush() {
    fflush(0)
}

fn is_tty() -> Bool {
    return nova_term_is_tty() == 1
}

fn enter_raw() -> Bool {
    return nova_term_enter_raw() == 1
}

fn leave_raw() -> Bool {
    return nova_term_leave_raw() == 1
}

fn terminal_width() -> Int {
    return nova_term_width()
}

fn terminal_height() -> Int {
    return nova_term_height()
}

fn terminal_size() -> TerminalSize {
    return TerminalSize { width: terminal_width(), height: terminal_height() }
}

fn read_key(timeout_ms: Int) -> Int {
    return nova_term_read_key(timeout_ms)
}

fn mouse_x() -> Int {
    return nova_term_mouse_x()
}

fn mouse_y() -> Int {
    return nova_term_mouse_y()
}

fn paste_len() -> Int {
    return nova_term_paste_len()
}

fn paste_next() -> Int {
    return nova_term_paste_next()
}

fn paste_text() -> String {
    return term_paste()
}

fn mouse_on() -> String {
    return "\u{1b}[?1000h\u{1b}[?1002h\u{1b}[?1006h"
}

fn mouse_off() -> String {
    return "\u{1b}[?1000l\u{1b}[?1002l\u{1b}[?1006l"
}

fn paste_on() -> String {
    return "\u{1b}[?2004h"
}

fn paste_off() -> String {
    return "\u{1b}[?2004l"
}

fn decode_key(code: Int) -> Key {
    if code < 0 {
        return Timeout
    }
    if code == 1001 {
        return Up
    }
    if code == 1002 {
        return Down
    }
    if code == 1003 {
        return Right
    }
    if code == 1004 {
        return Left
    }
    if code == 1005 {
        return Home
    }
    if code == 1006 {
        return End
    }
    if code == 1007 {
        return PageUp
    }
    if code == 1008 {
        return PageDown
    }
    if code == 1009 {
        return Delete
    }
    if code == 1010 {
        return Insert
    }
    if code == 1011 {
        return BackTab
    }
    if code == 1020 {
        return Resize
    }
    if code == 3000 {
        return Paste
    }
    if code == 2000 {
        return MouseLeft
    }
    if code == 2001 {
        return MouseMiddle
    }
    if code == 2002 {
        return MouseRight
    }
    if code == 2003 {
        return MouseRelease
    }
    if code == 2004 {
        return WheelUp
    }
    if code == 2005 {
        return WheelDown
    }
    if code == 2006 {
        return WheelLeft
    }
    if code == 2007 {
        return WheelRight
    }
    if code == 2010 {
        return DragLeft
    }
    if code == 2011 {
        return DragMiddle
    }
    if code == 2012 {
        return DragRight
    }
    if code == 3 {
        return Quit
    }
    if code == 13 {
        return Enter
    }
    if code == 10 {
        return Enter
    }
    if code == 9 {
        return Tab
    }
    if code == 127 {
        return Backspace
    }
    if code == 27 {
        return Escape
    }
    return Char(code)
}

// ---------- components ----------

fn panel(title: String, lines: List<String>, width: Int, colors: Theme) -> Panel {
    return Panel { title: title, lines: lines, width: width, border: colors.muted, title_style: colors.accent, body: colors.text }
}

impl Panel {
    fn render(self) -> String {
        let inner = self.width - 4;
        let title = self.title.clip(self.width - 5);
        let fill = self.width - 5 - title.display_width();
        var out = paint(self.border, "╭─ ");
        out = out + paint(self.title_style, title);
        out = out + paint(self.border, " " + repeat("─", fill) + "╮");
        out = out + "\n";
        for line in self.lines {
            out = out + paint(self.border, "│ ");
            out = out + paint(self.body, fit(line, inner));
            out = out + paint(self.border, " │");
            out = out + "\n";
        }
        out = out + paint(self.border, "╰" + repeat("─", self.width - 2) + "╯");
        return out;
    }
}

fn list_panel(title: String, items: List<String>, selected: Int, width: Int, colors: Theme) -> Panel {
    var lines: List<String> = []
    var i = 0
    for item in items {
        if i == selected {
            lines.push("> " + item)
        } else {
            lines.push("  " + item)
        }
        i += 1
    }
    return panel(title, lines, width, colors)
}

fn row(cells: List<String>) -> Row {
    return Row { cells: cells }
}

fn table(headers: List<String>, rows: List<Row>, widths: List<Int>, colors: Theme) -> Table {
    return Table { headers: headers, rows: rows, widths: widths, header: colors.accent, cell: colors.text, border: colors.muted }
}

impl Table {
    fn render(self) -> String {
        var total = 0;
        for width in self.widths {
            total += width + 2;
        }
        var out = paint(self.border, repeat("─", total)) + "\n";
        var header_line = "";
        var column = 0;
        for header in self.headers {
            header_line = header_line + fit(header, self.widths[column]) + "  ";
            column += 1;
        }
        out = out + paint(self.header, header_line) + "\n";
        out = out + paint(self.border, repeat("─", total)) + "\n";
        for item in self.rows {
            var line = "";
            var index = 0;
            for cell in item.cells {
                line = line + fit(cell, self.widths[index]) + "  ";
                index += 1;
            }
            out = out + paint(self.cell, line) + "\n";
        }
        out = out + paint(self.border, repeat("─", total));
        return out;
    }
}

fn progress(label: String, value: Int, total: Int, width: Int, colors: Theme) -> Progress {
    return Progress { label: label, value: value, total: total, width: width, filled: colors.success, empty: colors.muted, label_style: colors.text }
}

fn render_progress(value: Progress) -> String {
    var filled = 0
    if value.total > 0 {
        filled = value.value * value.width / value.total
    }
    if filled < 0 {
        filled = 0
    }
    if filled > value.width {
        filled = value.width
    }
    var percent = 0
    if value.total > 0 {
        percent = value.value * 100 / value.total
    }
    let bar = paint(value.filled, repeat("█", filled))
    let rest = paint(value.empty, repeat("░", value.width - filled))
    return paint(value.label_style, fit(value.label, 14)) + " " + bar + rest + " " + "${percent}%"
}

impl Progress {
    fn render(self) -> String {
        return render_progress(self)
    }
}

fn spinner_frame(index: Int) -> String {
    let frames: List<String> = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
    if index < 0 {
        return frames[0]
    }
    return frames[index % frames.len()]
}

fn spinner_line(label: String, index: Int, colors: Theme) -> String {
    return paint(colors.accent, spinner_frame(index)) + " " + paint(colors.muted, label)
}

fn banner(title: String, subtitle: String, width: Int, colors: Theme) -> String {
    var out = paint(colors.accent, "  ✦ " + title) + "\n"
    out = out + paint(colors.muted, "    " + subtitle) + "\n"
    out = out + rule("", width, colors.muted)
    return out
}

fn text_panel(title: String, text: String, width: Int, colors: Theme) -> Panel {
    return panel(title, text.wrap(width - 4), width, colors)
}
