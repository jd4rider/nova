// Lockfile, tree and metadata rendering for Nova Boxes.

import "./boxes.nova"
import "./resolve.nova"

fn rp_lock(manifest: BoxManifest, result: ResolveResult) -> String {
    var out = "# generated by nova-boxes — do not edit\n"
    out = out + "version = 1\n"
    out = out + "package = \"${manifest.name}\"\n"
    out = out + "package-version = \"${manifest.version}\"\n"
    for box in result.boxes {
        out = out + "box \"${box.name}\" \"${box.version}\" path \"${box.path}\"\n"
    }
    return out
}

fn rp_tree(manifest: BoxManifest, result: ResolveResult) -> String {
    var out = "${manifest.name} v${manifest.version}\n"
    for box in result.boxes {
        var indent = ""
        var i = 0
        while i < box.depth {
            indent = indent + "  "
            i = i + 1
        }
        out = out + "${indent}${box.name} v${box.version} (${box.path})\n"
    }
    return out
}

fn rp_metadata(manifest: BoxManifest, result: ResolveResult) -> String {
    var out = "{\"name\":\"${manifest.name}\",\"version\":\"${manifest.version}\","
    out = out + "\"bin\":\"${manifest.bin}\",\"packages\":["
    var first = true
    for box in result.boxes {
        if !first {
            out = out + ","
        }
        first = false
        out = out + "{\"name\":\"${box.name}\",\"version\":\"${box.version}\",\"path\":\"${box.path}\"}"
    }
    out = out + "]}"
    return out
}
