// Nova Boxes — the package manager for Nova, written in Nova.
//
// A package is a *box*. A box ships a `box.toml` manifest:
//
//   [package]
//   name = "render"
//   version = "0.1.0"
//
//   [dependencies]
//   math = "0.2.0"
//   gui = { path = "../gui" }
//
// and resolves to a `boxes.lock` listing every dependency in order. There are
// no Cargo crates, no registry client and no Rust in this path: manifests,
// validation, import graphs and lockfiles are plain Nova values, so the same
// code runs in the compiler, the CLI and an editor.

struct BoxDep {
    name: String,
    path: String,
    version: String,
}

struct BoxManifest {
    name: String,
    version: String,
    bin: String,
    deps: List<BoxDep>,
}

fn bx_trim_end(text: String) -> String {
    let chars = text.chars()
    var stop = chars.len()
    while stop > 0 {
        let c = chars[stop - 1]
        if c == " " || c == "\t" || c == "\r" {
            stop = stop - 1
        } else {
            var out = ""
            var i = 0
            while i < stop {
                out = out + chars[i]
                i = i + 1
            }
            return out
        }
    }
    return ""
}

fn bx_trim_start(text: String) -> String {
    let chars = text.chars()
    var start = 0
    while start < chars.len() {
        let c = chars[start]
        if c == " " || c == "\t" {
            start = start + 1
        } else {
            var out = ""
            var i = start
            while i < chars.len() {
                out = out + chars[i]
                i = i + 1
            }
            return out
        }
    }
    return ""
}

fn bx_trim(text: String) -> String {
    return bx_trim_start(bx_trim_end(text))
}

fn bx_lines(source: String) -> List<String> {
    let chars = source.chars()
    var lines: List<String> = []
    var current = ""
    var i = 0
    while i < chars.len() {
        if chars[i] == "\n" {
            lines.push(current)
            current = ""
        } else {
            current = current + chars[i]
        }
        i = i + 1
    }
    lines.push(current)
    return lines
}

// Drops a trailing `# comment`, but only when the `#` is outside quotes.
fn bx_strip_comment(line: String) -> String {
    let chars = line.chars()
    var quoted = false
    var i = 0
    while i < chars.len() {
        let c = chars[i]
        if c == "\"" {
            quoted = !quoted
        } else if c == "#" && !quoted {
            var out = ""
            var k = 0
            while k < i {
                out = out + chars[k]
                k = k + 1
            }
            return out
        }
        i = i + 1
    }
    return line
}

fn bx_unquote(text: String) -> String {
    let chars = text.chars()
    var out = ""
    var i = 0
    var quoted = false
    while i < chars.len() {
        if chars[i] == "\"" {
            quoted = !quoted
        } else if quoted {
            out = out + chars[i]
        }
        i = i + 1
    }
    return out
}

// The value of `path = "..."` inside an inline table, or "" when absent.
fn bx_table_value(text: String, key: String) -> String {
    let chars = text.chars()
    let target = key.chars()
    var i = 0
    while i + target.len() <= chars.len() {
        var matched = true
        var k = 0
        while k < target.len() {
            if chars[i + k] != target[k] {
                matched = false
            }
            k = k + 1
        }
        if matched {
            var j = i + target.len()
            while j < chars.len() && chars[j] != "=" {
                j = j + 1
            }
            if j < chars.len() {
                j = j + 1
                while j < chars.len() && chars[j] == " " {
                    j = j + 1
                }
                if j < chars.len() && chars[j] == "\"" {
                    j = j + 1
                    var out = ""
                    while j < chars.len() && chars[j] != "\"" {
                        out = out + chars[j]
                        j = j + 1
                    }
                    return out
                }
                var plain = ""
                while j < chars.len() && chars[j] != "," && chars[j] != "}" {
                    plain = plain + chars[j]
                    j = j + 1
                }
                return plain.trim()
            }
        }
        i = i + 1
    }
    return ""
}

// Manifest keys may be bare (`util`) or quoted (`"@nova/util"`). Unquoting a
// bare key would erase it, so only quoted keys lose their quotes.
fn bx_unquote_key(text: String) -> String {
    if text.starts_with("\"") {
        return bx_unquote(text)
    }
    return text.trim()
}

fn bx_valid_name(name: String) -> Bool {
    if name.len() == 0 {
        return false
    }
    // Scoped registry names are canonical only in lowercase; local names keep
    // accepting mixed case so existing manifests are not rewritten.
    if name.starts_with("@") {
        if name.len() > 64 {
            return false
        }
        let parts = name.split("/")
        if parts.len() != 2 || parts[1].starts_with("@") {
            return false
        }
        if !bx_scoped_part_ok(parts[0]) || !bx_scoped_part_ok(parts[1]) {
            return false
        }
        return true
    }
    let chars = name.chars()
    var i = 0
    while i < chars.len() {
        let c = chars[i]
        let allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-"
        var ok = false
        for known in allowed.chars() {
            if c == known {
                ok = true
            }
        }
        if !ok {
            return false
        }
        i = i + 1
    }
    return true
}

fn bx_parse_manifest(source: String) -> BoxManifest {
    var name = ""
    var version = "0.1.0"
    var bin = "src/main.nova"
    var deps: List<BoxDep> = []
    var section = ""
    for raw in bx_lines(source) {
        let line = bx_trim(bx_strip_comment(raw))
        if line.len() > 0 {
        if line.starts_with("[") {
            if line == "[package]" {
                section = "package"
            } else if line == "[bin]" {
                section = "bin"
            } else if line == "[dependencies]" {
                section = "dependencies"
            } else {
                section = "other"
            }
        } else {
            let parts = bx_split_key(line)
            let key = bx_unquote_key(parts.0)
            let value = parts.1
            if section == "package" && key == "name" {
                name = bx_unquote(value)
            }
            if section == "package" && key == "version" {
                version = bx_unquote(value)
            }
            if section == "bin" && key == "path" {
                bin = bx_unquote(value)
            }
            if section == "dependencies" && key.len() > 0 {
                var path = ""
                var ver = ""
                if value.starts_with("{") {
                    path = bx_table_value(value, "path")
                    ver = bx_table_value(value, "version")
                } else {
                    ver = bx_unquote(value)
                }
                deps.push(BoxDep { name: key, path: path, version: ver })
            }
        }
        }
    }
    return BoxManifest { name: name, version: version, bin: bin, deps: deps }
}

fn bx_split_key(line: String) -> (String, String) {
    let chars = line.chars()
    var i = 0
    while i < chars.len() && chars[i] != "=" {
        i = i + 1
    }
    var key = ""
    var k = 0
    while k < i {
        key = key + chars[k]
        k = k + 1
    }
    var value = ""
    var v = i + 1
    while v < chars.len() {
        value = value + chars[v]
        v = v + 1
    }
    return (bx_trim(key), bx_trim(value))
}

fn bx_lock(manifest: BoxManifest) -> String {
    var out = "# generated by nova-boxes — do not edit\n"
    out = out + "${manifest.name} ${manifest.version}\n"
    for dep in manifest.deps {
        if dep.path.len() > 0 {
            out = out + "${dep.name} path ${dep.path}\n"
        } else {
            out = out + "${dep.name} version ${dep.version}\n"
        }
    }
    return out
}

// Every `import "..."` path in a source file, in order, without duplicates.
fn bx_imports(source: String) -> List<String> {
    var found: List<String> = []
    for raw in bx_lines(source) {
        let line = bx_trim(raw)
        if line.starts_with("import") {
            let chars = line.chars()
            var first = -1
            var last = -1
            var i = 0
            while i < chars.len() {
                if chars[i] == "\"" {
                    if first < 0 {
                        first = i
                    } else {
                        last = i
                    }
                }
                i = i + 1
            }
            if first >= 0 && last > first {
                var path = ""
                var k = first + 1
                while k < last {
                    path = path + chars[k]
                    k = k + 1
                }
                var seen = false
                for existing in found {
                    if existing == path {
                        seen = true
                    }
                }
                if !seen {
                    found.push(path)
                }
            }
        }
    }
    return found
}

fn bx_scoped_part_ok(part: String) -> Bool {
    if part.len() == 0 {
        return false
    }
    let chars = part.chars()
    var start = 0
    if chars[0] == "@" {
        start = 1
    }
    if start >= chars.len() {
        return false
    }
    let first = chars[start]
    for digit in "0123456789".chars() {
        if first == digit {
            return false
        }
    }
    let allowed = "abcdefghijklmnopqrstuvwxyz0123456789_-"
    var i = 0
    while i < chars.len() {
        let c = chars[i]
        if i != 0 || c != "@" {
            var ok = false
            for known in allowed.chars() {
                if c == known {
                    ok = true
                }
            }
            if !ok {
                return false
            }
        }
        i = i + 1
    }
    return true
}

// A dependency key is quoted when it is not a bare TOML key, which is the case
// for every scoped registry name (`"@nova/math" = "^1.0.0"`).
fn bx_key(name: String) -> String {
    let allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-"
    for c in name.chars() {
        var ok = false
        for known in allowed.chars() {
            if c == known {
                ok = true
            }
        }
        if !ok {
            return "\"" + name + "\""
        }
    }
    return name
}

fn bx_join_lines(lines: List<String>) -> String {
    var out = ""
    for line in lines {
        out = out + line + "\n"
    }
    return out
}

fn bx_section_start(lines: List<String>, header: String) -> Int {
    var i = 0
    while i < lines.len() {
        if bx_trim(bx_strip_comment(lines[i])) == header {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn bx_section_end(lines: List<String>, start: Int) -> Int {
    var i = start + 1
    while i < lines.len() {
        if bx_trim(lines[i]).starts_with("[") {
            return i
        }
        i = i + 1
    }
    return lines.len()
}

fn bx_dep_line(lines: List<String>, start: Int, end: Int, name: String) -> Int {
    var i = start + 1
    while i < end {
        let line = bx_trim(bx_strip_comment(lines[i]))
        if line.len() > 0 && !line.starts_with("#") {
            let parts = bx_split_key(line)
            if bx_unquote_key(parts.0) == name {
                return i
            }
        }
        i = i + 1
    }
    return 0 - 1
}

// Adds or replaces `name` in `[dependencies]`, leaving every other line and
// comment untouched. This is what `nova box add` writes back to Box.toml.
fn bx_set_dependency(source: String, name: String, requirement: String) -> String {
    let lines = bx_lines(source)
    let entry = bx_key(name) + " = \"" + requirement + "\""
    let start = bx_section_start(lines, "[dependencies]")
    if start < 0 {
        var out = source
        if out.len() > 0 && !out.ends_with("\n") {
            out = out + "\n"
        }
        return out + "\n[dependencies]\n" + entry + "\n"
    }
    let end = bx_section_end(lines, start)
    let existing = bx_dep_line(lines, start, end, name)
    if existing >= 0 {
        var copy: List<String> = []
        var i = 0
        while i < lines.len() {
            if i == existing {
                copy.push(entry)
            } else {
                copy.push(lines[i])
            }
            i = i + 1
        }
        return bx_join_lines(copy)
    }
    var insert = start + 1
    var i = start + 1
    while i < end {
        if bx_trim(lines[i]).len() > 0 {
            insert = i + 1
        }
        i = i + 1
    }
    var out_lines: List<String> = []
    var k = 0
    while k < lines.len() {
        if k == insert {
            out_lines.push(entry)
        }
        out_lines.push(lines[k])
        k = k + 1
    }
    if insert >= lines.len() {
        out_lines.push(entry)
    }
    return bx_join_lines(out_lines)
}

// Removes `name` from `[dependencies]`. The bool says whether it was present.
fn bx_remove_dependency(source: String, name: String) -> (String, Bool) {
    let lines = bx_lines(source)
    let start = bx_section_start(lines, "[dependencies]")
    if start < 0 {
        return (source, false)
    }
    let end = bx_section_end(lines, start)
    let existing = bx_dep_line(lines, start, end, name)
    if existing < 0 {
        return (source, false)
    }
    var out: List<String> = []
    var i = 0
    while i < lines.len() {
        if i != existing {
            out.push(lines[i])
        }
        i = i + 1
    }
    return (bx_join_lines(out), true)
}

fn bx_manifest_ok(manifest: BoxManifest) -> Bool {
    if !bx_valid_name(manifest.name) {
        return false
    }
    if manifest.version.len() == 0 {
        return false
    }
    for dep in manifest.deps {
        if !bx_valid_name(dep.name) {
            return false
        }
        if dep.path.len() == 0 && dep.version.len() == 0 {
            return false
        }
    }
    return true
}
