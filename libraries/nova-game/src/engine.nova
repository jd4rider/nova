// Nova Game Engine: Breakout with levels, power-ups, multiball and a kinematic
// paddle.
//
// The engine is pure: `step(game, target)` returns the next Game and knows
// nothing about rendering. The paddle eases toward its target at a bounded
// speed, so a keyboard tap glides instead of teleporting and a mouse drag
// tracks smoothly. Balls live as flat quads (x, y, vx, vy) in millipixels, so a
// long rally stays exact and a ball list is cheap to copy.

import "physics.nova"

struct Game {
    balls: List<Int>,
    paddle: Int,
    paddle_v: Int,
    paddle_hits: Int,
    lives: Int,
    score: Int,
    rally: Int,
    status: Int,
    level: Int,
    bricks: List<Int>,
    caps_x: Int,
    caps_y: Int,
    caps_kind: Int,
    caps_alive: Bool,
    wide: Int,
    slow: Int,
}

fn field_width() -> Int {
    return 800
}

fn field_height() -> Int {
    return 520
}

fn brick_cols() -> Int {
    return 10
}

fn brick_rows() -> Int {
    return 5
}

fn brick_count() -> Int {
    return brick_cols() * brick_rows()
}

fn ball_size() -> Int {
    return 16
}

fn max_balls() -> Int {
    return 6
}

fn paddle_width() -> Int {
    return 120
}

fn paddle_width_of(game: Game) -> Int {
    if game.wide > 0 {
        return 180
    }
    return 120
}

fn paddle_height() -> Int {
    return 18
}

fn paddle_y() -> Int {
    return 466
}

// Pixels per tick the paddle may travel: fast enough to feel direct, slow
// enough that a key press glides.
fn paddle_speed() -> Int {
    return 18
}

fn capsule_size() -> Int {
    return 24
}

fn capsule_speed() -> Int {
    return 4
}

fn wide_duration() -> Int {
    return 480
}

fn slow_duration() -> Int {
    return 420
}

fn level_count() -> Int {
    return 4
}

fn level_name(level: Int) -> String {
    if level == 1 {
        return "CHECKERBOARD"
    }
    if level == 2 {
        return "DIAMOND"
    }
    if level == 3 {
        return "PYRAMID"
    }
    return "FULL HOUSE"
}

fn level_brick(level: Int, column: Int, row: Int) -> Bool {
    if level == 1 {
        return (column + row) % 2 == 0
    }
    if level == 2 {
        var dx = column - 4
        if dx < 0 {
            dx = -dx
        }
        var dy = row - 2
        if dy < 0 {
            dy = -dy
        }
        return dx + dy <= 4
    }
    if level == 3 {
        return column >= row && column <= brick_cols() - 1 - row
    }
    return true
}

fn brick_x(column: Int) -> Int {
    return 30 + column * 78
}

fn brick_y(row: Int) -> Int {
    return 60 + row * 30
}

fn brick_w() -> Int {
    return 70
}

fn brick_h() -> Int {
    return 24
}

fn brick_colour(row: Int) -> Int {
    var index = row
    if index < 0 {
        index = 0
    }
    return index % 6
}

// ---------- balls ----------

fn ball_quad(x: Int, y: Int, vx: Int, vy: Int) -> List<Int> {
    var quad: List<Int> = []
    quad.push(x)
    quad.push(y)
    quad.push(vx)
    quad.push(vy)
    return quad
}

fn ball_count(game: Game) -> Int {
    return game.balls.len() / 4
}

fn ball_x_at(game: Game, index: Int) -> Int {
    if index < 0 || index >= ball_count(game) {
        return 0
    }
    return game.balls[index * 4]
}

fn ball_y_at(game: Game, index: Int) -> Int {
    if index < 0 || index >= ball_count(game) {
        return 0
    }
    return game.balls[index * 4 + 1]
}

fn ball_px_x_at(game: Game, index: Int) -> Int {
    return ph_px(ball_x_at(game, index))
}

fn ball_px_y_at(game: Game, index: Int) -> Int {
    return ph_px(ball_y_at(game, index))
}

fn ball_px_x(game: Game) -> Int {
    return ball_px_x_at(game, 0)
}

fn ball_px_y(game: Game) -> Int {
    return ball_px_y_at(game, 0)
}

fn ball_pace(game: Game) -> Int {
    if ball_count(game) == 0 {
        return 0
    }
    var vx = game.balls[2]
    if vx < 0 {
        vx = -vx
    }
    var vy = game.balls[3]
    if vy < 0 {
        vy = -vy
    }
    return (vx + vy) / 1000
}

// Mirror every in-play ball once, keeping the total at or below max_balls.
fn mirror_balls(balls: List<Int>) -> List<Int> {
    var out: List<Int> = []
    var i = 0
    while i < balls.len() {
        out.push(balls[i])
        i = i + 1
    }
    let count = balls.len() / 4
    i = 0
    while i < count && out.len() / 4 < max_balls() {
        let x = balls[i * 4]
        let y = balls[i * 4 + 1]
        var vx = -balls[i * 4 + 2] + 800
        if vx > 9000 {
            vx = 9000
        }
        if vx < -9000 {
            vx = -9000
        }
        out.push(x)
        out.push(y)
        out.push(vx)
        out.push(-4600)
        i = i + 1
    }
    return out
}

fn multiball(game: Game) -> Game {
    if game.status != 1 {
        return game
    }
    return Game {
        balls: mirror_balls(game.balls),
        paddle: game.paddle,
        paddle_v: game.paddle_v,
        paddle_hits: game.paddle_hits,
        lives: game.lives,
        score: game.score,
        rally: game.rally,
        status: game.status,
        level: game.level,
        bricks: game.bricks,
        caps_x: game.caps_x,
        caps_y: game.caps_y,
        caps_kind: game.caps_kind,
        caps_alive: game.caps_alive,
        wide: game.wide,
        slow: game.slow,
    }
}

// ---------- levels ----------

fn level_bricks(level: Int) -> List<Int> {
    var bricks: List<Int> = []
    var row = 0
    while row < brick_rows() {
        var column = 0
        while column < brick_cols() {
            if level_brick(level, column, row) {
                bricks.push(1)
            } else {
                bricks.push(0)
            }
            column = column + 1
        }
        row = row + 1
    }
    return bricks
}

fn level_game(level: Int, score: Int, lives: Int) -> Game {
    return Game {
        balls: ball_quad(400000, 440000, 0, 0),
        paddle: 400,
        paddle_v: 0,
        paddle_hits: 0,
        lives: lives,
        score: score,
        rally: 0,
        status: 0,
        level: level,
        bricks: level_bricks(level),
        caps_x: 0,
        caps_y: 0,
        caps_kind: 0,
        caps_alive: false,
        wide: 0,
        slow: 0,
    }
}

fn new_game() -> Game {
    return level_game(0, 0, 3)
}

fn launch(game: Game) -> Game {
    if game.status != 0 {
        return game
    }
    return Game {
        balls: ball_quad(game.paddle * 1000, 440000, 4000, -5000),
        paddle: game.paddle,
        paddle_v: game.paddle_v,
        paddle_hits: game.paddle_hits,
        lives: game.lives,
        score: game.score,
        rally: 0,
        status: 1,
        level: game.level,
        bricks: game.bricks,
        caps_x: game.caps_x,
        caps_y: game.caps_y,
        caps_kind: game.caps_kind,
        caps_alive: game.caps_alive,
        wide: game.wide,
        slow: game.slow,
    }
}

fn next_level(game: Game) -> Game {
    var level = game.level + 1
    var score = game.score
    var lives = game.lives
    if level >= level_count() {
        level = 0
        score = 0
        lives = 3
    }
    return level_game(level, score, lives)
}

// Sets the board to cleared without touching score or lives: used by tests and
// by the app's transition frame.
fn clear_board(game: Game) -> Game {
    var bricks = game.bricks
    var i = 0
    while i < bricks.len() {
        bricks[i] = 0
        i = i + 1
    }
    return Game {
        balls: game.balls,
        paddle: game.paddle,
        paddle_v: game.paddle_v,
        paddle_hits: game.paddle_hits,
        lives: game.lives,
        score: game.score,
        rally: game.rally,
        status: 2,
        level: game.level,
        bricks: bricks,
        caps_x: game.caps_x,
        caps_y: game.caps_y,
        caps_kind: game.caps_kind,
        caps_alive: false,
        wide: game.wide,
        slow: game.slow,
    }
}

fn bricks_left(game: Game) -> Int {
    var alive = 0
    for brick in game.bricks {
        if brick == 1 {
            alive = alive + 1
        }
    }
    return alive
}

// ---------- geometry ----------

fn brick_body(column: Int, row: Int) -> Body {
    return ph_solid_box(brick_x(column), brick_y(row), brick_w(), brick_h())
}

fn paddle_body(game: Game) -> Body {
    return ph_solid_box(game.paddle - paddle_width_of(game) / 2, paddle_y(), paddle_width_of(game), paddle_height())
}

fn wall_list() -> List<Body> {
    var walls: List<Body> = []
    walls.push(ph_solid_box(0, -8, field_width(), 8))
    walls.push(ph_solid_box(-8, 0, 8, field_height()))
    walls.push(ph_solid_box(field_width(), 0, 8, field_height()))
    return walls
}

fn eased_paddle(game: Game, target: Int) -> Int {
    var want = target
    if want < 60 {
        want = 60
    }
    if want > field_width() - 60 {
        want = field_width() - 60
    }
    var paddle = game.paddle
    let speed = paddle_speed()
    if want > paddle + speed {
        paddle = paddle + speed
    } else if want < paddle - speed {
        paddle = paddle - speed
    } else {
        paddle = want
    }
    return paddle
}

// ---------- simulation ----------

fn step(game: Game, target: Int) -> Game {
    let paddle = eased_paddle(game, target)
    let paddle_v = paddle - game.paddle

    if game.status == 0 {
        return Game {
            balls: ball_quad(paddle * 1000, 440000, 0, 0),
            paddle: paddle,
            paddle_v: paddle_v,
            paddle_hits: game.paddle_hits,
            lives: game.lives,
            score: game.score,
            rally: game.rally,
            status: 0,
            level: game.level,
            bricks: game.bricks,
            caps_x: game.caps_x,
            caps_y: game.caps_y,
            caps_kind: game.caps_kind,
            caps_alive: game.caps_alive,
            wide: game.wide,
            slow: game.slow,
        }
    }

    if game.status != 1 {
        return Game {
            balls: game.balls,
            paddle: paddle,
            paddle_v: paddle_v,
            paddle_hits: game.paddle_hits,
            lives: game.lives,
            score: game.score,
            rally: game.rally,
            status: game.status,
            level: game.level,
            bricks: game.bricks,
            caps_x: game.caps_x,
            caps_y: game.caps_y,
            caps_kind: game.caps_kind,
            caps_alive: game.caps_alive,
            wide: game.wide,
            slow: game.slow,
        }
    }

    var bricks = game.bricks
    var score = game.score
    var rally = game.rally
    var caps_x = game.caps_x
    var caps_y = game.caps_y
    var caps_kind = game.caps_kind
    var caps_alive = game.caps_alive
    var wide = game.wide
    var slow = game.slow
    var bonus = 0
    var hits = game.paddle_hits
    var multiball_hit = false
    let walls = wall_list()
    var alive: List<Int> = []

    var b = 0
    let count = ball_count(game)
    while b < count {
        var ball = ph_with_velocity(ph_body(ph_px(game.balls[b * 4]), ph_px(game.balls[b * 4 + 1]), ball_size(), ball_size()), game.balls[b * 4 + 2], game.balls[b * 4 + 3])

        var kind = 0
        var hit = -1
        var best = ph_miss()
        var i = 0
        while i < walls.len() {
            let when = ph_sweep(ball, walls[i])
            if when < best {
                best = when
                hit = i
                kind = 1
            }
            i = i + 1
        }

        var row = 0
        while row < brick_rows() {
            var column = 0
            while column < brick_cols() {
                let index = row * brick_cols() + column
                if bricks[index] == 1 {
                    let when = ph_sweep(ball, brick_body(column, row))
                    if when < best {
                        best = when
                        hit = index
                        kind = 2
                    }
                }
                column = column + 1
            }
            row = row + 1
        }

        if ball.vy > 0 {
            let paddle_when = ph_sweep(ball, paddle_body(game))
            if paddle_when < best {
                best = paddle_when
                kind = 3
            }
        }

        if kind == 0 {
            ball = ph_advance(ball)
        } else if kind == 1 {
            ball = ph_resolve(ball, walls[hit])
        } else if kind == 3 {
            ball = ph_bounce_paddle(ball, paddle_body(game), 9)
            var spin = ball.vx + paddle_v * 700
            if spin > 9500 {
                spin = 9500
            }
            if spin < -9500 {
                spin = -9500
            }
            ball = ph_with_velocity(ball, spin, ball.vy)
            if ball.vy > -3000 {
                ball = ph_with_velocity(ball, ball.vx, -4000)
            }
            hits = hits + 1
            rally = 0
        } else {
            ball = ph_resolve(ball, brick_body(hit % brick_cols(), hit / brick_cols()))
            bricks[hit] = 0
            score = score + 10
            rally = rally + 1
            var factor = 100 + rally * 2
            if factor > 150 {
                factor = 150
            }
            if slow > 0 {
                factor = 100
            }
            ball = ph_with_velocity(ball, ball.vx * factor / 100, ball.vy * factor / 100)
            // Every fifth cleared brick drops a capsule, deterministically.
            if score / 10 % 5 == 3 && !caps_alive {
                caps_x = brick_x(hit % brick_cols()) + brick_w() / 2
                caps_y = brick_y(hit / brick_cols()) + brick_h() / 2
                caps_kind = score / 10 % 4 + 1
                caps_alive = true
            }
        }

        ball = ph_clamp(ball, 8, 8, field_width() - 8, field_height() + 60)
        ball = ph_speed_clamp(ball, 14000)

        // A ball that left the bottom is gone; the others keep playing.
        if ph_px(ball.y) <= field_height() {
            alive.push(ball.x)
            alive.push(ball.y)
            alive.push(ball.vx)
            alive.push(ball.vy)
        }
        b = b + 1
    }

    if caps_alive {
        caps_y = caps_y + capsule_speed()
        let half = capsule_size() / 2
        let px = paddle - paddle_width_of(game) / 2
        if caps_x + half > px && caps_x - half < px + paddle_width_of(game) && caps_y + half > paddle_y() && caps_y - half < paddle_y() + paddle_height() {
            if caps_kind == 1 {
                wide = wide_duration()
            }
            if caps_kind == 2 {
                slow = slow_duration()
            }
            if caps_kind == 3 {
                bonus = bonus + 1
            }
            if caps_kind == 4 {
                multiball_hit = true
            }
            caps_alive = false
        }
        if caps_y > field_height() + 40 {
            caps_alive = false
        }
    }

    if multiball_hit {
        alive = mirror_balls(alive)
    }

    if wide > 0 {
        wide = wide - 1
    }
    if slow > 0 {
        slow = slow - 1
    }

    var lives = game.lives + bonus

    // All balls gone: one life, a fresh ball on the paddle.
    if alive.len() == 0 {
        lives = lives - 1
        var next_status = 0
        if lives <= 0 {
            next_status = 3
        }
        return Game {
            balls: ball_quad(paddle * 1000, 440000, 0, 0),
            paddle: paddle,
            paddle_v: paddle_v,
            paddle_hits: hits,
            lives: lives,
            score: score,
            rally: 0,
            status: next_status,
            level: game.level,
            bricks: bricks,
            caps_x: caps_x,
            caps_y: caps_y,
            caps_kind: caps_kind,
            caps_alive: false,
            wide: 0,
            slow: 0,
        }
    }

    var status = 1
    var remaining = 0
    for brick in bricks {
        if brick == 1 {
            remaining = remaining + 1
        }
    }
    if remaining == 0 {
        status = 2
    }

    return Game {
        balls: alive,
        paddle: paddle,
        paddle_v: paddle_v,
        paddle_hits: hits,
        lives: lives,
        score: score,
        rally: rally,
        status: status,
        level: game.level,
        bricks: bricks,
        caps_x: caps_x,
        caps_y: caps_y,
        caps_kind: caps_kind,
        caps_alive: caps_alive,
        wide: wide,
        slow: slow,
    }
}
