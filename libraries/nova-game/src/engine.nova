// Nova Game Engine: Breakout on top of the swept-AABB physics core.
//
// The engine is pure: `step(game, paddle_target)` takes a Game and returns the
// next Game. It knows nothing about rendering: colours are palette *indices*,
// geometry is exposed in pixels, and the ball keeps millipixel precision so a
// rally does not drift or quantise into a vertical lock.

import "physics.nova"

struct Game {
    ball_x: Int,
    ball_y: Int,
    vx: Int,
    vy: Int,
    paddle: Int,
    paddle_v: Int,
    lives: Int,
    score: Int,
    rally: Int,
    status: Int,
    bricks: List<Int>,
}

fn field_width() -> Int {
    return 800
}

fn field_height() -> Int {
    return 520
}

fn brick_cols() -> Int {
    return 10
}

fn brick_rows() -> Int {
    return 5
}

fn brick_count() -> Int {
    return brick_cols() * brick_rows()
}

fn ball_size() -> Int {
    return 16
}

fn paddle_width() -> Int {
    return 120
}

fn paddle_height() -> Int {
    return 18
}

fn paddle_y() -> Int {
    return 466
}

// Geometry the renderers share. Bricks are 70x24 with an 8px gutter.
fn brick_x(column: Int) -> Int {
    return 30 + column * 78
}

fn brick_y(row: Int) -> Int {
    return 60 + row * 30
}

fn brick_w() -> Int {
    return 70
}

fn brick_h() -> Int {
    return 24
}

// Palette index for a row: the renderer maps 0..5 to its own hues, so the
// engine stays free of the GUI library.
fn brick_colour(row: Int) -> Int {
    var index = row
    if index < 0 {
        index = 0
    }
    return index % 6
}

fn ball_px_x(game: Game) -> Int {
    return ph_px(game.ball_x)
}

fn ball_px_y(game: Game) -> Int {
    return ph_px(game.ball_y)
}

fn ball_px_speed(game: Game) -> Int {
    return ph_px(game.vx)
}

fn new_game() -> Game {
    var bricks: List<Int> = []
    var index = 0
    while index < brick_count() {
        bricks.push(1)
        index = index + 1
    }
    return Game {
        ball_x: 400000,
        ball_y: 440000,
        vx: 4000,
        vy: -5000,
        paddle: 400,
        paddle_v: 0,
        lives: 3,
        score: 0,
        rally: 0,
        status: 0,
        bricks: bricks,
    }
}

fn launch(game: Game) -> Game {
    if game.status != 0 {
        return game
    }
    return Game {
        ball_x: game.ball_x,
        ball_y: game.ball_y,
        vx: 4000,
        vy: -5000,
        paddle: game.paddle,
        paddle_v: 0,
        lives: game.lives,
        score: game.score,
        rally: 0,
        status: 1,
        bricks: game.bricks,
    }
}

fn bricks_left(game: Game) -> Int {
    var alive = 0
    for brick in game.bricks {
        if brick == 1 {
            alive = alive + 1
        }
    }
    return alive
}

fn with_paddle(game: Game, paddle: Int) -> Game {
    return Game {
        ball_x: game.ball_x,
        ball_y: game.ball_y,
        vx: game.vx,
        vy: game.vy,
        paddle: paddle,
        paddle_v: game.paddle_v,
        lives: game.lives,
        score: game.score,
        rally: game.rally,
        status: game.status,
        bricks: game.bricks,
    }
}

fn brick_body(column: Int, row: Int) -> Body {
    return ph_solid_box(brick_x(column), brick_y(row), brick_w(), brick_h())
}

fn paddle_body(game: Game) -> Body {
    return ph_solid_box(game.paddle - paddle_width() / 2, paddle_y(), paddle_width(), paddle_height())
}

fn ball_body(game: Game) -> Body {
    return ph_with_velocity(ph_body(0, 0, ball_size(), ball_size()), game.vx, game.vy)
}

// Top, left and right walls. The bottom is open: falling out costs a life.
fn wall_list() -> List<Body> {
    var walls: List<Body> = []
    walls.push(ph_solid_box(0, -8, field_width(), 8))
    walls.push(ph_solid_box(-8, 0, 8, field_height()))
    walls.push(ph_solid_box(field_width(), 0, 8, field_height()))
    return walls
}

fn step(game: Game, target: Int) -> Game {
    var paddle = target
    if paddle < 50 {
        paddle = 50
    }
    if paddle > field_width() - 50 {
        paddle = field_width() - 50
    }
    let paddle_v = paddle - game.paddle
    if game.status == 0 {
        return Game {
            ball_x: paddle * 1000,
            ball_y: 440000,
            vx: 0,
            vy: 0,
            paddle: paddle,
            paddle_v: paddle_v,
            lives: game.lives,
            score: game.score,
            rally: game.rally,
            status: 0,
            bricks: game.bricks,
        }
    }
    if game.status != 1 {
        return with_paddle(game, paddle)
    }

    var ball = ph_body(ph_px(game.ball_x), ph_px(game.ball_y), ball_size(), ball_size())
    ball = ph_with_velocity(ball, game.vx, game.vy)

    // Earliest contact wins: walls, then bricks, then the paddle.
    var kind = 0
    var hit = -1
    var best = ph_miss()
    let walls = wall_list()
    var i = 0
    while i < walls.len() {
        let when = ph_sweep(ball, walls[i])
        if when < best {
            best = when
            hit = i
            kind = 1
        }
        i = i + 1
    }

    var bricks = game.bricks
    var row = 0
    while row < brick_rows() {
        var column = 0
        while column < brick_cols() {
            let index = row * brick_cols() + column
            if bricks[index] == 1 {
                let when = ph_sweep(ball, brick_body(column, row))
                if when < best {
                    best = when
                    hit = index
                    kind = 2
                }
            }
            column = column + 1
        }
        row = row + 1
    }

    // Only a descending ball hits the paddle; sweeping while it climbs would
    // pin it to the paddle at time zero and it would never leave.
    if game.vy > 0 {
        let paddle_when = ph_sweep(ball, paddle_body(game))
        if paddle_when < best {
            best = paddle_when
            kind = 3
        }
    }

    var score = game.score
    var rally = game.rally
    if kind == 0 {
        ball = ph_advance(ball)
    } else if kind == 1 {
        ball = ph_resolve(ball, walls[hit])
    } else if kind == 3 {
        ball = ph_bounce_paddle(ball, paddle_body(game), 9)
        // Kinematic paddle: where the ball meets the paddle and how fast the
        // paddle is moving both steer it.
        var spin = ball.vx + paddle_v * 700
        if spin > 9500 {
            spin = 9500
        }
        if spin < -9500 {
            spin = -9500
        }
        ball = ph_with_velocity(ball, spin, ball.vy)
        if ball.vy > -3000 {
            ball = ph_with_velocity(ball, ball.vx, -4000)
        }
        rally = 0
    } else {
        ball = ph_resolve(ball, brick_body(hit % brick_cols(), hit / brick_cols()))
        bricks[hit] = 0
        score = score + 10
        rally = rally + 1
        // Every brick adds pace, capped so the ball stays catchable.
        var factor = 100 + rally * 2
        if factor > 150 {
            factor = 150
        }
        ball = ph_with_velocity(ball, ball.vx * factor / 100, ball.vy * factor / 100)
    }

    ball = ph_clamp(ball, 8, 8, field_width() - 8, field_height() + 60)
    ball = ph_speed_clamp(ball, 14000)

    var lives = game.lives
    var status = 1
    let by = ph_px(ball.y)
    if by > field_height() {
        lives = lives - 1
        rally = 0
        if lives <= 0 {
            status = 3
        } else {
            status = 0
        }
        return Game {
            ball_x: paddle * 1000,
            ball_y: 440000,
            vx: 0,
            vy: 0,
            paddle: paddle,
            paddle_v: paddle_v,
            lives: lives,
            score: score,
            rally: 0,
            status: status,
            bricks: bricks,
        }
    }
    if score >= brick_count() * 10 {
        status = 2
    }

    return Game {
        ball_x: ball.x,
        ball_y: ball.y,
        vx: ball.vx,
        vy: ball.vy,
        paddle: paddle,
        paddle_v: paddle_v,
        lives: lives,
        score: score,
        rally: rally,
        status: status,
        bricks: bricks,
    }
}
